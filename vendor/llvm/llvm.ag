    LLVMOpaqueValue* LLVMBuildAlloca(LLVMOpaqueBuilder* p0, LLVMOpaqueType* p1, i8* p2);
    /// Builds a load of type `p1` from pointer `p2`.
    LLVMOpaqueValue* LLVMBuildLoad2(LLVMOpaqueBuilder* p0, LLVMOpaqueType* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds a store of value `p1` to pointer `p2`.
    LLVMOpaqueValue* LLVMBuildStore(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2);
    /// Builds `llvm.memset` of `p3` bytes of value `p2` at `p1` with alignment
    /// `p4`.
    LLVMOpaqueValue* LLVMBuildMemSet(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, LLVMOpaqueValue* p3, u32 p4);
    /// Builds `llvm.memcpy` of `p5` bytes from `p3` to `p1`; the regions must not
    /// overlap.
    LLVMOpaqueValue* LLVMBuildMemCpy(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, u32 p2, LLVMOpaqueValue* p3, u32 p4, LLVMOpaqueValue* p5);
    /// Builds `llvm.memmove` of `p5` bytes from `p3` to `p1`; regions may
    /// overlap.
    LLVMOpaqueValue* LLVMBuildMemMove(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, u32 p2, LLVMOpaqueValue* p3, u32 p4, LLVMOpaqueValue* p5);
    /// Builds a `getelementptr` over element type `p1` with `p4` indices.
    LLVMOpaqueValue* LLVMBuildGEP2(LLVMOpaqueBuilder* p0, LLVMOpaqueType* p1, LLVMOpaqueValue* p2, LLVMOpaqueValue** p3, u32 p4, i8* p5);
    /// Builds a pointer to field `p3` of struct type `p1` at `p2`.
    LLVMOpaqueValue* LLVMBuildStructGEP2(LLVMOpaqueBuilder* p0, LLVMOpaqueType* p1, LLVMOpaqueValue* p2, u32 p3, i8* p4);
    /// Builds a private global holding string `p1` and returns a pointer to it.
    LLVMOpaqueValue* LLVMBuildGlobalStringPtr(LLVMOpaqueBuilder* p0, i8* p1, i8* p2);
    /// Builds `ptrtoint`.
    LLVMOpaqueValue* LLVMBuildPtrToInt(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `inttoptr`.
    LLVMOpaqueValue* LLVMBuildIntToPtr(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `bitcast`.
    LLVMOpaqueValue* LLVMBuildBitCast(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds an integer resize (signed extension when widening).
    LLVMOpaqueValue* LLVMBuildIntCast(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `sext`.
    LLVMOpaqueValue* LLVMBuildSExt(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `zext`.
    LLVMOpaqueValue* LLVMBuildZExt(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `trunc`.
    LLVMOpaqueValue* LLVMBuildTrunc(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `sitofp`.
    LLVMOpaqueValue* LLVMBuildSIToFP(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `fptosi`; out-of-range values give poison.
    LLVMOpaqueValue* LLVMBuildFPToSI(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `uitofp`.
    LLVMOpaqueValue* LLVMBuildUIToFP(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `fptoui`; out-of-range values give poison.
    LLVMOpaqueValue* LLVMBuildFPToUI(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `fpext`.
    LLVMOpaqueValue* LLVMBuildFPExt(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds `fptrunc`.
    LLVMOpaqueValue* LLVMBuildFPTrunc(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueType* p2, i8* p3);
    /// Builds an integer comparison with predicate `p1`.
    LLVMOpaqueValue* LLVMBuildICmp(LLVMOpaqueBuilder* p0, LLVMIntPredicate p1, LLVMOpaqueValue* p2, LLVMOpaqueValue* p3, i8* p4);
    /// Builds `select`: `p2` when `p1` is true, else `p3`.
    LLVMOpaqueValue* LLVMBuildSelect(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, LLVMOpaqueValue* p3, i8* p4);
    /// Builds a floating-point comparison with predicate `p1`.
    LLVMOpaqueValue* LLVMBuildFCmp(LLVMOpaqueBuilder* p0, LLVMRealPredicate p1, LLVMOpaqueValue* p2, LLVMOpaqueValue* p3, i8* p4);
    /// Builds a call to `p2` of function type `p1` with `p4` arguments.
    LLVMOpaqueValue* LLVMBuildCall2(LLVMOpaqueBuilder* p0, LLVMOpaqueType* p1, LLVMOpaqueValue* p2, LLVMOpaqueValue** p3, u32 p4, i8* p5);
    /// Builds `extractvalue` of field `p2` from aggregate `p1`.
    LLVMOpaqueValue* LLVMBuildExtractValue(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, u32 p2, i8* p3);
    /// Builds `insertvalue` of `p2` into field `p3` of aggregate `p1`.
    LLVMOpaqueValue* LLVMBuildInsertValue(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, u32 p3, i8* p4);
    /// Sets the atomic ordering of a load or store (`LLVMAtomicOrdering` value).
    void LLVMSetOrdering(LLVMOpaqueValue* p0, i32 p1);
    /// Sets the alignment of a load, store, alloca, or global.
    void LLVMSetAlignment(LLVMOpaqueValue* p0, u32 p1);
    /// Builds a `fence` with ordering `p1`; single-thread scope when `p2` is
    /// nonzero.
    LLVMOpaqueValue* LLVMBuildFence(LLVMOpaqueBuilder* p0, i32 p1, i32 p2, i8* p3);
    /// Builds `atomicrmw` op `p1` on `p2` with value `p3`, ordering `p4`, single-
    /// thread when `p5`.
    LLVMOpaqueValue* LLVMBuildAtomicRMW(LLVMOpaqueBuilder* p0, i32 p1, LLVMOpaqueValue* p2, LLVMOpaqueValue* p3, i32 p4, i32 p5);
    /// Builds `cmpxchg` on `p1` (expected `p2`, new `p3`) with success/failure
    /// orderings `p4`/`p5`.
    LLVMOpaqueValue* LLVMBuildAtomicCmpXchg(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, LLVMOpaqueValue* p3, i32 p4, i32 p5, i32 p6);
    /// Creates an integer constant; `p2` nonzero sign-extends `p1` to wide types.
    LLVMOpaqueValue* LLVMConstInt(LLVMOpaqueType* p0, u64 p1, i32 p2);
    /// Parses integer constant text `p1` in radix `p2`.
    LLVMOpaqueValue* LLVMConstIntOfString(LLVMOpaqueType* p0, i8* p1, u8 p2);
    /// Creates a constant `inttoptr` expression.
    LLVMOpaqueValue* LLVMConstIntToPtr(LLVMOpaqueValue* p0, LLVMOpaqueType* p1);
    /// Creates a constant `ptrtoint` expression.
    LLVMOpaqueValue* LLVMConstPtrToInt(LLVMOpaqueValue* p0, LLVMOpaqueType* p1);
    /// Creates a constant `or` expression.
    LLVMOpaqueValue* LLVMConstOr(LLVMOpaqueValue* p0, LLVMOpaqueValue* p1);
    /// Creates a literal struct constant from `p2` values; packed when `p3` is
    /// nonzero.
    LLVMOpaqueValue* LLVMConstStructInContext(LLVMOpaqueContext* p0, LLVMOpaqueValue** p1, u32 p2, i32 p3);
    /// Returns the all-zero constant of a type.
    LLVMOpaqueValue* LLVMConstNull(LLVMOpaqueType* p0);
    /// Parses floating-point constant text `p1`.
    LLVMOpaqueValue* LLVMConstRealOfString(LLVMOpaqueType* p0, i8* p1);
    /// Returns the module's IR text. Free it with `LLVMDisposeMessage`.
    i8* LLVMPrintModuleToString(LLVMOpaqueModule* p0);
    /// Frees a string LLVM returned (print, triple, and error message outputs).
    void LLVMDisposeMessage(i8* p0);
    /// Creates pass builder options. Dispose with
    /// `LLVMDisposePassBuilderOptions`.
    LLVMOpaquePassBuilderOptions* LLVMCreatePassBuilderOptions();
    /// Destroys pass builder options.
    void LLVMDisposePassBuilderOptions(LLVMOpaquePassBuilderOptions* options);
    /// Runs the new-PM pipeline `passes` on the module. Returns null on success,
    /// or an error the caller must consume.
    LLVMOpaqueError* LLVMRunPasses(LLVMOpaqueModule* module, str passes,
        LLVMOpaqueTargetMachine* machine, LLVMOpaquePassBuilderOptions* options);
    /// Consumes `error` and returns its message. Free with
    /// `LLVMDisposeErrorMessage`.
    i8* LLVMGetErrorMessage(LLVMOpaqueError* error);
    /// Frees a message from `LLVMGetErrorMessage`.
    void LLVMDisposeErrorMessage(i8* message);
    /// Verifies the module. Returns nonzero when invalid; `*p2` receives a
    /// message to free with `LLVMDisposeMessage`.
    i32 LLVMVerifyModule(LLVMOpaqueModule* p0, LLVMVerifierFailureAction p1, i8** p2);
    /// Registers x86 target info.
    void LLVMInitializeX86TargetInfo();
    /// Registers the x86 target.
    void LLVMInitializeX86Target();
    /// Registers the x86 machine-code layer.
    void LLVMInitializeX86TargetMC();
    /// Registers the x86 assembly printer.
    void LLVMInitializeX86AsmPrinter();
    /// Registers the x86 assembly parser (needed for inline asm).
    void LLVMInitializeX86AsmParser();
    /// Registers AArch64 target info.
    void LLVMInitializeAArch64TargetInfo();
    /// Registers the AArch64 target.
    void LLVMInitializeAArch64Target();
    /// Registers the AArch64 machine-code layer.
    void LLVMInitializeAArch64TargetMC();
    /// Registers the AArch64 assembly printer.
    void LLVMInitializeAArch64AsmPrinter();
    /// Registers the AArch64 assembly parser.
    void LLVMInitializeAArch64AsmParser();
    /// Returns the host triple. Free it with `LLVMDisposeMessage`.
    i8* LLVMGetDefaultTargetTriple();
    /// Sets the module's data layout string.
    void LLVMSetDataLayout(LLVMOpaqueModule* p0, i8* p1);
    /// Sets the module's target triple.
    void LLVMSetTarget(LLVMOpaqueModule* p0, i8* p1);
    /// Creates a debug-info builder. Finalize, then dispose with
    /// `LLVMDisposeDIBuilder`.
    LLVMOpaqueDIBuilder* LLVMCreateDIBuilder(LLVMOpaqueModule* p0);
    /// Destroys a debug-info builder.
    void LLVMDisposeDIBuilder(LLVMOpaqueDIBuilder* p0);
    /// Resolves pending debug metadata; call before emitting the module.
    void LLVMDIBuilderFinalize(LLVMOpaqueDIBuilder* p0);
    /// Creates a debug-info builder that rejects unresolved nodes.
    LLVMOpaqueDIBuilder* LLVMCreateDIBuilderDisallowUnresolved(LLVMOpaqueModule* p0);
    /// Finalizes one function's debug metadata.
    void LLVMDIBuilderFinalizeSubprogram(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1);
    /// Attaches debug subprogram `p1` to function `p0`.
    void LLVMSetSubprogram(LLVMOpaqueValue* p0, LLVMOpaqueMetadata* p1);

    /// Creates the module's compile unit (language, file, producer, flags,
    /// emission kind, and more).
    LLVMOpaqueMetadata* LLVMDIBuilderCreateCompileUnit(LLVMOpaqueDIBuilder* p0, LLVMDWARFSourceLanguage p1, LLVMOpaqueMetadata* p2, i8* p3, u64 p4, i32 p5, i8* p6, u64 p7, u32 p8, i8* p9, u64 p10, LLVMDWARFEmissionKind p11, u32 p12, i32 p13, i32 p14, i8* p15, u64 p16, i8* p17, u64 p18);
    /// Creates a file descriptor from name `p1` and directory `p3`.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateFile(LLVMOpaqueDIBuilder* p0, i8* p1, u64 p2, i8* p3, u64 p4);
    /// Creates a subprogram (function) descriptor.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateFunction(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, i8* p2, u64 p3, i8* p4, u64 p5, LLVMOpaqueMetadata* p6, u32 p7, LLVMOpaqueMetadata* p8, i32 p9, i32 p10, u32 p11, LLVMDIFlags p12, i32 p13);
    /// Creates a lexical block scope at line `p3`, column `p4`.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateLexicalBlock(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, LLVMOpaqueMetadata* p2, u32 p3, u32 p4);
    /// Creates a debug location (line `p1`, column `p2`, scope `p3`).
    LLVMOpaqueMetadata* LLVMDIBuilderCreateDebugLocation(LLVMOpaqueContext* p0, u32 p1, u32 p2, LLVMOpaqueMetadata* p3, LLVMOpaqueMetadata* p4);
    /// Creates a function signature type from `p3` parameter types.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateSubroutineType(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, LLVMOpaqueMetadata** p2, u32 p3, LLVMDIFlags p4);
    /// Creates a basic type of `p3` bits with DWARF encoding `p4`.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateBasicType(LLVMOpaqueDIBuilder* p0, i8* p1, u64 p2, u64 p3, u32 p4, LLVMDIFlags p5);
    /// Creates a struct type with `p11` member descriptors.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateStructType(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, i8* p2, u64 p3, LLVMOpaqueMetadata* p4, u32 p5, u64 p6, u32 p7, LLVMDIFlags p8, LLVMOpaqueMetadata* p9, LLVMOpaqueMetadata** p10, u32 p11, u32 p12, LLVMOpaqueMetadata* p13, i8* p14, u64 p15);
    /// Creates a struct member at bit offset `p8`.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateMemberType(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, i8* p2, u64 p3, LLVMOpaqueMetadata* p4, u32 p5, u64 p6, u32 p7, u64 p8, LLVMDIFlags p9, LLVMOpaqueMetadata* p10);
    /// Creates a pointer type of `p2` bits to `p1`.
    LLVMOpaqueMetadata* LLVMDIBuilderCreatePointerType(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, u64 p2, u32 p3, u32 p4, i8* p5, u64 p6);
    /// Creates an array type of `p1` bits with `p5` subranges.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateArrayType(LLVMOpaqueDIBuilder* p0, u64 p1, u32 p2, LLVMOpaqueMetadata* p3, LLVMOpaqueMetadata** p4, u32 p5);


    /// Creates a DWARF expression from `p2` opcodes.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateExpression(LLVMOpaqueDIBuilder* p0, u64* p1, u64 p2);
    /// Creates a local variable descriptor.
    LLVMOpaqueMetadata* LLVMDIBuilderCreateAutoVariable(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, i8* p2, u64 p3, LLVMOpaqueMetadata* p4, u32 p5, LLVMOpaqueMetadata* p6, i32 p7, LLVMDIFlags p8, u32 p9);
    /// Creates a parameter variable descriptor (argument number `p4`, 1-based).
    LLVMOpaqueMetadata* LLVMDIBuilderCreateParameterVariable(LLVMOpaqueDIBuilder* p0, LLVMOpaqueMetadata* p1, i8* p2, u64 p3, u32 p4, LLVMOpaqueMetadata* p5, u32 p6, LLVMOpaqueMetadata* p7, i32 p8, LLVMDIFlags p9);
    /// Inserts a declare record for storage `p1` at the end of block `p5`.
    LLVMOpaqueDbgRecord* LLVMDIBuilderInsertDeclareRecordAtEnd(LLVMOpaqueDIBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueMetadata* p2, LLVMOpaqueMetadata* p3, LLVMOpaqueMetadata* p4, LLVMOpaqueBasicBlock* p5);
    /// Returns the `LLVMMetadataKind` of a metadata node.
    u32 LLVMGetMetadataKind(LLVMOpaqueMetadata* p0);

    /// Looks up the target for triple `p0`. Returns nonzero on failure with `*p2`
    /// set to a message to free with `LLVMDisposeMessage`.
    i32 LLVMGetTargetFromTriple(i8* p0, LLVMTarget** p1, i8** p2);
    /// Creates a target machine (triple, CPU, features, levels). Dispose with
    /// `LLVMDisposeTargetMachine`.
    LLVMOpaqueTargetMachine* LLVMCreateTargetMachine(LLVMTarget* p0, i8* p1, i8* p2, i8* p3, LLVMCodeGenOptLevel p4, LLVMRelocMode p5, LLVMCodeModel p6);
    /// Destroys a target machine.
    void LLVMDisposeTargetMachine(LLVMOpaqueTargetMachine* p0);
    /// Creates the machine's data layout. Dispose with `LLVMDisposeTargetData`.
    LLVMTargetDataRef* LLVMCreateTargetDataLayout(LLVMOpaqueTargetMachine* p0);
    /// Destroys a data layout.
    void LLVMDisposeTargetData(LLVMTargetDataRef* p0);
    /// Returns the data layout string. Free it with `LLVMDisposeMessage`.
    i8* LLVMCopyStringRepOfTargetData(LLVMTargetDataRef* p0);
    /// Returns a type's ABI allocation size in bytes.
    u64 LLVMABISizeOfType(LLVMTargetDataRef* p0, LLVMOpaqueType* p1);
    /// Returns a type's ABI alignment in bytes.
    u32 LLVMABIAlignmentOfType(LLVMTargetDataRef* p0, LLVMOpaqueType* p1);
    /// Returns the byte offset of field `p2` in struct type `p1`.
    u64 LLVMOffsetOfElement(LLVMTargetDataRef* p0, LLVMOpaqueType* p1, u32 p2);
    /// Returns nonzero when the type has a known size.
    i32 LLVMTypeIsSized(LLVMOpaqueType* p0);
    /// Writes the module as assembly or an object file to path `p2`. Returns
    /// nonzero on failure with `*p4` set to a message to free with
    /// `LLVMDisposeMessage`.
    i32 LLVMTargetMachineEmitToFile(LLVMOpaqueTargetMachine* p0, LLVMOpaqueModule* p1, i8* p2, LLVMCodeGenFileType p3, i8** p4);
    /// Creates an inline asm value: asm text `p1`, constraints `p3`, side effects
    /// `p5`, align stack `p6`, dialect `p7`, can throw `p8`.
    LLVMOpaqueValue* LLVMGetInlineAsm(LLVMOpaqueType* p0, i8* p1, u64 p2, i8* p3, u64 p4, i32 p5, i32 p6, i32 p7, i32 p8);
    /// Creates a string attribute `p1` = `p3`.
    LLVMOpaqueAttributeRef* LLVMCreateStringAttribute(LLVMOpaqueContext* p0, i8* p1, u32 p2, i8* p3, u32 p4);
    /// Adds an attribute to a function (index -1), its return (0), or parameter i
    /// (i + 1).
    void LLVMAddAttributeAtIndex(LLVMOpaqueValue* p0, u32 p1, LLVMOpaqueAttributeRef* p2);
}

/// Registers target info for every target this binding supports (x86,
/// AArch64).
void LLVMInitializeAllTargetInfos() {
    LLVMInitializeX86TargetInfo();
    LLVMInitializeAArch64TargetInfo();
}

/// Registers every supported target (x86, AArch64).
void LLVMInitializeAllTargets() {
    LLVMInitializeX86Target();
    LLVMInitializeAArch64Target();
}

/// Registers machine-code layers for every supported target.
void LLVMInitializeAllTargetMCs() {
    LLVMInitializeX86TargetMC();
    LLVMInitializeAArch64TargetMC();
}

/// Registers assembly printers for every supported target.
void LLVMInitializeAllAsmPrinters() {
    LLVMInitializeX86AsmPrinter();
    LLVMInitializeAArch64AsmPrinter();
}

/// Registers assembly parsers for every supported target.
void LLVMInitializeAllAsmParsers() {
    LLVMInitializeX86AsmParser();
    LLVMInitializeAArch64AsmParser();
}
