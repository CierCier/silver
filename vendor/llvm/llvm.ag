// vendor/llvm/llvm.ag — Silver interface declarations for LLVM C API

/// Opaque `LLVMContextRef`. Owns every type and constant created in it.
struct LLVMOpaqueContext {}
/// Opaque `LLVMModuleRef`.
struct LLVMOpaqueModule {}
/// Opaque `LLVMBuilderRef` (instruction builder).
struct LLVMOpaqueBuilder {}
/// Opaque `LLVMTypeRef`, owned by its context.
struct LLVMOpaqueType {}
/// Opaque `LLVMValueRef`, owned by its module or context.
struct LLVMOpaqueValue {}
/// Opaque `LLVMBasicBlockRef`, owned by its function.
struct LLVMOpaqueBasicBlock {}
/// Opaque `LLVMTargetMachineRef`.
struct LLVMOpaqueTargetMachine {}
/// Opaque `LLVMTargetDataRef` (data layout).
struct LLVMTargetDataRef {}
/// Opaque `LLVMTargetRef`, a static registry entry; never freed.
struct LLVMTarget {}
/// Opaque `LLVMMetadataRef`, owned by its context.
struct LLVMOpaqueMetadata {}
/// Opaque `LLVMAttributeRef`, owned by its context.
struct LLVMOpaqueAttributeRef {}
/// Opaque `LLVMDIBuilderRef` (debug-info builder).
struct LLVMOpaqueDIBuilder {}
/// Opaque `LLVMDbgRecordRef` (debug record).
struct LLVMOpaqueDbgRecord {}
/// Opaque `LLVMPassBuilderOptionsRef`.
struct LLVMOpaquePassBuilderOptions {}
/// Opaque `LLVMErrorRef`. Must be consumed, for example with
/// `LLVMGetErrorMessage`.
struct LLVMOpaqueError {}


/// Code generation optimization level (`LLVMCodeGenOptLevel`).
enum LLVMCodeGenOptLevel {
    LLVMCodeGenLevelNone = 0;
    LLVMCodeGenLevelLess = 1;
    LLVMCodeGenLevelDefault = 2;
    LLVMCodeGenLevelAggressive = 3;
}

/// Relocation model (`LLVMRelocMode`).
enum LLVMRelocMode {
    LLVMRelocDefault = 0;
    LLVMRelocStatic = 1;
    LLVMRelocPIC = 2;
    LLVMRelocDynamicNoPic = 3;
    LLVMRelocROPI = 4;
    LLVMRelocRWPI = 5;
    LLVMRelocROPI_RWPI = 6;
}

/// Code model (`LLVMCodeModel`).
enum LLVMCodeModel {
    LLVMCodeModelDefault = 0;
    LLVMCodeModelJITDefault = 1;
    LLVMCodeModelTiny = 2;
    LLVMCodeModelSmall = 3;
    LLVMCodeModelKernel = 4;
    LLVMCodeModelMedium = 5;
    LLVMCodeModelLarge = 6;
}

/// Output kind for `LLVMTargetMachineEmitToFile`.
enum LLVMCodeGenFileType {
    LLVMAssemblyFile = 0;
    LLVMObjectFile = 1;
}

/// What `LLVMVerifyModule` does on failure.
enum LLVMVerifierFailureAction {
    LLVMAbortProcessAction = 0;
    LLVMPrintMessageAction = 1;
    LLVMReturnStatusAction = 2;
}
/// Global value linkage (`LLVMLinkage`).
enum LLVMLinkage {
    LLVMExternalLinkage = 0;
    LLVMAvailableExternallyLinkage = 1;
    LLVMLinkOnceAnyLinkage = 2;
    LLVMLinkOnceODRLinkage = 3;
    LLVMLinkOnceODRAutoHideLinkage = 4;
    LLVMWeakAnyLinkage = 5;
    LLVMWeakODRLinkage = 6;
    LLVMAppendingLinkage = 7;
    LLVMInternalLinkage = 8;
    LLVMPrivateLinkage = 9;
    LLVMDLLImportLinkage = 10;
    LLVMDLLExportLinkage = 11;
    LLVMExternalWeakLinkage = 12;
    LLVMGhostLinkage = 13;
    LLVMCommonLinkage = 14;
    LLVMLinkerPrivateLinkage = 15;
    LLVMLinkerPrivateWeakLinkage = 16;
}

/// Debug-info flags; only the subset the compiler uses is listed.
enum LLVMDIFlags {
    LLVMDIFlagZero = 0;
    LLVMDIFlagPrivate = 1;
    LLVMDIFlagProtected = 2;
    LLVMDIFlagPublic = 3;
}

/// DWARF source language codes; only C89 and C are listed.
enum LLVMDWARFSourceLanguage {
    LLVMDWARFSourceLanguageC89 = 0;
    LLVMDWARFSourceLanguageC = 1;
}

/// How much debug info a compile unit emits.
enum LLVMDWARFEmissionKind {
    LLVMDWARFEmissionNone = 0;
    LLVMDWARFEmissionFull = 1;
    LLVMDWARFEmissionLineTablesOnly = 2;
}



/// Integer comparison predicates for `LLVMBuildICmp`.
enum LLVMIntPredicate {
    LLVMIntEQ = 32;
    LLVMIntNE = 33;
    LLVMIntUGT = 34;
    LLVMIntUGE = 35;
    LLVMIntULT = 36;
    LLVMIntULE = 37;
    LLVMIntSGT = 38;
    LLVMIntSGE = 39;
    LLVMIntSLT = 40;
    LLVMIntSLE = 41;
}

/// Floating-point comparison predicates for `LLVMBuildFCmp` (O = ordered, U =
/// unordered).
enum LLVMRealPredicate {
    LLVMRealPredicateFalse = 0;
    LLVMRealOEQ = 1;
    LLVMRealOGT = 2;
    LLVMRealOGE = 3;
    LLVMRealOLT = 4;
    LLVMRealOLE = 5;
    LLVMRealONE = 6;
    LLVMRealORD = 7;
    LLVMRealUNO = 8;
    LLVMRealUEQ = 9;
    LLVMRealUGT = 10;
    LLVMRealUGE = 11;
    LLVMRealULT = 12;
    LLVMRealULE = 13;
    LLVMRealUNE = 14;
    LLVMRealPredicateTrue = 15;
}

/// How conflicting module flags merge at link time.
enum LLVMModuleFlagBehavior {
    LLVMModuleFlagBehaviorError = 0;
    LLVMModuleFlagBehaviorWarning = 1;
    LLVMModuleFlagBehaviorRequire = 2;
    LLVMModuleFlagBehaviorOverride = 3;
    LLVMModuleFlagBehaviorAppend = 4;
    LLVMModuleFlagBehaviorAppendUnique = 5;
}


#[link("LLVM-22")]
extern "C" {
    /// Creates a context. Dispose with `LLVMContextDispose` after its modules.
    LLVMOpaqueContext* LLVMContextCreate();
    /// Destroys a context and everything it owns.
    void LLVMContextDispose(LLVMOpaqueContext* p0);
    /// Creates an empty module named `p0` in context `p1`. Dispose with
    /// `LLVMDisposeModule`.
    LLVMOpaqueModule* LLVMModuleCreateWithNameInContext(i8* p0, LLVMOpaqueContext* p1);
    /// Destroys a module and its functions and globals.
    void LLVMDisposeModule(LLVMOpaqueModule* p0);
    /// Creates an instruction builder. Dispose with `LLVMDisposeBuilder`.
    LLVMOpaqueBuilder* LLVMCreateBuilderInContext(LLVMOpaqueContext* p0);
    /// Destroys a builder.
    void LLVMDisposeBuilder(LLVMOpaqueBuilder* p0);
    /// Creates an opaque named struct type; set its fields with
    /// `LLVMStructSetBody`.
    LLVMOpaqueType* LLVMStructCreateNamed(LLVMOpaqueContext* p0, i8* p1);
    /// Sets the `p2` field types of a named struct; `p3` nonzero means packed.
    void LLVMStructSetBody(LLVMOpaqueType* p0, LLVMOpaqueType** p1, u32 p2, i32 p3);
    /// Returns a literal struct type of `p2` fields; `p3` nonzero means packed.
    LLVMOpaqueType* LLVMStructTypeInContext(LLVMOpaqueContext* p0, LLVMOpaqueType** p1, u32 p2, i32 p3);
    /// Creates a constant of named struct type `p0` from `p2` field values.
    LLVMOpaqueValue* LLVMConstNamedStruct(LLVMOpaqueType* p0, LLVMOpaqueValue** p1, u32 p2);
    /// Returns the named struct type `p1`, or null.
    LLVMOpaqueType* LLVMGetTypeByName2(LLVMOpaqueContext* p0, i8* p1);
    /// Returns the type's IR text. Free it with `LLVMDisposeMessage`.
    i8* LLVMPrintTypeToString(LLVMOpaqueType* p0);
    /// Returns `i1`.
    LLVMOpaqueType* LLVMInt1TypeInContext(LLVMOpaqueContext* p0);
    /// Returns `i8`.
    LLVMOpaqueType* LLVMInt8TypeInContext(LLVMOpaqueContext* p0);
    /// Returns `i16`.
    LLVMOpaqueType* LLVMInt16TypeInContext(LLVMOpaqueContext* p0);
    /// Returns `i32`.
    LLVMOpaqueType* LLVMInt32TypeInContext(LLVMOpaqueContext* p0);
    /// Returns `i64`.
    LLVMOpaqueType* LLVMInt64TypeInContext(LLVMOpaqueContext* p0);
    /// Returns `i128`.
    LLVMOpaqueType* LLVMInt128TypeInContext(LLVMOpaqueContext* p0);
    /// Returns `float`.
    LLVMOpaqueType* LLVMFloatTypeInContext(LLVMOpaqueContext* p0);
    /// Returns `double`.
    LLVMOpaqueType* LLVMDoubleTypeInContext(LLVMOpaqueContext* p0);
    /// Returns the opaque pointer type in address space `p1`.
    LLVMOpaqueType* LLVMPointerTypeInContext(LLVMOpaqueContext* p0, u32 p1);
    /// Returns `void`.
    LLVMOpaqueType* LLVMVoidTypeInContext(LLVMOpaqueContext* p0);
    /// Returns the integer type of `p1` bits.
    LLVMOpaqueType* LLVMIntTypeInContext(LLVMOpaqueContext* p0, u32 p1);
    /// Returns an array of `p1` elements of `p0`.
    LLVMOpaqueType* LLVMArrayType(LLVMOpaqueType* p0, u32 p1);
    /// Returns a function type: return `p0`, `p2` params from `p1`, variadic when
    /// `p3` is nonzero.
    LLVMOpaqueType* LLVMFunctionType(LLVMOpaqueType* p0, LLVMOpaqueType** p1, u32 p2, i32 p3);
    /// Wraps a value as metadata.
    LLVMOpaqueMetadata* LLVMValueAsMetadata(LLVMOpaqueValue* p0);
    /// Wraps metadata as a value (for metadata call arguments).
    LLVMOpaqueValue* LLVMMetadataAsValue(LLVMOpaqueContext* p0, LLVMOpaqueMetadata* p1);
    /// Adds module flag `p2` (length `p3`) with value `p4` and merge behavior
    /// `p1`.
    void LLVMAddModuleFlag(LLVMOpaqueModule* p0, LLVMModuleFlagBehavior p1, i8* p2, u64 p3, LLVMOpaqueMetadata* p4);

    /// Adds a function declaration named `p1` of function type `p2`.
    LLVMOpaqueValue* LLVMAddFunction(LLVMOpaqueModule* p0, i8* p1, LLVMOpaqueType* p2);
    /// Returns the function named `p1`, or null.
    LLVMOpaqueValue* LLVMGetNamedFunction(LLVMOpaqueModule* p0, i8* p1);
    /// Returns the value's name, borrowed from the value; do not free.
    i8* LLVMGetValueName(LLVMOpaqueValue* p0);
    /// Adds a global variable named `p2` of type `p1`.
    LLVMOpaqueValue* LLVMAddGlobal(LLVMOpaqueModule* p0, LLVMOpaqueType* p1, i8* p2);
    /// Returns the global named `p1`, or null.
    LLVMOpaqueValue* LLVMGetNamedGlobal(LLVMOpaqueModule* p0, i8* p1);
    /// Sets a global's linkage.
    void LLVMSetLinkage(LLVMOpaqueValue* p0, LLVMLinkage p1);
    /// Marks a global constant when `p1` is nonzero.
    void LLVMSetGlobalConstant(LLVMOpaqueValue* p0, i32 p1);
    /// Marks a global thread-local when `p1` is nonzero.
    void LLVMSetThreadLocal(LLVMOpaqueValue* p0, i32 p1);
    /// Creates a constant byte array from `p2` bytes; appends a NUL unless `p3`
    /// is nonzero.
    LLVMOpaqueValue* LLVMConstStringInContext2(LLVMOpaqueContext* p0, i8* p1, u64 p2, i32 p3);
    /// Creates a constant array of element type `p0` from `p2` values.
    LLVMOpaqueValue* LLVMConstArray2(LLVMOpaqueType* p0, LLVMOpaqueValue** p1, u64 p2);

    /// Sets a global's initializer.
    void LLVMSetInitializer(LLVMOpaqueValue* p0, LLVMOpaqueValue* p1);
    /// Returns parameter `p1` of function `p0`.
    LLVMOpaqueValue* LLVMGetParam(LLVMOpaqueValue* p0, u32 p1);
    /// Returns the value type of a global or function.
    LLVMOpaqueType* LLVMGlobalGetValueType(LLVMOpaqueValue* p0);
    /// Returns the value when it is a function, otherwise null.
    LLVMOpaqueValue* LLVMIsAFunction(LLVMOpaqueValue* p0);
    /// Returns a value's type.
    LLVMOpaqueType* LLVMTypeOf(LLVMOpaqueValue* p0);
    /// Returns the `LLVMTypeKind` of a type.
    u32 LLVMGetTypeKind(LLVMOpaqueType* p0);
    /// Returns an integer type's bit width.
    u32 LLVMGetIntTypeWidth(LLVMOpaqueType* p0);
    /// Returns a function type's parameter count.
    u32 LLVMCountParamTypes(LLVMOpaqueType* p0);
    /// Writes a function type's parameter types to `p1`, which must hold
    /// `LLVMCountParamTypes` entries.
    void LLVMGetParamTypes(LLVMOpaqueType* p0, LLVMOpaqueType** p1);
    /// Returns a function type's return type.
    LLVMOpaqueType* LLVMGetReturnType(LLVMOpaqueType* p0);
    /// Returns nonzero for a variadic function type.
    i32 LLVMIsFunctionVarArg(LLVMOpaqueType* p0);
    /// Appends a basic block named `p2` to function `p1`.
    LLVMOpaqueBasicBlock* LLVMAppendBasicBlockInContext(LLVMOpaqueContext* p0, LLVMOpaqueValue* p1, i8* p2);
    /// Returns a function's basic block count.
    u32 LLVMCountBasicBlocks(LLVMOpaqueValue* p0);
    /// Moves the builder to the end of block `p1`.
    void LLVMPositionBuilderAtEnd(LLVMOpaqueBuilder* p0, LLVMOpaqueBasicBlock* p1);
    /// Moves the builder to just before `instruction`.
    void LLVMPositionBuilderBefore(LLVMOpaqueBuilder* builder, LLVMOpaqueValue* instruction);
    /// Returns a function's entry block.
    LLVMOpaqueBasicBlock* LLVMGetEntryBasicBlock(LLVMOpaqueValue* function);
    /// Returns a block's first instruction, or null.
    LLVMOpaqueValue* LLVMGetFirstInstruction(LLVMOpaqueBasicBlock* block);
    /// Returns the next instruction in the block, or null.
    LLVMOpaqueValue* LLVMGetNextInstruction(LLVMOpaqueValue* instruction);
