    LLVMOpaqueValue* LLVMBuildSub(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `fsub`.
    LLVMOpaqueValue* LLVMBuildFSub(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds integer `mul` (wrapping).
    LLVMOpaqueValue* LLVMBuildMul(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `fmul`.
    LLVMOpaqueValue* LLVMBuildFMul(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `sdiv`; division by zero or overflow is undefined behavior.
    LLVMOpaqueValue* LLVMBuildSDiv(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `udiv`; division by zero is undefined behavior.
    LLVMOpaqueValue* LLVMBuildUDiv(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `fdiv`.
    LLVMOpaqueValue* LLVMBuildFDiv(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `srem`; a zero divisor is undefined behavior.
    LLVMOpaqueValue* LLVMBuildSRem(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `urem`; a zero divisor is undefined behavior.
    LLVMOpaqueValue* LLVMBuildURem(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds bitwise `and`.
    LLVMOpaqueValue* LLVMBuildAnd(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds bitwise `or`.
    LLVMOpaqueValue* LLVMBuildOr(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds bitwise `xor`.
    LLVMOpaqueValue* LLVMBuildXor(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds `shl`; shifting by the bit width or more gives poison.
    LLVMOpaqueValue* LLVMBuildShl(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds logical `lshr`; shifting by the bit width or more gives poison.
    LLVMOpaqueValue* LLVMBuildLShr(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds arithmetic `ashr`; shifting by the bit width or more gives poison.
    LLVMOpaqueValue* LLVMBuildAShr(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
    /// Builds integer negation.
    LLVMOpaqueValue* LLVMBuildNeg(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, i8* p2);
    /// Builds `fneg`.
    LLVMOpaqueValue* LLVMBuildFNeg(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, i8* p2);
    /// Builds bitwise not.
    LLVMOpaqueValue* LLVMBuildNot(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, i8* p2);
    /// Builds a stack slot of type `p1`. Place it in the entry block so it is not
