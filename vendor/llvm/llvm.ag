    LLVMOpaqueValue* LLVMBuildPhi(LLVMOpaqueBuilder* p0, LLVMOpaqueType* p1, i8* p2);
    /// Adds `p3` (value, block) inputs to a phi node.
    void LLVMAddIncoming(LLVMOpaqueValue* p0, LLVMOpaqueValue** p1, LLVMOpaqueBasicBlock** p2, u32 p3);
    /// Sets the debug location attached to instructions built next (null clears
    /// it).
    void LLVMSetCurrentDebugLocation2(LLVMOpaqueBuilder* p0, LLVMOpaqueMetadata* p1);

    /// Returns the builder's current block.
    LLVMOpaqueBasicBlock* LLVMGetInsertBlock(LLVMOpaqueBuilder* p0);
    /// Returns a block's terminator, or null when it has none yet.
    LLVMOpaqueValue* LLVMGetBasicBlockTerminator(LLVMOpaqueBasicBlock* p0);
    /// Builds `ret void`.
    LLVMOpaqueValue* LLVMBuildRetVoid(LLVMOpaqueBuilder* p0);
    /// Builds `ret` of a value.
    LLVMOpaqueValue* LLVMBuildRet(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1);
    /// Builds an unconditional branch.
    LLVMOpaqueValue* LLVMBuildBr(LLVMOpaqueBuilder* p0, LLVMOpaqueBasicBlock* p1);
    /// Builds `unreachable`.
    LLVMOpaqueValue* LLVMBuildUnreachable(LLVMOpaqueBuilder* p0);
    /// Builds a conditional branch on `p1` to `p2` (true) or `p3` (false).
    LLVMOpaqueValue* LLVMBuildCondBr(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueBasicBlock* p2, LLVMOpaqueBasicBlock* p3);
    /// Builds integer `add` (wrapping).
    LLVMOpaqueValue* LLVMBuildAdd(LLVMOpaqueBuilder* p0, LLVMOpaqueValue* p1, LLVMOpaqueValue* p2, i8* p3);
