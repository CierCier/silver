// bin/agsm/src/main.ag — Self-hosted Silver foreign sourcemap module builder.
import std.args;
import std.env;
import std.fs;
import std.io;
import std.mem.vec;
import std.process;
import std.string;
import std.sys.os;

bool agsm_is_executable(str path) {
    return is_file(path) && sys_access((i64)path, 1) == 0;
}

Optional<String> resolve_generator_binary() {
    Optional<String> configured = var("SILVER_AGSM");
    if (configured.is_some()) {
        String path = configured.unwrap();
        if (agsm_is_executable(path.to_str())) {
            return Optional<String>.some(move path);
        }
        path.drop();
        return Optional<String>.none();
    }

    String fallback = String.from_str("target/debug/agsm");
    if (agsm_is_executable(fallback.to_str())) {
        return Optional<String>.some(move fallback);
    }
    fallback.drop();

    Optional<String> path_env = var("PATH");
    if (path_env.is_some()) {
        String path_str = path_env.unwrap();
        SplitIter iter = path_str.split(":");
        while (true) {
            Optional<str> item = iter.next();
            if (item.is_none()) { break; }
            str dir = item.unwrap();
            String candidate = String.from_str(dir);
            candidate.push('/');
            candidate.push_str("agsm");
            if (agsm_is_executable(candidate.to_str())) {
                path_str.drop();
                return Optional<String>.some(move candidate);
            }
            candidate.drop();
        }
        path_str.drop();
    }

    return Optional<String>.none();
}

void print_help() {
    STDOUT.write_str("Silver foreign sourcemap module builder\n\n");
    STDOUT.write_str("Usage: agsm [COMMAND]\n\n");
    STDOUT.write_str("Commands:\n");
    STDOUT.write_str("  build  Build a foreign module from a sourcemap configuration\n");
    STDOUT.write_str("  help   Print this message or the help of the given subcommand(s)\n\n");
    STDOUT.write_str("Options:\n");
    STDOUT.write_str("  -h, --help  Print help\n");
}

void print_build_help() {
    STDOUT.write_str("Usage: agsm build [OPTIONS] [SOURCEMAP]\n\n");
    STDOUT.write_str("Arguments:\n");
    STDOUT.write_str("  [SOURCEMAP]  [default: sourcemap.toml]\n\n");
    STDOUT.write_str("Options:\n");
    STDOUT.write_str("  -o, --output <OUTPUT>\n");
    STDOUT.write_str("      --target <TARGET>\n");
    STDOUT.write_str("  -I, --include-path <DIR>\n");
    STDOUT.write_str("  -L, --lib-path <DIR>\n");
    STDOUT.write_str("  -D, --define <NAME[=VALUE]>\n");
    STDOUT.write_str("  -h, --help                   Print help\n");
}

i32 main() {
    Vec<String> arguments = args();
    if (arguments.len() <= 1) {
        print_help();
        arguments.drop();
        return 0;
    }

    String* first = arguments.get_ptr(1);
    if (first.equals("-h") || first.equals("--help") || first.equals("help")) {
        print_help();
        arguments.drop();
        return 0;
    }

    if (!first.equals("build")) {
        STDERR.write_str("agsm: error: unrecognized subcommand '");
        STDERR.write_str(first.to_str());
        STDERR.write_str("'\n\n");
        print_help();
        arguments.drop();
        return 2;
    }

    if (arguments.len() > 2) {
        String* second = arguments.get_ptr(2);
        if (second.equals("-h") || second.equals("--help") || second.equals("help")) {
            print_build_help();
            arguments.drop();
            return 0;
        }
    }

    Optional<String> generator = resolve_generator_binary();
    if (generator.is_none()) {
        STDERR.write_str("agsm: error: foreign module generator backend unavailable; build target/debug/agsm or set SILVER_AGSM\n");
        arguments.drop();
        return 2;
    }

    String program = generator.unwrap();
    Command command = Command.new(program.to_str());
    i64 idx = 1;
    while (idx < arguments.len()) {
        command.arg(arguments.get_ptr(idx).to_str());
        idx += 1;
    }

    Result<ExitStatus, i64> res = command.status();
    program.drop();
    arguments.drop();

    if (res.is_err()) {
        STDERR.write_str("agsm: error: failed to execute generator backend\n");
        return 2;
    }

    ExitStatus status = res.unwrap();
    if (!status.exited) {
        return 128 + status.signal;
    }
    return status.exit_code();
}
