import std.error;
import std.fmt;
import std.io;
import std.mem.vec;
import std.path;
import std.result;
import std.string;
import agc;
import frontend.artifacts;
import native_backend;
import workspace;
import frontend.ownership;
import frontend.send;
import agsm;

str token_kind_name(TokenKind kind) {
    return match kind {
        TokenKind.IntLiteral : "IntLiteral",
        TokenKind.FloatLiteral : "FloatLiteral",
        TokenKind.ComplexLiteral : "ComplexLiteral",
        TokenKind.StringLiteral : "StringLiteral",
        TokenKind.CharLiteral : "CharLiteral",
        TokenKind.Lifetime : "Lifetime",
        TokenKind.BoolLiteral : "BoolLiteral",
        TokenKind.Struct : "Struct",
        TokenKind.Enum : "Enum",
        TokenKind.Impl : "Impl",
        TokenKind.Trait : "Trait",
        TokenKind.Mut : "Mut",
        TokenKind.Const : "Const",
        TokenKind.Static : "Static",
        TokenKind.Volatile : "Volatile",
        TokenKind.If : "If",
        TokenKind.Else : "Else",
        TokenKind.While : "While",
        TokenKind.For : "For",
        TokenKind.Match : "Match",
        TokenKind.Break : "Break",
        TokenKind.Continue : "Continue",
        TokenKind.Return : "Return",
        TokenKind.Type : "Type",
        TokenKind.Let : "Let",
        TokenKind.SelfType : "SelfType",
        TokenKind.Defer : "Defer",
        TokenKind.Import : "Import",
        TokenKind.Comptime : "Comptime",
        TokenKind.Cast : "Cast",
        TokenKind.Move : "Move",
        TokenKind.Extern : "Extern",
        TokenKind.Private : "Private",
        TokenKind.Asm : "Asm",
        TokenKind.As : "As",
        TokenKind.In : "In",
        TokenKind.Macro : "Macro",
        TokenKind.True : "True",
        TokenKind.False : "False",
        TokenKind.Launch : "Launch",
        TokenKind.Wait : "Wait",
        TokenKind.I8 : "I8",
        TokenKind.I16 : "I16",
        TokenKind.I32 : "I32",
        TokenKind.I64 : "I64",
        TokenKind.I128 : "I128",
        TokenKind.U8 : "U8",
        TokenKind.U16 : "U16",
        TokenKind.U32 : "U32",
        TokenKind.U64 : "U64",
        TokenKind.U128 : "U128",
        TokenKind.F32 : "F32",
        TokenKind.F64 : "F64",
        TokenKind.F80 : "F80",
        TokenKind.C32 : "C32",
        TokenKind.C64 : "C64",
        TokenKind.C80 : "C80",
        TokenKind.Bool : "Bool",
        TokenKind.Str : "Str",
        TokenKind.Char : "Char",
        TokenKind.Void : "Void",
        TokenKind.VecType : "Vec",
        TokenKind.OptionalType : "Optional",
        TokenKind.Plus : "Plus",
        TokenKind.Minus : "Minus",
        TokenKind.Star : "Star",
        TokenKind.Slash : "Slash",
        TokenKind.Percent : "Percent",
        TokenKind.Equal : "Equal",
        TokenKind.NotEqual : "NotEqual",
        TokenKind.Less : "Less",
        TokenKind.Greater : "Greater",
        TokenKind.LessEqual : "LessEqual",
        TokenKind.GreaterEqual : "GreaterEqual",
        TokenKind.And : "And",
        TokenKind.Or : "Or",
        TokenKind.Not : "Not",
        TokenKind.Assign : "Assign",
        TokenKind.PlusAssign : "PlusAssign",
        TokenKind.MinusAssign : "MinusAssign",
        TokenKind.StarAssign : "StarAssign",
        TokenKind.SlashAssign : "SlashAssign",
        TokenKind.PercentAssign : "PercentAssign",
        TokenKind.BitwiseAndAssign : "BitwiseAndAssign",
        TokenKind.BitwiseOrAssign : "BitwiseOrAssign",
        TokenKind.BitwiseXorAssign : "BitwiseXorAssign",
        TokenKind.LeftShiftAssign : "LeftShiftAssign",
        TokenKind.RightShiftAssign : "RightShiftAssign",
        TokenKind.BitwiseAnd : "BitwiseAnd",
        TokenKind.BitwiseOr : "BitwiseOr",
        TokenKind.BitwiseXor : "BitwiseXor",
        TokenKind.BitwiseNot : "BitwiseNot",
