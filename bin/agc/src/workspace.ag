// Stage1 package and workspace planning.
//
// This is deliberately a small TOML reader for the manifest forms used by
// Silver packages. It validates the package boundary and resolves a selected
// target before the native backend is called. The backend can therefore be
// replaced without moving package selection back into the driver.
import std.error;
import std.fs;
import std.io.file;
import std.mem.alloc;
import std.mem.vec;
import std.path;
import std.result;
import std.string;
import std.env;

enum TargetKind {
    Bin;
    Lib;
    Test;
}

struct ManifestDependency {
    str name;
    str manifest;
}

struct ManifestTarget {
    str name;
    TargetKind kind;
    str entry;
    str manifest;
    bool has_entry;
    bool has_manifest;
}

struct PackageManifest {
    u8* text;
    i64 text_capacity;
    i64 text_used;
    str manifest_path;
    str root;
    str name;
    str version;
    str url;
    Vec<ManifestTarget> targets;
    Vec<ManifestDependency> dependencies;
}

impl Drop for PackageManifest {
    void drop(PackageManifest* self) {
        if (self.text != (u8*)0) {
            free(self.text);
            self.text = (u8*)0;
        }
        self.text_capacity = 0;
        self.text_used = 0;
    }
}

struct WorkspacePlan {
    String manifest_path;
    String root;
    String entry;
    String target_name;
    TargetKind target_kind;
    Vec<String> package_roots;
}

struct WorkspaceResolver {
    Vec<String> visited;
    WorkspacePlan* plan;
}

const str MANIFEST_FILE = "silver.toml";

void workspace_set_string(String* destination, str source) {
    destination.clear();
    destination.push_str(source);
}

void workspace_manifest_init(PackageManifest* manifest, str manifest_path, str root) {
    manifest.text = (u8*)0;
    manifest.text_capacity = 0;
    manifest.text_used = 0;
    manifest.manifest_path = manifest_path;
    manifest.root = root;
    manifest.name = "";
    manifest.version = "";
    manifest.url = "";
    manifest.targets = Vec<ManifestTarget>.new();
    manifest.dependencies = Vec<ManifestDependency>.new();
}

str workspace_intern_raw(PackageManifest* manifest, str value) {
    i64 length = strlen(value);
    if (manifest.text_used + length + 1 > manifest.text_capacity) {
        return "";
    }
    u8* result = &manifest.text[manifest.text_used];
    memcpy((void*)result, (const void*)value, length);
    result[length] = (u8)0;
    manifest.text_used += length + 1;
    return (str)result;
}

str workspace_intern_bytes(PackageManifest* manifest, u8* bytes, i64 start, i64 end) {
    while (start < end && workspace_byte_space(bytes[start])) { start += 1; }
    while (end > start && workspace_byte_space(bytes[end - 1])) { end -= 1; }
    if (start >= end) { return ""; }
    if (manifest.text_used + end - start + 1 > manifest.text_capacity) { return ""; }
    u8* result = &manifest.text[manifest.text_used];
    i64 out = 0;
    if (workspace_byte_quote(bytes[start]) && bytes[end - 1] == bytes[start]) {
        i64 i = start + 1;
        while (i < end - 1) {
            u8 ch = bytes[i];
            if (ch == (u8)92 && i + 1 < end - 1) {
                u8 next = bytes[i + 1];
                if (next == (u8)110) { ch = (u8)10; }
                else if (next == (u8)114) { ch = (u8)13; }
                else if (next == (u8)116) { ch = (u8)9; }
                else { ch = next; }
                i += 2;
            } else {
                i += 1;
            }
            result[out] = ch;
            out += 1;
        }
    } else {
        while (start < end) {
            result[out] = bytes[start];
            out += 1;
            start += 1;
        }
    }
    result[out] = (u8)0;
    manifest.text_used += out + 1;
    return (str)result;
}

void workspace_manifest_set_text(PackageManifest* manifest, str source, str manifest_path, str root) {
    i64 source_len = strlen(source);
    i64 capacity = source_len * 2 + 256;
    manifest.text = alloc<u8>(capacity);
    manifest.text_capacity = capacity;
    memcpy((void*)manifest.text, (const void*)source, source_len);
    manifest.text[source_len] = (u8)0;
    manifest.text_used = source_len + 1;
    manifest.manifest_path = workspace_intern_raw(manifest, manifest_path);
    manifest.root = workspace_intern_raw(manifest, root);
}

WorkspacePlan workspace_plan_empty() {
    WorkspacePlan plan;
    plan.manifest_path = String.new();
    plan.root = String.new();
    plan.entry = String.new();
    plan.target_name = String.new();
    plan.target_kind = TargetKind.Bin;
    plan.package_roots = Vec<String>.new();
    return plan;
}

WorkspaceResolver workspace_resolver_new(WorkspacePlan* plan) {
    WorkspaceResolver resolver;
    resolver.visited = Vec<String>.new();
    resolver.plan = plan;
    return resolver;
}

void workspace_error(String* error, str text) {
    error.clear();
    error.push_str(text);
}

void workspace_error_value(String* error, str prefix, str value, str suffix) {
    error.clear();
    error.push_str(prefix);
    error.push_str(value);
    error.push_str(suffix);
}

bool workspace_byte_space(u8 ch) {
    return ch == (u8)32 || ch == (u8)9 || ch == (u8)13;
}

bool workspace_byte_quote(u8 ch) {
    return ch == (u8)34 || ch == (u8)39;
}

bool workspace_kind_from_name(str name, TargetKind* kind) {
    if (strcmp(name, "bin") == 0) { *kind = TargetKind.Bin; return true; }
    if (strcmp(name, "lib") == 0) { *kind = TargetKind.Lib; return true; }
    if (strcmp(name, "test") == 0) { *kind = TargetKind.Test; return true; }
    return false;
}

ManifestTarget* workspace_find_target(Vec<ManifestTarget>* targets, TargetKind kind, str name) {
    i64 i = 0;
    while (i < targets.len()) {
        ManifestTarget* target = targets.get_ptr(i);
        if (target.kind == kind && strcmp(target.name, name) == 0) {
            return target;
        }
        i += 1;
    }
    return (ManifestTarget*)0;
}

ManifestTarget* workspace_ensure_target(PackageManifest* manifest, TargetKind kind, str name) {
    ManifestTarget* existing = workspace_find_target(&manifest.targets, kind, name);
    if (existing != (ManifestTarget*)0) { return existing; }
    ManifestTarget target;
    target.name = workspace_intern_raw(manifest, name);
    target.kind = kind;
    target.entry = "";
    target.manifest = "";
    target.has_entry = false;
    target.has_manifest = false;
    manifest.targets.push(target);
    return manifest.targets.get_ptr(manifest.targets.len - 1);
}

ManifestDependency* workspace_ensure_dependency(PackageManifest* manifest, str name) {
    i64 i = 0;
    while (i < manifest.dependencies.len()) {
        ManifestDependency* dependency = manifest.dependencies.get_ptr(i);
        if (strcmp(dependency.name, name) == 0) { return dependency; }
        i += 1;
    }
    ManifestDependency dependency;
    dependency.name = workspace_intern_raw(manifest, name);
    dependency.manifest = "";
    manifest.dependencies.push(dependency);
    return manifest.dependencies.get_ptr(manifest.dependencies.len - 1);
}

bool workspace_slice_equals(u8* bytes, i64 start, i64 end, str expected) {
    i64 length = strlen(expected);
    if (end - start != length) { return false; }
    i64 i = 0;
    while (i < length) {
        if (bytes[start + i] != expected[i]) { return false; }
        i += 1;
    }
    return true;
}

void workspace_trim_slice(u8* bytes, i64* start, i64* end) {
    while (*start < *end && workspace_byte_space(bytes[*start])) { *start += 1; }
    while (*end > *start && workspace_byte_space(bytes[*end - 1])) { *end -= 1; }
}

bool workspace_quoted_slice(u8* bytes, i64 start, i64 end) {
    workspace_trim_slice(bytes, &start, &end);
    return end - start >= 2 && workspace_byte_quote(bytes[start])
        && bytes[end - 1] == bytes[start];
}

i64 workspace_find_equals(u8* bytes, i64 start, i64 end) {
    u8 quote = (u8)0;
    bool escaped = false;
    i64 i = start;
    while (i < end) {
        u8 ch = bytes[i];
        if (quote != (u8)0) {
            if (escaped) { escaped = false; }
            else if (ch == (u8)92) { escaped = true; }
            else if (ch == quote) { quote = (u8)0; }
        } else if (workspace_byte_quote(ch)) {
            quote = ch;
        } else if (ch == (u8)61) {
            return i;
        }
        i += 1;
    }
    return -1;
}

bool workspace_parse_header_slice(PackageManifest* manifest, u8* bytes, i64 start, i64 end, i64* section, TargetKind* kind, str* target_name, str* dependency_name) {
    workspace_trim_slice(bytes, &start, &end);
    if (end - start < 2 || bytes[start] != (u8)91 || bytes[end - 1] != (u8)93) {
        return false;
    }
    i64 dot = -1;
    u8 quote = (u8)0;
    bool escaped = false;
    i64 i = start + 1;
    while (i < end - 1) {
        u8 ch = bytes[i];
        if (quote != (u8)0) {
            if (escaped) { escaped = false; }
            else if (ch == (u8)92) { escaped = true; }
            else if (ch == quote) { quote = (u8)0; }
        } else if (workspace_byte_quote(ch)) {
            quote = ch;
        } else if (ch == (u8)46) {
            dot = i;
            break;
        }
        i += 1;
    }
    if (dot < 0) { return false; }
    str first = workspace_intern_bytes(manifest, bytes, start + 1, dot);
    str second = workspace_intern_bytes(manifest, bytes, dot + 1, end - 1);
    if (strlen(second) == 0) { return false; }
    *section = 0;
    *target_name = "";
    *dependency_name = "";
    if (strcmp(first, "dependencies") == 0) {
        *section = 2;
        *dependency_name = second;
        return true;
    }
    TargetKind parsed_kind = TargetKind.Bin;
    if (!workspace_kind_from_name(first, &parsed_kind)) { return false; }
    *section = 1;
    *kind = parsed_kind;
    *target_name = second;
    workspace_ensure_target(manifest, parsed_kind, second);
    return true;
}

bool workspace_parse_manifest_text(str manifest_path, str source, PackageManifest* manifest, String* error) {
    String root = path_dirname(manifest_path);
    workspace_manifest_init(manifest, "", "");
    workspace_manifest_set_text(manifest, source, manifest_path, root.to_str());
    root.drop();

    u8* bytes = (u8*)source;
    i64 source_len = strlen(source);
    i64 line_start = 0;
    i64 section = 0;
    TargetKind current_kind = TargetKind.Bin;
    str current_target = "";
    str current_dependency = "";
    while (line_start <= source_len) {
        i64 line_end = line_start;
        while (line_end < source_len && bytes[line_end] != (u8)10) { line_end += 1; }
        i64 effective_end = line_end;
        u8 quote = (u8)0;
        bool escaped = false;
        i64 comment = line_start;
        while (comment < effective_end) {
            u8 ch = bytes[comment];
            if (quote != (u8)0) {
                if (escaped) { escaped = false; }
                else if (ch == (u8)92) { escaped = true; }
                else if (ch == quote) { quote = (u8)0; }
            } else if (workspace_byte_quote(ch)) {
                quote = ch;
            } else if (ch == (u8)35) {
                effective_end = comment;
                break;
            }
            comment += 1;
        }
        i64 start = line_start;
        workspace_trim_slice(bytes, &start, &effective_end);
        if (start < effective_end) {
            if (bytes[start] == (u8)91) {
                if (!workspace_parse_header_slice(manifest, bytes, start, effective_end, &section, &current_kind, &current_target, &current_dependency)) {
                    workspace_error(error, "invalid package manifest table header");
                    return false;
                }
            } else {
                i64 equals = workspace_find_equals(bytes, start, effective_end);
                if (equals < 0) {
                    workspace_error(error, "invalid package manifest assignment");
                    return false;
                }
                i64 key_start = start;
                i64 key_end = equals;
                i64 value_start = equals + 1;
                i64 value_end = effective_end;
                workspace_trim_slice(bytes, &key_start, &key_end);
                workspace_trim_slice(bytes, &value_start, &value_end);
                if (key_start >= key_end || value_start >= value_end) {
                    workspace_error(error, "invalid package manifest assignment");
                    return false;
                }
                if (section == 0) {
                    if (workspace_slice_equals(bytes, key_start, key_end, "name")) {
                        if (strlen(manifest.name) > 0) {
                            workspace_error(error, "duplicate package manifest field `name`");
                            return false;
                        }
                        if (!workspace_quoted_slice(bytes, value_start, value_end)) {
                            workspace_error(error, "package manifest `name` must be a string");
                            return false;
                        }
                        manifest.name = workspace_intern_bytes(manifest, bytes, value_start, value_end);
                    } else if (workspace_slice_equals(bytes, key_start, key_end, "version")) {
                        if (strlen(manifest.version) > 0) {
                            workspace_error(error, "duplicate package manifest field `version`");
                            return false;
                        }
                        if (!workspace_quoted_slice(bytes, value_start, value_end)) {
                            workspace_error(error, "package manifest `version` must be a string");
                            return false;
                        }
                        manifest.version = workspace_intern_bytes(manifest, bytes, value_start, value_end);
                    } else if (workspace_slice_equals(bytes, key_start, key_end, "url")) {
                        if (strlen(manifest.url) > 0) {
                            workspace_error(error, "duplicate package manifest field `url`");
                            return false;
                        }
                        if (!workspace_quoted_slice(bytes, value_start, value_end)) {
                            workspace_error(error, "package manifest `url` must be a string");
                            return false;
                        }
                        manifest.url = workspace_intern_bytes(manifest, bytes, value_start, value_end);
                    } else {
                        workspace_error(error, "unsupported package manifest key");
                        return false;
                    }
                } else if (section == 1 && strlen(current_target) > 0) {
                    ManifestTarget* target = workspace_ensure_target(manifest, current_kind, current_target);
                    if (workspace_slice_equals(bytes, key_start, key_end, "entry")) {
                        if (target.has_entry) {
                            workspace_error(error, "duplicate package target field `entry`");
                            return false;
                        }
                        if (!workspace_quoted_slice(bytes, value_start, value_end)) {
                            workspace_error(error, "package target `entry` must be a string");
                            return false;
                        }
                        target.entry = workspace_intern_bytes(manifest, bytes, value_start, value_end);
                        target.has_entry = true;
                    } else if (workspace_slice_equals(bytes, key_start, key_end, "manifest")) {
                        if (target.has_manifest) {
                            workspace_error(error, "duplicate package target field `manifest`");
                            return false;
                        }
                        if (!workspace_quoted_slice(bytes, value_start, value_end)) {
                            workspace_error(error, "package target `manifest` must be a string");
                            return false;
                        }
                        target.manifest = workspace_intern_bytes(manifest, bytes, value_start, value_end);
                        target.has_manifest = true;
                    } else {
                        workspace_error(error, "unsupported package target key");
                        return false;
                    }
                } else if (section == 2 && strlen(current_dependency) > 0) {
                    if (workspace_slice_equals(bytes, key_start, key_end, "manifest")) {
                        if (!workspace_quoted_slice(bytes, value_start, value_end)) {
                            workspace_error(error, "package dependency `manifest` must be a string");
                            return false;
                        }
                        ManifestDependency* dependency = workspace_ensure_dependency(manifest, current_dependency);
                        dependency.manifest = workspace_intern_bytes(manifest, bytes, value_start, value_end);
                    } else {
                        workspace_error(error, "unsupported package dependency key");
                        return false;
                    }
                }
            }
        }
        if (line_end >= source_len) { break; }
        line_start = line_end + 1;
    }

    if (strlen(manifest.name) == 0 || strlen(manifest.version) == 0) {
        workspace_error(error, "package manifest requires non-empty `name` and `version` fields");
        return false;
    }
    i64 i = 0;
    while (i < manifest.targets.len()) {
        ManifestTarget target = manifest.targets.get(i);
        if (target.has_entry == target.has_manifest) {
            workspace_error(error, "each package target must specify exactly one of `entry` or `manifest`");
            return false;
        }
        if (strlen(target.name) == 0) {
            workspace_error(error, "package target name must not be empty");
            return false;
        }
        i += 1;
    }
    i = 0;
    while (i < manifest.dependencies.len()) {
        ManifestDependency dependency = manifest.dependencies.get(i);
        if (strlen(dependency.manifest) == 0) {
            workspace_error(error, "each package dependency must specify `manifest`");
            return false;
        }
        i += 1;
    }
    return true;
}

bool workspace_read_manifest(str path, PackageManifest* manifest, String* error) {
    Result<String, Error> loaded = String.from_file(path);
    if (loaded.is_err()) {
        workspace_error_value(error, "failed to read package manifest `", path, "`");
        return false;
    }
    String source = loaded.unwrap();
    bool ok = workspace_parse_manifest_text(path, source.to_str(), manifest, error);
    source.drop();
    return ok;
}

bool workspace_contains(Vec<String>* values, str value) {
    i64 i = 0;
    while (i < values.len()) {
        // Borrow the stored root; get() would transfer and drop its String.
        String* item = values.get_ptr(i);
        if (strcmp(item.to_str(), value) == 0) { return true; }
        i += 1;
    }
    return false;
}

void workspace_add_root(WorkspacePlan* plan, str root) {
    if (strlen(root) == 0 || workspace_contains(&plan.package_roots, root)) { return; }
    String owned = String.from_str(root);
    plan.package_roots.push(move owned);
}

bool workspace_select_target(PackageManifest* manifest, TargetKind kind, str requested, ManifestTarget** selected, String* error) {
    i64 count = 0;
    ManifestTarget* package_match = (ManifestTarget*)0;
    ManifestTarget* first = (ManifestTarget*)0;
    i64 i = 0;
    while (i < manifest.targets.len()) {
        ManifestTarget* target = manifest.targets.get_ptr(i);
        if (target.kind == kind) {
            if (first == (ManifestTarget*)0) { first = target; }
            count += 1;
            if (strcmp(target.name, requested) == 0) {
                *selected = target;
                return true;
            }
            if (strlen(manifest.name) > 0 && strcmp(target.name, manifest.name) == 0) {
                package_match = target;
            }
        }
        i += 1;
    }
    if (strlen(requested) > 0) {
        workspace_error_value(error, "package has no `", requested, "` target of the requested kind");
        return false;
    }
    if (package_match != (ManifestTarget*)0) {
        *selected = package_match;
        return true;
    }
    if (count == 1 && first != (ManifestTarget*)0) {
        *selected = first;
        return true;
    }
    workspace_error(error, "package target is ambiguous; select one with `--bin` or `--lib`");
    return false;
}

bool workspace_str_starts_with(str value, str prefix) {
    i64 value_len = strlen(value);
    i64 prefix_len = strlen(prefix);
    if (prefix_len > value_len) { return false; }
    i64 i = 0;
    while (i < prefix_len) {
        if (value[i] != prefix[i]) { return false; }
        i += 1;
    }
    return true;
}

bool workspace_is_absolute(str path) {
    return strlen(path) > 0 && path[0] == (u8)47;
}

void workspace_make_absolute(String* output, str path) {
    if (workspace_is_absolute(path)) {
        String normalized = path_normalize(path);
        workspace_set_string(output, normalized.to_str());
        normalized.drop();
        return;
    }
    String cwd = current_dir();
    String joined = path_join(cwd.to_str(), path);
    cwd.drop();
    String normalized = path_normalize(joined.to_str());
    joined.drop();
    workspace_set_string(output, normalized.to_str());
    normalized.drop();
}

bool workspace_manifest_target_path(ManifestTarget* target, str root, String* path, String* error) {
    str relative = strlen(target.entry) > 0 ? target.entry : target.manifest;
    if (workspace_is_absolute(relative)) {
        workspace_error(error, "package target paths must be relative to the manifest");
        return false;
    }
    String joined = path_join(root, relative);
    String normalized_path = path_normalize(joined.to_str());
    if (!target.has_entry && is_dir(normalized_path.to_str())) {
        String manifest_path = path_join(normalized_path.to_str(), MANIFEST_FILE);
        workspace_set_string(path, manifest_path.to_str());
        manifest_path.drop();
    } else {
        workspace_set_string(path, normalized_path.to_str());
    }
    normalized_path.drop();
    joined.drop();
    return true;
}

bool workspace_visit_manifest(WorkspaceResolver* resolver, str manifest_path, TargetKind kind, str requested, i64 depth, String* error) {
    if (depth > 64) {
        workspace_error(error, "package manifest reference cycle is too deep");
        return false;
    }
    String normalized = path_normalize(manifest_path);
    if (workspace_contains(&resolver.visited, normalized.to_str())) {
        normalized.drop();
        return true;
    }
    String visited = String.from_str(normalized.to_str());
    resolver.visited.push(move visited);
    normalized.drop();

    PackageManifest manifest;
    workspace_manifest_init(&manifest, "", "");
    if (!workspace_read_manifest(manifest_path, &manifest, error)) {

        return false;
    }
    String root = String.from_str(manifest.root);
    workspace_add_root(resolver.plan, root.to_str());
    workspace_set_string(&resolver.plan.manifest_path, manifest_path);
    workspace_set_string(&resolver.plan.root, root.to_str());

    ManifestTarget* target = (ManifestTarget*)0;
    if (!workspace_select_target(&manifest, kind, requested, &target, error)) {

        return false;
    }
    workspace_set_string(&resolver.plan.target_name, target.name);
    resolver.plan.target_kind = target.kind;
    if (target.has_entry) {
        String entry = String.new();
        if (!workspace_manifest_target_path(target, root.to_str(), &entry, error)) {

            return false;
        }
        if (!file_exists(entry.to_str())) {
            workspace_error_value(error, "selected package target has no source entry at `", entry.to_str(), "`");
            entry.drop();

            return false;
        }
        resolver.plan.entry = move entry;
    } else {
        if (workspace_str_starts_with(target.manifest, "git+")) {
            workspace_error(error, "Git package targets are not supported by the stage1 resolver yet");

            return false;
        }
        String child = String.new();
        if (!workspace_manifest_target_path(target, root.to_str(), &child, error)) {

            return false;
        }
        String child_name = String.from_str(target.name);

        bool ok = workspace_visit_manifest(resolver, child.to_str(), kind, child_name.to_str(), depth + 1, error);
        child_name.drop();
        child.drop();
        return ok;
    }

    i64 i = 0;
    while (i < manifest.dependencies.len()) {
        ManifestDependency dependency = manifest.dependencies.get(i);
        if (workspace_str_starts_with(dependency.manifest, "git+")) {
            workspace_error(error, "Git package dependencies are not supported by the stage1 resolver yet");

            return false;
        }
        String dependency_path = path_join(root.to_str(), dependency.manifest);
        String normalized_dependency = path_normalize(dependency_path.to_str());
        dependency_path.drop();
        if (!workspace_path_is_manifest(dependency.manifest) && is_dir(normalized_dependency.to_str())) {
            String manifest_path = path_join(normalized_dependency.to_str(), MANIFEST_FILE);
            workspace_set_string(&normalized_dependency, manifest_path.to_str());
            manifest_path.drop();
        }
        if (!file_exists(normalized_dependency.to_str())) {
            workspace_error_value(error, "package dependency manifest not found: `", dependency.manifest, "`");
            normalized_dependency.drop();
            return false;
        }
        PackageManifest child_manifest;
        workspace_manifest_init(&child_manifest, "", "");
        String child_error = String.new();
        if (!workspace_read_manifest(normalized_dependency.to_str(), &child_manifest, &child_error)) {
            workspace_error(error, child_error.to_str());
            child_error.drop();
            normalized_dependency.drop();
            return false;
        }
        child_error.drop();
        String child_root = String.from_str(child_manifest.root);
        workspace_add_root(resolver.plan, child_root.to_str());
        child_root.drop();
        normalized_dependency.drop();
        i += 1;
    }

    return true;
}

bool workspace_plan_for_manifest(str manifest_path, TargetKind kind, str requested, WorkspacePlan* plan, String* error) {
    WorkspaceResolver resolver = workspace_resolver_new(plan);
    bool ok = workspace_visit_manifest(&resolver, manifest_path, kind, requested, 0, error);
    resolver.visited.drop();
    return ok;
}

bool workspace_path_is_manifest(str path) {
    String base = path_basename(path);
    bool result = base.equals(MANIFEST_FILE);
    base.drop();
    return result;
}

void workspace_plan_drop(WorkspacePlan* plan) {
    plan.package_roots.drop();
    plan.manifest_path.drop();
    plan.root.drop();
    plan.entry.drop();
    plan.target_name.drop();
}

bool workspace_plan_from_manifest(str manifest_path, TargetKind kind, str requested, WorkspacePlan* plan, String* error) {
    String absolute = String.new();
    workspace_make_absolute(&absolute, manifest_path);
    String normalized = path_normalize(absolute.to_str());
    workspace_set_string(&plan.manifest_path, normalized.to_str());
    String root = path_dirname(normalized.to_str());
    workspace_set_string(&plan.root, root.to_str());
    bool ok = workspace_plan_for_manifest(normalized.to_str(), kind, requested, plan, error);
    normalized.drop();
    root.drop();
    absolute.drop();
    return ok;
}

bool workspace_default_manifest(str* path) {
    String cwd = current_dir();
    String candidate = path_join(cwd.to_str(), MANIFEST_FILE);
    cwd.drop();
    if (file_exists(candidate.to_str())) {
        *path = move candidate;
        return true;
    }
    candidate.drop();
    return false;
}

bool workspace_manifest_file(str path) {
    if (workspace_path_is_manifest(path)) { return true; }
    // A direct input has no manifest context, so preserve source suffixes.
    if (is_dir(path) || !file_exists(path)) { return false; }
    String value = String.from_str(path);
    bool result = !value.ends_with(".ag") && !value.ends_with(".agm");
    value.drop();
    return result;
}

bool workspace_manifest_input(str input, String* manifest) {
    if (workspace_manifest_file(input)) {
        workspace_set_string(manifest, input);
        return true;
    }
    if (is_dir(input)) {
        String candidate = path_join(input, MANIFEST_FILE);
        if (file_exists(candidate.to_str())) {
            *manifest = move candidate;
            return true;
        }
        candidate.drop();
    }
    return false;
}

bool workspace_is_command(str value) {
    return strcmp(value, "build") == 0 || strcmp(value, "b") == 0
        || strcmp(value, "run") == 0 || strcmp(value, "r") == 0
        || strcmp(value, "check") == 0 || strcmp(value, "c") == 0
        || strcmp(value, "test") == 0 || strcmp(value, "t") == 0
        || strcmp(value, "init") == 0 || strcmp(value, "clean") == 0;
}

bool workspace_is_terminal_option(str value) {
    return strcmp(value, "--help") == 0 || strcmp(value, "-h") == 0
        || strcmp(value, "--version") == 0 || strcmp(value, "-V") == 0
        || strcmp(value, "--cache-info") == 0 || strcmp(value, "--cache-prune") == 0
        || strcmp(value, "--init") == 0 || strcmp(value, "--clean") == 0
        || workspace_str_starts_with(value, "--cache-prune=");
}

bool workspace_selector_consumes_value(Vec<String>* arguments, i64 index) {
    String* selector = arguments.get_ptr(index);
    if (strcmp(selector.to_str(), "--bin") != 0
        && strcmp(selector.to_str(), "--lib") != 0) {
        return false;
    }
    if (index + 1 >= arguments.len()) { return false; }
    String* next = arguments.get_ptr(index + 1);
    if (next.starts_with("-") || workspace_is_command(next.to_str())) { return false; }
    String candidate = String.new();
    bool manifest = workspace_manifest_input(next.to_str(), &candidate);
    candidate.drop();
    if (manifest || is_dir(next.to_str())) { return false; }
    if (next.ends_with(".ag")) { return false; }
    return true;
}

bool workspace_option_consumes_value(Vec<String>* arguments, i64 index) {
    String* option = arguments.get_ptr(index);
    if (strcmp(option.to_str(), "--bin") == 0 || strcmp(option.to_str(), "--lib") == 0) {
        return workspace_selector_consumes_value(arguments, index);
    }
    return strcmp(option.to_str(), "-o") == 0 || strcmp(option.to_str(), "--output") == 0
        || strcmp(option.to_str(), "-I") == 0 || strcmp(option.to_str(), "--root") == 0
        || strcmp(option.to_str(), "-D") == 0 || strcmp(option.to_str(), "-L") == 0
        || strcmp(option.to_str(), "-l") == 0 || strcmp(option.to_str(), "-W") == 0
        || strcmp(option.to_str(), "--target") == 0 || strcmp(option.to_str(), "--sysroot") == 0
        || strcmp(option.to_str(), "--cfg") == 0 || strcmp(option.to_str(), "--cache-dir") == 0
        || strcmp(option.to_str(), "-j") == 0 || strcmp(option.to_str(), "--jobs") == 0
        || strcmp(option.to_str(), "--emit") == 0 || strcmp(option.to_str(), "--run-arg") == 0;
}

i64 workspace_command_index(Vec<String>* arguments) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return -1; }
        if (argument.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        if (workspace_is_command(argument.to_str())) { return i; }
        return -1;
    }
    return -1;
}

bool workspace_argument_is_option(String* argument, str option) {
    if (argument.equals(option)) { return true; }
    i64 option_len = strlen(option);
    return argument.len > option_len + 1 && argument.starts_with(option)
        && argument.data[option_len] == (u8)61;
}

bool workspace_has_option(Vec<String>* arguments, str option) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (workspace_argument_is_option(argument, option)) { return true; }
        if (argument.equals("--")) { return false; }
        i += 1;
    }
    return false;
}

bool workspace_option_value(Vec<String>* arguments, str option, String* value) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.equals(option)) {
            bool optional_selector = strcmp(option, "--bin") == 0 || strcmp(option, "--lib") == 0;
            if (!optional_selector || workspace_selector_consumes_value(arguments, i)) {
                if (i + 1 >= arguments.len()) { return false; }
                workspace_set_string(value, arguments.get_ptr(i + 1).to_str());
                return true;
            }
        } else if (argument.len > strlen(option) + 1 && argument.starts_with(option)
            && argument.data[strlen(option)] == (u8)61) {
            String suffix = argument.strip_prefix(option);
            String equals_value = suffix.strip_prefix("=");
            workspace_set_string(value, equals_value.to_str());
            equals_value.drop();
            suffix.drop();
            return true;
        }
        i += 1;
    }
    return false;
}

bool workspace_find_package_input(Vec<String>* arguments, i64 command_index, String* input) {
    i64 start = command_index < 0 ? 1 : command_index + 1;
    i64 i = start;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        if (workspace_manifest_input(argument.to_str(), input)) { return true; }
        i += 1;
    }
    return false;
}

bool workspace_package_kind(Vec<String>* arguments, TargetKind* kind, String* requested) {
    requested.clear();
    bool is_lib = workspace_has_option(arguments, "--lib");
    bool is_bin = workspace_has_option(arguments, "--bin");
    if (is_lib && is_bin) { return false; }
    *kind = is_lib ? TargetKind.Lib : TargetKind.Bin;
    if (is_lib || is_bin) {
        String value = String.new();
        if (workspace_option_value(arguments, is_lib ? "--lib" : "--bin", &value)
            && value.len > 0) {
            requested.push_str(value.to_str());
        }
        value.drop();
    }
    return true;
}

bool workspace_has_positional_input(Vec<String>* arguments, i64 command_index) {
    i64 start = command_index < 0 ? 1 : command_index + 1;
    i64 i = start;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        return true;
    }
    return false;
}

bool workspace_has_grammar_emit(Vec<String>* arguments) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.equals("--emit=grammar")) { return true; }
        if (argument.equals("--emit") && i + 1 < arguments.len()
            && arguments.get_ptr(i + 1).equals("grammar")) { return true; }
        i += 1;
    }
    return false;
}

bool workspace_package_arguments(Vec<String>* arguments, WorkspacePlan* plan, bool* has_package, String* error) {
    *has_package = false;
    i64 command_index = workspace_command_index(arguments);
    if (command_index >= 0) {
        String* command = arguments.get_ptr(command_index);
        if (command.equals("init") || command.equals("clean")
            || command.equals("test") || command.equals("t")) {
            return true;
        }
        if (!workspace_is_command(command.to_str())) { return true; }
    } else {
        i64 option = 1;
        while (option < arguments.len()) {
            String* argument = arguments.get_ptr(option);
            if (argument.equals("--") || workspace_is_terminal_option(argument.to_str())) {
                return true;
            }
            option += 1;
        }
    }
    String input = String.new();
    bool found = workspace_find_package_input(arguments, command_index, &input);
    if (!found) {
        if (command_index < 0 || workspace_has_positional_input(arguments, command_index)
            || workspace_has_grammar_emit(arguments)) {
            return true;
        }
        if (!workspace_default_manifest(&input)) { return true; }
    }
    TargetKind kind = TargetKind.Bin;
    String requested = String.new();
    if (!workspace_package_kind(arguments, &kind, &requested)) {
        workspace_error(error, "only one of `--bin` or `--lib` may be specified");
        input.drop();
        requested.drop();
        return false;
    }
    if (!workspace_plan_from_manifest(input.to_str(), kind, requested.to_str(), plan, error)) {
        input.drop();
        requested.drop();
        return false;
    }
    input.drop();
    requested.drop();
    *has_package = true;
    return true;
}

void workspace_collect_roots(WorkspacePlan* plan, Vec<String>* include_dirs) {
    i64 i = 0;
    while (i < plan.package_roots.len()) {
        String* root = plan.package_roots.get_ptr(i);
        include_dirs.push(String.from_str(root.to_str()));
        String source = path_join(root.to_str(), "src");
        include_dirs.push(move source);
        String lib = path_join(root.to_str(), "lib/silver");
        include_dirs.push(move lib);
        i += 1;
    }
}
