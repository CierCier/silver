// Stage1 package and workspace planning.
//
// Manifest syntax is shared with editor tooling; this module selects build
// targets and prepares driver arguments before invoking the native backend.
import std.error;
import std.fs;
import std.io.file;
import std.mem.alloc;
import std.mem.vec;
import std.path;
import std.result;
import std.string;
import std.env;
import std.cli;
import std.process;
import project.manifest;


/// The resolved build target of a package command: manifest, root, entry
/// file, target name and kind, and every package root for imports.
struct WorkspacePlan {
    String manifest_path;
    String root;
    String entry;
    String target_name;
    TargetKind target_kind;
    Vec<String> package_roots;
}

/// Manifest traversal state; `visited` stops reference cycles.
struct WorkspaceResolver {
    Vec<String> visited;
    WorkspacePlan* plan;
}




/// Returns an empty plan.
WorkspacePlan workspace_plan_empty() {
    WorkspacePlan plan;
    plan.manifest_path = String.new();
    plan.root = String.new();
    plan.entry = String.new();
    plan.target_name = String.new();
    plan.target_kind = TargetKind.Bin;
    plan.package_roots = Vec<String>.new();
    return plan;
}

/// Returns a resolver that fills `plan`.
WorkspaceResolver workspace_resolver_new(WorkspacePlan* plan) {
    WorkspaceResolver resolver;
    resolver.visited = Vec<String>.new();
    resolver.plan = plan;
    return resolver;
}


/// Returns true when `value` is in `values`.
bool workspace_contains(Vec<String>* values, str value) {
    i64 i = 0;
    while (i < values.len()) {
        // Borrow the stored root; get() would transfer and drop its String.
        String* item = values.get_ptr(i);
        if (strcmp(item.to_str(), value) == 0) { return true; }
        i += 1;
    }
    return false;
}

/// Adds `root` to the plan's package roots unless empty or present.
void workspace_add_root(WorkspacePlan* plan, str root) {
    if (strlen(root) == 0 || workspace_contains(&plan.package_roots, root)) { return; }
    String owned = String.from_str(root);
    plan.package_roots.push(move owned);
}

/// Selects the target to build: the one named `requested` (of `kind` when
/// explicit), else the manifest's default target, else the only matching
/// one. Writes an error when the choice is missing or ambiguous.
bool workspace_select_target(PackageManifest* manifest, TargetKind kind, bool has_explicit_kind, str requested, ManifestTarget** selected, String* error) {
    if (strlen(requested) > 0) {
        i64 i = 0;
        while (i < manifest.targets.len()) {
            ManifestTarget* target = manifest.targets.get_ptr(i);
            if ((!has_explicit_kind || target.kind == kind) && strcmp(target.name, requested) == 0) {
                *selected = target;
                return true;
            }
            i += 1;
        }
        workspace_error_value(error, "package has no `", requested, "` target of the requested kind");
        return false;
    }

    if (!has_explicit_kind) {
        if (strlen(manifest.default_target) > 0) {
            i64 i = 0;
            while (i < manifest.targets.len()) {
                ManifestTarget* target = manifest.targets.get_ptr(i);
                if (strcmp(target.name, manifest.default_target) == 0) {
                    *selected = target;
                    return true;
                }
                i += 1;
            }
        }
        i64 i = 0;
        while (i < manifest.targets.len()) {
            ManifestTarget* target = manifest.targets.get_ptr(i);
            if (target.is_default) {
                *selected = target;
                return true;
            }
            i += 1;
        }
        if (strlen(manifest.name) > 0) {
            i64 i = 0;
            while (i < manifest.targets.len()) {
                ManifestTarget* target = manifest.targets.get_ptr(i);
                if (strcmp(target.name, manifest.name) == 0) {
                    *selected = target;
                    return true;
                }
                i += 1;
            }
        }
        i64 bin_count = 0;
        ManifestTarget* bin_first = (ManifestTarget*)0;
        i64 j = 0;
        while (j < manifest.targets.len()) {
            ManifestTarget* target = manifest.targets.get_ptr(j);
            if (target.kind == TargetKind.Bin) {
                if (bin_first == (ManifestTarget*)0) { bin_first = target; }
                bin_count += 1;
            }
            j += 1;
        }
        if (bin_count == 1 && bin_first != (ManifestTarget*)0) {
            *selected = bin_first;
            return true;
        }
        if (bin_count > 1) {
            workspace_error(error, "package target is ambiguous; select one with `--bin` or `--lib`");
            return false;
        }
        i64 lib_count = 0;
        ManifestTarget* lib_first = (ManifestTarget*)0;
        j = 0;
        while (j < manifest.targets.len()) {
            ManifestTarget* target = manifest.targets.get_ptr(j);
            if (target.kind == TargetKind.Lib) {
                if (lib_first == (ManifestTarget*)0) { lib_first = target; }
                lib_count += 1;
            }
            j += 1;
        }
        if (lib_count == 1 && lib_first != (ManifestTarget*)0) {
            *selected = lib_first;
            return true;
        }
        workspace_error(error, "package target is ambiguous; select one with `--bin` or `--lib`");
        return false;
    }

    i64 count = 0;
    ManifestTarget* first = (ManifestTarget*)0;
    ManifestTarget* package_match = (ManifestTarget*)0;
    ManifestTarget* default_target_match = (ManifestTarget*)0;
    ManifestTarget* is_default_match = (ManifestTarget*)0;
    i64 i = 0;
    while (i < manifest.targets.len()) {
        ManifestTarget* target = manifest.targets.get_ptr(i);
        if (target.kind == kind) {
            if (first == (ManifestTarget*)0) { first = target; }
            count += 1;
            if (strlen(manifest.default_target) > 0 && strcmp(target.name, manifest.default_target) == 0) {
                default_target_match = target;
            }
            if (target.is_default) {
                is_default_match = target;
            }
            if (strlen(manifest.name) > 0 && strcmp(target.name, manifest.name) == 0) {
                package_match = target;
            }
        }
        i += 1;
    }
    if (default_target_match != (ManifestTarget*)0) {
        *selected = default_target_match;
        return true;
    }
    if (is_default_match != (ManifestTarget*)0) {
        *selected = is_default_match;
        return true;
    }
    if (package_match != (ManifestTarget*)0) {
        *selected = package_match;
        return true;
    }
    if (count == 1 && first != (ManifestTarget*)0) {
        *selected = first;
        return true;
    }
    workspace_error(error, "package target is ambiguous; select one with `--bin` or `--lib`");
    return false;
}

/// Returns true when `value` starts with `prefix`.
bool workspace_str_starts_with(str value, str prefix) {
    i64 value_len = strlen(value);
    i64 prefix_len = strlen(prefix);
    if (prefix_len > value_len) { return false; }
    i64 i = 0;
    while (i < prefix_len) {
        if (value[i] != prefix[i]) { return false; }
        i += 1;
    }
    return true;
}


/// Writes `path` made absolute against the current directory, normalized.
void workspace_make_absolute(String* output, str path) {
    if (workspace_is_absolute(path)) {
        String normalized = path_normalize(path);
        workspace_set_string(output, normalized.to_str());
        normalized.drop();
        return;
    }
    String cwd = current_dir();
    String joined = path_join(cwd.to_str(), path);
    cwd.drop();
    String normalized = path_normalize(joined.to_str());
    joined.drop();
    workspace_set_string(output, normalized.to_str());
    normalized.drop();
}


/// Visits one manifest: records its root and follows a nested-manifest
/// target or dependency manifests, up to depth 64.
bool workspace_visit_manifest(WorkspaceResolver* resolver, str manifest_path, TargetKind kind, bool has_explicit_kind, str requested, i64 depth, String* error) {
    if (depth > 64) {
        workspace_error(error, "package manifest reference cycle is too deep");
        return false;
    }
    String normalized = path_normalize(manifest_path);
    if (workspace_contains(&resolver.visited, normalized.to_str())) {
        normalized.drop();
        return true;
    }
    String visited = String.from_str(normalized.to_str());
    resolver.visited.push(move visited);
    normalized.drop();

    PackageManifest manifest;
    workspace_manifest_init(&manifest, "", "");
    if (!workspace_read_manifest(manifest_path, &manifest, error)) {

        return false;
    }
    String root = String.from_str(manifest.root);
    workspace_add_root(resolver.plan, root.to_str());
    workspace_set_string(&resolver.plan.manifest_path, manifest_path);
    workspace_set_string(&resolver.plan.root, root.to_str());

    ManifestTarget* target = (ManifestTarget*)0;
    if (!workspace_select_target(&manifest, kind, has_explicit_kind, requested, &target, error)) {

        return false;
    }
    workspace_set_string(&resolver.plan.target_name, target.name);
    resolver.plan.target_kind = target.kind;
    if (target.has_entry) {
        String entry = String.new();
        if (!workspace_manifest_target_path(target, root.to_str(), &entry, error)) {

            return false;
        }
        if (!file_exists(entry.to_str())) {
            workspace_error_value(error, "selected package target has no source entry at `", entry.to_str(), "`");
            entry.drop();

            return false;
        }
        resolver.plan.entry = move entry;
    } else {
        if (workspace_str_starts_with(target.manifest, "git+")) {
            workspace_error(error, "Git package targets are not supported by the stage1 resolver yet");

            return false;
        }
        String child = String.new();
        if (!workspace_manifest_target_path(target, root.to_str(), &child, error)) {

            return false;
        }
        String child_name = String.from_str(target.name);

        bool ok = workspace_visit_manifest(resolver, child.to_str(), kind, has_explicit_kind, child_name.to_str(), depth + 1, error);
        child_name.drop();
        child.drop();
        return ok;
    }

    i64 i = 0;
    while (i < manifest.dependencies.len()) {
        ManifestDependency dependency = manifest.dependencies.get(i);
        if (workspace_str_starts_with(dependency.manifest, "git+")) {
            workspace_error(error, "Git package dependencies are not supported by the stage1 resolver yet");

            return false;
        }
        String dependency_path = path_join(root.to_str(), dependency.manifest);
        String normalized_dependency = path_normalize(dependency_path.to_str());
        dependency_path.drop();
        if (!workspace_path_is_manifest(dependency.manifest) && is_dir(normalized_dependency.to_str())) {
            String manifest_path = path_join(normalized_dependency.to_str(), MANIFEST_FILE);
            workspace_set_string(&normalized_dependency, manifest_path.to_str());
            manifest_path.drop();
        }
        if (!file_exists(normalized_dependency.to_str())) {
            workspace_error_value(error, "package dependency manifest not found: `", dependency.manifest, "`");
            normalized_dependency.drop();
            return false;
        }
        PackageManifest child_manifest;
        workspace_manifest_init(&child_manifest, "", "");
        String child_error = String.new();
        if (!workspace_read_manifest(normalized_dependency.to_str(), &child_manifest, &child_error)) {
            workspace_error(error, child_error.to_str());
            child_error.drop();
            normalized_dependency.drop();
            return false;
        }
        child_error.drop();
        String child_root = String.from_str(child_manifest.root);
        workspace_add_root(resolver.plan, child_root.to_str());
        child_root.drop();
        normalized_dependency.drop();
        i += 1;
    }

    return true;
}

/// Resolves `manifest_path` into `plan`.
bool workspace_plan_for_manifest(str manifest_path, TargetKind kind, bool has_explicit_kind, str requested, WorkspacePlan* plan, String* error) {
    WorkspaceResolver resolver = workspace_resolver_new(plan);
    bool ok = workspace_visit_manifest(&resolver, manifest_path, kind, has_explicit_kind, requested, 0, error);
    resolver.visited.drop();
    return ok;
}

/// Returns true when `path`'s file name is `silver.toml`.
bool workspace_path_is_manifest(str path) {
    String base = path_basename(path);
    bool result = base.equals(MANIFEST_FILE);
    base.drop();
    return result;
}

/// Frees everything a plan owns.
void workspace_plan_drop(WorkspacePlan* plan) {
    plan.package_roots.drop();
    plan.manifest_path.drop();
    plan.root.drop();
    plan.entry.drop();
    plan.target_name.drop();
}

/// Resolves a plan from a manifest path given relative to the current
/// directory.
bool workspace_plan_from_manifest(str manifest_path, TargetKind kind, bool has_explicit_kind, str requested, WorkspacePlan* plan, String* error) {
    String absolute = String.new();
    workspace_make_absolute(&absolute, manifest_path);
    String normalized = path_normalize(absolute.to_str());
    workspace_set_string(&plan.manifest_path, normalized.to_str());
    String root = path_dirname(normalized.to_str());
    workspace_set_string(&plan.root, root.to_str());
    bool ok = workspace_plan_for_manifest(normalized.to_str(), kind, has_explicit_kind, requested, plan, error);
    normalized.drop();
    root.drop();
    absolute.drop();
    return ok;
}

/// Sets `*path` to `./silver.toml` when it exists; false otherwise.
bool workspace_default_manifest(str* path) {
    String cwd = current_dir();
    String candidate = path_join(cwd.to_str(), MANIFEST_FILE);
    cwd.drop();
    if (file_exists(candidate.to_str())) {
        *path = move candidate;
        return true;
    }
    candidate.drop();
    return false;
}

/// Returns true when `path` names a manifest file (by name or by content).
bool workspace_manifest_file(str path) {
    if (workspace_path_is_manifest(path)) { return true; }
    // A direct input has no manifest context, so preserve source suffixes.
    if (is_dir(path) || !file_exists(path)) { return false; }
    String value = String.from_str(path);
    bool result = !value.ends_with(".ag") && !value.ends_with(".agm");
    value.drop();
    if (!result) { return false; }
    File f = File.open_read(path);
    if (!f.valid()) { return false; }
    u8 magic = (u8)0;
    i64 n = f.read((void*)&magic, 1, 1);
    f.close();
    if (n > 0 && magic == (u8)127) { return false; }
    return true;
}

/// Writes the manifest for a package input (a manifest file or a directory
/// holding one); false when `input` is not a package.
bool workspace_manifest_input(str input, String* manifest) {
    if (workspace_manifest_file(input)) {
        workspace_set_string(manifest, input);
        return true;
    }
    if (is_dir(input)) {
        String candidate = path_join(input, MANIFEST_FILE);
        if (file_exists(candidate.to_str())) {
            *manifest = move candidate;
            return true;
        }
        candidate.drop();
    }
    return false;
}

/// Returns true for a package command name or alias.
bool workspace_is_command(str value) {
    return strcmp(value, "build") == 0 || strcmp(value, "b") == 0
        || strcmp(value, "run") == 0 || strcmp(value, "r") == 0
        || strcmp(value, "check") == 0 || strcmp(value, "c") == 0
        || strcmp(value, "test") == 0 || strcmp(value, "t") == 0
        || strcmp(value, "init") == 0 || strcmp(value, "clean") == 0;
}

/// Returns true for options that print and exit (`--help`, `--version`,
/// cache info).
bool workspace_is_terminal_option(str value) {
    return strcmp(value, "--help") == 0 || strcmp(value, "-h") == 0
        || strcmp(value, "--version") == 0 || strcmp(value, "-V") == 0
        || strcmp(value, "--cache-info") == 0 || strcmp(value, "--cache-prune") == 0
        || strcmp(value, "--init") == 0 || strcmp(value, "--clean") == 0
        || workspace_str_starts_with(value, "--cache-prune=");
}

/// Returns true when `--bin`/`--lib` at `index` takes the next argument as a
/// target name.
bool workspace_selector_consumes_value(Vec<String>* arguments, i64 index) {
    String* selector = arguments.get_ptr(index);
    if (strcmp(selector.to_str(), "--bin") != 0
        && strcmp(selector.to_str(), "--lib") != 0) {
        return false;
    }
    if (index + 1 >= arguments.len()) { return false; }
    String* next = arguments.get_ptr(index + 1);
    if (next.starts_with("-") || workspace_is_command(next.to_str())) { return false; }
    if (workspace_has_later_input(arguments, index + 1)) { return true; }
    String candidate = String.new();
    bool manifest = workspace_manifest_input(next.to_str(), &candidate);
    candidate.drop();
    if (manifest || is_dir(next.to_str())) { return false; }
    if (next.ends_with(".ag")) { return false; }
    return true;
}

/// Returns true when the option at `index` takes the next argument.
bool workspace_option_consumes_value(Vec<String>* arguments, i64 index) {
    String* option = arguments.get_ptr(index);
    if (strcmp(option.to_str(), "--bin") == 0 || strcmp(option.to_str(), "--lib") == 0) {
        return workspace_selector_consumes_value(arguments, index);
    }
    return strcmp(option.to_str(), "-o") == 0 || strcmp(option.to_str(), "--output") == 0
        || strcmp(option.to_str(), "-I") == 0 || strcmp(option.to_str(), "--root") == 0
        || strcmp(option.to_str(), "-D") == 0 || strcmp(option.to_str(), "-L") == 0
        || strcmp(option.to_str(), "-l") == 0 || strcmp(option.to_str(), "-W") == 0
        || strcmp(option.to_str(), "--target") == 0 || strcmp(option.to_str(), "--sysroot") == 0
        || strcmp(option.to_str(), "--cfg") == 0 || strcmp(option.to_str(), "--cache-dir") == 0
        || strcmp(option.to_str(), "--manifest") == 0
        || strcmp(option.to_str(), "-j") == 0 || strcmp(option.to_str(), "--jobs") == 0
        || strcmp(option.to_str(), "--emit") == 0 || strcmp(option.to_str(), "--run-arg") == 0;
}

/// Returns true when another input follows `after_index`.
bool workspace_has_later_input(Vec<String>* arguments, i64 after_index) {
    i64 i = after_index + 1;
    while (i < arguments.len()) {
        String* arg = arguments.get_ptr(i);
        if (arg.equals("--")) { return false; }
        if (arg.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) { i += 2; }
            else { i += 1; }
            continue;
        }
        if (!workspace_is_command(arg.to_str())) { return true; }
        i += 1;
    }
    return false;
}

/// Returns the index of the command argument, or -1.
i64 workspace_command_index(Vec<String>* arguments) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return -1; }
        if (argument.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        if (workspace_is_command(argument.to_str())) { return i; }
        return -1;
    }
    return -1;
}

/// Returns true when `argument` is `option` or `option=value`.
bool workspace_argument_is_option(String* argument, str option) {
    if (argument.equals(option)) { return true; }
    i64 option_len = strlen(option);
    return argument.len > option_len + 1 && argument.starts_with(option)
        && argument.data[option_len] == (u8)61;
}

/// Returns true when the command line contains `option`.
bool workspace_has_option(Vec<String>* arguments, str option) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (workspace_argument_is_option(argument, option)) { return true; }
        if (argument.equals("--")) { return false; }
        i += 1;
    }
    return false;
}

/// Writes the value of `option` (`option value` or `option=value`).
bool workspace_option_value(Vec<String>* arguments, str option, String* value) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.equals(option)) {
            bool optional_selector = strcmp(option, "--bin") == 0 || strcmp(option, "--lib") == 0;
            if (!optional_selector || workspace_selector_consumes_value(arguments, i)) {
                if (i + 1 >= arguments.len()) { return false; }
                workspace_set_string(value, arguments.get_ptr(i + 1).to_str());
                return true;
            }
        } else if (argument.len > strlen(option) + 1 && argument.starts_with(option)
            && argument.data[strlen(option)] == (u8)61) {
            String suffix = argument.strip_prefix(option);
            String equals_value = suffix.strip_prefix("=");
            workspace_set_string(value, equals_value.to_str());
            equals_value.drop();
            suffix.drop();
            return true;
        }
        i += 1;
    }
    return false;
}

/// Writes the first package input after the command.
bool workspace_find_package_input(Vec<String>* arguments, i64 command_index, String* input) {
    i64 start = command_index < 0 ? 1 : command_index + 1;
    i64 i = start;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        if (workspace_manifest_input(argument.to_str(), input)) { return true; }
        i += 1;
    }
    return false;
}

/// Reads `--bin`/`--lib` target selection from the command line.
bool workspace_package_kind(Vec<String>* arguments, TargetKind* kind, String* requested, bool* has_explicit_kind) {
    requested.clear();
    bool is_lib = workspace_has_option(arguments, "--lib");
    bool is_bin = workspace_has_option(arguments, "--bin");
    if (is_lib && is_bin) { return false; }
    *has_explicit_kind = is_lib || is_bin;
    *kind = is_lib ? TargetKind.Lib : TargetKind.Bin;
    if (is_lib || is_bin) {
        String value = String.new();
        if (workspace_option_value(arguments, is_lib ? "--lib" : "--bin", &value)
            && value.len > 0) {
            requested.push_str(value.to_str());
        }
        value.drop();
    }
    return true;
}

/// Returns true when the command has a positional (non-option) input.
bool workspace_has_positional_input(Vec<String>* arguments, i64 command_index) {
    i64 start = command_index < 0 ? 1 : command_index + 1;
    i64 i = start;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.starts_with("-")) {
            if (workspace_option_consumes_value(arguments, i)) {
                i += 2;
            } else {
                i += 1;
            }
            continue;
        }
        return true;
    }
    return false;
}

/// Returns true when a grammar emit option is present.
bool workspace_has_grammar_emit(Vec<String>* arguments) {
    i64 i = 1;
    while (i < arguments.len()) {
        String* argument = arguments.get_ptr(i);
        if (argument.equals("--")) { return false; }
        if (argument.equals("--emit=grammar")) { return true; }
        if (argument.equals("--emit") && i + 1 < arguments.len()
            && arguments.get_ptr(i + 1).equals("grammar")) { return true; }
        i += 1;
    }
    return false;
}

/// Resolves the workspace plan for the command line, setting
/// `*has_package` when the command targets a package. Writes an error and
/// returns false when resolution fails.
bool workspace_package_arguments(Vec<String>* arguments, CliMatches* cli, WorkspacePlan* plan, bool* has_package, String* error) {
    *has_package = false;
    i64 command_index = workspace_command_index(arguments);
    if (command_index >= 0) {
        String* command = arguments.get_ptr(command_index);
        if (command.equals("init") || command.equals("clean")) {
            return true;
        }
        if (command.equals("test") || command.equals("t")) {
            *has_package = true;
            return true;
        }
        if (!workspace_is_command(command.to_str())) { return true; }
    } else {
        i64 option = 1;
        while (option < arguments.len()) {
            String* argument = arguments.get_ptr(option);
            if (argument.equals("--") || workspace_is_terminal_option(argument.to_str())) {
                return true;
            }
            option += 1;
        }
    }
    String input = String.new();
    bool found = false;
    if (cli.command.equals("build")) {
        Optional<String> first_positional = cli.positional(0);
        Optional<String> manifest_option = cli.value("manifest");
        if (first_positional.is_some()) {
            String source = first_positional.unwrap();
            if (!cli.has("manifest") && source.ends_with(".ag")) { return true; }
            // Positional manifest form: `agc build silver.toml ...`.
            found = !cli.has("manifest") && workspace_manifest_input(source.to_str(), &input);
            if (!found) {
                workspace_error(error, "build manifests must be selected with `--manifest PATH` or given as the positional manifest");
                return false;
            }
        } else if (manifest_option.is_some()) {
            String manifest_path = manifest_option.unwrap();
            found = workspace_manifest_input(manifest_path.to_str(), &input);
            if (!found) {
                workspace_error_value(error, "build manifest not found: `", manifest_path.to_str(), "`");
                manifest_path.drop();
                input.drop();
                return false;
            }
            manifest_path.drop();
        } else {
            found = workspace_default_manifest(&input);
        }
    } else {
        found = workspace_find_package_input(arguments, command_index, &input);
    }
    if (!found) {
        if (cli.command.equals("build")) {
            workspace_error(error, "no ./silver.toml found; pass `--manifest PATH`");
            input.drop();
            return false;
        }
        if (command_index < 0 || workspace_has_positional_input(arguments, command_index)
            || workspace_has_grammar_emit(arguments)) {
            return true;
        }
        if (!workspace_default_manifest(&input)) { return true; }
    }
    TargetKind kind = TargetKind.Bin;
    String requested = String.new();
    bool has_explicit_kind = false;
    if (!workspace_package_kind(arguments, &kind, &requested, &has_explicit_kind)) {
        workspace_error(error, "only one of `--bin` or `--lib` may be specified");
        input.drop();
        requested.drop();
        return false;
    }
    if (!workspace_plan_from_manifest(input.to_str(), kind, has_explicit_kind, requested.to_str(), plan, error)) {
        input.drop();
        requested.drop();
        return false;
    }
    input.drop();
    requested.drop();
    *has_package = true;
    return true;
}

/// Appends the plan's package roots to `include_dirs`.
void workspace_collect_roots(WorkspacePlan* plan, Vec<String>* include_dirs) {
    i64 i = 0;
    while (i < plan.package_roots.len()) {
        String* root = plan.package_roots.get_ptr(i);
        include_dirs.push(String.from_str(root.to_str()));
        String source = path_join(root.to_str(), "src");
        include_dirs.push(move source);
        String lib = path_join(root.to_str(), "lib/silver");
        include_dirs.push(move lib);
        i += 1;
    }
}

/// Creates `path` and missing parents. Returns false on failure.
bool workspace_mkdir_p(str path) {
    if (is_dir(path)) { return true; }
    String parent = path_dirname(path);
    if (parent.len() > 0 && !parent.equals(path) && !is_dir(parent.to_str())) {
        if (!workspace_mkdir_p(parent.to_str())) { parent.drop(); return false; }
    }
    parent.drop();
    return create_dir(path);
}

/// Escapes a string for a TOML basic string value.
String workspace_toml_escape(str value) {
    String out = String.new();
    i64 i = 0;
    while (i < strlen(value)) {
        u8 ch = (u8)value[i];
        if (ch == (u8)'\\') { out.push_str("\\\\"); }
        else if (ch == (u8)'"') { out.push_str("\\\""); }
        else { out.push(ch); }
        i += 1;
    }
    return move out;
}

/// True when the absolute directory `dir` or one of its ancestors holds a `.git` entry.
bool workspace_inside_git_repo(str dir) {
    String current = String.from_str(dir);
    while (current.len() > 0) {
        String marker = path_join(current.to_str(), ".git");
        if (exists(marker.to_str())) { return true; }
        String parent = path_dirname(current.to_str());
        if (parent.equals(current.to_str())) { return false; }
        current = move parent;
    }
    return false;
}

/// Template source of `src/main.ag` written by `agc init`.
const str INIT_ENTRY_SOURCE = "i32 main() {\n    @println(\"Hello, Silver!\");\n    return 0;\n}\n";

/// `agc init [DIR] [--name NAME]`: create silver.toml + src/main.ag and start a
/// git repository when git is available. Mirrors the stage0 template.
i32 workspace_init_command(CliMatches* cli) {
    String target = String.new();
    if (cli.positional_count() > 0) {
        Optional<String> first = cli.positional(0);
        if (first.is_some()) { target = first.unwrap(); }
    }
    // Resolve against the current directory first, so `.` and `..` name the
    // real directory instead of becoming the package name.
    if (!target.starts_with("/")) {
        String cwd = current_dir();
        target = path_join(cwd.to_str(), target.to_str());
    }
    target = path_normalize(target.to_str());
    if (exists(target.to_str()) && !is_dir(target.to_str())) {
        STDERR.write_str("agc: error: package target `");
        STDERR.write_str(target.to_str());
        STDERR.write_str("` exists and is not a directory\n");
        return 2;
    }
    String manifest_path = path_join(target.to_str(), MANIFEST_FILE);
    if (exists(manifest_path.to_str())) {
        STDERR.write_str("agc: error: package manifest already exists: `");
        STDERR.write_str(manifest_path.to_str());
        STDERR.write_str("`\n");
        return 2;
    }
    String name = String.new();
    Optional<String> name_option = cli.value("name");
    if (name_option.is_some()) { name = name_option.unwrap(); }
    if (name.len() == 0) { name = path_basename(target.to_str()); }
    if (name.len() == 0) {
        STDERR.write_str("agc: error: could not detect a package name from the target directory; pass `--name NAME`\n");
        return 2;
    }
    i64 name_index = 0;
    while (name_index < name.len()) {
        u8 ch = name.data[name_index];
        if (ch < 32 || ch == 127) {
            STDERR.write_str("agc: error: package name must not contain control characters; pass `--name NAME`\n");
            return 2;
        }
        name_index += 1;
    }
    String escaped = workspace_toml_escape(name.to_str());
    String manifest = String.from_str("name = \"");
    manifest.push_str(escaped.to_str());
    manifest.push_str("\"\nversion = \"0.1.0\"\n\n[bin.\"");
    manifest.push_str(escaped.to_str());
    manifest.push_str("\"]\nentry = \"src/main.ag\"\n");
    escaped.drop();
    String src_dir = path_join(target.to_str(), "src");
    String entry_path = path_join(src_dir.to_str(), "main.ag");
    if (exists(entry_path.to_str()) && !is_file(entry_path.to_str())) {
        STDERR.write_str("agc: error: package entry `");
        STDERR.write_str(entry_path.to_str());
        STDERR.write_str("` exists and is not a file\n");
        return 2;
    }
    if (!workspace_mkdir_p(target.to_str()) || !workspace_mkdir_p(src_dir.to_str())) {
        STDERR.write_str("agc: error: failed to create package in `");
        STDERR.write_str(target.to_str());
        STDERR.write_str("`\n");
        return 2;
    }
    // The manifest is written last: a failed init leaves no manifest behind,
    // so a retry is not rejected as "already exists".
    if (!exists(entry_path.to_str()) && !write_file(entry_path.to_str(), INIT_ENTRY_SOURCE)) {
        STDERR.write_str("agc: error: failed to write package entry `");
        STDERR.write_str(entry_path.to_str());
        STDERR.write_str("`\n");
        return 2;
    }
    if (!write_file(manifest_path.to_str(), manifest.to_str())) {
        STDERR.write_str("agc: error: failed to write package manifest `");
        STDERR.write_str(manifest_path.to_str());
        STDERR.write_str("`\n");
        return 2;
    }
    // Best effort, like stage0: start a git repository when git is on PATH and
    // the package is not already inside one. execve needs a resolved path, so
    // search PATH for the git binary.
    Optional<String> path_var = var("PATH");
    if (path_var.is_some() && !workspace_inside_git_repo(target.to_str())
        && set_current_dir(target.to_str())) {
        String search = path_var.unwrap();
        i64 begin = 0;
        bool spawned_git = false;
        while (begin <= search.len() && !spawned_git) {
            i64 end = begin;
            while (end < search.len() && search.data[end] != (u8)':') { end += 1; }
            String dir = search.substr(begin, end - begin);
            if (dir.len() > 0) {
                String candidate = path_join(dir.to_str(), "git");
                if (is_file(candidate.to_str())) {
                    Command git = Command.new(candidate.to_str());
                    git.arg("init");
                    git.arg("--quiet");
                    Result<Child, i64> spawned = git.spawn();
                    if (spawned.is_ok()) {
                        Child child = spawned.unwrap();
                        child.wait_status();
                        spawned_git = true;
                    }
                }
            }
            begin = end + 1;
        }
    }
    STDOUT.write_str("Created Silver package `");
    STDOUT.write_str(name.to_str());
    STDOUT.write_str("` in ");
    STDOUT.write_str(target.to_str());
    STDOUT.write_str("\nNext: cd ");
    STDOUT.write_str(target.to_str());
    STDOUT.write_str(" && agc run\n");
    return 0;
}
