import document;
import params;
import transport;
import json_rpc;
import std.fs;
import std.path;
import frontend.ast;
import frontend.cfg;
import frontend.module_loader;
import tooling.diagnostics;
import tooling.format;

enum ImportCompletionKind { Module; Selection; AliasKeyword; AliasName; Complete; }

struct ImportCompletionContext {
    ImportCompletionKind kind;
    String module;
    String prefix;
    Span replacement;
    Vec<String> selected;
}

void import_closure(Document* doc, Vec<Document*>* documents) {
    documents.push(doc); i64 i = 0;
    while (i < documents.len()) {
        Document* source = documents.get(i); i64 dependency = 0;
        while (dependency < source.dependencies.len()) {
            Document* next = source.dependencies.get(dependency); i64 existing = 0;
            while (existing < documents.len() && documents.get(existing) != next) { existing += 1; }
            if (existing == documents.len()) { documents.push(next); }
            dependency += 1;
        }
        i += 1;
    }
}

bool import_conflicts(Document* active, Document* added, PendingMessage* pending) {
    active.ensure_syntax();
    Vec<Document*> existing = Vec<Document*>.new(); import_closure(active, &existing);
    Vec<Document*> introduced = Vec<Document*>.new(); import_closure(added, &introduced);
    Vec<String> callable_overlaps = Vec<String>.new();
    i64 i = 0;
    while (i < introduced.len()) {
        Document* source = introduced.get(i); if (source == active) { return true; }
        i64 old = 0; while (old < existing.len() && existing.get(old) != source) { old += 1; }
        if (old < existing.len()) { i += 1; continue; }
        i64 symbol = 0;
        while (symbol < source.analysis.symbols.len()) {
            if (request_interrupted(pending)) { return true; }
            IdeSymbol* candidate = source.analysis.symbols.get_ptr(symbol);
            // Type and trait members can supply valid overloads without colliding as imported names.
            if (!candidate.local && !candidate.is_private && candidate.owner.len() == 0) {
                i64 previous = 0;
                // The frontend accepts same-name free functions as overloads across imports.
                while (previous < existing.len() + i) {
                    bool existing_source = previous < existing.len();
                    Document* other = existing_source ? existing.get(previous) : introduced.get(previous - existing.len());
                    if (other != source) {
                        i64 name = ide_name_head(&other.analysis, candidate.name.to_str());
                        while (name >= 0) {
                            IdeSymbol* found = other.analysis.symbols.get_ptr(name);
                            if (!found.local && (other == active || !found.is_private) && found.owner.len() == 0) {
                                if (candidate.kind != IdeSymbolKind.Function || found.kind != IdeSymbolKind.Function
                                    || other == active) { return true; }
                                i64 overlap = 0;
                                while (overlap < callable_overlaps.len()
                                    && !callable_overlaps.get_ptr(overlap).equals(candidate.name.to_str())) { overlap += 1; }
                                if (overlap == callable_overlaps.len()) {
                                    callable_overlaps.push(candidate.name.clone());
                                }
                            }
                            name = other.analysis.next_name.get(name);
                        }
                    }
                    previous += 1;
                }
            }
            symbol += 1;
        }
        i += 1;
    }
    if (callable_overlaps.len() > 0) {
        if (active.analysis.recovered || !active.analysis.diagnostics.is_empty()) { return true; }
        i = 0;
        while (i < existing.len()) {
            Document* source = existing.get(i);
            if (source != active && (source.analysis.recovered || !source.analysis.diagnostics.is_empty())) { return true; }
            i += 1;
        }
        i = 0;
        while (i < introduced.len()) {
            Document* source = introduced.get(i); bool already_present = false;
            i64 old = 0;
            while (old < existing.len()) {
                if (existing.get(old) == source) { already_present = true; break; }
                old += 1;
            }
            if (source != active && !already_present
                && (source.analysis.recovered || !source.analysis.diagnostics.is_empty())) { return true; }
            i += 1;
        }
        if (!import_overload_may_affect_source(&active.analysis.tree, &callable_overlaps)) { return false; }
        Vec<SyntaxTree*> baseline = Vec<SyntaxTree*>.new();
        Vec<SyntaxTree*> candidate = Vec<SyntaxTree*>.new();
        i = 0;
        while (i < existing.len()) {
            Document* source = existing.get(i);
            if (source != active) {
                source.ensure_syntax();
                baseline.push(&source.analysis.tree);
                candidate.push(&source.analysis.tree);
            }
            i += 1;
        }
        i = 0;
        while (i < introduced.len()) {
            Document* source = introduced.get(i); bool already_present = false;
            i64 old = 0;
            while (old < existing.len()) {
                if (existing.get(old) == source) { already_present = true; break; }
                old += 1;
            }
            if (source != active && !already_present) {
                source.ensure_syntax(); candidate.push(&source.analysis.tree);
            }
            i += 1;
        }
        CfgSet cfg = linux_defaults();
        ImportOverloadSafety safety = check_import_overload_safety(
            &active.analysis.tree, &baseline, &candidate, &callable_overlaps, &cfg);
        if (safety != ImportOverloadSafety.Safe) { return true; }
    }
    return false;
}

String import_module_from_base(str base, str path) {
    String directory = path_normalize(base); String file = path_normalize(path);
    if (!directory.ends_with("/")) { directory.push('/'); }
    if (!file.starts_with(directory.to_str()) || (!file.ends_with(".ag") && !file.ends_with(".agm"))) { return String.new(); }
    i64 extension = file.ends_with(".agm") ? 4 : 3;
    String relative = file.substr(directory.len(), file.len() - directory.len() - extension);
    String name = relative.replace("/", ".");
    TokenStream tokens = TokenStream.new(); DiagnosticBag errors = DiagnosticBag.new(); lex(name.clone(), &tokens, &errors);
    if (!errors.is_empty() || tokens.len() < 2) { return String.new(); }
    i64 i = 0;
    while (i + 1 < tokens.len()) {
        if (tokens.get(i).kind != (i % 2 == 0 ? TokenKind.Identifier : TokenKind.Dot)) { return String.new(); }
        i += 1;
    }
    if (i % 2 == 0) { return String.new(); }
    return move name;
}

String import_module_name(DocumentStore* store, Document* active, Document* target) {
    String parent = path_dirname(active.path.to_str()); String root = absolute_document_path(module_root(active.path.to_str()).to_str());
    i64 i = -1;
    while (i < store.include_dirs.len() + 1) {
        str base = i == -1 ? parent.to_str() : i == 0 ? root.to_str() : store.include_dirs.get_ptr(i - 1).to_str();
        String name = import_module_from_base(base, target.path.to_str());
        if (name.len() > 0) {
            String resolved = resolve_document_import(store, active, name.to_str());
            String normalized = path_normalize(resolved.to_str());
            if (resolved.len() > 0 && normalized.equals(path_normalize(target.path.to_str()).to_str())) { return move name; }
        }
        i += 1;
    }
    return String.new();
}

String import_statement(Document* active, str module_name) {
    String inserted = String.from_str("import "); inserted.push_str(module_name); inserted.push(';');
    inserted.push_str(source_newline(active.text.to_str(), &active.analysis.tokens));
    return move inserted;
}

void append_import_edit(String* out, Document* active, str module_name) {
    String inserted = import_statement(active, module_name);
    out.push_str("{\"range\":"); active.append_range(out, Span.synthetic());
    out.push_str(",\"newText\":\""); json_escape(inserted.to_str(), out); out.push_str("\"}");
}

enum ImportSelectionState { Name; AfterName; Alias; AfterAlias; }

bool import_cursor_word(Token* token) {
    if (token.text.len() == 0 || !typecheck_name_start(token.text.data[0])) { return false; }
    i64 i = 1;
    while (i < token.text.len()) {
        if (!typecheck_name_continue(token.text.data[i])) { return false; }
        i += 1;
    }
    return true;
}

String import_token_prefix(Document* doc, Token* token, i64 offset) {
    i64 length = offset - token.span.start;
    if (length < 0) { length = 0; }
    if (length > token.span.end - token.span.start) { length = token.span.end - token.span.start; }
    return doc.text.substr(token.span.start, length);
}

bool import_context_cursor_in_comment(Document* doc, i64 offset) {
    i64 i = 0;
    while (i < doc.analysis.tokens.len()) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.span.start <= offset && offset < token.span.end && token.kind == TokenKind.Comment) { return true; }
        i += 1;
    }
    return false;
}

void import_context_set(ImportCompletionContext* context, ImportCompletionKind kind,
                        str module, str prefix, Span replacement, Vec<String> selected) {
    context.kind = kind; context.module = String.from_str(module); context.prefix = String.from_str(prefix);
    context.replacement = replacement; context.selected = move selected;
}

Optional<ImportCompletionContext> import_completion_context(Document* doc, i64 offset) {
    if (offset < 0 || offset > doc.text.len() || import_context_cursor_in_comment(doc, offset)) {
        return Optional<ImportCompletionContext>.none();
    }
    i64 import_index = -1; i64 i = 0;
    while (i < doc.analysis.tokens.len() && doc.analysis.tokens.get(i).span.start < offset) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.kind == TokenKind.Semicolon) { import_index = -1; }
        else if (token.kind == TokenKind.Import) { import_index = i; }
        i += 1;
    }
    if (import_index < 0 || offset <= doc.analysis.tokens.get(import_index).span.end) {
        return Optional<ImportCompletionContext>.none();
    }

    Token* cursor_token = (Token*)0; i64 cursor_index = -1;
    i = import_index + 1;
    while (i < doc.analysis.tokens.len()) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.span.start <= offset && offset <= token.span.end) {
            if (token.span.end == offset && i + 1 < doc.analysis.tokens.len()) {
                Token* next = doc.analysis.tokens.get(i + 1);
                if (next.span.start == offset && import_cursor_word(next)) { token = next; i += 1; }
            }
            cursor_token = token; cursor_index = i; break;
        }
        if (token.kind == TokenKind.Semicolon || token.span.start >= offset) { break; }
        i += 1;
    }
    if (cursor_token == (Token*)0) {
        i = import_index + 1;
        while (i < doc.analysis.tokens.len() && doc.analysis.tokens.get(i).span.end <= offset
            && doc.analysis.tokens.get(i).kind != TokenKind.Semicolon) { i += 1; }
        cursor_index = i;
    }
    if (cursor_token != (Token*)0 && cursor_token.span.start == offset
        && (cursor_token.kind == TokenKind.RightBrace || cursor_token.kind == TokenKind.Semicolon
            || cursor_token.kind == TokenKind.Eof)) { cursor_token = (Token*)0; }

    String module = String.new(); Vec<String> selected = Vec<String>.new();
    bool path_mode = true; bool need_identifier = true;
    ImportSelectionState state = ImportSelectionState.Name;
    i = import_index + 1;
    while (i < cursor_index) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.kind == TokenKind.Comment) { i += 1; continue; }
        if (path_mode) {
            if (token.kind == TokenKind.Identifier && need_identifier) {
                if (module.len() > 0) { module.push('.'); }
                module.push_str(token.text.to_str()); need_identifier = false;
            } else if (token.kind == TokenKind.Dot && !need_identifier) { need_identifier = true; }
            else if (token.kind == TokenKind.LeftBrace && !need_identifier) { path_mode = false; }
            else { return Optional<ImportCompletionContext>.none(); }
        } else if (token.kind == TokenKind.Identifier && state == ImportSelectionState.Alias) {
            selected.push(token.text.clone());
            state = ImportSelectionState.AfterAlias;
        } else if (token.kind == TokenKind.Identifier && state == ImportSelectionState.Name) {
            selected.push(token.text.clone()); state = ImportSelectionState.AfterName;
        } else if (token.kind == TokenKind.As && state == ImportSelectionState.AfterName) {
            state = ImportSelectionState.Alias;
        } else if (token.kind == TokenKind.Comma
            && (state == ImportSelectionState.AfterName || state == ImportSelectionState.AfterAlias)) {
            state = ImportSelectionState.Name;
        }
        else if (token.kind == TokenKind.RightBrace) { return Optional<ImportCompletionContext>.none(); }
        else { return Optional<ImportCompletionContext>.none(); }
        i += 1;
    }
    if (path_mode && cursor_token != (Token*)0 && cursor_token.kind == TokenKind.LeftBrace
        && cursor_token.span.end == offset && !need_identifier) { path_mode = false; }
    if (path_mode) {
        String prefix = String.new(); Span replacement = Span.synthetic();
        replacement.start = offset; replacement.end = offset;
        ImportCompletionKind kind = ImportCompletionKind.Module;
        if (cursor_token != (Token*)0) {
            if (import_cursor_word(cursor_token)) { prefix = import_token_prefix(doc, cursor_token, offset); replacement = cursor_token.span; }
            else if (cursor_token.kind == TokenKind.Dot && cursor_token.span.end == offset) { }
            else { return Optional<ImportCompletionContext>.none(); }
        } else if (!need_identifier) { kind = ImportCompletionKind.Complete; }
        if (module.ends_with(".")) { module = module.substr(0, module.len() - 1); }
        ImportCompletionContext context;
        import_context_set(&context, kind, module.to_str(), prefix.to_str(), replacement, move selected);
        return Optional<ImportCompletionContext>.some(move context);
    }

    ImportCompletionKind kind = ImportCompletionKind.Selection; String prefix = String.new(); Span replacement = Span.synthetic();
    replacement.start = offset; replacement.end = offset;
    if (state == ImportSelectionState.AfterName) { kind = ImportCompletionKind.AliasKeyword; }
    else if (state == ImportSelectionState.Alias || state == ImportSelectionState.AfterAlias) { kind = ImportCompletionKind.AliasName; }
    if (cursor_token != (Token*)0) {
        if (import_cursor_word(cursor_token)) {
            prefix = import_token_prefix(doc, cursor_token, offset); replacement = cursor_token.span;
        }
        else if (cursor_token.kind == TokenKind.Comma && cursor_token.span.end == offset) { kind = ImportCompletionKind.Selection; }
        else if (cursor_token.kind == TokenKind.LeftBrace && cursor_token.span.end == offset) { }
        else { return Optional<ImportCompletionContext>.none(); }
    }
    i = cursor_index;
    while (i < doc.analysis.tokens.len()) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.kind == TokenKind.RightBrace || token.kind == TokenKind.Semicolon || token.kind == TokenKind.Eof) { break; }
        if (token.kind == TokenKind.Identifier && token != cursor_token) { selected.push(token.text.clone()); }
        i += 1;
    }
    ImportCompletionContext context;
    import_context_set(&context, kind, module.to_str(), prefix.to_str(), replacement, move selected);
    return Optional<ImportCompletionContext>.some(move context);
}

bool import_identifier_name(str name) {
    if (strlen(name) == 0) { return false; }
    TokenStream tokens = TokenStream.new(); DiagnosticBag errors = DiagnosticBag.new(); lex(String.from_str(name), &tokens, &errors);
    return errors.is_empty() && tokens.len() == 2 && tokens.get(0).kind == TokenKind.Identifier
        && tokens.get(0).text.equals(name);
}

void import_module_add(Vec<String>* modules, str name) {
    if (!import_identifier_name(name)) { return; }
    i64 i = 0; while (i < modules.len()) { if (modules.get_ptr(i).equals(name)) { return; } i += 1; }
    modules.push(String.from_str(name));
}

void import_scan_directory(Vec<String>* modules, DocumentStore* store, Document* active,
                           str directory, str parent_module, PendingMessage* pending) {
    if (request_interrupted(pending)) { return; }
    Result<Vec<String>, Error> read = read_dir(directory); if (read.is_err()) { return; }
    Vec<String> entries = read.unwrap(); i64 i = 0;
    while (i < entries.len() && !request_interrupted(pending)) {
        String* entry = entries.get_ptr(i);
        if (!entry.starts_with(".") && !entry.equals("target") && !entry.equals("node_modules")) {
            String child = path_join(directory, entry.to_str()); Result<Metadata, Error> stat = metadata(child.to_str());
            if (stat.is_ok()) {
                Metadata info = stat.unwrap();
                if (info.is_dir) { import_module_add(modules, entry.to_str()); }
                else if (info.is_file && (entry.ends_with(".ag") || entry.ends_with(".agm"))) {
                    String name = entry.ends_with(".agm") ? entry.substr(0, entry.len() - 4) : entry.substr(0, entry.len() - 3);
                    if (import_identifier_name(name.to_str())) {
                        String qualified = String.new();
                        if (strlen(parent_module) > 0) { qualified.push_str(parent_module); qualified.push('.'); }
                        qualified.push_str(name.to_str()); String resolved = resolve_document_import(store, active, qualified.to_str());
                        String normalized = path_normalize(resolved.to_str()); String target = path_normalize(child.to_str());
                        if (resolved.len() > 0 && normalized.equals(target.to_str())) { import_module_add(modules, name.to_str()); }
                    }
                }
            }
        }
        i += 1;
    }
}

void import_scan_overlays(Vec<String>* modules, DocumentStore* store, Document* active,
                          str parent_directory, str parent_module, PendingMessage* pending) {
    String directory = path_normalize(parent_directory); String prefix = directory.clone();
    if (!prefix.ends_with("/")) { prefix.push('/'); }
    i64 i = 0;
    while (i < store.overlay_paths.len() && !request_interrupted(pending)) {
        String path = path_normalize(store.overlay_paths.get_ptr(i).to_str());
        if (path.starts_with(prefix.to_str())) {
            String relative = path.substr(prefix.len(), path.len() - prefix.len()); i64 slash = 0;
            while (slash < relative.len() && relative.data[slash] != (u8)'/') { slash += 1; }
            String first = relative.substr(0, slash);
            if (!first.starts_with(".") && !first.equals("target") && !first.equals("node_modules")) {
                if (slash < relative.len()) { import_module_add(modules, first.to_str()); }
                else {
                    String file = path_basename(path.to_str());
                    if (file.ends_with(".ag") || file.ends_with(".agm")) {
                        String name = file.ends_with(".agm") ? file.substr(0, file.len() - 4) : file.substr(0, file.len() - 3);
                        if (import_identifier_name(name.to_str())) {
                            String qualified = String.new();
                            if (strlen(parent_module) > 0) { qualified.push_str(parent_module); qualified.push('.'); }
                            qualified.push_str(name.to_str());
                            String resolved = resolve_document_import(store, active, qualified.to_str());
                            if (resolved.len() > 0 && path_normalize(resolved.to_str()).equals(path.to_str())) {
                                import_module_add(modules, name.to_str());
                            }
                        }
                    }
                }
            }
        }
        i += 1;
    }
}

Vec<String> import_modules(DocumentStore* store, Document* active, str parent_module, PendingMessage* pending) {
    Vec<String> modules = Vec<String>.new();
    String local = path_dirname(active.path.to_str()); String root = absolute_document_path(module_root(active.path.to_str()).to_str());
    String parent = String.from_str(parent_module);
    bool standard = parent.equals("std") || parent.starts_with("std.");
    i64 base = 0;
    while (base < store.include_dirs.len() + 2 && !request_interrupted(pending)) {
        str directory = base == 0 ? (standard ? root.to_str() : local.to_str())
            : base == 1 ? (standard ? local.to_str() : root.to_str()) : store.include_dirs.get_ptr(base - 2).to_str();
        String parent_path = String.from_str(parent_module); parent_path = parent_path.replace(".", "/");
        String scan = parent_path.len() == 0 ? String.from_str(directory) : path_join(directory, parent_path.to_str());
        import_scan_directory(&modules, store, active, scan.to_str(), parent_module, pending);
        import_scan_overlays(&modules, store, active, scan.to_str(), parent_module, pending);
        base += 1;
    }
    return move modules;
}
