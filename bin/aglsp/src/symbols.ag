import document;
import positions;
import json_rpc;
import navigation;
import tooling.search;
import std.algo.sort;
import transport;

i64 symbol_kind(IdeSymbolKind kind) {
    return match kind {
        IdeSymbolKind.Function : 12, IdeSymbolKind.Method : 6,
        IdeSymbolKind.Struct : 23, IdeSymbolKind.Enum : 10,
        IdeSymbolKind.Trait : 11, IdeSymbolKind.TypeAlias : 5,
        IdeSymbolKind.Field : 8, IdeSymbolKind.Variant : 22,
        _ : 13,
    };
}

String compute_hover(Document* doc, i64 offset, bool markdown) {
    i64 occurrence = doc.analysis.occurrence_at(offset);
    SymbolTarget target = follow_import_alias(resolve_occurrence(doc, occurrence));
    if (target.symbol < 0) { return String.from_str("null"); }
    IdeSymbol* symbol = target.document.analysis.symbols.get_ptr(target.symbol);
    String content = String.new();
    if (markdown) { content.push_str("```silver\n"); }
    content.push_str(symbol.signature.to_str());
    if (markdown) { content.push_str("\n```"); }
    if (symbol.documentation.len() > 0) { content.push_str("\n\n"); content.push_str(symbol.documentation.to_str()); }
    String out = String.from_str("{\"contents\":{\"kind\":\""); out.push_str(markdown ? "markdown" : "plaintext"); out.push_str("\",\"value\":\"");
    json_escape(content.to_str(), &out); out.push_str("\"},\"range\":");
    doc.append_range(&out, doc.analysis.occurrences.get_ptr(occurrence).node.span);
    out.push('}'); return move out;
}

String compute_definition(Document* doc, i64 offset) {
    SymbolTarget target = follow_import_alias(resolve_occurrence(doc, doc.analysis.occurrence_at(offset)));
    if (target.symbol < 0) { return String.from_str("null"); }
    String out = String.new();
    append_location(&out, target.document, target.document.analysis.symbols.get_ptr(target.symbol).selection);
    return move out;
}

void append_document_symbol(String* out, Document* doc, i64 id, bool children) {
    IdeSymbol* symbol = doc.analysis.symbols.get_ptr(id);
    out.push_str("{\"name\":\"");
    if (symbol.kind == IdeSymbolKind.Method) { json_escape(symbol.owner.to_str(), out); out.push('.'); }
    json_escape(symbol.name.to_str(), out);
    out.push_str("\",\"detail\":\""); json_escape(symbol.signature.to_str(), out);
    out.push_str("\",\"kind\":"); i64 kind = symbol_kind(symbol.kind); out.push_display(&kind);
    out.push_str(",\"range\":"); doc.append_range(out, symbol.extent);
    out.push_str(",\"selectionRange\":"); doc.append_range(out, symbol.selection);
    if (children) {
        out.push_str(",\"children\":["); bool first = true; i64 i = 0;
        while (i < doc.analysis.symbols.len()) {
            IdeSymbol* child = doc.analysis.symbols.get_ptr(i);
            if (child.owner.equals(symbol.name.to_str()) && child.selection.start >= symbol.extent.start
                && child.selection.end <= symbol.extent.end && !child.local) {
                if (!first) { out.push(','); } first = false;
                append_document_symbol(out, doc, i, false);
            }
            i += 1;
        }
        out.push(']');
    }
    out.push('}');
}

void append_symbol_information(String* out, Document* doc, IdeSymbol* symbol) {
    out.push_str("{\"name\":\""); json_escape(symbol.name.to_str(), out);
    out.push_str("\",\"containerName\":\""); json_escape(symbol.owner.to_str(), out);
    out.push_str("\",\"kind\":"); i64 kind = symbol_kind(symbol.kind); out.push_display(&kind);
    out.push_str(",\"location\":"); append_location(out, doc, symbol.selection); out.push('}');
}

String compute_document_symbols(Document* doc, bool hierarchical) {
    String out = String.from_str("["); bool first = true; i64 i = 0;
    while (i < doc.analysis.symbols.len()) {
        IdeSymbol* symbol = doc.analysis.symbols.get_ptr(i);
        bool top_level = symbol.owner.len() == 0;
        if (hierarchical && symbol.kind == IdeSymbolKind.Method) {
            SymbolTarget target; target.document = doc; target.symbol = i;
            top_level = containing_implementation(target) >= 0;
        }
        if (!symbol.local && (!hierarchical || top_level)) {
            if (!first) { out.push(','); } first = false;
            if (hierarchical) { append_document_symbol(&out, doc, i, symbol.kind != IdeSymbolKind.Method); }
            else { append_symbol_information(&out, doc, symbol); }
        }
        i += 1;
    }
    out.push(']'); return move out;
}

String compute_references(DocumentStore* store, Document* doc, i64 offset, bool declarations, bool highlights) {
    SymbolTarget target = resolve_occurrence(doc, doc.analysis.occurrence_at(offset));
    Vec<Document*> documents = store.query_documents(doc);
    String out = String.from_str("["); bool first = true; i64 i = 0;
    while (target.symbol >= 0 && i < documents.len()) {
        Document* candidate = documents.get(i);
        if (highlights && candidate != doc) { i += 1; continue; }
        candidate.ensure_syntax();
        i64 j = 0;
        while (j < candidate.analysis.occurrences.len()) {
            IdeOccurrence* occurrence = candidate.analysis.occurrences.get_ptr(j);
            SymbolTarget resolved = resolve_occurrence(candidate, j);
            if (resolved.document == target.document && resolved.symbol == target.symbol
                && (declarations || !occurrence.definition)) {
                if (!first) { out.push(','); } first = false;
                if (highlights) {
                    out.push_str("{\"range\":"); candidate.append_range(&out, occurrence.node.span);
                    out.push_str(",\"kind\":1}");
                } else { append_location(&out, candidate, occurrence.node.span); }
            }
            j += 1;
        }
        candidate.compact(); i += 1;
    }
    out.push(']'); return move out;
}

bool valid_rename(str name) {
    if (!typecheck_name_start((u8)name[0])) { return false; }
    i64 i = 1;
    while (name[i] != (u8)0) { if (!typecheck_name_continue((u8)name[i])) { return false; } i += 1; }
    TokenStream tokens = TokenStream.new(); DiagnosticBag diagnostics = DiagnosticBag.new();
    lex(String.from_str(name), &tokens, &diagnostics);
    return diagnostics.is_empty() && tokens.len() == 2 && tokens.get(0).kind == TokenKind.Identifier;
}

String compute_prepare_rename(Document* doc, i64 offset) {
    i64 occurrence = doc.analysis.occurrence_at(offset);
    SymbolTarget target = rename_target(resolve_occurrence(doc, occurrence));
    if (target.symbol < 0) { return String.from_str("null"); }
    String out = String.from_str("{\"range\":");
    doc.append_range(&out, doc.analysis.occurrences.get_ptr(occurrence).node.span);
    out.push_str(",\"placeholder\":\"");
    json_escape(target.document.analysis.symbols.get_ptr(target.symbol).name.to_str(), &out);
    out.push_str("\"}"); return move out;
}

SymbolTarget rename_target(SymbolTarget target) {
    if (target.symbol >= 0 && target.document.analysis.symbols.get_ptr(target.symbol).kind == IdeSymbolKind.Method) {
        return declaration_target(target);
    }
    return target;
}

Vec<SymbolTarget> rename_plan(DocumentStore* store, Document* context, SymbolTarget target) {
    Vec<SymbolTarget> plan = Vec<SymbolTarget>.new(); target = rename_target(target);
    if (target.symbol < 0) { return move plan; }
    plan.push(target);
    if (target.document.analysis.symbols.get_ptr(target.symbol).kind != IdeSymbolKind.Method) { return move plan; }
    Vec<Document*> documents = store.query_documents(context);
    i64 i = 0;
    while (i < documents.len()) {
        Document* doc = documents.get(i); i64 symbol = ide_name_head(&doc.analysis, target.document.analysis.symbols.get_ptr(target.symbol).name.to_str());
        while (symbol >= 0) {
            SymbolTarget candidate; candidate.document = doc; candidate.symbol = symbol;
            if (!same_target(candidate, target) && same_target(rename_target(candidate), target)) { plan.push(candidate); }
            symbol = doc.analysis.next_name.get(symbol);
        }
        store.compact_closed();
        i += 1;
    }
    return move plan;
}

bool rename_conflicts(DocumentStore* store, Document* context, SymbolTarget target, str name) {
    target = rename_target(target); Vec<SymbolTarget> plan = rename_plan(store, context, target);
    if (target.symbol < 0) { return true; }
    IdeSymbol* selected = target.document.analysis.symbols.get_ptr(target.symbol);
    Vec<Document*> documents = store.query_documents(context);
    i64 i = 0;
    while (i < documents.len()) {
        Document* doc = documents.get(i); doc.ensure_syntax(); i64 j = 0;
        while (j < doc.analysis.symbols.len()) {
            IdeSymbol* symbol = doc.analysis.symbols.get_ptr(j);
            if (symbol.name.equals(name)) {
                i64 p = 0;
                while (p < plan.len()) {
                    SymbolTarget renamed = plan.get(p); IdeSymbol* declaration = renamed.document.analysis.symbols.get_ptr(renamed.symbol);
                    if (symbol != declaration && symbol.owner.equals(declaration.owner.to_str())) {
                        if (!declaration.local && !symbol.local) { return true; }
                        if (doc == renamed.document && symbol.scope.start < declaration.scope.end
                            && declaration.scope.start < symbol.scope.end) { return true; }
                    }
                    p += 1;
                }
            }
            j += 1;
        }
        j = 0;
        while (j < doc.analysis.occurrences.len()) {
            IdeOccurrence* occurrence = doc.analysis.occurrences.get_ptr(j);
            if (!occurrence.member && strcmp(occurrence.node.text, name) == 0) {
                i64 p = 0;
                while (p < plan.len()) {
                    SymbolTarget renamed = plan.get(p);
                    IdeSymbol* declaration = renamed.document.analysis.symbols.get_ptr(renamed.symbol);
                    if (declaration.local && doc == renamed.document
                        && declaration.selection.start <= occurrence.node.span.start
                        && declaration.scope.start <= occurrence.node.span.start
                        && occurrence.node.span.start < declaration.scope.end) {
                        SymbolTarget existing = rename_target(resolve_occurrence(doc, j));
                        if (existing.symbol != -1 && !same_target(existing, renamed)) { return true; }
                    }
                    p += 1;
                }
            }
            if (strcmp(occurrence.node.text, selected.name.to_str()) != 0) { j += 1; continue; }
            SymbolTarget resolved = rename_target(resolve_occurrence(doc, j));
            if (resolved.symbol == -2) {
                i64 p = 0;
                while (p < plan.len()) {
                    SymbolTarget renamed = plan.get(p);
                    if (occurrence.owner.equals(renamed.document.analysis.symbols.get_ptr(renamed.symbol).owner.to_str())) { return true; }
                    p += 1;
                }
            }
            if (occurrence.member) { j += 1; continue; }
            if (same_target(resolved, target)) {
                i64 other = ide_resolve_local(&doc.analysis, name, doc.analysis.occurrences.get_ptr(j).node.span.start);
                if (other >= 0 && !(doc == target.document && other == target.symbol)) { return true; }
            }
            j += 1;
        }
        store.compact_closed(); i += 1;
    }
    return false;
}

String compute_rename(DocumentStore* store, Document* context, SymbolTarget target, str name, bool versioned) {
    target = rename_target(target);
    if (target.symbol < 0) { return String.from_str("null"); }
    str selected_name = target.document.analysis.symbols.get_ptr(target.symbol).name.to_str();
    Vec<Document*> documents = store.query_documents(context);
    String out = String.from_str(versioned ? "{\"documentChanges\":[" : "{\"changes\":{"); bool first_doc = true; i64 i = 0;
    while (i < documents.len()) {
        Document* doc = documents.get(i); doc.ensure_syntax(); String edits = String.new(); bool first = true; i64 j = 0;
        while (j < doc.analysis.occurrences.len()) {
            if (strcmp(doc.analysis.occurrences.get_ptr(j).node.text, selected_name) != 0) { j += 1; continue; }
            SymbolTarget resolved = rename_target(resolve_occurrence(doc, j));
            if (same_target(resolved, target)) {
                if (!first) { edits.push(','); } first = false;
                edits.push_str("{\"range\":");
                doc.append_range(&edits, doc.analysis.occurrences.get_ptr(j).node.span);
                edits.push_str(",\"newText\":\""); json_escape(name, &edits); edits.push_str("\"}");
            }
            j += 1;
        }
        if (!first) {
            if (!first_doc) { out.push(','); } first_doc = false;
            if (versioned) { out.push_str("{\"textDocument\":{\"uri\":\""); }
            else { out.push('"'); }
            json_escape(doc.uri.to_str(), &out);
            if (versioned) {
                out.push_str("\",\"version\":");
                if (doc.open) { out.push_display(&doc.version); } else { out.push_str("null"); }
                out.push_str("},\"edits\":[");
            } else { out.push_str("\":["); }
            out.push_str(edits.to_str()); out.push(']');
            if (versioned) { out.push('}'); }
        }
        store.compact_closed(); i += 1;
    }
    out.push_str(versioned ? "]}" : "}}"); return move out;
}

struct WorkspaceSymbolMatch { Document* document; i64 symbol; i64 score; }

impl Lt<WorkspaceSymbolMatch> for WorkspaceSymbolMatch {
    bool __lt(&self, &WorkspaceSymbolMatch other) {
        if (self.score != other.score) { return self.score < other.score; }
        i32 name = strcmp(self.document.analysis.symbols.get_ptr(self.symbol).name.to_str(), other.document.analysis.symbols.get_ptr(other.symbol).name.to_str());
        if (name != 0) { return name < 0; }
        i32 path = strcmp(self.document.uri.to_str(), other.document.uri.to_str());
        if (path != 0) { return path < 0; }
        return self.symbol < other.symbol;
    }
}

String compute_workspace_symbols(DocumentStore* store, str query, PendingMessage* pending) {
    Vec<Document*> documents = store.query_documents((Document*)0);
    Vec<WorkspaceSymbolMatch> matches = Vec<WorkspaceSymbolMatch>.new(); i64 i = 0;
    while (i < documents.len() && !request_interrupted(pending)) {
        Document* doc = documents.get(i); i64 j = 0;
        while (j < doc.analysis.symbols.len() && !request_interrupted(pending)) {
            IdeSymbol* symbol = doc.analysis.symbols.get_ptr(j); i64 score = ide_match_score(query, symbol.name.to_str());
            if (!symbol.local && score >= 0) {
                WorkspaceSymbolMatch found; found.document = doc; found.symbol = j; found.score = score; matches.push(found);
            }
            j += 1;
        }
        i += 1;
    }
    if (request_interrupted(pending)) { return String.from_str("null"); }
    // Sorting is synchronous; interruption checks bracket it.
    sort<WorkspaceSymbolMatch>(&matches); String out = String.from_str("["); i = 0;
    while (i < matches.len() && !request_interrupted(pending)) {
        WorkspaceSymbolMatch* found = matches.get_ptr(i);
        if (i > 0) { out.push(','); }
        append_symbol_information(&out, found.document, found.document.analysis.symbols.get_ptr(found.symbol)); i += 1;
    }
    out.push(']'); return move out;
}
