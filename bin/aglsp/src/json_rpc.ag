// bin/aglsp/src/json_rpc.ag — JSON-RPC 2.0 transport over stdin and stdout.
import std.io;
import std.io.file;
import std.io.byte_stream;
import std.json;
import std.mem.alloc;
import std.mem.memory;
import std.mem.vec;
import std.string;
import std.atomic;
import std.sys.raw.poll;

struct JsonRpcMessage {
    bool has_id;
    // Raw JSON token so string and numeric request IDs round-trip unchanged.
    String id_raw;
    String method;
    String params_json;
}

impl JsonRpcMessage {
    JsonRpcMessage new() {
        JsonRpcMessage m;
        m.has_id = false;
        m.id_raw = String.new();
        m.method = String.new();
        m.params_json = String.new();
        return move m;
    }
}

void json_escape(str input, String* out) {
    i64 len = strlen(input);
    i64 i = 0;
    while (i < len) {
        u8 ch = (u8)input[i];
        if (ch == '"') {
            out.push_str("\\\"");
        } else if (ch == '\\') {
            out.push_str("\\\\");
        } else if (ch == '\n') {
            out.push_str("\\n");
        } else if (ch == '\r') {
            out.push_str("\\r");
        } else if (ch == '\t') {
            out.push_str("\\t");
        } else if (ch < 32) {
            str digits = "0123456789abcdef";
            out.push_str("\\u00");
            out.push((u8)digits[ch / 16]);
            out.push((u8)digits[ch % 16]);
        } else {
            out.push(ch);
        }
        i += 1;
    }
}

void send_raw_payload(str payload) {
    i64 payload_len = strlen(payload);
    String header = String.from_str("Content-Length: ");
    header.push_display(&payload_len);
    header.push_str("\r\n\r\n");

    STDOUT.write_str(header.to_str());
    STDOUT.write_str(payload);
    STDOUT.flush();
    header.drop();
}

void send_response(str id_json, str result_json) {
    if (strlen(id_json) == 0) { return; }
    String resp = String.from_str("{\"jsonrpc\":\"2.0\",\"id\":");
    resp.push_str(id_json);
    resp.push_str(",\"result\":");
    resp.push_str(result_json);
    resp.push_str("}");
    send_raw_payload(resp.to_str());
    resp.drop();
}

void send_notification(str method, str params_json) {
    String notif = String.from_str("{\"jsonrpc\":\"2.0\",\"method\":\"");
    notif.push_str(method);
    notif.push_str("\",\"params\":");
    notif.push_str(params_json);
    notif.push_str("}");
    send_raw_payload(notif.to_str());
    notif.drop();
}

void send_error(str id_json, i64 code, str message) {
    if (strlen(id_json) == 0) { return; }
    String resp = String.from_str("{\"jsonrpc\":\"2.0\",\"id\":");
    resp.push_str(id_json);
    resp.push_str(",\"error\":{\"code\":");
    resp.push_display(&code);
    resp.push_str(",\"message\":\"");
    json_escape(message, &resp);
    resp.push_str("\"}}");
    send_raw_payload(resp.to_str());
    resp.drop();
}

bool parse_rpc_request(str body, JsonRpcMessage* msg) {
    msg.has_id = false;
    msg.method.clear();
    msg.params_json.clear();
    msg.id_raw.clear();
    bool valid_version = false;
    bool saw_version = false; bool saw_method = false; bool saw_params = false;

    JsonReader r = JsonReader.new(body);
    if (!r.begin_object()) {
        return false;
    }

    while (true) {
        r.skip_whitespace();
        if (r.failed) { break; }
        u8* bytes = (u8*)r.input;
        if (r.index < r.length && bytes[r.index] == (u8)125) { break; }
        String key = r.read_string();
        if (r.failed) {
            key.drop();
            break;
        }
        if (!r.expect((u8)58)) {
            key.drop();
            break;
        }

        if (key.equals("jsonrpc")) {
            if (saw_version) { return false; } saw_version = true;
            String version = r.read_string();
            valid_version = version.equals("2.0");
        } else if (key.equals("method")) {
            if (saw_method) { return false; } saw_method = true;
            String m = r.read_string();
            if (m.len() > 0 && !m.is_valid_utf8()) { return false; }
            msg.method.push_str(m.to_str());
            m.drop();
        } else if (key.equals("id")) {
            if (msg.has_id) { return false; }
            r.skip_whitespace();
            i64 id_start = r.index;
            if (id_start >= r.length) { return false; }
            if (body[id_start] == '"') {
                String id = r.read_string();
                if (r.failed || (id.len() > 0 && !id.is_valid_utf8())) { return false; }
            } else {
                i64 id = 0;
                if (!r.read_i64(&id) || id < -2147483648 || id > 2147483647) { return false; }
            }
            msg.has_id = true;
            i64 id_end = r.index;
            while (id_start < id_end) {
                msg.id_raw.push(body[id_start]); id_start += 1;
            }
        } else if (key.equals("params")) {
            if (saw_params) { return false; } saw_params = true;
            r.skip_whitespace();
            i64 p_start = r.index;
            if (p_start >= r.length || (body[p_start] != '{' && body[p_start] != '[')) { return false; }
            r.skip_value();
            i64 p_end = r.index;
            i64 j = p_start;
            while (j < p_end && j < r.length) {
                msg.params_json.push(body[j]);
                j += 1;
            }
        } else {
            r.skip_value();
        }
        key.drop();
        r.skip_whitespace();
        if (r.index >= r.length || body[r.index] != ',') { break; }
        r.index += 1;
    }
    if (!r.end_object() || r.failed) { return false; }
    r.skip_whitespace();
    return valid_version && r.index == r.length && msg.method.len() > 0 && msg.method.len() == strlen(msg.method.to_str());
}

struct RpcPollFd { i32 fd; i16 events; i16 returned; }

i32 rpc_read_byte(ByteStream* stream, i32* stopping) {
    while (stream.pos >= stream.len) {
        if (__atomic_load_i32(stopping, ATOMIC_ACQUIRE) != 0) { return -1; }
        RpcPollFd descriptor; descriptor.fd = (i32)stream.file.fd;
        descriptor.events = 1; descriptor.returned = 0;
        i64 ready = sys_poll((i64)&descriptor, 1, 50);
        if (ready > 0) { break; }
        if (ready < 0 && ready != -4) { return -1; }
    }
    return stream.read_byte();
}

bool read_header_line(ByteStream* stream, String* line, i32* stopping) {
    line.clear();
    while (true) {
        i32 b = rpc_read_byte(stream, stopping);
        if (b < 0) {
            return false;
        }
        if (b == 10) { // \n
            return true;
        }
        if (b != 13) { // skip \r
            line.push((char)b);
        }
        if (line.len() > 8192) { return false; }
    }
    return true;
}

bool read_rpc_message(ByteStream* stream, String* body_out, i32* stopping) {
    body_out.clear();
    i64 content_length = -1;
    String line = String.new();

    while (true) {
        if (!read_header_line(stream, &line, stopping)) {
            line.drop();
            return false;
        }
        if (line.len() == 0) {
            // End of headers (\r\n\r\n reached)
            break;
        }
        String lower = line.to_lowercase();
        if (lower.starts_with("content-length:")) {
            if (content_length >= 0) { return false; }
            str s = line.to_str();
            i64 idx = 15;
            while (idx < line.len() && (s[idx] == ' ' || s[idx] == '\t')) {
                idx += 1;
            }
            i64 val = 0;
            i64 digit_start = idx;
            while (idx < line.len() && s[idx] >= '0' && s[idx] <= '9') {
                val = val * 10 + (i64)(s[idx] - '0');
                if (val > 16777216) { return false; }
                idx += 1;
            }
            if (idx == digit_start) { return false; }
            while (idx < line.len() && (s[idx] == ' ' || s[idx] == '\t')) { idx += 1; }
            if (idx != line.len()) { return false; }
            content_length = val;
        }
    }
    line.drop();

    if (content_length <= 0) {
        return false;
    }

    u8* buf = alloc<u8>(content_length + 1);
    i64 total_read = 0;
    while (total_read < content_length) {
        i32 ch = rpc_read_byte(stream, stopping);
        if (ch < 0) {
            free(buf);
            return false;
        }
        buf[total_read] = (u8)ch;
        total_read += 1;
    }
    buf[content_length] = (u8)0;

    body_out.push_bytes(buf, content_length);
    free(buf);
    return true;
}
