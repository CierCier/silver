// LSP positions use UTF-16 code units; compiler spans use UTF-8 bytes.
import std.string;
import std.mem.vec;
import frontend.diagnostics;

/// A zero-based LSP position (line, UTF-16 column).
struct LspPosition { i64 line; i64 character; }

/// The byte offset of each line start, for fast position conversion.
struct LspLineIndex { Vec<i64> starts; i64 length; }

impl LspLineIndex {
    /// Builds the line index of `text` (`\n`, `\r\n`, and `\r` end lines).
    LspLineIndex new(str text) {
        LspLineIndex index; index.starts = Vec<i64>.new(); index.starts.push(0);
        index.length = strlen(text); i64 offset = 0;
        while (offset < index.length) {
            if (text[offset] == '\r') {
                if (offset + 1 < index.length && text[offset + 1] == '\n') { offset += 1; }
                index.starts.push(offset + 1);
            } else if (text[offset] == '\n') { index.starts.push(offset + 1); }
            offset += 1;
        }
        return move index;
    }

    /// Converts byte `offset` (clamped to the text) to an LSP position.
    LspPosition position(LspLineIndex* self, str text, i64 offset) {
        if (offset < 0) { offset = 0; }
        if (offset > self.length) { offset = self.length; }
        i64 low = 0; i64 high = self.starts.len();
        while (low < high) {
            i64 middle = low + (high - low) / 2;
            if (self.starts.get(middle) <= offset) { low = middle + 1; } else { high = middle; }
        }
        LspPosition position; position.line = low - 1; position.character = 0;
        i64 cursor = self.starts.get(position.line);
        while (cursor < offset) {
            u8 byte = (u8)text[cursor];
            if (byte == (u8)'\r' || byte == (u8)'\n') { position.line += 1; position.character = 0; break; }
            position.character += byte >= 240 ? 2 : 1;
            cursor += utf8_width(byte);
        }
        return position;
    }

    /// Converts an LSP position to a byte offset. A column past the line end
    /// clamps to the line end; a column inside a surrogate pair fails.
    bool offset(LspLineIndex* self, str text, i64 line, i64 character, i64* result) {
        if (line < 0 || line >= self.starts.len() || character < 0) { return false; }
        i64 cursor = self.starts.get(line); i64 column = 0;
        while (cursor < self.length && text[cursor] != '\n' && text[cursor] != '\r' && column < character) {
            u8 byte = (u8)text[cursor]; i64 units = byte >= 240 ? 2 : 1;
            if (column + units > character) { return false; }
            column += units; cursor += utf8_width(byte);
        }
        *result = cursor; return true;
    }
}

/// Returns the UTF-8 sequence length of a lead byte.
i64 utf8_width(u8 byte) {
    if (byte < 128) { return 1; }
    if (byte < 224) { return 2; }
    if (byte < 240) { return 3; }
    return 4;
}

/// Converts byte `offset` to an LSP position without an index (O(offset)).
LspPosition lsp_position(str text, i64 offset) {
    LspPosition pos;
    pos.line = 0;
    pos.character = 0;
    i64 i = 0;
    i64 length = strlen(text);
    while (i < offset && i < length) {
        u8 byte = (u8)text[i];
        if (byte == (u8)'\r') {
            pos.line += 1; pos.character = 0;
            if (i + 1 < length && text[i + 1] == '\n') { i += 1; }
        } else if (byte == (u8)'\n') { pos.line += 1; pos.character = 0; }
        else { pos.character += byte >= 240 ? 2 : 1; }
        i += utf8_width(byte);
    }
    return pos;
}

/// Converts an LSP position to a byte offset without an index.
bool lsp_offset(str text, i64 line, i64 character, i64* offset) {
    if (line < 0 || character < 0) { return false; }
    i64 current_line = 0;
    i64 i = 0;
    i64 length = strlen(text);
    while (i < length && current_line < line) {
        if (text[i] == '\r') {
            current_line += 1;
            if (i + 1 < length && text[i + 1] == '\n') { i += 1; }
        } else if (text[i] == '\n') { current_line += 1; }
        i += 1;
    }
    if (current_line != line) { return false; }
    i64 column = 0;
    while (i < length && text[i] != '\n' && text[i] != '\r' && column < character) {
        u8 byte = (u8)text[i];
        i64 units = byte >= 240 ? 2 : 1;
        if (column + units > character) { return false; }
        column += units;
        i += utf8_width(byte);
    }
    *offset = i;
    return true;
}

/// Appends a `{line, character}` JSON object.
void append_position(String* out, LspPosition pos) {
    out.push_str("{\"line\":"); out.push_display(&pos.line);
    out.push_str(",\"character\":"); out.push_display(&pos.character); out.push('}');
}

/// Appends an LSP range JSON object for `span`.
void append_source_range(String* out, str text, Span span) {
    out.push_str("{\"start\":"); append_position(out, lsp_position(text, span.start));
    out.push_str(",\"end\":"); append_position(out, lsp_position(text, span.end)); out.push('}');
}
