import std.mem.vec;
import std.mem.alloc;
import std.mem.memory;
import std.string;
import std.path;
import std.fs;
import std.hash;
import frontend.module_loader;
import tooling.index;
import positions;

/// True when the offset sits inside a string, char, or comment literal.
bool inside_literal(Document* doc, i64 offset) {
    i64 i = 0;
    while (i < doc.analysis.tokens.len()) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.span.start < offset && offset < token.span.end) {
            return token.kind == TokenKind.Comment || token.kind == TokenKind.StringLiteral
                || token.kind == TokenKind.CharLiteral;
        }
        i += 1;
    }
    return false;
}

/// Returns `source` made absolute against the current directory.
String absolute_document_path(str source) {
    String path = String.from_str(source);
    if (!path.starts_with("/")) {
        String cwd = current_dir(); path = path_join(cwd.to_str(), path.to_str());
    }
    return path_normalize(path.to_str());
}

/// Returns the local path of a `file://` URI, or "" for other schemes.
String document_path(str uri) {
    Optional<String> decoded = file_uri_to_path(uri);
    if (!decoded.is_some()) { return String.new(); }
    String path = decoded.unwrap(); return absolute_document_path(path.to_str());
}

/// One file known to the server: its text, line index, version, dirty
/// flags, cached diagnostics and semantic tokens, editor index, and the
/// documents it imports. Allocated and owned by the `DocumentStore`.
struct Document {
    i64 store_id;
    String uri;
    String path;
    String text;
    // Content hash of `text`, kept by `replace_text`; keys the diagnostic cache.
    i64 text_hash;
    LspLineIndex lines;
    i64 version;
    i64 revision;
    bool open;
    bool imports_dirty;
    bool diagnostics_dirty;
    String diagnostic_items;
    i64 diagnostic_revision;
    bool semantic_dirty;
    i64 semantic_generation;
    i64 previous_semantic_generation;
    Vec<i64> semantic_data;
    Vec<i64> previous_semantic_data;
    IdeIndex analysis;
    Vec<Document*> dependencies;
}

/// Every known document plus the workspace roots, include directories, and
/// project manifests used to resolve imports. Not thread-safe; owns the
/// documents.
struct DocumentStore {
    Vec<Document*> docs;
    Vec<String> roots;
    Vec<String> include_dirs;
    Vec<String> manifest_dirs;
    Vec<String> project_roots;
    // Manifest target entry files; workspace diagnostics start from these.
    Vec<String> project_entries;
    Vec<String> overlay_paths;
    bool discover_open_projects;
}

/// Returns true when `path` is inside one of `roots`.
bool path_within_roots(Vec<String>* roots, str path) {
    i64 i = 0;
    while (i < roots.len()) {
        String* root = roots.get_ptr(i);
        i64 length = root.len();
        if (length > 0 && module_text_starts_with(path, root.to_str()) && (strlen(path) == length
            || root.data[length - 1] == (u8)'/' || path[length] == '/')) { return true; }
        i += 1;
    }
    return false;
}

/// Returns true for an open document or one inside the workspace or a
/// project root.
bool workspace_document(DocumentStore* store, Document* doc) {
    return doc.open || path_within_roots(&store.roots, doc.path.to_str())
        || path_within_roots(&store.project_roots, doc.path.to_str());
}

/// Returns true when symbols of `doc` may be offered by auto-import.
bool auto_import_document(DocumentStore* store, Document* doc) {
    return path_within_roots(&store.roots, doc.path.to_str())
        || path_within_roots(&store.project_roots, doc.path.to_str())
        || path_within_roots(&store.include_dirs, doc.path.to_str())
        || (store.discover_open_projects && doc.open);
}

impl Document {
    /// Closed files keep stable symbol IDs and source text, not a full parse tree.
    void compact(Document* self) {
        if (self.open || self.analysis.tree.root == (SyntaxNode*)0) { return; }
        // Pointer field overwrites lack drop glue; locals own the discarded buffers.
        NodePool pool = move self.analysis.pool;
        self.analysis.pool = NodePool.new();
        self.analysis.tree.root = (SyntaxNode*)0;
        TokenStream _tokens = move self.analysis.tokens;
        self.analysis.tokens = TokenStream.new();
        Vec<IdeOccurrence> _occurrences = move self.analysis.occurrences;
        self.analysis.occurrences = Vec<IdeOccurrence>.new();
        Vec<i64> _definitions = move self.analysis.definitions;
        self.analysis.definitions = Vec<i64>.new();
        Vec<IdeImplementation> _implementations = move self.analysis.implementations;
        self.analysis.implementations = Vec<IdeImplementation>.new();
        pool.destroy();
    }

    /// Reparses a compacted document so its syntax tree is available again.
    void ensure_syntax(Document* self) {
        if (self.analysis.tree.root != (SyntaxNode*)0) { return; }
        // Requests can hold symbol pointers while restoring another file's syntax.
        Vec<IdeSymbol> retained = move self.analysis.symbols;
        self.analysis.symbols = Vec<IdeSymbol>.new();
        IdeIndex _previous = move self.analysis;
        self.analysis = IdeIndex.new(self.text.to_str());
        Vec<IdeSymbol> _rebuilt = move self.analysis.symbols;
        self.analysis.symbols = move retained;
    }

    /// Replaces the text, rebuilding the line index and editor analysis.
    void replace_text(Document* self, str text) {
        String _previous_text = move self.text;
        LspLineIndex _previous_lines = move self.lines;
        IdeIndex _previous_analysis = move self.analysis;
        self.text = String.from_str(text);
        self.text_hash = hash_bytes(self.text.data, self.text.len());
        self.lines = LspLineIndex.new(self.text.to_str());
        self.analysis = IdeIndex.new(self.text.to_str());
    }

    /// Returns the LSP position (UTF-16 columns) of byte `offset`.
    LspPosition position(Document* self, i64 offset) { return self.lines.position(self.text.to_str(), offset); }

    /// Converts an LSP position to a byte offset; false when out of range.
    bool offset(Document* self, i64 line, i64 character, i64* result) {
        return self.lines.offset(self.text.to_str(), line, character, result);
    }

    /// Appends a JSON LSP range for `span`.
    void append_range(Document* self, String* out, Span span) {
        out.push_str("{\"start\":"); append_position(out, self.position(span.start));
        out.push_str(",\"end\":"); append_position(out, self.position(span.end)); out.push('}');
    }
}

impl DocumentStore {
    /// Return an owned list borrowing the current workspace/import graph.
    /// An explicit target also participates when it is outside the workspace.
    Vec<Document*> query_documents(DocumentStore* self, Document* selected) {
        Vec<Document*> documents = Vec<Document*>.new(); Vec<bool> included = Vec<bool>.new(); i64 i = 0;
        while (i < self.docs.len()) {
            Document* doc = self.docs.get(i); bool include = doc == selected || workspace_document(self, doc);
            included.push(include); if (include) { documents.push(doc); } i += 1;
        }
        i = 0;
        while (i < documents.len()) {
            Document* doc = documents.get(i); i64 dependency = 0;
            while (dependency < doc.dependencies.len()) {
                Document* imported = doc.dependencies.get(dependency);
                if (!included.get(imported.store_id)) { included.set(imported.store_id, true); documents.push(imported); }
                dependency += 1;
            }
            i += 1;
        }
        return move documents;
    }

    /// Creates an empty store.
    DocumentStore new() {
        DocumentStore store;
        store.docs = Vec<Document*>.new();
        store.roots = Vec<String>.new();
        store.include_dirs = Vec<String>.new();
        store.manifest_dirs = Vec<String>.new();
        store.project_roots = Vec<String>.new();
        store.project_entries = Vec<String>.new();
        store.overlay_paths = Vec<String>.new();
        store.discover_open_projects = true;
        // Same sysroot fallback cascade as the compiler: SILVER_SYSROOT,
        // executable-relative prefix, user data dir, and system share dirs.
        Vec<String> sysroot_dirs = module_sysroot_include_dirs();
        i64 si = 0;
        while (si < sysroot_dirs.len()) {
            String absolute = absolute_document_path(sysroot_dirs.get_ptr(si).to_str());
            i64 existing = 0;
            while (existing < store.include_dirs.len()
                && !store.include_dirs.get_ptr(existing).equals(absolute.to_str())) { existing += 1; }
            if (existing == store.include_dirs.len()) { store.include_dirs.push(move absolute); }
            else { absolute.drop(); }
            si += 1;
        }
        sysroot_dirs.drop();
        return move store;
    }

    /// Returns the document for `uri` (matched by path), or null.
    Document* get(DocumentStore* self, str uri) {
        String path = document_path(uri);
        i64 i = 0;
        while (i < self.docs.len()) {
            Document* doc = self.docs.get(i);
            if (doc.uri.equals(uri) || (path.len() > 0 && doc.path.equals(path.to_str()))) { return doc; }
            i += 1;
        }
        return (Document*)0;
    }

    /// Creates or replaces the document for `uri`. Ignores (returns null) a
    /// stale version for an open document; otherwise reindexes it, marks it
    /// dirty, and invalidates the documents that import it.
    Document* set(DocumentStore* self, str uri, str text, i64 version, bool open) {
        Document* doc = self.get(uri);
        if (doc == (Document*)0) {
            // Snapshot replacement takes ownership of the previous fields, even on first load.
            doc = alloc<Document>(1);
            doc.store_id = self.docs.len();
            doc.uri = String.from_str(uri);
            doc.path = document_path(uri);
            doc.dependencies = Vec<Document*>.new();
            self.docs.push(doc);
        } else if (doc.open && version <= doc.version) {
            return (Document*)0;
        } else { self.invalidate_dependents(doc); }
        if (open) { String _previous_uri = move doc.uri; doc.uri = String.from_str(uri); }
        doc.replace_text(text);
        doc.version = version;
        doc.revision += 1;
        doc.open = open;
        doc.imports_dirty = true;
        doc.diagnostics_dirty = true;
        doc.semantic_dirty = true;
        doc.compact();
        return doc;
    }

    /// Returns the document for file `path`, loading it from disk when unknown.
    /// Returns null for unreadable files, embedded NULs, or invalid UTF-8.
    Document* load(DocumentStore* self, str path) {
        String normalized = absolute_document_path(path);
        String uri = path_to_file_uri(normalized.to_str());
        Document* doc = self.get(uri.to_str());
        if (doc != (Document*)0) { return doc; }
        Result<String, Error> loaded = String.from_file(normalized.to_str());
        if (loaded.is_err()) { return (Document*)0; }
        String source = loaded.unwrap();
        if (source.len() != strlen(source.to_str()) || (source.len() > 0 && !source.is_valid_utf8())) { return (Document*)0; }
        return self.set(uri.to_str(), source.to_str(), 0, false);
    }

    /// Recomputes each dirty document's imports and dependencies.
    void refresh_imports(DocumentStore* self) {
        Vec<String> overlay_paths = Vec<String>.new(); i64 overlay = 0; bool changed = false;
        while (overlay < self.docs.len()) {
            Document* doc = self.docs.get(overlay);
            if (doc.open && doc.path.len() > 0) {
                i64 previous = 0;
                while (previous < self.overlay_paths.len() && !self.overlay_paths.get_ptr(previous).equals(doc.path.to_str())) { previous += 1; }
                if (previous == self.overlay_paths.len()) { changed = true; }
                overlay_paths.push(doc.path.clone());
            }
            overlay += 1;
        }
        changed = changed || overlay_paths.len() != self.overlay_paths.len();
        Vec<String> _previous_overlay_paths = move self.overlay_paths;
        self.overlay_paths = move overlay_paths;
        if (changed) {
            i64 dirty = 0;
            while (dirty < self.docs.len()) {
                Document* doc = self.docs.get(dirty);
                doc.imports_dirty = true; doc.diagnostics_dirty = true; doc.semantic_dirty = true;
                dirty += 1;
            }
        }
        i64 i = 0;
        while (i < self.docs.len()) {
            Document* doc = self.docs.get(i);
            if (!doc.imports_dirty) { i += 1; continue; }
            doc.imports_dirty = false;
            doc.diagnostics_dirty = true;
            doc.semantic_dirty = true;
            doc.dependencies.clear();
            if (doc.path.len() > 0) {
                i64 j = 0;
                while (j < doc.analysis.imports.len()) {
                    String path = resolve_document_import(self, doc, doc.analysis.imports.get_ptr(j).to_str());
                    if (path.len() > 0 && !path.ends_with(".agm")) {
                        Document* imported = self.load(path.to_str());
                        if (imported != (Document*)0 && imported != doc) { doc.dependencies.push(imported); }
                    }
                    j += 1;
                }
            }
            i += 1;
        }
    }

    /// Marks `uri` closed: reloads its on-disk text (or empties it), drops its
    /// parse tree, and invalidates its dependents.
    void close(DocumentStore* self, str uri) {
        Document* doc = self.get(uri);
        if (doc == (Document*)0) { return; }
        self.invalidate_dependents(doc);
        doc.open = false;
        doc.revision += 1;
        doc.imports_dirty = true;
        doc.diagnostics_dirty = true;
        doc.semantic_dirty = true;
        if (doc.path.len() > 0) {
            Result<String, Error> loaded = String.from_file(doc.path.to_str());
            if (loaded.is_ok()) {
                String text = loaded.unwrap();
                if (text.len() == strlen(text.to_str()) && (text.len() == 0 || text.is_valid_utf8())) {
                    doc.replace_text(text.to_str());
                    doc.compact();
                    return;
                }
            }
        }
        doc.replace_text("");
        doc.dependencies.clear();
        doc.compact();
    }

    /// Drops the parse trees of every closed document.
    void compact_closed(DocumentStore* self) {
        i64 i = 0;
        while (i < self.docs.len()) { self.docs.get(i).compact(); i += 1; }
    }

    /// Marks every document that transitively imports `changed` dirty.
    void invalidate_dependents(DocumentStore* self, Document* changed) {
        Vec<Document*> affected = Vec<Document*>.new(); affected.push(changed); i64 next = 0;
        while (next < affected.len()) {
            Document* dependency = affected.get(next); dependency.diagnostics_dirty = true; dependency.semantic_dirty = true;
            i64 i = 0;
            while (i < self.docs.len()) {
                Document* candidate = self.docs.get(i); bool depends = false; i64 j = 0;
                while (j < candidate.dependencies.len()) {
                    if (candidate.dependencies.get(j) == dependency) { depends = true; break; } j += 1;
                }
                if (depends) {
                    candidate.imports_dirty = true;
                    j = 0;
                    while (j < affected.len() && affected.get(j) != candidate) { j += 1; }
                    if (j == affected.len()) { affected.push(candidate); }
                }
                i += 1;
            }
            next += 1;
        }
    }
}

/// Resolves import `name` from `doc` to a file path ("" when unresolved),
/// using open documents as source overlays.
String resolve_document_import(DocumentStore* store, Document* doc, str name) {
    String module = module_root(doc.path.to_str()); String root = absolute_document_path(module.to_str()); String config = String.new();
    return resolve_module_path_with_sources(doc.path.to_str(), root.to_str(), name,
        &store.include_dirs, &config, &store.overlay_paths);
}

impl Drop for DocumentStore {
    void drop(*self) {
        i64 i = 0;
        while (i < self.docs.len()) {
            Document* doc = self.docs.get(i);
            @drop_in_place(doc, 1);
            free(doc);
            i += 1;
        }
    }
}

/// A symbol in a specific document; `symbol` is -1 when unresolved.
struct SymbolTarget { Document* document; i64 symbol; }

/// Searches `doc` and its imports (skipping `visited`) for a top-level
/// symbol `name` (a member of `owner` when set), writing it to `*target`.
void find_imported_symbol(Document* doc, str name, str owner, Vec<Document*>* visited, SymbolTarget* target) {
    i64 i = 0;
    while (i < visited.len()) { if (visited.get(i) == doc) { return; } i += 1; }
    visited.push(doc);
    i = ide_name_head(&doc.analysis, name);
    while (i >= 0) {
        IdeSymbol* symbol = doc.analysis.symbols.get_ptr(i);
        if (!symbol.local && !symbol.is_private && symbol.kind != IdeSymbolKind.Macro
            && symbol.name.equals(name) && symbol.owner.equals(owner)) {
            if (target.symbol == -1) { target.document = doc; target.symbol = i; }
            else { target.symbol = -2; }
        }
        i = doc.analysis.next_name.get(i);
    }
    i = 0;
    while (i < doc.dependencies.len()) {
        find_imported_symbol(doc.dependencies.get(i), name, owner, visited, target);
        i += 1;
    }
}

/// Collects members named `name` of `owner` across `doc` and its imports.
void collect_member_symbols(Document* doc, str name, str owner, Vec<Document*>* visited, Vec<SymbolTarget>* found) {
    i64 i = 0;
    while (i < visited.len()) { if (visited.get(i) == doc) { return; } i += 1; }
    visited.push(doc);
    i = ide_name_head(&doc.analysis, name);
    while (i >= 0) {
        IdeSymbol* symbol = doc.analysis.symbols.get_ptr(i);
        if (!symbol.local && !symbol.is_private && symbol.name.equals(name) && symbol.owner.equals(owner)) {
            SymbolTarget member; member.document = doc; member.symbol = i; found.push(member);
        }
        i = doc.analysis.next_name.get(i);
    }
    i = 0;
    while (i < doc.dependencies.len()) {
        collect_member_symbols(doc.dependencies.get(i), name, owner, visited, found); i += 1;
    }
}

/// One match wins; otherwise the kind the syntax prefers (see
/// ide_member_preferred). Two preferred matches stay ambiguous (-2).
SymbolTarget choose_member(Vec<SymbolTarget>* found, bool call) {
    SymbolTarget any; any.document = (Document*)0; any.symbol = -1;
    SymbolTarget preferred = any; i64 i = 0;
    while (i < found.len()) {
        SymbolTarget candidate = found.get(i);
        if (any.symbol == -1) { any = candidate; } else { any.symbol = -2; }
        IdeSymbol* symbol = candidate.document.analysis.symbols.get_ptr(candidate.symbol);
        if (ide_member_preferred(symbol.kind, call)) {
            if (preferred.symbol == -1) { preferred = candidate; } else { preferred.symbol = -2; }
        }
        i += 1;
    }
    return preferred.symbol != -1 ? preferred : any;
}

/// A type as written in source, and the document and offset whose scope
/// resolves its names.
struct TypeText { String text; Document* scope; i64 offset; }

/// Returns an unknown type text scoped to `doc`.
TypeText unknown_type(Document* doc) {
    TypeText found_type; found_type.text = String.new(); found_type.scope = doc; found_type.offset = 0; return move found_type;
}

/// Returns true for a byte that can appear in a type name.
bool type_name_byte(u8 c) {
    return (c >= (u8)'a' && c <= (u8)'z') || (c >= (u8)'A' && c <= (u8)'Z') || (c >= (u8)'0' && c <= (u8)'9') || c == (u8)'_';
}

/// Top-level entries of the `<...>` list that follows the first whole-word
/// `name` in `text`: `Map<String, Vec<i64>>*` with `Map` gives both arguments.
Vec<String> generic_arguments(str text, str name) {
    Vec<String> out = Vec<String>.new(); String source = String.from_str(text);
    i64 length = source.len(); i64 width = strlen(name); i64 i = 0; i64 open = -1;
    while (open < 0 && i + width <= length) {
        String word = source.substr(i, width);
        bool bounded = (i == 0 || !type_name_byte(source.data[i - 1]))
            && (i + width == length || !type_name_byte(source.data[i + width]));
        if (bounded && word.equals(name)) {
            i64 j = i + width;
            while (j < length && source.data[j] == (u8)' ') { j += 1; }
            if (j < length && source.data[j] == (u8)'<') { open = j; }
            else { return move out; }
        }
        i += 1;
    }
    if (open < 0) { return move out; }
    i64 depth = 0; i64 start = open + 1; i = open;
    while (i < length) {
        u8 c = source.data[i];
        if (c == (u8)'<') { depth += 1; }
        else if (c == (u8)'>') {
            depth -= 1;
            if (depth == 0) { String last = source.substr(start, i - start); out.push(last.trim()); return move out; }
        } else if (c == (u8)',' && depth == 1) {
            String item = source.substr(start, i - start); out.push(item.trim()); start = i + 1;
        }
        i += 1;
    }
    out.clear(); return move out;
}

/// Replaces whole-word type parameter names: `T* get_ptr` with T=String reads `String* get_ptr`.
String substitute_type_names(str text, Vec<String>* parameters, Vec<String>* arguments) {
    String source = String.from_str(text); String out = String.new(); i64 i = 0;
    while (i < source.len()) {
        if (!type_name_byte(source.data[i])) { out.push(source.data[i]); i += 1; continue; }
        i64 start = i;
        while (i < source.len() && type_name_byte(source.data[i])) { i += 1; }
        String word = source.substr(start, i - start); i64 k = 0; bool replaced = false;
        while (!replaced && k < parameters.len()) {
            if (parameters.get_ptr(k).equals(word.to_str())) { out.push_str(arguments.get_ptr(k).to_str()); replaced = true; }
            k += 1;
        }
        if (!replaced) { out.push_str(word.to_str()); }
    }
    return move out;
}

/// `text` from a member of `target` with the receiver's type arguments in place
/// of the owner's type parameters. Unchanged when either side is not generic.
String substitute_receiver(TypeText* receiver, SymbolTarget target, str text) {
    IdeSymbol* member = target.document.analysis.symbols.get_ptr(target.symbol);
    if (receiver.text.len() == 0 || member.owner.len() == 0) { return String.from_str(text); }
    SymbolTarget owner = visible_type_name(target.document, member.owner.to_str(), member.selection.start);
    if (owner.symbol < 0) { return String.from_str(text); }
    IdeSymbol* declaration = owner.document.analysis.symbols.get_ptr(owner.symbol);
    Vec<String> declared = generic_arguments(declaration.signature.to_str(), declaration.name.to_str());
    Vec<String> arguments = generic_arguments(receiver.text.to_str(), member.owner.to_str());
    if (declared.len() == 0 || declared.len() != arguments.len()) { return String.from_str(text); }
    // Bounds such as `T: Display` name the parameter first.
    Vec<String> parameters = Vec<String>.new(); i64 i = 0;
    while (i < declared.len()) { parameters.push(ide_owner_name(declared.get_ptr(i).to_str())); i += 1; }
    return substitute_type_names(text, &parameters, &arguments);
}

/// The receiver before the `.` that precedes a member occurrence, and whether
/// that receiver is a call result (`make().member`).
/// A type receiver written with arguments, `Point<i32>.new()`, sets
/// `written_end` to the end of its `>`; it is -1 otherwise.
bool member_receiver(Document* doc, i64 occurrence, i64* receiver, bool* call, i64* written_end) {
    *written_end = -1;
    SyntaxNode* separator = binding_previous_sibling(doc.analysis.occurrences.get_ptr(occurrence).node);
    if (separator == (SyntaxNode*)0 || separator.token_kind != TokenKind.Dot) { return false; }
    SyntaxNode* node = binding_previous_sibling(separator);
    *call = node != (SyntaxNode*)0 && node.kind == NodeKind.Parenthesized;
    if (*call) { node = binding_previous_sibling(node); }
    if (!*call && node != (SyntaxNode*)0
        && (node.token_kind == TokenKind.Greater || node.token_kind == TokenKind.RightShift)) {
        *written_end = node.span.end; i64 depth = 0;
        while (node != (SyntaxNode*)0) {
            if (node.token_kind == TokenKind.Greater) { depth += 1; }
            else if (node.token_kind == TokenKind.RightShift) { depth += 2; }
            else if (node.token_kind == TokenKind.Less) { depth -= 1; if (depth == 0) { break; } }
            node = binding_previous_sibling(node);
        }
        if (node != (SyntaxNode*)0) { node = binding_previous_sibling(node); }
    }
    if (node == (SyntaxNode*)0 || !node_is_identifier(node)) { return false; }
    *receiver = doc.analysis.occurrence_at(node.span.start);
    return *receiver >= 0 && *receiver < occurrence;
}

/// Returns the type of the receiver of a member occurrence.
TypeText member_receiver_type(Document* doc, i64 occurrence) {
    i64 receiver = -1; bool call = false; i64 written_end = -1;
    if (!member_receiver(doc, occurrence, &receiver, &call, &written_end)) { return unknown_type(doc); }
    TypeText found_type = expression_type(doc, receiver, call);
    // Keep the written arguments: `Point<i32>` substitutes into `Point<T> new(...)`.
    if (written_end >= 0 && found_type.text.len() > 0) {
        i64 start = doc.analysis.occurrences.get_ptr(receiver).node.span.start;
        found_type.text = doc.text.substr(start, written_end - start);
        found_type.scope = doc; found_type.offset = start;
    }
    return move found_type;
}

/// Concrete type of the expression ending at `occurrence` (`call` when call
/// arguments follow): a value's declared type or a call's return type, with a
/// generic receiver's type arguments substituted. A type name used as a
/// receiver (`String.new()`) is that type. Empty text when unknown.
TypeText expression_type(Document* doc, i64 occurrence, bool call) {
    TypeText found_type = unknown_type(doc);
    SymbolTarget target = follow_import_alias(resolve_occurrence(doc, occurrence));
    if (target.symbol < 0) { return move found_type; }
    IdeSymbol* symbol = target.document.analysis.symbols.get_ptr(target.symbol);
    found_type.scope = target.document; found_type.offset = symbol.selection.start;
    if (ide_type_symbol(symbol.kind) && symbol.kind != IdeSymbolKind.TypeParameter) {
        if (!call) { found_type.text = symbol.name.clone(); }
        return move found_type;
    }
    bool callable = symbol.kind == IdeSymbolKind.Function || symbol.kind == IdeSymbolKind.Method;
    if (callable != call) { return move found_type; }
    TypeText receiver = member_receiver_type(doc, occurrence);
    found_type.text = substitute_receiver(&receiver, target, symbol.type_name.to_str());
    return move found_type;
}

/// The member owner a type names, following aliases. A name the declaring
/// scope cannot see (a substituted argument) is resolved from `fallback`.
String type_text_owner(TypeText* found_type, Document* fallback) {
    String head = ide_owner_name(found_type.text.to_str());
    if (head.len() == 0) { return move head; }
    if (is_primitive_type_token(Lexer.keyword_kind(head.data, 0, head.len()))) { return move head; }
    SymbolTarget target = visible_type_name(found_type.scope, head.to_str(), found_type.offset);
    if (target.symbol < 0 && fallback != found_type.scope) { target = visible_type_name(fallback, head.to_str(), 0); }
    return symbol_receiver_owner(target);
}

/// A member's hover signature with its receiver's type arguments substituted:
/// `T item` reads `Text item` on a `Box<Text>`.
String concrete_signature(Document* doc, i64 occurrence, SymbolTarget target) {
    TypeText receiver = member_receiver_type(doc, occurrence);
    return substitute_receiver(&receiver, target, target.document.analysis.symbols.get_ptr(target.symbol).signature.to_str());
}

/// Resolves an occurrence (local, member, or imported) to its symbol.
SymbolTarget resolve_occurrence(Document* doc, i64 occurrence) {
    SymbolTarget target;
    target.document = doc;
    target.symbol = -1;
    if (occurrence < 0) { return target; }
    IdeOccurrence* selected = doc.analysis.occurrences.get_ptr(occurrence);
    if (selected.symbol >= 0) { target.symbol = selected.symbol; return target; }
    if (selected.symbol == -2) { target.symbol = -2; return target; }
    // An `@name` use only names a macro declared in this file; it never falls
    // back to an ordinary imported symbol of the same name.
    if (ide_macro_use(selected.node)) { return target; }
    String owner = selected.owner.clone();
    if (selected.member) {
        SyntaxNode* separator = binding_previous_sibling(selected.node);
        if (separator != (SyntaxNode*)0 && separator.token_kind == TokenKind.Dot) {
            // `value.member` or `call(...).member`; the owner comes from the receiver's type.
            i64 receiver = -1; bool call_result = false;
            i64 written_end = -1;
            if (!member_receiver(doc, occurrence, &receiver, &call_result, &written_end)) { return target; }
            TypeText found_type = expression_type(doc, receiver, call_result);
            owner = type_text_owner(&found_type, doc);
        }
        if (owner.len() == 0) { return target; }
        Vec<SymbolTarget> found = Vec<SymbolTarget>.new();
        i64 local = ide_name_head(&doc.analysis, selected.node.text);
        while (local >= 0) {
            IdeSymbol* symbol = doc.analysis.symbols.get_ptr(local);
            if (symbol.owner.equals(owner.to_str())) { SymbolTarget member; member.document = doc; member.symbol = local; found.push(member); }
            local = doc.analysis.next_name.get(local);
        }
        // Members declared in this file shadow imported ones of the same owner.
        Vec<Document*> visited = Vec<Document*>.new(); visited.push(doc); i64 i = 0;
        bool shadowed = found.len() > 0;
        while (!shadowed && i < doc.dependencies.len()) {
            collect_member_symbols(doc.dependencies.get(i), selected.node.text, owner.to_str(), &visited, &found);
            i += 1;
        }
        SymbolTarget chosen = choose_member(&found, ide_member_call(selected.node));
        if (chosen.symbol != -1) { return chosen; }
        return target;
    }
    Vec<Document*> visited = Vec<Document*>.new();
    visited.push(doc);
    i64 i = 0;
    while (i < doc.dependencies.len()) {
        find_imported_symbol(doc.dependencies.get(i), selected.node.text, owner.to_str(), &visited, &target);
        i += 1;
    }
    return target;
}

/// Follows an import alias symbol to the symbol it names.
SymbolTarget follow_import_alias(SymbolTarget target) {
    if (target.symbol < 0) { return target; }
    IdeSymbol* symbol = target.document.analysis.symbols.get_ptr(target.symbol);
    if (symbol.kind != IdeSymbolKind.ImportAlias) { return target; }
    Document* doc = target.document;
    Vec<Document*> visited = Vec<Document*>.new(); visited.push(doc);
    target.symbol = -1;
    i64 i = 0;
    while (i < doc.dependencies.len()) {
        find_imported_symbol(doc.dependencies.get(i), symbol.type_name.to_str(), "", &visited, &target);
        i += 1;
    }
    return target;
}

/// Resolves value name `name` visible at `offset` in `doc` or its imports.
SymbolTarget visible_name(Document* doc, str name, i64 offset) {
    SymbolTarget target; target.document = doc;
    target.symbol = ide_resolve_local(&doc.analysis, name, offset);
    if (target.symbol != -1) { return follow_import_alias(target); }
    Vec<Document*> visited = Vec<Document*>.new(); visited.push(doc); i64 i = 0;
    while (i < doc.dependencies.len()) {
        find_imported_symbol(doc.dependencies.get(i), name, "", &visited, &target); i += 1;
    }
    return follow_import_alias(target);
}

/// Resolves type name `name` visible at `offset` in `doc` or its imports.
SymbolTarget visible_type_name(Document* doc, str name, i64 offset) {
    SymbolTarget target; target.document = doc;
    target.symbol = ide_resolve_type(&doc.analysis, name, offset);
    if (target.symbol == -1) {
        Vec<Document*> visited = Vec<Document*>.new(); visited.push(doc); i64 i = 0;
        while (i < doc.dependencies.len()) {
            find_imported_symbol(doc.dependencies.get(i), name, "", &visited, &target); i += 1;
        }
    }
    target = follow_import_alias(target);
    if (target.symbol >= 0 && !ide_type_symbol(target.document.analysis.symbols.get_ptr(target.symbol).kind)) { target.symbol = -1; }
    return target;
}

/// Returns the owner type name of a symbol, following aliases.
String symbol_receiver_owner(SymbolTarget target) {
    target = follow_import_alias(target);
    Vec<SymbolTarget> visited = Vec<SymbolTarget>.new();
    while (target.symbol >= 0) {
        i64 i = 0;
        while (i < visited.len()) {
            SymbolTarget previous = visited.get(i);
            if (previous.document == target.document && previous.symbol == target.symbol) { return String.new(); }
            i += 1;
        }
        visited.push(target);
        IdeSymbol* symbol = target.document.analysis.symbols.get_ptr(target.symbol);
        if (symbol.kind == IdeSymbolKind.Struct || symbol.kind == IdeSymbolKind.Enum
            || symbol.kind == IdeSymbolKind.Trait) { return symbol.name.clone(); }
        if (symbol.kind == IdeSymbolKind.Function || symbol.kind == IdeSymbolKind.Method) { return String.new(); }
        if (symbol.type_owner.len() == 0 || (visited.len() > 1 && symbol.kind != IdeSymbolKind.TypeAlias)) { return String.new(); }
        if (is_primitive_type_token(Lexer.keyword_kind(symbol.type_owner.data, 0, symbol.type_owner.len()))) {
            return symbol.type_owner.clone();
        }
        target = visible_type_name(target.document, symbol.type_owner.to_str(), symbol.selection.start);
    }
    return String.new();
}
