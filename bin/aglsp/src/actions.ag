import document;
import imports;
import params;
import json_rpc;
import capabilities;

bool action_quickfix_context(str json, bool* allowed) {
    String diagnostics = json_field(json, "diagnostics"); JsonReader reader = JsonReader.new(diagnostics.to_str());
    if (!reader.begin_array()) { return false; }
    String only = json_field(json, "only"); *allowed = only.len() == 0;
    if (only.len() == 0) { return true; }
    reader = JsonReader.new(only.to_str()); if (!reader.begin_array()) { return false; }
    reader.skip_whitespace();
    while (!reader.failed && reader.index < reader.length && reader.input[reader.index] != ']') {
        String kind = reader.read_string(); if (reader.failed) { return false; }
        if (kind.equals("") || kind.equals("quickfix")) { *allowed = true; }
        if (!skip_comma_if_present(&reader)) { break; } reader.skip_whitespace();
    }
    return reader.end_array() && !reader.failed;
}

// Parse `context.only` into the action families the client asked for. An empty
// or absent filter allows every family.
void action_context(str json, bool* quickfix, bool* refactor) {
    *quickfix = true; *refactor = true;
    String only = json_field(json, "only");
    if (only.len() == 0) { return; }
    *quickfix = false; *refactor = false;
    JsonReader reader = JsonReader.new(only.to_str());
    if (!reader.begin_array()) { *quickfix = true; *refactor = true; return; }
    reader.skip_whitespace();
    while (!reader.failed && reader.index < reader.length && reader.input[reader.index] != ']') {
        String kind = reader.read_string();
        if (reader.failed) { return; }
        if (kind.equals("") || kind.equals("quickfix")) { *quickfix = true; }
        if (kind.equals("refactor") || kind.equals("refactor.extract")) { *refactor = true; }
        if (!skip_comma_if_present(&reader)) { break; }
        reader.skip_whitespace();
    }
}

i64 action_line_start(Document* doc, i64 offset) {
    i64 start = offset;
    while (start > 0 && doc.text.data[start - 1] != (u8)'\n') { start -= 1; }
    return start;
}

// A name that does not already appear in the document, so the new binding
// cannot capture or shadow an existing one.
String action_fresh_name(Document* doc, str base) {
    String name = String.from_str(base);
    i64 suffix = 1;
    while (true) {
        bool taken = false;
        i64 i = 0;
        while (i + name.len() <= doc.text.len()) {
            if (doc.text.data[i] == (u8)name.data[0]) {
                bool match = true; i64 j = 1;
                while (j < name.len()) {
                    if (doc.text.data[i + j] != (u8)name.data[j]) { match = false; break; }
                    j += 1;
                }
                if (match) { taken = true; break; }
            }
            i += 1;
        }
        if (!taken) { return move name; }
        name = String.from_str(base);
        name.push('_');
        name.push_display(&suffix);
        suffix += 1;
    }
}

// Offer `let name = <selection>;` on the line above the selection and replace
// the selection with the new binding. `let` infers the type, so no annotation
// is needed.
String extract_variable_action(Document* doc, Span selection) {
    if (selection.start >= selection.end || selection.end > doc.text.len()) { return String.new(); }
    String selected = doc.text.substr(selection.start, selection.end - selection.start);
    if (selected.len() == 0 || selected.len() != strlen(selected.to_str())) { return String.new(); }
    i64 line = action_line_start(doc, selection.start);
    String indent = String.new();
    i64 cursor = line;
    while (cursor < doc.text.len() && (doc.text.data[cursor] == (u8)' ' || doc.text.data[cursor] == (u8)'\t')) {
        indent.push(doc.text.data[cursor]);
        cursor += 1;
    }
    String name = action_fresh_name(doc, "extracted");
    String inserted = String.from_str("let ");
    inserted.push_str(name.to_str());
    inserted.push_str(" = ");
    inserted.push_str(selected.to_str());
    inserted.push_str(";\n");
    inserted.push_str(indent.to_str());
    String out = String.from_str("{\"title\":\"Extract to variable\",\"kind\":\"refactor.extract\",\"edit\":");
    out.push_str("{\"changes\":{\"");
    json_escape(doc.uri.to_str(), &out);
    out.push_str("\":[{\"range\":");
    Span at_line = Span.synthetic(); at_line.start = line; at_line.end = line;
    doc.append_range(&out, at_line);
    out.push_str(",\"newText\":\""); json_escape(inserted.to_str(), &out);
    out.push_str("\"},{\"range\":"); doc.append_range(&out, selection);
    out.push_str(",\"newText\":\""); json_escape(name.to_str(), &out);
    out.push_str("\"}]}}}");
    return move out;
}

String compute_code_actions(DocumentStore* store, Document* active, Span selection,
        bool quickfix, bool refactor, ClientOptions* client, PendingMessage* pending) {
    String imports = compute_import_actions(store, active, selection, quickfix, client, pending);
    String out = String.from_str("[");
    bool comma = false;
    i64 i = 1;
    while (i + 1 < imports.len()) { out.push(imports.data[i]); i += 1; }
    if (imports.len() > 2) { comma = true; }
    if (refactor) {
        String extra = extract_variable_action(active, selection);
        if (extra.len() > 0) {
            if (comma) { out.push(','); }
            out.push_str(extra.to_str());
        }
    }
    out.push(']');
    return move out;
}

void append_import_action(String* out, Document* active, str module_name, str name, bool versioned) {
    out.push_str("{\"title\":\"Import "); json_escape(name, out); out.push_str(" from "); json_escape(module_name, out);
    out.push_str("\",\"kind\":\"quickfix\",\"edit\":");
    out.push_str(versioned ? "{\"documentChanges\":[{\"textDocument\":{\"uri\":\"" : "{\"changes\":{\"");
    json_escape(active.uri.to_str(), out);
    if (versioned) {
        out.push_str("\",\"version\":"); if (active.open) { out.push_display(&active.version); } else { out.push_str("null"); }
        out.push_str("},\"edits\":[");
    } else { out.push_str("\":["); }
    append_import_edit(out, active, module_name);
    out.push_str(versioned ? "]}]}" : "]}}"); out.push('}');
}

String compute_import_actions(DocumentStore* store, Document* active, Span selection, bool allowed, ClientOptions* client, PendingMessage* pending) {
    Vec<Document*> documents = store.query_documents(active);
    String out = String.from_str("["); bool comma = false; Vec<String> offered = Vec<String>.new(); i64 occurrence = 0;
    while (allowed && occurrence < active.analysis.occurrences.len() && !request_interrupted(pending)) {
        IdeOccurrence* selected = active.analysis.occurrences.get_ptr(occurrence); Span span = selected.node.span;
        bool intersects = span.start <= selection.end && span.end >= selection.start;
        if (!selected.definition && !selected.member && intersects && resolve_occurrence(active, occurrence).symbol == -1) {
            i64 doc = 0;
            while (doc < documents.len() && !request_interrupted(pending)) {
                Document* candidate = documents.get(doc);
                if (candidate != active && candidate.path.len() > 0 && candidate.analysis.diagnostics.is_empty()) {
                    Vec<Document*> visited = Vec<Document*>.new(); SymbolTarget target; target.document = candidate; target.symbol = -1;
                    find_imported_symbol(candidate, selected.node.text, "", &visited, &target);
                    if (target.symbol >= 0 && target.document == candidate
                        && candidate.analysis.symbols.get_ptr(target.symbol).kind != IdeSymbolKind.ImportAlias) {
                        String module_name = import_module_name(store, active, candidate);
                        if (module_name.len() > 0) {
                            String key = module_name.clone(); key.push(':'); key.push_str(selected.node.text); i64 existing = 0;
                            while (existing < offered.len() && !offered.get_ptr(existing).equals(key.to_str())) { existing += 1; }
                            if (existing == offered.len() && !import_conflicts(active, candidate, pending)) {
                                offered.push(move key); if (comma) { out.push(','); } comma = true;
                                append_import_action(&out, active, module_name.to_str(), selected.node.text, client.versioned_edits);
                            }
                        }
                    }
                }
                doc += 1;
            }
        }
        occurrence += 1;
    }
    out.push(']'); return move out;
}
