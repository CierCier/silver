import document;
import positions;
import symbols;
import completion;
import params;
import capabilities;

i64 semantic_kind(IdeSymbolKind kind) {
    return match kind {
        IdeSymbolKind.Function : 9, IdeSymbolKind.Method : 10,
        IdeSymbolKind.Struct : 2, IdeSymbolKind.Enum : 3,
        IdeSymbolKind.Trait : 1, IdeSymbolKind.TypeAlias : 1,
        IdeSymbolKind.Field : 8, IdeSymbolKind.Variant : 4,
        IdeSymbolKind.Parameter : 6, IdeSymbolKind.TypeParameter : 5, _ : 7,
    };
}

Vec<i64> semantic_data(Document* doc, &SemanticTokenOptions options, i64 begin, i64 finish) {
    Vec<i64> data = Vec<i64>.new();
    if (begin == finish) { return move data; }
    i64 previous_line = 0; i64 previous_character = 0; i64 i = 0;
    while (i < doc.analysis.tokens.len()) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.span.end <= begin || token.span.start >= finish) { i += 1; continue; }
        i64 kind = -1; i64 modifiers = 0;
        if (token.kind == TokenKind.Comment) { kind = 13; }
        else if (token.kind == TokenKind.StringLiteral || token.kind == TokenKind.CharLiteral) { kind = 14; }
        else if (token.kind == TokenKind.IntLiteral || token.kind == TokenKind.FloatLiteral || token.kind == TokenKind.ComplexLiteral) { kind = 15; }
        else if (is_primitive_type_token(token.kind)) { kind = 1; }
        else if ((i64)token.kind >= (i64)TokenKind.Struct && (i64)token.kind <= (i64)TokenKind.Wait) { kind = 12; }
        else if ((i64)token.kind >= (i64)TokenKind.Plus && (i64)token.kind <= (i64)TokenKind.Decrement) { kind = 16; }
        else if (token.kind == TokenKind.Identifier) {
            i64 occurrence = doc.analysis.occurrence_at(token.span.start);
            SymbolTarget target = resolve_occurrence(doc, occurrence);
            if (target.symbol >= 0) {
                IdeSymbol* symbol = target.document.analysis.symbols.get_ptr(target.symbol);
                kind = semantic_kind(symbol.kind);
                if (doc.analysis.occurrences.get_ptr(occurrence).definition) { modifiers = 3; }
                if (symbol.readonly) { modifiers += 4; }
            }
        }
        if (kind >= 0) {
            kind = options.type_map[kind];
            if (kind < 0) { i += 1; continue; }
            i64 mapped_modifiers = 0; i64 bit = 0;
            while (bit < 3) {
                if ((modifiers & (1 << bit)) != 0) { mapped_modifiers = mapped_modifiers | options.modifier_map[bit]; }
                bit += 1;
            }
            i64 start = token.span.start;
            i64 limit = token.span.end;
            while (start < limit) {
                i64 end = start;
                while (end < limit && doc.text.data[end] != (u8)'\n' && doc.text.data[end] != (u8)'\r') { end += 1; }
                if (end > start) {
                    LspPosition position = doc.position(start);
                    LspPosition token_end = doc.position(end);
                    i64 delta_line = position.line - previous_line;
                    i64 delta_character = delta_line == 0 ? position.character - previous_character : position.character;
                    i64 length = token_end.character - position.character;
                    data.push(delta_line); data.push(delta_character); data.push(length); data.push(kind); data.push(mapped_modifiers);
                    previous_line = position.line; previous_character = position.character;
                }
                start = end + 1;
            }
        }
        i += 1;
    }
    return move data;
}

void append_semantic_data(String* out, Vec<i64>* data, i64 begin, i64 end) {
    out.push('['); i64 i = begin;
    while (i < end) { if (i > begin) { out.push(','); } i64 value = data.get(i); out.push_display(&value); i += 1; }
    out.push(']');
}

String semantic_result_id(Document* doc, i64 generation) {
    String id = doc.uri.clone(); id.push('#'); id.push_display(&generation); return move id;
}

void update_semantic_data(Document* doc, &SemanticTokenOptions options) {
    if (!doc.semantic_dirty) { return; }
    doc.previous_semantic_generation = doc.semantic_generation;
    Vec<i64> _previous_data = move doc.previous_semantic_data;
    doc.previous_semantic_data = move doc.semantic_data;
    doc.semantic_data = semantic_data(doc, options, 0, doc.text.len());
    doc.semantic_generation += 1; doc.semantic_dirty = false;
}

String compute_semantic_tokens(Document* doc, &SemanticTokenOptions options) {
    update_semantic_data(doc, options); String id = semantic_result_id(doc, doc.semantic_generation);
    String out = String.from_str("{\"resultId\":\""); json_escape(id.to_str(), &out); out.push_str("\",\"data\":");
    append_semantic_data(&out, &doc.semantic_data, 0, doc.semantic_data.len()); out.push('}'); return move out;
}

String compute_semantic_delta(Document* doc, &SemanticTokenOptions options, str previous_id) {
    update_semantic_data(doc, options);
    String current = semantic_result_id(doc, doc.semantic_generation);
    String previous = semantic_result_id(doc, doc.previous_semantic_generation);
    if (strcmp(previous_id, current.to_str()) != 0 && (doc.previous_semantic_generation == 0 || strcmp(previous_id, previous.to_str()) != 0)) {
        return compute_semantic_tokens(doc, options);
    }
    String out = String.from_str("{\"resultId\":\""); json_escape(current.to_str(), &out); out.push_str("\",\"edits\":[");
    if (strcmp(previous_id, current.to_str()) != 0) {
        i64 common = 0; i64 old_length = doc.previous_semantic_data.len(); i64 new_length = doc.semantic_data.len();
        while (common < old_length && common < new_length && doc.previous_semantic_data.get(common) == doc.semantic_data.get(common)) { common += 1; }
        i64 suffix = 0;
        while (suffix < old_length - common && suffix < new_length - common
            && doc.previous_semantic_data.get(old_length - suffix - 1) == doc.semantic_data.get(new_length - suffix - 1)) { suffix += 1; }
        if (common != old_length || common != new_length) {
            i64 removed = old_length - common - suffix;
            out.push_str("{\"start\":"); out.push_display(&common); out.push_str(",\"deleteCount\":"); out.push_display(&removed);
            out.push_str(",\"data\":"); append_semantic_data(&out, &doc.semantic_data, common, new_length - suffix); out.push('}');
        }
    }
    out.push_str("]}"); return move out;
}

String compute_semantic_range(Document* doc, &SemanticTokenOptions options, i64 begin, i64 end) {
    Vec<i64> data = semantic_data(doc, options, begin, end); String out = String.from_str("{\"data\":");
    append_semantic_data(&out, &data, 0, data.len()); out.push('}'); return move out;
}

void append_fold(Document* doc, Span span, bool comment, ClientOptions* client, String* out, i64* count) {
    if (*count >= client.folding_range_limit) { return; }
    LspPosition start = doc.position(span.start); LspPosition end = doc.position(span.end);
    // Keep the closing line visible, including any code after the delimiter.
    if (client.folding_line_only) { end.line -= 1; }
    if (start.line >= end.line) { return; }
    if (*count > 0) { out.push(','); } *count += 1;
    out.push_str("{\"startLine\":"); out.push_display(&start.line);
    if (!client.folding_line_only) {
        out.push_str(",\"startCharacter\":"); out.push_display(&start.character);
    }
    out.push_str(",\"endLine\":"); out.push_display(&end.line);
    if (!client.folding_line_only) {
        out.push_str(",\"endCharacter\":"); out.push_display(&end.character);
    }
    if (comment) { out.push_str(",\"kind\":\"comment\""); } out.push('}');
}

void append_folds(Document* doc, SyntaxNode* node, ClientOptions* client, String* out, i64* count) {
    if (node == (SyntaxNode*)0 || *count >= client.folding_range_limit) { return; }
    if (node.kind == NodeKind.Block || node.kind == NodeKind.Parenthesized || node.kind == NodeKind.Bracket) {
        append_fold(doc, node.span, false, client, out, count);
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0 && *count < client.folding_range_limit) {
        append_folds(doc, child, client, out, count); child = child.next_sibling;
    }
}

String compute_folding(Document* doc, ClientOptions* client) {
    String out = String.from_str("["); i64 count = 0;
    append_folds(doc, doc.analysis.tree.root, client, &out, &count);
    i64 i = 0;
    while (i < doc.analysis.tokens.len() && count < client.folding_range_limit) {
        Token* token = doc.analysis.tokens.get(i);
        if (token.kind == TokenKind.Comment && token.span.start_line < token.span.end_line) {
            append_fold(doc, token.span, true, client, &out, &count);
        }
        i += 1;
    }
    out.push(']'); return move out;
}

SyntaxNode* selection_node(SyntaxNode* node, i64 offset) {
    if (node == (SyntaxNode*)0 || offset < node.span.start || offset >= node.span.end) { return (SyntaxNode*)0; }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        SyntaxNode* selected = selection_node(child, offset);
        if (selected != (SyntaxNode*)0) { return selected; }
        child = child.next_sibling;
    }
    return node;
}

bool parse_selection_offsets(Document* doc, str json, Vec<i64>* offsets) {
    String positions = json_field(json, "positions"); JsonReader reader = JsonReader.new(positions.to_str());
    if (!reader.begin_array()) { return false; }
    reader.skip_whitespace();
    while (!reader.failed && reader.index < reader.length && reader.input[reader.index] != ']') {
        i64 start = reader.index;
        if (!reader.skip_value()) { return false; }
        String position = positions.substr(start, reader.index - start);
        i64 line = 0; i64 column = 0; i64 offset = 0;
        if (!parse_position(position.to_str(), &line, &column) || !doc.offset(line, column, &offset)) { return false; }
        offsets.push(offset);
        if (!skip_comma_if_present(&reader)) { break; } reader.skip_whitespace();
    }
    return reader.end_array() && !reader.failed;
}

String compute_selection_ranges(Document* doc, Vec<i64>* offsets) {
    String out = String.from_str("["); i64 i = 0;
    while (i < offsets.len()) {
        i64 offset = offsets.get(i);
        SyntaxNode* node = selection_node(doc.analysis.tree.root, offset);
        if (i > 0) { out.push(','); }
        i64 depth = 0; Span previous = Span.synthetic(); previous.start = -1;
        while (node != (SyntaxNode*)0) {
            if (previous.start != node.span.start || previous.end != node.span.end) {
                if (depth > 0) { out.push_str(",\"parent\":"); }
                out.push_str("{\"range\":"); doc.append_range(&out, node.span);
                previous = node.span; depth += 1;
            }
            node = node.parent;
        }
        if (depth == 0) {
            Span empty = Span.synthetic(); empty.start = offset; empty.end = offset;
            out.push_str("{\"range\":"); doc.append_range(&out, empty); depth = 1;
        }
        while (depth > 0) { out.push('}'); depth -= 1; }
        i += 1;
    }
    out.push(']'); return move out;
}

bool redundant_parameter_argument(Document* doc, i64 begin, i64 end, str name) {
    while (begin < end) {
        Token* first = doc.analysis.tokens.get(begin);
        Token* last = doc.analysis.tokens.get(end - 1);
        if (first.kind == TokenKind.Comment) { begin += 1; continue; }
        if (last.kind == TokenKind.Comment) { end -= 1; continue; }
        if (first.kind == TokenKind.LeftParen && last.kind == TokenKind.RightParen) {
            begin += 1; end -= 1; continue;
        }
        if (first.kind == TokenKind.Move || first.kind == TokenKind.BitwiseAnd) {
            begin += 1;
            if (first.kind == TokenKind.BitwiseAnd) {
                while (begin < end && doc.analysis.tokens.get(begin).kind == TokenKind.Comment) { begin += 1; }
                if (begin < end && doc.analysis.tokens.get(begin).kind == TokenKind.Mut) { begin += 1; }
            }
            continue;
        }
        return end == begin + 1 && first.kind == TokenKind.Identifier && first.text.equals(name);
    }
    return false;
}

String compute_inlay_hints(Document* doc, i64 start, i64 end) {
    String out = String.from_str("["); bool first = true; i64 i = 0;
    while (i < doc.analysis.symbols.len()) {
        IdeSymbol* symbol = doc.analysis.symbols.get_ptr(i);
        if (symbol.inferred && symbol.type_name.len() > 0 && !symbol.type_name.equals("unknown")
            && start <= symbol.selection.end && symbol.selection.end <= end) {
            if (!first) { out.push(','); } first = false;
            out.push_str("{\"position\":"); append_position(&out, doc.position(symbol.selection.end));
            out.push_str(",\"kind\":1,\"label\":\": "); json_escape(symbol.type_name.to_str(), &out); out.push_str("\"}");
        }
        i += 1;
    }
    i = 0;
    while (i < doc.analysis.tokens.len()) {
        Token* open = doc.analysis.tokens.get(i);
        if (open.kind == TokenKind.LeftParen && i > 0) {
            i64 occurrence = call_occurrence(doc, i);
            SymbolTarget target = follow_import_alias(resolve_occurrence(doc, occurrence));
            if (target.symbol >= 0 && occurrence >= 0 && !doc.analysis.occurrences.get_ptr(occurrence).definition) {
                IdeSymbol* symbol = target.document.analysis.symbols.get_ptr(target.symbol);
                SyntaxNode* separator = binding_previous_sibling(doc.analysis.occurrences.get_ptr(occurrence).node);
                i64 parameter = symbol.instance && separator != (SyntaxNode*)0 && separator.token_kind == TokenKind.Dot ? 1 : 0;
                i64 j = i + 1; Vec<i64> opens = Vec<i64>.new(); i64 argument = -1;
                while (j < doc.analysis.tokens.len()) {
                    Token* token = doc.analysis.tokens.get(j);
                    if (token.kind == TokenKind.Less) {
                        i64 close = generic_call_close_token(doc, j);
                        if (close >= 0) { j = close + 1; continue; }
                    }
                    bool boundary = opens.len() == 0 && (token.kind == TokenKind.RightParen || token.kind == TokenKind.Comma);
                    if (boundary || token.kind == TokenKind.Eof) {
                        if (argument >= 0 && parameter < symbol.parameter_names.len()) {
                            String* name = symbol.parameter_names.get_ptr(parameter);
                            Token* first_token = doc.analysis.tokens.get(argument);
                            if (!name.equals("_") && !redundant_parameter_argument(doc, argument, j, name.to_str())
                                && start <= first_token.span.start && first_token.span.start < end) {
                                if (!first) { out.push(','); } first = false;
                                out.push_str("{\"position\":"); append_position(&out, doc.position(first_token.span.start));
                                out.push_str(",\"kind\":2,\"paddingRight\":true,\"label\":\"");
                                json_escape(name.to_str(), &out); out.push_str(":\"}");
                            }
                        }
                        if (token.kind != TokenKind.Comma) { break; }
                        parameter += 1; argument = -1;
                    } else if (token.kind != TokenKind.Comment) {
                        if (is_close(token)) {
                            if (opens.len() == 0 || !matching_open(doc.analysis.tokens.get(opens.get(opens.len() - 1)), token)) { break; }
                            opens.pop(); j += 1; continue;
                        }
                        if (argument < 0) { argument = j; }
                        if (is_open(token)) { opens.push(j); }
                    }
                    j += 1;
                }
            }
        }
        i += 1;
    }
    out.push(']'); return move out;
}
