// std/io/byte_stream.ag — Buffered byte-oriented stream over a File.
// Provides a read-ahead buffer for efficient single-byte and bulk reads
// from unbuffered file descriptors.
import std.error;
import std.io.file;
import std.mem;
import std.mem.alloc;
import std.sys.result;
import std.optional;
import std.string;
import std.iter;

/// A read-ahead buffer over an owned `File`. Dropping it frees the buffer and
/// closes the file.
struct ByteStream {
    File file;
    u8* buf;
    i64 len;
    i64 pos;
    i64 cap;
}

impl ByteStream {
    /// Creates a stream over stdin with a 4 KiB buffer. Reads lazily.
    ByteStream stdin() {
        ByteStream bs;
        bs.file = stdin_file();
        bs.cap = 4096;
        bs.buf = alloc<u8>(bs.cap);
        bs.len = 0;
        bs.pos = 0;
        return bs;
    }

    /// Returns the next byte (0-255), or -1 at end of file or on a read error.
    /// May block to refill the buffer.
    i32 read_byte(*self) {
        if (self.pos < self.len) {
            i32 result = (i32)self.buf[self.pos];
            self.pos = self.pos + 1;
            return result;
        }
        if (self.file.invalid()) {
            return -1;
        }
        // Refill buffer from file.
        self.pos = 0;
        self.len = 0;
        Result<i64, Error> r = try_read(self.file.fd, self.buf, self.cap);
        if (r.is_err()) {
            self.file.had_error = true;
            return -1;
        }
        if (r.value() == 0) {
            self.file.at_eof = true;
            return -1;
        }
        self.len = r.value();
        self.pos = 1;
        return (i32)self.buf[0];
    }

    /// Copies up to `dst_len` bytes into `dst`, using buffered bytes first.
    /// Returns the count copied; 0 means end of file, an error, or an invalid
    /// file. May block.
    i64 read_into(*self, u8* dst, i64 dst_len) {
        if (dst_len <= 0 || self.file.invalid()) {
            return 0;
        }
        i64 total = 0;
        // Consume buffered bytes first.
        i64 avail = self.len - self.pos;
        if (avail > 0) {
            i64 to_copy = dst_len;
            if (to_copy > avail) {
                to_copy = avail;
            }
            i64 i = 0;
            while (i < to_copy) {
                dst[i] = self.buf[self.pos + i];
                i = i + 1;
            }
            self.pos = self.pos + to_copy;
            total = total + to_copy;
            dst = (u8*)((i64)dst + to_copy);
            dst_len = dst_len - to_copy;
        }
        // If more bytes are needed, refill and copy again.
        while (dst_len > 0 && !self.file.at_eof && !self.file.had_error) {
            self.pos = 0;
            self.len = 0;
            Result<i64, Error> r = try_read(self.file.fd, self.buf, self.cap);
            if (r.is_err()) {
                self.file.had_error = true;
                break;
            }
            if (r.value() == 0) {
                self.file.at_eof = true;
                break;
            }
            self.len = r.value();
            i64 to_copy = dst_len;
            if (to_copy > self.len) {
                to_copy = self.len;
            }
            i64 i = 0;
            while (i < to_copy) {
                dst[i] = self.buf[i];
                i = i + 1;
            }
            self.pos = to_copy;
            total = total + to_copy;
            dst = (u8*)((i64)dst + to_copy);
            dst_len = dst_len - to_copy;
        }
        return total;
    }

    /// Creates a stream that takes ownership of `f`, with a 4 KiB buffer.
    ByteStream from_file(File f) {
        ByteStream bs;
        bs.file = move f;
        bs.cap = 4096;
        bs.buf = alloc<u8>(bs.cap);
        bs.len = 0;
        bs.pos = 0;
        return bs;
    }

    /// Returns the next line including its trailing `\n` (the last line may lack
    /// one), or None at end of file. `\r` is kept. A read error ends the line.
    Optional<String> read_line(&mut self) {
        if (self.eof()) {
            return Optional<String>.none();
        }
        String s = String.new();
        while (true) {
            i32 b = self.read_byte();
            if (b < 0) {
                if (s.len() == 0) {
                    return Optional<String>.none();
                }
                break;
            }
            s.push((u8)b);
            if (b == 10) {
                break;
            }
        }
        return Optional<String>.some(move s);
    }

    /// Returns true when the buffer is empty and the file has reported end of
    /// file. Does not read ahead, so it can be false right before EOF.
    bool eof(&self) {
        if (self.pos < self.len) {
            return false;
        }
        return self.file.at_eof;
    }
}

impl Drop for ByteStream {
    void drop(*self) {
        if (self.buf != (u8*)0) {
            free(self.buf);
            self.buf = (u8*)0;
        }
        self.file.close();
        self.len = 0;
        self.pos = 0;
        self.cap = 0;
    }
}

/// A buffered reader over an owned `File`; a thin wrapper of `ByteStream`.
struct BufReader {
    ByteStream inner;
}

impl BufReader {
    /// Creates a reader that takes ownership of `f`.
    BufReader new(File f) {
        BufReader br;
        br.inner = ByteStream.from_file(move f);
        return br;
    }

    /// Returns the next byte, or -1 at end of file or on error.
    i32 read_byte(&mut self) {
        return self.inner.read_byte();
    }

    /// Copies up to `dst_len` bytes into `dst`; returns the count (0 at EOF).
    i64 read_into(&mut self, u8* dst, i64 dst_len) {
        return self.inner.read_into(dst, dst_len);
    }

    /// Returns the next line including its `\n`, or None at end of file.
    Optional<String> read_line(&mut self) {
        return self.inner.read_line();
    }

    /// Returns true when no buffered bytes remain and the file reported EOF.
    bool eof(&self) {
        return self.inner.eof();
    }
}

impl File {
    /// Returns the next line including its trailing `\n` (the last line may lack
    /// one), or None at end of file. Allocates a 4 KiB read buffer on first use.
    /// A read error sets `had_error` and ends the line. Do not mix with unbuffered
    /// reads on the same file: buffered bytes would be skipped.
    Optional<String> read_line(*self) {
        if (self.invalid() || self.at_eof) {
            return Optional<String>.none();
        }
        String s = String.new();
        while (true) {
            if (self.read_pos >= self.read_len) {
                if (self.read_buf == (u8*)0) {
                    self.read_buf = alloc<u8>(4096);
                }
                self.read_pos = 0;
                self.read_len = 0;
                Result<i64, Error> r = try_read(self.fd, self.read_buf, 4096);
                if (r.is_err()) {
                    self.had_error = true;
                    if (s.len() == 0) {
                        return Optional<String>.none();
                    }
                    break;
                }
                i64 n = r.value();
                if (n <= 0) {
                    self.at_eof = true;
                    if (s.len() == 0) {
                        return Optional<String>.none();
                    }
                    break;
                }
                self.read_len = n;
            }
            i64 start = self.read_pos;
            i64 found = -1;
            for (i64 i = start; i < self.read_len; i = i + 1) {
                if (self.read_buf[i] == (u8)10) {
                    found = i;
                    break;
                }
            }
            if (found >= 0) {
                i64 count = found - start + 1;
                for (i64 i = 0; i < count; i = i + 1) {
                    s.push(self.read_buf[start + i]);
                }
                self.read_pos = found + 1;
                break;
            } else {
                i64 count = self.read_len - start;
                for (i64 i = 0; i < count; i = i + 1) {
                    s.push(self.read_buf[start + i]);
                }
                self.read_pos = self.read_len;
            }
        }
        return Optional<String>.some(move s);
    }

    /// Returns an iterator over the remaining lines (see `read_line`). The
    /// iterator borrows the file, which must outlive it.
    LinesIter lines(*self) {
        LinesIter it;
        it.file = self;
        return it;
    }
}

/// An iterator of lines from a borrowed `File`; yields owned strings.
struct LinesIter {
    File* file;
}

impl IntoIterator for LinesIter {
    type Item = String;
    type IntoIter = LinesIter;
    LinesIter into_iter(LinesIter self) {
        return self;
    }
}

impl Iterator for LinesIter {
    type Item = String;
    Optional<String> next(*self) {
        return self.file.read_line();
    }
}

