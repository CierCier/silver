// std/io/file.ag — Silver file I/O: typed-syscall File API and the
// pure-Silver print path (BufWriter, STDOUT/STDERR, println).
//
// The plain print path (println/eprintln) writes through raw sys_write via
// std.fmt (pure Silver, no printf/puts).  The File API runs directly on the
// typed syscall layer (std.sys.result: try_open/try_read/try_write/
// try_close/try_lseek) — no FILE*, no libc stdio buffering.


import std.atomic;
import std.cpu;
import std.error;
import std.result;
import std.fmt;
import std.mem.alloc;
import std.mem.drop;
import std.sys.result;
if (@cfg(os.linux)) {
    import std.sys.raw.fs;
}

/// Sentinel returned by the byte-oriented `File` methods at end of file or on
/// error.
const i32 EOF = -1;

/// Seek origins for File.seek_from (values match lseek(2) whence).
enum IO_SEEK {
    SET = 0;
    CURSOR = 1;
    END = 2;
}


// ---------------------------------------------------------------------------
// BufWriter — buffered I/O backed by a growable heap buffer and a raw fd.
// Provides write_str/write_i64/write_u64/write_f64/write_bool for the
// compile-time print expansion and manual formatting use.
// Global instances STDOUT and STDERR are lazy-initialized (cap == 0).
//
// We store the buffer address as `i64` rather than `u8*` so the global
// initializer (which runs at compile time) can use integer 0 instead of
// a null-pointer literal.
// ---------------------------------------------------------------------------

/// A buffered writer over a file descriptor, or over memory for `@format`.
/// The buffer is allocated lazily on first write. `STDOUT` and `STDERR` are
/// flushed automatically at process exit; other writers must be flushed or
/// dropped by their owner, or buffered output is lost.
struct BufWriter {
    i64 data;   // address of buffer (0 = uninitialized)
    i64 len;
    i64 cap;
    i64 fd;
    BufWriter* list_next;   // intrusive linked list (flush-on-exit chain)
    BufWriter* list_prev;
    u8 mode;                // IOMODE_UNBUFFERED | IOMODE_LINE | IOMODE_BLOCK
}

// Zero-cost global instances (all zero → triggers lazy init on first write).
/// Process-wide stdout writer, line buffered. Not synchronized: concurrent
/// writers from several threads can interleave or race.
BufWriter STDOUT = { .data = 0, .len = 0, .cap = 0, .fd = 1,
    .list_next = (BufWriter*)0, .list_prev = (BufWriter*)0, .mode = 1 };
/// Process-wide stderr writer, unbuffered (each write is a syscall).
BufWriter STDERR = { .data = 0, .len = 0, .cap = 0, .fd = 2,
    .list_next = (BufWriter*)0, .list_prev = (BufWriter*)0, .mode = 0 };

// Buffering modes for BufWriter.
// Internal constants — no `pub` needed (public by default in Silver).
/// Buffering mode: one write syscall per write call.
const u8 IOMODE_UNBUFFERED = 0;   // immediate syscall per write
/// Buffering mode: flush whenever written data contains a newline.
const u8 IOMODE_LINE      = 1;   // flush when data contains \n
/// Buffering mode: flush when the buffer fills or on an explicit flush.
const u8 IOMODE_BLOCK     = 2;   // flush when buffer is full or explicit call
/// Buffering mode: in-memory buffer for `@format`/`@sprint`; never written to
/// an fd.
const u8 IOMODE_MEMORY    = 3;   // in-memory @format/@sprint buffer (fd = -1)

/// Head of the intrusive linked list of global BufWriters (STDOUT, STDERR).
/// NULL = empty list. No heap allocation, no size limit.
BufWriter* __buf_writer_list;

// Scratch buffers for number formatting.
/// Internal: 32-byte scratch buffer for number formatting.
struct __Buf32 { u8 data[32]; }
/// Internal: 40-byte scratch buffer for number formatting.
struct __Buf40 { u8 data[40]; }

impl BufWriter {
    /// Ensure internal buffer is initialized (lazy mmap).
    void ensure_init(*self) {
        if (self.cap == 0) {
            // UNBUFFERED mode: no buffer allocation, just set cap sentinel.
            if (self.mode == IOMODE_UNBUFFERED) {
                self.cap = -1;   // sentinel: "initialized, no buffer"
                return;
            }
            i64 buf = (i64)malloc(4096);
            if (__atomic_cmpxchg_i64(&self.data, 0, buf, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST)) {
                self.len = 0;
                __atomic_store_i64(&self.cap, 4096, ATOMIC_RELEASE);
            } else {
                free((void*)buf);
                while (__atomic_load_i64(&self.cap, ATOMIC_ACQUIRE) == 0) {
                    cpu_relax();
                }
            }
        }
    }

    /// Buffer a write.  Flush behavior depends on self.mode.
    void write(*self, u8* src, i64 n) {
        if (n <= 0 || src == (u8*)0) {
            return;
        }
        self.ensure_init();

        // UNBUFFERED: direct syscall, no buffering.
        if (self.mode == IOMODE_UNBUFFERED) {
            if (self.fd >= 0) {
                __fmt_write_fd(self.fd, src, n);
            }
            return;
        }

        // IN-MEMORY writers (IOMODE_MEMORY, @format/@sprint): accumulate
        // into the buffer, growing it. A negative cap is a stack scratch
        // buffer (set up by the compiler); a positive cap is heap-owned.
        // Detection keys on mode (u8, loaded exactly) rather than fd, whose
        // i32 slot reads as i64 with adjacent garbage upper bits. This also
        // fixes the old behavior where a chunk larger than the 4096 buffer
        // was silently dropped.
        if (self.mode == IOMODE_MEMORY) {
            i64 active_cap = self.cap;
            if (active_cap < 0) {
                active_cap = 0 - active_cap;
            }
            if (self.len + n > active_cap) {
                i64 new_cap = active_cap * 2;
                if (new_cap < self.len + n) {
                    new_cap = self.len + n;
                }
                u8* heap = (u8*)malloc(new_cap);
                if (self.len > 0) {
                    silver_rt_memcpy(heap, (u8*)self.data, self.len);
                }
                if (self.cap > 0) {
                    free((u8*)self.data);
                }
                self.data = (i64)heap;
                self.cap = new_cap;
            }
            silver_rt_memcpy((u8*)(self.data + self.len), src, n);
            self.len = self.len + n;
            return;
        }

        // BLOCK + LINE: use the buffer.
        // If the incoming data exceeds remaining capacity, flush first.
        // (Both modes need this guard to prevent buffer overflow.)
        if (self.len + n > self.cap && self.len > 0) {
            self.flush();
        }

        // If data still doesn't fit after flush (single chunk > cap), write directly.
        // LINE mode: also bypass for oversized chunks — can't reliably detect \n in them.
        if (n > self.cap && self.len == 0) {
            if (self.fd >= 0) {
                __fmt_write_fd(self.fd, src, n);
            }
            return;
        }

        if (self.len + n > self.cap) {
            i64 new_cap = self.cap * 2;
            if (new_cap < self.len + n) {
                new_cap = self.len + n;
            }
            u8* heap = (u8*)malloc(new_cap);
            if (self.len > 0) {
                silver_rt_memcpy(heap, (u8*)self.data, self.len);
            }
            if (self.cap > 0) {
                free((u8*)self.data);
            }
            self.data = (i64)heap;
            self.cap = new_cap;
        }

        // Copy bytes into buffer.
        u8* buf = (u8*)self.data;
        silver_rt_memcpy(&buf[self.len], src, n);
        self.len = self.len + n;

        // LINE: flush if any \n in the written data.
        if (self.mode == IOMODE_LINE) {
            i64 j = self.len - n;
            i64 flushed = 0;
            while (j < self.len) {
                if (buf[j] == (u8)10) {
                    // Flush up to and including this \n.
                    self.flush();
                    flushed = 1;
                    break;
                }
                j += 1;
            }
        }
    }

    /// Write a null-terminated string.
    void write_str(*self, str s) {
        if (s == (str)0) {
            return;
        }
        self.write((u8*)s, cstr_len((u8*)s));
    }

    /// Format and buffer an i64 value.
    void write_i64(*self, i64 v) {
        __Buf32 tmp;
        u8* p = (u8*)&tmp;
        i64 n = itoa(v, p);
        self.write(p, n);
    }

    /// Format and buffer a u64 value.
    void write_u64(*self, u64 v) {
        __Buf32 tmp;
        u8* p = (u8*)&tmp;
        i64 n = utoa(v, p);
        self.write(p, n);
    }

    /// Format and buffer a u128 value.
    void write_u128(*self, u128 v) {
        __Buf40 tmp;
        u8* p = (u8*)&tmp;
        i64 n = utoa128(v, p);
        self.write(p, n);
    }

    /// Format and buffer an i128 value.
    void write_i128(*self, i128 v) {
        __Buf40 tmp;
        u8* p = (u8*)&tmp;
        i64 n = itoa128(v, p);
        self.write(p, n);
    }

    /// Format and buffer an f64 value.
    void write_f64(*self, f64 v) {
        FmtPrintBuf tmp;
        u8* p = (u8*)&tmp;
        i64 n = ftoa(v, p);
        self.write(p, n);
    }

    /// Format and buffer a bool value.
    void write_bool(*self, bool v) {
        if (v) { self.write_str("true"); }
        else   { self.write_str("false"); }
    }
    /// Write a single byte.
    void write_u8(*self, u8 c) {
        self.write(&c, 1);
    }

    /// Write a Unicode scalar as UTF-8, replacing invalid values with U+FFFD.
    void write_char(*self, char value) {
        u8 bytes[4];
        i64 length = utf8_encode(value, &bytes[0]);
        self.write(&bytes[0], length);
    }

    /// Format and buffer a pointer value as 0x... hex.
    void write_ptr(*self, void* p) {
        u64 val = (u64)p;
        if (val == (u64)0) {
            self.write_str("0x0");
            return;
        }
        u8 buf[20];
        buf[0] = (u8)'0';
        buf[1] = (u8)'x';
        u8 hex_digits[16];
        i64 n = 0;
        while (val > (u64)0) {
            u64 d = val & (u64)0xF;
            if (d < (u64)10) {
                hex_digits[n] = (u8)((u8)'0' + (u8)d);
            } else {
                hex_digits[n] = (u8)((u8)'a' + (u8)(d - (u64)10));
            }
            n = n + 1;
            val = val >> (u64)4;
        }
        i64 i = 0;
        while (i < n) {
            buf[2 + i] = hex_digits[n - 1 - i];
            i = i + 1;
        }
        self.write(&buf[0], 2 + n);
    }

    /// Promote an in-memory writer (IOMODE_MEMORY) from its stack scratch
    /// buffer to an owned heap block before @format/@sprint hand the buffer
    /// off to a String or return it as str. No-op when already heap-owned.
    void __promote_in_memory(*self) {
        if (self.mode == IOMODE_MEMORY && self.cap < 0) {
            u8* heap = (u8*)malloc(self.len);
            silver_rt_memcpy(heap, (u8*)self.data, self.len);
            self.data = (i64)heap;
            self.cap = self.len;
        }
    }

    /// Flush buffered data to the underlying fd via a single sys_write call.
    void flush(*self) {
        self.ensure_init();
        if (self.len > 0) {
            if (self.fd >= 0) {
                i64 written = __fmt_write_fd(self.fd, (u8*)self.data, self.len);
                if (written > 0) {
                    if (written < self.len) {
                        u8* buf = (u8*)self.data;
                        i64 i = 0;
                        i64 remaining = self.len - written;
                        while (i < remaining) {
                            buf[i] = buf[written + i];
                            i += 1;
                        }
                        self.len = remaining;
                    } else {
                        self.len = 0;
                    }
                }
            }
        }
    }

}

impl Drop for BufWriter {
    /// Drop: flush remaining data, then free the buffer.
    void drop(*self) {
        self.flush();
        if (self.cap > 0) {
            free((void*)self.data);
            self.data = 0;
            self.cap = 0;
        }
    }
}

// ---------------------------------------------------------------------------

/// Release the internal buffer (used at process exit for global writers,
/// which are never auto-dropped).
void free_buffer(BufWriter* self) {
    if (self.cap > 0) {
        free((void*)self.data);
        self.data = 0;
        self.cap = 0;
    }
}

// ---------------------------------------------------------------------------
// Global buffer flush — called by _start after main() returns.
// ---------------------------------------------------------------------------

/// Flush the global STDOUT and STDERR buffers on process exit.
/// Called from _start after main() returns.
/// Uses explicit references rather than an intrusive list, so stack-local
/// BufWriters with fd=1/2 are never accidentally registered.
void __silver_flush_all() {
    STDOUT.flush();
    STDERR.flush();
    // Globals are never auto-dropped; free their buffers so leak-check
    // reports stay clean (the 4096-byte lazy-init buffer leaked before).
    free_buffer(&STDOUT);
    free_buffer(&STDERR);
}
// File — a typed-syscall file descriptor wrapper.
/// An open file descriptor with 4 KiB read and write buffers. Writes are
/// buffered until `flush`, `close`, a read, or a seek. `at_eof`/`had_error`
/// remember the last result so `eof()`/`error()` work like stdio. Dropping
/// an owning `File` flushes and closes it; flush errors are then lost, so
/// call `flush` or `close` yourself when they matter.
struct File {
    i32 fd;
    bool is_open;
    bool at_eof;
    bool had_error;
    bool owns_fd;
    u8* read_buf;
    i64 read_pos;
    i64 read_len;
    u8* write_buf;
    i64 write_len;
}

impl File {
    /// Wraps `fd`, taking ownership: `close` and drop close it.
    File from_fd(i32 fd) {
        File file = { .fd = fd, .is_open = fd >= 0, .at_eof = false, .had_error = false, .owns_fd = true, .read_buf = (u8*)0, .read_pos = 0, .read_len = 0, .write_buf = (u8*)0, .write_len = 0 };
        return file;
    }

    /// Returns a closed `File` (`invalid()` is true).
    File closed() {
        File file = { .fd = -1, .is_open = false, .at_eof = false, .had_error = false, .owns_fd = false, .read_buf = (u8*)0, .read_pos = 0, .read_len = 0, .write_buf = (u8*)0, .write_len = 0 };
        return file;
    }
    /// Wraps `fd` without ownership: `close` and drop leave it open.
    File borrow_fd(i32 fd) {
        File file = { .fd = fd, .is_open = fd >= 0, .at_eof = false, .had_error = false, .owns_fd = false, .read_buf = (u8*)0, .read_pos = 0, .read_len = 0, .write_buf = (u8*)0, .write_len = 0 };
        return file;
    }


    /// fopen-style mode string -> open(2) flags.  Unknown/empty modes
    /// conservatively map to O_RDONLY.
    i64 mode_flags(str mode) {
        if (mode == (str)0) {
            return O_RDONLY;
        }
        u8* m = (u8*)mode;
        u8 first = m[0];
        bool plus = cstr_contains(m, 43);   // '+'
        bool has_x = cstr_contains(m, 120); // 'x'
        if (first == (u8)114) {             // 'r'
            if (plus) {
                return O_RDWR;
            }
            return O_RDONLY;
        }
        if (first == (u8)119) {             // 'w'
            i64 flags = O_WRONLY | O_CREAT | O_TRUNC;
            if (plus) {
                flags = O_RDWR | O_CREAT | O_TRUNC;
            }
            if (has_x) {
                flags = flags | O_EXCL;
            }
            return flags;
        }
        if (first == (u8)97) {              // 'a'
            i64 flags = O_WRONLY | O_CREAT | O_APPEND;
            if (plus) {
                flags = O_RDWR | O_CREAT | O_APPEND;
            }
            if (has_x) {
                flags = flags | O_EXCL;
            }
            return flags;
        }
        return O_RDONLY;
    }

    /// Opens `path` with an fopen-style mode (`r`, `w`, `a`, optional `+`/`x`).
    /// New files get mode 0666 minus the umask. Returns a closed `File` on
    /// failure; use `try_open` to get the error.
    File open(str path, str mode) {
        Result<i64, Error> r = try_open(path, File.mode_flags(mode), 438); // 0o666
        if (r.is_err()) {
            return File.closed();
        }
        return File.from_fd((i32)r.value());
    }

    /// Opens `path` like `open`, but returns the OS error on failure.
    Result<File, Error> try_open(str path, str mode) {
        Result<i64, Error> r = try_open(path, File.mode_flags(mode), 438); // 0o666
        if (r.is_err()) {
            return Result<File, Error>.Err(r.unwrap_err());
        }
        return Result<File, Error>.Ok(File.from_fd((i32)r.unwrap()));
    }

    /// Opens `path` for reading; returns a closed `File` on failure.
    File open_read(str path) {
        return File.open(path, "r");
    }

    /// Opens `path` for writing, creating or truncating it; returns a closed
    /// `File` on failure.
    File open_write(str path) {
        return File.open(path, "w");
    }

    /// Opens `path` for appending, creating it if needed; returns a closed
    /// `File` on failure.
    File open_append(str path) {
        return File.open(path, "a");
    }
    /// Returns true when the file holds an open descriptor.
    bool valid(*self) {
        return self.is_open && self.fd >= 0;
    }

    /// Returns true when the file is closed or failed to open.
    bool invalid(*self) {
        return !self.valid();
    }

    /// Flushes, frees the buffers, and closes the fd when owned. Returns 0 or the
    /// close errno. Flush errors are not reported here. Safe to call again.
    i32 close(*self) {
        self.flush();
        if (self.write_buf != (u8*)0) {
            free(self.write_buf);
            self.write_buf = (u8*)0;
            self.write_len = 0;
        }
        if (self.read_buf != (u8*)0) {
            free(self.read_buf);
            self.read_buf = (u8*)0;
            self.read_pos = 0;
            self.read_len = 0;
        }
        if (self.invalid()) {
            self.is_open = false;
            return 0;
        }
        if (!self.owns_fd) {
            self.fd = -1;
            self.is_open = false;
            self.owns_fd = false;
            return 0;
        }
        Result<i64, Error> r = try_close(self.fd);
        if (r.is_ok()) {
            self.fd = -1;
            self.is_open = false;
            self.owns_fd = false;
            return 0;
        }
        return (i32)r.errno();
    }

    /// Flushes user-space write buffer to fd.
    i32 flush(*self) {
        if (self.invalid()) {
            return EOF;
        }
        if (self.write_buf != (u8*)0 && self.write_len > 0) {
            i64 written = 0;
            while (written < self.write_len) {
                Result<i64, Error> r = try_write(self.fd, (u8*)((i64)self.write_buf + written), self.write_len - written);
                if (r.is_err()) {
                    self.had_error = true;
                    return EOF;
                }
                if (r.value() == 0) {
                    self.had_error = true;
                    return EOF;
                }
                written = written + r.value();
            }
            self.write_len = 0;
        }
        return 0;
    }

    /// Returns the next byte (0-255), or `EOF` at end of file or on error. Flushes
    /// pending writes first and refills a 4 KiB read buffer as needed.
    i32 read_char(*self) {
        if (self.invalid() || self.at_eof) {
            return EOF;
        }
        if (self.write_buf != (u8*)0 && self.write_len > 0) {
            if (self.flush() < 0) {
                return EOF;
            }
        }
        if (self.read_pos < self.read_len) {
            u8 ch = self.read_buf[self.read_pos];
            self.read_pos = self.read_pos + 1;
            return (i32)ch;
        }
        if (self.read_buf == (u8*)0) {
            self.read_buf = alloc<u8>(4096);
        }
        self.read_pos = 0;
        self.read_len = 0;
        Result<i64, Error> r = try_read(self.fd, self.read_buf, 4096);
        if (r.is_err()) {
            self.had_error = true;
            return EOF;
        }
        i64 n = r.value();
        if (n <= 0) {
            self.at_eof = true;
            return EOF;
        }
        self.read_len = n;
        self.read_pos = 1;
        return (i32)self.read_buf[0];
    }

    /// Buffers one byte for writing; flushes when the 4 KiB buffer is full.
    /// Returns 0, or `EOF` when invalid or a flush fails.
    i32 write_char(*self, i32 ch) {
        if (self.invalid()) {
            return EOF;
        }
        if (self.write_buf == (u8*)0) {
            self.write_buf = alloc<u8>(4096);
            self.write_len = 0;
        }
        if (self.write_len >= 4096) {
            if (self.flush() < 0) {
                return EOF;
            }
        }
        self.write_buf[self.write_len] = (u8)ch;
        self.write_len = self.write_len + 1;
        return ch;
    }

    /// Buffered string write: small writes accumulate in the 4096-byte
    /// buffer (flushed by flush/close/read/seek, as with write_char);
    /// only writes that cannot fit go straight to the fd.
    i32 write_str(*self, str text) {
        if (self.invalid()) {
            return EOF;
        }
        if (text == (str)0) {
            self.had_error = true;
            return EOF;
        }
        u8* p = (u8*)text;
        i64 len = cstr_len(p);
        if (self.write_buf == (u8*)0) {
            self.write_buf = alloc<u8>(4096);
            self.write_len = 0;
        }
        // Oversized write: drain pending bytes, then write through directly.
        if (len >= 4096) {
            if (self.write_len > 0 && self.flush() < 0) {
                return EOF;
            }
            i64 written = 0;
            while (written < len) {
                Result<i64, Error> r = try_write(self.fd, (u8*)((i64)p + written), len - written);
                if (r.is_err()) {
                    self.had_error = true;
                    return EOF;
                }
                if (r.value() == 0) {
                    self.had_error = true;
                    return EOF;
                }
                written = written  + r.value();
            }
            return 0;
        }
        if (self.write_len + len > 4096) {
            if (self.flush() < 0) {
                return EOF;
            }
        }
        memcpy((void*)&self.write_buf[self.write_len], (const void*)p, len);
        self.write_len = self.write_len + len;
        return 0;
    }

    /// Buffers `text` plus a newline. Returns 0, or `EOF` on failure.
    i32 write_line(*self, str text) {
        if (self.invalid()) {
            return EOF;
        }
        i32 result = self.write_str(text);
        if (result < 0) {
            return result;
        }
        return self.write_char(10);
    }

    /// fread-shaped API: reads up to elem_size*elem_count bytes, returns
    /// whole elements read (0 at EOF or on error, like a short fread).
    i64 read(*self, void* buffer, i64 elem_size, i64 elem_count) {
        if (self.invalid()) {
            return 0;
        }
        if (self.write_buf != (u8*)0 && self.write_len > 0) {
            if (self.flush() < 0) {
                return 0;
            }
        }
        if (elem_size <= 0 || elem_count <= 0) {
            return 0;
        }
        i64 total = elem_size * elem_count;
        i64 done = 0;
        if (self.read_pos < self.read_len) {
            i64 avail = self.read_len - self.read_pos;
            i64 to_copy = avail;
            if (to_copy > total) {
                to_copy = total;
            }
            memcpy(buffer, (const void*)&self.read_buf[self.read_pos], to_copy);
            self.read_pos = self.read_pos + to_copy;
            done = to_copy;
        }
        while (done < total) {
            Result<i64, Error> r = try_read(self.fd, (u8*)((i64)buffer + done), total - done);
            if (r.is_err()) {
                self.had_error = true;
                break;
            }
            if (r.value() == 0) {
                self.at_eof = true;
                break;
            }
            done = done  + r.value();
        }
        return done / elem_size;
    }

    /// fwrite-shaped API: writes elem_size*elem_count bytes, returns whole
    /// elements written (short count on error, like fwrite).
    i64 write(*self, const void* buffer, i64 elem_size, i64 elem_count) {
        if (self.invalid()) {
            return 0;
        }
        if (self.write_buf != (u8*)0 && self.write_len > 0) {
            if (self.flush() < 0) {
                return 0;
            }
        }
        if (elem_size <= 0 || elem_count <= 0) {
            return 0;
        }
        i64 total = elem_size * elem_count;
        i64 done = 0;
        while (done < total) {
            Result<i64, Error> r = try_write(self.fd, (u8*)((i64)buffer + done), total - done);
            if (r.is_err()) {
                self.had_error = true;
                break;
            }
            if (r.value() == 0) {
                self.had_error = true;
                break;
            }
            done = done  + r.value();
        }
        return done / elem_size;
    }

    /// Seeks to absolute byte `offset`; see `seek_from`.
    bool seek(*self, i64 offset) {
        return self.seek_from(offset, IO_SEEK.SET);
    }

    /// Seeks to the start of the file; see `seek_from`.
    bool seek_to_start(*self) {
        return self.seek_from(0, IO_SEEK.SET);
    }

    /// Seeks to the end of the file; see `seek_from`.
    bool seek_to_end(*self) {
        return self.seek_from(0, IO_SEEK.END);
    }

    /// Flushes pending writes, discards buffered reads, and moves the file
    /// position. Returns false on failure. Does not clear the EOF flag; use
    /// `rewind` or `clear_error` for that.
    bool seek_from(*self, i64 offset, IO_SEEK origin) {
        if (self.invalid()) {
            return false;
        }
        if (self.write_buf != (u8*)0 && self.write_len > 0) {
            if (self.flush() < 0) {
                return false;
            }
        }
        self.read_pos = 0;
        self.read_len = 0;
        Result<i64, Error> r = try_lseek(self.fd, offset, (i64)((i32)origin));
        if (r.is_err()) {
            self.had_error = true;
            return false;
        }
        return true;
    }

    /// Flushes pending writes and returns the kernel file offset, or -1. Bytes
    /// already read ahead into the read buffer are not subtracted, so after
    /// `read_char`/`read_line` this is ahead of the logical position.
    i64 tell(*self) {
        if (self.invalid()) {
            return -1;
        }
        if (self.write_buf != (u8*)0 && self.write_len > 0) {
            if (self.flush() < 0) {
                return -1;
            }
        }
        Result<i64, Error> r = try_lseek(self.fd, 0, SEEK_CUR);
        if (r.is_err()) {
            self.had_error = true;
            return -1;
        }
        return r.value();
    }

    /// Seeks to the start and clears the EOF and error flags.
    void rewind(*self) {
        if (self.valid()) {
            self.read_pos = 0;
            self.read_len = 0;
            self.seek_from(0, IO_SEEK.SET);
            self.at_eof = false;
            self.had_error = false;
        }
    }

    /// Returns true at end of file, or when the file is invalid.
    bool eof(&self) {
        if (self.invalid()) {
            return true;
        }
        return self.at_eof;
    }

    /// Returns true after a failed operation, or when the file is invalid.
    bool error(&self) {
        if (self.invalid()) {
            return true;
        }
        return self.had_error;
    }

    /// Clears the EOF and error flags.
    void clear_error(*self) {
        if (self.valid()) {
            self.at_eof = false;
            self.had_error = false;
        }
    }

    /// Returns the file size in bytes, or -1. Seeks to the end and back to
    /// `tell()`, which discards any read-ahead buffer (see `tell`).
    i64 size(*self) {
        if (self.invalid()) {
            return -1;
        }
        i64 pos = self.tell();
        if (pos < 0) {
            return -1;
        }
        Result<i64, Error> end = try_lseek(self.fd, 0, SEEK_END);
        if (end.is_err()) {
            self.had_error = true;
            return -1;
        }
        self.seek_from(pos, IO_SEEK.SET);
        return end.value();
    }
}

impl Drop for File {
    void drop(*self) {
        self.close();
    }
}


/// True when `needle` (a byte value) occurs in the null-terminated string `p`.
bool cstr_contains(u8* p, u8 needle) {
    i64 i = 0;
    while (p[i] != (u8)0) {
        if (p[i] == needle) {
            return true;
        }
        i += 1;
    }
    return false;
}

// Convenience constructors for the standard descriptors.
/// Returns a non-owning `File` for fd 0; dropping it leaves stdin open.
File stdin_file() {
    return File.borrow_fd(STDIN_FD);
}

/// Returns a non-owning `File` for fd 1. Its writes bypass `STDOUT`'s buffer.
File stdout_file() {
    return File.borrow_fd(STDOUT_FD);
}

/// Returns a non-owning `File` for fd 2.
File stderr_file() {
    return File.borrow_fd(STDERR_FD);
}

// High-level helpers. These write straight through the write(2) syscall
// (std.fmt), bypassing libc stdio buffering entirely.
/// Writes `text` and a newline straight to fd 1. Bypasses `STDOUT`'s
/// buffer, so it can appear before earlier buffered output that has no
/// newline yet. Returns the bytes written, or `EOF` for null or failure.
i32 println(str text) {
    if (text == (str)0) {
        return EOF;
    }
    u8* p = (u8*)text;
    i64 len = cstr_len(p);
    if (write_stdout(p, len) < 0) {
        return EOF;
    }
    if (write_stdout((u8*)"\n", 1) < 0) {
        return EOF;
    }
    return (i32)(len + 1);
}

/// Writes `text` and a newline straight to fd 2. Returns the bytes written,
/// or `EOF` for null or failure.
i32 eprintln(str text) {
    if (text == (str)0) {
        return EOF;
    }
    u8* p = (u8*)text;
    i64 len = cstr_len(p);
    if (write_stderr(p, len) < 0) {
        return EOF;
    }
    if (write_stderr((u8*)"\n", 1) < 0) {
        return EOF;
    }
    return (i32)(len + 1);
}

/// Returns true when `path` can be opened for reading. An existing file the
/// caller cannot read reports false.
bool file_exists(str path) {
    File file = File.open_read(path);
    if (file.invalid()) {
        return false;
    }
    file.close();
    return true;
}

/// Deletes the file at `path` (unlink). Returns false on any error.
bool file_delete(str path) {
    return sys_unlink((i64)path) == 0;
}

/// Renames `from` to `to`, replacing an existing `to`. Returns false on any
/// error, including a cross-filesystem move.
bool file_rename(str from, str to) {
    return sys_rename((i64)from, (i64)to) == 0;
}

/// File metadata for change detection (did a document change on disk?) and
/// cache invalidation.
struct FileStat {
    i64 size;       // bytes
    i64 mtime_sec;  // modification time, seconds since the epoch
    i64 mtime_nsec; // nanosecond part of the modification time
    i32 mode;       // file mode and type bits
}

impl FileStat {
    /// Returns true for a directory.
    bool is_dir(&self) {
        return (self.mode & 61440) == 16384; // S_IFDIR = 0x4000 = 16384
    }

    /// Returns true for a regular file.
    bool is_file(&self) {
        return (self.mode & 61440) == 32768; // S_IFREG = 0x8000 = 32768
    }

    /// Returns true for a symbolic link. Only `lstat_path` results can report
    /// one; `stat_path` follows links.
    bool is_symlink(&self) {
        return (self.mode & 61440) == 40960; // S_IFLNK = 0xA000 = 40960
    }
}

/// Little-endian i64 from a raw buffer (x86-64 stat fields are LE).
i64 read_le_i64(u8* buf, i64 off) {
    i64 v = 0;
    i64 i = 7;
    while (i >= 0) {
        v = (v << 8) | (i64)buf[off + i];
        i = i - 1;
    }
    return v;
}

private void file_stat_from_buf(u8* buf, FileStat* st) {
    st.size = read_le_i64(buf, 48);
    st.mtime_sec = read_le_i64(buf, 88);
    st.mtime_nsec = read_le_i64(buf, 96);
    st.mode = (i32)read_le_i64(buf, 24);
}

/// stat(2) for a path; Err carries the errno when it fails. The platform
/// seam writes the x86-64 `struct stat` layout into a raw buffer.
Result<FileStat, Error> stat_path(str path) {
    u8 buf[144];
    i64 i = 0;
    while (i < 144) {
        buf[i] = (u8)0;
        i += 1;
    }
    i64 rc = sys_stat((i64)path, (i64)buf);
    if (rc != 0) {
        Error e = Error.new(-rc, "stat failed");
        return Result<FileStat, Error>.Err(move e);
    }
    FileStat st;
    file_stat_from_buf(&buf[0], &st);
    return Result<FileStat, Error>.Ok(move st);
}

/// lstat(2) for Linux paths. Other targets report that no-follow metadata is unavailable.
Result<FileStat, Error> lstat_path(str path) {
    if (@cfg(os.linux)) {
        u8 buf[144];
        i64 i = 0;
        while (i < 144) {
            buf[i] = 0;
            i += 1;
        }
        i64 rc = sys_lstat((i64)path, (i64)&buf[0]);
        if (rc != 0) {
            Error e = Error.new(-rc, "lstat failed");
            return Result<FileStat, Error>.Err(move e);
        }
        FileStat st;
        file_stat_from_buf(&buf[0], &st);
        return Result<FileStat, Error>.Ok(move st);
    }
    Error e = Error.new(95, "no-follow metadata unavailable");
    return Result<FileStat, Error>.Err(move e);
}

