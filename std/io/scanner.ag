// std/io/scanner.ag — stdin token scanner with UTF-8 BOM support.
// Reads all of stdin into a heap buffer, then provides whitespace-delimited
// token and line iteration with zero-copy str borrows.
import std.error;
import std.io.file;
import std.mem;
import std.mem.alloc;
import std.mem.drop;
import std.string;
import std.sys.result;

struct Scanner {
    u8* buf;
    i64 len;
    i64 cap;
    i64 pos;
    bool ok;
    bool has_saved;
    i64 saved_end;
    u8 saved_byte;
}

impl Scanner {
    /// Read all of fd 0 into an internal heap buffer.
    /// Skips a UTF-8 BOM (0xEF 0xBB 0xBF) if present.
    /// On read error, ok = false but already-read bytes are kept.
    Scanner stdin() {
        Scanner s;
        s.cap = 4096;
        s.buf = alloc<u8>(s.cap);
        s.len = 0;
        s.pos = 0;
        s.ok = true;
        s.has_saved = false;
        s.saved_end = 0;
        s.saved_byte = (u8)0;

        while (true) {
            i64 space = s.cap - s.len;
            // Need at least 2 bytes: 1 for reading, 1 for NUL.
            if (space < 2) {
                i64 new_cap = s.cap * 2;
                s.buf = realloc<u8>(s.buf, new_cap);
                s.cap = new_cap;
                space = s.cap - s.len;
            }
            Result<i64, Error> r = try_read(STDIN_FD, &s.buf[s.len], space - 1);
            if (r.is_ok()) {
                i64 n = r.value();
                if (n == 0) {
                    break;  // EOF
                }
                s.len = s.len + n;
            } else {
                s.ok = false;
                break;
            }
        }
        // NUL-terminate.
        s.buf[s.len] = (u8)0;

        // Skip UTF-8 BOM.
        if (s.len >= 3 && s.buf[0] == (u8)0xEF && s.buf[1] == (u8)0xBB && s.buf[2] == (u8)0xBF) {
            s.pos = 3;
        }
        return s;
    }

    /// Return true if more non-whitespace tokens are available.
    /// Restores any saved delimiter and skips whitespace.
    bool has_next(&mut self) {
        if (self.has_saved) {
            self.buf[self.saved_end] = self.saved_byte;
            self.has_saved = false;
        }
        while (self.pos + 16 <= self.len) {
            i64 non_ws = asm("
                movdqu (%rax), %xmm0
                movl $$0x20202020, %edx
                movd %edx, %xmm1
                pshufd $$0, %xmm1, %xmm1
                pcmpeqb %xmm0, %xmm1

                movl $$0x09090909, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                movl $$0x0a0a0a0a, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                movl $$0x0d0d0d0d, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                pmovmskb %xmm1, %ecx
                cmpl $$65535, %ecx
                je 1f
                notl %ecx
                bsfl %ecx, %eax
                jmp 2f
                1:
                movq $$-1, %rax
                2:
            ", [&self.buf[self.pos]], ["rdx", "rcx", "xmm0", "xmm1", "xmm2"]);
            if (non_ws >= 0) {
                self.pos = self.pos + non_ws;
                return true;
            }
            self.pos = self.pos + 16;
        }
        while (self.pos < self.len) {
            u8 ch = self.buf[self.pos];
            if (ch == (u8)0x20 || ch == (u8)0x09 || ch == (u8)0x0A || ch == (u8)0x0D || ch == (u8)0x0B || ch == (u8)0x0C) {
                self.pos = self.pos + 1;
            } else {
                break;
            }
        }
        return self.pos < self.len;
    }

    /// Return the next whitespace-delimited token as a borrowed NUL-terminated str.
    /// The returned pointer is valid until the next mutating scanner call.
    /// Sets ok = false and returns (str)0 when no token remains.
    str next(&mut self) {
        if (!self.has_next()) {
            self.ok = false;
            return (str)0;
        }
        i64 start = self.pos;
        while (self.pos + 16 <= self.len) {
            i64 ws = asm("
                movdqu (%rax), %xmm0
                movl $$0x20202020, %edx
                movd %edx, %xmm1
                pshufd $$0, %xmm1, %xmm1
                pcmpeqb %xmm0, %xmm1

                movl $$0x09090909, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                movl $$0x0a0a0a0a, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                movl $$0x0d0d0d0d, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                pmovmskb %xmm1, %eax
                bsfl %eax, %eax
                jnz 1f
                movq $$-1, %rax
                1:
            ", [&self.buf[self.pos]], ["rdx", "rcx", "xmm0", "xmm1", "xmm2"]);
            if (ws >= 0) {
                self.pos = self.pos + ws;
                break;
            }
            self.pos = self.pos + 16;
        }
        while (self.pos < self.len) {
            u8 ch = self.buf[self.pos];
            if (ch == (u8)0x20 || ch == (u8)0x09 || ch == (u8)0x0A || ch == (u8)0x0D || ch == (u8)0x0B || ch == (u8)0x0C) {
                break;
            }
            self.pos = self.pos + 1;
        }
        if (self.pos < self.len) {
            self.saved_end = self.pos;
            self.saved_byte = self.buf[self.pos];
            self.buf[self.pos] = (u8)0;
            self.has_saved = true;
        } else {
            self.has_saved = false;
        }
        return (str)&self.buf[start];
    }

    /// Return the next token as an owned String.
    /// Sets ok = false on failure.
    String next_string(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return String.new();
        }
        return String.from_str(tok);
    }

    /// Parse the next token as a signed integer, saturating to [lo, hi] on
    /// overflow (ok = false). Non-numeric tokens set ok = false and return 0.
    i64 _parse_signed(&mut self, i64 lo, i64 hi) {
        str tok = self.next();
        if (!self.ok) {
            return 0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        bool neg = false;
        if (p[i] == (u8)'-') {
            neg = true;
            i = i + 1;
        } else {
            if (p[i] == (u8)'+') {
                i = i + 1;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return 0;
        }
        i64 val = 0;
        // Thresholds: at every digit step val*10 +/- digit must stay within
        // [lo, hi]. Truncating division and sign-preserving remainder work
        // for negative bounds (e.g. i64::MIN: lo_div = -922337203685477580,
        // lo_rem = -8, so digit > 8 overflows when val == lo_div).
        i64 lo_div = lo / 10;
        i64 hi_div = hi / 10;
        i64 lo_rem = lo % 10;
        i64 hi_rem = hi % 10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            i64 digit = (i64)(p[i] - (u8)'0');
            if (!overflow) {
                if (neg) {
                    if (val < lo_div || (val == lo_div && digit > (0 - lo_rem))) {
                        overflow = true;
                    } else {
                        val = val * 10 - digit;
                    }
                } else {
                    if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                        overflow = true;
                    } else {
                        val = val * 10 + digit;
                    }
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return 0;
        }
        if (overflow) {
            self.ok = false;
            if (neg) {
                return lo;
            }
            return hi;
        }
        return val;
    }

    /// Parse the next token as an unsigned integer, saturating to [0, hi] on
    /// overflow (ok = false). A leading '-' sets ok = false and returns 0.
    u64 _parse_unsigned(&mut self, u64 hi) {
        str tok = self.next();
        if (!self.ok) {
            return (u64)0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        if (p[i] == (u8)'+') {
            i = i + 1;
        } else {
            if (p[i] == (u8)'-') {
                self.ok = false;
                return (u64)0;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return (u64)0;
        }
        u64 val = (u64)0;
        u64 hi_div = hi / (u64)10;
        u64 hi_rem = hi % (u64)10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            u64 digit = (u64)(p[i] - (u8)'0');
            if (!overflow) {
                if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                    overflow = true;
                } else {
                    val = val * (u64)10 + digit;
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return (u64)0;
        }
        if (overflow) {
            self.ok = false;
            return hi;
        }
        return val;
    }

    /// Parse the next token as a signed i8.
    /// Overflow saturates to i8::MIN or i8::MAX and sets ok = false.
    i8 next_i8(&mut self) {
        return (i8)self._parse_signed(-128, 127);
    }

    /// Parse the next token as a signed i16.
    /// Overflow saturates to i16::MIN or i16::MAX and sets ok = false.
    i16 next_i16(&mut self) {
        return (i16)self._parse_signed(-32768, 32767);
    }

    /// Parse the next token as a signed i32.
    /// Overflow saturates to i32::MIN or i32::MAX and sets ok = false.
    i32 next_i32(&mut self) {
        return (i32)self._parse_signed(-2147483647 - 1, 2147483647);
    }

    /// Parse the next token as a signed i64.
    /// Overflow saturates to i64::MIN or i64::MAX and sets ok = false.
    i64 next_i64(&mut self) {
        return self._parse_signed(-9223372036854775807 - 1, 9223372036854775807);
    }

    /// Parse the next token as a signed i128.
    /// Overflow saturates to i128::MIN or i128::MAX and sets ok = false.
    i128 next_i128(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return (i128)0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        bool neg = false;
        if (p[i] == (u8)'-') {
            neg = true;
            i = i + 1;
        } else {
            if (p[i] == (u8)'+') {
                i = i + 1;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return (i128)0;
        }
        i128 val = (i128)0;
        i128 lo = (i128)(-170141183460469231731687303715884105727) - (i128)1;  // i128::MIN
        i128 hi = (i128)170141183460469231731687303715884105727;              // i128::MAX
        i128 lo_div = lo / (i128)10;
        i128 hi_div = hi / (i128)10;
        i128 lo_rem = lo % (i128)10;
        i128 hi_rem = hi % (i128)10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            i128 digit = (i128)(p[i] - (u8)'0');
            if (!overflow) {
                if (neg) {
                    if (val < lo_div || (val == lo_div && digit > ((i128)0 - lo_rem))) {
                        overflow = true;
                    } else {
                        val = val * (i128)10 - digit;
                    }
                } else {
                    if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                        overflow = true;
                    } else {
                        val = val * (i128)10 + digit;
                    }
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return (i128)0;
        }
        if (overflow) {
            self.ok = false;
            if (neg) {
                return lo;
            }
            return hi;
        }
        return val;
    }

    /// Parse the next token as an unsigned u8.
    /// Overflow sets ok = false and returns u8::MAX.
    u8 next_u8(&mut self) {
        return (u8)self._parse_unsigned(255);
    }

    /// Parse the next token as an unsigned u16.
    /// Overflow sets ok = false and returns u16::MAX.
    u16 next_u16(&mut self) {
        return (u16)self._parse_unsigned(65535);
    }

    /// Parse the next token as an unsigned u32.
    /// Overflow sets ok = false and returns u32::MAX.
    u32 next_u32(&mut self) {
        return (u32)self._parse_unsigned(4294967295);
    }

    /// Parse the next token as an unsigned u64.
    /// Overflow sets ok = false and returns u64::MAX.
    u64 next_u64(&mut self) {
        return self._parse_unsigned(18446744073709551615);
    }

    /// Parse the next token as an unsigned u128.
    /// Overflow sets ok = false and returns u128::MAX.
    u128 next_u128(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return (u128)0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        if (p[i] == (u8)'+') {
            i = i + 1;
        } else {
            if (p[i] == (u8)'-') {
                self.ok = false;
                return (u128)0;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return (u128)0;
        }
        u128 val = (u128)0;
        u128 hi = (u128)-1;  // u128::MAX
        u128 hi_div = hi / (u128)10;
        u128 hi_rem = hi % (u128)10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            u128 digit = (u128)(p[i] - (u8)'0');
            if (!overflow) {
                if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                    overflow = true;
                } else {
                    val = val * (u128)10 + digit;
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return (u128)0;
        }
        if (overflow) {
            self.ok = false;
            return hi;
        }
        return val;
    }

    /// Parse the next token as a 64-bit float.
    /// Supports optional sign, fraction and exponent. Values that overflow
    /// become infinity (IEEE semantics); malformed tokens set ok = false.
    f64 next_f64(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return 0.0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        bool neg = false;
        if (p[i] == (u8)'-') {
            neg = true;
            i = i + 1;
        } else {
            if (p[i] == (u8)'+') {
                i = i + 1;
            }
        }
        f64 val = 0.0;
        bool any = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            val = val * 10.0 + (f64)(p[i] - (u8)'0');
            i = i + 1;
            any = true;
        }
        if (p[i] == (u8)'.') {
            i = i + 1;
            f64 scale = 1.0;
            while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
                scale = scale * 10.0;
                val = val + (f64)(p[i] - (u8)'0') / scale;
                i = i + 1;
                any = true;
            }
        }
        if (p[i] == (u8)'e' || p[i] == (u8)'E') {
            i = i + 1;
            bool eneg = false;
            if (p[i] == (u8)'-') {
                eneg = true;
                i = i + 1;
            } else {
                if (p[i] == (u8)'+') {
                    i = i + 1;
                }
            }
            i64 exp = 0;
            bool eany = false;
            while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
                exp = exp * 10 + (i64)(p[i] - (u8)'0');
                i = i + 1;
                eany = true;
            }
            if (!eany) {
                self.ok = false;
                return 0.0;
            }
            // Clamp absurd exponents to bound the scaling loop; beyond ~309
            // multiplications the value is already +/-inf or 0.
            i64 n = exp;
            if (n > 400) {
                n = 400;
            }
            f64 e = 1.0;
            i64 j = 0;
            while (j < n) {
                e = e * 10.0;
                j = j + 1;
            }
            if (eneg) {
                val = val / e;
            } else {
                val = val * e;
            }
        }
        if (!any || p[i] != (u8)0) {
            self.ok = false;
            return 0.0;
        }
        if (neg) {
            val = 0.0 - val;
        }
        return val;
    }

    /// Parse the next token as a 32-bit float.
    /// Same syntax as next_f64; the result is narrowed to f32.
    f32 next_f32(&mut self) {
        f64 v = self.next_f64();
        if (!self.ok) {
            return (f32)0;
        }
        return (f32)v;
    }

    /// Parse the next token as a boolean ("true" / "false").
    /// Any other token sets ok = false and returns false.
    bool next_bool(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return false;
        }
        u8* q = (u8*)tok;
        if (q[0] == (u8)'t' && q[1] == (u8)'r' && q[2] == (u8)'u' && q[3] == (u8)'e' && q[4] == (u8)0) {
            return true;
        }
        if (q[0] == (u8)'f' && q[1] == (u8)'a' && q[2] == (u8)'l' && q[3] == (u8)'s' && q[4] == (u8)'e' && q[5] == (u8)0) {
            return false;
        }
        self.ok = false;
        return false;
    }

    /// Return the next line (bytes up to but not including LF or CRLF).
    /// The returned str is a borrowed NUL-terminated view into the buffer.
    /// Sets ok = false at EOF.
    str next_line(&mut self) {
        // Restore previous saved delimiter.
        if (self.has_saved) {
            self.buf[self.saved_end] = self.saved_byte;
            self.has_saved = false;
        }
        if (self.pos >= self.len) {
            self.ok = false;
            return (str)0;
        }
        // If the previous token ended exactly at a line break, consume that
        // break and return the following line rather than an empty view.
        if (self.buf[self.pos] == (u8)0x0D) {
            self.pos = self.pos + 1;
            if (self.pos < self.len && self.buf[self.pos] == (u8)0x0A) {
                self.pos = self.pos + 1;
            }
        } else {
            if (self.buf[self.pos] == (u8)0x0A) {
                self.pos = self.pos + 1;
            }
        }
        if (self.pos >= self.len) {
            self.ok = false;
            return (str)0;
        }
        i64 start = self.pos;
        // Scan forward until LF or end.
        while (self.pos < self.len && self.buf[self.pos] != (u8)0x0A) {
            self.pos = self.pos + 1;
        }
        // If the delimiter is preceded by CR, treat CRLF as a single terminator.
        if (self.pos > start && self.buf[self.pos - 1] == (u8)0x0D) {
            self.pos = self.pos - 1;
        }
        if (self.pos < self.len) {
            self.saved_end = self.pos;
            self.saved_byte = self.buf[self.pos];
            self.buf[self.pos] = (u8)0;
            self.has_saved = true;
        } else {
            self.has_saved = false;
        }
        return (str)&self.buf[start];
    }

    /// Return true if no errors have been encountered.
    bool good(&self) {
        return self.ok;
    }
}

impl Drop for Scanner {
    /// Free the internal buffer.
    void drop(*self) {
        if (self.buf != (u8*)0) {
            free(self.buf);
            self.buf = (u8*)0;
        }
    }
}
