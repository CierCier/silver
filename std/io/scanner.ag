// std/io/scanner.ag — stdin token scanner with UTF-8 BOM support.
// Reads all of stdin into a heap buffer, then provides whitespace-delimited
// token and line iteration with zero-copy str borrows.
import std.error;
import std.io.file;
import std.mem;
import std.mem.alloc;
import std.mem.drop;
import std.string;
import std.sys.result;

struct Scanner {
    u8* buf;
    i64 len;
    i64 cap;
    i64 pos;
    bool ok;
    i32 fd;
    bool eof;
    u8* token_buf;
    i64 token_cap;
}

impl Scanner {
    /// Read all of fd 0 into an internal heap buffer.
    /// Skips a UTF-8 BOM (0xEF 0xBB 0xBF) if present.
    /// On read error, ok = false but already-read bytes are kept.
    /// Initialize Scanner reading from fd 0 with a streaming buffer window.
    /// Skips a UTF-8 BOM (0xEF 0xBB 0xBF) if present.
    Scanner stdin() {
        Scanner s;
        s.cap = 65536;
        s.buf = alloc<u8>(s.cap);
        s.len = 0;
        s.pos = 0;
        s.ok = true;
        s.fd = STDIN_FD;
        s.eof = false;
        s.token_buf = (u8*)0;
        s.token_cap = 0;
        s.refill();
        if (s.len >= 3 && s.buf[0] == (u8)0xEF && s.buf[1] == (u8)0xBB && s.buf[2] == (u8)0xBF) {
            s.pos = 3;
        }
        return s;
    }

    /// Create an in-memory Scanner reading from a C string.
    Scanner from_str(str text) {
        Scanner s;
        i64 slen = strlen(text);
        s.cap = slen + 1;
        s.buf = alloc<u8>(s.cap);
        if (slen > 0) {
            memcpy((void*)s.buf, (const void*)text, slen);
        }
        s.buf[slen] = (u8)0;
        s.len = slen;
        s.pos = 0;
        s.ok = true;
        s.fd = -1;
        s.eof = true;
        s.token_buf = (u8*)0;
        s.token_cap = 0;
        if (s.len >= 3 && s.buf[0] == (u8)0xEF && s.buf[1] == (u8)0xBB && s.buf[2] == (u8)0xBF) {
            s.pos = 3;
        }
        return s;
    }

    /// Refill the buffer from the underlying file descriptor, sliding unread
    /// bytes to the front of the window.
    void refill(&mut self) {
        if (self.fd < 0 || self.eof) {
            return;
        }
        if (self.pos > 0) {
            i64 remaining = self.len - self.pos;
            if (remaining > 0) {
                memmove((void*)self.buf, (const void*)&self.buf[self.pos], remaining);
            }
            self.len = remaining;
            self.pos = 0;
        }
        i64 space = self.cap - self.len;
        if (space < 1024) {
            i64 new_cap = self.cap * 2;
            self.buf = realloc<u8>(self.buf, new_cap);
            self.cap = new_cap;
            space = self.cap - self.len;
        }
        Result<i64, Error> r = try_read(self.fd, &self.buf[self.len], space);
        if (r.is_ok()) {
            i64 n = r.value();
            if (n == 0) {
                self.eof = true;
            } else {
                self.len = self.len + n;
            }
        } else {
            self.eof = true;
        }
    }

    /// Return true if more non-whitespace tokens are available.
    bool has_next(&mut self) {
        while (true) {
            while (self.pos < self.len) {
                u8 ch = self.buf[self.pos];
                if (ch == (u8)0x20 || ch == (u8)0x09 || ch == (u8)0x0A || ch == (u8)0x0D || ch == (u8)0x0B || ch == (u8)0x0C) {
                    self.pos = self.pos + 1;
                } else {
                    return true;
                }
            }
            if (self.fd < 0 || self.eof) {
                return false;
            }
            self.refill();
            if (self.pos >= self.len && self.eof) {
                return false;
            }
        }
        return false;
    }

    /// Return the next whitespace-delimited token as an immutable zero-copy Slice<u8>.
    Slice<u8> next_slice(&mut self) {
        if (!self.has_next()) {
            self.ok = false;
            Slice<u8> empty;
            empty.data = (u8*)0;
            empty.len = 0;
            return empty;
        }
        i64 start = self.pos;
        while (true) {
            while (self.pos < self.len) {
                u8 ch = self.buf[self.pos];
                if (ch == (u8)0x20 || ch == (u8)0x09 || ch == (u8)0x0A || ch == (u8)0x0D || ch == (u8)0x0B || ch == (u8)0x0C) {
                    Slice<u8> s;
                    s.data = &self.buf[start];
                    s.len = self.pos - start;
                    return s;
                }
                self.pos = self.pos + 1;
            }
            if (self.fd < 0 || self.eof) {
                Slice<u8> s;
                s.data = &self.buf[start];
                s.len = self.pos - start;
                return s;
            }
            i64 token_len = self.pos - start;
            if (start > 0) {
                memmove((void*)self.buf, (const void*)&self.buf[start], token_len);
                self.len = token_len;
                self.pos = token_len;
                start = 0;
            }
            i64 space = self.cap - self.len;
            if (space < 1024) {
                i64 new_cap = self.cap * 2;
                self.buf = realloc<u8>(self.buf, new_cap);
                self.cap = new_cap;
                space = self.cap - self.len;
            }
            Result<i64, Error> r = try_read(self.fd, &self.buf[self.len], space);
            if (r.is_ok()) {
                i64 n = r.value();
                if (n == 0) {
                    self.eof = true;
                    Slice<u8> s;
                    s.data = &self.buf[start];
                    s.len = self.pos - start;
                    return s;
                }
                self.len = self.len + n;
            } else {
                self.eof = true;
                Slice<u8> s;
                s.data = &self.buf[start];
                s.len = self.pos - start;
                return s;
            }
        }
        Slice<u8> empty;
        empty.data = (u8*)0;
        empty.len = 0;
        return empty;
    }

    /// Return the next whitespace-delimited token as a borrowed NUL-terminated str.
    /// The returned pointer is valid until the next scanner call.
    /// Does NOT mutate the source buffer in place.
    str next(&mut self) {
        Slice<u8> tok = self.next_slice();
        if (!self.ok || tok.data == (u8*)0) {
            return (str)0;
        }
        if (self.token_buf == (u8*)0 || self.token_cap <= tok.len) {
            if (self.token_buf != (u8*)0) {
                free(self.token_buf);
            }
            self.token_cap = tok.len + 64;
            self.token_buf = alloc<u8>(self.token_cap);
        }
        if (tok.len > 0) {
            memcpy((void*)self.token_buf, (const void*)tok.data, tok.len);
        }
        self.token_buf[tok.len] = (u8)0;
        return (str)self.token_buf;
    }

    /// Return the next token as an owned String.
    String next_string(&mut self) {
        Slice<u8> tok = self.next_slice();
        if (!self.ok || tok.data == (u8*)0) {
            return String.new();
        }
        return tok.to_string();
    }

    /// Parse the next token as a signed integer, saturating to [lo, hi] on
    /// overflow (ok = false). Non-numeric tokens set ok = false and return 0.
    i64 _parse_signed(&mut self, i64 lo, i64 hi) {
        str tok = self.next();
        if (!self.ok) {
            return 0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        bool neg = false;
        if (p[i] == (u8)'-') {
            neg = true;
            i = i + 1;
        } else {
            if (p[i] == (u8)'+') {
                i = i + 1;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return 0;
        }
        i64 val = 0;
        // Thresholds: at every digit step val*10 +/- digit must stay within
        // [lo, hi]. Truncating division and sign-preserving remainder work
        // for negative bounds (e.g. i64::MIN: lo_div = -922337203685477580,
        // lo_rem = -8, so digit > 8 overflows when val == lo_div).
        i64 lo_div = lo / 10;
        i64 hi_div = hi / 10;
        i64 lo_rem = lo % 10;
        i64 hi_rem = hi % 10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            i64 digit = (i64)(p[i] - (u8)'0');
            if (!overflow) {
                if (neg) {
                    if (val < lo_div || (val == lo_div && digit > (0 - lo_rem))) {
                        overflow = true;
                    } else {
                        val = val * 10 - digit;
                    }
                } else {
                    if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                        overflow = true;
                    } else {
                        val = val * 10 + digit;
                    }
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return 0;
        }
        if (overflow) {
            self.ok = false;
            if (neg) {
                return lo;
            }
            return hi;
        }
        return val;
    }

    /// Parse the next token as an unsigned integer, saturating to [0, hi] on
    /// overflow (ok = false). A leading '-' sets ok = false and returns 0.
    u64 _parse_unsigned(&mut self, u64 hi) {
        str tok = self.next();
        if (!self.ok) {
            return (u64)0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        if (p[i] == (u8)'+') {
            i = i + 1;
        } else {
            if (p[i] == (u8)'-') {
                self.ok = false;
                return (u64)0;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return (u64)0;
        }
        u64 val = (u64)0;
        u64 hi_div = hi / (u64)10;
        u64 hi_rem = hi % (u64)10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            u64 digit = (u64)(p[i] - (u8)'0');
            if (!overflow) {
                if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                    overflow = true;
                } else {
                    val = val * (u64)10 + digit;
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return (u64)0;
        }
        if (overflow) {
            self.ok = false;
            return hi;
        }
        return val;
    }

    /// Parse the next token as a signed i8.
    /// Overflow saturates to i8::MIN or i8::MAX and sets ok = false.
    i8 next_i8(&mut self) {
        return (i8)self._parse_signed(-128, 127);
    }

    /// Parse the next token as a signed i16.
    /// Overflow saturates to i16::MIN or i16::MAX and sets ok = false.
    i16 next_i16(&mut self) {
        return (i16)self._parse_signed(-32768, 32767);
    }

    /// Parse the next token as a signed i32.
    /// Overflow saturates to i32::MIN or i32::MAX and sets ok = false.
    i32 next_i32(&mut self) {
        return (i32)self._parse_signed(-2147483647 - 1, 2147483647);
    }

    /// Parse the next token as a signed i64.
    /// Overflow saturates to i64::MIN or i64::MAX and sets ok = false.
    i64 next_i64(&mut self) {
        return self._parse_signed(-9223372036854775807 - 1, 9223372036854775807);
    }

    /// Parse the next token as a signed i128.
    /// Overflow saturates to i128::MIN or i128::MAX and sets ok = false.
    i128 next_i128(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return (i128)0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        bool neg = false;
        if (p[i] == (u8)'-') {
            neg = true;
            i = i + 1;
        } else {
            if (p[i] == (u8)'+') {
                i = i + 1;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return (i128)0;
        }
        i128 val = (i128)0;
        i128 lo = (i128)(-170141183460469231731687303715884105727) - (i128)1;  // i128::MIN
        i128 hi = (i128)170141183460469231731687303715884105727;              // i128::MAX
        i128 lo_div = lo / (i128)10;
        i128 hi_div = hi / (i128)10;
        i128 lo_rem = lo % (i128)10;
        i128 hi_rem = hi % (i128)10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            i128 digit = (i128)(p[i] - (u8)'0');
            if (!overflow) {
                if (neg) {
                    if (val < lo_div || (val == lo_div && digit > ((i128)0 - lo_rem))) {
                        overflow = true;
                    } else {
                        val = val * (i128)10 - digit;
                    }
                } else {
                    if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                        overflow = true;
                    } else {
                        val = val * (i128)10 + digit;
                    }
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return (i128)0;
        }
        if (overflow) {
            self.ok = false;
            if (neg) {
                return lo;
            }
            return hi;
        }
        return val;
    }

    /// Parse the next token as an unsigned u8.
    /// Overflow sets ok = false and returns u8::MAX.
    u8 next_u8(&mut self) {
        return (u8)self._parse_unsigned(255);
    }

    /// Parse the next token as an unsigned u16.
    /// Overflow sets ok = false and returns u16::MAX.
    u16 next_u16(&mut self) {
        return (u16)self._parse_unsigned(65535);
    }

    /// Parse the next token as an unsigned u32.
    /// Overflow sets ok = false and returns u32::MAX.
    u32 next_u32(&mut self) {
        return (u32)self._parse_unsigned(4294967295);
    }

    /// Parse the next token as an unsigned u64.
    /// Overflow sets ok = false and returns u64::MAX.
    u64 next_u64(&mut self) {
        return self._parse_unsigned(18446744073709551615);
    }

    /// Parse the next token as an unsigned u128.
    /// Overflow sets ok = false and returns u128::MAX.
    u128 next_u128(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return (u128)0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        if (p[i] == (u8)'+') {
            i = i + 1;
        } else {
            if (p[i] == (u8)'-') {
                self.ok = false;
                return (u128)0;
            }
        }
        if (p[i] < (u8)'0' || p[i] > (u8)'9') {
            self.ok = false;
            return (u128)0;
        }
        u128 val = (u128)0;
        u128 hi = (u128)-1;  // u128::MAX
        u128 hi_div = hi / (u128)10;
        u128 hi_rem = hi % (u128)10;
        bool overflow = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            u128 digit = (u128)(p[i] - (u8)'0');
            if (!overflow) {
                if (val > hi_div || (val == hi_div && digit > hi_rem)) {
                    overflow = true;
                } else {
                    val = val * (u128)10 + digit;
                }
            }
            i = i + 1;
        }
        if (p[i] != (u8)0) {
            self.ok = false;
            return (u128)0;
        }
        if (overflow) {
            self.ok = false;
            return hi;
        }
        return val;
    }

    /// Parse the next token as a 64-bit float.
    /// Supports optional sign, fraction and exponent. Values that overflow
    /// become infinity (IEEE semantics); malformed tokens set ok = false.
    f64 next_f64(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return 0.0;
        }
        u8* p = (u8*)tok;
        i64 i = 0;
        bool neg = false;
        if (p[i] == (u8)'-') {
            neg = true;
            i = i + 1;
        } else {
            if (p[i] == (u8)'+') {
                i = i + 1;
            }
        }
        f64 val = 0.0;
        bool any = false;
        while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
            val = val * 10.0 + (f64)(p[i] - (u8)'0');
            i = i + 1;
            any = true;
        }
        if (p[i] == (u8)'.') {
            i = i + 1;
            f64 scale = 1.0;
            while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
                scale = scale * 10.0;
                val = val + (f64)(p[i] - (u8)'0') / scale;
                i = i + 1;
                any = true;
            }
        }
        if (p[i] == (u8)'e' || p[i] == (u8)'E') {
            i = i + 1;
            bool eneg = false;
            if (p[i] == (u8)'-') {
                eneg = true;
                i = i + 1;
            } else {
                if (p[i] == (u8)'+') {
                    i = i + 1;
                }
            }
            i64 exp = 0;
            bool eany = false;
            while (p[i] >= (u8)'0' && p[i] <= (u8)'9') {
                exp = exp * 10 + (i64)(p[i] - (u8)'0');
                i = i + 1;
                eany = true;
            }
            if (!eany) {
                self.ok = false;
                return 0.0;
            }
            // Clamp absurd exponents to bound the scaling loop; beyond ~309
            // multiplications the value is already +/-inf or 0.
            i64 n = exp;
            if (n > 400) {
                n = 400;
            }
            f64 e = 1.0;
            i64 j = 0;
            while (j < n) {
                e = e * 10.0;
                j = j + 1;
            }
            if (eneg) {
                val = val / e;
            } else {
                val = val * e;
            }
        }
        if (!any || p[i] != (u8)0) {
            self.ok = false;
            return 0.0;
        }
        if (neg) {
            val = 0.0 - val;
        }
        return val;
    }

    /// Parse the next token as a 32-bit float.
    /// Same syntax as next_f64; the result is narrowed to f32.
    f32 next_f32(&mut self) {
        f64 v = self.next_f64();
        if (!self.ok) {
            return (f32)0;
        }
        return (f32)v;
    }

    /// Parse the next token as a boolean ("true" / "false").
    /// Any other token sets ok = false and returns false.
    bool next_bool(&mut self) {
        str tok = self.next();
        if (!self.ok) {
            return false;
        }
        u8* q = (u8*)tok;
        if (q[0] == (u8)'t' && q[1] == (u8)'r' && q[2] == (u8)'u' && q[3] == (u8)'e' && q[4] == (u8)0) {
            return true;
        }
        if (q[0] == (u8)'f' && q[1] == (u8)'a' && q[2] == (u8)'l' && q[3] == (u8)'s' && q[4] == (u8)'e' && q[5] == (u8)0) {
            return false;
        }
        self.ok = false;
        return false;
    }

    /// Return the next line as an immutable zero-copy Slice<u8>.
    Slice<u8> next_line_slice(&mut self) {
        if (self.pos >= self.len) {
            if (self.fd < 0 || self.eof) {
                self.ok = false;
                Slice<u8> empty;
                empty.data = (u8*)0;
                empty.len = 0;
                return empty;
            }
            self.refill();
            if (self.pos >= self.len && self.eof) {
                self.ok = false;
                Slice<u8> empty;
                empty.data = (u8*)0;
                empty.len = 0;
                return empty;
            }
        }
        if (self.buf[self.pos] == (u8)0x0D) {
            self.pos = self.pos + 1;
            if (self.pos < self.len && self.buf[self.pos] == (u8)0x0A) {
                self.pos = self.pos + 1;
            }
        } else {
            if (self.buf[self.pos] == (u8)0x0A) {
                self.pos = self.pos + 1;
            }
        }
        if (self.pos >= self.len) {
            self.ok = false;
            Slice<u8> empty;
            empty.data = (u8*)0;
            empty.len = 0;
            return empty;
        }
        i64 start = self.pos;
        while (true) {
            while (self.pos < self.len) {
                if (self.buf[self.pos] == (u8)0x0A) {
                    i64 end = self.pos;
                    if (end > start && self.buf[end - 1] == (u8)0x0D) {
                        end = end - 1;
                    }
                    self.pos = self.pos + 1;
                    Slice<u8> s;
                    s.data = &self.buf[start];
                    s.len = end - start;
                    return s;
                }
                self.pos = self.pos + 1;
            }
            if (self.fd < 0 || self.eof) {
                i64 end = self.pos;
                if (end > start && self.buf[end - 1] == (u8)0x0D) {
                    end = end - 1;
                }
                Slice<u8> s;
                s.data = &self.buf[start];
                s.len = end - start;
                return s;
            }
            i64 line_len = self.pos - start;
            if (start > 0) {
                memmove((void*)self.buf, (const void*)&self.buf[start], line_len);
                self.len = line_len;
                self.pos = line_len;
                start = 0;
            }
            i64 space = self.cap - self.len;
            if (space < 1024) {
                i64 new_cap = self.cap * 2;
                self.buf = realloc<u8>(self.buf, new_cap);
                self.cap = new_cap;
                space = self.cap - self.len;
            }
            Result<i64, Error> r = try_read(self.fd, &self.buf[self.len], space);
            if (r.is_ok()) {
                i64 n = r.value();
                if (n == 0) {
                    self.eof = true;
                    i64 end = self.pos;
                    if (end > start && self.buf[end - 1] == (u8)0x0D) {
                        end = end - 1;
                    }
                    Slice<u8> s;
                    s.data = &self.buf[start];
                    s.len = end - start;
                    return s;
                }
                self.len = self.len + n;
            } else {
                self.eof = true;
                i64 end = self.pos;
                if (end > start && self.buf[end - 1] == (u8)0x0D) {
                    end = end - 1;
                }
                Slice<u8> s;
                s.data = &self.buf[start];
                s.len = end - start;
                return s;
            }
        }
        Slice<u8> empty;
        empty.data = (u8*)0;
        empty.len = 0;
        return empty;
    }

    /// Return the next line as a borrowed NUL-terminated str.
    /// Does NOT mutate the source buffer in place.
    str next_line(&mut self) {
        Slice<u8> line = self.next_line_slice();
        if (!self.ok || line.data == (u8*)0) {
            return (str)0;
        }
        if (self.token_buf == (u8*)0 || self.token_cap <= line.len) {
            if (self.token_buf != (u8*)0) {
                free(self.token_buf);
            }
            self.token_cap = line.len + 64;
            self.token_buf = alloc<u8>(self.token_cap);
        }
        if (line.len > 0) {
            memcpy((void*)self.token_buf, (const void*)line.data, line.len);
        }
        self.token_buf[line.len] = (u8)0;
        return (str)self.token_buf;
    }

    /// Return true if no errors have been encountered.
    bool good(&self) {
        return self.ok;
    }
}

impl Drop for Scanner {
    /// Free the internal buffer.
    void drop(*self) {
        if (self.buf != (u8*)0) {
            free(self.buf);
            self.buf = (u8*)0;
        }
        if (self.token_buf != (u8*)0) {
            free(self.token_buf);
            self.token_buf = (u8*)0;
            self.token_cap = 0;
        }
    }
}
