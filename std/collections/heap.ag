// BinaryHeap<T> — max-heap priority queue.
//
// Elements are ordered by the `<` and `>` operators; the greatest element
// is always at the front.  Min-heap behavior can be achieved with a wrapper
// type whose `<` / `>` are reversed.
//
// Memory (malloc/realloc/free) is provided through std.mem.
// pop and peek abort on an empty heap.

import std.mem;
import std.iter;
import std.optional;
import std.mem.vec;

/// A max-heap priority queue backed by a contiguous growable array.
struct BinaryHeap<T> {
    T* data;
    i64 len;
    i64 cap;
}

impl BinaryHeap<T> {
    /// Empty heap — no allocation.
    BinaryHeap<T> new() {
        BinaryHeap<T> h;
        h.data = (T*)0;
        h.len = 0;
        h.cap = 0;
        return h;
    }

    /// Reserve space for `capacity` elements up front.
    BinaryHeap<T> with_capacity(i64 capacity) {
        BinaryHeap<T> h;
        if (capacity != 0) {
            h.data = (T*)(malloc(@size(T) * capacity));
        } else {
            h.data = (T*)0;
        }
        h.len = 0;
        h.cap = capacity;
        return h;
    }
    /// Build a binary heap from a vector by pushing each element.
    BinaryHeap<T> from_vec(Vec<T> v) {
        BinaryHeap<T> h = BinaryHeap<T>.with_capacity(v.len());
        for val in v {
            h.push(move val);
        }
        return h;
    }

    /// Convert the heap into a vector in unspecified (internal buffer) order.
    Vec<T> into_vec(self) {
        Vec<T> v;
        v.data = self.data;
        v.len = self.len;
        v.cap = self.cap;
        self.data = (T*)0;
        self.len = 0;
        self.cap = 0;
        return v;
    }


    // -- Size ------------------------------------------------------------

    /// Number of elements in the heap.
    i64 len(&self) {
        return self.len;
    }

    /// Total allocated capacity.
    i64 capacity(&self) {
        return self.cap;
    }

    /// True when `len` is zero.
    bool is_empty(&self) {
        return self.len == 0;
    }

    // -- Mutation --------------------------------------------------------

    /// Push `value` onto the heap (O(log n)).
    void push(&mut self, T value) {
        if (self.len >= self.cap) {
            i64 new_cap = 1;
            if (self.cap != 0) {
                new_cap = self.cap * 2;
            }
            self.data = (T*)(realloc_bytes(self.data, @size(T) * new_cap));
            self.cap = new_cap;
        }
        self.data[self.len] = move value;
        i64 child = self.len;
        self.len = self.len + 1;

        // Sift up: swap while child > parent
        while (child > 0) {
            i64 parent = (child - 1) / 2;
            if (!(self.data[parent] < self.data[child])) {
                break;
            }
            T tmp_p = self.data[parent];
            T tmp_c = self.data[child];
            self.data[parent] = move tmp_c;
            self.data[child] = move tmp_p;
            child = parent;
        }
    }

    /// Remove and return the greatest element.  Aborts if empty.
    T pop(&mut self) {
        if (self.len == 0) {
            abort();
        }
        T result = self.data[0];
        self.len = self.len - 1;
        if (self.len > 0) {
            T last = self.data[self.len];
            self.data[0] = move last;

            // Sift down: swap root with larger child while root < child
            i64 root = 0;
            while (true) {
                i64 child = 2 * root + 1;
                if (child >= self.len) {
                    break;
                }
                if (child + 1 < self.len && self.data[child] < self.data[child + 1]) {
                    child = child + 1;
                }
                if (!(self.data[root] < self.data[child])) {
                    break;
                }
                T tmp_r = self.data[root];
                T tmp_c = self.data[child];
                self.data[root] = move tmp_c;
                self.data[child] = move tmp_r;
                root = child;
            }
        }
        return result;
    }

    /// Return a copy of the greatest element without removing it.  Aborts if empty.
    T peek(&self) {
        if (self.len == 0) {
            abort();
        }
        return self.data[0];
    }

    // -- Fallible accessors (None instead of abort) -----------------------

    /// Remove and return the greatest element, or None when empty.
    Optional<T> try_pop(&mut self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.pop());
    }

    /// Copy of the greatest element, or None when empty.
    Optional<T> try_peek(&self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.peek());
    }

    /// Remove all elements without freeing the backing buffer.
    void clear(&mut self) {
        self.len = 0;
    }
}

impl<T> Drop for BinaryHeap<T> {
    /// Frees the backing buffer.
    void drop(*self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.cap = 0;
    }
}
struct BinaryHeapIntoIter<T> {
    BinaryHeap<T> heap;
}

impl<T> Iterator for BinaryHeapIntoIter<T> {
    type Item = T;
    Optional<T> next(*self) {
        return self.heap.try_pop();
    }
}

impl<T> Drop for BinaryHeapIntoIter<T> {
    void drop(*self) {
        self.heap.drop();
    }
}

impl<T> IntoIterator for BinaryHeap<T> {
    type Item = T;
    type IntoIter = BinaryHeapIntoIter<T>;
    BinaryHeapIntoIter<T> into_iter(self) {
        BinaryHeapIntoIter<T> it;
        it.heap = move self;
        return it;
    }
}
