// HashSet<K> — hash set backed by HashMap<K, bool>.
//
// Import std.map provides the underlying HashMap with @hash(key) and ==
// semantics for keys.

import std.map;

/// A hash set backed by HashMap<K, bool>.
struct HashSet<K> {
    HashMap<K, bool> map;
}

impl HashSet<K> {
    /// Empty hash set — no allocation until first insert.
    HashSet<K> new() {
        HashSet<K> s;
        s.map = HashMap<K, bool>.new();
        return s;
    }

    /// Number of entries in the set.
    i64 len(HashSet<K>* self) {
        return self.map.len();
    }

    /// True when no entries.
    bool is_empty(HashSet<K>* self) {
        return self.map.is_empty();
    }

    /// Insert a key into the set.  If the key already exists, it is replaced
    /// (the set remains unchanged in logical value).
    void insert(HashSet<K>* self, K key) {
        self.map.insert(key, true);
    }

    /// Return true if the set contains the key.
    bool contains(HashSet<K>* self, K key) {
        return self.map.contains_key(key);
    }

    /// Remove a key from the set.  Returns true if the key was present.
    bool erase(HashSet<K>* self, K key) {
        return self.map.erase(key);
    }

    /// Remove all elements without releasing the backing memory.
    void clear(HashSet<K>* self) {
        self.map.clear();
    }
}

impl<K> Drop<HashSet<K>> for HashSet<K> {
    /// Drops the underlying HashMap.
    void drop(HashSet<K>* self) {
        self.map.drop();
    }
}
