// Ring-buffer deque. Move transfers owned elements; Copy is bitwise.
// `iter` borrows; `into_iter`/`drain` own the buffer. Drop frees buffers only.
import std.mem;
import std.optional;
import std.iter;
/// A double-ended queue backed by a ring buffer.
struct Deque<T> {
    T* data;
    i64 len;
    i64 cap;
    i64 head;
}

impl Deque<T> {
    /// Empty deque — no allocation.
    Deque<T> new() {
        Deque<T> d;
        d.data = (T*)0;
        d.len = 0;
        d.cap = 0;
        d.head = 0;
        return d;
    }

    /// Reserve space for `capacity` elements up front.
    Deque<T> with_capacity(i64 capacity) {
        Deque<T> d;
        if (capacity != 0) {
            d.data = (T*)(malloc(@size(T) * capacity));
        } else {
            d.data = (T*)0;
        }
        d.len = 0;
        d.cap = capacity;
        d.head = 0;
        return d;
    }

    // -- Size ------------------------------------------------------------

    /// Number of elements in the deque.
    i64 len(&Deque<T> self) {
        return self.len;
    }

    /// Total allocated capacity.
    i64 capacity(&Deque<T> self) {
        return self.cap;
    }

    /// True when `len` is zero.
    bool is_empty(&Deque<T> self) {
        return self.len == 0;
    }

    // -- Mutation --------------------------------------------------------

    /// Grow capacity to at least `min_cap`, linearizing the ring buffer.
    /// Moves elements (`new[i] = move old[(head+i)%old_cap]`) not shallow copy;
    /// POD-only copy removed.
    void grow(&mut Deque<T> self, i64 min_cap) {
        i64 new_cap = self.cap;
        if (new_cap == 0) {
            new_cap = 1;
        }
        while (new_cap < min_cap) {
            new_cap = new_cap * 2;
        }
        i64 old_cap = self.cap;
        T* new_data = (T*)(malloc(@size(T) * new_cap));
        if (old_cap > 0) {
            i64 i = 0;
            while (i < self.len) {
                new_data[i] = move self.data[(self.head + i) % old_cap];
                i = i + 1;
            }
        }
        if (self.data != (T*)0) {
            free(self.data);
        }
        self.data = new_data;
        self.head = 0;
        self.cap = new_cap;
    }

    /// Push `value` to the back (O(1) amortized).
    void push_back(&mut Deque<T> self, T value) {
        if (self.len >= self.cap) {
            i64 min_cap = 1;
            if (self.cap != 0) {
                min_cap = self.cap * 2;
            }
            self.grow(min_cap);
        }
        i64 tail = (self.head + self.len) % self.cap;
        self.data[tail] = move value;
        self.len = self.len + 1;
    }

    /// Push `value` to the front (O(1) amortized).
    void push_front(&mut Deque<T> self, T value) {
        if (self.len >= self.cap) {
            i64 min_cap = 1;
            if (self.cap != 0) {
                min_cap = self.cap * 2;
            }
            self.grow(min_cap);
        }
        self.head = (self.head - 1 + self.cap) % self.cap;
        self.data[self.head] = move value;
        self.len = self.len + 1;
    }

    /// Remove and return the front element.  Aborts if empty.
    /// Moves ownership (`move data[head]`); stale slot left moved-from.
    T pop_front(&mut Deque<T> self) {
        if (self.len == 0) {
            abort();
        }
        T result = move self.data[self.head];
        self.head = (self.head + 1) % self.cap;
        self.len = self.len - 1;
        return move result;
    }

    /// Remove and return the back element.  Aborts if empty.
    /// Moves ownership (`move data[tail]`).
    T pop_back(&mut Deque<T> self) {
        if (self.len == 0) {
            abort();
        }
        self.len = self.len - 1;
        i64 tail = (self.head + self.len) % self.cap;
        T result = move self.data[tail];
        return move result;
    }

    /// Return a copy of the front element without removing it.  Aborts if empty.
    T front(&Deque<T> self) {
        if (self.len == 0) {
            abort();
        }
        return self.data[self.head];
    }

    /// Return a copy of the back element without removing it.  Aborts if empty.
    T back(&Deque<T> self) {
        if (self.len == 0) {
            abort();
        }
        i64 tail = (self.head + self.len - 1) % self.cap;
        return self.data[tail];
    }

    // -- Fallible accessors (None instead of abort) -----------------------

    /// Remove and return the front element, or None when empty.
    Optional<T> try_pop_front(&mut Deque<T> self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.pop_front());
    }

    /// Remove and return the back element, or None when empty.
    Optional<T> try_pop_back(&mut Deque<T> self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.pop_back());
    }

    /// Copy of the front element, or None when empty.
    Optional<T> try_front(&Deque<T> self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.front());
    }

    /// Copy of the back element, or None when empty.
    Optional<T> try_back(&Deque<T> self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.back());
    }

    /// Remove all elements without freeing the backing buffer.
    /// NOTE: Does NOT drop elements — for owned T drain via `pop_front`/`pop_back`
    /// (each `move`s) before `clear`/`drop`; otherwise inner allocations leak.
    void clear(&mut Deque<T> self) {
        self.len = 0;
        self.head = 0;
    }
}

impl<T> Drop for Deque<T> {
    /// Frees the backing buffer. Does NOT call per-element destructors; see `clear`.
    void drop(Deque<T>* self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.cap = 0;
        self.head = 0;
    }
}

// -- Iterator support ---------------------------------------------------
//
// Ownership contract repeated for grep: `iter(&self)` borrows, `into_iter(self)` moves.
/// Owning iterator over Deque<T> elements (buffer transferred via `move` in `into_iter`).
struct DequeIter<T> {
    T* data;
    i64 len;
    i64 cap;
    i64 head;
    i64 idx;
}

/// Borrowing iterator over Deque<T> elements (yields copies, does not own buffer).
struct DequeBorrowIter<T> {
    T* data;
    i64 len;
    i64 cap;
    i64 head;
    i64 idx;
}

impl<T> IntoIterator for Deque<T> {
    type Item = T;
    type IntoIter = DequeIter<T>;
    /// Consumes the deque, moving its buffer into the iterator.
    /// `Self self` (by value) — not `&Self` — so `move self.data` drains and
    /// leaves `self` moved-from (null/0). Iterator owns and frees the buffer.
    DequeIter<T> into_iter(Deque<T> self) {
        DequeIter<T> iter;
        iter.data = move self.data;
        iter.len = self.len;
        iter.cap = self.cap;
        iter.head = self.head;
        iter.idx = 0;
        self.data = (T*)0;
        self.len = 0;
        self.cap = 0;
        self.head = 0;
        return iter;
    }
}

impl<T> Deque<T> {
    /// Borrows the deque and yields element copies without consuming it.
    /// `&Deque<T> self` so the deque stays live; iterator holds raw ptr copy.
    DequeBorrowIter<T> iter(&Deque<T> self) {
        DequeBorrowIter<T> it;
        it.data = self.data;
        it.len = self.len;
        it.cap = self.cap;
        it.head = self.head;
        it.idx = 0;
        return it;
    }

    /// Drains the deque, moving its buffer into an owning iterator.
    /// `&mut self` — moves buffer out and clears deque so it is empty but live.
    DequeIter<T> drain(&mut Deque<T> self) {
        DequeIter<T> d;
        d.data = move self.data;
        d.len = self.len;
        d.cap = self.cap;
        d.head = self.head;
        d.idx = 0;
        self.data = (T*)0;
        self.len = 0;
        self.cap = 0;
        self.head = 0;
        return d;
    }
}

impl<T> Drop for DequeIter<T> {
    /// Frees the backing buffer. Does NOT drop un-drained elements — iterate to
    /// completion or `pop_*` to move out owned values before drop.
    void drop(DequeIter<T>* self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.cap = 0;
        self.head = 0;
        self.idx = 0;
    }
}

impl<T> Iterator for DequeIter<T> {
    type Item = T;
    /// Move the next element out; Copy is bitwise.
    Optional<T> next(DequeIter<T>* self) {
        if (self.idx < self.len) {
            i64 pos = (self.head + self.idx) % self.cap;
            T tmp = self.data[pos];
            T value = move tmp;
            self.idx = self.idx + 1;
            return Optional<T>.some(move value);
        }
        return Optional<T>.none();
    }
}

impl<T> Iterator for DequeBorrowIter<T> {
    type Item = T;
    /// Borrow the next element; the deque remains owned by the caller.
    Optional<T> next(DequeBorrowIter<T>* self) {
        if (self.idx < self.len) {
            i64 pos = (self.head + self.idx) % self.cap;
            T v = self.data[pos];
            self.idx = self.idx + 1;
            return Optional<T>.some(v);
        }
        return Optional<T>.none();
    }
}
