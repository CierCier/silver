// std/collections/bitset.ag — Dynamic bitset for dense integer sets and flags.
import std.mem.vec;

/// A growable set of non-negative integers stored as 64-bit words.
/// Negative indices are ignored by every method.
struct BitSet {
    Vec<u64> words;
    i64 bit_count;
}

impl BitSet {
    /// Creates an empty bitset without allocating.
    BitSet new() {
        BitSet b;
        b.words = Vec<u64>.new();
        b.bit_count = 0;
        return move b;
    }

    /// Creates a bitset with room for `bits` bits, all clear. `len()` then
    /// reports `bits` even though no bit is set.
    BitSet with_capacity(i64 bits) {
        BitSet b;
        b.words = Vec<u64>.new();
        b.bit_count = bits;
        i64 words_needed = (bits + 63) / 64;
        i64 i = 0;
        while (i < words_needed) {
            b.words.push(0);
            i += 1;
        }
        return move b;
    }

    /// Sets `bit`, growing the storage when needed.
    void set(BitSet* self, i64 bit) {
        if (bit < 0) { return; }
        i64 word_idx = bit / 64;
        i64 bit_idx = bit % 64;
        while (word_idx >= self.words.len()) {
            self.words.push(0);
        }
        u64 mask = (u64)1 << (u32)bit_idx;
        u64 cur = self.words.get(word_idx);
        self.words.set(word_idx, cur | mask);
        if (bit >= self.bit_count) {
            self.bit_count = bit + 1;
        }
    }

    /// Clears `bit`. Does not shrink storage or `len()`.
    void clear_bit(BitSet* self, i64 bit) {
        if (bit < 0) { return; }
        i64 word_idx = bit / 64;
        if (word_idx >= self.words.len()) { return; }
        i64 bit_idx = bit % 64;
        u64 mask = ~((u64)1 << (u32)bit_idx);
        u64 cur = self.words.get(word_idx);
        self.words.set(word_idx, cur & mask);
    }

    /// Returns true when `bit` is set; false for bits beyond the storage.
    bool test(BitSet* self, i64 bit) {
        if (bit < 0) { return false; }
        i64 word_idx = bit / 64;
        if (word_idx >= self.words.len()) { return false; }
        i64 bit_idx = bit % 64;
        u64 mask = (u64)1 << (u32)bit_idx;
        return (self.words.get(word_idx) & mask) != 0;
    }

    /// Clears every bit. Keeps the storage and `len()` unchanged.
    void clear_all(BitSet* self) {
        i64 i = 0;
        while (i < self.words.len()) {
            self.words.set(i, 0);
            i += 1;
        }
    }

    /// Returns one past the highest bit ever set, or the `with_capacity` size if
    /// larger. It is a bound, not a count of set bits.
    i64 len(&self) {
        return self.bit_count;
    }
}
