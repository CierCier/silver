// Queue<T> — FIFO queue adapter wrapping Deque<T>.
//
// @deprecated Prefer `Deque<T>` from `std.collections.deque`.
//
// Memory and ring buffer logic are provided by Deque<T>.

import std.mem;
import std.collections.deque;
import std.optional;

/// @deprecated Prefer `Deque<T>` from `std.collections.deque`.
/// A FIFO queue backed by `Deque<T>`.
struct Queue<T> {
    Deque<T> inner;
}

impl<T> Queue<T> {
    /// Empty queue — no allocation.
    Queue<T> new() {
        Queue<T> q;
        q.inner = Deque<T>.new();
        return move q;
    }

    /// Reserve space for `capacity` elements up front.
    Queue<T> with_capacity(i64 capacity) {
        Queue<T> q;
        q.inner = Deque<T>.with_capacity(capacity);
        return move q;
    }

    // -- Size ------------------------------------------------------------

    /// Number of elements in the queue.
    i64 len(&self) {
        return self.inner.len();
    }

    /// Total allocated capacity.
    i64 capacity(&self) {
        return self.inner.capacity();
    }

    /// True when `len` is zero.
    bool is_empty(&self) {
        return self.inner.is_empty();
    }

    // -- Mutation --------------------------------------------------------

    /// Push `value` to the back of the queue (O(1) amortized).
    void push(&mut self, T value) {
        self.inner.push_back(move value);
    }

    /// Remove and return the front element. Aborts if empty.
    T pop(&mut self) {
        return self.inner.pop_front();
    }

    /// Return a copy of the front element without removing it. Aborts if empty.
    T front(&self) {
        return self.inner.front();
    }

    // -- Fallible accessors (None instead of abort) -----------------------

    /// Remove and return the front element, or None when empty.
    Optional<T> try_pop(&mut self) {
        return self.inner.try_pop_front();
    }

    /// Copy of the front element, or None when empty.
    Optional<T> try_front(&self) {
        return self.inner.try_front();
    }

    /// Remove all elements without freeing the backing buffer.
    void clear(&mut self) {
        self.inner.clear();
    }
}

impl<T> Drop for Queue<T> {
    /// Frees the backing buffer.
    void drop(*self) {
        self.inner.drop();
    }
}
