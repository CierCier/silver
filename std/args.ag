// std/args.ag — process argument access.
// References accessor functions compiled from entry.ag.

extern "C" {
    i32 silver_argc();
    i8** silver_argv();
}

struct Args {
    i32 argc;
    i8** argv;
}

impl Args {
    Args new() {
        Args a;
        a.argc = silver_argc();
        a.argv = silver_argv();
        return a;
    }

    i32 argc(*self) {
        return self.argc;
    }
}
