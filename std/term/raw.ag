// std/term/raw.ag — termios definitions and the raw-mode guard.
//
// RawMode.enable puts a tty fd into raw (cfmakeraw-equivalent) state and
// restores the saved mode on drop, so early returns cannot leave the
// terminal unusable. Linux uses termios ioctls; other platforms go through
// the sys_raw_enable/sys_raw_restore seam (Win32 console mode), sharing
// the same guard shape.

import std.sys.raw.fs;
import std.sys.os;
import std.sys.result;
import std.error;
import std.result;

// termios ioctl requests (Linux x86_64).
/// ioctl request that reads a terminal's termios settings.
const i64 TCGETS = 0x5401;
/// ioctl request that applies termios settings immediately.
const i64 TCSETS = 0x5402;
/// ioctl request that applies termios settings after pending output drains.
const i64 TCSETSW = 0x5403;
/// ioctl request that drains output, discards pending input, then applies
/// termios settings.
const i64 TCSETSF = 0x5404;

// Input flags.
/// termios input flag: a break condition sends SIGINT.
const u32 BRKINT = 0x2;
/// termios input flag: translate CR to NL on input.
const u32 ICRNL = 0x100;
/// termios input flag: enable input parity checking.
const u32 INPCK = 0x10;
/// termios input flag: strip the eighth bit of input bytes.
const u32 ISTRIP = 0x20;
/// termios input flag: XON/XOFF output flow control (Ctrl-S/Ctrl-Q).
const u32 IXON = 0x400;
// Output flags.
/// termios output flag: enable output processing (such as NL to CRNL).
const u32 OPOST = 0x1;
// Control flags.
/// termios control flag: 8-bit characters.
const u32 CS8 = 0x30;
// Local flags.
/// termios local flag: Ctrl-C, Ctrl-Z, and Ctrl-\ generate signals.
const u32 ISIG = 0x1;
/// termios local flag: canonical (line-buffered) input.
const u32 ICANON = 0x2;
/// termios local flag: echo input characters.
const u32 ECHO = 0x8;
/// termios local flag: extended input processing (such as Ctrl-V).
const u32 IEXTEN = 0x8000;
// Control-character indices.
/// `c_cc` index of the minimum byte count for a non-canonical read.
const i64 VMIN = 6;
/// `c_cc` index of the non-canonical read timeout, in tenths of a second.
const i64 VTIME = 5;

/// Linux x86_64 `struct termios` (60 bytes with C padding, computed by the
/// type checker): 4 flag words, line discipline, 32 control characters,
/// and the input/output baud words.
struct Termios {
    u32 c_iflag;
    u32 c_oflag;
    u32 c_cflag;
    u32 c_lflag;
    u8 c_line;
    u8 c_cc[32];
    u32 c_ispeed;
    u32 c_ospeed;
}

if (@cfg(os.linux)) {
/// Reads the termios settings of terminal `fd` into `*out`.
Result<i64, Error> try_tcgetattr(i32 fd, Termios* out) {
    i64 r = sys_ioctl((i64)fd, TCGETS, (i64)out);
    if (r != 0) {
        return Err(-r, "tcgetattr failed");
    }
    return Ok((i64)0);
}

/// Applies `*t` to terminal `fd`. `action` is `TCSETS`, `TCSETSW`, or `TCSETSF`.
Result<i64, Error> try_tcsetattr(i32 fd, i64 action, Termios* t) {
    i64 r = sys_ioctl((i64)fd, action, (i64)t);
    if (r != 0) {
        return Err(-r, "tcsetattr failed");
    }
    return Ok((i64)0);
}
}

/// True when `fd` is a terminal. Portable over the sys_is_tty seam
/// (TCGETS probe on Linux, GetConsoleMode on Windows).
bool term_is_tty(i32 fd) {
    return sys_is_tty((i64)fd) != 0;
}

/// Apply cfmakeraw-equivalent bits to a termios value in place.
void termios_make_raw(Termios* t) {
    t.c_iflag = t.c_iflag & ~(BRKINT | ICRNL | INPCK | ISTRIP | IXON);
    t.c_oflag = t.c_oflag & ~OPOST;
    t.c_cflag = t.c_cflag | CS8;
    t.c_lflag = t.c_lflag & ~(ECHO | ICANON | IEXTEN | ISIG);
    t.c_cc[VMIN] = (u8)1;
    t.c_cc[VTIME] = (u8)0;
}

if (@cfg(os.linux)) {
/// A guard that holds a terminal in raw mode. Dropping it restores the saved
/// termios settings, so keep it alive for as long as raw mode is needed.
struct RawMode {
    i32 fd;
    Termios saved;
    bool active;
}

impl RawMode {
    /// Put `fd` into raw mode, saving its termios for restore on drop.
    /// Fails (without touching the fd) when `fd` is not a tty.
    Result<RawMode, Error> enable(i32 fd) {
        Termios cur;
        i64 r = sys_ioctl((i64)fd, TCGETS, (i64)&cur);
        if (r != 0) {
            return Err(-r, "tcgetattr failed");
        }
        Termios saved = cur;
        termios_make_raw(&cur);
        r = sys_ioctl((i64)fd, TCSETSF, (i64)&cur);
        if (r != 0) {
            return Err(-r, "tcsetattr failed");
        }
        RawMode g;
        g.fd = fd;
        g.saved = saved;
        g.active = true;
        return Ok(move g);
    }

    /// Restore the saved termios early; also runs from drop.
    void restore(*self) {
        if (self.active) {
            sys_ioctl((i64)self.fd, TCSETSW, (i64)&self.saved);
            self.active = false;
        }
    }
}

impl Drop for RawMode {
    void drop(*self) {
        self.restore();
    }
}
} else {
    // Windows RawMode: same guard shape, but the saved slot carries the
    // console input mode DWORD (little-endian in the first 4 Termios bytes)
    // managed by the sys_raw_enable/sys_raw_restore seam.
    /// A guard that holds the console in raw mode. Dropping it restores the saved
    /// console input mode, so keep it alive for as long as raw mode is needed.
    struct RawMode {
        i32 fd;
        Termios saved;
        bool active;
    }

    impl RawMode {
        /// Put `fd` into raw mode, saving its console mode for restore.
        /// Fails (without touching the fd) when `fd` is not a console.
        Result<RawMode, Error> enable(i32 fd) {
            RawMode g;
            g.fd = fd;
            g.active = false;
            i64 r = sys_raw_enable((i64)fd, (u8*)&g.saved, 60);
            if (r != 0) {
                return Err(-r, "raw mode failed");
            }
            g.active = true;
            return Ok(move g);
        }

        /// Restore the saved console mode early; also runs from drop.
        void restore(*self) {
            if (self.active) {
                sys_raw_restore((i64)self.fd, (u8*)&self.saved);
                self.active = false;
            }
        }
    }

    impl Drop for RawMode {
        void drop(*self) {
            self.restore();
        }
    }
}
