// std/crypto/sha256.ag — pure-Silver SHA-256 and HMAC-SHA256 implementation (FIPS 180-4 / RFC 6234).

import std.mem.alloc;
import std.mem.drop;
import std.mem.memory;
import std.string;

const i64 SHA256_BLOCK = 64;
const i64 SHA256_OUT = 32;

i64 sha256_rotr(i64 x, i64 n) {
    return (((x >> n) | (x << (64 - n))) & (i64)0xffffffff) | ((((x & (i64)0xffffffff) >> n) | ((x & (i64)0xffffffff) << (32 - n))) & (i64)0xffffffff);
}

i64 sha256_shr(i64 x, i64 n) {
    return ((x & (i64)0xffffffff) >> n) & (i64)0xffffffff;
}

i64 sha256_ch(i64 x, i64 y, i64 z) {
    return ((x & y) ^ ((~x) & z)) & (i64)0xffffffff;
}

i64 sha256_maj(i64 x, i64 y, i64 z) {
    return ((x & y) ^ (x & z) ^ (y & z)) & (i64)0xffffffff;
}

i64 sha256_big_sigma0(i64 x) {
    return sha256_rotr(x, 2) ^ sha256_rotr(x, 13) ^ sha256_rotr(x, 22);
}

i64 sha256_big_sigma1(i64 x) {
    return sha256_rotr(x, 6) ^ sha256_rotr(x, 11) ^ sha256_rotr(x, 25);
}

i64 sha256_small_sigma0(i64 x) {
    return sha256_rotr(x, 7) ^ sha256_rotr(x, 18) ^ sha256_shr(x, 3);
}

i64 sha256_small_sigma1(i64 x) {
    return sha256_rotr(x, 17) ^ sha256_rotr(x, 19) ^ sha256_shr(x, 10);
}

u32 K256[64] = {
    (u32)0x428a2f98, (u32)0x71374491, (u32)0xb5c0fbcf, (u32)0xe9b5dba5,
    (u32)0x3956c25b, (u32)0x59f111f1, (u32)0x923f82a4, (u32)0xab1c5ed5,
    (u32)0xd807aa98, (u32)0x12835b01, (u32)0x243185be, (u32)0x550c7dc3,
    (u32)0x72be5d74, (u32)0x80deb1fe, (u32)0x9bdc06a7, (u32)0xc19bf174,
    (u32)0xe49b69c1, (u32)0xefbe4786, (u32)0x0fc19dc6, (u32)0x240ca1cc,
    (u32)0x2de92c6f, (u32)0x4a7484aa, (u32)0x5cb0a9dc, (u32)0x76f988da,
    (u32)0x983e5152, (u32)0xa831c66d, (u32)0xb00327c8, (u32)0xbf597fc7,
    (u32)0xc6e00bf3, (u32)0xd5a79147, (u32)0x06ca6351, (u32)0x14292967,
    (u32)0x27b70a85, (u32)0x2e1b2138, (u32)0x4d2c6dfc, (u32)0x53380d13,
    (u32)0x650a7354, (u32)0x766a0abb, (u32)0x81c2c92e, (u32)0x92722c85,
    (u32)0xa2bfe8a1, (u32)0xa81a664b, (u32)0xc24b8b70, (u32)0xc76c51a3,
    (u32)0xd192e819, (u32)0xd6990624, (u32)0xf40e3585, (u32)0x106aa070,
    (u32)0x19a4c116, (u32)0x1e376c08, (u32)0x2748774c, (u32)0x34b0bcb5,
    (u32)0x391c0cb3, (u32)0x4ed8aa4a, (u32)0x5b9cca4f, (u32)0x682e6ff3,
    (u32)0x748f82ee, (u32)0x78a5636f, (u32)0x84c87814, (u32)0x8cc70208,
    (u32)0x90befffa, (u32)0xa4506ceb, (u32)0xbef9a3f7, (u32)0xc67178f2
};

/// Compute SHA-256 digest over `len` bytes at `data`.
/// Output is written to `out` (must be at least 32 bytes).
bool sha256(u8* data, i64 len, u8* out) {
    if (data == (u8*)0 && len != 0) {
        return false;
    }

    i64 h0 = (i64)0x6a09e667;
    i64 h1 = (i64)0xbb67ae85;
    i64 h2 = (i64)0x3c6ef372;
    i64 h3 = (i64)0xa54ff53a;
    i64 h4 = (i64)0x510e527f;
    i64 h5 = (i64)0x9b05688c;
    i64 h6 = (i64)0x1f83d9ab;
    i64 h7 = (i64)0x5be0cd19;

    u64 bit_len = (u64)len * 8;
    i64 blocks = (len + 72) / 64;

    i64 w[64];
    i64 off = 0;
    i64 b = 0;
    while (b < blocks) {
        u8 block[64];
        i64 i = 0;
        while (i < 64) {
            if (off < len) {
                block[i] = data[off];
            } else if (off == len) {
                block[i] = (u8)0x80;
            } else if (off >= blocks * 64 - 8) {
                i64 byte_idx = off - (blocks * 64 - 8);
                block[i] = (u8)((bit_len >> ((7 - byte_idx) * 8)) & 0xff);
            } else {
                block[i] = (u8)0;
            }
            off = off + 1;
            i = i + 1;
        }

        i = 0;
        while (i < 16) {
            w[i] = ((i64)block[i * 4] << 24) | ((i64)block[i * 4 + 1] << 16)
                | ((i64)block[i * 4 + 2] << 8) | (i64)block[i * 4 + 3];
            i = i + 1;
        }
        while (i < 64) {
            i64 s0 = sha256_small_sigma0(w[i - 15]);
            i64 s1 = sha256_small_sigma1(w[i - 2]);
            w[i] = (w[i - 16] + s0 + w[i - 7] + s1) & (i64)0xffffffff;
            i = i + 1;
        }

        i64 a = h0;
        i64 bv = h1;
        i64 c = h2;
        i64 d = h3;
        i64 e = h4;
        i64 f = h5;
        i64 g = h6;
        i64 h = h7;

        i = 0;
        while (i < 64) {
            i64 S1 = sha256_big_sigma1(e);
            i64 ch = sha256_ch(e, f, g);
            i64 temp1 = (h + S1 + ch + (i64)K256[i] + w[i]) & (i64)0xffffffff;
            i64 S0 = sha256_big_sigma0(a);
            i64 maj = sha256_maj(a, bv, c);
            i64 temp2 = (S0 + maj) & (i64)0xffffffff;

            h = g;
            g = f;
            f = e;
            e = (d + temp1) & (i64)0xffffffff;
            d = c;
            c = bv;
            bv = a;
            a = (temp1 + temp2) & (i64)0xffffffff;

            i = i + 1;
        }

        h0 = (h0 + a) & (i64)0xffffffff;
        h1 = (h1 + bv) & (i64)0xffffffff;
        h2 = (h2 + c) & (i64)0xffffffff;
        h3 = (h3 + d) & (i64)0xffffffff;
        h4 = (h4 + e) & (i64)0xffffffff;
        h5 = (h5 + f) & (i64)0xffffffff;
        h6 = (h6 + g) & (i64)0xffffffff;
        h7 = (h7 + h) & (i64)0xffffffff;

        b = b + 1;
    }

    out[0]  = (u8)(h0 >> 24); out[1]  = (u8)(h0 >> 16); out[2]  = (u8)(h0 >> 8); out[3]  = (u8)h0;
    out[4]  = (u8)(h1 >> 24); out[5]  = (u8)(h1 >> 16); out[6]  = (u8)(h1 >> 8); out[7]  = (u8)h1;
    out[8]  = (u8)(h2 >> 24); out[9]  = (u8)(h2 >> 16); out[10] = (u8)(h2 >> 8); out[11] = (u8)h2;
    out[12] = (u8)(h3 >> 24); out[13] = (u8)(h3 >> 16); out[14] = (u8)(h3 >> 8); out[15] = (u8)h3;
    out[16] = (u8)(h4 >> 24); out[17] = (u8)(h4 >> 16); out[18] = (u8)(h4 >> 8); out[19] = (u8)h4;
    out[20] = (u8)(h5 >> 24); out[21] = (u8)(h5 >> 16); out[22] = (u8)(h5 >> 8); out[23] = (u8)h5;
    out[24] = (u8)(h6 >> 24); out[25] = (u8)(h6 >> 16); out[26] = (u8)(h6 >> 8); out[27] = (u8)h6;
    out[28] = (u8)(h7 >> 24); out[29] = (u8)(h7 >> 16); out[30] = (u8)(h7 >> 8); out[31] = (u8)h7;
    return true;
}

/// Compute SHA-256 and return hex string (64 characters).
String sha256_hex(u8* data, i64 len) {
    u8 digest[32];
    sha256(data, len, &digest[0]);

    str hex_chars = "0123456789abcdef";
    String res = String.with_capacity(64);
    for (i64 i = 0; i < 32; i = i + 1) {
        u8 byte = digest[i];
        res.push((u8)hex_chars[(i64)(byte >> 4)]);
        res.push((u8)hex_chars[(i64)(byte & (u8)0x0f)]);
    }
    return move res;
}

/// Compute HMAC-SHA256 (RFC 2104).
/// Output is written to `out` (must be at least 32 bytes).
bool hmac_sha256(u8* key, i64 key_len, u8* msg, i64 msg_len, u8* out) {
    u8 k_pad[64];
    for (i64 i = 0; i < 64; i = i + 1) {
        k_pad[i] = (u8)0;
    }

    if (key_len > 64) {
        sha256(key, key_len, &k_pad[0]);
    } else {
        for (i64 i = 0; i < key_len; i = i + 1) {
            k_pad[i] = key[i];
        }
    }

    // Inner hash: SHA-256((k_pad ^ 0x36) || msg)
    u8 i_pad[64];
    u8 o_pad[64];
    for (i64 i = 0; i < 64; i = i + 1) {
        i_pad[i] = k_pad[i] ^ (u8)0x36;
        o_pad[i] = k_pad[i] ^ (u8)0x5c;
    }

    i64 inner_len = 64 + msg_len;
    u8* inner_buf = alloc<u8>(inner_len);
    silver_rt_memcpy(inner_buf, &i_pad[0], 64);
    if (msg_len > 0 && msg != (u8*)0) {
        silver_rt_memcpy(&inner_buf[64], msg, msg_len);
    }

    u8 inner_hash[32];
    sha256(inner_buf, inner_len, &inner_hash[0]);
    free((void*)inner_buf);

    // Outer hash: SHA-256((k_pad ^ 0x5c) || inner_hash)
    u8 outer_buf[96];
    silver_rt_memcpy(&outer_buf[0], &o_pad[0], 64);
    silver_rt_memcpy(&outer_buf[64], &inner_hash[0], 32);

    return sha256(&outer_buf[0], 96, out);
}
