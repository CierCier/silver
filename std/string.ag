import std.mem.alloc;
import std.mem.memory;
import std.ops;
import std.slice;
import std.mem.drop;
import std.iter;
import std.optional;
import std.mem.vec;
import std.error;
import std.result;
import std.sys.result;
// memcmp, strcmp, strlen, abort come from std.mem.memory
// (transitively via std.mem.alloc).

struct String {
    u8* data;
    i64 len;
    i64 capacity;
}

impl String {
    String new() {
        return String.with_capacity(16);
    }

    String with_capacity(i64 capacity) {
        String s;
        s.len = 0;
        s.capacity = capacity;
        if (capacity > 0) {
            s.data = alloc_n<u8>(capacity);
            s.data[0] = (u8)0;
        } else {
            s.data = (u8*)0;
        }
        return s;
    }

    i64 len(&self) {
        return self.len;
    }

    /// True when `len` is zero.
    bool is_empty(&self) {
        return self.len == 0;
    }

    i64 capacity(&self) {
        return self.capacity;
    }

    Slice<u8> as_slice(&self) {
        Slice<u8> s;
        s.data = self.data;
        s.len = self.len;
        return s;
    }

    /// Returns a sub-slice spanning [start, end) with Python-style negative index clamping.
    Slice<u8> __slice_get(&self, i64 start, i64 end) {
        Slice<u8> s = self.as_slice();
        return s.__slice_get(start, end);
    }

    void clear(&mut self) {
        self.len = 0;
        if (self.data != (u8*)0) {
            self.data[0] = (u8)0;
        }
    }

    void push(&mut self, u8 ch) {
        // Need space for the character plus the null terminator
        if (self.len + 2 > self.capacity) {
            i64 new_cap = self.capacity * 2;
            if (new_cap < 16) {
                new_cap = 16;
            }
            self.data = realloc<u8>(self.data, new_cap);
            self.capacity = new_cap;
        }
        self.data[self.len] = ch;
        self.len = self.len + 1;
        self.data[self.len] = (u8)0;
    }

    /// Append `len` raw bytes from `bytes` with a single bulk copy.
    #[inline(always)]
    void push_bytes(&mut self, u8* bytes, i64 len) {
        if (len <= 0 || bytes == (u8*)0) { return; }
        if (self.len + len + 1 > self.capacity) {
            i64 new_cap = self.capacity * 2;
            if (new_cap < 16) { new_cap = 16; }
            while (new_cap < self.len + len + 1) { new_cap = new_cap * 2; }
            self.data = realloc<u8>(self.data, new_cap);
            self.capacity = new_cap;
        }
        silver_rt_memcpy(&self.data[self.len], bytes, len);
        self.len = self.len + len;
        self.data[self.len] = (u8)0;
    }

    void push_str(&mut self, str text) {
        if (text == (str)0) {
            return;
        }
        i64 text_len = strlen(text);
        if (text_len == 0) {
            return;
        }
        if (self.len + text_len + 1 > self.capacity) {
            i64 new_cap = self.capacity * 2;
            if (new_cap < self.len + text_len + 16) {
                new_cap = self.len + text_len + 16;
            }
            self.data = realloc<u8>(self.data, new_cap);
            self.capacity = new_cap;
        }
        memcpy((void*)&self.data[self.len], (const void*)text, text_len);
        self.len = self.len + text_len;
        self.data[self.len] = (u8)0;
    }

    // Clone borrows self by shared reference, creates a deep copy, and returns it.
    // The caller retains ownership of the original string.
    String clone(&self) {
        String s = String.with_capacity(self.capacity);
        s.len = self.len;
        if (self.len > 0) {
            memcpy((void*)s.data, (const void*)self.data, self.len);
            s.data[s.len] = (u8)0;
        }
        return s;
    }

    bool equals(&self, str other) {
        if (other == (str)0) {
            return false;
        }
        if (self.data == (u8*)0) {
            return strlen(other) == 0;
        }
        return strcmp((const char*)self.data, other) == 0;
    }

    const char* to_str(&self) {
        if (self.data == (u8*)0) {
            return "";
        }
        return (const char*)self.data;
    }

    String from_str(str s) {
        // +1 so push_str's NUL never forces a second allocation.
        String out = String.with_capacity(strlen(s) + 1);
        out.push_str(s);
        return out;
    }

    /// Borrow the contents as a NUL-terminated str view. The view is valid
    /// while the original String still owns its buffer (the same lifetime as
    /// accessing `.data` directly). Cast receivers are borrowed views: the
    /// compiler does not run the by-value `self` copy's destructor, so the
    /// String keeps ownership and no explicit hand-off is needed.
    cast str(String self) {
        return (str)self.data;
    }

    String trim(&self) {
        i64 start = 0;
        i64 end = self.len;
        while (start < self.len) {
            u8 ch = self.data[start];
            if (ch != (u8)32 && ch != (u8)9 && ch != (u8)10 && ch != (u8)13) {
                break;
            }
            start = start + 1;
        }
        while (end > start) {
            u8 ch = self.data[end - 1];
            if (ch != (u8)32 && ch != (u8)9 && ch != (u8)10 && ch != (u8)13) {
                break;
            }
            end = end - 1;
        }
        i64 new_len = end - start;
        // +1 for the NUL terminator: with_capacity(N) + data[N] = 0 would
        // write one byte past the allocation.
        String result = String.with_capacity(new_len + 1);
        result.len = new_len;
        if (new_len > 0) {
            memcpy((void*)result.data, (const void*)&self.data[start], new_len);
            result.data[new_len] = (u8)0;
        }
        return result;
    }

    bool starts_with(&self, str prefix) {
        if (prefix == (str)0) {
            return false;
        }
        i64 prefix_len = strlen(prefix);
        if (prefix_len == 0) {
            return true;
        }
        if (self.len < prefix_len) {
            return false;
        }
        return memcmp((const void*)self.data, (const void*)prefix, prefix_len) == 0;
    }

    bool ends_with(&self, str suffix) {
        if (suffix == (str)0) {
            return false;
        }
        i64 suffix_len = strlen(suffix);
        if (suffix_len == 0) {
            return true;
        }
        if (self.len < suffix_len) {
            return false;
        }
        return memcmp((const void*)&self.data[self.len - suffix_len], (const void*)suffix, suffix_len) == 0;
    }

    bool contains(&self, str needle) {
        if (needle == (str)0) {
            return false;
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return true;
        }
        if (self.len < needle_len) {
            return false;
        }
        if (needle_len == 1) {
            // Single byte: SSE2 memchr scan instead of per-position memcmp.
            u8* n = (u8*)needle;
            u8 first = n[0];
            return mem_find_byte(&self.data[0], first, self.len) >= 0;
        }
        for (i64 i = 0; i <= self.len - needle_len; i = i + 1) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                return true;
            }
        }
        return false;
    }

    i64 find(&self, str needle) {
        if (needle == (str)0) {
            return -1;
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return 0;
        }
        if (self.len < needle_len) {
            return -1;
        }
        if (needle_len == 1) {
            // Single byte: SSE2/AVX2 memchr scan instead of per-position memcmp.
            u8* n = (u8*)needle;
            u8 first = n[0];
            return mem_find_byte(&self.data[0], first, self.len);
        }
        for (i64 i = 0; i <= self.len - needle_len; i = i + 1) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                return i;
            }
        }
        return -1;
    }

    /// Find last occurrence of `needle`. Returns index, or -1 if not found.
    i64 rfind(&self, str needle) {
        if (needle == (str)0) {
            return -1;
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return self.len;
        }
        if (self.len < needle_len) {
            return -1;
        }
        if (needle_len == 1) {
            u8* n = (u8*)needle;
            return mem_find_byte_back(&self.data[0], n[0], self.len);
        }
        i64 i = self.len - needle_len;
        while (i >= 0) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                return i;
            }
            i = i - 1;
        }
        return -1;
    }

    /// Count occurrences of `needle` in the string.
    i64 count(&self, str needle) {
        if (needle == (str)0 || self.len == 0) {
            return 0;
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return 0;
        }
        if (needle_len == 1) {
            u8* n = (u8*)needle;
            return mem_count_byte(&self.data[0], n[0], self.len);
        }
        i64 c = 0;
        i64 i = 0;
        while (i <= self.len - needle_len) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                c = c + 1;
                i = i + needle_len;
            } else {
                i = i + 1;
            }
        }
        return c;
    }

    /// Return a copy converted to lowercase ASCII.
    String to_lowercase(&self) {
        String result = self.clone();
        for (i64 i = 0; i < result.len; i = i + 1) {
            u8 ch = result.data[i];
            if (ch >= (u8)65 && ch <= (u8)90) {
                result.data[i] = ch + (u8)32;
            }
        }
        return result;
    }

    /// Return a copy converted to uppercase ASCII.
    String to_uppercase(&self) {
        String result = self.clone();
        for (i64 i = 0; i < result.len; i = i + 1) {
            u8 ch = result.data[i];
            if (ch >= (u8)97 && ch <= (u8)122) {
                result.data[i] = ch - (u8)32;
            }
        }
        return result;
    }

    String substr(&self, i64 start, i64 len) {
        if (start < 0) {
            start = 0;
        }
        if (start >= self.len) {
            return String.new();
        }
        if (len <= 0) {
            return String.new();
        }
        if (start + len > self.len) {
            len = self.len - start;
        }
        String result = String.with_capacity(len + 1); // +1 for NUL
        result.len = len;
        if (len > 0) {
            memcpy((void*)result.data, (const void*)&self.data[start], len);
            result.data[len] = (u8)0;
        }
        return result;
    }

    SplitIter split(&self, str delimiter) {
        SplitIter it;
        it.data = self.data;
        it.len = self.len;
        it.pos = 0;
        it.delim = delimiter;
        it.delim_len = strlen(delimiter);
        it.done = false;
        it.has_saved = false;
        it.saved_byte = (u8)0;
        it.saved_end = 0;
        return it;
    }

    String join(str delimiter, Vec<String>* strings) {
        i64 delim_len = strlen(delimiter);
        i64 total = 0;
        for (i64 i = 0; i < strings.len(); i = i + 1) {
            String* s = strings.get_ptr(i);
            total = total + s.len;
        }
        if (strings.len() > 1) {
            total = total + delim_len * (strings.len() - 1);
        }
        String result = String.with_capacity(total + 1); // +1 for NUL
        result.len = total;
        i64 pos = 0;
        for (i64 i = 0; i < strings.len(); i = i + 1) {
            String* s = strings.get_ptr(i);
            if (s.len > 0) {
                memcpy((void*)&result.data[pos], (const void*)s.data, s.len);
                pos = pos + s.len;
            }
            if (i < strings.len() - 1 && delim_len > 0) {
                memcpy((void*)&result.data[pos], (const void*)delimiter, delim_len);
                pos = pos + delim_len;
            }
        }
        if (total > 0) {
            result.data[total] = (u8)0;
        }
        return result;
    }

    String replace(&self, str needle, str replacement) {
        if (needle == (str)0 || self.len == 0) {
            return self.clone();
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return self.clone();
        }
        i64 repl_len = 0;
        if (replacement != (str)0) {
            repl_len = strlen(replacement);
        }
        // First pass: count non-overlapping occurrences.
        i64 count = 0;
        i64 i = 0;
        while (i <= self.len - needle_len) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                count = count + 1;
                i = i + needle_len;
            } else {
                i = i + 1;
            }
        }
        if (count == 0) {
            return self.clone();
        }
        // Second pass: build the result.
        i64 new_len = self.len - count * needle_len + count * repl_len;
        String result = String.with_capacity(new_len + 1); // +1 for NUL
        result.len = new_len;
        i64 src = 0;
        i64 dst = 0;
        while (src < self.len) {
            if (src <= self.len - needle_len
                && memcmp((const void*)&self.data[src], (const void*)needle, needle_len) == 0) {
                if (repl_len > 0) {
                    memcpy((void*)&result.data[dst], (const void*)replacement, repl_len);
                    dst = dst + repl_len;
                }
                src = src + needle_len;
            } else {
                result.data[dst] = self.data[src];
                src = src + 1;
                dst = dst + 1;
            }
        }
        if (new_len > 0) {
            result.data[new_len] = (u8)0;
        }
        return result;
    }
    i64 byte_len(&self) {
        return self.len;
    }

    bool is_valid_utf8(&self) {
        if (self.data == (u8*)0) { return false; }
        i64 i = 0;
        while (i + 16 <= self.len) {
            i64 non_ascii = asm("movdqu (%rax), %xmm0\npmovmskb %xmm0, %eax", [&self.data[i]], ["xmm0"]);
            if (non_ascii == 0) {
                i = i + 16;
            } else {
                break;
            }
        }
        while (i < self.len) {
            u8 b = self.data[i];
            if (b < (u8)0x80) {
                // 1-byte sequence: 0xxxxxxx
                i = i + 1;
            } else if (b < (u8)0xE0) {
                // 2-byte sequence: 110xxxxx 10xxxxxx
                if (i + 1 >= self.len) { return false; }
                u8 b2 = self.data[i + 1];
                if (b < (u8)0xC2) { return false; }
                if ((b2 & (u8)0xC0) != (u8)0x80) { return false; }
                i = i + 2;
            } else if (b < (u8)0xF0) {
                // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
                if (i + 2 >= self.len) { return false; }
                u8 b2 = self.data[i + 1];
                u8 b3 = self.data[i + 2];
                if ((b2 & (u8)0xC0) != (u8)0x80) { return false; }
                if ((b3 & (u8)0xC0) != (u8)0x80) { return false; }
                // Reject overlong (E0 80..9F)
                if (b == (u8)0xE0 && b2 < (u8)0xA0) { return false; }
                // Reject surrogates (ED A0..BF)
                if (b == (u8)0xED && b2 >= (u8)0xA0) { return false; }
                i = i + 3;
            } else if (b < (u8)0xF8) {
                // 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                if (i + 3 >= self.len) { return false; }
                u8 b2 = self.data[i + 1];
                u8 b3 = self.data[i + 2];
                u8 b4 = self.data[i + 3];
                if ((b2 & (u8)0xC0) != (u8)0x80) { return false; }
                if ((b3 & (u8)0xC0) != (u8)0x80) { return false; }
                if ((b4 & (u8)0xC0) != (u8)0x80) { return false; }
                // Reject overlong (F0 80..8F)
                if (b == (u8)0xF0 && b2 < (u8)0x90) { return false; }
                // Reject > U+10FFFF (F4 90+ or F5+)
                if (b == (u8)0xF4 && b2 >= (u8)0x90) { return false; }
                if (b >= (u8)0xF5) { return false; }
                i = i + 4;
            } else {
                // 0xF8..0xFF: invalid lead byte
                return false;
            }
        }
        return true;
    }

    i64 char_len(&self) {
        if (self.data == (u8*)0) { return 0; }
        i64 count = 0;
        i64 i = 0;
        while (i < self.len) {
            count = count + 1;
            u8 b = self.data[i];
            if (b < (u8)0x80) {
                i = i + 1;
            } else if (b < (u8)0xE0) {
                i = i + 2;
            } else if (b < (u8)0xF0) {
                i = i + 3;
            } else {
                i = i + 4;
            }
        }
        return count;
    }

    bool push_codepoint(&mut self, u32 cp) {
        // Reject surrogates and out-of-range values
        if (cp >= (u32)0xD800 && cp <= (u32)0xDFFF) { return false; }
        if (cp > (u32)0x10FFFF) { return false; }
        if (cp < (u32)0x80) {
            self.push((u8)cp);
        } else if (cp < (u32)0x800) {
            self.push((u8)((u32)0xC0 | (cp >> (u32)6)));
            self.push((u8)((u32)0x80 | (cp & (u32)0x3F)));
        } else if (cp < (u32)0x10000) {
            self.push((u8)((u32)0xE0 | (cp >> (u32)12)));
            self.push((u8)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
            self.push((u8)((u32)0x80 | (cp & (u32)0x3F)));
        } else {
            self.push((u8)((u32)0xF0 | (cp >> (u32)18)));
            self.push((u8)((u32)0x80 | ((cp >> (u32)12) & (u32)0x3F)));
            self.push((u8)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
            self.push((u8)((u32)0x80 | (cp & (u32)0x3F)));
        }
        return true;
    }
    Optional<i64> parse_i64(&self) {
        if (self.len == 0 || self.data == (u8*)0) { return None; }
        return parse_i64((str)self.data);
    }

    Optional<i64> parse_i64_radix(&self, i64 radix) {
        if (self.len == 0 || self.data == (u8*)0) { return None; }
        return parse_i64_radix((str)self.data, radix);
    }

    Optional<i32> parse_i32(&self) {
        Optional<i64> o = self.parse_i64();
        if (o.is_none()) { return None; }
        return Some((i32)o.unwrap());
    }

    Optional<u64> parse_u64(&self) {
        Optional<i64> o = self.parse_i64();
        if (o.is_none()) { return None; }
        i64 v = o.unwrap();
        if (v < 0) { return None; }
        return Some((u64)v);
    }

    Vec<i64> extract_ints(&self) {
        if (self.len == 0 || self.data == (u8*)0) {
            return Vec<i64>.new();
        }
        return extract_ints((str)self.data);
    }

    Vec<String> lines(&self) {
        Vec<String> res = Vec<String>.new();
        if (self.len == 0 || self.data == (u8*)0) {
            return res;
        }
        i64 start = 0;
        for (i64 i = 0; i < self.len; i = i + 1) {
            if (self.data[i] == (u8)'\n') {
                i64 line_len = i - start;
                if (line_len > 0 && self.data[start + line_len - 1] == (u8)'\r') {
                    line_len = line_len - 1;
                }
                res.push(self.substr(start, line_len));
                start = i + 1;
            }
        }
        if (start < self.len) {
            i64 line_len = self.len - start;
            if (line_len > 0 && self.data[start + line_len - 1] == (u8)'\r') {
                line_len = line_len - 1;
            }
            res.push(self.substr(start, line_len));
        }
        return res;
    }

    Vec<String> words(&self) {
        Vec<String> res = Vec<String>.new();
        if (self.len == 0 || self.data == (u8*)0) {
            return res;
        }
        i64 i = 0;
        while (i < self.len) {
            while (i < self.len && (self.data[i] == (u8)' ' || self.data[i] == (u8)'\t' || self.data[i] == (u8)'\n' || self.data[i] == (u8)'\r')) {
                i = i + 1;
            }
            if (i >= self.len) {
                break;
            }
            i64 start = i;
            while (i < self.len && self.data[i] != (u8)' ' && self.data[i] != (u8)'\t' && self.data[i] != (u8)'\n' && self.data[i] != (u8)'\r') {
                i = i + 1;
            }
            res.push(self.substr(start, i - start));
        }
        return res;
    }
    Optional<[String, String]> split_once(&self, str delimiter) {
        i64 idx = self.find(delimiter);
        if (idx < 0) {
            return None;
        }
        i64 delim_len = strlen(delimiter);
        String first = self.substr(0, idx);
        String second = self.substr(idx + delim_len, self.len - (idx + delim_len));
        return Some([move first, move second]);
    }
    String strip_prefix(&self, str prefix) {
        if (self.starts_with(prefix)) {
            i64 plen = strlen(prefix);
            return self.substr(plen, self.len - plen);
        }
        return self.clone();
    }

    String strip_suffix(&self, str suffix) {
        if (self.ends_with(suffix)) {
            i64 slen = strlen(suffix);
            return self.substr(0, self.len - slen);
        }
        return self.clone();
    }

    String trim_start(&self) {
        i64 start = 0;
        while (start < self.len) {
            u8 ch = self.data[start];
            if (ch == (u8)' ' || ch == (u8)'\t' || ch == (u8)'\n' || ch == (u8)'\r') {
                start = start + 1;
            } else {
                break;
            }
        }
        return self.substr(start, self.len - start);
    }

    String trim_end(&self) {
        i64 end = self.len;
        while (end > 0) {
            u8 ch = self.data[end - 1];
            if (ch == (u8)' ' || ch == (u8)'\t' || ch == (u8)'\n' || ch == (u8)'\r') {
                end = end - 1;
            } else {
                break;
            }
        }
        return self.substr(0, end);
    }

    /// Read the entire file at `path` into a String.
    Result<String, Error> from_file(str path) {
        Result<i64, Error> r_open = try_open(path, O_RDONLY, 0);
        if (r_open.is_err()) {
            return Err(r_open.errno(), r_open.err_name());
        }
        i32 fd = (i32)r_open.value();
        String out = String.with_capacity(1024);
        u8 buf[4096];
        while (true) {
            Result<i64, Error> r_read = try_read(fd, &buf[0], 4096);
            if (r_read.is_err()) {
                try_close(fd);
                out.drop();
                return Err(r_read.errno(), r_read.err_name());
            }
            i64 n = r_read.value();
            if (n <= 0) {
                break;
            }
            out.push_bytes(&buf[0], n);
        }
        try_close(fd);
        return Ok(move out);
    }
}

impl Drop for String {
    void drop(*self) {
        if (self.data != (u8*)0) {
            free(self.data);
            self.data = (u8*)0;
        }
        self.len = 0;
        self.capacity = 0;
    }
}
impl IndexedAccess for String {
    type Item = u8;
    u8 __index_get(*self, i64 index) {
        if (@cfg(debug) && (index < 0 || index >= self.len)) { abort(); }
        return self.data[index];
    }
    void __index_set(*self, i64 index, u8 value) {
        if (@cfg(debug) && (index < 0 || index >= self.len)) { abort(); }
        self.data[index] = value;
    }
}

// String+String and String+str are overloads of the same `__add` name; the
// compiler resolves them by argument type (see codegen overload handling).
// Both take the by-value receiver as their first parameter.
impl Add<String> for String {
    String __add(self, String other) {
        i64 total = self.len + other.len;
        String result = String.with_capacity(total + 1); // +1 for NUL
        result.len = total;
        if (self.len > 0) {
            memcpy((void*)result.data, (const void*)self.data, self.len);
        }
        if (other.len > 0) {
            memcpy((void*)&result.data[self.len], (const void*)other.data, other.len);
        }
        if (total > 0) {
            result.data[total] = (u8)0;
        }
        // No null-outs: the by-value params are dropped at callee exit, which
        // frees their buffers exactly once (nulling them would leak).
        return result;
    }
}

// __add(String, str) for string-literal concatenation (same ABI note as above).
impl String {
    String __add(self, str other) {
        i64 other_len = strlen(other);
        i64 total = self.len + other_len;
        String result = String.with_capacity(total + 1); // +1 for NUL
        result.len = total;
        if (self.len > 0) {
            memcpy((void*)result.data, (const void*)self.data, self.len);
        }
        if (other_len > 0) {
            memcpy((void*)&result.data[self.len], (const void*)other, other_len);
        }
        if (total > 0) {
            result.data[total] = (u8)0;
        }
        // No null-outs: the by-value param is dropped at callee exit, which
        // frees its buffer exactly once (nulling it would leak).
        return result;
    }
}
impl Eq<String> for String {
    bool __eq(&self, &String other) {
        if (self.len != other.len) { return false; }
        if (self.len == 0) { return true; }
        return memcmp((const void*)self.data, (const void*)other.data, self.len) == 0;
    }
}

impl Ne<String> for String {
    bool __ne(&self, &String other) {
        return !self.__eq(other);
    }
}

impl String {
    bool __eq(&self, str other) {
        if (other == (str)0) { return self.len == 0; }
        i64 other_len = strlen(other);
        if (self.len != other_len) { return false; }
        if (self.len == 0) { return true; }
        return memcmp((const void*)self.data, (const void*)other, self.len) == 0;
    }

    bool __ne(&self, str other) {
        return !self.__eq(other);
    }
}

impl Compare for String {
    i32 compare(*self, String* other) {
        if (self == other) { return 0; }
        if (self.len == 0 && other.len == 0) { return 0; }
        if (self.len == 0) { return -1; }
        if (other.len == 0) { return 1; }
        i64 min_len = self.len;
        if (other.len < min_len) { min_len = other.len; }
        i32 cmp = memcmp((const void*)self.data, (const void*)other.data, min_len);
        if (cmp != 0) { return cmp; }
        if (self.len < other.len) { return -1; }
        if (self.len > other.len) { return 1; }
        return 0;
    }
}

impl Lt<String> for String {
    bool __lt(&self, &String other) {
        return self.compare(other) < 0;
    }
}

impl Gt<String> for String {
    bool __gt(&self, &String other) {
        return self.compare(other) > 0;
    }
}

impl Le<String> for String {
    bool __le(&self, &String other) {
        return self.compare(other) <= 0;
    }
}

impl Ge<String> for String {
    bool __ge(&self, &String other) {
        return self.compare(other) >= 0;
    }
}

struct SplitIter {
    u8* data;
    i64 len;
    i64 pos;
    str delim;
    i64 delim_len;
    bool done;
    i64 saved_end;
    u8 saved_byte;
    bool has_saved;
}

impl Iterator for SplitIter {
    type Item = str;
    Optional<str> next(*self) {
        if (self.data == (u8*)0) {
            if (!self.done && self.pos == 0) {
                self.done = true;
                return Some((str)"");
            }
            return None;
        }
        if (self.has_saved) {
            self.data[self.saved_end] = self.saved_byte;
            self.has_saved = false;
            self.pos = self.saved_end + self.delim_len;
        }
        if (self.done && self.pos >= self.len) {
            return None;
        }
        if (self.delim_len == 0 || self.delim == (str)0) {
            if (self.pos == 0 && !self.done) {
                self.done = true;
                self.saved_end = self.len;
                self.saved_byte = self.data[self.len];
                self.data[self.len] = (u8)0;
                self.has_saved = true;
                return Some((str)&self.data[0]);
            }
            return None;
        }
        i64 start = self.pos;
        i64 end = self.len;
        bool found = false;
        for (i64 i = start; i <= self.len - self.delim_len; i = i + 1) {
            if (memcmp((const void*)&self.data[i], (const void*)self.delim, self.delim_len) == 0) {
                end = i;
                found = true;
                break;
            }
        }
        if (!found) {
            self.done = true;
            end = self.len;
        }
        self.saved_end = end;
        self.saved_byte = self.data[end];
        self.data[end] = (u8)0;
        self.has_saved = true;
        return Some((str)&self.data[start]);
    }
}
impl Drop for SplitIter {
    void drop(*self) {
        if (self.has_saved && self.data != (u8*)0) {
            self.data[self.saved_end] = self.saved_byte;
            self.has_saved = false;
        }
    }
}

/// Iterator over String byte sequence (borrowed).
struct StringBytesIter {
    u8* data;
    i64 len;
    i64 idx;
}

impl Iterator for StringBytesIter {
    type Item = u8;
    Optional<u8> next(*self) {
        if (self.idx < self.len) {
            u8 v = self.data[self.idx];
            self.idx = self.idx + 1;
            return Some(v);
        }
        return None;
    }
}

/// Consuming iterator over String bytes (owns backing buffer).
struct StringIntoIter {
    u8* data;
    i64 len;
    i64 capacity;
    i64 idx;
}

impl Iterator for StringIntoIter {
    type Item = u8;
    Optional<u8> next(*self) {
        if (self.idx < self.len) {
            u8 v = self.data[self.idx];
            self.idx = self.idx + 1;
            return Some(v);
        }
        return None;
    }
}

impl Drop for StringIntoIter {
    void drop(*self) {
        if (self.data != (u8*)0) {
            free(self.data);
            self.data = (u8*)0;
        }
        self.len = 0;
        self.capacity = 0;
        self.idx = 0;
    }
}

impl IntoIterator for String {
    type Item = u8;
    type IntoIter = StringIntoIter;
    StringIntoIter into_iter(self) {
        StringIntoIter it;
        it.data = self.data;
        it.len = self.len;
        it.capacity = self.capacity;
        it.idx = 0;
        self.data = (u8*)0;
        self.len = 0;
        self.capacity = 0;
        return it;
    }
}

impl String {
    /// Return a borrowed iterator over the bytes of this string.
    StringBytesIter bytes(&self) {
        StringBytesIter it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        return it;
    }

    /// Return a borrowed iterator over the bytes of this string.
    StringBytesIter iter(&self) {
        return self.bytes();
    }
}

/// Parse an integer in decimal format with optional leading '-' or '+'.
Optional<i64> parse_i64(str s) {
    return parse_i64_radix(s, 10);
}

/// Parse an integer with given radix (2..36), with optional leading '-' or '+'.
Optional<i64> parse_i64_radix(str s, i64 radix) {
    if (s == (str)0 || radix < 2 || radix > 36) {
        return None;
    }
    u8* p = (u8*)s;
    i64 len = strlen(s);
    i64 i = 0;
    while (i < len && (p[i] == (u8)' ' || p[i] == (u8)'\t' || p[i] == (u8)'\n' || p[i] == (u8)'\r')) {
        i = i + 1;
    }
    if (i == len) {
        return None;
    }
    bool neg = false;
    if (p[i] == (u8)'-') {
        neg = true;
        i = i + 1;
    } else if (p[i] == (u8)'+') {
        i = i + 1;
    }
    if (i == len) {
        return None;
    }
    if (radix == 16 && i + 2 <= len && p[i] == (u8)'0' && (p[i + 1] == (u8)'x' || p[i + 1] == (u8)'X')) {
        i = i + 2;
    }
    if (radix == 2 && i + 2 <= len && p[i] == (u8)'0' && (p[i + 1] == (u8)'b' || p[i + 1] == (u8)'B')) {
        i = i + 2;
    }
    if (i == len) {
        return None;
    }
    i64 val = 0;
    i64 digits = 0;
    while (i < len) {
        u8 c = p[i];
        i64 digit = -1;
        if (c >= (u8)'0' && c <= (u8)'9') {
            digit = (i64)(c - (u8)'0');
        } else if (c >= (u8)'a' && c <= (u8)'z') {
            digit = (i64)(c - (u8)'a') + 10;
        } else if (c >= (u8)'A' && c <= (u8)'Z') {
            digit = (i64)(c - (u8)'A') + 10;
        } else if (c == (u8)' ' || c == (u8)'\t' || c == (u8)'\n' || c == (u8)'\r') {
            while (i < len && (p[i] == (u8)' ' || p[i] == (u8)'\t' || p[i] == (u8)'\n' || p[i] == (u8)'\r')) {
                i = i + 1;
            }
            if (i == len && digits > 0) {
                break;
            }
            return None;
        } else {
            return None;
        }
        if (digit < 0 || digit >= radix) {
            return None;
        }
        val = val * radix + digit;
        digits = digits + 1;
        i = i + 1;
    }
    if (digits == 0) {
        return None;
    }
    if (neg) {
        val = -val;
    }
    return Some(val);
}

/// Extract all signed integer values found in string `s` (e.g. "x=10, y=-25" -> [10, -25]).
Vec<i64> extract_ints(str s) {
    Vec<i64> result = Vec<i64>.new();
    if (s == (str)0) { return result; }
    u8* p = (u8*)s;
    i64 len = strlen(s);
    i64 i = 0;
    while (i < len) {
        if ((p[i] >= (u8)'0' && p[i] <= (u8)'9') || (p[i] == (u8)'-' && i + 1 < len && p[i + 1] >= (u8)'0' && p[i + 1] <= (u8)'9')) {
            bool neg = false;
            if (p[i] == (u8)'-') {
                neg = true;
                i = i + 1;
            }
            i64 val = 0;
            while (i < len && p[i] >= (u8)'0' && p[i] <= (u8)'9') {
                val = val * 10 + (i64)(p[i] - (u8)'0');
                i = i + 1;
            }
            if (neg) {
                val = -val;
            }
            result.push(val);
        } else {
            i = i + 1;
        }
    }
    return result;
}
/// Read the entire file at `path` into an owned String.
Result<String, Error> read_to_string(str path) {
    return String.from_file(path);
}

/// Read the entire file at `path` into lines.
Result<Vec<String>, Error> read_lines(str path) {
    Result<String, Error> r = String.from_file(path);
    if (r.is_err()) {
        return Err(r.unwrap_err());
    }
    String content = r.unwrap();
    Vec<String> res = content.lines();
    content.drop();
    return Ok(move res);
}
