import std.mem.alloc;
import std.mem.memory;
import std.ops;
import std.mem.drop;
import std.iter;
import std.optional;
import std.mem.vec;
// memcmp, strcmp, strlen, abort come from std.mem.memory
// (transitively via std.mem.alloc).

struct String {
    u8* data;
    i64 len;
    i64 capacity;
}

impl String {
    String new() {
        return String.with_capacity(16);
    }

    String with_capacity(i64 capacity) {
        String s;
        s.len = 0;
        s.capacity = capacity;
        if (capacity > 0) {
            s.data = alloc<u8>(capacity);
            s.data[0] = (u8)0;
        } else {
            s.data = (u8*)0;
        }
        return s;
    }

    i64 len(&String self) {
        return self.len;
    }

    i64 capacity(&String self) {
        return self.capacity;
    }

    void clear(&mut String self) {
        self.len = 0;
        if (self.data != (u8*)0) {
            self.data[0] = (u8)0;
        }
    }

    void push(&mut String self, u8 ch) {
        // Need space for the character plus the null terminator
        if (self.len + 2 > self.capacity) {
            i64 new_cap = self.capacity * 2;
            if (new_cap < 16) {
                new_cap = 16;
            }
            self.data = realloc<u8>(self.data, new_cap);
            self.capacity = new_cap;
        }
        self.data[self.len] = ch;
        self.len = self.len + 1;
        self.data[self.len] = (u8)0;
    }

    /// Append `len` raw bytes from `bytes` with a single bulk copy.
    #[inline(always)]
    void push_bytes(&mut String self, u8* bytes, i64 len) {
        if (len <= 0 || bytes == (u8*)0) { return; }
        if (self.len + len + 1 > self.capacity) {
            i64 new_cap = self.capacity * 2;
            if (new_cap < 16) { new_cap = 16; }
            while (new_cap < self.len + len + 1) { new_cap = new_cap * 2; }
            self.data = realloc<u8>(self.data, new_cap);
            self.capacity = new_cap;
        }
        silver_rt_memcpy(&self.data[self.len], bytes, len);
        self.len = self.len + len;
        self.data[self.len] = (u8)0;
    }

    void push_str(&mut String self, str text) {
        if (text == (str)0) {
            return;
        }
        i64 text_len = strlen(text);
        if (text_len == 0) {
            return;
        }
        if (self.len + text_len + 1 > self.capacity) {
            i64 new_cap = self.capacity * 2;
            if (new_cap < self.len + text_len + 16) {
                new_cap = self.len + text_len + 16;
            }
            self.data = realloc<u8>(self.data, new_cap);
            self.capacity = new_cap;
        }
        memcpy((void*)&self.data[self.len], (const void*)text, text_len);
        self.len = self.len + text_len;
        self.data[self.len] = (u8)0;
    }

    // Clone borrows self by shared reference, creates a deep copy, and returns it.
    // The caller retains ownership of the original string.
    String clone(&String self) {
        String s = String.with_capacity(self.capacity);
        s.len = self.len;
        if (self.len > 0) {
            memcpy((void*)s.data, (const void*)self.data, self.len);
            s.data[s.len] = (u8)0;
        }
        return s;
    }

    bool equals(&String self, str other) {
        if (other == (str)0) {
            return false;
        }
        if (self.data == (u8*)0) {
            return strlen(other) == 0;
        }
        return strcmp((const char*)self.data, other) == 0;
    }

    const char* to_str(&String self) {
        if (self.data == (u8*)0) {
            return "";
        }
        return (const char*)self.data;
    }

    String from_str(str s) {
        String out = String.with_capacity(strlen(s));
        out.push_str(s);
        return out;
    }

    /// Borrow the contents as a NUL-terminated str view. The view is valid
    /// while the original String still owns its buffer (the same lifetime as
    /// accessing `.data` directly). Cast receivers are borrowed views: the
    /// compiler does not run the by-value `self` copy's destructor, so the
    /// String keeps ownership and no explicit hand-off is needed.
    cast str(String self) {
        return (str)self.data;
    }

    String trim(&String self) {
        i64 start = 0;
        i64 end = self.len;
        while (start < self.len) {
            u8 ch = self.data[start];
            if (ch != (u8)32 && ch != (u8)9 && ch != (u8)10 && ch != (u8)13) {
                break;
            }
            start = start + 1;
        }
        while (end > start) {
            u8 ch = self.data[end - 1];
            if (ch != (u8)32 && ch != (u8)9 && ch != (u8)10 && ch != (u8)13) {
                break;
            }
            end = end - 1;
        }
        i64 new_len = end - start;
        String result = String.with_capacity(new_len);
        result.len = new_len;
        if (new_len > 0) {
            memcpy((void*)result.data, (const void*)&self.data[start], new_len);
            result.data[new_len] = (u8)0;
        }
        return result;
    }

    bool starts_with(&String self, str prefix) {
        if (prefix == (str)0) {
            return false;
        }
        i64 prefix_len = strlen(prefix);
        if (prefix_len == 0) {
            return true;
        }
        if (self.len < prefix_len) {
            return false;
        }
        return memcmp((const void*)self.data, (const void*)prefix, prefix_len) == 0;
    }

    bool ends_with(&String self, str suffix) {
        if (suffix == (str)0) {
            return false;
        }
        i64 suffix_len = strlen(suffix);
        if (suffix_len == 0) {
            return true;
        }
        if (self.len < suffix_len) {
            return false;
        }
        return memcmp((const void*)&self.data[self.len - suffix_len], (const void*)suffix, suffix_len) == 0;
    }

    bool contains(&String self, str needle) {
        if (needle == (str)0) {
            return false;
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return true;
        }
        if (self.len < needle_len) {
            return false;
        }
        if (needle_len == 1) {
            // Single byte: SSE2 memchr scan instead of per-position memcmp.
            u8* n = (u8*)needle;
            u8 first = n[0];
            return memchr(&self.data[0], first, self.len) >= 0;
        }
        for (i64 i = 0; i <= self.len - needle_len; i = i + 1) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                return true;
            }
        }
        return false;
    }

    i64 find(&String self, str needle) {
        if (needle == (str)0) {
            return -1;
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return 0;
        }
        if (self.len < needle_len) {
            return -1;
        }
        if (needle_len == 1) {
            // Single byte: SSE2 memchr scan instead of per-position memcmp.
            u8* n = (u8*)needle;
            u8 first = n[0];
            return memchr(&self.data[0], first, self.len);
        }
        for (i64 i = 0; i <= self.len - needle_len; i = i + 1) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                return i;
            }
        }
        return -1;
    }

    String substr(&String self, i64 start, i64 len) {
        if (start < 0) {
            start = 0;
        }
        if (start >= self.len) {
            return String.new();
        }
        if (len <= 0) {
            return String.new();
        }
        if (start + len > self.len) {
            len = self.len - start;
        }
        String result = String.with_capacity(len);
        result.len = len;
        if (len > 0) {
            memcpy((void*)result.data, (const void*)&self.data[start], len);
            result.data[len] = (u8)0;
        }
        return result;
    }

    SplitIter split(&String self, str delimiter) {
        SplitIter it;
        it.data = self.data;
        it.len = self.len;
        it.pos = 0;
        it.delim = delimiter;
        it.delim_len = strlen(delimiter);
        it.done = false;
        it.has_saved = false;
        it.saved_byte = (u8)0;
        it.saved_end = 0;
        return it;
    }

    String join(str delimiter, Vec<String>* strings) {
        i64 delim_len = strlen(delimiter);
        i64 total = 0;
        for (i64 i = 0; i < strings.len(); i = i + 1) {
            String* s = strings.get_ptr(i);
            total = total + s.len;
        }
        if (strings.len() > 1) {
            total = total + delim_len * (strings.len() - 1);
        }
        String result = String.with_capacity(total);
        result.len = total;
        i64 pos = 0;
        for (i64 i = 0; i < strings.len(); i = i + 1) {
            String* s = strings.get_ptr(i);
            if (s.len > 0) {
                memcpy((void*)&result.data[pos], (const void*)s.data, s.len);
                pos = pos + s.len;
            }
            if (i < strings.len() - 1 && delim_len > 0) {
                memcpy((void*)&result.data[pos], (const void*)delimiter, delim_len);
                pos = pos + delim_len;
            }
        }
        if (total > 0) {
            result.data[total] = (u8)0;
        }
        return result;
    }

    String replace(&String self, str needle, str replacement) {
        if (needle == (str)0 || self.len == 0) {
            return self.clone();
        }
        i64 needle_len = strlen(needle);
        if (needle_len == 0) {
            return self.clone();
        }
        i64 repl_len = 0;
        if (replacement != (str)0) {
            repl_len = strlen(replacement);
        }
        // First pass: count non-overlapping occurrences.
        i64 count = 0;
        i64 i = 0;
        while (i <= self.len - needle_len) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, needle_len) == 0) {
                count = count + 1;
                i = i + needle_len;
            } else {
                i = i + 1;
            }
        }
        if (count == 0) {
            return self.clone();
        }
        // Second pass: build the result.
        i64 new_len = self.len - count * needle_len + count * repl_len;
        String result = String.with_capacity(new_len);
        result.len = new_len;
        i64 src = 0;
        i64 dst = 0;
        while (src < self.len) {
            if (src <= self.len - needle_len
                && memcmp((const void*)&self.data[src], (const void*)needle, needle_len) == 0) {
                if (repl_len > 0) {
                    memcpy((void*)&result.data[dst], (const void*)replacement, repl_len);
                    dst = dst + repl_len;
                }
                src = src + needle_len;
            } else {
                result.data[dst] = self.data[src];
                src = src + 1;
                dst = dst + 1;
            }
        }
        if (new_len > 0) {
            result.data[new_len] = (u8)0;
        }
        return result;
    }
    i64 byte_len(&String self) {
        return self.len;
    }

    bool is_valid_utf8(&String self) {
        if (self.data == (u8*)0) { return false; }
        i64 i = 0;
        while (i < self.len) {
            u8 b = self.data[i];
            if (b < (u8)0x80) {
                // 1-byte sequence: 0xxxxxxx
                i = i + 1;
            } else if (b < (u8)0xE0) {
                // 2-byte sequence: 110xxxxx 10xxxxxx
                if (i + 1 >= self.len) { return false; }
                u8 b2 = self.data[i + 1];
                if (b < (u8)0xC2) { return false; }
                if ((b2 & (u8)0xC0) != (u8)0x80) { return false; }
                i = i + 2;
            } else if (b < (u8)0xF0) {
                // 3-byte sequence: 1110xxxx 10xxxxxx 10xxxxxx
                if (i + 2 >= self.len) { return false; }
                u8 b2 = self.data[i + 1];
                u8 b3 = self.data[i + 2];
                if ((b2 & (u8)0xC0) != (u8)0x80) { return false; }
                if ((b3 & (u8)0xC0) != (u8)0x80) { return false; }
                // Reject overlong (E0 80..9F)
                if (b == (u8)0xE0 && b2 < (u8)0xA0) { return false; }
                // Reject surrogates (ED A0..BF)
                if (b == (u8)0xED && b2 >= (u8)0xA0) { return false; }
                i = i + 3;
            } else if (b < (u8)0xF8) {
                // 4-byte sequence: 11110xxx 10xxxxxx 10xxxxxx 10xxxxxx
                if (i + 3 >= self.len) { return false; }
                u8 b2 = self.data[i + 1];
                u8 b3 = self.data[i + 2];
                u8 b4 = self.data[i + 3];
                if ((b2 & (u8)0xC0) != (u8)0x80) { return false; }
                if ((b3 & (u8)0xC0) != (u8)0x80) { return false; }
                if ((b4 & (u8)0xC0) != (u8)0x80) { return false; }
                // Reject overlong (F0 80..8F)
                if (b == (u8)0xF0 && b2 < (u8)0x90) { return false; }
                // Reject > U+10FFFF (F4 90+ or F5+)
                if (b == (u8)0xF4 && b2 >= (u8)0x90) { return false; }
                if (b >= (u8)0xF5) { return false; }
                i = i + 4;
            } else {
                // 0xF8..0xFF: invalid lead byte
                return false;
            }
        }
        return true;
    }

    i64 char_len(&String self) {
        if (self.data == (u8*)0) { return 0; }
        i64 count = 0;
        i64 i = 0;
        while (i < self.len) {
            count = count + 1;
            u8 b = self.data[i];
            if (b < (u8)0x80) {
                i = i + 1;
            } else if (b < (u8)0xE0) {
                i = i + 2;
            } else if (b < (u8)0xF0) {
                i = i + 3;
            } else {
                i = i + 4;
            }
        }
        return count;
    }

    bool push_codepoint(&mut String self, u32 cp) {
        // Reject surrogates and out-of-range values
        if (cp >= (u32)0xD800 && cp <= (u32)0xDFFF) { return false; }
        if (cp > (u32)0x10FFFF) { return false; }
        if (cp < (u32)0x80) {
            self.push((u8)cp);
        } else if (cp < (u32)0x800) {
            self.push((u8)((u32)0xC0 | (cp >> (u32)6)));
            self.push((u8)((u32)0x80 | (cp & (u32)0x3F)));
        } else if (cp < (u32)0x10000) {
            self.push((u8)((u32)0xE0 | (cp >> (u32)12)));
            self.push((u8)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
            self.push((u8)((u32)0x80 | (cp & (u32)0x3F)));
        } else {
            self.push((u8)((u32)0xF0 | (cp >> (u32)18)));
            self.push((u8)((u32)0x80 | ((cp >> (u32)12) & (u32)0x3F)));
            self.push((u8)((u32)0x80 | ((cp >> (u32)6) & (u32)0x3F)));
            self.push((u8)((u32)0x80 | (cp & (u32)0x3F)));
        }
        return true;
    }
}

impl Drop<String> for String {
    void drop(String* self) {
        if (self.data != (u8*)0) {
            free(self.data);
            self.data = (u8*)0;
        }
        self.len = 0;
        self.capacity = 0;
    }
}
impl IndexedAccess<String> for String {
    type Item = u8;
    u8 __index_get(String* self, i64 index) {
        if (@cfg(debug) && (index < 0 || index >= self.len)) { abort(); }
        return self.data[index];
    }
    void __index_set(String* self, i64 index, u8 value) {
        if (@cfg(debug) && (index < 0 || index >= self.len)) { abort(); }
        self.data[index] = value;
    }
}

// String+String and String+str are overloads of the same `__add` name; the
// compiler resolves them by argument type (see codegen overload handling).
// Both take the by-value receiver as their first parameter.
impl Add<String, String> for String {
    String __add(String self, String other) {
        i64 total = self.len + other.len;
        String result = String.with_capacity(total);
        result.len = total;
        if (self.len > 0) {
            memcpy((void*)result.data, (const void*)self.data, self.len);
        }
        if (other.len > 0) {
            memcpy((void*)&result.data[self.len], (const void*)other.data, other.len);
        }
        if (total > 0) {
            result.data[total] = (u8)0;
        }
        self.data = (u8*)0;
        self.len = 0;
        self.capacity = 0;
        other.data = (u8*)0;
        other.len = 0;
        other.capacity = 0;
        return result;
    }
}

// __add(String, str) for string-literal concatenation (same ABI note as above).
impl String {
    String __add(String self, str other) {
        i64 other_len = strlen(other);
        i64 total = self.len + other_len;
        String result = String.with_capacity(total);
        result.len = total;
        if (self.len > 0) {
            memcpy((void*)result.data, (const void*)self.data, self.len);
        }
        if (other_len > 0) {
            memcpy((void*)&result.data[self.len], (const void*)other, other_len);
        }
        if (total > 0) {
            result.data[total] = (u8)0;
        }
        self.data = (u8*)0;
        self.len = 0;
        self.capacity = 0;
        return result;
    }
}

struct SplitIter {
    u8* data;
    i64 len;
    i64 pos;
    str delim;
    i64 delim_len;
    bool done;
    i64 saved_end;
    u8 saved_byte;
    bool has_saved;
}

impl Iterator<SplitIter> for SplitIter {
    type Item = str;
    Optional<str> next(SplitIter* self) {
        if (self.data == (u8*)0) {
            if (!self.done && self.pos == 0) {
                self.done = true;
                return Optional<str>.some((str)"");
            }
            return Optional<str>.none();
        }
        if (self.has_saved) {
            self.data[self.saved_end] = self.saved_byte;
            self.has_saved = false;
            self.pos = self.saved_end + self.delim_len;
        }
        if (self.done && self.pos >= self.len) {
            return Optional<str>.none();
        }
        if (self.delim_len == 0 || self.delim == (str)0) {
            if (self.pos == 0 && !self.done) {
                self.done = true;
                self.saved_end = self.len;
                self.saved_byte = self.data[self.len];
                self.data[self.len] = (u8)0;
                self.has_saved = true;
                return Optional<str>.some((str)&self.data[0]);
            }
            return Optional<str>.none();
        }
        i64 start = self.pos;
        i64 end = self.len;
        bool found = false;
        for (i64 i = start; i <= self.len - self.delim_len; i = i + 1) {
            if (memcmp((const void*)&self.data[i], (const void*)self.delim, self.delim_len) == 0) {
                end = i;
                found = true;
                break;
            }
        }
        if (!found) {
            self.done = true;
            end = self.len;
        }
        self.saved_end = end;
        self.saved_byte = self.data[end];
        self.data[end] = (u8)0;
        self.has_saved = true;
        return Optional<str>.some((str)&self.data[start]);
    }
}
