// Optional<T> — payload-enum value-or-absence container.
//
// Aborts the process (with a message on stderr) when a value is extracted
// from the wrong variant: `unwrap()` on a none value.  Use
// `is_some`/`is_none` to test first, or `unwrap_or` for a non-aborting
// fallback.
import std.io.file;

/// Terminates the process with SIGABRT, like C `abort()`.
// Uses the pure-Silver abort() from std.mem.memory (transitively via std.io).
void __optional_abort() {
    abort();
    while (true) {}
}

// Optional<T> — None carries no value, Some(T) carries a value.
// NOTE: None is declared first so its discriminant is 0, matching the
// for-in lowering which treats a zero tag as the end of iteration.
enum Optional<T> {
    None;
    Some(T);
}

impl Optional<T> {
    /// Construct a present value.
    Optional<T> some(T thing) {
        // The by-value param owns `thing`; hand it to the enum so the
        // payload is single-owner (a bare copy would double-own).
        return Optional.Some(move thing);
    }

    /// Construct an absent value.
    Optional<T> none() {
        return Optional.None;
    }

    bool is_some(Optional<T> self) {
        return match self { Some(v) : true, None : false };
    }

    bool is_none(Optional<T> self) {
        return match self { Some(v) : false, None : true };
    }

    /// Extract the contained value.  Aborts if the optional is none.
    T unwrap(Optional<T> self) {
        if (self.is_some()) {
            T dummy;
            return match self { Some(v) : v, None : dummy };
        }
        STDERR.write_str("Optional::unwrap: called on a none value\n");
        __optional_abort();
        // unreachable - dummy return to satisfy return type
        T dummy;
        return dummy;
    }

    T unwrap_or(Optional<T> self, T fallback) {
        return match self { Some(v) : v, None : fallback };
    }
}
