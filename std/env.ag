// std/env.ag — environment variables, arguments, and process working directory.

import std.io.file;
import std.mem.alloc;
import std.mem.memory;
import std.mem.vec;
import std.optional;
import std.string;
import std.sys.entry;
import std.sys.raw.fs;

/// Look up environment variable `key`. Returns Some(value) if set, None otherwise.
Optional<String> var(str key) {
    if (key == (str)0) {
        return Optional<String>.none();
    }
    i64 key_len = strlen(key);
    if (key_len == 0) {
        return Optional<String>.none();
    }

    i8** env = silver_envp();
    if (env == (i8**)0) {
        return Optional<String>.none();
    }

    i64 i = 0;
    while (env[i] != (i8*)0) {
        str entry_str = (str)env[i];
        i64 entry_len = strlen(entry_str);
        if (entry_len > key_len && entry_str[key_len] == 61) { // '=' is ASCII 61
            if (memcmp((const void*)entry_str, (const void*)key, key_len) == 0) {
                str val_ptr = (str)((i64)entry_str + key_len + 1);
                String val = String.from_str(val_ptr);
                return Optional<String>.some(move val);
            }
        }
        i = i + 1;
    }
    return Optional<String>.none();
}

i8** g_dynamic_envp = (i8**)0;
i64 g_dynamic_env_cap = 0;
i64 g_dynamic_env_len = 0;

/// Set environment variable `key` to `val`. Creates or updates the variable.
void set_var(str key, str val) {
    if (key == (str)0 || val == (str)0) {
        return;
    }
    i64 key_len = strlen(key);
    if (key_len == 0) {
        return;
    }
    i64 val_len = strlen(val);

    i64 entry_len = key_len + 1 + val_len;
    u8* entry_buf = alloc<u8>(entry_len + 1);
    memcpy((void*)entry_buf, (const void*)key, key_len);
    entry_buf[key_len] = (u8)'=';
    if (val_len > 0) {
        memcpy((void*)&entry_buf[key_len + 1], (const void*)val, val_len);
    }
    entry_buf[entry_len] = (u8)0;

    i8** env = silver_envp();
    if (g_dynamic_envp == (i8**)0) {
        i64 count = 0;
        if (env != (i8**)0) {
            while (env[count] != (i8*)0) {
                count = count + 1;
            }
        }
        g_dynamic_env_cap = count + 32;
        g_dynamic_envp = (i8**)alloc<i64>(g_dynamic_env_cap);
        for (i64 i = 0; i < count; i = i + 1) {
            g_dynamic_envp[i] = env[i];
        }
        g_dynamic_envp[count] = (i8*)0;
        g_dynamic_env_len = count;
        __silver_envp = g_dynamic_envp;
        env = g_dynamic_envp;
    }

    for (i64 i = 0; i < g_dynamic_env_len; i = i + 1) {
        str cur = (str)env[i];
        i64 cur_len = strlen(cur);
        if (cur_len > key_len && cur[key_len] == 61) {
            if (memcmp((const void*)cur, (const void*)key, key_len) == 0) {
                env[i] = (i8*)entry_buf;
                return;
            }
        }
    }

    if (g_dynamic_env_len + 2 > g_dynamic_env_cap) {
        g_dynamic_env_cap = g_dynamic_env_cap * 2;
        g_dynamic_envp = (i8**)realloc<i64>((i64*)g_dynamic_envp, g_dynamic_env_cap);
        __silver_envp = g_dynamic_envp;
        env = g_dynamic_envp;
    }
    env[g_dynamic_env_len] = (i8*)entry_buf;
    g_dynamic_env_len = g_dynamic_env_len + 1;
    env[g_dynamic_env_len] = (i8*)0;
}

/// Remove environment variable `key`.
void remove_var(str key) {
    if (key == (str)0) {
        return;
    }
    i64 key_len = strlen(key);
    if (key_len == 0) {
        return;
    }
    i8** env = silver_envp();
    if (env == (i8**)0) {
        return;
    }
    for (i64 i = 0; env[i] != (i8*)0; i = i + 1) {
        str cur = (str)env[i];
        i64 cur_len = strlen(cur);
        if (cur_len > key_len && cur[key_len] == 61) {
            if (memcmp((const void*)cur, (const void*)key, key_len) == 0) {
                i64 j = i;
                while (env[j] != (i8*)0) {
                    env[j] = env[j + 1];
                    j = j + 1;
                }
                if (g_dynamic_env_len > 0) {
                    g_dynamic_env_len = g_dynamic_env_len - 1;
                }
                return;
            }
        }
    }
}

/// Returns the current working directory, or an empty string on error.
String current_dir() {
    i64 cap = 1024;
    u8* buf = alloc<u8>(cap);
    while (true) {
        i64 r = sys_getcwd((i64)buf, cap);
        if (r > 0) {
            String s = String.from_str((str)buf);
            free((void*)buf);
            return move s;
        }
        if (r == -34) { // ERANGE: buffer too small
            free((void*)buf);
            cap = cap * 2;
            buf = alloc<u8>(cap);
            continue;
        }
        break;
    }
    free((void*)buf);
    return String.new();
}

/// Change the current working directory to `path`. Returns true on success.
bool set_current_dir(str path) {
    if (path == (str)0) {
        return false;
    }
    i64 r = sys_chdir((i64)path);
    return r == 0;
}

/// Returns command-line arguments passed to the program as a Vec<String>.
Vec<String> args() {
    i32 argc = silver_argc();
    i8** argv = silver_argv();
    Vec<String> res = Vec<String>.with_capacity((i64)argc);
    if (argv == (i8**)0) {
        return move res;
    }

    i64 i = 0;
    while (i < (i64)argc) {
        if (argv[i] != (i8*)0) {
            String arg_str = String.from_str((str)argv[i]);
            res.push(move arg_str);
        }
        i = i + 1;
    }
    return move res;
}
