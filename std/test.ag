// std/test.ag — test harness using print macros.
//
// Provides shared counters (tests_passed/tests_failed), a full assertion
// suite using compiler-builtin print macros, and per-case wall-clock timers:
// done() prints a timing table (monotonic microseconds per test_start case
// plus the total), so tests report where their time actually goes — loopback
// cases are sub-millisecond, so microsecond resolution matters.

import std.mem.memory;
import std.io.file;
import std.time;

i32 tests_passed = 0;
i32 tests_failed = 0;

const i64 TEST_MAX_CASES = 256;

struct TestCaseTiming {
    u8 name[64];
    i64 elapsed_us;
}

TestCaseTiming g_case_times[256]; // TEST_MAX_CASES
i64 g_case_count = 0;
Instant g_case_start;
bool g_case_open = false;

/// Print a section header and start the case timer.
void test_start(str name) {
    // Close the previous case's timer.
    if (g_case_open && g_case_count > 0) {
        Instant end = now();
        g_case_times[g_case_count - 1].elapsed_us = end.elapsed_ns(g_case_start) / 1000;
    }
    g_case_start = now();
    g_case_open = true;
    if (g_case_count < TEST_MAX_CASES) {
        u8* src = (u8*)name;
        i64 i = 0;
        while (i < 63 && src[i] != (u8)0) {
            g_case_times[g_case_count].name[i] = src[i];
            i = i + 1;
        }
        g_case_times[g_case_count].name[i] = (u8)0;
        g_case_times[g_case_count].elapsed_us = -1;
        g_case_count = g_case_count + 1;
    }
    @println("\n--- {} ---", name);
}

/// Close the open case timer (called by done and the next test_start).
void test_close_case() {
    if (g_case_open && g_case_count > 0) {
        Instant end = now();
        g_case_times[g_case_count - 1].elapsed_us = end.elapsed_ns(g_case_start) / 1000;
        g_case_open = false;
    }
}

// The assertion helpers below are fail-fast: the check runs through the
// language `@assert` macro, so a failed check aborts immediately with an
// "assertion failed at <file>:<line>: <msg>" report on stderr. In release
// builds (@assert pruned) the helpers still record a pass for bookkeeping.
// A scratch buffer carries the expected/got detail into the abort message.
u8 g_assert_scratch[256];

/// "<msg> (expected <e>, got <a>)" in the scratch buffer.
str assert_values(str msg, i64 expected, i64 actual) {
    u8* out = &g_assert_scratch[0];
    i64 n = 0;
    if (msg != (str)0) {
        u8* m = (u8*)msg;
        i64 i = 0;
        while (m[i] != (u8)0 && n < 200) { out[n] = m[i]; n = n + 1; i = i + 1; }
    }
    str suffix = " (expected ";
    u8* s = (u8*)suffix;
    i64 i = 0;
    while (s[i] != (u8)0 && n < 240) { out[n] = s[i]; n = n + 1; i = i + 1; }
    u8 digits[24];
    i64 nd = 0;
    i64 v = expected;
    if (v < 0) { out[n] = (u8)'-'; n = n + 1; v = 0 - v; }
    if (v == 0) { digits[0] = (u8)'0'; nd = 1; }
    while (v > 0 && nd < 23) { digits[nd] = (u8)((u8)'0' + (u8)(v % 10)); nd = nd + 1; v = v / 10; }
    while (nd > 0 && n < 240) { nd = nd - 1; out[n] = digits[nd]; n = n + 1; }
    str mid = ", got ";
    s = (u8*)mid;
    i = 0;
    while (s[i] != (u8)0 && n < 240) { out[n] = s[i]; n = n + 1; i = i + 1; }
    nd = 0;
    v = actual;
    if (v < 0) { out[n] = (u8)'-'; n = n + 1; v = 0 - v; }
    if (v == 0) { digits[0] = (u8)'0'; nd = 1; }
    while (v > 0 && nd < 23) { digits[nd] = (u8)((u8)'0' + (u8)(v % 10)); nd = nd + 1; v = v / 10; }
    while (nd > 0 && n < 240) { nd = nd - 1; out[n] = digits[nd]; n = n + 1; }
    if (n < 240) { out[n] = (u8)')'; n = n + 1; }
    out[n] = (u8)0;
    return (str)&g_assert_scratch[0];
}

/// Simple pass/fail check (no value comparison). Fail-fast via @assert.
void check(bool cond, str msg) {
    @assert(cond, msg);
    @println("  [PASS] {}", msg);
    tests_passed += 1;
}

/// Check a boolean condition is false. Fail-fast via @assert.
void assert_false(bool cond, str msg) {
    @assert(!cond, msg);
    @println("  [PASS] {}", msg);
    tests_passed += 1;
}

/// Check a boolean condition. Fail-fast via @assert.
void assert_true(bool cond, str msg) {
    @assert(cond, msg);
    @println("  [PASS] {}", msg);
    tests_passed += 1;
}

/// Check i64 equality. Fail-fast via @assert; the abort message carries the
/// expected and actual values.
void assert_eq_i64(i64 expected, i64 actual, str msg) {
    @assert(expected == actual, assert_values(msg, expected, actual));
    @println("  [PASS] {}", msg);
    tests_passed += 1;
}

/// Check i32 equality. Fail-fast via @assert.
void assert_eq_i32(i32 expected, i32 actual, str msg) {
    assert_eq_i64((i64)expected, (i64)actual, msg);
}

/// Check string equality. Fail-fast via @assert.
void assert_eq_str(str expected, str actual, str msg) {
    @assert(strcmp(expected, actual) == 0, msg);
    @println("  [PASS] {}", msg);
    tests_passed += 1;
}

/// Print summary and return failure count (for main() to return).
i32 done() {
    test_close_case();
    @println("\n=== Results ===");
    @println("Passed: {}, Failed: {}", tests_passed, tests_failed);
    i64 total_us = 0;
    i64 i = 0;
    while (i < g_case_count) {
        if (g_case_times[i].elapsed_us >= 0) {
            total_us = total_us + g_case_times[i].elapsed_us;
        }
        i = i + 1;
    }
    @println("\n=== Timings (microseconds) ===");
    i = 0;
    while (i < g_case_count) {
        @println("  {}: {} us", (str)&g_case_times[i].name[0], g_case_times[i].elapsed_us);
        i = i + 1;
    }
    @println("  TOTAL: {} us", total_us);
    return tests_failed;
}
