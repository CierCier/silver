// Result<T, E> — payload-enum success-or-error container.
//
// Ok(T) carries a success value, Err(E) carries an error.  Aborts the
// process (with a message on stderr) when a value is extracted from the
// wrong variant: `unwrap()` on an err value and `get_error()` on an ok
// value.  Use `success`/`failed` to test first, or `unwrap_or` for a
// non-aborting fallback.
import std.display;
import std.io.file;

/// Terminates the process with SIGABRT, like C `abort()`.
/// Internal helper for `Result.unwrap`; not part of the public API.
void __result_abort() {
    abort();
}

/// The outcome of a fallible operation: `Ok(T)` on success or `Err(E)` on
/// failure. Extracting the wrong variant (`unwrap` on `Err`, `unwrap_err` on
/// `Ok`) prints to stderr and aborts the process.
enum Result<T, E> {
    Ok(T);
    Err(E);
}

impl Result<T, E> {
    /// Wraps a success value.
    Result<T, E> ok(T value) {
        return Result.Ok(move value);
    }

    /// Wraps an error value.
    Result<T, E> err(E error) {
        return Result.Err(move error);
    }

    /// Returns true for `Ok`. Does not consume the result.
    bool is_ok(&self) {
        return match *self { Ok(v) : true, Err(e) : false };
    }

    /// Returns true for `Err`. Does not consume the result.
    bool is_err(&self) {
        return match *self { Ok(v) : false, Err(e) : true };
    }

    /// Same as `is_ok`.
    bool success(&self) {
        return self.is_ok();
    }

    /// Same as `is_err`.
    bool failed(&self) {
        return self.is_err();
    }

    /// Extract the success value, transferring ownership out of the
    /// result (move-out binding). Aborts if the result is an error.
    T unwrap(self) {
        match self {
            Ok(move v) : {
                return move v;
            },
            Err(e) : {
                STDERR.write_str("Result::unwrap: called on an err value\n");
                __result_abort();
            }
        }
    }

    /// Consumes the result and returns its value, or `fallback` on `Err`. The
    /// error payload is dropped. `fallback` is evaluated even on `Ok`.
    T unwrap_or(self, T fallback) {
        return match self { Ok(move v) : v, Err(e) : fallback };
    }

    /// Consume this result, transforming only its success payload.
    Result<U, E> map<U>(self, U(T) transform) {
        return match self {
            Ok(move value) : Ok(transform(move value)),
            Err(move error) : Err(move error)
        };
    }

    /// Consume this result, transforming only its error payload.
    Result<T, F> map_err<F>(self, F(E) transform) {
        return match self {
            Ok(move value) : Ok(move value),
            Err(move error) : Err(transform(move error))
        };
    }

    /// Consume this result and run the next fallible operation on success.
    Result<U, E> and_then<U>(self, Result<U, E>(T) next) {
        return match self {
            Ok(move value) : next(move value),
            Err(move error) : Err(move error)
        };
    }

    /// Extract the error value, transferring ownership out of the result.
    /// Aborts if the result is ok.
    E unwrap_err(self) {
        match self {
            Ok(v) : {
                STDERR.write_str("Result::unwrap_err: called on an ok value\n");
                __result_abort();
            },
            Err(move e) : {
                return move e;
            }
        }
    }

    /// Same as `unwrap_err`: consumes the result and aborts when it is `Ok`.
    E get_error(self) {
        return self.unwrap_err();
    }
}

/// Debug-style formatting: `Ok(v)` / `Err(e)`. Payload bindings are borrows
/// (see the Optional impl): Drop-typed payloads stay owned by the original.
impl<T, E> Display for Result<T, E> {
    void fmt(*self, BufWriter* out) {
        match *self {
            Ok(v) : @fprint(out, "Ok({})", v),
            Err(e) : @fprint(out, "Err({})", e),
        };
    }
}
