// Result<T, E> — payload-enum success-or-error container.
//
// Ok(T) carries a success value, Err(E) carries an error.  Aborts the
// process (with a message on stderr) when a value is extracted from the
// wrong variant: `unwrap()` on an err value and `get_error()` on an ok
// value.  Use `success`/`failed` to test first, or `unwrap_or` for a
// non-aborting fallback.
import std.io.file;

/// Terminates the process with SIGABRT, like C `abort()`.
void __result_abort() {
    abort();
    while (true) {}
}

enum Result<T, E> {
    Ok(T);
    Err(E);
}

impl Result<T, E> {
    Result<T, E> ok(T value) {
        return Result.Ok(value);
    }

    Result<T, E> err(E error) {
        return Result.Err(error);
    }

    bool success(Result<T, E> self) {
        return match self { Ok(v) : true, Err(e) : false };
    }

    bool failed(Result<T, E> self) {
        return match self { Ok(v) : false, Err(e) : true };
    }

    /// Extract the success value.  Aborts if the result is an error.
    T unwrap(Result<T, E> self) {
        if (self.success()) {
            T dummy;
            return match self { Ok(v) : v, Err(e) : dummy };
        }
        STDERR.write_str("Result::unwrap: called on an err value\n");
        __result_abort();
        // unreachable - dummy return to satisfy return type
        T dummy;
        return dummy;
    }

    T unwrap_or(Result<T, E> self, T fallback) {
        return match self { Ok(v) : v, Err(e) : fallback };
    }

    /// Extract the error value.  Aborts if the result is ok.
    E get_error(Result<T, E> self) {
        if (self.failed()) {
            E dummy;
            return match self { Ok(v) : dummy, Err(e) : e };
        }
        STDERR.write_str("Result::get_error: called on an ok value\n");
        __result_abort();
        // unreachable - dummy return to satisfy return type
        E dummy;
        return dummy;
    }
}
