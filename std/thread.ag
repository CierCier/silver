// std/thread.ag — 1:1 OS-thread runtime on raw `clone` for static (no-libc)
// Silver programs.
//
// The whole-allocator spinlock (std/mem/alloc.ag) makes it safe for these
// threads to allocate/free concurrently. Synchronization is the atomics-based
// done-flag in each TaskRecord: a launch hands the child a stack and its
// trampoline, the child runs it, stores its done flag, wakes one joiner via
// futex, and exits via sys_exit (which with CLONE_THREAD ends only that
// thread). Waiters spin briefly on the flag and then sleep in the kernel.
//
// User code starts threads only with `launch`; the compiler calls
// `__silver_launch` / `__silver_launch_scoped` here, and `wait` and Task drop
// glue call into std.rt.thread_registry.

import std.sys.os;
import std.sys.raw.thread;
import std.rt.thread_registry;
import std.mem.alloc;

/// Number of logical CPUs available to the current process. Linux uses the
/// calling thread's affinity mask so pools respect cpusets and containers.
i64 thread_available_parallelism() {
    i64 count = 1;
    if (@cfg(os.linux)) {
        u8 mask[1024];
        i64 bytes = sys_sched_getaffinity(0, 1024, (i64)&mask[0]);
        if (bytes > 0) {
            count = 0;
            i64 i = 0;
            while (i < bytes) {
                u8 bits = mask[i];
                while (bits != 0) {
                    count += (i64)(bits & (u8)1);
                    bits = bits >> 1;
                }
                i += 1;
            }
            if (count == 0) { count = 1; }
        }
    }
    return count;
}

/// Raw clone flags for a thread that shares the process address space:
/// CLONE_VM|CLONE_FS|CLONE_FILES|CLONE_SIGHAND|CLONE_THREAD|CLONE_SYSVSEM|CLONE_CHILD_CLEARTID|CLONE_CHILD_SETTID.
const i64 THREAD_CLONE_FLAGS = 19205888;

/// Dedicated stack size per thread (16-byte aligned top, 2MB).
const i64 THREAD_STACK_SIZE = 2097152;

// Raw clone shim. Spawns a thread running fn(arg) on a fresh stack_top.
// Parent path returns the child tid in %rax. Child resumes after `syscall`
// with rsp = stack_top and, taking the `jnz` fall-through, `call`s fn(arg)
// then exits via sys_exit(60) (CLONE_THREAD ⇒ only this thread exits).
// The clone+trampoline asm lives in std.sys.os (thread_spawn_raw), which
// thread.ag cannot import back — it owns the OS spawn seam.

/// Child entry. arg is a TaskRecord* owned by the parent registry. Calls the
/// user function, signals completion (release store + futex wake so a joining
/// thread sleeps instead of spinning), then exits the thread.
/// Internal: the spawn trampoline target; not for direct calls. It never
/// returns, and it also flushes this thread's allocator cache.
private void thread_entry(i64 arg) {
    TaskRecord* rec = (TaskRecord*)arg;
    void(i64) fn = (void(i64))rec.fn;
    fn(rec.arg);
    mem_tcache_exit();
    __atomic_store_i64(&rec.done, 1, ATOMIC_RELEASE);
    thread_wake_done_futex(rec);
    thread_exit(0);
}

/// Claims a free registry slot for `fn(arg)` and starts its thread. `pack` is
/// the launch pack the waiter frees (0 for a raw spawn) and `scoped` marks a
/// task that borrows from its launcher. Returns null when the registry is
/// full, the stack mmap fails, or clone fails; the caller keeps `pack`.
private TaskRecord* thread_start(i64 fn, i64 arg, i64 pack, i64 scoped) {
    thread_lock_acquire();
    i64 slot = -1;
    for (i64 i = 0; i < thread_registry_capacity(); i = i + 1) {
        if (g_threads[i].tid == 0) {
            slot = i;
            break;
        }
    }
    if (slot < 0) {
        thread_lock_release();
        return (TaskRecord*)0;
    }
    TaskRecord* rec = &g_threads[slot];
    rec.tid = -1; // claimed, child not yet running
    rec.fn = fn;
    rec.arg = arg;
    rec.done = 0;
    rec.pack = pack;
    rec.scoped = scoped;
    thread_lock_release();

    i64 tid = thread_spawn_claimed(rec, (i64)thread_entry);
    if (tid <= 0) {
        thread_spawn_cleanup(rec);
        return (TaskRecord*)0;
    }
    rec.tid = tid;
    return rec;
}

/// Launch a `launch` expression's trampoline on a fresh thread (T1). `tramp`
/// is a per-site `void(i64)` marshaller; `pack` is the compiler-owned
/// argument/result block. Returns the task handle to `wait` on, or 0
/// on failure (registry full, stack mmap failure, or clone error). On failure,
/// ownership of `pack` stays with the caller so it can run argument destructors.
/// v1: no lazy slot-reap — a slot is reclaimed only by `__silver_wait_done`
/// or `join_all` at process exit, keeping the returned rec stable.
i64 __silver_launch(void(i64) tramp, u8* pack) {
    if ((i64)tramp == 0 || (i64)pack == 0) {
        return 0;
    }
    TaskRecord* rec = thread_start((i64)tramp, (i64)pack, (i64)pack, 0);
    if (rec == (TaskRecord*)0) {
        return 0;
    }
    return task_handle(rec);
}

/// `__silver_launch` for a launch whose arguments borrow from the launcher.
/// The compiler joins such a task before its borrows end: an unwaited handle
/// is joined by `__silver_task_join_scoped` when it leaves scope.
i64 __silver_launch_scoped(void(i64) tramp, u8* pack) {
    if ((i64)tramp == 0 || (i64)pack == 0) {
        return 0;
    }
    TaskRecord* rec = thread_start((i64)tramp, (i64)pack, (i64)pack, 1);
    if (rec == (TaskRecord*)0) {
        return 0;
    }
    return task_handle(rec);
}

/// Allocates the Linux-only dedicated stack and spawns the child running
/// fn(rec.arg). Returns the tid/handle (> 0) or 0 on failure. On Linux the
/// child stack is mmapped and recorded in rec.stack; on Windows CreateThread
/// manages the stack and rec.stack stays null.
private i64 thread_spawn_claimed(TaskRecord* rec, i64 fn) {
    u8* stack = (u8*)0;
    u8* top = (u8*)0;
    if (@cfg(os.linux)) {
        // 16-byte aligned top; base is page-aligned and THREAD_STACK_SIZE is
        // a multiple of 16.
        if (rec.stack == (u8*)0) {
            stack = mem_sys_alloc(THREAD_STACK_SIZE);
            if (stack == (u8*)0) {
                return 0;
            }
            rec.stack = stack;
        } else {
            stack = rec.stack;
        }
        top = (u8*)((i64)stack + THREAD_STACK_SIZE);
    }
    rec.ctid = 1;
    // Any spawn ends single-threaded allocator mode (see mem_mark_multithreaded).
    mem_mark_multithreaded();
    i64 tid = thread_spawn_raw(THREAD_CLONE_FLAGS, top, fn, (i64)rec, &rec.ctid);
    if (tid <= 0 && stack != (u8*)0) {
        mem_sys_free(stack, THREAD_STACK_SIZE);
        rec.stack = (u8*)0;
    }
    return tid;
}

/// Rolls a failed spawn back without freeing the caller-owned launch pack.
private void thread_spawn_cleanup(TaskRecord* rec) {
    if (rec.stack != (u8*)0) {
        mem_sys_free(rec.stack, THREAD_STACK_SIZE);
        rec.stack = (u8*)0;
    }
    thread_lock_acquire();
    rec.tid = 0;
    rec.pack = 0;
    rec.scoped = 0;
    thread_lock_release();
}
