// std/sync.ag — Synchronization primitives for concurrent code.
//
// Building blocks for sharing state between threads: a futex-based RawMutex, a
// WaitGroup counter, and the raw futex wait/wake helpers they are built on.
//
// Everything here is seq_cst by default.  The futex slow-path protocol
// (check state under the word, sleep, re-check) is only sound with strong
// ordering — relaxed futex wait/wake can miss a wake-up — and the atomics
// that decide whether to sleep or wake must agree with the futex word.
//
// The wait/wake helpers use the classic `futex` syscall (nr 202) with the
// FUTEX_WAIT/FUTEX_WAKE opcodes, available on every Linux kernel, rather
// than the newer split futex_wait/futex_wake syscalls (Linux >= 6.7).

import std.atomic;
import std.mem.drop;
import std.sys.raw.sync;
import std.sys.errno;

// futex(2) opcodes for the classic sys_futex syscall.
const i64 FUTEX_WAIT = 0;
const i64 FUTEX_WAKE = 1;

/// Sleep until the word at `addr` differs from `expected` or a futex_wake
/// fires on it.  Returns as soon as the kernel reports a result (woken,
/// value changed, or EAGAIN); callers re-check their state in a loop.  Only
/// EINTR is retried — a signal interruption must not lose the wait.
void futex_wait(i32* addr, i32 expected) {
    while (true) {
        i64 r = sys_futex((i64)addr, FUTEX_WAIT, (i64)expected, 0, 0, 0);
        if (r != -EINTR) {
            return;
        }
    }
}

/// Wake up to `nr_wake` threads blocked in futex_wait on `addr`.
/// Returns the number of threads actually woken.
i64 futex_wake(i32* addr, i64 nr_wake) {
    return sys_futex((i64)addr, FUTEX_WAKE, nr_wake, 0, 0, 0);
}

// -- RawMutex --------------------------------------------------------------

/// A blocking mutual-exclusion lock (futex-based).
///
/// This is the low-level lock primitive; `Mutex<T>` below wraps a value
/// with an RAII guard on top of it.  (Named RawMutex to mirror that split.)
///
/// state is one of:
///   0  unlocked
///   1  locked, no waiters parked
///   2  locked, waiters parked on the futex word
///
/// `lock` fast-paths an uncontended CAS (0 -> 1), then marks the lock as
/// contended and sleeps on `state` until the owner unlocks.  `unlock`
/// releases with an exchange and wakes one waiter when any were parked.
/// spurious / lost wake-ups are impossible: a waiter always re-checks the
/// lock state after the futex returns, and a waker always exchanges the
/// state before waking.
struct RawMutex {
    i32 state;
}

impl RawMutex {
    /// A fresh, unlocked mutex.
    RawMutex new() {
        RawMutex m;
        m.state = 0;
        return m;
    }

    /// Acquire the lock, blocking until it is free.
    void lock(&mut RawMutex self) {
        // Fast path: uncontended acquisition.
        bool acquired = __atomic_cmpxchg_i32(&self.state, 0, 1, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST);
        if (acquired) {
            return;
        }
        // Slow path: mark waiters present, then sleep until the lock is
        // observed free.  Exchanging to 2 (instead of just reading) is what
        // both claims and re-claims the lock after a wake.
        i32 old = __atomic_exchange_i32(&self.state, 2, ATOMIC_SEQ_CST);
        while (old != 0) {
            futex_wait(&self.state, 2);
            old = __atomic_exchange_i32(&self.state, 2, ATOMIC_SEQ_CST);
        }
    }

    /// Release the lock, waking one waiter if any were parked.
    void unlock(&mut RawMutex self) {
        i32 old = __atomic_exchange_i32(&self.state, 0, ATOMIC_SEQ_CST);
        if (old == 2) {
            futex_wake(&self.state, 1);
        }
    }

    /// Try to acquire the lock without blocking; true on success.
    bool try_lock(&mut RawMutex self) {
        return __atomic_cmpxchg_i32(&self.state, 0, 1, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST);
    }
}

// -- Mutex<T> + Guard<T> (RAII) -----------------------------------------------

/// A mutex-protected value.  `lock` returns a Guard<T> that grants access to
/// the value and unlocks the underlying RawMutex when it is dropped — at
/// scope exit, on early return, or when ownership is `move`d.  The guard is
/// the only way to touch the value, so accesses/updates are serialized.
///
/// A zero-initialized `Mutex<T>` is a valid unlocked mutex holding a zero
/// value, so globals need no constructor:
///     Mutex<i64> g_counter;
/// Locals should use `Mutex<i64>.new(initial)`.
struct Mutex<T> {
    RawMutex mu;
    T value;
}

impl<T> Mutex<T> {
    /// A fresh, unlocked mutex holding `value`.
    Mutex<T> new(T value) {
        Mutex<T> m;
        m.mu = RawMutex.new();
        m.value = move value;
        return m;
    }

    /// Acquire the lock (blocking) and return a guard granting access to the
    /// value.  The guard unlocks on drop.  Takes a raw-pointer receiver so
    /// the guard can hold the same address.
    Guard<T> lock(Mutex<T>* self) {
        self.mu.lock();
        Guard<T> g;
        g.owner = self;
        return g;
    }
}

/// RAII guard returned by Mutex<T>::lock.  The compiler runs its drop on
/// every exit path (scope end, early return), so the lock can never be left
/// held.  Access the value through get_ptr / get / set.
struct Guard<T> {
    Mutex<T>* owner;
}

impl<T> Guard<T> {
    /// Mutable pointer to the guarded value (valid while the guard lives).
    T* get_ptr(&Guard<T> self) {
        return &self.owner.value;
    }

    /// Copy of the guarded value.  For owned element types prefer get_ptr —
    /// a copy shares resources with the guarded value (std-wide caveat).
    T get(&Guard<T> self) {
        return self.owner.value;
    }

    /// Overwrite the guarded value.
    void set(&mut Guard<T> self, T value) {
        self.owner.value = move value;
    }

    /// Pointer to the underlying RawMutex.
    RawMutex* raw_mutex(&Guard<T> self) {
        return &self.owner.mu;
    }
}

impl<T> Drop for Guard<T> {
    /// Release the lock.  Runs automatically at scope exit / early return.
    void drop(Guard<T>* self) {
        self.owner.mu.unlock();
    }
}

// -- WaitGroup -------------------------------------------------------------

/// A counter that threads decrement as work completes; `wait` blocks until
/// it reaches zero.  Idiom: `add(1)` per unit of work before handing it to a
/// thread, `done()` when that unit finishes, and a single `wait` in the
/// coordinator.  The final `done` that reaches zero wakes every waiter.
struct WaitGroup {
    i32 count;
}

impl WaitGroup {
    /// A fresh, zeroed wait group.
    WaitGroup new() {
        WaitGroup w;
        w.count = 0;
        return w;
    }

    /// Add `delta` units of outstanding work.  Typically 1.
    void add(&mut WaitGroup self, i64 delta) {
        __atomic_fetch_add_i32(&self.count, (i32)delta, ATOMIC_SEQ_CST);
    }

    /// Mark one unit of work complete.  When the count reaches zero, wake
    /// all waiters so a coordinator blocked in `wait_all` can proceed.
    void done(&mut WaitGroup self) {
        i32 prev = __atomic_fetch_sub_i32(&self.count, 1, ATOMIC_SEQ_CST);
        if (prev == 1) {
            futex_wake(&self.count, 2147483647);
        }
    }

    /// Block until the count reaches zero.
    void wait_all(&WaitGroup self) {
        i32 c = __atomic_load_i32(&self.count, ATOMIC_SEQ_CST);
        while (c != 0) {
            futex_wait(&self.count, c);
            c = __atomic_load_i32(&self.count, ATOMIC_SEQ_CST);
        }
    }
}

// -- Condvar ---------------------------------------------------------------

/// A condition variable for blocking threads until an event is signaled.
///
/// `wait` atomically unlocks the associated RawMutex and blocks on a futex
/// sequence word. Upon waking, `wait` re-acquires the lock before returning.
struct Condvar {
    i32 seq;
}

impl Condvar {
    /// A fresh condition variable.
    Condvar new() {
        Condvar c;
        c.seq = 0;
        return c;
    }

    /// Block the current thread until notified. Atomically releases the
    /// mutex `mu`, sleeps on the futex word, and re-acquires
    /// the mutex before returning.
    /// Named `wait_on` because `wait` is the task-join keyword.
    void wait_on(Condvar* self, RawMutex* mu) {
        i32 expected = __atomic_load_i32(&(*self).seq, ATOMIC_SEQ_CST);
        (*mu).unlock();
        futex_wait(&(*self).seq, expected);
        (*mu).lock();
    }

    /// Wake one thread waiting on this condition variable.
    void notify_one(Condvar* self) {
        __atomic_fetch_add_i32(&(*self).seq, 1, ATOMIC_SEQ_CST);
        futex_wake(&(*self).seq, 1);
    }

    /// Alias for `notify_one` (short form).
    void notify(Condvar* self) {
        (*self).notify_one();
    }

    /// Wake all threads waiting on this condition variable.
    void notify_all(Condvar* self) {
        __atomic_fetch_add_i32(&(*self).seq, 1, ATOMIC_SEQ_CST);
        futex_wake(&(*self).seq, 2147483647);
    }
}

// -- RawRwLock (Writer-Priority) -------------------------------------------

/// A writer-priority read-write lock.
///
/// State:
///   0       unlocked
///   > 0     active reader count
///   -1      active writer
///
/// Writers waiting count prevents new readers from acquiring the lock,
/// avoiding writer starvation under heavy reader concurrency.
struct RawRwLock {
    i32 state;
    i32 writers_waiting;
    i32 read_futex;
    i32 write_futex;
}

impl RawRwLock {
    /// A fresh, unlocked read-write lock.
    RawRwLock new() {
        RawRwLock rw;
        rw.state = 0;
        rw.writers_waiting = 0;
        rw.read_futex = 0;
        rw.write_futex = 0;
        return rw;
    }

    /// Acquire a shared read lock, blocking if a writer is active or waiting.
    void read_lock(RawRwLock* self) {
        while (true) {
            i32 ww = __atomic_load_i32(&(*self).writers_waiting, ATOMIC_SEQ_CST);
            i32 s = __atomic_load_i32(&(*self).state, ATOMIC_SEQ_CST);
            if (ww == 0 && s >= 0) {
                if (__atomic_cmpxchg_i32(&(*self).state, s, s + 1, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST)) {
                    return;
                }
            } else {
                i32 expected = __atomic_load_i32(&(*self).read_futex, ATOMIC_SEQ_CST);
                futex_wait(&(*self).read_futex, expected);
            }
        }
    }

    /// Try to acquire a shared read lock without blocking.
    bool try_read_lock(RawRwLock* self) {
        i32 ww = __atomic_load_i32(&(*self).writers_waiting, ATOMIC_SEQ_CST);
        if (ww > 0) {
            return false;
        }
        i32 s = __atomic_load_i32(&(*self).state, ATOMIC_SEQ_CST);
        if (s < 0) {
            return false;
        }
        return __atomic_cmpxchg_i32(&(*self).state, s, s + 1, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST);
    }

    /// Release a shared read lock.
    void read_unlock(RawRwLock* self) {
        i32 prev = __atomic_fetch_sub_i32(&(*self).state, 1, ATOMIC_SEQ_CST);
        if (prev == 1) {
            // Last reader exited: wake one waiting writer if any
            if (__atomic_load_i32(&(*self).writers_waiting, ATOMIC_SEQ_CST) > 0) {
                __atomic_fetch_add_i32(&(*self).write_futex, 1, ATOMIC_SEQ_CST);
                futex_wake(&(*self).write_futex, 1);
            }
        }
    }

    /// Acquire an exclusive write lock, blocking until all readers and writers exit.
    void write_lock(RawRwLock* self) {
        __atomic_fetch_add_i32(&(*self).writers_waiting, 1, ATOMIC_SEQ_CST);
        while (true) {
            if (__atomic_cmpxchg_i32(&(*self).state, 0, -1, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST)) {
                __atomic_fetch_sub_i32(&(*self).writers_waiting, 1, ATOMIC_SEQ_CST);
                return;
            }
            i32 expected = __atomic_load_i32(&(*self).write_futex, ATOMIC_SEQ_CST);
            futex_wait(&(*self).write_futex, expected);
        }
    }

    /// Try to acquire an exclusive write lock without blocking.
    bool try_write_lock(RawRwLock* self) {
        return __atomic_cmpxchg_i32(&(*self).state, 0, -1, ATOMIC_SEQ_CST, ATOMIC_SEQ_CST);
    }

    /// Release an exclusive write lock.
    void write_unlock(RawRwLock* self) {
        __atomic_exchange_i32(&(*self).state, 0, ATOMIC_SEQ_CST);
        if (__atomic_load_i32(&(*self).writers_waiting, ATOMIC_SEQ_CST) > 0) {
            __atomic_fetch_add_i32(&(*self).write_futex, 1, ATOMIC_SEQ_CST);
            futex_wake(&(*self).write_futex, 1);
        } else {
            __atomic_fetch_add_i32(&(*self).read_futex, 1, ATOMIC_SEQ_CST);
            futex_wake(&(*self).read_futex, 2147483647);
        }
    }
}

// -- RwLock<T> + ReadGuard<T> / WriteGuard<T> (RAII) -----------------------

/// An RwLock-protected value allowing concurrent readers or exclusive writer.
struct RwLock<T> {
    RawRwLock rw;
    T value;
}

impl<T> RwLock<T> {
    /// A fresh, unlocked RwLock holding `value`.
    RwLock<T> new(T value) {
        RwLock<T> r;
        r.rw = RawRwLock.new();
        r.value = move value;
        return r;
    }

    /// Acquire a shared read lock and return an RAII ReadGuard.
    ReadGuard<T> read(RwLock<T>* self) {
        (*self).rw.read_lock();
        ReadGuard<T> g;
        g.owner = self;
        return g;
    }

    /// Acquire an exclusive write lock and return an RAII WriteGuard.
    WriteGuard<T> write(RwLock<T>* self) {
        (*self).rw.write_lock();
        WriteGuard<T> g;
        g.owner = self;
        return g;
    }
}

/// RAII guard returned by RwLock<T>::read. Automatically unlocks on drop.
struct ReadGuard<T> {
    RwLock<T>* owner;
}

impl<T> ReadGuard<T> {
    /// Pointer to the guarded value (valid while the guard lives).
    T* get_ptr(ReadGuard<T>* self) {
        return &(*self).owner.value;
    }

    /// Copy of the guarded value.
    T get(ReadGuard<T>* self) {
        return (*self).owner.value;
    }
}

impl<T> Drop for ReadGuard<T> {
    void drop(ReadGuard<T>* self) {
        (*self).owner.rw.read_unlock();
    }
}

/// RAII guard returned by RwLock<T>::write. Automatically unlocks on drop.
struct WriteGuard<T> {
    RwLock<T>* owner;
}

impl<T> WriteGuard<T> {
    /// Pointer to the guarded value (valid while the guard lives).
    T* get_ptr(WriteGuard<T>* self) {
        return &(*self).owner.value;
    }

    /// Copy of the guarded value.
    T get(WriteGuard<T>* self) {
        return (*self).owner.value;
    }

    /// Overwrite the guarded value.
    void set(WriteGuard<T>* self, T value) {
        (*self).owner.value = move value;
    }
}

impl<T> Drop for WriteGuard<T> {
    void drop(WriteGuard<T>* self) {
        (*self).owner.rw.write_unlock();
    }
}