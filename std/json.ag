    Result<u64, JsonError> from_json(JsonReader* input) {
        u64 value = 0;
        if (!input.read_u64(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        return Ok(value);
    }
}

impl FromJson for f32 {
    Result<f32, JsonError> from_json(JsonReader* input) {
        f64 value = 0.0;
        if (!input.read_f64(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        return Ok((f32)value);
    }
}

impl FromJson for f64 {
    Result<f64, JsonError> from_json(JsonReader* input) {
        f64 value = 0.0;
        if (!input.read_f64(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        return Ok(value);
    }
}

impl FromJson for Optional<i32> {
    Result<Optional<i32>, JsonError> from_json(JsonReader* input) {
        input.skip_whitespace();
        u8* bytes = (u8*)input.input;
        if (input.index < input.length && bytes[input.index] == (u8)110) {
            if (input.literal("null")) {
                Optional<i32> none = None;
                return Ok(move none);
            }
        }
        i32 value = 0;
        if (!input.read_i32(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        Optional<i32> some = Some(value);
        return Ok(move some);
    }
}

impl FromJson for Optional<f64> {
    Result<Optional<f64>, JsonError> from_json(JsonReader* input) {
        input.skip_whitespace();
        u8* bytes = (u8*)input.input;
        if (input.index < input.length && bytes[input.index] == (u8)110) {
            if (input.literal("null")) {
                Optional<f64> none = None;
                return Ok(move none);
            }
        }
        f64 value = 0.0;
        if (!input.read_f64(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        Optional<f64> some = Some(value);
        return Ok(move some);
    }
}

