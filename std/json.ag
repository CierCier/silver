impl<T> FromJson for Optional<T> {
    Result<Optional<T>, JsonError> from_json(JsonReader* input) {
        Optional<T> slot;
        if (!slot.json_decode(input)) {
            JsonError error = JsonError.at_index(input.index);
            return Err(move error);
        }
        return Ok(move slot);
    }
}

impl JsonDecode for i8 {
    bool json_decode(*self, JsonReader* input) {
        i64 value = 0;
        if (!input.read_i64(&value)) { return false; }
        *self = (i8)value;
        return true;
    }
}

