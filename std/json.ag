// JSON serialization traits and streaming reader/writer.
//
// ToJson is intentionally a streaming API: implementations write directly to
// JsonWriter instead of allocating one string per nested value.
// FromJson returns Result so custom implementations own validation policy.

import std.io.file;
import std.string;
import std.result;
import std.fmt;
import std.mem.memory;
import std.mem.vec;
import std.optional;

enum JsonError {
    Invalid;
    At(i64); // byte offset where decoding failed
}

impl JsonError {
    JsonError invalid() {
        return JsonError.Invalid;
    }

    /// Error carrying the reader's byte offset at the failure point.
    JsonError at_index(i64 index) {
        return JsonError.At(move index);
    }

    /// Byte offset of the failure, or -1 when unknown.
    i64 offset(*self) {
        i64 result = -1;
        match *self {
            Invalid : result = -1,
            At(idx) : result = idx,
        }
        return result;
    }
}

trait ToJson {
    void to_json(*self, JsonWriter* out);
}

trait FromJson {
    Result<Self, JsonError> from_json(JsonReader* input);
}

// Decode a value of type Self from the reader, writing it into *self and
// returning success. Unlike FromJson, this has a receiver so generic
// containers can decode their element type T without knowing it: they call
// `T elem; elem.json_decode(input)` on a zero-initialized local and the
// value lands in the local. The bool return keeps nested generic calls
// small (no large struct returns through monomorphized code).
trait JsonDecode {
    bool json_decode(*self, JsonReader* input);
}

struct JsonWriter {
    BufWriter output;
    u8 contexts[32]; // 1 = object, 2 = array
    bool first[32];
    i64 depth;
    bool expecting_value;
}

impl JsonWriter {
    JsonWriter new() {
        JsonWriter writer;
        writer.output.data = 0;
        writer.output.len = 0;
        writer.output.cap = 0;
        writer.output.fd = -1;
        writer.output.list_next = (BufWriter*)0;
        writer.output.list_prev = (BufWriter*)0;
        writer.output.mode = IOMODE_BLOCK;
        writer.depth = 0;
        writer.expecting_value = false;
        return move writer;
    }

    void before_value(*self) {
        if (self.depth == 0) {
            return;
        }
        if (self.expecting_value) {
            self.expecting_value = false;
            return;
        }
        i64 top = self.depth - 1;
        if (self.contexts[top] == 2) {
            if (!self.first[top]) {
                self.output.write_u8((u8)44);
            }
            self.first[top] = false;
        }
    }

    void write_escaped_body(*self, str value) {
        u8* bytes = (u8*)value;
        i64 i = 0;
        i64 len = cstr_len(bytes);
        while (i < len) {
            u8 ch = bytes[i];
            if (ch == (u8)34) {
                self.output.write_str("\\\"");
            } else if (ch == (u8)92) {
                self.output.write_str("\\\\");
            } else if (ch == (u8)8) {
                self.output.write_str("\\b");
            } else if (ch == (u8)12) {
                self.output.write_str("\\f");
            } else if (ch == (u8)10) {
                self.output.write_str("\\n");
            } else if (ch == (u8)13) {
                self.output.write_str("\\r");
            } else if (ch == (u8)9) {
                self.output.write_str("\\t");
            } else if (ch < (u8)32) {
                self.write_hex4((u32)ch);
            } else {
                self.output.write_u8(ch);
            }
            i = i + 1;
        }
    }

    void write_hex4(*self, u32 value) {
        self.output.write_str("\\u00");
        self.output.write_u8(self.hex_digit((value >> 4) & 0xF));
        self.output.write_u8(self.hex_digit(value & 0xF));
    }

    u8 hex_digit(*self, u32 v) {
        if (v < 10) { return (u8)((u32)48 + v); }
        return (u8)((u32)97 + v - 10);
    }

    void write_string(*self, str value) {
        self.before_value();
        self.output.write_u8((u8)34);
        self.write_escaped_body(value);
        self.output.write_u8((u8)34);
    }

    void write_raw(*self, str value) {
        self.before_value();
        self.output.write_str(value);
    }

    void write_null(*self) {
        self.before_value();
        self.output.write_str("null");
    }

    void write_i64(*self, i64 value) {
        self.before_value();
        self.output.write_i64(value);
    }

    void write_u64(*self, u64 value) {
        self.before_value();
        self.output.write_u64(value);
    }

    void write_f64(*self, f64 value) {
        self.before_value();
        self.output.write_f64(value);
    }

    void write_bool(*self, bool value) {
        self.before_value();
        self.output.write_bool(value);
    }

    void begin_object(*self) {
        self.before_value();
        self.output.write_u8((u8)123);
        if (self.depth < 32) {
            self.contexts[self.depth] = 1;
            self.first[self.depth] = true;
            self.depth = self.depth + 1;
        }
    }

    void end_object(*self) {
        if (self.depth > 0) {
            self.depth = self.depth - 1;
        }
        self.output.write_u8((u8)125);
    }

    void begin_array(*self) {
        self.before_value();
        self.output.write_u8((u8)91);
        if (self.depth < 32) {
            self.contexts[self.depth] = 2;
            self.first[self.depth] = true;
            self.depth = self.depth + 1;
        }
    }

    void end_array(*self) {
        if (self.depth > 0) {
            self.depth = self.depth - 1;
        }
        self.output.write_u8((u8)93);
    }

    void field(*self, str name) {
        if (self.depth == 0 || self.contexts[self.depth - 1] != 1) {
            return;
        }
        i64 top = self.depth - 1;
        if (!self.first[top]) {
            self.output.write_u8((u8)44);
        }
        self.first[top] = false;
        self.output.write_u8((u8)34);
        self.write_escaped_body(name);
        self.output.write_str("\":");
        self.expecting_value = true;
    }

    str finish(*self) {
        self.output.write_u8((u8)0);
        str result = (str)self.output.data;
        self.output.data = 0;
        self.output.len = 0;
        self.output.cap = 0;
        return result;
    }
}

struct JsonReader {
    str input;
    i64 index;
    i64 length;
    bool failed;
}

impl JsonReader {
    JsonReader new(str input) {
        JsonReader reader;
        reader.input = input;
        reader.index = 0;
        reader.length = cstr_len((u8*)input);
        reader.failed = false;
        return move reader;
    }

    void skip_whitespace(*self) {
        u8* bytes = (u8*)self.input;
        while (self.index + 16 <= self.length) {
            i64 non_ws = asm("
                movdqu (%rax), %xmm0
                movl $$0x20202020, %edx
                movd %edx, %xmm1
                pshufd $$0, %xmm1, %xmm1
                pcmpeqb %xmm0, %xmm1

                movl $$0x09090909, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                movl $$0x0a0a0a0a, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                movl $$0x0d0d0d0d, %edx
                movd %edx, %xmm2
                pshufd $$0, %xmm2, %xmm2
                pcmpeqb %xmm0, %xmm2
                por %xmm2, %xmm1

                pmovmskb %xmm1, %ecx
                cmpl $$65535, %ecx
                je 1f
                notl %ecx
                bsfl %ecx, %eax
                movzwq %ax, %rax
                jmp 2f
                1:
                movq $$-1, %rax
                2:
            ", [&bytes[self.index]], ["rdx", "rcx", "xmm0", "xmm1", "xmm2"]);
            if (non_ws >= 0) {
                self.index = self.index + non_ws;
                return;
            }
            self.index = self.index + 16;
        }
        while (self.index < self.length) {
            u8 ch = bytes[self.index];
            if (ch != (u8)32 && ch != (u8)9 && ch != (u8)10 && ch != (u8)13) {
                return;
            }
            self.index = self.index + 1;
        }
    }

    bool expect(*self, u8 expected) {
        u8* bytes = (u8*)self.input;
        self.skip_whitespace();
        if (self.index >= self.length || bytes[self.index] != expected) {
            self.failed = true;
            return false;
        }
        self.index = self.index + 1;
        return true;
    }

    bool begin_object(*self) { return self.expect((u8)123); }
    bool end_object(*self) { return self.expect((u8)125); }
    bool begin_array(*self) { return self.expect((u8)91); }
    bool end_array(*self) { return self.expect((u8)93); }
    bool comma(*self) { return self.expect((u8)44); }

    /// True when the next non-whitespace byte closes the current object.
    /// Peeking avoids the failed flag that expect() sets on mismatch, so a
    /// normally-terminated object never poisons an enclosing decode.
    bool at_object_end(*self) {
        self.skip_whitespace();
        u8* bytes = (u8*)self.input;
        return self.index < self.length && bytes[self.index] == (u8)125;
    }

    bool literal(*self, str value) {
        u8* input = (u8*)self.input;
        u8* expected = (u8*)value;
        self.skip_whitespace();
        i64 len = cstr_len(expected);
        if (self.index + len > self.length) {
            self.failed = true;
            return false;
        }
        i64 i = 0;
        while (i < len) {
            if (input[self.index + i] != expected[i]) {
                self.failed = true;
                return false;
            }
            i = i + 1;
        }
        self.index = self.index + len;
        return true;
    }

    bool read_bool(*self, bool* out) {
        u8* bytes = (u8*)self.input;
        self.skip_whitespace();
        if (self.index + 4 <= self.length
            && bytes[self.index] == (u8)116) {
            if (self.literal("true")) { *out = true; return true; }
        }
        if (self.literal("false")) { *out = false; return true; }
        self.failed = true;
        return false;
    }

    bool read_i64(*self, i64* out) {
        u8* bytes = (u8*)self.input;
        self.skip_whitespace();
        bool negative = false;
        if (self.index < self.length && bytes[self.index] == (u8)45) {
            negative = true;
            self.index = self.index + 1;
        }
        i64 value = 0;
        i64 digits = 0;
        if (self.index < self.length && bytes[self.index] == (u8)48) {
            digits = 1;
            self.index = self.index + 1;
            if (self.index < self.length && bytes[self.index] >= (u8)48 && bytes[self.index] <= (u8)57) {
                self.failed = true;
                return false;
            }
        } else {
            while (self.index < self.length) {
                u8 ch = bytes[self.index];
                if (ch < (u8)48 || ch > (u8)57) { break; }
                value = value * 10 + (i64)(ch - (u8)48);
                self.index = self.index + 1;
                digits = digits + 1;
            }
        }
        if (digits == 0) {
            self.failed = true;
            return false;
        }
        if (negative) { value = -value; }
        *out = value;
        return true;
    }

    bool read_i32(*self, i32* out) {
        i64 value = 0;
        if (!self.read_i64(&value)) { return false; }
        *out = (i32)value;
        return true;
    }

    bool read_u64(*self, u64* out) {
        u8* bytes = (u8*)self.input;
        self.skip_whitespace();
        if (self.index < self.length && bytes[self.index] == (u8)45) {
            self.failed = true;
            return false;
        }
        u64 value = 0;
        i64 digits = 0;
        if (self.index < self.length && bytes[self.index] == (u8)48) {
            digits = 1;
            self.index = self.index + 1;
            if (self.index < self.length && bytes[self.index] >= (u8)48 && bytes[self.index] <= (u8)57) {
                self.failed = true;
                return false;
            }
        } else {
            while (self.index < self.length) {
                u8 ch = bytes[self.index];
                if (ch < (u8)48 || ch > (u8)57) { break; }
                value = value * 10 + (u64)(ch - (u8)48);
                self.index = self.index + 1;
                digits = digits + 1;
            }
        }
        if (digits == 0) {
            self.failed = true;
            return false;
        }
        *out = value;
        return true;
    }

    bool read_f64(*self, f64* out) {
        u8* bytes = (u8*)self.input;
        self.skip_whitespace();
        bool negative = false;
        if (self.index < self.length && bytes[self.index] == (u8)45) {
            negative = true;
            self.index = self.index + 1;
        }
        f64 value = 0.0;
        i64 digits = 0;
        if (self.index < self.length && bytes[self.index] == (u8)48) {
            digits = 1;
            self.index = self.index + 1;
            if (self.index < self.length && bytes[self.index] >= (u8)48 && bytes[self.index] <= (u8)57) {
                self.failed = true;
                return false;
            }
        } else {
            while (self.index < self.length) {
                u8 ch = bytes[self.index];
                if (ch < (u8)48 || ch > (u8)57) { break; }
                value = value * 10.0 + (f64)(ch - (u8)48);
                self.index = self.index + 1;
                digits = digits + 1;
            }
        }
        if (digits == 0) {
            self.failed = true;
            return false;
        }
        f64 fraction = 0.1;
        if (self.index < self.length && bytes[self.index] == (u8)46) {
            self.index = self.index + 1;
            i64 fraction_digits = 0;
            while (self.index < self.length) {
                u8 ch = bytes[self.index];
                if (ch < (u8)48 || ch > (u8)57) { break; }
                value = value + (f64)(ch - (u8)48) * fraction;
                fraction = fraction / 10.0;
                self.index = self.index + 1;
                fraction_digits = fraction_digits + 1;
            }
            if (fraction_digits == 0) {
                self.failed = true;
                return false;
            }
        }
        if (self.index < self.length
            && (bytes[self.index] == (u8)101 || bytes[self.index] == (u8)69)) {
            self.index = self.index + 1;
            bool exponent_negative = false;
            if (self.index < self.length && bytes[self.index] == (u8)45) {
                exponent_negative = true;
                self.index = self.index + 1;
            } else if (self.index < self.length && bytes[self.index] == (u8)43) {
                self.index = self.index + 1;
            }
            i64 exponent = 0;
            i64 exponent_digits = 0;
            while (self.index < self.length) {
                u8 ch = bytes[self.index];
                if (ch < (u8)48 || ch > (u8)57) { break; }
                exponent = exponent * 10 + (i64)(ch - (u8)48);
                self.index = self.index + 1;
                exponent_digits = exponent_digits + 1;
            }
            if (exponent_digits == 0) {
                self.failed = true;
                return false;
            }
            f64 scale = 1.0;
            i64 i = 0;
            if (exponent_negative) {
                while (i < exponent) { scale = scale / 10.0; i = i + 1; }
            } else {
                while (i < exponent) { scale = scale * 10.0; i = i + 1; }
            }
            value = value * scale;
        }
        if (negative) { value = -value; }
        *out = value;
        return true;
    }

    String read_string(*self) {
        u8* bytes = (u8*)self.input;
        String result = String.new();
        if (!self.expect((u8)34)) { return move result; }
        while (self.index < self.length) {
            i64 start = self.index;
            while (self.index + 16 <= self.length) {
                i64 delim = asm("
                    movdqu (%rax), %xmm0
                    movl $$0x22222222, %edx
                    movd %edx, %xmm1
                    pshufd $$0, %xmm1, %xmm1
                    pcmpeqb %xmm0, %xmm1

                    movl $$0x5c5c5c5c, %edx
                    movd %edx, %xmm2
                    pshufd $$0, %xmm2, %xmm2
                    pcmpeqb %xmm0, %xmm2
                    por %xmm2, %xmm1

                    pmovmskb %xmm1, %eax
                    movzwq %ax, %rax
                ", [&bytes[self.index]], ["rdx", "xmm0", "xmm1", "xmm2"]);
                if (delim != 0) {
                    i64 bit = asm("bsfq %rax, %rax", [delim], []);
                    self.index = self.index + bit;
                    break;
                }
                self.index = self.index + 16;
            }
            if (self.index > start) {
                result.push_bytes(&bytes[start], self.index - start);
            }
            if (self.index >= self.length) {
                break;
            }
            u8 ch = bytes[self.index];
            self.index = self.index + 1;
            if (ch == (u8)34) { return move result; }
            if (ch != (u8)92) {
                result.push(ch);
                continue;
            }
            if (self.index >= self.length) { break; }
            u8 escaped = bytes[self.index];
            self.index = self.index + 1;
            if (escaped == (u8)34) { result.push((u8)34); }
            else if (escaped == (u8)92) { result.push((u8)92); }
            else if (escaped == (u8)98) { result.push((u8)8); }
            else if (escaped == (u8)102) { result.push((u8)12); }
            else if (escaped == (u8)110) { result.push((u8)10); }
            else if (escaped == (u8)114) { result.push((u8)13); }
            else if (escaped == (u8)116) { result.push((u8)9); }
            else if (escaped == (u8)117) {
                u32 cp = self.read_hex4();
                if (self.failed) { return move result; }
                if (cp >= 0xD800 && cp <= 0xDBFF) {
                    // High surrogate: the next escape must be a low surrogate.
                    if (self.index + 1 >= self.length
                        || bytes[self.index] != (u8)92
                        || bytes[self.index + 1] != (u8)117) {
                        self.failed = true;
                        return move result;
                    }
                    self.index = self.index + 2;
                    u32 low = self.read_hex4();
                    if (self.failed || low < 0xDC00 || low > 0xDFFF) {
                        self.failed = true;
                        return move result;
                    }
                    cp = 0x10000 + ((cp - 0xD800) << 10) + (low - 0xDC00);
                } else if (cp >= 0xDC00 && cp <= 0xDFFF) {
                    // Lone low surrogate has no high half.
                    self.failed = true;
                    return move result;
                }
                if (!result.push_codepoint(cp)) {
                    self.failed = true;
                    return move result;
                }
            }
            else { self.failed = true; return move result; }
        }
        self.failed = true;
        return move result;
    }

    bool field(*self, str name) {
        String actual = self.read_string();
        if (self.failed || !actual.equals(name)) {
            self.failed = true;
            return false;
        }
        return self.expect((u8)58);
    }

    u32 read_hex4(*self) {
        if (self.index + 4 > self.length) {
            self.failed = true;
            return 0;
        }
        u8* bytes = (u8*)self.input;
        u32 value = 0;
        i64 i = 0;
        while (i < 4) {
            i32 d = self.hex_digit(bytes[self.index + i]);
            if (d < 0) {
                self.failed = true;
                return 0;
            }
            value = value * 16 + (u32)d;
            i = i + 1;
        }
        self.index = self.index + 4;
        return value;
    }

    i32 hex_digit(*self, u8 c) {
        if (c >= (u8)48 && c <= (u8)57) { return (i32)(c - (u8)48); }
        if (c >= (u8)97 && c <= (u8)102) { return (i32)(c - (u8)97) + 10; }
        if (c >= (u8)65 && c <= (u8)70) { return (i32)(c - (u8)65) + 10; }
        return -1;
    }

    /// Consume one JSON value of any shape (object, array, string, number,
    /// literal). Fields with unknown names are skipped so parsing tolerates
    /// extra keys in the payload.
    bool skip_value(*self) {
        self.skip_whitespace();
        if (self.failed) { return false; }
        u8* bytes = (u8*)self.input;
        if (self.index >= self.length) {
            self.failed = true;
            return false;
        }
        u8 ch = bytes[self.index];
        if (ch == (u8)123) {
            if (!self.begin_object()) { return false; }
            while (true) {
                self.skip_whitespace();
                if (self.failed) { return false; }
                if (self.index < self.length && bytes[self.index] == (u8)125) {
                    self.index = self.index + 1;
                    break;
                }
                String key = self.read_string();
                if (self.failed) { return false; }
                if (!self.expect((u8)58)) { return false; }
                if (!self.skip_value()) { return false; }
                self.skip_whitespace();
                if (self.failed) { return false; }
                if (self.index < self.length && bytes[self.index] == (u8)44) {
                    self.index = self.index + 1;
                }
            }
            return true;
        } else if (ch == (u8)91) {
            if (!self.begin_array()) { return false; }
            while (true) {
                self.skip_whitespace();
                if (self.failed) { return false; }
                if (self.index < self.length && bytes[self.index] == (u8)93) {
                    self.index = self.index + 1;
                    break;
                }
                if (!self.skip_value()) { return false; }
                self.skip_whitespace();
                if (self.failed) { return false; }
                if (self.index < self.length && bytes[self.index] == (u8)44) {
                    self.index = self.index + 1;
                }
            }
            return true;
        } else if (ch == (u8)34) {
            String s = self.read_string();
            return !self.failed;
        } else if (ch == (u8)116) {
            return self.literal("true");
        } else if (ch == (u8)102) {
            return self.literal("false");
        } else if (ch == (u8)110) {
            return self.literal("null");
        } else {
            f64 number = 0.0;
            return self.read_f64(&number);
        }
    }

    bool ok(*self) {
        self.skip_whitespace();
        return !self.failed && self.index == self.length;
    }
}

impl ToJson for i8 { void to_json(*self, JsonWriter* out) { out.write_i64((i64)*self); } }
impl ToJson for i16 { void to_json(*self, JsonWriter* out) { out.write_i64((i64)*self); } }
impl ToJson for i32 { void to_json(*self, JsonWriter* out) { out.write_i64((i64)*self); } }
impl ToJson for i64 { void to_json(*self, JsonWriter* out) { out.write_i64(*self); } }
impl ToJson for u8 { void to_json(*self, JsonWriter* out) { out.write_u64((u64)*self); } }
impl ToJson for u16 { void to_json(*self, JsonWriter* out) { out.write_u64((u64)*self); } }
impl ToJson for u32 { void to_json(*self, JsonWriter* out) { out.write_u64((u64)*self); } }
impl ToJson for u64 { void to_json(*self, JsonWriter* out) { out.write_u64(*self); } }
impl ToJson for f64 { void to_json(*self, JsonWriter* out) { out.write_f64(*self); } }
impl ToJson for f32 { void to_json(*self, JsonWriter* out) { out.write_f64((f64)*self); } }
impl ToJson for bool { void to_json(*self, JsonWriter* out) { out.write_bool(*self); } }
impl ToJson for str { void to_json(*self, JsonWriter* out) { out.write_string(*self); } }
impl ToJson for String { void to_json(*self, JsonWriter* out) { out.write_string((str)self.data); } }
impl<T> ToJson for Optional<T> {
    void to_json(*self, JsonWriter* out) {
        if (self.is_none()) {
            out.write_null();
            return;
        }
        // unwrap consumes the optional (by-value receiver), so restore the
        // payload afterwards: serialization must not move the caller's value.
        T inner = (*self).unwrap();
        inner.to_json(out);
        *self = Optional.Some(move inner);
    }
}


impl FromJson for i64 {
    Result<i64, JsonError> from_json(JsonReader* input) {
        i64 value = 0;
        if (!input.read_i64(&mut value)) {
            JsonError error = JsonError.at_index(input.index);
            return Err(move error);
        }
        return Ok(value);
    }
}

impl FromJson for i32 {
    Result<i32, JsonError> from_json(JsonReader* input) {
        i32 value = 0;
        if (!input.read_i32(&mut value)) {
            JsonError error = JsonError.at_index(input.index);
            return Err(move error);
        }
        return Ok(value);
