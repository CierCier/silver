        if (!input.read_u64(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        return Ok((u16)value);
    }
}

impl FromJson for u32 {
    Result<u32, JsonError> from_json(JsonReader* input) {
        u64 value = 0;
        if (!input.read_u64(&value)) {
            JsonError error = JsonError.invalid();
            return Err(move error);
        }
        return Ok((u32)value);
    }
}

