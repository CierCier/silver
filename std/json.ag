impl<T> JsonDecode for Optional<T> {
    Result<Optional<T>, JsonError> json_decode(*self, JsonReader* input) {
        input.skip_whitespace();
        u8* bytes = (u8*)input.input;
        if (input.index < input.length && bytes[input.index] == (u8)110) {
            if (input.literal("null")) {
                Optional<T> none = None;
                return Ok(move none);
            }
        }
        // Zero-init local anchors the element-type dispatch.
        T slot;
        Result<T, JsonError> inner = slot.json_decode(input);
        if (inner.is_err()) {
            return Err(inner.unwrap_err());
        }
        Optional<T> some = Some(inner.unwrap());
        return Ok(move some);
    }
}

impl<T> JsonDecode for Vec<T> {
    Result<Vec<T>, JsonError> json_decode(*self, JsonReader* input) {
        Vec<T> out = Vec<T>.new();
        if (!input.begin_array()) {
            JsonError error = JsonError.at_index(input.index);
            return Err(move error);
        }
        bool first = true;
        bool elem_failed = false;
        JsonError elem_error = JsonError.invalid();
        while (true) {
            input.skip_whitespace();
            if (input.failed) { break; }
            u8* bytes = (u8*)input.input;
            if (input.index < input.length && bytes[input.index] == (u8)93) {
                input.index = input.index + 1;
                break;
            }
            if (!first) {
                if (!input.comma()) { break; }
                input.skip_whitespace();
                if (input.failed) { break; }
                if (input.index < input.length && bytes[input.index] == (u8)93) {
                    // Trailing comma before the closing bracket.
                    input.failed = true;
                    break;
                }
            }
            // Zero-init local anchors the element-type dispatch.
            T slot;
            Result<T, JsonError> elem = slot.json_decode(input);
            if (elem.is_err()) {
                elem_failed = true;
                elem_error = elem.unwrap_err();
                break;
            }
            out.push(elem.unwrap());
            first = false;
        }
        if (input.failed) {
            out.dispose();
            JsonError error = JsonError.at_index(input.index);
            return Err(move error);
        }
        if (elem_failed) {
            out.dispose();
            return Err(move elem_error);
        }
        return Ok(move out);
    }
}

impl<T> ToJson for Vec<T> {
    void to_json(*self, JsonWriter* out) {
        out.begin_array();
        i64 i = 0;
        while (i < self.len) {
            self.data[i].to_json(out);
            i = i + 1;
        }
        out.end_array();
    }
}

impl<T> FromJson for Vec<T> {
    Result<Vec<T>, JsonError> from_json(JsonReader* input) {
        Vec<T> slot;
        return slot.json_decode(input);
    }
}

impl JsonDispose for i8 { void dispose(*self) {} }
impl JsonDispose for i16 { void dispose(*self) {} }
impl JsonDispose for i32 { void dispose(*self) {} }
impl JsonDispose for i64 { void dispose(*self) {} }
impl JsonDispose for u8 { void dispose(*self) {} }
impl JsonDispose for u16 { void dispose(*self) {} }
impl JsonDispose for u32 { void dispose(*self) {} }
impl JsonDispose for u64 { void dispose(*self) {} }
impl JsonDispose for i128 { void dispose(*self) {} }
impl JsonDispose for u128 { void dispose(*self) {} }
impl JsonDispose for f32 { void dispose(*self) {} }
impl JsonDispose for f64 { void dispose(*self) {} }
impl JsonDispose for bool { void dispose(*self) {} }
impl JsonDispose for str { void dispose(*self) {} }

impl JsonDispose for String {
    void dispose(*self) {
        self.drop();
    }
}

impl<T> JsonDispose for Optional<T> {
    void dispose(*self) {
        if (self.is_none()) { return; }
        T inner = (*self).unwrap();
        inner.dispose();
        *self = Optional<T>.none();
    }
}

impl<T> JsonDispose for Vec<T> {
    void dispose(*self) {
        i64 i = 0;
        while (i < self.len) {
            self.data[i].dispose();
            i = i + 1;
        }
        self.drop();
    }
}

