/// Boxed heap-allocated values.
///
/// `Box<T>` is a smart pointer that owns a dynamically allocated value of type `T` on the heap.
/// When the box goes out of scope, its destructor is automatically called, freeing the allocated memory.
///
/// LIMITATION: `Box<T>::new` copies `val` into the heap slot (the by-value
/// param is then dropped at callee exit), so an owned `T` (String, Vec, …)
/// leaves the box holding dangling pointers — use Box for POD/plain types
/// until move-into-deref (`*p = move val`) is supported.

import std.mem;
import std.mem.drop;

struct Box<T> {
    T* ptr;
}

impl Box<T> {
    /// Allocates memory on the heap and moves `val` into it, returning a new `Box<T>`.
    /// POD-only today (see the struct note): owned T double-frees on drop.
    Box<T> new(T val) {
        T* p = alloc<T>();
        *p = val;
        Box<T> b;
        b.ptr = p;
        return b;
    }

    /// Returns a pointer to the inner boxed value.
    T* get(Box<T>* self) {
        return self.ptr;
    }
}

impl<T> Drop for Box<T> {
    /// Frees the heap-allocated memory associated with this box.
    void drop(Box<T>* self) {
        if (self.ptr != (T*)0) {
            free(self.ptr);
            self.ptr = (T*)0;
        }
    }
}
