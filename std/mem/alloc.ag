// Pure-Silver heap allocator — page-aligned free lists over mmap/munmap.
//
// Replaces the libc malloc/calloc/realloc/free externs with a self-contained
// allocator built directly on the raw sys_mmap/sys_munmap syscall wrappers.
//
// Layout
// ──────
// Every allocation carries a 16-byte header immediately before the user
// pointer, so user data is always 16-byte aligned:
//     header[0] (i64): payload capacity in bytes
//     header[1] (i64): tag
//         0..8  → size-class index (block lives in a shared free-list chunk)
//         < 0   → huge allocation with its own mmap;
//                 tag = -1 - (offset from mmap base to the header)
//
///
/// Small allocations (≤ 4096 bytes, alignment ≤ 64) come from per-class
/// free lists. Classes are powers of two from 16 to 4096 bytes. When a
/// list is empty a 64 KiB chunk is mmap'd and carved into blocks; chunks
/// are never returned to the OS (blocks recycle through the free list).
///
/// Huge allocations (> 4096 bytes, or alignment > 64) get a dedicated mmap
/// and are munmap'd on free.
///
/// Size-0 allocations return a dangling non-null pointer; freeing null or a
/// dangling pointer is a no-op.
///
/// Allocator state is a static .bss struct of free-list heads, zero-initialized
/// by the OS loader — no lazy init, no hot-path branch.

import std.sys.raw.fs;
import std.sys.raw.memory;
import std.sys.raw.process;
import std.mem.memory;
import std.rt.backtrace;
import std.atomic;
// Static free-list head table in .bss — eliminates lazy-init branch on every
// alloc/free. Zero-initialized by the OS loader at program startup.
i64 g_mem_heads[9];
const i64 MEM_NUM_CLASSES = 9;
const i64 MEM_HEADER_SIZE = 16;
const i64 MEM_PAGE_SIZE = 4096;
const i64 MEM_MIN_VALID_ADDR = 65536; // 64 KiB — Linux vm.mmap_min_addr
const i64 MEM_CHUNK_SIZE = 65536;
const i64 MEM_MAX_CLASS_SIZE = 4096;

// -- OS page primitives -----------------------------------------------------

/// mmap `len` bytes of zeroed anonymous read/write memory.
/// Returns null on failure.
u8* mem_sys_alloc(i64 len) {
    // PROT_READ|PROT_WRITE = 3, MAP_PRIVATE|MAP_ANONYMOUS = 34, fd = -1
    i64 r = sys_mmap(0, len, 3, 34, -1, 0);
    if (r < 0) {
        return (u8*)0;
    }
    return (u8*)r;
}

/// Return a mapping to the OS.
void mem_sys_free(u8* base, i64 len) {
    if (base != (u8*)0) {
        sys_munmap((i64)base, len);
    }
}

// -- Internal helpers -------------------------------------------------------

i64 mem_align_up(i64 value, i64 alignment) {
    if (alignment <= 1) {
        return value;
    }
    i64 remainder = value % alignment;
    if (remainder == 0) {
        return value;
    }
    return value + alignment - remainder;
}

i64 mem_page_round(i64 n) {
    return mem_align_up(n, MEM_PAGE_SIZE);
}

/// Dangling non-null pointer used for size-0 allocations.
/// Lies inside the (never-mapped) zero page, so free() can detect it.
u8* mem_dangling(i64 align) {
    i64 a = 16;
    if (align > 16) {
        a = align;
    }
    // Cap the dangling sentinel value to ensure it lies safely below
    // the MEM_MIN_VALID_ADDR boundary.
    if (a >= MEM_MIN_VALID_ADDR) {
        a = 16;
    }
    return (u8*)a;
}

/// Free-list head table (static `.bss` — always available).
i64* mem_heads() {
    return g_mem_heads;
}

/// Smallest size class index whose payload holds `size` bytes.
i64 mem_class_index(i64 size) {
    i64 idx = 0;
    i64 csize = 16;
    while (csize < size) {
        csize = csize * 2;
        idx += 1;
    }
    return idx;
}

i64 mem_class_size(i64 idx) {
    i64 csize = 16;
    for (i64 i = 0; i < idx; i = i + 1) {
        csize = csize * 2;
    }
    return csize;
}

/// Carve a fresh chunk into blocks for class `idx` and push them on its list.
void mem_refill(i64* heads, i64 idx) {
    i64 csize = mem_class_size(idx);
    i64 stride = csize + MEM_HEADER_SIZE;
    u8* chunk = mem_sys_alloc(MEM_CHUNK_SIZE);
    if (chunk == (u8*)0) {
        return;
    }
    i64 count = MEM_CHUNK_SIZE / stride;
    i64 head = heads[idx];
    // Push blocks in reverse so the lowest address pops first.
    for (i64 i = count - 1; i >= 0; i = i - 1) {
        i64 h = (i64)chunk + i * stride;
        i64* header = (i64*)h;
        header[0] = csize;
        header[1] = idx;
        // While free, the first payload word is the next-free link.
        i64* link = (i64*)(h + MEM_HEADER_SIZE);
        link[0] = head;
        head = h;
    }
    heads[idx] = head;
}

// -- Thread safety ----------------------------------------------------------
//
// The free-list head table (g_mem_heads) and the leak-check tables are shared
// mutable state. v0 makes the size-class paths of alloc/free mutually
// exclusive with a whole-allocator spinlock so multiple 1:1 OS threads can
// allocate and free concurrently (huge allocations talk only to the kernel via
// mmap/munmap and touch no shared state, so they take no lock).
//
// The lock is a plain i32 in .bss (0 = free, 1 = held) guarded by the
// `__atomic_cmpxchg_i32` / `__atomic_store_i32` intrinsics.

/// Allocator spinlock state. 0 = free, 1 = held.
i32 g_mem_lock;

/// Acquire the allocator spinlock, spinning until the CAS succeeds.
void mem_lock_acquire() {
    while (true) {
        bool acquired = __atomic_cmpxchg_i32(&g_mem_lock, 0, 1, ATOMIC_SEQ_CST, ATOMIC_ACQUIRE);
        if (acquired) {
            return;
        }
    }
}

/// Release the allocator spinlock.
void mem_lock_release() {
    __atomic_store_i32(&g_mem_lock, 0, ATOMIC_RELEASE);
}

// -- Raw allocator core -----------------------------------------------------

/// Core allocation: `size` bytes with at least `align` alignment.
/// Returns dangling non-null for size <= 0, null on OOM.
u8* mem_alloc_raw_impl(i64 size, i64 align) {
    if (size <= 0) {
        return mem_dangling(align);
    }
    if (align <= MEM_HEADER_SIZE && size <= MEM_MAX_CLASS_SIZE) {
        mem_lock_acquire();
        i64* heads = mem_heads();
        i64 idx = mem_class_index(size);
        if (heads[idx] == 0) {
            mem_refill(heads, idx);
        }
        i64 h = heads[idx];
        if (h == 0) {
            mem_lock_release();
            return (u8*)0;
        }
        i64* link = (i64*)(h + MEM_HEADER_SIZE);
        heads[idx] = link[0];
        mem_lock_release();
        return (u8*)(h + MEM_HEADER_SIZE);
    }
    // Huge (or over-aligned) allocation: dedicated mapping, no shared state.
    i64 extra = 0;
    if (align > MEM_HEADER_SIZE) {
        extra = align;
    }
    i64 total = mem_page_round(size + MEM_HEADER_SIZE + extra);
    u8* base = mem_sys_alloc(total);
    if (base == (u8*)0) {
        return (u8*)0;
    }
    i64 user = (i64)base + MEM_HEADER_SIZE;
    if (align > MEM_HEADER_SIZE) {
        user = mem_align_up(user, align);
    }
    i64 h = user - MEM_HEADER_SIZE;
    i64 offset = h - (i64)base;
    i64* header = (i64*)h;
    header[0] = total - offset - MEM_HEADER_SIZE;
    header[1] = 0 - 1 - offset;
    return (u8*)user;
}

/// Core free. Tolerates null and dangling pointers.
void mem_free_raw_impl(u8* ptr) {
    i64 a = (i64)ptr;
    if (a < MEM_MIN_VALID_ADDR) {
        // Null or dangling (zero-page) pointer: no-op.
        return;
    }
    mem_lock_acquire();
    i64* header = (i64*)(a - MEM_HEADER_SIZE);
    i64 tag = header[1];
    if (tag >= 0 && tag < MEM_NUM_CLASSES) {
        i64* heads = mem_heads();
        i64* link = (i64*)a;
        link[0] = heads[tag];
        heads[tag] = a - MEM_HEADER_SIZE;
        mem_lock_release();
        return;
    }
    mem_lock_release();
    if (tag < 0) {
        i64 offset = 0 - 1 - tag;
        i64 total = offset + MEM_HEADER_SIZE + header[0];
        mem_sys_free((u8*)(a - MEM_HEADER_SIZE - offset), total);
    }
    // Unknown tag: defensive no-op.
}

// -- Leak-check runtime (allocation-free, static tracking) -------------------
//
// When the compiler's --leak-check flag is active, the codegen emits a constant
// global __silver_leak_check_enabled = true.  The allocator checks this global
// and routes every allocation/free through tracking functions that detect
// leaks, double-frees, and buffer overflows without doing any dynamic
// allocation themselves.

extern "C" { bool __silver_leak_check_enabled; }

const i64 LEAK_MAX_RECORDS = 65536;
const i64 LEAK_CANARY_LIVE = 0x4C4956454C495645;  // "LIVELIVE"
const i64 LEAK_CANARY_DEAD = 0x4445414444454144;  // "DEADDEAD"

i64 __leak_user_ptrs[65536];
i64 __leak_raw_ptrs[65536];
i64 __leak_sizes[65536];
i64 __leak_callers[65536];
u8 __leak_states[65536]; // 0 empty, 1 live, 2 freed, 3 ignored (global cache)

// -- Raw stderr helpers (no allocation, no BufWriter) ------------------------

void __silver_leak_write_str(str msg) {
    if (msg == (str)0) { return; }
    u8* p = (u8*)msg;
    i64 len = 0;
    while (p[len] != (u8)0) { len = len + 1; }
    sys_write(2, (i64)msg, len);
}

void __silver_leak_write_hex(i64 v) {
    u8 buf[19];
    i64 i = 0;
    if (v == 0) {
        buf[0] = (u8)48;
        i = 1;
    } else {
        i64 pos = 18;
        while (v != 0 && pos >= 0) {
            i64 d = v & (i64)15;
            if (d < 10) {
                buf[pos] = (u8)(48 + d);
            } else {
                buf[pos] = (u8)(87 + d);
            }
            v = v >> (i64)4;
            pos = pos - 1;
        }
        while (pos < 18) {
            pos = pos + 1;
            buf[i] = buf[pos];
            i = i + 1;
        }
    }
    sys_write(2, (i64)buf, i);
}

void __silver_leak_write_i64(i64 v) {
    if (v < 0) {
        sys_write(2, (i64)"-", 1);
        v = 0 - v;
    }
    u8 buf[20];
    i64 i = 20;
    if (v == 0) {
        i = i - 1;
        buf[i] = (u8)48;
    } else {
        while (v != 0) {
            i = i - 1;
            buf[i] = (u8)(48 + (v % (i64)10));
            v = v / (i64)10;
        }
    }
    sys_write(2, (i64)&buf[i], 20 - i);
}

void __silver_leak_abort(str msg) {
    __silver_leak_write_str("leak-check: ");
    __silver_leak_write_str(msg);
    sys_write(2, (i64)"\n", 1);
    sys_exit_group(1);
    while (true) {}
}

// -- Alignment helper (local to avoid import cycle) --------------------------

i64 __leak_align_up(i64 value, i64 alignment) {
    if (alignment <= 1) {
        return value;
    }
    i64 remainder = value % alignment;
    if (remainder == 0) {
        return value;
    }
    return value + alignment - remainder;
}

// -- Tracking insert/find ----------------------------------------------------

i64 __leak_find_empty() {
    for (i64 i = 0; i < LEAK_MAX_RECORDS; i = i + 1) {
        if (__leak_states[i] == (u8)0 || __leak_states[i] == (u8)2) {
            return i;
        }
    }
    return -1;
}

i64 __leak_find_user(i64 user) {
    for (i64 i = 0; i < LEAK_MAX_RECORDS; i = i + 1) {
        if ((__leak_states[i] == (u8)1 || __leak_states[i] == (u8)3)
            && __leak_user_ptrs[i] == user) {
            return i;
        }
    }
    return -1;
}

/// Mark a live allocation as intentionally process-lifetime (a global
/// cache, a static buffer): the leak report skips it, but frees still work
/// (an evicted cache entry releases its memory normally).
void __silver_leak_ignore(u8* ptr) {
    i64 user = (i64)ptr;
    if (user < MEM_MIN_VALID_ADDR) {
        return;
    }
    i64 slot = __leak_find_user(user);
    if (slot >= 0) {
        __leak_states[slot] = (u8)3;
    }
}

// -- Public allocation hooks -------------------------------------------------

u8* __silver_leak_alloc(i64 size, i64 align) {
    if (size <= 0) {
        return mem_alloc_raw_impl(size, align);
    }
    // Allocate extra for canaries + alignment slop
    i64 raw_size = size + align + 16;
    u8* raw = mem_alloc_raw_impl(raw_size, align);
    if (raw == (u8*)0) {
        __silver_leak_abort("allocation failed");
    }
    i64 user = __leak_align_up((i64)raw + 8, align);
    // Live canary before user data
    i64* canary_before = (i64*)(user - 8);
    canary_before[0] = LEAK_CANARY_LIVE;
    // Live canary after user data
    i64* canary_after = (i64*)(user + size);
    canary_after[0] = LEAK_CANARY_LIVE;

    i64 slot = __leak_find_empty();
    if (slot < 0) {
        __silver_leak_abort("record table full");
    }
    __leak_user_ptrs[slot] = user;
    __leak_raw_ptrs[slot] = (i64)raw;
    __leak_sizes[slot] = size;
    __leak_states[slot] = (u8)1;

    i64 alloc_caller = 0;
    i64 cur_rbp = bt_read_rbp();
    i64 depth = 0;
    while (cur_rbp > 65536 && depth < 8) {
        i64* p_rbp = (i64*)cur_rbp;
        i64 next_rbp = *p_rbp;
        if (next_rbp <= cur_rbp || next_rbp < 65536) {
            break;
        }
        i64* p_ret = (i64*)(cur_rbp + 8);
        i64 ret_addr = *p_ret;
        if (ret_addr > 65536) {
            alloc_caller = ret_addr;
            i64 idx = bt_resolve(ret_addr);
            if (idx >= 0) {
                BtEntry e = __silver_bt_entries[idx];
                if (e.file != (u8*)0
                    && strcmp((const char*)e.file, (const char*)"alloc.ag") != 0
                    && strcmp((const char*)e.name, (const char*)"mem_alloc_impl") != 0
                    && strcmp((const char*)e.name, (const char*)"__silver_leak_alloc") != 0) {
                    break;
                }
            }
        }
        cur_rbp = next_rbp;
        depth = depth + 1;
    }
    __leak_callers[slot] = alloc_caller;
    return (u8*)user;
}

void __silver_leak_free(u8* ptr) {
    i64 user = (i64)ptr;
    if (user < MEM_MIN_VALID_ADDR) {
        // Null or dangling pointer: no-op, matching mem_free_impl.
        return;
    }
    i64 slot = __leak_find_user(user);
    if (slot < 0) {
        __silver_leak_abort("invalid or double free");
    }
    i64 size = __leak_sizes[slot];
    // Check canaries
    i64* canary_before = (i64*)(user - 8);
    i64* canary_after = (i64*)(user + size);
    if (canary_before[0] != LEAK_CANARY_LIVE || canary_after[0] != LEAK_CANARY_LIVE) {
        __silver_leak_abort("buffer overflow or corrupted allocation");
    }
    // Write dead canaries
    canary_before[0] = LEAK_CANARY_DEAD;
    canary_after[0] = LEAK_CANARY_DEAD;
    // Mark freed
    __leak_states[slot] = (u8)2;
    // Free the raw storage
    mem_free_raw_impl((u8*)__leak_raw_ptrs[slot]);
}

u8* __silver_leak_realloc(u8* ptr, i64 new_size, i64 align) {
    i64 user = (i64)ptr;
    if (user < MEM_MIN_VALID_ADDR) {
        return __silver_leak_alloc(new_size, align);
    }
    if (new_size <= 0) {
        __silver_leak_free(ptr);
        return mem_alloc_raw_impl(0, align);
    }
    i64 slot = __leak_find_user(user);
    if (slot < 0) {
        __silver_leak_abort("invalid or double free in realloc");
    }
    i64 old_size = __leak_sizes[slot];
    u8* fresh = __silver_leak_alloc(new_size, align);
    if ((i64)fresh < MEM_MIN_VALID_ADDR) {
        return (u8*)0;
    }
    i64 copy_n = old_size;
    if (new_size < old_size) {
        copy_n = new_size;
    }
    silver_rt_memcpy(fresh, ptr, copy_n);
    __silver_leak_free(ptr);
    return fresh;
}

i32 __silver_leak_check_report() {
    if (!__silver_leak_check_enabled) {
        return 0;
    }
    i32 count = 0;
    for (i64 i = 0; i < LEAK_MAX_RECORDS; i = i + 1) {
        if (__leak_states[i] == (u8)1) {
            __silver_leak_write_str("leak-check: leak ptr=0x");
            __silver_leak_write_hex(__leak_user_ptrs[i]);
            __silver_leak_write_str(" size=");
            __silver_leak_write_i64(__leak_sizes[i]);
            i64 caller = __leak_callers[i];
            if (caller > 0) {
                i64 idx = bt_resolve(caller);
                if (idx >= 0) {
                    BtEntry e = __silver_bt_entries[idx];
                    __silver_leak_write_str(" allocated at ");
                    __silver_leak_write_str((str)e.name);
                    u8* file = (u8*)0;
                    i64 line = 0;
                    bt_line_lookup(e.addr, caller, &file, &line);
                    if (line > 0 && file != (u8*)0) {
                        __silver_leak_write_str(" (");
                        __silver_leak_write_str((str)file);
                        __silver_leak_write_str(":");
                        __silver_leak_write_i64(line);
                        __silver_leak_write_str(")");
                    } else if (e.line > 0 && e.file != (u8*)0) {
                        __silver_leak_write_str(" (");
                        __silver_leak_write_str((str)e.file);
                        __silver_leak_write_str(":");
                        __silver_leak_write_i64(e.line);
                        __silver_leak_write_str(")");
                    }
                }
            }
            __silver_leak_write_str("\n");
            count = count + 1;
        }
    }
    return count;
}

// -- Checked wrappers (routed through leak-check hooks when enabled) ---------

u8* mem_alloc_impl(i64 size, i64 align) {
    if (__silver_leak_check_enabled) {
        return __silver_leak_alloc(size, align);
    }
    return mem_alloc_raw_impl(size, align);
}

void mem_free_impl(u8* ptr) {
    if (__silver_leak_check_enabled) {
        __silver_leak_free(ptr);
        return;
    }
    mem_free_raw_impl(ptr);
}

/// Core realloc. Null/dangling input behaves like a fresh allocation;
/// new_size <= 0 frees and returns a dangling pointer.
u8* mem_realloc_impl(u8* ptr, i64 new_size, i64 align) {
    if (__silver_leak_check_enabled) {
        return __silver_leak_realloc(ptr, new_size, align);
    }
    i64 a = (i64)ptr;
    if (a < MEM_MIN_VALID_ADDR) {
        return mem_alloc_raw_impl(new_size, align);
    }
    if (new_size <= 0) {
        mem_free_raw_impl(ptr);
        return mem_dangling(align);
    }
    i64* header = (i64*)(a - MEM_HEADER_SIZE);
    i64 cap = header[0];
    if (new_size <= cap) {
        return ptr;
    }
    u8* fresh = mem_alloc_raw_impl(new_size, align);
    if (fresh == (u8*)0) {
        return (u8*)0;
    }
    silver_rt_memcpy(fresh, ptr, cap);
    mem_free_raw_impl(ptr);
    return fresh;
}

// -- Frozen C-ABI runtime surface (mirrors silver_runtime ffi.rs) -----------

/// Allocate `size` bytes with `align` alignment.
/// Size 0 returns a dangling non-null pointer; OOM returns null.
u8* silver_rt_alloc(i64 size, i64 align) {
    return mem_alloc_impl(size, align);
}

/// Allocate zeroed memory (same contract as silver_rt_alloc).
u8* silver_rt_alloc_zeroed(i64 size, i64 align) {
    u8* ptr = mem_alloc_impl(size, align);
    if ((i64)ptr >= MEM_MIN_VALID_ADDR) {
        i64* header = (i64*)((i64)ptr - MEM_HEADER_SIZE);
        if (header[1] >= 0) {
            // Recycled size-class block: may hold stale data.
            // (Huge blocks are freshly mmap'd and already zeroed.)
            silver_rt_memset(ptr, (u8)0, size);
        }
    }
    return ptr;
}

/// Reallocate to `new_size`. new_size 0 deallocates and returns dangling;
/// null input behaves like silver_rt_alloc.
u8* silver_rt_realloc(u8* ptr0, i64 old_size, i64 new_size, i64 align) {
    if (new_size <= 0) {
        silver_rt_dealloc(ptr0, old_size, align);
        return mem_dangling(align);
    }
    return mem_realloc_impl(ptr0, new_size, align);
}

/// Deallocate. Null pointer or size 0 is a no-op.
void silver_rt_dealloc(u8* ptr0, i64 size, i64 align) {
    if ((i64)ptr0 == 0 || size <= 0) {
        return;
    }
    mem_free_impl(ptr0);
}

// -- libc-compatible shims --------------------------------------------------
// Keep existing std/ call sites (malloc/calloc/realloc/free) compiling
// unchanged, routed through the pure-Silver allocator.

void* malloc(i64 size) {
    return (void*)mem_alloc_impl(size, 16);
}

void* calloc(i64 count, i64 size) {
    if (count > 0) {
        if (size > 9223372036854775807 / count) {
            return (void*)0;
        }
    }
    i64 total = count * size;
    u8* ptr = mem_alloc_impl(total, 16);
    if ((i64)ptr >= MEM_MIN_VALID_ADDR) {
        i64* header = (i64*)((i64)ptr - MEM_HEADER_SIZE);
        if (header[1] >= 0) {
            silver_rt_memset(ptr, (u8)0, total);
        }
    }
    return (void*)ptr;
}

/// Raw byte-oriented realloc shim (used by the generic element-count API
/// and the containers; named distinctly so it cannot collide with the
/// generic `realloc<T>` overload during monomorphization).
void* realloc_bytes(void* ptr, i64 new_size) {
    return (void*)mem_realloc_impl((u8*)ptr, new_size, 16);
}

void free(void* ptr) {
    mem_free_impl((u8*)ptr);
}

// -- Generic typed interface ------------------------------------------------

// Fallible allocation (returns null on OOM). Legacy naming preserved for
// callers that handle OOM explicitly. Prefer `alloc<T>` / `realloc<T>` for
// new code — they abort on OOM, matching Rust/Zig safe defaults.

T* try_alloc<T>() {
    return (T*)(malloc(@size(T)));
}

T* try_alloc<T>(i64 count) {
    return (T*)(calloc(count, @size(T)));
}

T* try_realloc<T>(T* ptr, i64 count) {
    return (T*)(realloc_bytes(ptr, @size(T) * count));
}

// Abort-on-OOM variants (safe default). These call `abort()` from std.mem.memory
// when allocation fails, providing explicit failure instead of a segfault.

T* alloc<T>() {
    T* ptr = try_alloc<T>();
    if (ptr == (T*)0) {
        abort();
    }
    return ptr;
}

T* alloc<T>(i64 count) {
    T* ptr = try_alloc<T>(count);
    if (ptr == (T*)0) {
        abort();
    }
    return ptr;
}

T* realloc<T>(T* ptr, i64 count) {
    T* result = try_realloc<T>(ptr, count);
    if (result == (T*)0) {
        abort();
    }
    return result;
}
