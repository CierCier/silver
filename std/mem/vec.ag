// Generic contiguous-growable array (Vec<T>).
//
// Memory management (malloc/realloc/free) is linked from the C runtime;
// callers pay only for elements they push.  O(1) amortized push, O(1) index.
//
// A Vec<T>'s drop method frees the backing buffer automatically.
//
// LIMITATIONS
// ───────────
// Drop does NOT call per-element destructors — the type system cannot
// currently iterate elements on drop.  For owned-element types, use
// `get_ptr` for read-only access and `take` to extract values before
// the Vec goes out of scope.  POD types (i32, structs of i32, etc.)
// are always safe.
import std.mem.alloc;
import std.mem.drop;
import std.ops;
import std.optional;
import std.iter;
/// A contiguous, growable array type.
struct Vec<T> {
    T* data;
    i64 len;
    i64 cap;
}

impl Vec<T> {
    /// Empty vector — no allocation.
    Vec<T> new() {
        Vec<T> v;
        v.data = (T*)0;
        v.len = 0;
        v.cap = 0;
        return v;
    }

    /// Reserve space for `capacity` elements up front.
    Vec<T> with_capacity(i64 capacity) {
        Vec<T> v;
        v.data = (T*)(0);
        if (capacity != 0) {
            v.data = (T*)(malloc(@size(T) * capacity));
        }
        v.len = 0;
        v.cap = capacity;
        return v;
    }

    // -- Size / capacity ------------------------------------------------

    /// Number of elements currently in the vector.
    i64 len(&Vec<T> self) {
        return self.len;
    }

    /// Total allocated capacity.
    i64 capacity(&Vec<T> self) {
        return self.cap;
    }

    /// True when `len` is zero.
    bool is_empty(&Vec<T> self) {
        return self.len == 0;
    }

    // -- Element access -------------------------------------------------

    /// Read element at `index`.  Returns a COPY — for owned-element types
    /// this creates a shallow copy that shares resources with the backing
    /// buffer.  Prefer `get_ptr` or `take` for owned types.
    /// Out-of-bounds indices abort deterministically in every build profile.
    T get(&Vec<T> self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }

    /// Read element at `index`, returning None when out of bounds.
    Optional<T> try_get(&Vec<T> self, i64 index) {
        if (index < 0 || index >= self.len) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.data[index]);
    }

    /// Pointer to element at `index`.
    /// Out-of-bounds indices abort deterministically in every build profile.
    T* get_ptr(&Vec<T> self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return &(self.data[index]);
    }

    /// Overwrite element at `index`.
    /// Out-of-bounds indices abort deterministically in every build profile.
    void set(&mut Vec<T> self, i64 index, T value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = move value;
    }

    // -- Mutation -------------------------------------------------------

    /// Append `value` to the end (O(1) amortized).
    void push(&mut Vec<T> self, T value) {
        if (self.len >= self.cap) {
            i64 new_cap = 1;
            if (self.cap != 0) {
                new_cap = self.cap * 2;
            }
            self.data = (T*)(realloc<T>(self.data, new_cap));
            self.cap = new_cap;
        }
        self.data[self.len] = move value;
        self.len = self.len + 1;
    }

    /// Remove and return the last element.  Assumes `len > 0`.
    /// The stale slot retains a copy; do NOT read a popped index.
    T pop(&mut Vec<T> self) {
        self.len = self.len - 1;
        T result = self.data[self.len];
        return result;
    }

    /// Move value out of position `index`, removing it from the Vec: the
    /// tail shifts left and `len` shrinks, so the slot is truly vacated
    /// (drain with `take(0)` repeatedly, or `pop()` for LIFO).
    T take(&mut Vec<T> self, i64 index) {
        T result = self.data[index];
        i64 i = index;
        while (i + 1 < self.len) {
            self.data[i] = self.data[i + 1];
            i = i + 1;
        }
        self.len = self.len - 1;
        return result;
    }

    /// Remove all elements without freeing the backing buffer.
    void clear(&mut Vec<T> self) {
        self.len = 0;
    }

    /// Reserve at least `min_capacity` elements, growing if needed.
    void reserve(&mut Vec<T> self, i64 min_capacity) {
        if (self.cap >= min_capacity) {
            return;
        }
        self.data = realloc<T>(self.data, min_capacity);
        self.cap = min_capacity;
    }

    /// Shrink capacity to match length.
    void shrink_to_fit(&mut Vec<T> self) {
        if (self.len == 0) {
            if (self.data != (T*)0) {
                free(self.data);
            }
            self.data = (T*)0;
            self.cap = 0;
        } else {
            if (self.len < self.cap) {
                self.data = realloc<T>(self.data, self.len);
                self.cap = self.len;
            }
        }
    }
}

impl<T> Drop for Vec<T> {
    /// Frees the backing buffer.  Does NOT call per-element destructors
    /// (the type system currently does not iterate elements on drop).
    void drop(Vec<T>* self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.cap = 0;
    }
}
impl<T> IndexedAccess for Vec<T> {
    type Item = T;
    T __index_get(Vec<T>* self, i64 index) {
        // Deterministic in all build profiles — release builds must not
        // index out of bounds silently (UB).
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }
    void __index_set(Vec<T>* self, i64 index, T value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = move value;
    }
}

// -- Iterator support ---------------------------------------------------
//
// VecIter<T> is an iterator over Vec<T> elements. into_iter() consumes the
// Vec: it hands the backing buffer to the iterator and clears the Vec's
// fields so the Vec's own drop is a no-op. VecIter OWNS the buffer after
// that transfer and frees it in its Drop (a VecIter left un-drained leaks
// the buffer otherwise). The iterator itself never frees element values —
// iterate owned elements with get_ptr/drop like the Vec contract.

/// Iterator over Vec<T> elements (owns the backing buffer after into_iter).
struct VecIter<T> {
    T* data;
    i64 len;
    i64 idx;
}

impl<T> Drop for VecIter<T> {
    void drop(VecIter<T>* self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.idx = 0;
    }
}

impl<T> Vec<T> {
    /// Consume the Vec and return an iterator over its elements. The
    /// backing buffer transfers to the iterator, which frees it on drop
    /// (the Vec's fields are cleared so its own drop is a no-op).
    VecIter<T> into_iter(Vec<T>* self) {
        VecIter<T> iter;
        iter.data = self.data;
        iter.len = self.len;
        iter.idx = 0;
        self.data = (T*)0;
        self.len = 0;
        self.cap = 0;
        return iter;
    }
}

impl<T> Iterator for VecIter<T> {
    type Item = T;
    /// Returns the next element in the iteration sequence, or an empty Optional when done.
    Optional<T> next(VecIter<T>* self) {
        if (self.idx < self.len) {
            T value = self.data[self.idx];
            self.idx = self.idx + 1;
            return Optional<T>.some(value);
        }
        return Optional<T>.none();
    }
}
