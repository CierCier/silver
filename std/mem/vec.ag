// Generic contiguous-growable array (Vec<T>).
//
// Ownership: `push`/`set`/`__index_set` take `T value` by value and `move` it
// into the backing buffer (`self.data[len] = move value`), so owned element
// types (String, Vec<u8>, HashMap, etc.) transfer ownership on push and are
// not double-freed. Growth (`push` reallocation, `reserve`, `shrink_to_fit`)
// moves existing elements via `move old[i] -> new[i]` (Place Index) and frees
// the old buffer without dropping — the new buffer now owns the elements.
// This replaces the earlier POD-only `realloc` byte-copy (which duplicated
// owned pointers and relied on `Drop` not iterating elements). POD types such
// as `i32` expand to a trivial bitwise copy under `move` and remain `Copy`.
//
// Drop still does NOT call per-element destructors — the backing buffer is
// freed via `free` on scope exit. Drain owned elements explicitly via
// `take`, `pop`, `drain`/`into_iter` (each `move`s out) before the Vec drops,
// or iterate the draining iterator to completion. See the ownership smoke
// comment at the bottom of this file.
import std.slice;
// A Vec<T>'s drop method frees the backing buffer automatically.
import std.mem.alloc;
import std.mem.drop;
import std.ops;
import std.optional;
import std.iter;
/// A contiguous, growable array type.
struct Vec<T> {
    T* data;
    i64 len;
    i64 cap;
}

impl Vec<T> {
    /// Empty vector — no allocation.
    Vec<T> new() {
        Vec<T> v;
        v.data = (T*)0;
        v.len = 0;
        v.cap = 0;
        return v;
    }

    /// Reserve space for `capacity` elements up front.
    Vec<T> with_capacity(i64 capacity) {
        Vec<T> v;
        v.data = (T*)(0);
        if (capacity != 0) {
            v.data = (T*)(malloc(@size(T) * capacity));
        }
        v.len = 0;
        v.cap = capacity;
        return v;
    }

    // -- Size / capacity ------------------------------------------------

    /// Number of elements currently in the vector.
    i64 len(&Vec<T> self) {
        return self.len;
    }

    /// Total allocated capacity.
    i64 capacity(&Vec<T> self) {
        return self.cap;
    }

    /// True when `len` is zero.
    bool is_empty(&Vec<T> self) {
        return self.len == 0;
    }

    // -- Element access -------------------------------------------------

    /// Read element at `index`.  Returns a COPY — for owned-element types
    /// this creates a shallow copy that shares resources with the backing
    /// buffer.  Prefer `get_ptr` or `take` for owned types.
    /// Out-of-bounds indices abort deterministically in every build profile.
    T get(&Vec<T> self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }

    /// Read element at `index`, returning None when out of bounds.
    Optional<T> try_get(&Vec<T> self, i64 index) {
        if (index < 0 || index >= self.len) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.data[index]);
    }

    /// Pointer to element at `index`.
    /// Out-of-bounds indices abort deterministically in every build profile.
    T* get_ptr(&Vec<T> self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return &(self.data[index]);
    }

    /// Overwrite element at `index`.
    /// Out-of-bounds indices abort deterministically in every build profile.
    void set(&mut Vec<T> self, i64 index, T value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = move value;
    }

    // -- Mutation -------------------------------------------------------

    /// Append `value` to the end (O(1) amortized).
    /// Growth moves existing elements via `move` (Place Index) — `new[i] = move old[i]`
    /// — so owned T (String, Vec<u8>) transfers ownership without duplicating
    /// the backing pointer; the old buffer is then `free`d (no per-element drop).
    /// For Copy T (i32, POD structs) `move` is a bitwise copy.
    void push(&mut Vec<T> self, T value) {
        if (self.len >= self.cap) {
            i64 new_cap = 1;
            if (self.cap != 0) {
                new_cap = self.cap * 2;
            }
            T* new_data = (T*)(malloc(@size(T) * new_cap));
            if (self.data != (T*)0) {
                i64 i = 0;
                while (i < self.len) {
                    // FIXME: ideal `new_data[i] = move self.data[i]` (Place Index)
                    // needs `move` to accept `Index` (typeck.rs:1767). Use two-step
                    // via `tmp` so `move` is on an identifier and typeck passes.
                    // Old buffer is `free`d without drops, so shallow copy is not
                    // double-freed; replace with direct `move old[i]` once allowed.
                    T tmp = self.data[i];
                    new_data[i] = move tmp;
                    i = i + 1;
                }
                free(self.data);
            }
            self.data = new_data;
            self.cap = new_cap;
        }
        self.data[self.len] = move value;
        self.len = self.len + 1;
    }

    /// Remove and return the last element.  Assumes `len > 0`.
    /// Moves ownership out (`move self.data[len-1]`); the stale slot is left
    /// in a moved-from state and `len` is decremented, so `Copy` T copies and
    /// non-Copy T transfers without duplication.
    T pop(&mut Vec<T> self) {
        self.len = self.len - 1;
        T tmp = self.data[self.len];
        T result = move tmp;
        return move result;
    }

    /// Move value out of position `index`, removing it from the Vec: the
    /// tail shifts left via `move` and `len` shrinks, so the slot is truly
    /// vacated (drain with `take(0)` repeatedly, or `pop()` for LIFO).
    /// Each shifted element is `move`d (`data[i] = move data[i+1]`) leaving the
    /// source in a moved-from state; the trailing slot beyond `len` is ignored.
    T take(&mut Vec<T> self, i64 index) {
        T tmp0 = self.data[index];
        T result = move tmp0;
        i64 i = index;
        while (i + 1 < self.len) {
            T tmp = self.data[i + 1];
            self.data[i] = move tmp;
        }
        self.len = self.len - 1;
        return move result;
    }

    /// Remove all elements without freeing the backing buffer.
    /// NOTE: Does NOT drop elements — for owned T, `drain`/`take`/`pop` first
    /// to move out values (see smoke comment below); otherwise backing memory
    /// is freed but inner allocations (e.g., String buffers) leak.
    void clear(&mut Vec<T> self) {
        self.len = 0;
    }

    /// Reserve at least `min_capacity` elements, growing if needed.
    /// Moves existing elements (`new[i] = move old[i]`) rather than `realloc`
    /// byte-copy; see `push` doc. POD-only `realloc` workaround removed.
    void reserve(&mut Vec<T> self, i64 min_capacity) {
        if (self.cap >= min_capacity) {
            return;
        }
        T* new_data = (T*)(malloc(@size(T) * min_capacity));
        if (self.data != (T*)0) {
            i64 i = 0;
            while (i < self.len) {
                T tmp = self.data[i];
                new_data[i] = move tmp;
                i = i + 1;
            }
            free(self.data);
        }
        self.data = new_data;
        self.cap = min_capacity;
    }

    /// Shrink capacity to match length.
    /// Moves elements via `move` into a right-sized buffer instead of
    /// `realloc` byte-copy; POD-only path removed.
    void shrink_to_fit(&mut Vec<T> self) {
        if (self.len == 0) {
            if (self.data != (T*)0) {
                free(self.data);
            }
            self.data = (T*)0;
            self.cap = 0;
        } else {
            if (self.len < self.cap) {
                T* new_data = (T*)(malloc(@size(T) * self.len));
                i64 i = 0;
                while (i < self.len) {
                    T tmp = self.data[i];
                    new_data[i] = move tmp;
                    i = i + 1;
                }
                free(self.data);
                self.data = new_data;
                self.cap = self.len;
            }
        }
    }
}

impl<T> Drop for Vec<T> {
    /// Frees the backing buffer.  Does NOT call per-element destructors
    /// (the type system currently does not iterate elements on drop).
    void drop(Vec<T>* self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.cap = 0;
    }
}
impl<T> IndexedAccess for Vec<T> {
    type Item = T;
    T __index_get(Vec<T>* self, i64 index) {
        // Deterministic in all build profiles — release builds must not
        // index out of bounds silently (UB).
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }
    void __index_set(Vec<T>* self, i64 index, T value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = move value;
    }
}

// -- Iterator support ---------------------------------------------------
//
// VecIter<T> is an iterator over Vec<T> elements. into_iter() consumes the
// Vec: it hands the backing buffer to the iterator and clears the Vec's
// fields so the Vec's own drop is a no-op. VecIter OWNS the buffer after
// that transfer and frees it in its Drop (a VecIter left un-drained leaks
// the buffer otherwise). The iterator itself never frees element values —
// iterate owned elements with get_ptr/drop like the Vec contract.

/// Iterator over Vec<T> elements (owns the backing buffer after into_iter).
struct VecIter<T> {
    T* data;
    i64 len;
    i64 idx;
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = VecIter<T>;
    VecIter<T> into_iter(Vec<T> self) {
        VecIter<T> iter;
        iter.data = self.data;
        iter.len = self.len;
        iter.idx = 0;
        self.data = (T*)0;
        self.len = 0;
        self.cap = 0;
        return iter;
    }
}

impl<T> Vec<T> {
    Slice<T> as_slice(&Vec<T> self) {
        Slice<T> s;
        s.data = self.data;
        s.len = self.len;
        return s;
    }

    Slice<T> as_mut_slice(&mut Vec<T> self) {
        Slice<T> s;
        s.data = self.data;
        s.len = self.len;
        return s;
    }

    SliceIter<T> iter(&Vec<T> self) {
        SliceIter<T> it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        return it;
    }

    RevIter<T> rev_iter(&Vec<T> self) {
        RevIter<T> r;
        r.data = self.data;
        r.len = self.len;
        r.idx = 0;
        return r;
    }
}

impl<T> Drop for VecIter<T> {
    void drop(VecIter<T>* self) {
        if (self.data != (T*)0) {
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.idx = 0;
    }
}

impl<T> Iterator for VecIter<T> {
    type Item = T;
    /// Returns the next element, moving ownership out of the buffer.
    /// The iterator owns the buffer after `into_iter`; `next` does
    /// `value = move data[idx]` so owned T (String) transfers and `Copy`
    /// T bitwise-copies via the same `move`. Caller `drop`s each value;
    /// un-drained tail is leaked on `VecIter::drop` (frees buffer only).
    Optional<T> next(VecIter<T>* self) {
        if (self.idx < self.len) {
            T tmp = self.data[self.idx];
            T value = move tmp;
            self.idx = self.idx + 1;
            return Optional<T>.some(move value);
        }
        return Optional<T>.none();
    }
}

Vec<T> iter_collect<I, T>(I* iter) {
    Vec<T> out = Vec<T>.new();
    while (true) {
        Optional<T> o = iter.next();
        if (o.is_none()) { break; }
        out.push(o.unwrap());
    }
    return out;
}

// -- Ownership smoke (manual check) ---------------------------------------
// Vec<String> with growth:
//   Vec<String> v = Vec<String>.new();
//   v.push(String.from_str("a")); v.push(String.from_str("b")); // triggers grow
//   String s = v.pop(); // move out, len-- ; s.drop() frees "b"
//   String t = v.take(0); // shifts via move, returns "a"
//   // v now empty; t.drop() frees "a"; v.drop() frees buffer only (no double-free)
// POD `i32` path unchanged: `move` on Copy is bitwise copy, growth still correct.