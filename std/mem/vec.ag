// Growable contiguous array. Move transfers owned elements; Copy is bitwise.
// Drop frees the buffer only, so drain owned elements before discarding Vec.
import std.display;
import std.slice;
import std.mem.alloc;
import std.mem.drop;
import std.ops;
import std.optional;
import std.iter;
/// A contiguous, growable array type.
struct Vec<T> {
    T* data;
    i64 len;
    i64 cap;
}

impl Vec<T> {
    /// Empty vector — no allocation.
    Vec<T> new() {
        Vec<T> v;
        v.data = (T*)0;
        v.len = 0;
        v.cap = 0;
        return v;
    }

    /// Reserve space for `capacity` elements up front.
    Vec<T> with_capacity(i64 capacity) {
        Vec<T> v;
        v.data = (T*)(0);
        if (capacity != 0) {
            v.data = (T*)(malloc(@size(T) * capacity));
        }
        v.len = 0;
        v.cap = capacity;
        return v;
    }

    // -- Size / capacity ------------------------------------------------

    /// Number of elements currently in the vector.
    i64 len(&self) {
        return self.len;
    }

    /// Total allocated capacity.
    i64 capacity(&self) {
        return self.cap;
    }

    /// True when `len` is zero.
    bool is_empty(&self) {
        return self.len == 0;
    }

    // -- Element access -------------------------------------------------

    /// Read element at `index`.  Returns a COPY — for owned-element types
    /// this creates a shallow copy that shares resources with the backing
    /// buffer.  Prefer `get_ptr` or `take` for owned types.
    /// Out-of-bounds indices abort deterministically in every build profile.
    T get(&self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }

    /// Read element at `index`, returning None when out of bounds.
    Optional<T> try_get(&self, i64 index) {
        if (index < 0 || index >= self.len) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.data[index]);
    }

    /// Pointer to element at `index`.
    /// Out-of-bounds indices abort deterministically in every build profile.
    T* get_ptr(&self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return &(self.data[index]);
    }

    /// Overwrite element at `index`.
    /// Out-of-bounds indices abort deterministically in every build profile.
    void set(&mut self, i64 index, T value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = move value;
    }

    // -- Mutation -------------------------------------------------------

    /// Append `value` to the end (O(1) amortized).
    /// Growth uses `realloc`, which extends in place when the allocator's
    /// size-class headroom (or a `with_capacity` over-reserve) already covers
    /// the new length — the old malloc+memcpy+free path copied unconditionally.
    /// Owned T stays bitwise relocatable either way (see previous doc).
    void push(&mut self, T value) {
        if (self.len >= self.cap) {
            i64 new_cap = 8;
            if (self.cap != 0) {
                new_cap = self.cap * 2;
            }
            // realloc tolerates the null buffer of a fresh Vec.
            self.data = (T*)(realloc_bytes(self.data, @size(T) * new_cap));
            self.cap = new_cap;
        }
        self.data[self.len] = move value;
        self.len = self.len + 1;
    }

    /// Remove and return the last element.  Assumes `len > 0`.
    /// Moves ownership out (`move self.data[len-1]`); the stale slot is left
    /// in a moved-from state and `len` is decremented, so `Copy` T copies and
    /// non-Copy T transfers without duplication.
    T pop(&mut self) {
        self.len = self.len - 1;
        T tmp = self.data[self.len];
        T result = move tmp;
        return move result;
    }

    /// Move value out of position `index`, removing it from the Vec: the
    /// tail shifts left and `len` shrinks, so the slot is truly vacated.
    /// Every T is bitwise relocatable, so the tail moves with one memmove
    /// instead of a per-element move loop; the trailing slot beyond `len`
    /// is ignored exactly as before.
    T take(&mut self, i64 index) {
        T tmp0 = self.data[index];
        T result = move tmp0;
        i64 tail = self.len - index - 1;
        if (tail > 0) {
            silver_rt_memmove((u8*)&self.data[index], (u8*)&self.data[index + 1], tail * @size(T));
        }
        self.len = self.len - 1;
        return move result;
    }

    /// Remove element at `index` in O(1) by swapping with the last element.
    T swap_remove(&mut self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        if (index == self.len - 1) {
            return self.pop();
        }
        T tmp_idx = self.data[index];
        T result = move tmp_idx;
        T last = self.pop();
        self.data[index] = move last;
        return move result;
    }

    /// Swap two elements by index.
    void swap(&mut self, i64 a, i64 b) {
        if (a < 0 || a >= self.len || b < 0 || b >= self.len) { abort(); }
        if (a == b) { return; }
        T tmp_a = self.data[a];
        T tmp_b = self.data[b];
        self.data[a] = move tmp_b;
        self.data[b] = move tmp_a;
    }

    /// Reverse elements in place.
    void reverse(&mut self) {
        if (self.len <= 1) { return; }
        i64 left = 0;
        i64 right = self.len - 1;
        while (left < right) {
            self.swap(left, right);
            left = left + 1;
            right = right - 1;
        }
    }

    /// Pop the last element, or None when empty.
    Optional<T> try_pop(&mut self) {
        if (self.len == 0) {
            return Optional<T>.none();
        }
        return Optional<T>.some(self.pop());
    }


    /// Remove all elements without freeing the backing buffer.
    /// Drops active elements in place before resetting length.
    void clear(&mut self) {
        if (self.data != (T*)0 && self.len > 0) {
            @drop_in_place(self.data, self.len);
        }
        self.len = 0;
    }

    /// Reserve at least `min_capacity` elements, growing if needed.
    /// Uses `realloc` so size-class headroom extends in place; null-safe.
    void reserve(&mut self, i64 min_capacity) {
        if (self.cap >= min_capacity) {
            return;
        }
        self.data = (T*)(realloc_bytes(self.data, @size(T) * min_capacity));
        self.cap = min_capacity;
    }

    /// Shrink capacity to match length.
    /// `realloc` extends or shrinks via the allocator; when the size class
    /// already fits, the buffer stays in place and only `cap` is lowered.
    void shrink_to_fit(&mut self) {
        if (self.len == 0) {
            if (self.data != (T*)0) {
                free(self.data);
            }
            self.data = (T*)0;
            self.cap = 0;
        } else {
            if (self.len < self.cap) {
                self.data = (T*)(realloc_bytes(self.data, @size(T) * self.len));
                self.cap = self.len;
            }
        }
    }
}

impl<T> Drop for Vec<T> {
    /// Frees the backing buffer after dropping contained elements.
    void drop(*self) {
        if (self.data != (T*)0) {
            @drop_in_place(self.data, self.len);
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.cap = 0;
    }
}
impl<T> IndexedAccess for Vec<T> {
    type Item = T;
    T __index_get(*self, i64 index) {
        // Deterministic in all build profiles — release builds must not
        // index out of bounds silently (UB).
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }
    void __index_set(*self, i64 index, T value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = move value;
    }
}

// -- Iterator support ---------------------------------------------------
//
// Ownership contract:
// - `iter(&self)` borrows: takes `&self`, copies the raw
//   pointer/len into a `SliceIter<T>` and yields each element via copy
//   (`data[idx]` / `get_ptr` copy). The Vec remains valid and its buffer is
//   NOT transferred. Caller must not mutate Vec while the borrow lives.
// - `into_iter(self)` moves: takes `self` by value (Self self,
//   not &Self), transfers the buffer via `move self.data` and clears the Vec
//   (`self.data = null; self.len = 0; self.cap = 0`) so Vec's drop is a no-op.
//   The returned `VecIter<T>` owns the buffer (frees it on Drop) and each
//   `next()` does `value = move data[idx]` transferring ownership.

/// Iterator over Vec<T> elements (owns the backing buffer after into_iter).
struct VecIter<T> {
    T* data;
    i64 len;
    i64 idx;
}

impl<T> IntoIterator for Vec<T> {
    type Item = T;
    type IntoIter = VecIter<T>;
    /// Consumes the Vec, moving its buffer into the iterator.
    /// `self` (by value) — not `&self` — so `move self.data` drains and
    /// leaves `self` moved-from (null/0). Iterator owns and frees the buffer.
    VecIter<T> into_iter(self) {
        VecIter<T> iter;
        iter.data = move self.data;
        iter.len = self.len;
        iter.idx = 0;
        self.data = (T*)0;
        self.len = 0;
        self.cap = 0;
        return iter;
    }
}

impl<T> Vec<T> {
    Slice<T> as_slice(&self) {
        Slice<T> s;
        s.data = self.data;
        s.len = self.len;
        return s;
    }

    Slice<T> as_mut_slice(&mut self) {
        Slice<T> s;
        s.data = self.data;
        s.len = self.len;
        return s;
    }

    /// Returns a sub-slice spanning [start, end) with Python-style negative index clamping.
    Slice<T> __slice_get(&self, i64 start, i64 end) {
        Slice<T> s = self.as_slice();
        return s.__slice_get(start, end);
    }

    /// Borrows the Vec and yields element copies without consuming it.
    /// `&self` so the Vec stays live; iterator holds a raw ptr copy.
    SliceIter<T> iter(&self) {
        SliceIter<T> it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        return it;
    }

    RevIter<T> rev_iter(&self) {
        RevIter<T> r;
        r.data = self.data;
        r.len = self.len;
        r.idx = 0;
        return r;
    }
}


/// Debug-style list: `[1, 2, 3]`, `[]` when empty. Elements are read in
/// place through the backing buffer (`self.data[i]`, as in `ToJson`), so
/// Drop-typed elements stay owned by the Vec while printing.
impl<T> Display for Vec<T> {
    void fmt(*self, BufWriter* out) {
        out.write_str("[");
        i64 i = 0;
        while (i < self.len) {
            if (i > 0) {
                out.write_str(", ");
            }
            @fprint(out, "{}", self.data[i]);
            i = i + 1;
        }
        out.write_str("]");
    }
}


impl<T> Drop for VecIter<T> {
    void drop(*self) {
        if (self.data != (T*)0) {
            if (self.idx < self.len) {
                @drop_in_place(&self.data[self.idx], self.len - self.idx);
            }
            free(self.data);
            self.data = (T*)0;
        }
        self.len = 0;
        self.idx = 0;
    }
}

impl<T> Iterator for VecIter<T> {
    type Item = T;
    /// Returns the next element, moving ownership out of the buffer.
    /// The iterator owns the buffer after `into_iter`; `next` does
    /// `value = move data[idx]` so owned T (String) transfers and `Copy`
    /// T bitwise-copies via the same `move`. Caller `drop`s each value;
    /// un-drained tail is leaked on `VecIter::drop` (frees buffer only).
    Optional<T> next(*self) {
        if (self.idx < self.len) {
            T tmp = self.data[self.idx];
            T value = move tmp;
            self.idx = self.idx + 1;
            return Some(move value);
        }
        return None;
    }
}

Vec<T> iter_collect<I, T>(I* iter) {
    Vec<T> out = Vec<T>.new();
    while (true) {
        Optional<T> o = iter.next();
        if (o.is_none()) { break; }
        out.push(o.unwrap());
    }
    return out;
}

/// Constructs a new Vec initialized with the given elements.
macro [T] Vec<T> vec(T... elements) {
    Vec<T> v = Vec<T>.with_capacity(elements.len);
    for e in elements {
        v.push(e);
    }
    return move v;
}

// -- Ownership smoke (manual check) ---------------------------------------
// Vec<String> with growth:
//   Vec<String> v = Vec<String>.new();
//   v.push(String.from_str("a")); v.push(String.from_str("b")); // triggers grow
//   String s = v.pop(); // move out, len-- ; s.drop() frees "b"
//   String t = v.take(0); // shifts via move, returns "a"
//   // v now empty; t.drop() frees "a"; v.drop() frees buffer only (no double-free)
// POD `i32` path unchanged: `move` on Copy is bitwise copy, growth still correct.