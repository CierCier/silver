/// The `Drop` trait provides a mechanism to release resources (such as heap memory
/// or file descriptors) when a value goes out of scope.
///
/// Types implementing `Drop` must define the `drop` method, which takes a pointer
/// to the instance and is called automatically by the compiler.
trait Drop {
    /// Releases resources owned by `self`. Called by the compiler at scope exit,
    /// on overwrite, and on container cleanup; do not call it directly unless the
    /// value is then never used or dropped again. Fields with their own `Drop`
    /// are dropped after this method returns, so do not drop them here.
    void drop(*self);
}

/// Runs destructors in place for `count` contiguous elements starting at `ptr`.
/// If `T` does not implement `Drop` or require destruction, this is a compile-time no-op.
void drop_in_place<T>(T* ptr, i64 count) {
    @drop_in_place(ptr, count);
}
