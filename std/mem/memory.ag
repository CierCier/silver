// Pure-Silver memory intrinsics — memset/memcpy/memmove/strlen.
//
// No libc dependence: every routine is a plain byte loop over raw pointers.
// The silver_rt_* entry points form part of the frozen C-ABI runtime surface
// (mirroring silver_runtime/src/runtime/ffi.rs) and are exported unmangled.
//
// Semantics (frozen):
//   - memset/memcpy/memmove return dst and tolerate null pointers (no-op).
//   - memmove handles overlapping regions in either direction.
//   - strlen(null) returns 0.
//
// Bulk copies: when the build enables the cpu.* cfg keys, memcpy/memset
// dispatch large transfers to per-feature SIMD kernels. The kernels are
// always compiled (#[target_feature]) and the dispatch checks are @cfg
// folds: build-gated at compile time, then the runtime CPU probe (std/cpu.ag)
// decides per machine. Small transfers never pay the probes — the size guard
// precedes every feature check.

import std.cpu;

/// Copy 64 bytes per iteration (`blocks` iterations), AVX-512.
#[target_feature("avx512f")]
void memcpy_v512(u8* d, u8* s, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        vmovdqu64 (%r10), %zmm0
        vmovdqu64 %zmm0, (%r9)
        addq $$64, %r9
        addq $$64, %r10
        decq %r8
        jnz 1b
        vzeroupper
    ", [blocks, d, s], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 32 bytes per iteration (`blocks` iterations), AVX2.
#[target_feature("avx2")]
void memcpy_v256(u8* d, u8* s, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        vmovdqu (%r10), %ymm0
        vmovdqu %ymm0, (%r9)
        addq $$32, %r9
        addq $$32, %r10
        decq %r8
        jnz 1b
        vzeroupper
    ", [blocks, d, s], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 16 bytes per iteration (`blocks` iterations), SSE.
#[target_feature("sse41")]
void memcpy_v128(u8* d, u8* s, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        movdqu (%r10), %xmm0
        movdqu %xmm0, (%r9)
        addq $$16, %r9
        addq $$16, %r10
        decq %r8
        jnz 1b
    ", [blocks, d, s], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Fill 64 bytes per iteration (`blocks` iterations), AVX-512.
#[target_feature("avx512f")]
void memset_v512(u8* d, u8 value, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movl %esi, %eax
        vmovd %eax, %xmm0
        vpbroadcastb %xmm0, %zmm0
        1:
        vmovdqu64 %zmm0, (%r9)
        addq $$64, %r9
        decq %r8
        jnz 1b
        vzeroupper
    ", [blocks, d, value], ["rbx", "rdx", "r8", "r9", "xmm0"]);
}

/// Fill 32 bytes per iteration (`blocks` iterations), AVX2.
#[target_feature("avx2")]
void memset_v256(u8* d, u8 value, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movl %esi, %eax
        vmovd %eax, %xmm0
        vpbroadcastb %xmm0, %ymm0
        1:
        vmovdqu %ymm0, (%r9)
        addq $$32, %r9
        decq %r8
        jnz 1b
        vzeroupper
    ", [blocks, d, value], ["rbx", "rdx", "r8", "r9", "xmm0"]);
}

/// Fill `len` bytes at `dst` with `value`. Returns `dst`. Null-tolerant.
u8* silver_rt_memset(u8* dst, u8 value, i64 len) {
    if (dst == (u8*)0) {
        return dst;
    }
    u8* result = dst;
    i64 n = len;
    if (n >= 64) {
        if (@cfg(cpu.avx512f)) {
            i64 blocks = n / 64;
            memset_v512(dst, value, blocks);
            n = n - blocks * 64;
            dst = (u8*)((i64)dst + blocks * 64);
        }
    }
    if (n >= 32) {
        if (@cfg(cpu.avx2)) {
            i64 blocks = n / 32;
            memset_v256(dst, value, blocks);
            n = n - blocks * 32;
            dst = (u8*)((i64)dst + blocks * 32);
        }
    }
    while (n >= 8) {
        dst[n - 8] = value;
        dst[n - 7] = value;
        dst[n - 6] = value;
        dst[n - 5] = value;
        dst[n - 4] = value;
        dst[n - 3] = value;
        dst[n - 2] = value;
        dst[n - 1] = value;
        n = n - 8;
    }
    while (n >= 1) {
        dst[n - 1] = value;
        n = n - 1;
    }
    return result;
}

/// Copy `len` bytes from `src` to `dst` (regions must not overlap).
/// Returns `dst`. Null-tolerant.
u8* silver_rt_memcpy(u8* dst, u8* src, i64 len) {
    if (dst == (u8*)0 || src == (u8*)0) {
        return dst;
    }
    u8* result = dst;
    i64 n = len;
    if (n >= 64) {
        if (@cfg(cpu.avx512f)) {
            i64 blocks = n / 64;
            memcpy_v512(dst, src, blocks);
            n = n - blocks * 64;
            dst = (u8*)((i64)dst + blocks * 64);
            src = (u8*)((i64)src + blocks * 64);
        }
    }
    if (n >= 32) {
        if (@cfg(cpu.avx2)) {
            i64 blocks = n / 32;
            memcpy_v256(dst, src, blocks);
            n = n - blocks * 32;
            dst = (u8*)((i64)dst + blocks * 32);
            src = (u8*)((i64)src + blocks * 32);
        }
    }
    if (n >= 16) {
        if (@cfg(cpu.sse41)) {
            i64 blocks = n / 16;
            memcpy_v128(dst, src, blocks);
            n = n - blocks * 16;
            dst = (u8*)((i64)dst + blocks * 16);
            src = (u8*)((i64)src + blocks * 16);
        }
    }
    while (n >= 8) {
        dst[n - 8] = src[n - 8];
        dst[n - 7] = src[n - 7];
        dst[n - 6] = src[n - 6];
        dst[n - 5] = src[n - 5];
        dst[n - 4] = src[n - 4];
        dst[n - 3] = src[n - 3];
        dst[n - 2] = src[n - 2];
        dst[n - 1] = src[n - 1];
        n = n - 8;
    }
    while (n >= 1) {
        dst[n - 1] = src[n - 1];
        n = n - 1;
    }
    return result;
}

/// Copy `len` bytes from `src` to `dst`; overlap is allowed.
/// Returns `dst`. Null-tolerant.
///
/// Forward copies (dst below src) reuse the memcpy kernels; backward copies
/// (dst above src) walk the same kernels from the end. Both directions are
/// overlap-safe: reads always trail writes. SIMD is build-gated via @cfg,
/// exactly like memcpy; small moves skip the probes (size guard first).
///
/// Copy 64 bytes per iteration backwards, AVX-512.
#[target_feature("avx512f")]
void memmove_v512_back(u8* dend, u8* send, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        subq $$64, %r9
        subq $$64, %r10
        vmovdqu64 (%r10), %zmm0
        vmovdqu64 %zmm0, (%r9)
        decq %r8
        jnz 1b
        vzeroupper
    ", [blocks, dend, send], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 32 bytes per iteration backwards, AVX2.
#[target_feature("avx2")]
void memmove_v256_back(u8* dend, u8* send, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        subq $$32, %r9
        subq $$32, %r10
        vmovdqu (%r10), %ymm0
        vmovdqu %ymm0, (%r9)
        decq %r8
        jnz 1b
        vzeroupper
    ", [blocks, dend, send], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 16 bytes per iteration backwards, SSE.
#[target_feature("sse41")]
void memmove_v128_back(u8* dend, u8* send, i64 blocks) {
    asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        subq $$16, %r9
        subq $$16, %r10
        movdqu (%r10), %xmm0
        movdqu %xmm0, (%r9)
        decq %r8
        jnz 1b
    ", [blocks, dend, send], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

u8* silver_rt_memmove(u8* dst, u8* src, i64 len) {
    if (dst == (u8*)0 || src == (u8*)0) {
        return dst;
    }
    u8* result = dst;
    i64 d = (i64)dst;
    i64 s = (i64)src;
    i64 n = len;
    if (d < s) {
        // Copy forward: reads stay ahead of writes. Same cascade as memcpy.
        if (n >= 64) {
            if (@cfg(cpu.avx512f)) {
                i64 blocks = n / 64;
                memcpy_v512(dst, src, blocks);
                n = n - blocks * 64;
                dst = (u8*)((i64)dst + blocks * 64);
                src = (u8*)((i64)src + blocks * 64);
            }
        }
        if (n >= 32) {
            if (@cfg(cpu.avx2)) {
                i64 blocks = n / 32;
                memcpy_v256(dst, src, blocks);
                n = n - blocks * 32;
                dst = (u8*)((i64)dst + blocks * 32);
                src = (u8*)((i64)src + blocks * 32);
            }
        }
        if (n >= 16) {
            if (@cfg(cpu.sse41)) {
                i64 blocks = n / 16;
                memcpy_v128(dst, src, blocks);
                n = n - blocks * 16;
                dst = (u8*)((i64)dst + blocks * 16);
                src = (u8*)((i64)src + blocks * 16);
            }
        }
        while (n > 0) {
            *dst = *src;
            dst = (u8*)((i64)dst + 1);
            src = (u8*)((i64)src + 1);
            n = n - 1;
        }
    } else if (d > s) {
        // Copy backward: reads stay ahead of writes.
        u8* dend = (u8*)(d + n);
        u8* send = (u8*)(s + n);
        if (n >= 64) {
            if (@cfg(cpu.avx512f)) {
                i64 blocks = n / 64;
                memmove_v512_back(dend, send, blocks);
                n = n - blocks * 64;
                dend = (u8*)((i64)dend - blocks * 64);
                send = (u8*)((i64)send - blocks * 64);
            }
        }
        if (n >= 32) {
            if (@cfg(cpu.avx2)) {
                i64 blocks = n / 32;
                memmove_v256_back(dend, send, blocks);
                n = n - blocks * 32;
                dend = (u8*)((i64)dend - blocks * 32);
                send = (u8*)((i64)send - blocks * 32);
            }
        }
        if (n >= 16) {
            if (@cfg(cpu.sse41)) {
                i64 blocks = n / 16;
                memmove_v128_back(dend, send, blocks);
                n = n - blocks * 16;
                dend = (u8*)((i64)dend - blocks * 16);
                send = (u8*)((i64)send - blocks * 16);
            }
        }
        while (n > 0) {
            dend = (u8*)((i64)dend - 1);
            send = (u8*)((i64)send - 1);
            *dend = *send;
            n = n - 1;
        }
    }
    return result;
}


/// Length of a NUL-terminated string. Returns 0 for null.
///
/// Scans 16 bytes per iteration with SSE2 `pcmpeqb` (baseline on x86-64, no
/// runtime probe needed). The pointer is aligned up to 16 first with scalar
/// bytes so every wide read starts on a 16-byte boundary — aligned 16-byte
/// reads never cross a page, so the scan cannot fault on a string that ends
/// at a page edge.
i64 silver_rt_strlen(const char* s) {
    u8* p = (u8*)s;
    if (p == (u8*)0) {
        return 0;
    }
    return asm("
        movq %rax, %r8
        movq %rax, %r9
        andq $$15, %rax
        jz 2f
        1:
        cmpb $$0, (%r9)
        je 3f
        incq %r9
        movq %r9, %rax
        andq $$15, %rax
        jnz 1b
        2:
        4:
        movdqu (%r9), %xmm0
        pxor %xmm1, %xmm1
        pcmpeqb %xmm1, %xmm0
        pmovmskb %xmm0, %ecx
        testl %ecx, %ecx
        jnz 5f
        addq $$16, %r9
        jmp 4b
        5:
        bsfl %ecx, %ecx
        movl %ecx, %eax
        addq %rax, %r9
        3:
        movq %r9, %rax
        subq %r8, %rax
    ", [p], ["rbx", "rdx", "r8", "r9", "xmm0", "xmm1"]);
}

/// Find byte `c` across 32-byte chunks with AVX2.
#[target_feature("avx2")]
i64 mem_find_byte_v256(u8* p, u8 c, i64 blocks) {
    return asm("
        movq %rax, %r8
        movq %rdi, %r9
        movl %esi, %eax
        vmovd %eax, %xmm0
        vpbroadcastb %xmm0, %ymm0
        1:
        vmovdqu (%r9), %ymm1
        vpcmpeqb %ymm0, %ymm1, %ymm1
        vpmovmskb %ymm1, %ecx
        testl %ecx, %ecx
        jnz 2f
        addq $$32, %r9
        decq %r8
        jnz 1b
        movq $$-1, %rax
        vzeroupper
        jmp 3f
        2:
        bsfl %ecx, %ecx
        movl %ecx, %edx
        movq %r9, %rax
        subq %rdi, %rax
        addq %rdx, %rax
        vzeroupper
        3:
    ", [blocks, p, (i64)c], ["rbx", "rdx", "r8", "r9", "xmm0", "xmm1"]);
}

/// Find the first occurrence of byte `c` in the first `n` bytes of `p`.
/// Returns the byte index, or -1 when absent.
i64 mem_find_byte(u8* p, u8 c, i64 n) {
    if (p == (u8*)0 || n <= 0) {
        return -1;
    }
    i64 i = 0;
    if (n >= 32 && @cfg(cpu.avx2)) {
        i64 blocks = n / 32;
        i64 r = mem_find_byte_v256(p, c, blocks);
        if (r >= 0) {
            return r;
        }
        i = blocks * 32;
    }
    while (i + 16 <= n) {
        i64 blocks = (n - i) / 16;
        i64 r = asm("
            movq %rax, %r8
            movq %rdi, %r9
            movl %esi, %eax
            movd %eax, %xmm0
            punpcklbw %xmm0, %xmm0
            punpcklwd %xmm0, %xmm0
            pshufd $$0, %xmm0, %xmm0
            1:
            movdqu (%r9), %xmm1
            pcmpeqb %xmm0, %xmm1
            pmovmskb %xmm1, %ecx
            testl %ecx, %ecx
            jnz 2f
            addq $$16, %r9
            decq %r8
            jnz 1b
            movq $$-1, %rax
            jmp 3f
            2:
            bsfl %ecx, %ecx
            movl %ecx, %edx
            movq %r9, %rax
            subq %rdi, %rax
            addq %rdx, %rax
            3:
        ", [blocks, &p[i], (i64)c], ["rbx", "rdx", "r8", "r9", "xmm0", "xmm1"]);
        if (r >= 0) {
            return i + r;
        }
        i = i + blocks * 16;
    }
    while (i < n) {
        if (p[i] == c) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Find the last occurrence of byte `c` in the first `n` bytes of `p`.
/// Returns the byte index, or -1 when absent.
i64 mem_find_byte_back(u8* p, u8 c, i64 n) {
    if (p == (u8*)0 || n <= 0) {
        return -1;
    }
    i64 i = n;
    while (i >= 16) {
        i64 offset = i - 16;
        i64 r = asm("
            movl %edi, %edx
            movd %edx, %xmm0
            punpcklbw %xmm0, %xmm0
            punpcklwd %xmm0, %xmm0
            pshufd $$0, %xmm0, %xmm0
            movdqu (%rax), %xmm1
            pcmpeqb %xmm0, %xmm1
            pmovmskb %xmm1, %ecx
            testl %ecx, %ecx
            jz 1f
            bsrl %ecx, %ecx
            movl %ecx, %eax
            jmp 2f
            1:
            movq $$-1, %rax
            2:
        ", [&p[offset], (i64)c], ["rbx", "rdx", "rcx", "xmm0", "xmm1"]);
        if (r >= 0) {
            return offset + r;
        }
        i = offset;
    }
    while (i > 0) {
        i = i - 1;
        if (p[i] == c) {
            return i;
        }
    }
    return -1;
}

/// Count occurrences of byte `c` in the first `n` bytes of `p`.
i64 mem_count_byte(u8* p, u8 c, i64 n) {
    if (p == (u8*)0 || n <= 0) {
        return 0;
    }
    i64 count = 0;
    i64 i = 0;
    while (i + 16 <= n) {
        i64 match_count = asm("
            movl %edi, %edx
            movd %edx, %xmm0
            punpcklbw %xmm0, %xmm0
            punpcklwd %xmm0, %xmm0
            pshufd $$0, %xmm0, %xmm0
            movdqu (%rax), %xmm1
            pcmpeqb %xmm0, %xmm1
            pmovmskb %xmm1, %ecx
            popcntl %ecx, %eax
        ", [&p[i], (i64)c], ["rbx", "rdx", "rcx", "xmm0", "xmm1"]);
        count = count + match_count;
        i = i + 16;
    }
    while (i < n) {
        if (p[i] == c) {
            count = count + 1;
        }
        i = i + 1;
    }
    return count;
}

/// Standard C memchr: returns pointer to first occurrence, or null.
u8* memchr(const void* s, i32 c, i64 n) {
    u8* p = (u8*)s;
    i64 idx = mem_find_byte(p, (u8)c, n);
    if (idx < 0) {
        return (u8*)0;
    }
    return (u8*)((i64)p + idx);
}

/// Standard C memrchr: returns pointer to last occurrence, or null.
u8* memrchr(const void* s, i32 c, i64 n) {
    u8* p = (u8*)s;
    i64 idx = mem_find_byte_back(p, (u8)c, n);
    if (idx < 0) {
        return (u8*)0;
    }
    return (u8*)((i64)p + idx);
}

/// Compare two regions in 32-byte chunks with AVX2.
#[target_feature("avx2")]
i64 memcmp_v256(u8* p1, u8* p2, i64 blocks) {
    return asm("
        movq %rax, %r8
        movq %rdi, %r9
        movq %rsi, %r10
        1:
        vmovdqu (%r9), %ymm0
        vmovdqu (%r10), %ymm1
        vpcmpeqb %ymm0, %ymm1, %ymm0
        vpmovmskb %ymm0, %ecx
        cmpl $$-1, %ecx
        jne 2f
        addq $$32, %r9
        addq $$32, %r10
        decq %r8
        jnz 1b
        movq $$0, %rax
        vzeroupper
        jmp 3f
        2:
        notl %ecx
        bsfl %ecx, %ecx
        movl %ecx, %eax
        addq %rax, %r9
        addq %rax, %r10
        movzbl (%r9), %eax
        movzbl (%r10), %edx
        subl %edx, %eax
        vzeroupper
        3:
    ", [blocks, p1, p2], ["rbx", "rdx", "r8", "r9", "r10", "xmm0", "xmm1"]);
}

/// Compare the first `n` bytes of two regions. Returns 0 when equal, else the
/// difference of the first differing bytes. Null inputs are not tolerated
/// (matches the C contract).
i32 memcmp(const void* s1, const void* s2, i64 n) {
    u8* p1 = (u8*)s1;
    u8* p2 = (u8*)s2;
    i64 i = 0;
    if (n >= 32 && @cfg(cpu.avx2)) {
        i64 blocks = n / 32;
        i64 diff = memcmp_v256(p1, p2, blocks);
        if (diff != 0) {
            return (i32)diff;
        }
        i = blocks * 32;
    }
    while (n - i >= 16) {
        i64 diff = asm("
            movq %rax, %r8
            movq %rdi, %r9
            movq %rsi, %r10
            1:
            movdqu (%r9), %xmm0
            movdqu (%r10), %xmm1
            pcmpeqb %xmm1, %xmm0
            pmovmskb %xmm0, %ecx
            cmpl $$65535, %ecx
            jne 2f
            addq $$16, %r9
            addq $$16, %r10
            decq %r8
            jnz 1b
            movq $$0, %rax
            jmp 3f
            2:
            notl %ecx
            bsfl %ecx, %ecx
            movl %ecx, %eax
            addq %rax, %r9
            addq %rax, %r10
            movzbl (%r9), %eax
            movzbl (%r10), %edx
            subl %edx, %eax
            3:
        ", [((n - i) / 16), &p1[i], &p2[i]], ["rbx", "rdx", "r8", "r9", "r10", "xmm0", "xmm1"]);
        if (diff != 0) {
            return (i32)diff;
        }
        i = i + (n - i) / 16 * 16;
    }
    while (i < n) {
        if (p1[i] != p2[i]) {
            return (i32)p1[i] - (i32)p2[i];
        }
        i = i + 1;
    }
    return 0;
}

/// libc-compatible `bcmp`: zero when the regions are equal, non-zero
/// otherwise. LLVM's optimizer recognizes memcmp-shaped code at -O2 and
/// lowers it to a `bcmp` call; the no-libc runtime provides this shim so
/// optimized builds link.
i32 bcmp(const void* s1, const void* s2, i64 n) {
    return memcmp(s1, s2, n);
}

/// Compare two NUL-terminated strings. Kept scalar: strings are typically
/// short, and the wide-path dispatch overhead would dominate; the page-edge
/// alignment cost of a SIMD version is not worth it here.
i32 strcmp(const char* s1, const char* s2) {
    u8* p1 = (u8*)s1;
    u8* p2 = (u8*)s2;
    i64 i = 0;
    while (p1[i] != 0 && p1[i] == p2[i]) {
        i += 1;
    }
    return (i32)p1[i] - (i32)p2[i];
}

// ---------------------------------------------------------------------------
// libc-compatible shims.
//
// These keep existing std/ call sites (memset/memcpy/memmove/strlen with the
// classic C signatures) compiling unchanged, routed through the pure-Silver
// implementations above.
// ---------------------------------------------------------------------------

void* memset(void* ptr, i32 value, i64 num) {
    return (void*)silver_rt_memset((u8*)ptr, (u8)value, num);
}

void* memcpy(void* dest, const void* src, i64 num) {
    return (void*)silver_rt_memcpy((u8*)dest, (u8*)src, num);
}

void* memmove(void* dest, const void* src, i64 num) {
    return (void*)silver_rt_memmove((u8*)dest, (u8*)src, num);
}

i64 strlen(const char* s) {
    return silver_rt_strlen(s);
}


// ---------------------------------------------------------------------------
// Pure-Silver abort — no libc dependency.
// Sends SIGABRT to self, then exits with 128+6.
// ---------------------------------------------------------------------------

import std.sys.raw.fs;
import std.sys.raw.process;
import std.rt.backtrace;

void abort() {
    // Named stack trace before dying (skip = walker frame + this abort frame).
    silver_print_backtrace(2);
    sys_kill(sys_getpid(), 6);  // SIGABRT
    sys_exit_group(134);        // 128 + SIGABRT
}

/// Called by the compiler's `@assert` expansion when a debug check fails.
/// Writes `assertion failed at <file>:<line>: <msg>\n` to stderr via raw
/// write(2) (no stdio dependency), then aborts. In release builds the
/// expansion is pruned before codegen, so this is never referenced.
void __silver_assert_failed(str file, i64 line, str msg) {
    u8 buf[512];
    i64 n = 0;
    u8* prefix = (u8*)"assertion failed at ";
    i64 i = 0;
    while (prefix[i] != (u8)0 && n < 480) { buf[n] = prefix[i]; n = n + 1; i = i + 1; }
    if (file != (str)0) {
        u8* f = (u8*)file;
        i = 0;
        while (f[i] != (u8)0 && n < 480) { buf[n] = f[i]; n = n + 1; i = i + 1; }
    }
    if (n < 480) { buf[n] = (u8)':'; n = n + 1; }
    i64 ln = line;
    u8 digits[20];
    i64 nd = 0;
    if (ln == 0) { digits[0] = (u8)'0'; nd = 1; }
    while (ln > 0 && nd < 19) { digits[nd] = (u8)((u8)'0' + (u8)(ln % 10)); nd = nd + 1; ln = ln / 10; }
    while (nd > 0 && n < 480) { nd = nd - 1; buf[n] = digits[nd]; n = n + 1; }
    if (n + 1 < 480) { buf[n] = (u8)':'; buf[n + 1] = (u8)' '; n = n + 2; }
    if (msg != (str)0) {
        u8* m = (u8*)msg;
        i = 0;
        while (m[i] != (u8)0 && n < 480) { buf[n] = m[i]; n = n + 1; i = i + 1; }
    }
    if (n < 480) { buf[n] = (u8)'\n'; n = n + 1; }
    sys_write(2, (i64)&buf[0], n);
    abort();
}
