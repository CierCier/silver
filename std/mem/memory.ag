// Pure-Silver memory intrinsics — memset/memcpy/memmove/strlen.
//
// No libc dependence: every routine is a plain byte loop over raw pointers.
// The silver_rt_* entry points form part of the frozen C-ABI runtime surface
// (mirroring silver_runtime/src/runtime/ffi.rs) and are exported unmangled.
//
// Semantics (frozen):
//   - memset/memcpy/memmove return dst and tolerate null pointers (no-op).
//   - memmove handles overlapping regions in either direction.
//   - strlen(null) returns 0.
//
// Bulk copies: when the build enables the cpu.* cfg keys, memcpy/memset
// dispatch large transfers to per-feature SIMD kernels. The kernels are
// always compiled (#[target_feature]) and the dispatch checks are @cfg
// folds: build-gated at compile time, then the runtime CPU probe (std/cpu.ag)
// decides per machine. Small transfers never pay the probes — the size guard
// precedes every feature check.

import std.cpu;

/// Copy 64 bytes per iteration (`blocks` iterations), AVX-512.
#[target_feature("avx512f")]
void memcpy_v512(u8* d, u8* s, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nvmovdqu64 (%r10), %zmm0\nvmovdqu64 %zmm0, (%r9)\naddq $$64, %r9\naddq $$64, %r10\ndecq %r8\njnz 1b\nvzeroupper", [blocks, d, s], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 32 bytes per iteration (`blocks` iterations), AVX2.
#[target_feature("avx2")]
void memcpy_v256(u8* d, u8* s, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nvmovdqu (%r10), %ymm0\nvmovdqu %ymm0, (%r9)\naddq $$32, %r9\naddq $$32, %r10\ndecq %r8\njnz 1b\nvzeroupper", [blocks, d, s], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 16 bytes per iteration (`blocks` iterations), SSE.
#[target_feature("sse41")]
void memcpy_v128(u8* d, u8* s, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nmovdqu (%r10), %xmm0\nmovdqu %xmm0, (%r9)\naddq $$16, %r9\naddq $$16, %r10\ndecq %r8\njnz 1b", [blocks, d, s], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Fill 64 bytes per iteration (`blocks` iterations), AVX-512.
#[target_feature("avx512f")]
void memset_v512(u8* d, u8 value, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovl %esi, %eax\nvmovd %eax, %xmm0\nvpbroadcastb %xmm0, %zmm0\n1:\nvmovdqu64 %zmm0, (%r9)\naddq $$64, %r9\ndecq %r8\njnz 1b\nvzeroupper", [blocks, d, value], ["rbx", "rdx", "r8", "r9", "xmm0"]);
}

/// Fill 32 bytes per iteration (`blocks` iterations), AVX2.
#[target_feature("avx2")]
void memset_v256(u8* d, u8 value, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovl %esi, %eax\nvmovd %eax, %xmm0\nvpbroadcastb %xmm0, %ymm0\n1:\nvmovdqu %ymm0, (%r9)\naddq $$32, %r9\ndecq %r8\njnz 1b\nvzeroupper", [blocks, d, value], ["rbx", "rdx", "r8", "r9", "xmm0"]);
}

/// Fill `len` bytes at `dst` with `value`. Returns `dst`. Null-tolerant.
u8* silver_rt_memset(u8* dst, u8 value, i64 len) {
    if (dst == (u8*)0) {
        return dst;
    }
    u8* result = dst;
    i64 n = len;
    if (n >= 64) {
        if (@cfg(cpu.avx512f)) {
            i64 blocks = n / 64;
            memset_v512(dst, value, blocks);
            n = n - blocks * 64;
            dst = (u8*)((i64)dst + blocks * 64);
        }
    }
    if (n >= 32) {
        if (@cfg(cpu.avx2)) {
            i64 blocks = n / 32;
            memset_v256(dst, value, blocks);
            n = n - blocks * 32;
            dst = (u8*)((i64)dst + blocks * 32);
        }
    }
    while (n >= 8) {
        dst[n - 8] = value;
        dst[n - 7] = value;
        dst[n - 6] = value;
        dst[n - 5] = value;
        dst[n - 4] = value;
        dst[n - 3] = value;
        dst[n - 2] = value;
        dst[n - 1] = value;
        n = n - 8;
    }
    while (n >= 1) {
        dst[n - 1] = value;
        n = n - 1;
    }
    return result;
}

/// Copy `len` bytes from `src` to `dst` (regions must not overlap).
/// Returns `dst`. Null-tolerant.
u8* silver_rt_memcpy(u8* dst, u8* src, i64 len) {
    if (dst == (u8*)0 || src == (u8*)0) {
        return dst;
    }
    u8* result = dst;
    i64 n = len;
    if (n >= 64) {
        if (@cfg(cpu.avx512f)) {
            i64 blocks = n / 64;
            memcpy_v512(dst, src, blocks);
            n = n - blocks * 64;
            dst = (u8*)((i64)dst + blocks * 64);
            src = (u8*)((i64)src + blocks * 64);
        }
    }
    if (n >= 32) {
        if (@cfg(cpu.avx2)) {
            i64 blocks = n / 32;
            memcpy_v256(dst, src, blocks);
            n = n - blocks * 32;
            dst = (u8*)((i64)dst + blocks * 32);
            src = (u8*)((i64)src + blocks * 32);
        }
    }
    if (n >= 16) {
        if (@cfg(cpu.sse41)) {
            i64 blocks = n / 16;
            memcpy_v128(dst, src, blocks);
            n = n - blocks * 16;
            dst = (u8*)((i64)dst + blocks * 16);
            src = (u8*)((i64)src + blocks * 16);
        }
    }
    while (n >= 8) {
        dst[n - 8] = src[n - 8];
        dst[n - 7] = src[n - 7];
        dst[n - 6] = src[n - 6];
        dst[n - 5] = src[n - 5];
        dst[n - 4] = src[n - 4];
        dst[n - 3] = src[n - 3];
        dst[n - 2] = src[n - 2];
        dst[n - 1] = src[n - 1];
        n = n - 8;
    }
    while (n >= 1) {
        dst[n - 1] = src[n - 1];
        n = n - 1;
    }
    return result;
}

/// Copy `len` bytes from `src` to `dst`; overlap is allowed.
/// Returns `dst`. Null-tolerant.
///
/// Forward copies (dst below src) reuse the memcpy kernels; backward copies
/// (dst above src) walk the same kernels from the end. Both directions are
/// overlap-safe: reads always trail writes. SIMD is build-gated via @cfg,
/// exactly like memcpy; small moves skip the probes (size guard first).
///
/// Copy 64 bytes per iteration backwards, AVX-512.
#[target_feature("avx512f")]
void memmove_v512_back(u8* dend, u8* send, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nsubq $$64, %r9\nsubq $$64, %r10\nvmovdqu64 (%r10), %zmm0\nvmovdqu64 %zmm0, (%r9)\ndecq %r8\njnz 1b\nvzeroupper", [blocks, dend, send], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 32 bytes per iteration backwards, AVX2.
#[target_feature("avx2")]
void memmove_v256_back(u8* dend, u8* send, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nsubq $$32, %r9\nsubq $$32, %r10\nvmovdqu (%r10), %ymm0\nvmovdqu %ymm0, (%r9)\ndecq %r8\njnz 1b\nvzeroupper", [blocks, dend, send], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

/// Copy 16 bytes per iteration backwards, SSE.
#[target_feature("sse41")]
void memmove_v128_back(u8* dend, u8* send, i64 blocks) {
    asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nsubq $$16, %r9\nsubq $$16, %r10\nmovdqu (%r10), %xmm0\nmovdqu %xmm0, (%r9)\ndecq %r8\njnz 1b", [blocks, dend, send], ["rbx", "rdx", "r8", "r9", "r10", "xmm0"]);
}

u8* silver_rt_memmove(u8* dst, u8* src, i64 len) {
    if (dst == (u8*)0 || src == (u8*)0) {
        return dst;
    }
    u8* result = dst;
    i64 d = (i64)dst;
    i64 s = (i64)src;
    i64 n = len;
    if (d < s) {
        // Copy forward: reads stay ahead of writes. Same cascade as memcpy.
        if (n >= 64) {
            if (@cfg(cpu.avx512f)) {
                i64 blocks = n / 64;
                memcpy_v512(dst, src, blocks);
                n = n - blocks * 64;
                dst = (u8*)((i64)dst + blocks * 64);
                src = (u8*)((i64)src + blocks * 64);
            }
        }
        if (n >= 32) {
            if (@cfg(cpu.avx2)) {
                i64 blocks = n / 32;
                memcpy_v256(dst, src, blocks);
                n = n - blocks * 32;
                dst = (u8*)((i64)dst + blocks * 32);
                src = (u8*)((i64)src + blocks * 32);
            }
        }
        if (n >= 16) {
            if (@cfg(cpu.sse41)) {
                i64 blocks = n / 16;
                memcpy_v128(dst, src, blocks);
                n = n - blocks * 16;
                dst = (u8*)((i64)dst + blocks * 16);
                src = (u8*)((i64)src + blocks * 16);
            }
        }
        while (n >= 1) {
            dst[n - 1] = src[n - 1];
            n = n - 1;
        }
    } else {
        if (d > s) {
            // Copy backward: reads trail writes. Kernels take the END of the
            // remaining region and walk down; the end pointers advance as
            // each stage consumes its bulk.
            i64 dend = (i64)dst + n;
            i64 send = (i64)src + n;
            if (n >= 64) {
                if (@cfg(cpu.avx512f)) {
                    i64 blocks = n / 64;
                    memmove_v512_back((u8*)dend, (u8*)send, blocks);
                    n = n - blocks * 64;
                    dend = dend - blocks * 64;
                    send = send - blocks * 64;
                }
            }
            if (n >= 32) {
                if (@cfg(cpu.avx2)) {
                    i64 blocks = n / 32;
                    memmove_v256_back((u8*)dend, (u8*)send, blocks);
                    n = n - blocks * 32;
                    dend = dend - blocks * 32;
                    send = send - blocks * 32;
                }
            }
            if (n >= 16) {
                if (@cfg(cpu.sse41)) {
                    i64 blocks = n / 16;
                    memmove_v128_back((u8*)dend, (u8*)send, blocks);
                    n = n - blocks * 16;
                    dend = dend - blocks * 16;
                    send = send - blocks * 16;
                }
            }
            // Tail: index from the START of the remaining region, like the
            // forward path (dend/send track its END).
            u8* ds = (u8*)((i64)dend - n);
            u8* ss = (u8*)((i64)send - n);
            while (n >= 1) {
                dst[n - 1] = src[n - 1];
                n = n - 1;
            }
        }
        // d == s: nothing to do.
    }
    return result;
}


/// Length of a NUL-terminated string. Returns 0 for null.
///
/// Scans 16 bytes per iteration with SSE2 `pcmpeqb` (baseline on x86-64, no
/// runtime probe needed). The pointer is aligned up to 16 first with scalar
/// bytes so every wide read starts on a 16-byte boundary — aligned 16-byte
/// reads never cross a page, so the scan cannot fault on a string that ends
/// at a page edge.
i64 silver_rt_strlen(const char* s) {
    u8* p = (u8*)s;
    if (p == (u8*)0) {
        return 0;
    }
    return asm("movq %rax, %r8\nmovq %rax, %r9\nandq $$15, %rax\njz 2f\n1:\ncmpb $$0, (%r9)\nje 3f\nincq %r9\nmovq %r9, %rax\nandq $$15, %rax\njnz 1b\n2:\n4:\nmovdqu (%r9), %xmm0\npxor %xmm1, %xmm1\npcmpeqb %xmm1, %xmm0\npmovmskb %xmm0, %ecx\ntestl %ecx, %ecx\njnz 5f\naddq $$16, %r9\njmp 4b\n5:\nbsfl %ecx, %ecx\nmovl %ecx, %eax\naddq %rax, %r9\n3:\nmovq %r9, %rax\nsubq %r8, %rax", [p], ["rbx", "rdx", "r8", "r9", "xmm0", "xmm1"]);
}

/// Find the first occurrence of byte `c` in the first `n` bytes of `p`.
/// Returns the byte index, or -1 when absent. Scans 16 bytes per iteration
/// with SSE2 (baseline); the block reads never pass `p + n`, so there is no
/// over-read and no page hazard on arbitrary buffers.
i64 memchr(u8* p, u8 c, i64 n) {
    if (p == (u8*)0 || n <= 0) {
        return -1;
    }
    i64 i = 0;
    while (i + 16 <= n) {
        i64 blocks = (n - i) / 16;
        i64 r = asm("movq %rax, %r8\nmovq %rdi, %r9\nmovl %esi, %eax\nmovd %eax, %xmm0\npunpcklbw %xmm0, %xmm0\npunpcklwd %xmm0, %xmm0\npshufd $$0, %xmm0, %xmm0\n1:\nmovdqu (%r9), %xmm1\npcmpeqb %xmm0, %xmm1\npmovmskb %xmm1, %ecx\ntestl %ecx, %ecx\njnz 2f\naddq $$16, %r9\ndecq %r8\njnz 1b\nmovq $$-1, %rax\njmp 3f\n2:\nbsfl %ecx, %ecx\nmovl %ecx, %edx\nmovq %r9, %rax\nsubq %rdi, %rax\naddq %rdx, %rax\n3:", [blocks, &p[i], (i64)c], ["rbx", "rdx", "r8", "r9", "xmm0", "xmm1"]);
        if (r >= 0) {
            return i + r;
        }
        i = i + blocks * 16;
    }
    while (i < n) {
        if (p[i] == c) {
            return i;
        }
        i = i + 1;
    }
    return -1;
}

/// Compare the first `n` bytes of two regions. Returns 0 when equal, else the
/// difference of the first differing bytes. Null inputs are not tolerated
/// (matches the C contract).
///
/// Compares 16 bytes per iteration with SSE2 (baseline). The block reads
/// never pass `n`, so no over-read and no page hazards. Short compares pay
/// nothing extra — the size guard precedes the wide path.
i32 memcmp(const void* s1, const void* s2, i64 n) {
    u8* p1 = (u8*)s1;
    u8* p2 = (u8*)s2;
    i64 i = 0;
    while (n - i >= 16) {
        i64 diff = asm("movq %rax, %r8\nmovq %rdi, %r9\nmovq %rsi, %r10\n1:\nmovdqu (%r9), %xmm0\nmovdqu (%r10), %xmm1\npcmpeqb %xmm1, %xmm0\npmovmskb %xmm0, %ecx\ncmpl $$65535, %ecx\njne 2f\naddq $$16, %r9\naddq $$16, %r10\ndecq %r8\njnz 1b\nmovq $$0, %rax\njmp 3f\n2:\nnotl %ecx\nbsfl %ecx, %ecx\nmovl %ecx, %eax\naddq %rax, %r9\naddq %rax, %r10\nmovzbl (%r9), %eax\nmovzbl (%r10), %edx\nsubl %edx, %eax\n3:", [((n - i) / 16), &p1[i], &p2[i]], ["rbx", "rdx", "r8", "r9", "r10", "xmm0", "xmm1"]);
        if (diff != 0) {
            return (i32)diff;
        }
        i = i + (n - i) / 16 * 16;
    }
    while (i < n) {
        if (p1[i] != p2[i]) {
            return (i32)p1[i] - (i32)p2[i];
        }
        i = i + 1;
    }
    return 0;
}

/// Compare two NUL-terminated strings. Kept scalar: strings are typically
/// short, and the wide-path dispatch overhead would dominate; the page-edge
/// alignment cost of a SIMD version is not worth it here.
i32 strcmp(const char* s1, const char* s2) {
    u8* p1 = (u8*)s1;
    u8* p2 = (u8*)s2;
    i64 i = 0;
    while (p1[i] != 0 && p1[i] == p2[i]) {
        i += 1;
    }
    return (i32)p1[i] - (i32)p2[i];
}

// ---------------------------------------------------------------------------
// libc-compatible shims.
//
// These keep existing std/ call sites (memset/memcpy/memmove/strlen with the
// classic C signatures) compiling unchanged, routed through the pure-Silver
// implementations above.
// ---------------------------------------------------------------------------

void* memset(void* ptr, i32 value, i64 num) {
    return (void*)silver_rt_memset((u8*)ptr, (u8)value, num);
}

void* memcpy(void* dest, const void* src, i64 num) {
    return (void*)silver_rt_memcpy((u8*)dest, (u8*)src, num);
}

void* memmove(void* dest, const void* src, i64 num) {
    return (void*)silver_rt_memmove((u8*)dest, (u8*)src, num);
}

i64 strlen(const char* s) {
    return silver_rt_strlen(s);
}


// ---------------------------------------------------------------------------
// Pure-Silver abort — no libc dependency.
// Sends SIGABRT to self, then exits with 128+6.
// ---------------------------------------------------------------------------

import std.sys.raw.process;

void abort() {
    sys_kill(sys_getpid(), 6);  // SIGABRT
    sys_exit_group(134);        // 128 + SIGABRT
}
