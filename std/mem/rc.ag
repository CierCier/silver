// Rc<T> — reference-counted shared-ownership smart pointer.
//
// Multiple Rc handles can share ownership of the same heap object.
// The object is freed when the last handle is dropped.
//
// USAGE:
//   Rc<GraphNode> n = Rc.new(GraphNode.new(id));
//   Rc<GraphNode> m = n.clone();  // shared ownership
//   (*n.get()).payload[0] = 42;
//
// The count and the value live in one co-allocated RcBox<T>, so creating a
// handle is a single heap allocation instead of two (16 bytes of metadata
// and one spinlock acquisition saved per instance). The handle stores the
// two interior pointers; the count sits at offset 0 of the box, so freeing
// it releases the whole allocation.
//
// NOTE: Does NOT call T's destructor on last-drop (same as Box/Vec).
//       The heap memory for T is freed; if T holds owned resources
//       those must be managed separately.
//       Rc<T>::new also copies `val` into the heap slot (by-value param
//       dropped at callee exit), so owned T leaves the Rc holding dangling
//       pointers — use POD/plain T until move-into-deref is supported.
import std.mem.alloc;
import std.mem.drop;

/// Shared allocation: reference count followed by the value.
struct RcBox<T> {
    i32 count;
    T value;
}

struct Rc<T> {
    T* ptr;
    i32* count;
}

impl<T> Rc<T> {
    /// Create a new reference-counted handle (single co-allocated box).
    Rc<T> new(T val) {
        RcBox<T>* b = alloc<RcBox<T>>();
        (*b).count = 1;
        (*b).value = val;
        Rc<T> rc;
        rc.ptr = &((*b).value);
        rc.count = &((*b).count);
        return rc;
    }

    /// Create a new reference-counted handle by copying `*ptr` into a fresh
    /// box. The caller retains ownership of `ptr` and must free it; the Rc
    /// owns only the box. The count starts at 1.
    Rc<T> from_ptr(T* ptr) {
        RcBox<T>* b = alloc<RcBox<T>>();
        (*b).count = 1;
        (*b).value = *ptr;
        Rc<T> rc;
        rc.ptr = &((*b).value);
        rc.count = &((*b).count);
        return rc;
    }

    /// Clone the handle — increments the reference count.
    Rc<T> clone(*self) {
        if ((i64)self.count != 0) {
            *(self.count) = *(self.count) + 1;
        }
        Rc<T> c;
        c.ptr = self.ptr;
        c.count = self.count;
        return c;
    }

    /// Get a raw pointer to the value.
    T* get(*self) {
        return self.ptr;
    }
}

impl<T> Drop for Rc<T> {
    /// Drop one handle — decrements the reference count.
    /// Frees the co-allocated box when it reaches zero.
    void drop(*self) {
        if ((i64)self.count != 0) {
            *(self.count) = *(self.count) - 1;
            if (*(self.count) == 0) {
                free(self.count);
            }
        }
        self.ptr = (T*)0;
        self.count = (i32*)0;
    }
}
