// SwissTable map. Iteration borrows; into_iter/drain move buffers out.
// Move transfers owned K/V values; Copy is bitwise. `erase` tombstones
// without moving, so use `remove` or drain when owned values matter.
import std.optional;
import std.mem.alloc;
import std.hash;
import std.io.file;
import std.mem.drop;
import std.iter;

// Internal entry state: Swiss Table 16-byte metadata control groups.
// Control byte values:
// 0x80 (128): Empty bucket
// 0xFE (254): Deleted bucket (tombstone)
// 0..127: Occupied bucket with 7-bit hash fingerprint (h2)
struct HashMap<K, V> {
    K* keys;
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 len;
}

const i64 INITIAL_CAPACITY = 16;
const f64 LOAD_FACTOR = 0.875;
const u8 CTRL_EMPTY = (u8)0x80;
const u8 CTRL_DELETED = (u8)0xFE;

/// Extract 7-bit fingerprint (h2) in [0, 127].
u8 h2_fingerprint(i64 hash) {
    i64 h = (hash >> 57) & (i64)0x7F;
    return (u8)h;
}

/// Match 16 control bytes against target h2 fingerprint using SSE2.
/// Returns a 16-bit bitmask of matching bucket offsets.
i64 probe_group_match(u8* ctrl_ptr, u8 h2) {
    return asm("
        movq %rax, %r8
        movl %edi, %edx
        movd %edx, %xmm0
        punpcklbw %xmm0, %xmm0
        punpcklwd %xmm0, %xmm0
        pshufd $$0, %xmm0, %xmm0
        movdqu (%r8), %xmm1
        pcmpeqb %xmm0, %xmm1
        pmovmskb %xmm1, %eax
        movzwq %ax, %rax
    ", [ctrl_ptr, (i64)h2], ["rdx", "r8", "xmm0", "xmm1"]);
}

/// Match 16 control bytes against EMPTY (0x80) using SSE2.
/// Returns a 16-bit bitmask of empty bucket offsets.
i64 probe_group_empty(u8* ctrl_ptr) {
    return asm("
        movq %rax, %r8
        movl $$0x80808080, %edx
        movd %edx, %xmm0
        pshufd $$0, %xmm0, %xmm0
        movdqu (%r8), %xmm1
        pcmpeqb %xmm0, %xmm1
        pmovmskb %xmm1, %eax
        movzwq %ax, %rax
    ", [ctrl_ptr], ["rdx", "r8", "xmm0", "xmm1"]);
}

/// Match 16 control bytes for any free (EMPTY or DELETED, MSB=1) slot using SSE2.
i64 probe_group_free(u8* ctrl_ptr) {
    return asm("
        movdqu (%rax), %xmm0
        pmovmskb %xmm0, %eax
        movzwq %ax, %rax
    ", [ctrl_ptr], ["xmm0"]);
}

/// Bit scan forward (trailing zeros).
i64 trailing_zeros(i64 mask) {
    return asm("
        bsfq %rax, %rax
    ", [mask], []);
}

impl HashMap<K, V> {
    /// Create empty HashMap (no allocation until first insert).
    HashMap<K, V> new() {
        HashMap<K, V> m;
        m.keys = (K*)0;
        m.values = (V*)0;
        m.ctrl = (u8*)0;
        m.capacity = 0;
        m.len = 0;
        return m;
    }

    /// Number of live entries.
    i64 len(&self) {
        return self.len;
    }

    /// True when no entries.
    bool is_empty(&self) {
        return self.len == 0;
    }

    // -- Internal helpers ------------------------------------------------

    /// Set control byte at index, replicating to the overflow group if within first 16 slots.
    void set_ctrl(&mut self, i64 idx, u8 val) {
        self.ctrl[idx] = val;
        if (idx < 16) {
            self.ctrl[self.capacity + idx] = val;
        }
    }

    /// Grow table to at least `min_capacity`, rehashing all entries.
    void grow(&mut self, i64 min_capacity) {
        i64 new_cap = self.capacity;
        if (new_cap == 0) {
            new_cap = INITIAL_CAPACITY;
        }
        while (new_cap < min_capacity) {
            new_cap = new_cap * 2;
        }

        K* new_keys = alloc_n<K>(new_cap);
        V* new_vals = alloc_n<V>(new_cap);
        // +16 for SIMD control byte padding
        u8* new_ctrl = alloc_n<u8>(new_cap + 16);
        for (i64 j = 0; j < new_cap + 16; j = j + 1) {
            new_ctrl[j] = CTRL_EMPTY;
        }

        // Rehash existing entries — move owned K/V via Place Index so non-Copy
        // (String, Vec) transfers ownership (`new[slot]=move old[i]`) and the
        // old buffer's slots are left moved-from before `free`. POD-only
        // shallow copy (`key = old[i]; new[slot]=key`) removed.
        if (self.ctrl != (u8*)0) {
            i64 mask = new_cap - 1;
            for (i64 i = 0; i < self.capacity; i = i + 1) {
                if (self.ctrl[i] < (u8)0x80) {
                    K key = move self.keys[i];
                    V val = move self.values[i];
                    i64 h = @hash(key);
                    if (h < 0) { h = -h; }
                    u8 h2 = h2_fingerprint(h);
                    i64 idx = h & mask;
                    i64 step = 0;
                    while (true) {
                        i64 free_slots = probe_group_free(&new_ctrl[idx]);
                        if (free_slots != 0) {
                            i64 bit = trailing_zeros(free_slots);
                            i64 slot = (idx + bit) & mask;
                            new_keys[slot] = move key;
                            new_vals[slot] = move val;
                            new_ctrl[slot] = h2;
                            if (slot < 16) {
                                new_ctrl[new_cap + slot] = h2;
                            }
                            break;
                        }
                        step = step + 16;
                        idx = (idx + step) & mask;
                    }
                }
            }
            free(self.keys);
            free(self.values);
            free(self.ctrl);
        }

        self.keys = new_keys;
        self.values = new_vals;
        self.ctrl = new_ctrl;
        self.capacity = new_cap;
    }

    /// Find slot index for `key`. Returns -1 if not found.
    i64 find_slot(&self, K key) {
        if (self.capacity == 0 || self.len == 0) {
            return -1;
        }
        i64 h = @hash(key);
        if (h < 0) { h = -h; }
        return self.find_slot_with_hash(key, h);
    }

    /// Find slot for `key` given a pre-computed non-negative hash.
    /// Used by the entry API after the lookup key has been moved.
    i64 find_slot_with_hash(&self, K key, i64 h) {
        u8 h2 = h2_fingerprint(h);
        i64 mask = self.capacity - 1;
        i64 idx = h & mask;
        i64 step = 0;

        while (true) {
            i64 matches = probe_group_match(&self.ctrl[idx], h2);
            while (matches != 0) {
                i64 bit = trailing_zeros(matches);
                i64 slot = (idx + bit) & mask;
                if (self.keys[slot] == key) {
                    return slot;
                }
                matches = matches & (matches - 1);
            }
            i64 empties = probe_group_empty(&self.ctrl[idx]);
            if (empties != 0) {
                return -1;
            }
            step = step + 16;
            idx = (idx + step) & mask;
        }
        return -1;
    }

    // -- Public API ------------------------------------------------------

    /// Insert key-value pair. If key exists, value is replaced.
    void insert(&mut self, K key, V value) {
        i64 cap = self.capacity;
        if (cap == 0) {
            self.grow(INITIAL_CAPACITY);
        } else {
            f64 load = (f64)(self.len + 1) / (f64)cap;
            if (load > LOAD_FACTOR) {
                self.grow(cap * 2);
            }
        }

        i64 h = @hash(key);
        if (h < 0) { h = -h; }
        u8 h2 = h2_fingerprint(h);
        self._insert_at(h, h2, move key, move value);
    }

    /// Internal: insert with a pre-computed hash, returns the slot index.
    i64 _insert_at(&mut self, i64 h, u8 h2, K key, V value) {
        i64 mask = self.capacity - 1;
        i64 idx = h & mask;
        i64 first_available = -1;
        i64 step = 0;

        while (true) {
            i64 matches = probe_group_match(&self.ctrl[idx], h2);
            while (matches != 0) {
                i64 bit = trailing_zeros(matches);
                i64 slot = (idx + bit) & mask;
                if (self.keys[slot] == key) {
                    self.keys[slot] = move key;
                    self.values[slot] = move value;
                    return slot;
                }
                matches = matches & (matches - 1);
            }
            if (first_available == -1) {
                i64 free_slots = probe_group_free(&self.ctrl[idx]);
                if (free_slots != 0) {
                    i64 bit = trailing_zeros(free_slots);
                    first_available = (idx + bit) & mask;
                }
            }
            i64 empties = probe_group_empty(&self.ctrl[idx]);
            if (empties != 0) {
                self.keys[first_available] = move key;
                self.values[first_available] = move value;
                self.set_ctrl(first_available, h2);
                self.len = self.len + 1;
                return first_available;
            }
            step = step + 16;
            idx = (idx + step) & mask;
        }
        return -1;
    }

    /// Get value for key. Aborts if key not found.
    V get(&self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            return self.values[idx];
        }
        STDOUT.write_str("HashMap::get: key not found\n");
        abort();
        V dummy;
        return dummy;
    }

    /// Get value for key, or None when the key is absent.
    Optional<V> get_opt(&self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            return Some(self.values[idx]);
        }
        return None;
    }

    /// Get pointer to value for key. Aborts if key not found.
    V* get_ptr(&self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            return &self.values[idx];
        }
        STDOUT.write_str("HashMap::get_ptr: key not found\n");
        abort();
        return (V*)0;
    }

    /// Check if key exists.
    bool contains_key(&self, K key) {
        return self.find_slot(key) >= 0;
    }

    /// Remove key. Returns true if key was present.
    ///
    /// NOTE: This does NOT call per-element destructors — owned `K` / `V`
    /// values are leaked.  Use `remove` (which returns the owned pair) or
    /// `drain` to release owned elements explicitly.
    bool erase(&mut self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            self.set_ctrl(idx, CTRL_DELETED);
            self.len = self.len - 1;
            return true;
        }
        return false;
    }

    Optional<[K, V]> remove(&mut self, K key) {
        i64 idx = self.find_slot(key);
        if (idx < 0) {
            return None;
        }
        K k = move self.keys[idx];
        V v = move self.values[idx];
        self.set_ctrl(idx, CTRL_DELETED);
        self.len = self.len - 1;
        return Some([move k, move v]);
    }

    /// Mutable value access. Returns null when the key is absent.
    V* get_mut(&mut self, K key) {
        i64 idx = self.find_slot(key);
        if (idx < 0) {
            return (V*)0;
        }
        return &self.values[idx];
    }

    /// Ensure capacity for at least `additional` more entries.
    void reserve(&mut self, i64 additional) {
        if (additional <= 0) { return; }
        i64 required = self.len + additional;
        i64 cap = self.capacity;
        if (cap > 0) {
            f64 max_f = (f64)cap * LOAD_FACTOR;
            i64 max_supported = (i64)max_f;
            if (required <= max_supported) { return; }
        }
        i64 target = cap;
        if (target < INITIAL_CAPACITY) { target = INITIAL_CAPACITY; }
        while (true) {
            f64 max_f = (f64)target * LOAD_FACTOR;
            i64 max_supported = (i64)max_f;
            if (required <= max_supported) { break; }
            target = target * 2;
        }
        self.grow(target);
    }

    /// Rehash into the smallest capacity that fits the current length.
    void shrink_to_fit(&mut self) {
        i64 cap = self.capacity;
        if (cap == 0) { return; }
        i64 target = INITIAL_CAPACITY;
        while (target < cap) {
            f64 max_f = (f64)target * LOAD_FACTOR;
            i64 max_supported = (i64)max_f;
            if (self.len <= max_supported) { break; }
            target = target * 2;
        }
        if (target < cap) {
            self.grow(target);
        }
    }

    /// Remove all entries and release backing memory.
    ///
    /// NOTE: This does NOT call per-element destructors — owned `K` / `V`
    /// values are leaked.  Use `drain` first to release owned elements.
    void clear(&mut self) {
        if (self.ctrl != (u8*)0) {
            free(self.keys);
            free(self.values);
            free(self.ctrl);
            self.keys = (K*)0;
            self.values = (V*)0;
            self.ctrl = (u8*)0;
        }
        self.capacity = 0;
        self.len = 0;
    }

    /// Drain all live entries, yielding owned `(K, V)` pairs.
    /// `&mut self` — moves buffers out (`keys/values/ctrl`) and clears map
    /// so it is empty but still live (re-usable). Iterator owns buffers;
    /// each `next()` moves `K`/`V` via `move keys[idx]` (Place Index).
    HashMapDrain<K, V> drain(&mut self) {
        HashMapDrain<K, V> d;
        d.keys = move self.keys;
        d.values = move self.values;
        d.ctrl = move self.ctrl;
        d.capacity = self.capacity;
        d.idx = 0;
        self.keys = (K*)0;
        self.values = (V*)0;
        self.ctrl = (u8*)0;
        self.capacity = 0;
        self.len = 0;
        return d;
    }

    /// Indexed access: map[key] — returns value for key, aborts if not found.
    V __index_get(&self, K key) {
        return self.get(key);
    }

    /// Indexed assignment: map[key] = value — inserts or updates entry.
    void __index_set(&mut self, K key, V value) {
        self.insert(key, value);
    }
}

impl<K, V> Drop for HashMap<K, V> {
    /// Free all memory. Does NOT call per-element destructors.
    void drop(*self) {
        if (self.ctrl != (u8*)0) {
            free(self.keys);
            free(self.values);
            free(self.ctrl);
            self.keys = (K*)0;
            self.values = (V*)0;
            self.ctrl = (u8*)0;
        }
        self.capacity = 0;
        self.len = 0;
    }
}

struct HashMapEntry<K, V> {
    K key;
    V value;
}

struct HashMapIntoIter<K, V> {
    K* keys;
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 idx;
}

impl<K, V> IntoIterator for HashMap<K, V> {
    type Item = HashMapEntry<K, V>;
    type IntoIter = HashMapIntoIter<K, V>;
    /// Consumes the map, moving its buffers into the iterator.
    /// `self` (by value) — not `&self` — so `move self.keys` drains and
    /// leaves `self` moved-from (null/0). Iterator owns and frees buffers;
    /// `next()` moves each entry via Place Index.
    HashMapIntoIter<K, V> into_iter(self) {
        HashMapIntoIter<K, V> it;
        it.keys = move self.keys;
        it.values = move self.values;
        it.ctrl = move self.ctrl;
        it.capacity = self.capacity;
        it.idx = 0;
        self.keys = (K*)0;
        self.values = (V*)0;
        self.ctrl = (u8*)0;
        self.capacity = 0;
        self.len = 0;
        return it;
    }
}
impl<K, V> Drop for HashMapIntoIter<K, V> {
    void drop(*self) {
        if (self.ctrl != (u8*)0) {
            free(self.keys);
            free(self.values);
            free(self.ctrl);
            self.keys = (K*)0;
            self.values = (V*)0;
            self.ctrl = (u8*)0;
        }
        self.capacity = 0;
        self.idx = 0;
    }
}

impl<K, V> Iterator for HashMapIntoIter<K, V> {
    type Item = HashMapEntry<K, V>;
    /// Consuming iterator — moves each entry out (`move keys[idx]`/`move values[idx]`)
    /// so owned K/V transfers; `Copy` K/V bitwise-copy via same `move`.
    Optional<HashMapEntry<K, V>> next(*self) {
        if (self.ctrl == (u8*)0) {
            return Optional<HashMapEntry<K, V>>.none();
        }
        while (self.idx < self.capacity) {
            u8 ctrl = self.ctrl[self.idx];
            if (ctrl < (u8)0x80) {
                HashMapEntry<K, V> e;
                e.key = move self.keys[self.idx];
                e.value = move self.values[self.idx];
                self.idx = self.idx + 1;
                return Optional<HashMapEntry<K, V>>.some(move e);
            }
            self.idx = self.idx + 1;
        }
        return Optional<HashMapEntry<K, V>>.none();
    }
}

struct HashMapIter<K, V> {
    K* keys;
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 idx;
}

impl<K, V> HashMap<K, V> {
    /// Borrows the map and yields live `(K, V)` entries as owned copies.
    /// `&self` — does NOT consume the map; iterator holds raw
    /// pointers and yields via copy (`keys[idx]`/`values[idx]`). Map stays live.
    HashMapIter<K, V> iter(&self) {
        HashMapIter<K, V> it;
        it.keys = self.keys;
        it.values = self.values;
        it.ctrl = self.ctrl;
        it.capacity = self.capacity;
        it.idx = 0;
        return it;
    }

    /// Iterate over all live values, yielding owned copies.
    HashMapValuesIter<K, V> values(&self) {
        HashMapValuesIter<K, V> it;
        it.values = self.values;
        it.ctrl = self.ctrl;
        it.capacity = self.capacity;
        it.idx = 0;
        return it;
    }

    /// Iterate over all live keys, yielding owned copies.
    HashMapKeysIter<K, V> keys(&self) {
        HashMapKeysIter<K, V> it;
        it.keys = self.keys;
        it.ctrl = self.ctrl;
        it.capacity = self.capacity;
        it.idx = 0;
        return it;
    }

    /// Iterate over all live values yielding owned copies (non-destructive).
    HashMapIterMut<K, V> iter_mut(&mut self) {
        HashMapIterMut<K, V> it;
        it.values = self.values;
        it.ctrl = self.ctrl;
        it.capacity = self.capacity;
        it.idx = 0;
        return it;
    }

    /// Open an entry-handle for `key`. The handle borrows the map mutably
    /// for its lifetime; the borrow checker statically prevents any other
    /// access to the map until the handle is dropped.
    HashMapEntryRef<K, V> entry(&mut self, K key) {
        HashMapEntryRef<K, V> e;
        e.map = self;
        e.key = key;
        e.inserted = false;
        if (self.capacity > 0 && self.len > 0) {
            i64 h = @hash(e.key);
            if (h < 0) { h = -h; }
            e.idx = self.find_slot_with_hash(e.key, h);
        } else {
            e.idx = -1;
        }
        return e;
    }
}

impl<K, V> Iterator for HashMapIter<K, V> {
    type Item = HashMapEntry<K, V>;
    Optional<HashMapEntry<K, V>> next(*self) {
        if (self.ctrl == (u8*)0) {
            return Optional<HashMapEntry<K, V>>.none();
        }
        while (self.idx < self.capacity) {
            u8 ctrl = self.ctrl[self.idx];
            if (ctrl < (u8)0x80) {
                HashMapEntry<K, V> e;
                e.key = self.keys[self.idx];
                e.value = self.values[self.idx];
                self.idx = self.idx + 1;
                return Optional<HashMapEntry<K, V>>.some(e);
            }
            self.idx = self.idx + 1;
        }
        return Optional<HashMapEntry<K, V>>.none();
    }
}

struct HashMapKeysIter<K, V> {
    K* keys;
    u8* ctrl;
    i64 capacity;
    i64 idx;
}
impl<K, V> Iterator for HashMapKeysIter<K, V> {
    type Item = K;
    Optional<K> next(*self) {
        if (self.ctrl == (u8*)0) {
            return None;
        }
        while (self.idx < self.capacity) {
            u8 ctrl = self.ctrl[self.idx];
            if (ctrl < (u8)0x80) {
                K k = self.keys[self.idx];
                self.idx = self.idx + 1;
                return Some(k);
            }
            self.idx = self.idx + 1;
        }
        return None;
    }
}
struct HashMapValuesIter<K, V> {
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 idx;
}
impl<K, V> Iterator for HashMapValuesIter<K, V> {
    type Item = V;
    Optional<V> next(*self) {
        if (self.ctrl == (u8*)0) {
            return None;
        }
        while (self.idx < self.capacity) {
            u8 ctrl = self.ctrl[self.idx];
            if (ctrl < (u8)0x80) {
                V v = self.values[self.idx];
                self.idx = self.idx + 1;
                return Some(v);
            }
            self.idx = self.idx + 1;
        }
        return None;
    }
}
struct HashMapIterMut<K, V> {
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 idx;
}
impl<K, V> Iterator for HashMapIterMut<K, V> {
    type Item = V;
    Optional<V> next(*self) {
        if (self.ctrl == (u8*)0) {
            return None;
        }
        while (self.idx < self.capacity) {
            u8 ctrl = self.ctrl[self.idx];
            if (ctrl < (u8)0x80) {
                V v = self.values[self.idx];
                self.idx = self.idx + 1;
                return Some(v);
            }
            self.idx = self.idx + 1;
        }
        return None;
    }
}
struct HashMapDrain<K, V> {
    K* keys;
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 idx;
}
impl<K, V> Drop for HashMapDrain<K, V> {
    void drop(*self) {
        if (self.ctrl != (u8*)0) {
            free(self.keys);
            free(self.values);
            free(self.ctrl);
            self.keys = (K*)0;
            self.values = (V*)0;
            self.ctrl = (u8*)0;
        }
        self.capacity = 0;
        self.idx = 0;
    }
}
impl<K, V> Iterator for HashMapDrain<K, V> {
    type Item = [K, V];
    /// Draining iterator — moves each tuple out (`move keys[idx]`/`move values[idx]`)
    /// so owned T transfers; same `move` is a copy for `Copy` T.
    Optional<[K, V]> next(*self) {
        if (self.ctrl == (u8*)0) {
            return None;
        }
        while (self.idx < self.capacity) {
            u8 ctrl = self.ctrl[self.idx];
            if (ctrl < (u8)0x80) {
                K k = move self.keys[self.idx];
                V v = move self.values[self.idx];
                self.idx = self.idx + 1;
                return Some([move k, move v]);
            }
            self.idx = self.idx + 1;
        }
        return None;
    }
}
struct HashMapEntryRef<K, V> {
    HashMap<K, V>* map;
    K key;
    i64 idx;
    bool inserted;
}
impl<K, V> HashMapEntryRef<K, V> {
    bool was_present(&self) {
        return self.idx >= 0 && !self.inserted;
    }

    bool is_vacant(&self) {
        return self.idx < 0;
    }

    V* get_ptr(&self) {
        if (self.idx < 0) { return (V*)0; }
        return &self.map.values[self.idx];
    }

    V* get_mut_ptr(&self) {
        if (self.idx < 0) { return (V*)0; }
        return &self.map.values[self.idx];
    }

    Optional<V> take(&mut self) {
        if (self.idx < 0) {
            return None;
        }
        V v = move self.map.values[self.idx];
        self.map.set_ctrl(self.idx, CTRL_DELETED);
        self.map.len = self.map.len - 1;
        self.idx = -1;
        return Some(move v);
    }

    V* or_insert(&mut self, V default) {
        if (self.idx >= 0) {
            return &self.map.values[self.idx];
        }
        i64 cap = self.map.capacity;
        if (cap == 0) {
            self.map.grow(INITIAL_CAPACITY);
        } else {
            f64 load = (f64)(self.map.len + 1) / (f64)cap;
            if (load > LOAD_FACTOR) {
                self.map.grow(cap * 2);
            }
        }
        i64 h = @hash(self.key);
        if (h < 0) { h = -h; }
        u8 h2 = h2_fingerprint(h);
        self.idx = self.map._insert_at(h, h2, move self.key, move default);
        self.inserted = true;
        return &self.map.values[self.idx];
    }

    V* or_insert_with(&mut self, V () f) {
        if (self.idx >= 0) {
            return &self.map.values[self.idx];
        }
        V def = f();
        return self.or_insert(move def);
    }

    void and_modify(&mut self, void (V*) f) {
        if (self.idx < 0) { return; }
        f(&self.map.values[self.idx]);
    }
}

// -- Ownership smoke (manual check) ---------------------------------------
// HashMap<String,String> growth + remove + drain + into_iter:
//   HashMap<String,String> m = HashMap<String,String>.new();
//   m.insert(String.from_str("k1"), String.from_str("v1")); // move in
//   m.insert(String.from_str("k2"), String.from_str("v2")); // may grow via move
//   Optional<Pair<String,String>> o = m.remove(String.from_str("k1")); // move out
//   HashMapDrain<String,String> d = m.drain(); // each next() moves Pair<String,String>
//   HashMap<String,String> m2 = HashMap<String,String>.new();
//   m2.insert(String.from_str("a"), String.from_str("b"));
//   HashMapIntoIter<String,String> it = m2.into_iter(); // each next() moves entry
//   // remaining buffers freed via free only; no double-free of owned Strings
