import std.optional;
import std.mem.alloc;
import std.hash;
import std.io.file;
import std.mem.drop;

// Internal entry state: Swiss Table 16-byte metadata control groups.
// Control byte values:
// 0x80 (128): Empty bucket
// 0xFE (254): Deleted bucket (tombstone)
// 0..127: Occupied bucket with 7-bit hash fingerprint (h2)
struct HashMap<K, V> {
    K* keys;
    V* values;
    u8* ctrl;
    i64 capacity;
    i64 len;
}

const i64 INITIAL_CAPACITY = 16;
const f64 LOAD_FACTOR = 0.875;
const u8 CTRL_EMPTY = (u8)0x80;
const u8 CTRL_DELETED = (u8)0xFE;

/// Extract 7-bit fingerprint (h2) in [0, 127].
u8 h2_fingerprint(i64 hash) {
    i64 h = (hash >> 57) & (i64)0x7F;
    return (u8)h;
}

/// Match 16 control bytes against target h2 fingerprint using SSE2.
/// Returns a 16-bit bitmask of matching bucket offsets.
i64 probe_group_match(u8* ctrl_ptr, u8 h2) {
    return asm("
        movq %rax, %r8
        movl %edi, %edx
        movd %edx, %xmm0
        punpcklbw %xmm0, %xmm0
        punpcklwd %xmm0, %xmm0
        pshufd $$0, %xmm0, %xmm0
        movdqu (%r8), %xmm1
        pcmpeqb %xmm0, %xmm1
        pmovmskb %xmm1, %eax
        movzwq %ax, %rax
    ", [ctrl_ptr, (i64)h2], ["rdx", "r8", "xmm0", "xmm1"]);
}

/// Match 16 control bytes against EMPTY (0x80) using SSE2.
/// Returns a 16-bit bitmask of empty bucket offsets.
i64 probe_group_empty(u8* ctrl_ptr) {
    return asm("
        movq %rax, %r8
        movl $$0x80808080, %edx
        movd %edx, %xmm0
        pshufd $$0, %xmm0, %xmm0
        movdqu (%r8), %xmm1
        pcmpeqb %xmm0, %xmm1
        pmovmskb %xmm1, %eax
        movzwq %ax, %rax
    ", [ctrl_ptr], ["rdx", "r8", "xmm0", "xmm1"]);
}

/// Match 16 control bytes for any free (EMPTY or DELETED, MSB=1) slot using SSE2.
i64 probe_group_free(u8* ctrl_ptr) {
    return asm("
        movdqu (%rax), %xmm0
        pmovmskb %xmm0, %eax
        movzwq %ax, %rax
    ", [ctrl_ptr], ["xmm0"]);
}

/// Bit scan forward (trailing zeros).
i64 trailing_zeros(i64 mask) {
    return asm("
        bsfq %rax, %rax
    ", [mask], []);
}

impl HashMap<K, V> {
    /// Create empty HashMap (no allocation until first insert).
    HashMap<K, V> new() {
        HashMap<K, V> m;
        m.keys = (K*)0;
        m.values = (V*)0;
        m.ctrl = (u8*)0;
        m.capacity = 0;
        m.len = 0;
        return m;
    }

    /// Number of live entries.
    i64 len(&HashMap<K, V> self) {
        return self.len;
    }

    /// True when no entries.
    bool is_empty(&HashMap<K, V> self) {
        return self.len == 0;
    }

    // -- Internal helpers ------------------------------------------------

    /// Set control byte at index, replicating to the overflow group if within first 16 slots.
    void set_ctrl(&mut HashMap<K, V> self, i64 idx, u8 val) {
        self.ctrl[idx] = val;
        if (idx < 16) {
            self.ctrl[self.capacity + idx] = val;
        }
    }

    /// Grow table to at least `min_capacity`, rehashing all entries.
    void grow(&mut HashMap<K, V> self, i64 min_capacity) {
        i64 new_cap = self.capacity;
        if (new_cap == 0) {
            new_cap = INITIAL_CAPACITY;
        }
        while (new_cap < min_capacity) {
            new_cap = new_cap * 2;
        }

        K* new_keys = alloc<K>(new_cap);
        V* new_vals = alloc<V>(new_cap);
        // Extra 16 bytes for seamless SIMD group wrapping
        u8* new_ctrl = alloc<u8>(new_cap + 16);
        for (i64 j = 0; j < new_cap + 16; j = j + 1) {
            new_ctrl[j] = CTRL_EMPTY;
        }

        // Rehash existing entries
        if (self.ctrl != (u8*)0) {
            i64 mask = new_cap - 1;
            for (i64 i = 0; i < self.capacity; i = i + 1) {
                if (self.ctrl[i] < (u8)0x80) {
                    K key = self.keys[i];
                    V val = self.values[i];
                    i64 h = @hash(key);
                    if (h < 0) { h = -h; }
                    u8 h2 = h2_fingerprint(h);
                    i64 idx = h & mask;
                    i64 step = 0;
                    while (true) {
                        i64 free_slots = probe_group_free(&new_ctrl[idx]);
                        if (free_slots != 0) {
                            i64 bit = trailing_zeros(free_slots);
                            i64 slot = (idx + bit) & mask;
                            new_keys[slot] = move key;
                            new_vals[slot] = move val;
                            new_ctrl[slot] = h2;
                            if (slot < 16) {
                                new_ctrl[new_cap + slot] = h2;
                            }
                            break;
                        }
                        step = step + 16;
                        idx = (idx + step) & mask;
                    }
                }
            }
            free(self.keys);
            free(self.values);
            free(self.ctrl);
        }

        self.keys = new_keys;
        self.values = new_vals;
        self.ctrl = new_ctrl;
        self.capacity = new_cap;
    }

    /// Find slot index for `key`. Returns -1 if not found.
    i64 find_slot(&HashMap<K, V> self, K key) {
        if (self.capacity == 0 || self.len == 0) {
            return -1;
        }
        i64 h = @hash(key);
        if (h < 0) { h = -h; }
        u8 h2 = h2_fingerprint(h);
        i64 mask = self.capacity - 1;
        i64 idx = h & mask;
        i64 step = 0;

        while (true) {
            i64 matches = probe_group_match(&self.ctrl[idx], h2);
            while (matches != 0) {
                i64 bit = trailing_zeros(matches);
                i64 slot = (idx + bit) & mask;
                if (self.keys[slot] == key) {
                    return slot;
                }
                matches = matches & (matches - 1);
            }
            i64 empties = probe_group_empty(&self.ctrl[idx]);
            if (empties != 0) {
                return -1;
            }
            step = step + 16;
            idx = (idx + step) & mask;
        }
        return -1;
    }

    // -- Public API ------------------------------------------------------

    /// Insert key-value pair. If key exists, value is replaced.
    void insert(&mut HashMap<K, V> self, K key, V value) {
        i64 cap = self.capacity;
        if (cap == 0) {
            self.grow(INITIAL_CAPACITY);
            cap = self.capacity;
        } else {
            f64 load = (f64)(self.len + 1) / (f64)cap;
            if (load > LOAD_FACTOR) {
                self.grow(cap * 2);
                cap = self.capacity;
            }
        }

        i64 h = @hash(key);
        if (h < 0) { h = -h; }
        u8 h2 = h2_fingerprint(h);
        i64 mask = cap - 1;
        i64 idx = h & mask;
        i64 first_available = -1;
        i64 step = 0;

        while (true) {
            i64 matches = probe_group_match(&self.ctrl[idx], h2);
            while (matches != 0) {
                i64 bit = trailing_zeros(matches);
                i64 slot = (idx + bit) & mask;
                if (self.keys[slot] == key) {
                    self.keys[slot] = move key;
                    self.values[slot] = move value;
                    return;
                }
                matches = matches & (matches - 1);
            }
            if (first_available == -1) {
                i64 free_slots = probe_group_free(&self.ctrl[idx]);
                if (free_slots != 0) {
                    i64 bit = trailing_zeros(free_slots);
                    first_available = (idx + bit) & mask;
                }
            }
            i64 empties = probe_group_empty(&self.ctrl[idx]);
            if (empties != 0) {
                self.keys[first_available] = move key;
                self.values[first_available] = move value;
                self.set_ctrl(first_available, h2);
                self.len = self.len + 1;
                return;
            }
            step = step + 16;
            idx = (idx + step) & mask;
        }
    }

    /// Get value for key. Aborts if key not found.
    V get(&HashMap<K, V> self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            return self.values[idx];
        }
        STDOUT.write_str("HashMap::get: key not found\n");
        abort();
        V dummy;
        return dummy;
    }

    /// Get value for key, or None when the key is absent.
    Optional<V> get_opt(&HashMap<K, V> self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            return Optional<V>.some(self.values[idx]);
        }
        return Optional<V>.none();
    }

    /// Get pointer to value for key. Aborts if key not found.
    V* get_ptr(&HashMap<K, V> self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            return &self.values[idx];
        }
        STDOUT.write_str("HashMap::get_ptr: key not found\n");
        abort();
        return (V*)0;
    }

    /// Check if key exists.
    bool contains_key(&HashMap<K, V> self, K key) {
        return self.find_slot(key) >= 0;
    }

    /// Remove key. Returns true if key was present.
    bool erase(&mut HashMap<K, V> self, K key) {
        i64 idx = self.find_slot(key);
        if (idx >= 0) {
            self.set_ctrl(idx, CTRL_DELETED);
            self.len = self.len - 1;
            return true;
        }
        return false;
    }

    /// Remove all entries and release backing memory.
    void clear(&mut HashMap<K, V> self) {
        if (self.ctrl != (u8*)0) {
            free(self.keys);
            free(self.values);
            free(self.ctrl);
            self.keys = (K*)0;
            self.values = (V*)0;
            self.ctrl = (u8*)0;
        }
        self.capacity = 0;
        self.len = 0;
    }

    /// Indexed access: map[key] — returns value for key, aborts if not found.
    V __index_get(&HashMap<K, V> self, K key) {
        return self.get(key);
    }

    /// Indexed assignment: map[key] = value — inserts or updates entry.
    void __index_set(&mut HashMap<K, V> self, K key, V value) {
        self.insert(key, value);
    }
}

impl<K, V> Drop for HashMap<K, V> {
    /// Free all memory. Does NOT call per-element destructors.
    void drop(HashMap<K, V>* self) {
        if (self.ctrl != (u8*)0) {
            free(self.keys);
            free(self.values);
            free(self.ctrl);
            self.keys = (K*)0;
            self.values = (V*)0;
            self.ctrl = (u8*)0;
        }
        self.capacity = 0;
        self.len = 0;
    }
}
