// std/fs.ag — native filesystem operations.
//
// Portable over the `sys_*` platform seam (std/sys/os.ag): directory
// listing, mkdir/rmdir, and existence probes resolve per-platform, so this
// module carries no cfg gating of its own.

import std.error;
import std.io.file;
import std.mem.memory;
import std.mem.vec;
import std.result;
import std.string;
import std.sys.os;

/// Metadata for a file or directory.
struct Metadata {
    i64 size;
    i64 mtime_sec;
    i64 mtime_nsec;
    bool is_dir;
    bool is_file;
}

/// Read entire file at `path` into an owned String.
Result<String, Error> read_file(str path) {
    return String.from_file(path);
}

/// Write entire string `content` to file at `path`. Overwrites existing file.
/// Returns true on success.
bool write_file(str path, str content) {
    File f = File.open_write(path);
    if (!f.valid()) {
        return false;
    }
    i32 r = f.write_str(content);
    f.close();
    return r == 0;
}

/// Check whether a file or directory exists at `path`.
bool exists(str path) {
    if (path == (str)0) {
        return false;
    }
    i64 r = sys_access((i64)path, 0); // F_OK = 0
    return r == 0;
}

/// Query metadata for path.
Result<Metadata, Error> metadata(str path) {
    Result<FileStat, Error> r = stat_path(path);
    if (r.is_err()) {
        return Result<Metadata, Error>.Err(r.unwrap_err());
    }
    FileStat st = r.unwrap();
    Metadata m;
    m.size = st.size;
    m.mtime_sec = st.mtime_sec;
    m.mtime_nsec = st.mtime_nsec;
    m.is_dir = st.is_dir();
    m.is_file = st.is_file();
    return Result<Metadata, Error>.Ok(m);
}

/// Returns true if `path` is a directory.
bool is_dir(str path) {
    Result<Metadata, Error> r = metadata(path);
    if (r.is_err()) {
        return false;
    }
    Metadata m = r.unwrap();
    return m.is_dir;
}

/// Returns true if `path` is a regular file.
bool is_file(str path) {
    Result<Metadata, Error> r = metadata(path);
    if (r.is_err()) {
        return false;
    }
    Metadata m = r.unwrap();
    return m.is_file;
}

/// Read entries of directory at `path`. Excludes "." and "..".
Result<Vec<String>, Error> read_dir(str path) {
    if (path == (str)0) {
        Error e = Error.new(22, "invalid path"); // EINVAL
        return Result<Vec<String>, Error>.Err(move e);
    }
    // One seam call fills a NUL-separated name buffer on either platform.
    u8 buf[16384];
    i64 n = sys_list_dir((i64)path, &buf[0], 16384);
    if (n < 0) {
        Error e = Error.new(-n, "list directory failed");
        return Result<Vec<String>, Error>.Err(move e);
    }
    Vec<String> entries = Vec<String>.new();
    i64 off = 0;
    i64 i = 0;
    while (i < n) {
        str name = (str)&buf[off];
        entries.push(String.from_str(name));
        while (buf[off] != (u8)0) {
            off += 1;
        }
        off += 1;
        i += 1;
    }
    return Result<Vec<String>, Error>.Ok(move entries);
}

/// Create a new directory at `path` with mode 0755. Returns true on success.
bool create_dir(str path) {
    if (path == (str)0) {
        return false;
    }
    i64 r = sys_mkdir((i64)path, 493); // 0755 octal = 493 decimal
    return r == 0;
}

/// Remove a file at `path`. Returns true on success.
bool remove_file(str path) {
    if (path == (str)0) {
        return false;
    }
    i64 r = sys_unlink((i64)path);
    return r == 0;
}

/// Remove an empty directory at `path`. Returns true on success.
bool remove_dir(str path) {
    if (path == (str)0) {
        return false;
    }
    i64 r = sys_rmdir((i64)path);
    return r == 0;
}

/// Recursively remove directory at `path` and all its contents. Returns true on success.
bool remove_dir_all(str path) {
    if (path == (str)0) {
        return false;
    }
    Result<Vec<String>, Error> r = read_dir(path);
    if (r.is_err()) {
        return false;
    }
    Vec<String> entries = r.unwrap();
    bool ok = true;
    for (i64 i = 0; i < entries.len(); i = i + 1) {
        String* name = entries.get_ptr(i);
        String child = String.from_str(path);
        if (!child.ends_with("/")) {
            child.push_str("/");
        }
        child.push_str(name.to_str());
        str child_str = child.to_str();
        if (is_dir(child_str)) {
            if (!remove_dir_all(child_str)) {
                ok = false;
            }
        } else {
            if (!remove_file(child_str)) {
                ok = false;
            }
        }
        child.drop();
        name.drop();
    }
    entries.drop();
    if (!ok) {
        return false;
    }
    return remove_dir(path);
}

/// Rename file or directory from `from` to `to`. Returns true on success.
bool rename(str from, str to) {
    if (from == (str)0 || to == (str)0) {
        return false;
    }
    i64 r = sys_rename((i64)from, (i64)to);
    return r == 0;
}

/// Copy file from `from` to `to`. Returns true on success.
bool copy_file(str from, str to) {
    Result<String, Error> content = read_file(from);
    if (content.is_err()) {
        return false;
    }
    String s = content.unwrap();
    bool ok = write_file(to, s.to_str());
    s.drop();
    return ok;
}

/// Returns the size in bytes of file at `path`, or -1 on error.
i64 file_size(str path) {
    File f = File.open_read(path);
    if (!f.valid()) {
        return -1;
    }
    i64 sz = f.size();
    f.close();
    return sz;
}
