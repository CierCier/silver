// std/display.ag — Display formatting trait.
//
// The `Display` trait is recognized by the compiler's compile-time
// `print`/`format` expansion.  Types that implement `Display` can be
// formatted with `{}` placeholders.
//
// Primitive types (i64, u64, f64, bool, str) have built-in implementations
// that forward to BufWriter's write_T methods.

import std.io.file;  // BufWriter only — never the full std.io (that would
                      // drag scanner/byte_stream (and thus std.optional /
                      // std.iter) into every module that imports Display,
// colliding with user types that shadow those names.

/// Trait for types that can be formatted for display.
trait Display {
    void fmt(*self, BufWriter* out);
}

// Primitives — redirect to BufWriter.write_T methods
impl Display for i64 {
    void fmt(*self, BufWriter* out) { out.write_i64(*self); }
}
impl Display for i32 {
    void fmt(*self, BufWriter* out) { out.write_i64((i64)*self); }
}
impl Display for i16 {
    void fmt(*self, BufWriter* out) { out.write_i64((i64)*self); }
}
impl Display for i8 {
    void fmt(*self, BufWriter* out) { out.write_i64((i64)*self); }
}
impl Display for u64 {
    void fmt(*self, BufWriter* out) { out.write_u64(*self); }
}
impl Display for u32 {
    void fmt(*self, BufWriter* out) { out.write_u64((u64)*self); }
}
impl Display for u16 {
    void fmt(*self, BufWriter* out) { out.write_u64((u64)*self); }
}
impl Display for u8 {
    void fmt(*self, BufWriter* out) { out.write_u64((u64)*self); }
}
impl Display for f64 {
    void fmt(*self, BufWriter* out) { out.write_f64(*self); }
}
impl Display for f32 {
    void fmt(*self, BufWriter* out) { out.write_f64((f64)*self); }
}
impl Display for bool {
    void fmt(*self, BufWriter* out) { out.write_bool(*self); }
}
// NOTE: `char` truncates to a single byte, matching the primitive writer
// path (`write_u8`) this replaces.
impl Display for char {
    void fmt(*self, BufWriter* out) { out.write_u8((u8)*self); }
}
impl Display for str {
    void fmt(*self, BufWriter* out) { out.write_str(*self); }
}
// NOTE: `impl Display for String` lives in std/string.ag next to `String`
// and `to_str`: display.ag must not reference `String`, or units that
// inline display.ag without string.ag (e.g. cached leaf modules) fail to
// resolve the body.
impl Display for i128 {
    void fmt(*self, BufWriter* out) { out.write_i128(*self); }
}
impl Display for u128 {
    void fmt(*self, BufWriter* out) { out.write_u128(*self); }
}
