import std.mem.alloc;
import std.mem.drop;
import std.mem.memory;
import std.ops;
import std.iter;
import std.optional;
import std.slice;
struct Bytes {
    u8* data;
    i64 len;
    i64 cap;
}

impl Bytes {
    Bytes new() {
        return Bytes.with_capacity(0);
    }

    Bytes from_str(str text) {
        i64 n = strlen((const u8*)text);
        Bytes b = Bytes.with_capacity(n);
        if (n > 0) {
            memcpy((void*)b.data, (const void*)text, n);
            b.len = n;
        }
        return b;
    }

    Bytes with_capacity(i64 capacity) {
        Bytes b;
        b.len = 0;
        b.cap = capacity;
        if (capacity > 0) {
            b.data = alloc_n<u8>(capacity);
        } else {
            b.data = (u8*)0;
        }
        return b;
    }

    i64 len(&Bytes self) {
        return self.len;
    }

    /// True when `len` is zero.
    bool is_empty(&Bytes self) {
        return self.len == 0;
    }

    i64 capacity(&Bytes self) {
        return self.cap;
    }

    /// Take ownership of the buffer out of `self`, leaving it empty
    /// (allocation-free). Unlike a plain copy-then-replace, the taken
    /// buffer is not dropped: the caller owns it. `dst = src.take(&src)`
    /// is the single-owner transfer primitive.
    Bytes take(Bytes* self) {
        Bytes out;
        out.data = self.data;
        out.len = self.len;
        out.cap = self.cap;
        self.data = (u8*)0;
        self.len = 0;
        self.cap = 0;
        return out;
    }

    void push(&mut Bytes self, u8 byte) {
        if (self.len + 1 > self.cap) {
            i64 new_cap = self.cap * 2;
            if (new_cap < 16) {
                new_cap = 16;
            }
            self.data = realloc<u8>(self.data, new_cap);
            self.cap = new_cap;
        }
        self.data[self.len] = byte;
        self.len = self.len + 1;
    }

    void extend(&mut Bytes self, u8* src, i64 src_len) {
        if (src_len <= 0 || src == (u8*)0) {
            return;
        }
        bool is_internal = false;
        i64 src_offset = 0;
        if (self.data != (u8*)0 && (i64)src >= (i64)self.data && (i64)src < (i64)self.data + self.cap) {
            src_offset = (i64)src - (i64)self.data;
        }
        if (self.len + src_len > self.cap) {
            i64 new_cap = self.cap * 2;
            if (new_cap < self.len + src_len) {
                new_cap = self.len + src_len;
            }
            if (new_cap < 16) {
                new_cap = 16;
            }
            self.data = realloc<u8>(self.data, new_cap);
            self.cap = new_cap;
            if (is_internal) {
                src = (u8*)((i64)self.data + src_offset);
            }
        }
        silver_rt_memcpy(&self.data[self.len], src, src_len);
        self.len = self.len + src_len;
    }

    /// Find first occurrence of `byte`. Returns index, or -1 if not found.
    i64 find(&Bytes self, u8 byte) {
        return mem_find_byte(self.data, byte, self.len);
    }

    /// Find last occurrence of `byte`. Returns index, or -1 if not found.
    i64 rfind(&Bytes self, u8 byte) {
        return mem_find_byte_back(self.data, byte, self.len);
    }

    /// Count occurrences of `byte`.
    i64 count(&Bytes self, u8 byte) {
        return mem_count_byte(self.data, byte, self.len);
    }

    /// True if `byte` is present in buffer.
    bool contains(&Bytes self, u8 byte) {
        return self.find(byte) >= 0;
    }

    /// True if buffer begins with `prefix`.
    bool starts_with(&Bytes self, u8* prefix, i64 prefix_len) {
        if (prefix == (u8*)0 || prefix_len <= 0) {
            return true;
        }
        if (self.len < prefix_len) {
            return false;
        }
        return memcmp((const void*)self.data, (const void*)prefix, prefix_len) == 0;
    }

    /// True if buffer ends with `suffix`.
    bool ends_with(&Bytes self, u8* suffix, i64 suffix_len) {
        if (suffix == (u8*)0 || suffix_len <= 0) {
            return true;
        }
        if (self.len < suffix_len) {
            return false;
        }
        return memcmp((const void*)&self.data[self.len - suffix_len], (const void*)suffix, suffix_len) == 0;
    }

    /// True if two byte buffers have identical contents.
    bool equals(&Bytes self, Bytes* other) {
        if (other == (Bytes*)0) {
            return false;
        }
        if (self.len != other.len) {
            return false;
        }
        if (self.len == 0) {
            return true;
        }
        return memcmp((const void*)self.data, (const void*)other.data, self.len) == 0;
    }

    /// Read byte at `index`. Out-of-bounds indices abort deterministically in every build profile.
    u8 get(&Bytes self, i64 index) {
        if (index < 0 || index >= self.len) {
            abort();
        }
        return self.data[index];
    }

    /// Read byte at `index` without bounds checking.
    u8 get_unchecked(&Bytes self, i64 index) {
        return self.data[index];
    }

    /// Write `value` at `index`. Out-of-bounds indices abort deterministically in every build profile.
    void set(&mut Bytes self, i64 index, u8 value) {
        if (index < 0 || index >= self.len) {
            abort();
        }
        self.data[index] = value;
    }

    /// Write `value` at `index` without bounds checking.
    void set_unchecked(&mut Bytes self, i64 index, u8 value) {
        self.data[index] = value;
    }
    u8* as_ptr(&Bytes self) {
        return self.data;
    }

    void clear(&mut Bytes self) {
        self.len = 0;
    }
}

impl Drop for Bytes {
    void drop(Bytes* self) {
        if (self.data != (u8*)0) {
            free(self.data);
            self.data = (u8*)0;
        }
        self.len = 0;
        self.cap = 0;
    }
}

impl IndexedAccess for Bytes {
    type Item = u8;
    u8 __index_get(Bytes* self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }
    void __index_set(Bytes* self, i64 index, u8 value) {
        if (index < 0 || index >= self.len) { abort(); }
        self.data[index] = value;
    }
}


struct BytesIter {
    u8* data;
    i64 len;
    i64 idx;
}

impl Iterator for BytesIter {
    type Item = u8;
    Optional<u8> next(BytesIter* self) {
        if (self.idx < self.len) {
            u8 v = self.data[self.idx];
            self.idx = self.idx + 1;
            return Optional<u8>.some(v);
        }
        return Optional<u8>.none();
    }
}

struct BytesIntoIter {
    u8* data;
    i64 len;
    i64 idx;
}

impl Iterator for BytesIntoIter {
    type Item = u8;
    Optional<u8> next(BytesIntoIter* self) {
        if (self.idx < self.len) {
            u8 v = self.data[self.idx];
            self.idx = self.idx + 1;
            return Optional<u8>.some(v);
        }
        return Optional<u8>.none();
    }
}

impl Drop for BytesIntoIter {
    void drop(BytesIntoIter* self) {
        if (self.data != (u8*)0) {
            free(self.data);
            self.data = (u8*)0;
        }
        self.len = 0;
        self.idx = 0;
    }
}

impl IntoIterator for Bytes {
    type Item = u8;
    type IntoIter = BytesIntoIter;
    BytesIntoIter into_iter(Bytes self) {
        BytesIntoIter it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        self.data = (u8*)0;
        self.len = 0;
        self.cap = 0;
        return it;
    }
}

impl Bytes {
    BytesIter iter(&Bytes self) {
        BytesIter it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        return it;
    }

    Slice<u8> as_slice(&Bytes self) {
        Slice<u8> s;
        s.data = self.data;
        s.len = self.len;
        return s;
    }
}