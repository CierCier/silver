// std/sys/entry.ag — Silver _start entry point for static (no-libc) binaries.
import std.io.file;
import std.rt.builtins;
import std.rt.thread_registry;
import std.sys.os;
//
// Importing this module inlines a `_start` symbol that:
//   1. Sets up argc/argv/envp for the platform.
//   2. Runs platform init (CPU feature probe on x86; nothing on wasm).
//   3. Calls the user program's `main`.
//   4. Waits for spawned threads, flushes buffered I/O, reports leaks.
//   5. Exits the process with main's return value (or 1 on a leak).
//
// Platform entry points:
//   - Linux x86_64: a raw ET_EXEC `_start` blob reads argc/argv/envp off the
//     process stack and exits via exit_group (syscall 231).
//   - Windows: `_start` is the /ENTRY point; argc/argv come from
//     GetCommandLineW/CommandLineToArgvW and exit is ExitProcess.
//   - WebAssembly (wasi): a portable `_start` built from WASI preview1
//     imports — args_sizes_get/args_get, proc_exit. No registers, no rbp, no
//     cpuid, no clone. `main` is reached through the `@call_main()` builtin,
//     which calls the declared `main` symbol at whatever return type it has
//     (the x86 blobs are signature-agnostic only because they are asm).
//
// Usage:
//   import std.sys.entry;       // in any Silver program (linking is always static; no libc)
//   i32 main() { return 0; }
//
// The module's _start is inlined into the consumer's object file by the import
// hook, so no separate linking step is needed.

i32 silver_argc() {
    return __silver_argc;
}

i8** silver_argv() {
    return __silver_argv;
}

i8** silver_envp() {
    return __silver_envp;
}

if (@cfg(os.wasi)) {
    // WebAssembly / WASI preview1 entry.
    //
    // The argv/envp globals are real Silver globals here (the x86 entries
    // define them out of a `.bss` section directive inside an asm blob, which
    // wasm cannot express).
    i32 __silver_argc;
    i8** __silver_argv;
    i8** __silver_envp;

    extern "C" {
        #[link_module("wasi_snapshot_preview1")]
        #[link_name("args_sizes_get")]
        i32 wasi_args_sizes_get(u32* argc, u32* buf_size);
        #[link_module("wasi_snapshot_preview1")]
        #[link_name("args_get")]
        i32 wasi_args_get(i8** argv, u8* argv_buf);
        #[link_module("wasi_snapshot_preview1")]
        #[link_name("environ_sizes_get")]
        i32 wasi_environ_sizes_get(u32* count, u32* buf_size);
        #[link_module("wasi_snapshot_preview1")]
        #[link_name("environ_get")]
        i32 wasi_environ_get(i8** environ, u8* environ_buf);
        #[link_module("wasi_snapshot_preview1")]
        #[link_name("proc_exit")]
        void wasi_proc_exit(i32 code);
    }

    void _start() {
        __silver_wasi_arg_setup();
        __silver_wasi_env_setup();
        i32 rc = @call_main();
        __silver_thread_registry_join_all();
        __silver_flush_all();
        i32 leak = __silver_leak_check_report();
        if (leak != 0) {
            rc = 1;
        }
        wasi_proc_exit(rc);
    }

    /// Fill __silver_argc/__silver_argv from WASI args_sizes_get/args_get.
    /// The pointer array and string bytes come from one page allocation that
    /// lives for the process lifetime. On wasm32 an `i8*` is 4 bytes.
    void __silver_wasi_arg_setup() {
        u32 argc = 0;
        u32 buf_size = 0;
        if (wasi_args_sizes_get(&argc, &buf_size) != 0) {
            __silver_argc = 0;
            __silver_argv = (i8**)0;
            return;
        }
        i64 ptr_bytes = ((i64)argc + 1) * 4;
        u8* block = mem_sys_alloc(ptr_bytes + (i64)buf_size + 1);
        if (block == (u8*)0) {
            __silver_argc = 0;
            __silver_argv = (i8**)0;
            return;
        }
        i8** argv = (i8**)block;
        u8* argbuf = block + ptr_bytes;
        if (wasi_args_get(argv, argbuf) != 0) {
            __silver_argc = 0;
            __silver_argv = (i8**)0;
            return;
        }
        argv[argc] = (i8*)0;
        __silver_argc = (i32)argc;
        __silver_argv = argv;
    }

    /// Fill __silver_envp from WASI environ_sizes_get/environ_get. WASI passes
    /// environment variables as a NUL-separated "KEY=VALUE" block, which is
    /// exactly what std.env expects.
    void __silver_wasi_env_setup() {
        u32 count = 0;
        u32 buf_size = 0;
        if (wasi_environ_sizes_get(&count, &buf_size) != 0) {
            __silver_envp = (i8**)0;
            return;
        }
        i64 ptr_bytes = ((i64)count + 1) * 4;
        u8* block = mem_sys_alloc(ptr_bytes + (i64)buf_size + 1);
        if (block == (u8*)0) {
            __silver_envp = (i8**)0;
            return;
        }
        i8** envp = (i8**)block;
        u8* envbuf = block + ptr_bytes;
        if (wasi_environ_get(envp, envbuf) != 0) {
            __silver_envp = (i8**)0;
            return;
        }
        envp[count] = (i8*)0;
        __silver_envp = envp;
    }
} else {
    import std.cpu;
    import std.thread;

    extern "C" {
        i32 __silver_argc;
        i8** __silver_argv;
        i8** __silver_envp;
    }

if (@cfg(os.linux)) {
    // Linux entry: raw ET_EXEC _start. argc/argv come off the process stack and
    // exit goes through exit_group — the classic no-libc crt0 contract.
    void _start() {
        asm("
        .section .bss
        __silver_argc: .zero 4
        __silver_argv: .zero 8
        __silver_envp: .zero 8
        .text
        xor %ebp, %ebp
        mov (%rsp), %rdi
        lea 8(%rsp), %rsi
        mov %rdi, __silver_argc(%rip)
        mov %rsi, __silver_argv(%rip)
        lea 16(%rsp,%rdi,8), %rdx
        mov %rdx, __silver_envp(%rip)
        and $$-16, %rsp
        call __silver_cpu_init
        call main
        mov %rax, %r12
        call __silver_thread_registry_join_all
        call __silver_flush_all
        call __silver_leak_check_report
        cmp $$0, %eax
        je 1f
        mov $$1, %r12
        1:
        mov %r12, %rdi
        mov $$231, %eax
        syscall
    ");
    }
} else {
    // Windows entry: linked via /ENTRY:_start (the CRT's mainCRTStartup never
    // runs). Same protocol as the Linux blob, with Win32 plumbing:
    //   - __silver_win_arg_setup fills __silver_argc/__silver_argv from
    //     GetCommandLineW/CommandLineToArgvW (UTF-16 -> UTF-8).
    //   - sys_platform_init switches the console to UTF-8 before any output.
    //   - exit is ExitProcess (never returns, so %r12 needs no preserving).
    extern "C" {
        // Win32 argv plumbing (windows entry only).
        #[link_name("GetCommandLineW")]
        u16* win_GetCommandLineW();
        #[link_name("CommandLineToArgvW")]
        u16** win_CommandLineToArgvW(u16* cmd, i32* count);
        #[link_name("LocalFree")]
        u8* win_LocalFree(u8* mem);
    }

    void _start() {
        sys_platform_init();
        __silver_win_arg_setup();
        __silver_cpu_init();
        // Signature-agnostic call: the user program may define i32/i64/void main.
        // The 32-byte reservation is the Win64 shadow space; RSP is 16-aligned
        // inside the function body, and 32 preserves that alignment for the call.
        i32 rc = __silver_call_main();
        __silver_thread_registry_join_all();
        __silver_flush_all();
        i32 leak = __silver_leak_check_report();
        if (leak != 0) {
            rc = 1;
        }
        sys_exit_group((i64)rc);
    }

    /// Windows argv plumbing: CommandLineToArgvW, then UTF-16 -> UTF-8 for every
    /// argument. Buffers come from the page allocator and live for the process
    /// lifetime. Called once from _start before __silver_cpu_init.
    /// Calls the user program's `main` without naming its type: the Linux entry
    /// blob reads the return from %rax the same way, so any main signature
    /// (i32/i64/void) links and runs.
    i32 __silver_call_main() {
        return asm("
        sub $$32, %rsp
        call main
        add $$32, %rsp
    ", [], ["rax", "rcx", "rdx", "r8", "r9", "r10", "r11", "xmm0", "xmm1", "xmm2", "xmm3", "xmm4", "xmm5"]);
    }

    void __silver_win_arg_setup() {
        // Define the argv globals in .bss (the Windows counterpart of the Linux
        // entry blob's section directives). Runs once, before anything reads them.
        asm("
        .section .bss
        __silver_argc: .zero 4
        __silver_argv: .zero 8
        __silver_envp: .zero 8
        .text
    ");
        u16* cmd = win_GetCommandLineW();
        i32 argcw = 0;
        u16** argvw = win_CommandLineToArgvW(cmd, &argcw);
        if (argvw == (u16**)0 || argcw <= 0) {
            // Degenerate command line: still give main() an empty argv.
            __silver_argc = 0;
            __silver_argv = (i8**)0;
            return;
        }
        // One allocation: (argcw + 1) pointers, then UTF-8 payloads.
        i64 ptr_bytes = ((i64)argcw + 1) * 8;
        i64 payload = 0;
        i64 i = 0;
        while (i < argcw) {
            i64 j = 0;
            while (argvw[i][j] != 0) { j += 1; }
            // Worst case 3 UTF-8 bytes per UTF-16 unit + terminator.
            payload += j * 3 + 4;
            i += 1;
        }
        u8* block = mem_sys_alloc(ptr_bytes + payload);
        if (block == (u8*)0) {
            __silver_argc = 0;
            __silver_argv = (i8**)0;
            win_LocalFree((u8*)argvw);
            return;
        }
        i8** argv = (i8**)block;
        i64 cap = payload;
        i64 off = ptr_bytes;
        i = 0;
        while (i < argcw) {
            argv[i] = (i8*)(block + off);
            i64 used = win_utf16_to_utf8(argvw[i], block + off, cap);
            off += used + 1;
            cap -= used + 1;
            i += 1;
        }
        argv[argcw] = (i8*)0;
        __silver_argc = argcw;
        __silver_argv = argv;
        win_LocalFree((u8*)argvw);
    }
}
}
