// std/sys/entry.ag — Silver _start entry point for static (no-libc) binaries.
import std.cpu;
import std.io.file;
import std.rt.builtins;
import std.rt.thread_registry;
import std.thread;
//
// Importing this module inlines a `_start` symbol that:
//   1. Zeroes %rbp (ABI: marks outermost stack frame).
//   2. Loads argc from (%rsp) into %rdi (first arg to main).
//   3. Computes argv = rsp+8 into %rsi (second arg, for future use).
//   4. Re-aligns the stack to 16 bytes (and $-16, %rsp).
//   5. Calls __silver_cpu_init() so @cfg(cpu.*) probe globals are set.
//   6. Calls main().
//   7. Saves return value in %r12, calls __silver_thread_registry_join_all()
//      so every spawned thread finishes before exit, then calls
//      __silver_flush_all() to flush any buffered I/O (BufWriter STDOUT/STDERR).
//   8. Restores the return value into %rdi and invokes exit_group via syscall 231.
//
// Usage:
//   import std.sys.entry;       // in any Silver program (linking is always static; no libc)
//   i32 main() { return 0; }
//
// The module's _start is inlined into the consumer's object file by the import
// hook, so no separate linking step is needed.
extern "C" {
    i32 main();
    i32 __silver_argc;
    i8** __silver_argv;
}

i32 silver_argc() {
    return __silver_argc;
}

i8** silver_argv() {
    return __silver_argv;
}

void _start() {
    asm("
        .section .bss
        __silver_argc: .zero 4
        __silver_argv: .zero 8
        .text
        xor %ebp, %ebp
        mov (%rsp), %rdi
        lea 8(%rsp), %rsi
        mov %rdi, __silver_argc(%rip)
        mov %rsi, __silver_argv(%rip)
        and $$-16, %rsp
        call __silver_cpu_init
        call main
        mov %rax, %r12
        call __silver_thread_registry_join_all
        call __silver_flush_all
        call __silver_leak_check_report
        cmp $$0, %eax
        je 1f
        mov $$1, %r12
        1:
        mov %r12, %rdi
        mov $$231, %eax
        syscall
    ");
}
