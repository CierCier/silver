// std/sys/io_vec.ag — Vectorized scatter/gather I/O and sendfile.
//
// Essential primitives for high-performance servers:
// - writev: send response headers + body chunks in a single call.
// - readv: scatter incoming frames across pre-allocated buffers.
// - sendfile: transfer file data to a socket; zero-copy on Linux.
//
// On Windows the OS seam emulates these: one WSASend/WSARecv for sockets,
// one WriteFile/ReadFile through a bounce buffer for other descriptors, and
// sendfile as a copy loop through a 16 KiB userspace buffer.

import std.error;
import std.sys.os;
import std.sys.raw.fs;
import std.sys.result;

if (!@cfg(os.wasi)) {
/// Linux struct iovec (void* iov_base, size_t iov_len) — 16 bytes on x86_64.
/// The Windows seam translates it (WSABUF for sockets, a bounce buffer
/// otherwise).
struct IoVec {
    void* base;
    i64   len;
}

impl IoVec {
    /// Describes `len` bytes at `base` for vectored I/O. Does not copy or own the
    /// buffer; it must stay valid for the duration of the syscall that uses it.
    IoVec new(void* base, i64 len) {
        IoVec iov;
        iov.base = base;
        iov.len = len;
        return iov;
    }
}

/// Write data from multiple buffers in one call (writev(2)). On Windows,
/// non-socket descriptors are written from one gathered copy of the buffers.
Result<i64, Error> try_writev(i32 fd, IoVec* iov, i64 count) {
    return Result<i64, Error>.from_raw(sys_writev((i64)fd, (i64)iov, count));
}

/// Read data into multiple buffers in one call (readv(2)). On Windows,
/// non-socket descriptors are read into one buffer, then scattered.
Result<i64, Error> try_readv(i32 fd, IoVec* iov, i64 count) {
    return Result<i64, Error>.from_raw(sys_readv((i64)fd, (i64)iov, count));
}

/// Transfer from file descriptor `in_fd` to `out_fd` (sendfile(2)): zero-copy
/// on Linux, a 16 KiB userspace copy loop on Windows. If `offset` is non-null,
/// reading starts at `*offset` and updates it upon completion; on Windows,
/// another thread must not use `in_fd` during such a call.
Result<i64, Error> try_sendfile(i32 out_fd, i32 in_fd, i64* offset, i64 count) {
    return Result<i64, Error>.from_raw(sys_sendfile((i64)out_fd, (i64)in_fd, (i64)offset, count));
}
}
