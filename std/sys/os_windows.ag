    #[link_name("LocalFree")]
    u8* win_LocalFree(u8* mem);
}

// bcrypt is linked by the driver's windows default lib set (like kernel32):
// an item-level #[link(bcrypt)] here would leak -lbcrypt into posix links.
extern "C" {
    /// Win32 `BCryptGenRandom`.
    #[link_name("BCryptGenRandom")]
    i32 win_BCryptGenRandom(i64 alg, u8* buf, u64 len, u32 flags);
}

// Win32 constants used below.
/// VirtualAlloc flag: commit pages.
const u32 WIN_MEM_COMMIT = 0x1000;
/// VirtualAlloc flag: reserve address space.
const u32 WIN_MEM_RESERVE = 0x2000;
/// VirtualFree flag: release the whole reservation.
const u32 WIN_MEM_RELEASE = 0x8000;
/// Page protection: read and write.
const u32 WIN_PAGE_READWRITE = 4;
/// File access right: read.
const u32 WIN_GENERIC_READ = 0x80000000;
/// File access right: write.
const u32 WIN_GENERIC_WRITE = 0x40000000;
/// File share mode: allow other readers, writers, and deleters, so an open
/// file can be unlinked or renamed as on Linux.
const u32 WIN_FILE_SHARE_ALL = 7;
/// CreateFileW disposition: create, failing if the file exists.
const u32 WIN_CREATE_NEW = 1;
/// CreateFileW disposition: create or truncate.
const u32 WIN_CREATE_ALWAYS = 2;
/// CreateFileW disposition: open, failing if missing.
const u32 WIN_OPEN_EXISTING = 3;
/// CreateFileW disposition: open and truncate, failing if missing.
const u32 WIN_TRUNCATE_EXISTING = 5;
/// CreateFileW disposition: open or create.
const u32 WIN_OPEN_ALWAYS = 4;
/// File attribute: normal file.
const u32 WIN_FILE_ATTRIBUTE_NORMAL = 0x80;
/// File attribute: read-only.
const i64 WIN_FILE_ATTRIBUTE_READONLY = 0x1;
/// File attribute: directory.
const i64 WIN_FILE_ATTRIBUTE_DIRECTORY = 0x10;
/// CreateFileW flag: required to open a directory handle.
const u32 WIN_FILE_FLAG_BACKUP_SEMANTICS = 0x02000000;
/// CreateFileW flag: open a symlink itself rather than its target.
const u32 WIN_FILE_FLAG_OPEN_REPARSE_POINT = 0x00200000;
/// Access right: delete the object.
const u32 WIN_DELETE = 0x00010000;
/// File information class `FileBasicInfo` (times and attributes).
const i32 WIN_FILE_BASIC_INFO = 0;
/// File information class `FileDispositionInfoEx`.
const i32 WIN_FILE_DISPOSITION_INFO_EX = 21;
/// FileDispositionInfoEx flag: delete the file.
const u32 WIN_FILE_DISPOSITION_DELETE = 0x1;
/// FileDispositionInfoEx flag: unlink the name immediately (POSIX).
const u32 WIN_FILE_DISPOSITION_POSIX_SEMANTICS = 0x2;
/// FileDispositionInfoEx flag: delete even when marked read-only.
const u32 WIN_FILE_DISPOSITION_IGNORE_READONLY_ATTRIBUTE = 0x10;
/// Linux `st_mode` file-type bits for a regular file.
const i64 WIN_S_IFREG = 0x8000;
/// Linux `st_mode` file-type bits for a directory.
const i64 WIN_S_IFDIR = 0x4000;
/// FILETIME value of the Unix epoch (100 ns ticks from 1601 to 1970).
const i64 WIN_FILETIME_UNIX_EPOCH = 116444736000000000;
/// SetFilePointer origin: start of file.
const u32 WIN_FILE_BEGIN = 0;
/// SetFilePointer origin: current position.
const u32 WIN_FILE_CURRENT = 1;
/// SetFilePointer origin: end of file.
const u32 WIN_FILE_END = 2;
/// MoveFileExW flag: replace an existing target.
const u32 WIN_MOVE_REPLACE = 1;
/// MoveFileExW flag: allow a copy-and-delete across volumes.
const u32 WIN_MOVE_COPY_ALLOWED = 2;
/// Timeout value meaning wait forever.
const u32 WIN_INFINITE = 0xFFFFFFFF;
/// GetStdHandle id for standard input.
const i32 WIN_STD_INPUT = -10;
/// GetStdHandle id for standard output.
const i32 WIN_STD_OUTPUT = -11;
/// GetStdHandle id for standard error.
const i32 WIN_STD_ERROR = -12;
/// Console code page for UTF-8.
const u32 WIN_CP_UTF8 = 65001;

// Linux O_* flag bits come from std/sys/result.ag (Linux numeric values);
// the windows sys_open translates them into Win32 create dispositions.

// ---------------------------------------------------------------------------
// UTF-8 <-> UTF-16 (Win32 *W APIs take UTF-16; std strings are UTF-8).
// ---------------------------------------------------------------------------

/// UTF-8 string length in UTF-16 code units (excluding the terminator).
/// Non-BMP code points (4-byte UTF-8) encode as surrogate pairs: 2 units.
i64 win_utf16_len(u8* s) {
    i64 n = 0;
    i64 i = 0;
    while (s[i] != 0) {
        u32 cp = (u32)s[i];
        i64 advance = 1;
        if ((cp & 0xE0) == 0xC0) { advance = 2; }
        else if ((cp & 0xF0) == 0xE0) { advance = 3; }
        else if ((cp & 0xF8) == 0xF0) { advance = 4; n += 1; }
        i += advance;
        n += 1;
    }
    return n;
}

/// Convert NUL-terminated UTF-8 into `dst` (UTF-16, NUL-terminated).
/// Returns the number of UTF-16 code units written.
i64 win_utf8_to_utf16(u8* s, u16* dst) {
    i64 out = 0;
    i64 i = 0;
    while (s[i] != 0) {
        u32 cp = (u32)s[i];
        i64 advance = 1;
        if ((cp & 0xE0) == 0xC0) {
            advance = 2;
            cp = cp & 0x1F;
        } else if ((cp & 0xF0) == 0xE0) {
            advance = 3;
            cp = cp & 0x0F;
        } else if ((cp & 0xF8) == 0xF0) {
            advance = 4;
            cp = cp & 0x07;
        } else {
            cp = cp & 0x7F;
        }
        i += 1;
        // Gather continuation bytes.
        i64 k = 1;
        while (k < advance) {
            cp = (cp << 6) | ((u32)s[i] & 0x3F);
            i += 1;
            k += 1;
        }
        if (cp >= 0x10000) {
            // Surrogate pair.
            u32 v = cp - 0x10000;
            dst[out] = (u16)(0xD800 + (v >> 10));
            dst[out + 1] = (u16)(0xDC00 + (v & 0x3FF));
            out += 2;
        } else {
            dst[out] = (u16)cp;
            out += 1;
        }
    }
    dst[out] = 0;
    return out;
}

/// Convert a NUL-terminated UTF-16 string to NUL-terminated UTF-8 into dst
/// (capacity bytes). Returns bytes written.
i64 win_utf16_to_utf8(u16* src, u8* dst, i64 dst_cap) {
    i64 out = 0;
    i64 i = 0;
    while (src[i] != 0 && out < dst_cap - 4) {
        u32 cp = (u32)src[i];
        i += 1;
        if (cp >= 0xD800 && cp < 0xDC00 && (u32)src[i] >= 0xDC00 && (u32)src[i] < 0xE000) {
            u32 lo = (u32)src[i];
            i += 1;
            cp = 0x10000 + ((cp - 0xD800) << 10) + (lo - 0xDC00);
        } else if (cp >= 0xD800 && cp < 0xE000) {
            // Unpaired surrogate (Windows strings are not always valid
            // UTF-16): U+FFFD, leaving the next unit (maybe a NUL) unread.
            cp = 0xFFFD;
        }
        if (cp < 0x80) {
            dst[out] = (u8)cp;
            out += 1;
        } else if (cp < 0x800) {
            dst[out] = (u8)(0xC0 | (cp >> 6));
            dst[out + 1] = (u8)(0x80 | (cp & 0x3F));
            out += 2;
        } else if (cp < 0x10000) {
            dst[out] = (u8)(0xE0 | (cp >> 12));
            dst[out + 1] = (u8)(0x80 | ((cp >> 6) & 0x3F));
            dst[out + 2] = (u8)(0x80 | (cp & 0x3F));
            out += 3;
        } else {
            dst[out] = (u8)(0xF0 | (cp >> 18));
            dst[out + 1] = (u8)(0x80 | ((cp >> 12) & 0x3F));
            dst[out + 2] = (u8)(0x80 | ((cp >> 6) & 0x3F));
            dst[out + 3] = (u8)(0x80 | (cp & 0x3F));
            out += 4;
        }
    }
    dst[out] = 0;
    return out;
}

/// True when UTF-8 names `a` (`alen` bytes) and `b` (`blen` bytes) are equal
/// under Windows' ordinal case-insensitive rules (the OS uppercase table,
/// as environment variable names compare). Names over 511 UTF-16 units
/// compare unequal.
bool win_names_equal_ci(u8* a, i64 alen, u8* b, i64 blen) {
    return win_names_compare_ci(a, alen, b, blen) == 0;
}

/// Orders UTF-8 names `a` and `b` like `win_names_equal_ci`: -1, 0, or 1.
/// Names over 511 UTF-16 units order after every other name (and unequal).
i32 win_names_compare_ci(u8* a, i64 alen, u8* b, i64 blen) {
    u16 wa[512];
    u16 wb[512];
    i64 na = win_utf8_prefix_to_utf16(a, alen, &wa[0], 512);
    i64 nb = win_utf8_prefix_to_utf16(b, blen, &wb[0], 512);
    if (na < 0 || nb < 0) {
        return nb < 0 ? -1 : 1;
    }
    // CSTR_LESS_THAN = 1, CSTR_EQUAL = 2, CSTR_GREATER_THAN = 3.
    return win_CompareStringOrdinal(&wa[0], (i32)na, &wb[0], (i32)nb, 1) - 2;
}

/// Internal: converts the first `len` bytes of UTF-8 `s` into `dst`
/// (`cap` units). Returns the unit count, or -1 when it does not fit.
i64 win_utf8_prefix_to_utf16(u8* s, i64 len, u16* dst, i64 cap) {
    u8 tmp[1024];
    if (len >= 1024) {
        return -1;
    }
    i64 i = 0;
    while (i < len) {
        tmp[i] = s[i];
        i += 1;
    }
    tmp[len] = (u8)0;
    if (win_utf16_len(&tmp[0]) >= cap) {
        return -1;
    }
    return win_utf8_to_utf16(&tmp[0], dst);
}

/// Anonymous RW pages, zero-initialized. prot/flags/fd/off follow the Linux
/// mmap convention (3 = R|W, 34 = PRIVATE|ANONYMOUS); the Windows
/// implementation reserves+commits RW pages, which are also zeroed.
i64 sys_mmap(i64 addr, i64 len, i64 prot, i64 flags, i64 fd, i64 off) {
    if (len == 0) {
        return -22; // EINVAL
    }
    if ((flags & 3) == 0) {
        // Neither MAP_PRIVATE (2) nor MAP_SHARED (1): the Linux kernel
        // rejects this with EINVAL; mirror it.
        return -22;
    }
    u8* p = win_VirtualAlloc((u8*)addr, (u64)len, WIN_MEM_RESERVE | WIN_MEM_COMMIT, WIN_PAGE_READWRITE);
    if (p == (u8*)0) {
        return -12; // ENOMEM
    }
    return (i64)p;
}

/// MEM_RELEASE frees the whole reservation and requires the exact base
/// address the allocator records in its block header, so `len` is unused.
i64 sys_munmap(i64 addr, i64 len) {
    if (addr == 0) {
        return -22;
    }
    if (win_VirtualFree((u8*)addr, 0, WIN_MEM_RELEASE) == 0) {
        return -22;
    }
    return 0;
}

// ---------------------------------------------------------------------------
// File I/O. See the fd semantics note in the header.
// ---------------------------------------------------------------------------

/// Linux errno (positive) for a Win32 or Winsock error code, so seam callers
/// see the same codes on every platform. Unlisted codes report EIO.
i64 win_errno(u32 err) {
    return match err {
        2: ENOENT,            // ERROR_FILE_NOT_FOUND
        3: ENOENT,            // ERROR_PATH_NOT_FOUND
        4: EMFILE,            // ERROR_TOO_MANY_OPEN_FILES
        5: EACCES,            // ERROR_ACCESS_DENIED
        6: EBADF,             // ERROR_INVALID_HANDLE
        8: ENOMEM,            // ERROR_NOT_ENOUGH_MEMORY
        14: ENOMEM,           // ERROR_OUTOFMEMORY
        15: ENOENT,           // ERROR_INVALID_DRIVE
        17: EXDEV,            // ERROR_NOT_SAME_DEVICE
        19: EROFS,            // ERROR_WRITE_PROTECT
        32: EBUSY,            // ERROR_SHARING_VIOLATION
        33: EBUSY,            // ERROR_LOCK_VIOLATION
        39: ENOSPC,           // ERROR_HANDLE_DISK_FULL
        80: EEXIST,           // ERROR_FILE_EXISTS
        87: EINVAL,           // ERROR_INVALID_PARAMETER
        109: EPIPE,           // ERROR_BROKEN_PIPE
        112: ENOSPC,          // ERROR_DISK_FULL
        122: ERANGE,          // ERROR_INSUFFICIENT_BUFFER
        123: ENOENT,          // ERROR_INVALID_NAME
        145: ENOTEMPTY,       // ERROR_DIR_NOT_EMPTY
        183: EEXIST,          // ERROR_ALREADY_EXISTS
        206: ENAMETOOLONG,    // ERROR_FILENAME_EXCED_RANGE
        232: EPIPE,           // ERROR_NO_DATA (pipe closing)
        267: ENOTDIR,         // ERROR_DIRECTORY
        10004: EINTR,         // WSAEINTR
        10009: EBADF,         // WSAEBADF
        10013: EACCES,        // WSAEACCES
        10014: EFAULT,        // WSAEFAULT
        10022: EINVAL,        // WSAEINVAL
        10024: EMFILE,        // WSAEMFILE
        10035: EAGAIN,        // WSAEWOULDBLOCK
        10036: EINPROGRESS,   // WSAEINPROGRESS
        10037: EALREADY,      // WSAEALREADY
        10038: 88,            // WSAENOTSOCK -> ENOTSOCK
        10039: 89,            // WSAEDESTADDRREQ -> EDESTADDRREQ
        10040: 90,            // WSAEMSGSIZE -> EMSGSIZE
        10041: 91,            // WSAEPROTOTYPE -> EPROTOTYPE
        10042: 92,            // WSAENOPROTOOPT -> ENOPROTOOPT
        10043: 93,            // WSAEPROTONOSUPPORT -> EPROTONOSUPPORT
        10044: 94,            // WSAESOCKTNOSUPPORT -> ESOCKTNOSUPPORT
        10045: 95,            // WSAEOPNOTSUPP -> EOPNOTSUPP
        10046: 96,            // WSAEPFNOSUPPORT -> EPFNOSUPPORT
        10047: 97,            // WSAEAFNOSUPPORT -> EAFNOSUPPORT
        10048: EADDRINUSE,    // WSAEADDRINUSE
        10049: EADDRNOTAVAIL, // WSAEADDRNOTAVAIL
        10050: 100,           // WSAENETDOWN -> ENETDOWN
        10051: ENETUNREACH,   // WSAENETUNREACH
        10052: 102,           // WSAENETRESET -> ENETRESET
        10053: 103,           // WSAECONNABORTED -> ECONNABORTED
        10054: ECONNRESET,    // WSAECONNRESET
        10055: 105,           // WSAENOBUFS -> ENOBUFS
        10056: 106,           // WSAEISCONN -> EISCONN
        10057: ENOTCONN,      // WSAENOTCONN
        10058: EPIPE,         // WSAESHUTDOWN: send after shutdown(WR)
        10060: ETIMEDOUT,     // WSAETIMEDOUT
        10061: ECONNREFUSED,  // WSAECONNREFUSED
        10063: ENAMETOOLONG,  // WSAENAMETOOLONG
        10064: 112,           // WSAEHOSTDOWN -> EHOSTDOWN
        10065: EHOSTUNREACH,  // WSAEHOSTUNREACH
        10091: 100,           // WSASYSNOTREADY -> ENETDOWN
        _: EIO
    };
}

/// Linux errno (positive) for the calling thread's last Win32 error.
i64 win_last_errno() {
    return win_errno(win_GetLastError());
}

/// Resolve fd 0/1/2 to the standard handles; pass everything through as a
/// (sign-extended) Win32 handle.
i64 win_fd_handle(i64 fd) {
    if (fd == 0) { return win_GetStdHandle(WIN_STD_INPUT); }
    if (fd == 1) { return win_GetStdHandle(WIN_STD_OUTPUT); }
    if (fd == 2) { return win_GetStdHandle(WIN_STD_ERROR); }
    return fd;
}

/// Seam: one WriteFile call (one send on a socket fd); fds 0-2 map to the
/// standard handles. Returns the count written or the mapped -errno.
i64 sys_write(i64 fd, i64 buf, i64 len) {
    if (win_fd_is_socket(fd)) {
        return win_sock_send(fd, buf, len, 0);
    }
    if (len == 0) {
        return 0;
    }
    u32 written = 0;
    i64 h = win_fd_handle(fd);
    if (win_WriteFile(h, (u8*)buf, (u32)len, &written, (u8*)0) == 0) {
        return -win_last_errno();
    }
    return (i64)written;
}

/// Seam: one ReadFile call (one recv on a socket fd). A closed pipe reports
/// 0 (EOF) rather than an error. Returns the count or -errno.
i64 sys_read(i64 fd, i64 buf, i64 len) {
    if (win_fd_is_socket(fd)) {
        return win_sock_recv(fd, buf, len, 0);
    }
    u32 nread = 0;
    i64 h = win_fd_handle(fd);
    if (win_ReadFile(h, (u8*)buf, (u32)len, &nread, (u8*)0) == 0) {
        // EOF on a pipe arrives as a ReadFile FAILURE (not a 0-byte
        // success): the write end closed -> ERROR_BROKEN_PIPE (109), a
        // synchronous handle drained -> ERROR_HANDLE_EOF (38). Both are
        // clean EOF; anything else maps through the errno approximation.
        i64 err = (i64)win_GetLastError();
        if (err == 109 || err == 38) {
            return 0;
        }
        return -win_last_errno();
    }
    return (i64)nread;
}

/// Translate the Linux O_* bit layout (std/sys/result.ag) into a Win32
/// create/open call. Always binary; the returned fd is the truncated handle.
i64 sys_open(i64 path, i64 flags, i64 mode) {
    u8* p8 = (u8*)path;
    i64 units = win_utf16_len(p8);
    // UTF-16 buffer on the stack: path lengths are small; over-allocate 4x.
    u16 wpath[1024];
    if (units >= 1000) {
        return -36; // ENAMETOOLONG
    }
    win_utf8_to_utf16(p8, &wpath[0]);

    u32 access = WIN_GENERIC_READ;
    if ((flags & O_RDWR) == O_RDWR) {
        access = WIN_GENERIC_READ | WIN_GENERIC_WRITE;
    } else if ((flags & O_WRONLY) == O_WRONLY) {
        access = WIN_GENERIC_WRITE;
    }

    u32 disp = WIN_OPEN_EXISTING;
    if ((flags & O_CREAT) == O_CREAT && (flags & O_TRUNC) == O_TRUNC) {
        disp = WIN_CREATE_ALWAYS;
    } else if ((flags & O_CREAT) == O_CREAT) {
        if ((flags & O_EXCL) == O_EXCL) {
            disp = WIN_CREATE_NEW;
        } else {
            disp = WIN_OPEN_ALWAYS;
        }
    } else if ((flags & O_TRUNC) == O_TRUNC) {
        disp = WIN_TRUNCATE_EXISTING;
    }

    i64 h = win_CreateFileW(&wpath[0], access, WIN_FILE_SHARE_ALL, (u8*)0, disp, WIN_FILE_ATTRIBUTE_NORMAL, 0);
    if (h == -1) {
        return -win_last_errno();
    }
    if ((flags & O_APPEND) == O_APPEND) {
        win_SetFilePointer(h, 0, (i32*)0, WIN_FILE_END);
    }
    return (i64)(i32)h;
}

/// Only AT_FDCWD semantics are consumed by std: relative paths resolve
/// against the process CWD, which is what the handle-less open does.
i64 sys_openat(i64 dirfd, i64 path, i64 flags, i64 mode) {
    // Only AT_FDCWD semantics exist here; a bad explicit dirfd is EBADF.
    if (dirfd != -100) { // AT_FDCWD
        return -9;
    }
    return sys_open(path, flags, mode);
}

/// Only F_GETFL/F_SETFL (O_NONBLOCK toggling) are consumed. F_GETFL reports
/// O_RDWR: winsock cannot query FIONBIO, and regular files have no
/// non-blocking mode. F_SETFL on a socket applies the O_NONBLOCK bit through
/// FIONBIO, so the get-modify-set idiom works; on files it is accepted.
i64 sys_fcntl(i64 fd, i64 cmd, i64 arg) {
    if (cmd == F_GETFL) {
        return O_RDWR;
    }
    if (cmd == F_SETFL && win_fd_is_socket(fd)) {
        return win_sock_set_nonblocking(fd, (arg & O_NONBLOCK) != 0);
    }
    return 0;
}

/// mremap via allocate-copy-free. The page allocator's reallocations stay
/// within one mapping in practice; this path is the general fallback.
i64 sys_mremap(i64 old_addr, i64 old_size, i64 new_size, i64 flags, i64 new_addr) {
    // Unaligned or zero addresses are EINVAL (the Linux kernel also rejects
    // them) — and dereferencing an unaligned address here would fault.
    if (old_addr == 0 || new_size == 0 || (old_addr & 4095) != 0) {
        return -22;
    }
    if (new_size <= old_size) {
        return old_addr;
    }
    i64 fresh = sys_mmap(0, new_size, 3, 34, -1, 0);
    if (fresh <= 0) {
        return fresh;
    }
    i64 n = old_size;
    if (new_size < n) {
        n = new_size;
    }
    u8* src = (u8*)old_addr;
    u8* dst = (u8*)fresh;
    i64 i = 0;
    while (i < n) {
        dst[i] = src[i];
        i += 1;
    }
    sys_munmap(old_addr, old_size);
    return fresh;
}

/// Process-wide exit fallback (never returns on either platform).
i64 sys_exit(i64 code) {
    win_ExitProcess((u32)code);
    return 0;
}

/// Seam: closes a file handle. fds 0-2 are never closed and report success;
/// a bad handle reports -EBADF.
i64 sys_close(i64 fd) {
    if (fd >= 0 && fd <= 2) {
        return 0; // standard handles are not ours to close
    }
    if (win_fd_is_socket(fd)) {
        if (win_closesocket(win_fd_socket(fd)) != 0) {
            return -win_wsa_errno();
        }
        return 0;
    }
    if (fd == -1 || fd == -2) {
        // Current-process/thread pseudo handles: CloseHandle on them
        // succeeds silently on some Windows builds, but they are never
        // ours to close — report EBADF like a bad descriptor.
        return -9;
    }
    if (win_CloseHandle(fd) == 0) {
        return -9; // EBADF
    }
    return 0;
}

/// 64-bit seek via the low/high split of SetFilePointer.
i64 sys_lseek(i64 fd, i64 off, i64 whence) {
    i64 h = win_fd_handle(fd);
    i32 high = (i32)(off >> 32);
    i32 low = (i32)off;
    i32 method = WIN_FILE_BEGIN;
    if (whence == 1) { method = WIN_FILE_CURRENT; }
    else if (whence == 2) { method = WIN_FILE_END; }
    i32 res = win_SetFilePointer(h, low, &high, method);
    if (res == -1 && win_GetLastError() != 0) {
        return -win_last_errno();
    }
    return ((i64)(u32)high << 32) | (i64)(u32)res;
}

/// Seam: unlink(2). Deletes with POSIX semantics where the file system
/// supports them (NTFS, Windows 10 1809+): the name disappears at once even
/// while the file is open, so it can be reused immediately, and a read-only
/// attribute does not block deletion. Elsewhere DeleteFileW leaves an open
/// file's name delete-pending until its last handle closes. Symlinks are
/// removed, not followed. Paths of 1000 or more UTF-16 units report
/// -ENAMETOOLONG.
i64 sys_unlink(i64 path) {
    u16 wpath[1024];
    if (win_utf16_len((u8*)path) >= 1000) {
        return -36;
    }
    win_utf8_to_utf16((u8*)path, &wpath[0]);
    i64 h = win_CreateFileW(&wpath[0], WIN_DELETE, WIN_FILE_SHARE_ALL, (u8*)0, WIN_OPEN_EXISTING,
        WIN_FILE_FLAG_OPEN_REPARSE_POINT, 0);
    if (h == -1) {
        return -win_last_errno();
    }
    u32 disposition = WIN_FILE_DISPOSITION_DELETE | WIN_FILE_DISPOSITION_POSIX_SEMANTICS
        | WIN_FILE_DISPOSITION_IGNORE_READONLY_ATTRIBUTE;
    i32 posix = win_SetFileInformationByHandle(h, WIN_FILE_DISPOSITION_INFO_EX, (u8*)&disposition, 4);
    win_CloseHandle(h);
    if (posix != 0) {
        return 0;
    }
    if (win_DeleteFileW(&wpath[0]) == 0) {
        return -win_last_errno();
    }
    return 0;
}

/// Seam: MoveFileExW, replacing the target and allowing cross-volume moves.
/// Failures report the mapped errno.
i64 sys_rename(i64 from, i64 to) {
    u16 wfrom[1024];
    u16 wto[1024];
    if (win_utf16_len((u8*)from) >= 1000 || win_utf16_len((u8*)to) >= 1000) {
        return -36;
    }
    win_utf8_to_utf16((u8*)from, &wfrom[0]);
    win_utf8_to_utf16((u8*)to, &wto[0]);
    if (win_MoveFileExW(&wfrom[0], &wto[0], WIN_MOVE_REPLACE | WIN_MOVE_COPY_ALLOWED) == 0) {
        return -win_last_errno();
    }
    return 0;
}

/// Fills the Linux x86_64 `struct stat` layout in the caller's 144-byte
/// buffer: st_dev 0, st_ino 8, st_nlink 16, st_mode 24, st_size 48,
/// st_blksize 56, st_blocks 64, st_atim 72/80, st_mtim 88/96, st_ctim
/// 104/112. st_ctim is the NTFS change time (metadata or data), falling back
/// to the last write time where the file system has none. Directories open
/// only with FILE_FLAG_BACKUP_SEMANTICS; no access rights are requested, so
/// files locked for reading still stat.
i64 sys_stat(i64 path, i64 buf) {
    u16 wpath[1024];
    if (win_utf16_len((u8*)path) >= 1000) {
        return -36;
    }
    win_utf8_to_utf16((u8*)path, &wpath[0]);
    i64 h = win_CreateFileW(&wpath[0], 0, WIN_FILE_SHARE_ALL, (u8*)0, WIN_OPEN_EXISTING, WIN_FILE_FLAG_BACKUP_SEMANTICS, 0);
    if (h == -1) {
        return -win_last_errno();
    }
    // BY_HANDLE_FILE_INFORMATION is 52 bytes; the slack keeps 8-byte reads
    // of the trailing u32 fields inside the buffer.
    u8 info[56];
    i64 i = 0;
    while (i < 56) {
        info[i] = 0;
        i += 1;
    }
    i32 ok = win_GetFileInformationByHandle(h, &info[0]);
    i64 err = win_last_errno();
    // FILE_BASIC_INFO (40 bytes): ChangeTime at 24.
    u64 basic[5];
    i64 change = 0;
    if (ok != 0 && win_GetFileInformationByHandleEx(h, WIN_FILE_BASIC_INFO, (u8*)&basic[0], 40) != 0) {
        change = (i64)basic[3];
    }
    win_CloseHandle(h);
    if (ok == 0) {
        return -err;
    }
    if (change == 0) {
        change = win_le_i64(&info[0], 20);
    }
    i64 attr = win_le_u32(&info[0], 0);
    i64 size = (win_le_u32(&info[0], 32) << 32) | win_le_u32(&info[0], 36);
    i64 mode = WIN_S_IFREG | 420; // 0644
    if ((attr & WIN_FILE_ATTRIBUTE_DIRECTORY) != 0) {
        mode = WIN_S_IFDIR | 493; // 0755
    }
    if ((attr & WIN_FILE_ATTRIBUTE_READONLY) != 0) {
        mode = mode & ~146; // clear the 0222 write bits
    }
    u8* out = (u8*)buf;
    win_store_le_i64(out, 0, win_le_u32(&info[0], 28));
    win_store_le_i64(out, 8, (win_le_u32(&info[0], 44) << 32) | win_le_u32(&info[0], 48));
    win_store_le_i64(out, 16, win_le_u32(&info[0], 40));
    win_store_le_i64(out, 24, mode);
    win_store_le_i64(out, 48, size);
    win_store_le_i64(out, 56, 4096);
    win_store_le_i64(out, 64, (size + 511) / 512);
    win_store_filetime(out, 72, win_le_i64(&info[0], 12));
    win_store_filetime(out, 88, win_le_i64(&info[0], 20));
    win_store_filetime(out, 104, change);
    return 0;
}

/// Internal: stores FILETIME `ft` (100 ns ticks since 1601) as a Unix
/// timespec {sec, nsec} at `buf[off]`. Pre-1970 times keep nsec in
/// [0, 1e9), as Linux does: one tick before the epoch is {-1, 999999900}.
void win_store_filetime(u8* buf, i64 off, i64 ft) {
    i64 unix100 = ft - WIN_FILETIME_UNIX_EPOCH;
    i64 sec = unix100 / 10000000;
    i64 rem = unix100 % 10000000;
    if (rem < 0) {
        sec -= 1;
        rem += 10000000;
    }
    win_store_le_i64(buf, off, sec);
    win_store_le_i64(buf, off + 8, rem * 100);
}

/// Internal: reads a little-endian u32 at `buf[off]`, zero-extended.
i64 win_le_u32(u8* buf, i64 off) {
    return (i64)buf[off] | ((i64)buf[off + 1] << 8) | ((i64)buf[off + 2] << 16) | ((i64)buf[off + 3] << 24);
}

/// Internal: reads a little-endian i64 at `buf[off]`.
i64 win_le_i64(u8* buf, i64 off) {
    return (i64)win_le_u64(buf, off);
}

/// Internal: reads a little-endian u64 at `buf[off]`.
u64 win_le_u64(u8* buf, i64 off) {
    u64 v = 0;
    i64 i = 7;
    while (i >= 0) {
        v = (v << 8) | (u64)buf[off + i];
        i -= 1;
    }
    return v;
}

/// Internal: writes `v` little-endian at `buf[off]`.
void win_store_le_i64(u8* buf, i64 off, i64 v) {
    i64 i = 0;
    while (i < 8) {
        buf[off + i] = (u8)((u64)v & 0xFF);
        v = (i64)((u64)v >> 8);
        i += 1;
    }
}

/// Seam: ExitProcess with `code`. Never returns.
i64 sys_exit_group(i64 code) {
    win_ExitProcess((u32)code);
    return 0;
}

/// Seam: returns the process id.
i64 sys_getpid() {
    return (i64)win_GetCurrentProcessId();
}

/// Seam: signal 0 probes whether `pid` exists; signal 6 (SIGABRT) exits the
/// current process with 134; any other signal terminates the current
/// process with code 1, whatever `pid` is.
i64 sys_kill(i64 pid, i64 sig) {
    if (sig == 0) {
        // Existence probe (signal 0): a process is alive when it can be
        // opened for query, or when access is denied to a protected one;
        // only a missing process reports ESRCH.
        if (pid == win_GetCurrentProcessId()) {
            return 0;
        }
        i64 h = win_OpenProcess(0x1000, 0, (u32)pid); // PROCESS_QUERY_LIMITED_INFORMATION
        if (h != 0) {
            win_CloseHandle(h);
            return 0;
        }
        if (win_GetLastError() == 5) { // ERROR_ACCESS_DENIED: alive but protected
            return 0;
        }
        return -3; // ESRCH
    }
    if (sig == 6) {
        win_ExitProcess(134);
        return 0;
    }
    win_TerminateProcess(win_GetCurrentProcess(), 1);
    return 0;
}

/// Yield the current thread's timeslice.
void thread_yield() {
    win_SwitchToThread();
}

/// Seam: ExitThread; ends only the calling thread.
void thread_exit(i64 code) {
    win_ExitThread((u32)code);
}

/// Returns the thread handle (>0) or 0 on failure. `stack_top` is the
/// Linux-only dedicated stack; Windows threads get an OS-managed stack.
i64 thread_spawn_raw(i64 flags, u8* stack_top, i64 fn, i64 arg, i32* ctid) {
    i64 h = win_CreateThread((u8*)0, 2097152, (u64(u64))fn, (u8*)arg, 0, (u32*)0);
    if (h == 0) {
        return 0;
    }
    return h;
}

/// FUTEX_WAIT (op 0) sleeps while *uaddr == val; FUTEX_WAKE (op 1) wakes up
/// to `val` waiters. WaitOnAddress re-checks the compare value atomically in
/// the kernel, giving the same lost-wake guarantees. Timeout is a timespec*
/// ({i64 sec, i64 nsec}) or null.
i64 sys_futex(i64 uaddr, i64 op, i64 val, i64 timeout, i64 uaddr2, i64 val3) {
    u32* addr = (u32*)uaddr;
    if (op == 1) {
        // FUTEX_WAKE: wake all waiters when asked for more than one; the
        // futex protocol re-checks state after waking, so over-waking is
        // semantically safe.
        if (val == 1) {
            win_WakeByAddressSingle(addr);
        } else {
            win_WakeByAddressAll(addr);
        }
        return val;
    }
    if (op != 0) {
        return -22; // EINVAL: only WAIT/WAKE are used by std
    }
    // FUTEX_WAIT: kernel-side compare against `val`.
    u32 expected = (u32)val;
    u32 ms = WIN_INFINITE;
    if (timeout != 0) {
        i64 sec = raw_le_i64_at((i64*)timeout, 0);
        i64 nsec = raw_le_i64_at((i64*)timeout, 1);
        if (sec < 0) {
            return -22;
        }
        ms = (u32)(sec * 1000 + nsec / 1000000);
        if (ms == 0 && (sec > 0 || nsec > 0)) {
            ms = 1;
        }
    }
    i64 r = win_WaitOnAddress(addr, &expected, 4, ms);
    if (r == 0) {
        // Timed out (the only failure mode for a valid address).
        return -110; // ETIMEDOUT
    }
    return 0;
}

/// Internal: returns `p[idx]`.
i64 raw_le_i64_at(i64* p, i64 idx) {
    return p[idx];
}

/// Seam: closes the thread handle returned by `thread_spawn_raw`.
void thread_reclaim(i64 tid) {
    if (tid > 0) {
        win_CloseHandle(tid);
    }
}

/// MSVC compatibility markers for the freestanding (no-CRT) Windows link:
/// the backend references `_fltused` whenever float operations exist, and
/// emits `__chkstk` calls before frames larger than one page. The probe
/// walks down from the current stack pointer one 4KB page at a time so the
/// guard page is hit in order; RAX carries the frame size on entry (it is
/// preserved, which is the contract the compiler-generated call relies on).
i32 _fltused = 1;

/// MSVC stack probe: touches each 4 KiB page of a large frame in order so
/// the guard page grows the stack. Called by compiler-generated code only.
void __chkstk() {
    asm("
        push %rcx
        push %rax
        cmp $$0x1000, %rax
        jb 1f
        mov %rsp, %rcx
        2:
        sub $$0x1000, %rcx
        sub $$0x1000, %rax
        testl $$0, (%rcx)
        cmp $$0x1000, %rax
        ja 2b
        1:
        pop %rax
        pop %rcx
    ", []);
}

/// Windows: Sleep(ms) with round-up — sub-millisecond precision is not
/// required by std callers. `rem` is left untouched (callers pass 0).
i64 sys_nanosleep(i64 req, i64 rem) {
    i64* ts = (i64*)req;
    i64 ms = ts[0] * 1000 + (ts[1] + 999999) / 1000000;
    if (ms < 1) {
        ms = 1;
    }
    win_Sleep((u32)ms);
    return 0;
}

/// Fills {i64 sec, i64 nsec} at ts. clk 1 = CLOCK_MONOTONIC (QPC), anything
/// else = CLOCK_REALTIME (GetSystemTimePreciseAsFileTime).
i64 sys_clock_gettime(i64 clk, i64 ts) {    u8* p = (u8*)ts;
    if (clk == 1) {
        i64 count = 0;
        i64 freq = 0;
        win_QueryPerformanceCounter(&count);
        win_QueryPerformanceFrequency(&freq);
        if (freq == 0) {
            freq = 10000000;
        }
        i64 sec = count / freq;
        i64 frac = count % freq;
        win_store_le_i64(p, 0, sec);
        win_store_le_i64(p, 8, frac * 1000000000 / freq);
        return 0;
    }
    u64 ft = 0;
    win_GetSystemTimePreciseAsFileTime(&ft);
    i64 unix100 = (i64)ft - WIN_FILETIME_UNIX_EPOCH;
    win_store_le_i64(p, 0, unix100 / 10000000);
    win_store_le_i64(p, 8, (unix100 % 10000000) * 100);
    return 0;
}

/// BCryptGenRandom with the system-preferred RNG fills the whole buffer;
/// getrandom semantics (partial fills, EINTR) are not exercised by callers
/// here.
i64 sys_getrandom(i64 buf, i64 len, i64 flags) {
    // BCRYPT_USE_SYSTEM_PREFERRED_RNG = 2; null algorithm handle.
    if (win_BCryptGenRandom(0, (u8*)buf, (u64)len, 2) != 0) {
        return -5;
    }
    return len;
}

// ---------------------------------------------------------------------------
// One-time platform setup, called by _start before cpu init: UTF-8 console
// codepages so @println renders correctly on a real console.
// ---------------------------------------------------------------------------

/// Seam: switches the console input and output code pages to UTF-8.
void sys_platform_init() {
    win_SetConsoleOutputCP(WIN_CP_UTF8);
    win_SetConsoleCP(WIN_CP_UTF8);
}

// ---------------------------------------------------------------------------
// Filesystem seam: mkdir / access / rmdir / directory listing.
// ---------------------------------------------------------------------------

extern "C" {
    /// Win32 `CreateDirectoryW`.
    #[link_name("CreateDirectoryW")]
    i32 win_CreateDirectoryW(u16* path, u8* attrs);
    /// Win32 `RemoveDirectoryW`.
    #[link_name("RemoveDirectoryW")]
    i32 win_RemoveDirectoryW(u16* path);
    /// Win32 `GetFileAttributesW`.
    #[link_name("GetFileAttributesW")]
    u32 win_GetFileAttributesW(u16* path);
    /// Win32 `FindFirstFileW`.
    #[link_name("FindFirstFileW")]
    i64 win_FindFirstFileW(u16* pattern, u8* data);
    /// Win32 `FindNextFileW`.
    #[link_name("FindNextFileW")]
    i32 win_FindNextFileW(i64 handle, u8* data);
    /// Win32 `FindClose`.
    #[link_name("FindClose")]
    i32 win_FindClose(i64 handle);
    /// Win32 `GetCurrentDirectoryW`.
    #[link_name("GetCurrentDirectoryW")]
    u32 win_GetCurrentDirectoryW(u32 len, u16* buf);
    /// Win32 `SetCurrentDirectoryW`.
    #[link_name("SetCurrentDirectoryW")]
    i32 win_SetCurrentDirectoryW(u16* path);
}

/// Convert a NUL-terminated UTF-8 path into `wpath` (capacity units).
/// Returns false when the path is too long for the buffer.
bool win_path_to_wide(u8* path, u16* wpath, i64 cap) {
    if (win_utf16_len(path) + 1 >= cap) {
        return false;
    }
    win_utf8_to_utf16(path, wpath);
    return true;
}

/// Seam: CreateDirectoryW (`mode` is ignored). Failures report the mapped
/// errno (EEXIST, ENOENT, ...).
i64 sys_mkdir(i64 path, i64 mode) {
    u16 wpath[1024];
    if (!win_path_to_wide((u8*)path, &wpath[0], 1024)) {
        return -36; // ENAMETOOLONG
    }
    if (win_CreateDirectoryW(&wpath[0], (u8*)0) == 0) {
        return -win_last_errno();
    }
    return 0;
}

/// Existence probe (only F_OK semantics are consumed: mode is ignored).
i64 sys_access(i64 path, i64 mode) {
    u16 wpath[1024];
    if (!win_path_to_wide((u8*)path, &wpath[0], 1024)) {
        return -36;
    }
    if (win_GetFileAttributesW(&wpath[0]) == (u32)0xFFFFFFFF) {
        return -win_last_errno();
    }
    return 0;
}

/// Seam: RemoveDirectoryW. Failures report the mapped errno (ENOTEMPTY,
/// ENOENT, ...).
i64 sys_rmdir(i64 path) {
    u16 wpath[1024];
    if (!win_path_to_wide((u8*)path, &wpath[0], 1024)) {
        return -36;
    }
    if (win_RemoveDirectoryW(&wpath[0]) == 0) {
        return -win_last_errno();
    }
    return 0;
}

/// Seam: getcwd(2) semantics. Writes the NUL-terminated UTF-8 working
/// directory into `buf` (capacity `cap` bytes) and returns its length
/// including the terminator; -ERANGE when `cap` is too small.
i64 sys_getcwd(i64 buf, i64 cap) {
    u16 wbuf[1024];
    u32 units = win_GetCurrentDirectoryW(1024, &wbuf[0]);
    if (units == 0) {
        return -win_last_errno();
    }
    if (units >= 1024) {
        return -36; // ENAMETOOLONG: beyond the seam's path buffer
    }
    // Worst case 3 UTF-8 bytes per unit (surrogate pairs: 4 per 2 units);
    // win_utf16_to_utf8 stops 4 bytes short of its capacity, hence the slack.
    i64 need = (i64)units * 3 + 5;
    if (cap < need) {
        // Measure exactly before reporting ERANGE: most paths are ASCII.
        u8 tmp[3077];
        i64 exact = win_utf16_to_utf8(&wbuf[0], &tmp[0], 3077) + 1;
        if (cap < exact) {
            return -34;
        }
        u8* out = (u8*)buf;
        i64 i = 0;
        while (i < exact) {
            out[i] = tmp[i];
            i += 1;
        }
        return exact;
    }
    return win_utf16_to_utf8(&wbuf[0], (u8*)buf, cap) + 1;
}

/// Seam: chdir(2). Returns 0 or the mapped -errno.
i64 sys_chdir(i64 path) {
    u16 wpath[1024];
    if (!win_path_to_wide((u8*)path, &wpath[0], 1024)) {
        return -36;
    }
    if (win_SetCurrentDirectoryW(&wpath[0]) == 0) {
        return -win_last_errno();
    }
    return 0;
}

/// List NUL-separated entry names of directory `path` into `buf` (capacity
/// `cap` bytes). Returns the entry count, or a negative errno. "." and ".."
/// are excluded. Overflow reports ENAMETOOLONG (-36). Layout matches the
/// Linux counterpart so consumers stay portable.
i64 sys_list_dir(i64 path, u8* buf, i64 cap) {
    if (path == 0 || buf == (u8*)0 || cap <= 0) {
        return -22; // EINVAL
    }
    // Build the "path\*" search pattern (tolerates a trailing separator).
    u8 pat[1024];
    i64 n = 0;
    u8* p8 = (u8*)path;
    while (p8[n] != 0 && n < 1000) {
        pat[n] = p8[n];
        n += 1;
    }
    if (p8[n] != 0) {
        return -36;
    }
    if (n > 0 && pat[n - 1] != (u8)47 && pat[n - 1] != (u8)92) {
        pat[n] = (u8)92; // backslash
        n += 1;
    }
    pat[n] = (u8)42; // '*'
    pat[n + 1] = (u8)0;
    u16 wpat[1024];
    win_utf8_to_utf16(&pat[0], &wpat[0]);
    // WIN32_FIND_DATAW is 592 bytes; cFileName (WCHAR[260]) starts at 44.
    u8 data[592];
    i64 h = win_FindFirstFileW(&wpat[0], &data[0]);
    if (h == -1) {
        return -win_last_errno();
    }
    i64 off = 0;
    i64 count = 0;
    while (true) {
        u16* name = (u16*)&data[44];
        bool dot = name[0] == (u16)46 && name[1] == (u16)0;
        bool dotdot = name[0] == (u16)46 && name[1] == (u16)46 && name[2] == (u16)0;
        if (!dot && !dotdot) {
            // Worst case 3 UTF-8 bytes per unit plus terminator.
            i64 units = 0;
            while (name[units] != (u16)0) {
                units += 1;
            }
            if (off + units * 3 + 1 > cap) {
                win_FindClose(h);
                return -36;
            }
            i64 used = win_utf16_to_utf8(name, &buf[off], cap - off);
            off += used + 1;
            count += 1;
        }
        if (win_FindNextFileW(h, &data[0]) == 0) {
            break;
        }
    }
    win_FindClose(h);
    return count;
}

// ---------------------------------------------------------------------------
// Socket seam: the Linux socket syscalls over winsock (ws2_32).
//
// Callers pass Linux values throughout: AF_INET6 = 10 in sockaddrs, SOL_SOCKET
// = 1 and the Linux SO_* numbers, SOCK_NONBLOCK/SOCK_CLOEXEC type flags, the
// 8-byte Linux pollfd, and -errno results. Each call translates at this
// boundary, so std.sys.socket and std.net stay platform-neutral.
//
// Socket fds are the SOCKET handle with bit 0 set. Win32 handles are
// multiples of 4 (the low two bits are reserved for application tags), so the
// tag lets read/write/close/fcntl route sockets to winsock (recv/send/
// closesocket/FIONBIO), as Linux fds do. Winsock calls get the untagged handle.
// ---------------------------------------------------------------------------

extern "C" {
    /// Winsock `WSAStartup`.
    #[link_name("WSAStartup")]
    i32 win_WSAStartup(u16 version, u8* data);
    /// Winsock `WSAGetLastError`.
    #[link_name("WSAGetLastError")]
    i32 win_WSAGetLastError();
    /// Winsock `WSASocketW`.
    #[link_name("WSASocketW")]
    u64 win_WSASocketW(i32 af, i32 kind, i32 protocol, u8* info, u32 group, u32 flags);
    /// Winsock `closesocket`.
    #[link_name("closesocket")]
    i32 win_closesocket(u64 s);
    /// Winsock `bind`.
    #[link_name("bind")]
    i32 win_bind(u64 s, u8* addr, i32 len);
    /// Winsock `listen`.
    #[link_name("listen")]
    i32 win_listen(u64 s, i32 backlog);
    /// Winsock `accept`.
    #[link_name("accept")]
    u64 win_accept(u64 s, u8* addr, i32* len);
    /// Winsock `connect`.
    #[link_name("connect")]
    i32 win_connect(u64 s, u8* addr, i32 len);
    /// Winsock `shutdown`.
    #[link_name("shutdown")]
    i32 win_shutdown(u64 s, i32 how);
    /// Winsock `setsockopt`.
    #[link_name("setsockopt")]
    i32 win_setsockopt(u64 s, i32 level, i32 name, u8* value, i32 len);
    /// Winsock `getsockopt`.
    #[link_name("getsockopt")]
    i32 win_getsockopt(u64 s, i32 level, i32 name, u8* value, i32* len);
    /// Winsock `getsockname`.
    #[link_name("getsockname")]
    i32 win_getsockname(u64 s, u8* addr, i32* len);
    /// Winsock `getpeername`.
    #[link_name("getpeername")]
    i32 win_getpeername(u64 s, u8* addr, i32* len);
    /// Winsock `send`.
    #[link_name("send")]
    i32 win_send(u64 s, u8* buf, i32 len, i32 flags);
    /// Winsock `recv`.
    #[link_name("recv")]
    i32 win_recv(u64 s, u8* buf, i32 len, i32 flags);
    /// Winsock `sendto`.
    #[link_name("sendto")]
    i32 win_sendto(u64 s, u8* buf, i32 len, i32 flags, u8* addr, i32 addr_len);
    /// Winsock `recvfrom`.
    #[link_name("recvfrom")]
    i32 win_recvfrom(u64 s, u8* buf, i32 len, i32 flags, u8* addr, i32* addr_len);
    /// Winsock `ioctlsocket`.
    #[link_name("ioctlsocket")]
    i32 win_ioctlsocket(u64 s, u32 cmd, u32* arg);
    /// Winsock `WSAIoctl`.
    #[link_name("WSAIoctl")]
    i32 win_WSAIoctl(u64 s, u32 code, u8* in_buf, u32 in_len, u8* out_buf, u32 out_len, u32* returned, u8* overlapped, u8* routine);
    /// Winsock `WSAPoll`.
    #[link_name("WSAPoll")]
    i32 win_WSAPoll(u8* fds, u32 count, i32 timeout);
    /// Winsock `WSASend`.
    #[link_name("WSASend")]
    i32 win_WSASend(u64 s, u8* bufs, u32 count, u32* sent, u32 flags, u8* overlapped, u8* routine);
    /// Winsock `WSARecv`.
    #[link_name("WSARecv")]
    i32 win_WSARecv(u64 s, u8* bufs, u32 count, u32* received, u32* flags, u8* overlapped, u8* routine);
}

/// Linux `AF_INET6`; winsock's value is 23. AF_UNIX (1) and AF_INET (2) agree.
const i64 WIN_LINUX_AF_INET6 = 10;
/// Winsock `AF_INET6`.
const i64 WIN_AF_INET6 = 23;
/// Linux `SOCK_NONBLOCK` socket type flag.
const i64 WIN_LINUX_SOCK_NONBLOCK = 2048;
/// Linux `SOCK_CLOEXEC` socket type flag.
const i64 WIN_LINUX_SOCK_CLOEXEC = 524288;
/// Linux `MSG_NOSIGNAL`: winsock never raises SIGPIPE, so it is dropped.
const i64 WIN_LINUX_MSG_NOSIGNAL = 0x4000;
/// Linux `MSG_WAITALL`; winsock's value is 8.
const i64 WIN_LINUX_MSG_WAITALL = 0x100;
/// Winsock `SOCK_DGRAM`.
const i64 WIN_SOCK_DGRAM = 2;
/// `WSASocketW` flag: overlapped-capable socket, as `socket()` creates.
/// Blocking calls still complete synchronously; without it winsock ignores
/// SO_RCVTIMEO/SO_SNDTIMEO.
const u32 WIN_WSA_FLAG_OVERLAPPED = 0x01;
/// `WSASocketW` flag: the handle is not inherited by child processes.
const u32 WIN_WSA_FLAG_NO_HANDLE_INHERIT = 0x80;
/// `ioctlsocket` command: set (non-zero) or clear non-blocking mode.
const u32 WIN_FIONBIO = 0x8004667E;
/// `WSAIoctl` code: report (or not) ICMP port-unreachable as recv errors.
const u32 WIN_SIO_UDP_CONNRESET = 0x9800000C;
/// `WSAIoctl` code: initial RTO and SYN retransmission count for connect.
const u32 WIN_SIO_TCP_INITIAL_RTO = 0x98000011;
/// Winsock `SOL_SOCKET` level.
const i32 WIN_SOL_SOCKET = 0xFFFF;
/// Winsock `SO_RCVTIMEO` (DWORD milliseconds, not a timeval).
const i32 WIN_SO_RCVTIMEO = 0x1006;
/// Winsock `SO_SNDTIMEO` (DWORD milliseconds, not a timeval).
const i32 WIN_SO_SNDTIMEO = 0x1005;
/// Winsock `SO_ERROR` (reports a WSA error code).
const i32 WIN_SO_ERROR = 0x1007;
/// Linux `ENOPROTOOPT`: the option has no winsock equivalent.
const i64 WIN_ENOPROTOOPT = 92;
/// Largest byte count one winsock call accepts (an `int`).
const i64 WIN_SOCK_IO_MAX = 0x7FFFFFFF;
/// WSABUF/WSAPOLLFD entries converted on the stack per call.
const i64 WIN_SOCK_BATCH = 64;

/// Internal: true once WSAStartup has succeeded. Set only on success, so a
/// failed start (e.g. WSASYSNOTREADY) is retried by the next socket call.
/// A race only starts winsock twice, which it reference-counts harmlessly;
/// it is never balanced by WSACleanup.
bool g_win_wsa_started = false;

/// Internal: initializes winsock 2.2 on first use. 0 or -errno.
i64 win_wsa_init() {
    if (!g_win_wsa_started) {
        u8 data[512]; // WSADATA is 408 bytes on x64
        i32 err = win_WSAStartup((u16)0x0202, &data[0]);
        if (err != 0) {
            return -win_errno((u32)err); // WSAStartup returns its error
        }
        g_win_wsa_started = true;
    }
    return 0;
}

/// True when `fd` is a tagged socket fd (see the section header).
bool win_fd_is_socket(i64 fd) {
    return fd > 2 && (fd & 1) != 0;
}

/// The SOCKET handle behind tagged socket fd `fd`.
u64 win_fd_socket(i64 fd) {
    return (u64)(fd & ~(i64)1);
}

/// Tags a fresh SOCKET as an fd. Handles beyond the i32 fd range or without
/// the reserved low bits clear (non-kernel provider handles) are closed and
/// reported as EMFILE.
i64 win_socket_fd(u64 s) {
    if ((s & 3) != 0 || s > (u64)0x7FFFFFFE) {
        win_closesocket(s);
        return -EMFILE;
    }
    return (i64)(s | 1);
}

/// Linux errno for the calling thread's last winsock error.
i64 win_wsa_errno() {
    return win_errno((u32)win_WSAGetLastError());
}

/// Linux errno for a failed send/recv: an SO_RCVTIMEO/SO_SNDTIMEO expiry is
/// EAGAIN on Linux, where winsock reports WSAETIMEDOUT.
i64 win_wsa_io_errno() {
    i32 err = win_WSAGetLastError();
    if (err == 10060) { // WSAETIMEDOUT
        return EAGAIN;
    }
    return win_errno((u32)err);
}

/// Internal: reads a little-endian u16 at `buf[off]`, zero-extended.
i64 win_le_u16(u8* buf, i64 off) {
    return (i64)buf[off] | ((i64)buf[off + 1] << 8);
}

/// Copies Linux sockaddr `addr` (`len` bytes) into `out` (128 bytes) with the
/// winsock family value. Returns the length, or -EINVAL when it does not fit.
i64 win_sockaddr_to_win(i64 addr, i64 len, u8* out) {
    if (len < 2 || len > 128) {
        return -EINVAL;
    }
    u8* src = (u8*)addr;
    i64 i = 0;
    while (i < len) {
        out[i] = src[i];
        i += 1;
    }
    if (win_le_u16(out, 0) == WIN_LINUX_AF_INET6) {
        out[0] = (u8)WIN_AF_INET6;
        out[1] = (u8)0;
    }
    return len;
}

/// Rewrites the family of a winsock-filled sockaddr at `addr` (`len` valid
/// bytes) to the Linux value.
void win_sockaddr_to_linux(i64 addr, i64 len) {
    u8* p = (u8*)addr;
    if (addr != 0 && len >= 2 && win_le_u16(p, 0) == WIN_AF_INET6) {
        p[0] = (u8)WIN_LINUX_AF_INET6;
        p[1] = (u8)0;
    }
}

/// Sets or clears non-blocking mode on socket fd `fd`. 0 or -errno.
i64 win_sock_set_nonblocking(i64 fd, bool on) {
    u32 mode = on ? (u32)1 : (u32)0;
    if (win_ioctlsocket(win_fd_socket(fd), WIN_FIONBIO, &mode) != 0) {
        return -win_wsa_errno();
    }
    return 0;
}

/// Winsock send/recv flags for Linux `flags`. MSG_OOB/PEEK/DONTROUTE share
/// values; MSG_NOSIGNAL is dropped and MSG_WAITALL renumbered.
i32 win_sock_flags(i64 flags) {
    i64 out = flags & ~(WIN_LINUX_MSG_NOSIGNAL | WIN_LINUX_MSG_WAITALL);
    if ((flags & WIN_LINUX_MSG_WAITALL) != 0) {
        out = out | 8;
    }
    return (i32)out;
}

/// Socket write(2)/send(2): one send call. Count or -errno.
i64 win_sock_send(i64 fd, i64 buf, i64 len, i64 flags) {
    i64 n = len > WIN_SOCK_IO_MAX ? WIN_SOCK_IO_MAX : len;
    i32 r = win_send(win_fd_socket(fd), (u8*)buf, (i32)n, win_sock_flags(flags));
    if (r < 0) {
        return -win_wsa_io_errno();
    }
    return (i64)r;
}

/// Socket read(2)/recv(2): one recv call. Count (0 = peer closed) or -errno.
/// A truncated datagram returns the filled length, as Linux does.
i64 win_sock_recv(i64 fd, i64 buf, i64 len, i64 flags) {
    i64 n = len > WIN_SOCK_IO_MAX ? WIN_SOCK_IO_MAX : len;
    i32 r = win_recv(win_fd_socket(fd), (u8*)buf, (i32)n, win_sock_flags(flags));
    if (r < 0) {
        if (win_WSAGetLastError() == 10040) { // WSAEMSGSIZE
            return n;
        }
        return -win_wsa_io_errno();
    }
    return (i64)r;
}

/// Seam: socket(2). `kind` may carry SOCK_NONBLOCK/SOCK_CLOEXEC. Datagram
/// sockets ignore ICMP port-unreachable reports, as unconnected Linux UDP
/// sockets do. Returns the tagged fd or -errno.
i64 sys_socket(i64 domain, i64 kind, i64 protocol) {
    i64 started = win_wsa_init();
    if (started < 0) {
        return started;
    }
    i64 af = domain == WIN_LINUX_AF_INET6 ? WIN_AF_INET6 : domain;
    i64 base = kind & ~(WIN_LINUX_SOCK_NONBLOCK | WIN_LINUX_SOCK_CLOEXEC);
    u32 flags = WIN_WSA_FLAG_OVERLAPPED;
    if ((kind & WIN_LINUX_SOCK_CLOEXEC) != 0) {
        flags = flags | WIN_WSA_FLAG_NO_HANDLE_INHERIT;
    }
    u64 s = win_WSASocketW((i32)af, (i32)base, (i32)protocol, (u8*)0, 0, flags);
    if (s == ~(u64)0) {
        return -win_wsa_errno();
    }
    i64 fd = win_socket_fd(s);
    if (fd < 0) {
        return fd;
    }
    if (base == WIN_SOCK_DGRAM) {
        u32 off = 0;
        u32 returned = 0;
        win_WSAIoctl(s, WIN_SIO_UDP_CONNRESET, (u8*)&off, 4, (u8*)0, 0, &returned, (u8*)0, (u8*)0);
    }
    if ((kind & WIN_LINUX_SOCK_NONBLOCK) != 0) {
        i64 r = win_sock_set_nonblocking(fd, true);
        if (r < 0) {
            win_closesocket(s);
            return r;
        }
    }
    return fd;
}

/// Seam: bind(2) with a Linux sockaddr. 0 or -errno.
i64 sys_bind(i64 fd, i64 addr, i64 len) {
    u8 wa[128];
    i64 n = win_sockaddr_to_win(addr, len, &wa[0]);
    if (n < 0) {
        return n;
    }
    if (win_bind(win_fd_socket(fd), &wa[0], (i32)n) != 0) {
        return -win_wsa_errno();
    }
    return 0;
}

/// Seam: listen(2). 0 or -errno.
i64 sys_listen(i64 fd, i64 backlog) {
    if (win_listen(win_fd_socket(fd), (i32)backlog) != 0) {
        return -win_wsa_errno();
    }
    return 0;
}

/// Seam: accept4(2). Winsock accepted sockets inherit the listener's
/// blocking mode; this applies SOCK_NONBLOCK explicitly so the result is
/// blocking unless asked, as on Linux. `addr`/`len_ptr` may be null.
i64 sys_accept4(i64 fd, i64 addr, i64 len_ptr, i64 flags) {
    u64 s = win_accept(win_fd_socket(fd), (u8*)addr, (i32*)len_ptr);
    if (s == ~(u64)0) {
        return -win_wsa_errno();
    }
    if (len_ptr != 0) {
        i32* lenp = (i32*)len_ptr;
        win_sockaddr_to_linux(addr, (i64)lenp[0]);
    }
    i64 cfd = win_socket_fd(s);
    if (cfd < 0) {
        return cfd;
    }
    i64 r = win_sock_set_nonblocking(cfd, (flags & WIN_LINUX_SOCK_NONBLOCK) != 0);
    if (r < 0) {
        win_closesocket(s);
        return r;
    }
    return cfd;
}

/// Seam: accept(2): accept4 with no flags.
i64 sys_accept(i64 fd, i64 addr, i64 len_ptr) {
    return sys_accept4(fd, addr, len_ptr, 0);
}

/// True when winsock sockaddr `wa` (`len` bytes) is 127.0.0.0/8 or ::1.
bool win_sockaddr_is_loopback(u8* wa, i64 len) {
    i64 family = win_le_u16(wa, 0);
    if (family == 2 && len >= 8) {
        return wa[4] == (u8)127;
    }
    if (family == WIN_AF_INET6 && len >= 24) {
        i64 i = 8;
        while (i < 23) {
            if (wa[i] != (u8)0) {
                return false;
            }
            i += 1;
        }
        return wa[23] == (u8)1;
    }
    return false;
}

/// Seam: connect(2) with a Linux sockaddr. A non-blocking connect in
/// progress reports EINPROGRESS (winsock says WSAEWOULDBLOCK).
///
/// Windows answers a RST to its SYN by retransmitting the SYN for about two
/// seconds before reporting ECONNREFUSED; Linux fails at once. On loopback,
/// where a SYN cannot be lost, SYN retransmission is disabled so a refused
/// connection fails immediately there too.
i64 sys_connect(i64 fd, i64 addr, i64 len) {
    u8 wa[128];
    i64 n = win_sockaddr_to_win(addr, len, &wa[0]);
    if (n < 0) {
        return n;
    }
    if (win_sockaddr_is_loopback(&wa[0], n)) {
        // TCP_INITIAL_RTO_PARAMETERS { u16 Rtt; u8 MaxSynRetransmissions; }:
        // unspecified RTT (0xFFFF), TCP_INITIAL_RTO_NO_SYN_RETRANSMISSIONS
        // (0xFE). Fails harmlessly on non-TCP sockets.
        u8 rto[4] = { (u8)0xFF, (u8)0xFF, (u8)0xFE, (u8)0 };
        u32 returned = 0;
        win_WSAIoctl(win_fd_socket(fd), WIN_SIO_TCP_INITIAL_RTO, &rto[0], 4, (u8*)0, 0, &returned, (u8*)0, (u8*)0);
    }
    if (win_connect(win_fd_socket(fd), &wa[0], (i32)n) != 0) {
        i32 err = win_WSAGetLastError();
        if (err == 10035) { // WSAEWOULDBLOCK
            return -EINPROGRESS;
        }
        return -win_errno((u32)err);
    }
    return 0;
}

/// Seam: shutdown(2); SHUT_RD/WR/RDWR share winsock's SD_* values.
i64 sys_shutdown(i64 fd, i64 how) {
    if (win_shutdown(win_fd_socket(fd), (i32)how) != 0) {
        return -win_wsa_errno();
    }
    return 0;
}

/// Winsock (level, name) for a Linux socket option, packed as
/// level << 32 | name. 0 means "accept as a no-op"; -1 means unsupported.
/// SO_REUSEADDR is a no-op: winsock already rebinds ports held only by
/// TIME_WAIT connections, and its own SO_REUSEADDR would allow two live
/// listeners on one port. SO_REUSEPORT load balancing has no equivalent.
i64 win_sockopt(i64 level, i64 name) {
    if (level == 1) { // SOL_SOCKET
        i64 wname = match name {
            2: 0,         // SO_REUSEADDR: no-op
            3: 0x1008,    // SO_TYPE
            4: 0x1007,    // SO_ERROR
            6: 0x0020,    // SO_BROADCAST
            7: 0x1001,    // SO_SNDBUF
            8: 0x1002,    // SO_RCVBUF
            9: 0x0008,    // SO_KEEPALIVE
            20: 0x1006,   // SO_RCVTIMEO
            21: 0x1005,   // SO_SNDTIMEO
            _: -1
        };
        if (wname <= 0) {
            return wname;
        }
        return ((i64)WIN_SOL_SOCKET << 32) | wname;
    }
    if (level == 6 && name == 1) { // IPPROTO_TCP, TCP_NODELAY
        return ((i64)6 << 32) | 1;
    }
    return -1;
}

/// Seam: setsockopt(2) with Linux level/option values. SO_RCVTIMEO and
/// SO_SNDTIMEO take a Linux timeval and become winsock DWORD milliseconds.
i64 sys_setsockopt(i64 fd, i64 level, i64 name, i64 value, i64 len) {
    i64 opt = win_sockopt(level, name);
    if (opt == 0) {
        return 0;
    }
    if (opt < 0) {
        return -WIN_ENOPROTOOPT;
    }
    i32 wlevel = (i32)(opt >> 32);
    i32 wname = (i32)(opt & 0xFFFFFFFF);
    u64 s = win_fd_socket(fd);
    i32 r = 0;
    if (wlevel == WIN_SOL_SOCKET && (wname == WIN_SO_RCVTIMEO || wname == WIN_SO_SNDTIMEO)) {
        if (len < 16) {
            return -EINVAL;
        }
        // Linux rules: tv_usec outside [0, 1e6) is EDOM; a negative tv_sec
        // times out at once (winsock's floor is 1 ms, as 0 means none); a
        // timeout too large to represent waits forever.
        i64* tv = (i64*)value;
        if (tv[1] < 0 || tv[1] >= 1000000) {
            return -EDOM;
        }
        i64 ms = 1;
        if (tv[0] >= 0) {
            if (tv[0] > 0xFFFFFFFE / 1000) {
                ms = 0;
            } else {
                ms = tv[0] * 1000 + (tv[1] + 999) / 1000;
                if (ms > 0xFFFFFFFE) {
                    ms = 0;
                }
            }
        }
        u32 dw = (u32)ms;
        r = win_setsockopt(s, wlevel, wname, (u8*)&dw, 4);
    } else {
        r = win_setsockopt(s, wlevel, wname, (u8*)value, (i32)len);
    }
    if (r != 0) {
        return -win_wsa_errno();
    }
    return 0;
}

/// Seam: getsockopt(2) with Linux level/option values. SO_ERROR reports a
/// Linux errno; the timeouts report a Linux timeval.
i64 sys_getsockopt(i64 fd, i64 level, i64 name, i64 value, i64 len_ptr) {
    i64 opt = win_sockopt(level, name);
    if (opt <= 0) {
        return -WIN_ENOPROTOOPT;
    }
    i32 wlevel = (i32)(opt >> 32);
    i32 wname = (i32)(opt & 0xFFFFFFFF);
    u64 s = win_fd_socket(fd);
    i32* lenp = (i32*)len_ptr;
    if (wlevel == WIN_SOL_SOCKET && (wname == WIN_SO_RCVTIMEO || wname == WIN_SO_SNDTIMEO)) {
        if (lenp[0] < 16) {
            return -EINVAL;
        }
        u32 dw = 0;
        i32 dlen = 4;
        if (win_getsockopt(s, wlevel, wname, (u8*)&dw, &dlen) != 0) {
            return -win_wsa_errno();
        }
        i64* tv = (i64*)value;
        tv[0] = (i64)dw / 1000;
        tv[1] = ((i64)dw % 1000) * 1000;
        lenp[0] = 16;
        return 0;
    }
    if (win_getsockopt(s, wlevel, wname, (u8*)value, lenp) != 0) {
        return -win_wsa_errno();
    }
    if (wlevel == WIN_SOL_SOCKET && wname == WIN_SO_ERROR) {
        i32* err = (i32*)value;
        if (err[0] != 0) {
            err[0] = (i32)win_errno((u32)err[0]);
        }
    }
    return 0;
}

/// Seam: getsockname(2); the result carries the Linux family value.
i64 sys_getsockname(i64 fd, i64 addr, i64 len_ptr) {
    i32* lenp = (i32*)len_ptr;
    if (win_getsockname(win_fd_socket(fd), (u8*)addr, lenp) != 0) {
        return -win_wsa_errno();
    }
    win_sockaddr_to_linux(addr, (i64)lenp[0]);
    return 0;
}

/// Seam: getpeername(2); the result carries the Linux family value.
i64 sys_getpeername(i64 fd, i64 addr, i64 len_ptr) {
    i32* lenp = (i32*)len_ptr;
    if (win_getpeername(win_fd_socket(fd), (u8*)addr, lenp) != 0) {
        return -win_wsa_errno();
    }
    win_sockaddr_to_linux(addr, (i64)lenp[0]);
    return 0;
}

/// Seam: sendto(2); a null `addr` sends on the connected peer. Count or
/// -errno.
i64 sys_sendto(i64 fd, i64 buf, i64 len, i64 flags, i64 addr, i64 addr_len) {
    if (addr == 0) {
        return win_sock_send(fd, buf, len, flags);
    }
    u8 wa[128];
    i64 n = win_sockaddr_to_win(addr, addr_len, &wa[0]);
    if (n < 0) {
        return n;
    }
    i64 count = len > WIN_SOCK_IO_MAX ? WIN_SOCK_IO_MAX : len;
    i32 r = win_sendto(win_fd_socket(fd), (u8*)buf, (i32)count, win_sock_flags(flags), &wa[0], (i32)n);
    if (r < 0) {
        return -win_wsa_io_errno();
    }
    return (i64)r;
}

/// Seam: recvfrom(2); `addr`/`len_ptr` may be null, and a filled address
/// carries the Linux family value. Count (0 = stream peer closed) or -errno.
i64 sys_recvfrom(i64 fd, i64 buf, i64 len, i64 flags, i64 addr, i64 len_ptr) {
    if (addr == 0 || len_ptr == 0) {
        return win_sock_recv(fd, buf, len, flags);
    }
    i64 count = len > WIN_SOCK_IO_MAX ? WIN_SOCK_IO_MAX : len;
    i32* lenp = (i32*)len_ptr;
    i32 r = win_recvfrom(win_fd_socket(fd), (u8*)buf, (i32)count, win_sock_flags(flags), (u8*)addr, lenp);
    if (r < 0) {
        if (win_WSAGetLastError() != 10040) { // WSAEMSGSIZE: truncated datagram
            return -win_wsa_io_errno();
        }
        r = (i32)count;
    }
    win_sockaddr_to_linux(addr, (i64)lenp[0]);
    return (i64)r;
}

/// Seam: poll(2) over socket fds with the Linux 8-byte pollfd and POLL*
/// bits, through WSAPoll (16-byte WSAPOLLFD). Negative fds are left out of
/// the winsock set and get zero revents, as on Linux; with no active fds the
/// call just waits out the timeout (forever when negative). Non-socket fds
/// fail with ENOTSOCK. A hang-up also reports POLLIN when it was requested,
/// so readers see EOF as on Linux.
i64 sys_poll(i64 fds, i64 nfds, i64 timeout_ms) {
    u8* lfds = (u8*)fds;
    i64 active = 0;
    i64 i = 0;
    while (i < nfds) {
        i32* fdp = (i32*)&lfds[i * 8];
        lfds[i * 8 + 6] = (u8)0;
        lfds[i * 8 + 7] = (u8)0;
        if (fdp[0] >= 0) {
            active += 1;
        }
        i += 1;
    }
    if (active == 0) {
        if (timeout_ms != 0) {
            win_Sleep(timeout_ms < 0 || timeout_ms > 0xFFFFFFFE ? WIN_INFINITE : (u32)timeout_ms);
        }
        return 0;
    }
    u64 stack_buf[128]; // WIN_SOCK_BATCH * 16 bytes, pointer-aligned for WSAPOLLFD
    u8* wfds = (u8*)&stack_buf[0];
    i64 bytes = active * 16;
    bool mapped = active > WIN_SOCK_BATCH;
    if (mapped) {
        i64 m = sys_mmap(0, bytes, 3, 34, -1, 0);
        if (m < 0) {
            return m;
        }
        wfds = (u8*)m;
    }
    i64 k = 0;
    i = 0;
    while (i < nfds) {
        i32* fdp = (i32*)&lfds[i * 8];
        if (fdp[0] >= 0) {
            i64 ev = win_le_u16(lfds, i * 8 + 4);
            i64 wev = 0;
            if ((ev & 1) != 0) { wev = wev | 0x100; } // POLLIN  -> POLLRDNORM
            if ((ev & 2) != 0) { wev = wev | 0x200; } // POLLPRI -> POLLRDBAND
            if ((ev & 4) != 0) { wev = wev | 0x10; }  // POLLOUT -> POLLWRNORM
            win_store_le_i64(wfds, k * 16, (i64)win_fd_socket((i64)fdp[0]));
            win_store_le_i64(wfds, k * 16 + 8, wev); // events; revents = 0
            k += 1;
        }
        i += 1;
    }
    i32 ms = -1;
    if (timeout_ms >= 0) {
        ms = timeout_ms > 0x7FFFFFFF ? (i32)0x7FFFFFFF : (i32)timeout_ms;
    }
    i32 r = win_WSAPoll(wfds, (u32)active, ms);
    i64 result = (i64)r;
    if (r < 0) {
        result = -win_wsa_errno();
    } else {
        k = 0;
        i = 0;
        while (i < nfds) {
            i32* fdp = (i32*)&lfds[i * 8];
            if (fdp[0] >= 0) {
                i64 wrev = win_le_u16(wfds, k * 16 + 10);
                i64 ev = win_le_u16(lfds, i * 8 + 4);
                i64 rev = 0;
                if ((wrev & 0x100) != 0) { rev = rev | 1; }  // POLLRDNORM -> POLLIN
                if ((wrev & 0x200) != 0) { rev = rev | 2; }  // POLLRDBAND -> POLLPRI
                if ((wrev & 0x10) != 0) { rev = rev | 4; }   // POLLWRNORM -> POLLOUT
                if ((wrev & 1) != 0) { rev = rev | 8; }      // POLLERR
                if ((wrev & 2) != 0) {                       // POLLHUP
                    rev = rev | 16 | (ev & 1);
                }
                if ((wrev & 4) != 0) { rev = rev | 32; }     // POLLNVAL
                lfds[i * 8 + 6] = (u8)(rev & 0xFF);
                k += 1;
            }
            i += 1;
        }
    }
    if (mapped) {
        sys_munmap((i64)wfds, bytes);
    }
    return result;
}

/// Seam: writev(2). Sockets send the whole vector in one WSASend, so a
/// datagram stays one datagram. Other fds gather it into one buffer and
/// issue one WriteFile, so concurrent writers cannot interleave inside it.
/// Returns the byte count (possibly short) or -errno.
i64 sys_writev(i64 fd, i64 iov, i64 count) {
    return win_vectored_io(fd, iov, count, true);
}

/// Seam: readv(2). Sockets fill the whole vector in one WSARecv (a
/// truncated datagram returns the bytes that fit, as Linux does). Other fds
/// issue one ReadFile and scatter what it returned, so a pipe read returns
/// the available data instead of blocking for every buffer.
i64 sys_readv(i64 fd, i64 iov, i64 count) {
    return win_vectored_io(fd, iov, count, false);
}

/// Linux `IOV_MAX`: the largest iovec count writev/readv accept.
const i64 WIN_IOV_MAX = 1024;

/// Internal: shared writev/readv over Linux iovecs ({void* base, i64 len}).
i64 win_vectored_io(i64 fd, i64 iov, i64 count, bool write) {
    if (count < 0 || count > WIN_IOV_MAX) {
        return -EINVAL;
    }
    i64* vec = (i64*)iov;
    i64 total = 0;
    i64 i = 0;
    while (i < count) {
        if (vec[i * 2 + 1] < 0) {
            return -EINVAL;
        }
        total += vec[i * 2 + 1];
        if (total > WIN_SOCK_IO_MAX) {
            return -EINVAL; // Linux rejects a total beyond ssize_t; winsock beyond int
        }
        i += 1;
    }
    if (win_fd_is_socket(fd)) {
        return win_sock_vectored_io(fd, vec, count, total, write);
    }
    if (total == 0) {
        return 0;
    }
    // One native call through a bounce buffer.
    u8 stack_buf[16384];
    u8* bounce = &stack_buf[0];
    bool mapped = total > 16384;
    if (mapped) {
        i64 m = sys_mmap(0, total, 3, 34, -1, 0);
        if (m < 0) {
            return m;
        }
        bounce = (u8*)m;
    }
    i64 r = 0;
    if (write) {
        i64 off = 0;
        i = 0;
        while (i < count) {
            u8* base = (u8*)vec[i * 2];
            i64 j = 0;
            while (j < vec[i * 2 + 1]) {
                bounce[off + j] = base[j];
                j += 1;
            }
            off += vec[i * 2 + 1];
            i += 1;
        }
        r = sys_write(fd, (i64)bounce, total);
    } else {
        r = sys_read(fd, (i64)bounce, total);
        i64 off = 0;
        i = 0;
        while (i < count && off < r) {
            u8* base = (u8*)vec[i * 2];
            i64 j = 0;
            while (j < vec[i * 2 + 1] && off < r) {
                base[j] = bounce[off];
                j += 1;
                off += 1;
            }
            i += 1;
        }
    }
    if (mapped) {
        sys_munmap((i64)bounce, total);
    }
    return r;
}

/// Internal: one WSASend/WSARecv over the whole iovec array (WSABUF is
/// {u32 len; (pad) u8* buf}: 16 bytes).
i64 win_sock_vectored_io(i64 fd, i64* vec, i64 count, i64 total, bool write) {
    u64 stack_bufs[128]; // WIN_SOCK_BATCH * 16 bytes, pointer-aligned for WSABUF
    u8* bufs = (u8*)&stack_bufs[0];
    i64 bytes = count * 16;
    bool mapped = count > WIN_SOCK_BATCH;
    if (mapped) {
        i64 m = sys_mmap(0, bytes, 3, 34, -1, 0);
        if (m < 0) {
            return m;
        }
        bufs = (u8*)m;
    }
    i64 i = 0;
    while (i < count) {
        win_store_le_i64(bufs, i * 16, vec[i * 2 + 1]);
        win_store_le_i64(bufs, i * 16 + 8, vec[i * 2]);
        i += 1;
    }
    u32 done = 0;
    u32 flags = 0;
    i32 r = 0;
    if (write) {
        r = win_WSASend(win_fd_socket(fd), bufs, (u32)count, &done, 0, (u8*)0, (u8*)0);
    } else {
        r = win_WSARecv(win_fd_socket(fd), bufs, (u32)count, &done, &flags, (u8*)0, (u8*)0);
    }
    i64 result = (i64)done;
    if (r != 0) {
        if (!write && win_WSAGetLastError() == 10040) { // WSAEMSGSIZE
            result = total; // the vector is full; the rest was discarded
        } else {
            result = -win_wsa_io_errno();
        }
    }
    if (mapped) {
        sys_munmap((i64)bufs, bytes);
    }
    return result;
}

/// Internal: ReadFile of up to `len` bytes at file offset `off` (OVERLAPPED
/// offset, no separate seek). EOF reads 0. Count or -errno.
i64 win_pread(i64 fd, u8* buf, i64 len, i64 off) {
    u64 ov[4]; // OVERLAPPED: Internal, InternalHigh, Offset|OffsetHigh, hEvent
    ov[0] = 0;
    ov[1] = 0;
    ov[2] = (u64)off;
    ov[3] = 0;
    u32 got = 0;
    if (win_ReadFile(win_fd_handle(fd), buf, (u32)len, &got, (u8*)&ov[0]) == 0) {
        if (win_GetLastError() == 38) { // ERROR_HANDLE_EOF
            return 0;
        }
        return -win_last_errno();
    }
    return (i64)got;
}

/// Seam: sendfile(2) as a copy loop through a 16 KiB buffer. Returns the
/// bytes sent (possibly short) or -errno.
///
/// With a null `offset_ptr`, reading starts at the file position, which ends
/// just past the last byte sent: bytes read but not accepted by `out_fd`
/// (EAGAIN on a non-blocking socket) are given back, so a retry resumes
/// there. With `offset_ptr`, reads are positional and *offset_ptr advances
/// by the bytes sent. Windows positional reads on a synchronous handle still
/// move its shared position, so the call restores it afterwards; another
/// thread must not use `in_fd` during the call (as with Rust's `seek_read`).
i64 sys_sendfile(i64 out_fd, i64 in_fd, i64 offset_ptr, i64 count) {
    i64* offset = (i64*)offset_ptr;
    i64 saved = 0;
    if (offset_ptr != 0) {
        saved = sys_lseek(in_fd, 0, 1); // SEEK_CUR
        if (saved < 0) {
            return saved;
        }
    }
    u8 chunk[16384];
    i64 sent = 0;
    i64 err = 0;
    while (sent < count) {
        i64 want = count - sent;
        if (want > 16384) { want = 16384; }
        i64 got = 0;
        if (offset_ptr != 0) {
            got = win_pread(in_fd, &chunk[0], want, offset[0] + sent);
        } else {
            got = sys_read(in_fd, (i64)&chunk[0], want);
        }
        if (got <= 0) {
            err = got;
            break;
        }
        i64 put = 0;
        while (put < got) {
            i64 w = sys_write(out_fd, (i64)&chunk[put], got - put);
            if (w <= 0) {
                err = w < 0 ? w : -EIO;
                break;
            }
            put += w;
        }
        sent += put;
        if (put < got) {
            if (offset_ptr == 0) {
                sys_lseek(in_fd, put - got, 1); // give back the unsent bytes
            }
            break;
        }
    }
    if (offset_ptr != 0) {
        offset[0] = offset[0] + sent;
        sys_lseek(in_fd, saved, 0); // SEEK_SET
    }
    if (sent == 0 && err < 0) {
        return err;
    }
    return sent;
}

// ---------------------------------------------------------------------------
// Console seam: window size, raw mode, tty test, readable-wait.
// ---------------------------------------------------------------------------

extern "C" {
    /// Win32 `GetConsoleScreenBufferInfo`.
    #[link_name("GetConsoleScreenBufferInfo")]
    i32 win_GetConsoleScreenBufferInfo(i64 handle, u8* info);
    /// Win32 `GetConsoleMode`.
    #[link_name("GetConsoleMode")]
    i32 win_GetConsoleMode(i64 handle, u32* mode);
    /// Win32 `SetConsoleMode`.
    #[link_name("SetConsoleMode")]
    i32 win_SetConsoleMode(i64 handle, u32 mode);
    /// Win32 `WaitForSingleObject`.
    #[link_name("WaitForSingleObject")]
    i32 win_WaitForSingleObject(i64 handle, u32 ms);
}

/// Write the console window size for `fd` ({rows, cols} as i64) through
/// `rows_ptr` / `cols_ptr`. 0 on success, negative errno otherwise.
i64 sys_console_size(i64 fd, i64 rows_ptr, i64 cols_ptr) {
    // CONSOLE_SCREEN_BUFFER_INFO (22 bytes): srWindow = 4 shorts
    // (Left@10, Top@12, Right@14, Bottom@16), each little-endian.
    u8 info[22];
    i64 i = 0;
    while (i < 22) {
        info[i] = (u8)0;
        i += 1;
    }
    if (win_GetConsoleScreenBufferInfo(win_fd_handle(fd), &info[0]) == 0) {
        return -5; // EIO (not a console, e.g. a pipe)
    }
    i64 left = (i64)info[10] | ((i64)info[11] << 8);
    i64 top = (i64)info[12] | ((i64)info[13] << 8);
    i64 right = (i64)info[14] | ((i64)info[15] << 8);
    i64 bottom = (i64)info[16] | ((i64)info[17] << 8);
    i64* rp = (i64*)rows_ptr;
    i64* cp = (i64*)cols_ptr;
    rp[0] = bottom - top + 1;
    cp[0] = right - left + 1;
    return 0;
}

/// True (1) when `fd` is a console, 0 otherwise.
i64 sys_is_tty(i64 fd) {
    u32 mode = 0;
    return win_GetConsoleMode(win_fd_handle(fd), &mode) != 0;
}

/// Put `fd` into raw mode, saving the previous console input mode (DWORD,
/// little-endian) into `saved[0..4]` (`len` must be >= 4). 0 on success,
/// negative errno otherwise. Clears ENABLE_PROCESSED/LINE/ECHO_INPUT.
i64 sys_raw_enable(i64 fd, u8* saved, i64 len) {
    if (saved == (u8*)0 || len < 4) {
        return -22; // EINVAL
    }
    u32 mode = 0;
    if (win_GetConsoleMode(win_fd_handle(fd), &mode) == 0) {
        return -5; // EIO
    }
    saved[0] = (u8)(mode & 0xFF);
    saved[1] = (u8)((mode >> 8) & 0xFF);
    saved[2] = (u8)((mode >> 16) & 0xFF);
    saved[3] = (u8)((mode >> 24) & 0xFF);
    u32 raw = mode & ~(u32)7;
    if (win_SetConsoleMode(win_fd_handle(fd), raw) == 0) {
        return -5;
    }
    return 0;
}

/// Restore a console mode previously saved by sys_raw_enable.
i64 sys_raw_restore(i64 fd, u8* saved) {
    if (saved == (u8*)0) {
        return -22; // EINVAL
    }
    u32 mode = (u32)saved[0] | ((u32)saved[1] << 8) | ((u32)saved[2] << 16) | ((u32)saved[3] << 24);
    if (win_SetConsoleMode(win_fd_handle(fd), mode) == 0) {
        return -5;
    }
    return 0;
}

/// Block up to `timeout_ms` (>= 0; negative waits forever) for `fd` to
/// become readable. Returns 1 when readable, 0 on timeout, negative errno.
/// Console and pipe handles are both waitable kernel objects.
i64 sys_wait_readable(i64 fd, i64 timeout_ms) {
    u32 ms = WIN_INFINITE;
    if (timeout_ms >= 0) {
        ms = (u32)timeout_ms;
    }
    i64 r = win_WaitForSingleObject(win_fd_handle(fd), ms);
    if (r == 0) {
        return 1; // WAIT_OBJECT_0
    }
    if (r == 258) {
        return 0; // WAIT_TIMEOUT
    }
    return -5; // EIO
}
