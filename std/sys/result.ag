// std/sys/result.ag — typed, Result-style front-ends for raw Linux syscalls.
//
// Raw sys_* wrappers (std/sys/linux.ag) traffic exclusively in i64 and
// encode failure as a return value in -4095..-1 (negated errno). The
// standard `Result<i64, i64>` decodes that convention: Ok(value) carries
// the successful return, Err(errno) carries the positive errno. The
// syscall-specific helpers (`from_raw`, `err_is`, `err_name`, ...) live on
// an impl of `Result<i64, i64>` here so error handling is unified with the
// rest of the stdlib.
//
// The typed wrappers are prefixed `try_` (try_read, try_write, ...) rather
// than using the bare POSIX names: Silver `pub` functions emit unmangled
// C-ABI symbols, and defining `read`/`write`/`open`/... would interpose on
// libc symbols with an incompatible (sret struct return) ABI while the
// toolchain still links against libc.

import std.result;
import std.sys.errno;
import std.sys.linux;

// --- Flag constants used by the typed wrappers ---

// mmap protection bits (asm-generic/mman-common.h).
const i64 PROT_NONE = 0;
const i64 PROT_READ = 1;
const i64 PROT_WRITE = 2;
const i64 PROT_EXEC = 4;

// mmap flag bits (x86_64).
const i64 MAP_SHARED = 1;
const i64 MAP_PRIVATE = 2;
const i64 MAP_FIXED = 16;
const i64 MAP_ANONYMOUS = 32;

// mremap flag bits. (MREMAP_FIXED is not supported by try_mremap, which
// does not take a new_address argument.)
const i64 MREMAP_MAYMOVE = 1;

// open(2) flag bits (x86_64, octal values in C headers).
const i64 O_RDONLY = 0;
const i64 O_WRONLY = 1;
const i64 O_RDWR = 2;
const i64 O_CREAT = 64;        // 0o100
const i64 O_EXCL = 128;        // 0o200
const i64 O_TRUNC = 512;       // 0o1000
const i64 O_APPEND = 1024;     // 0o2000
const i64 O_NONBLOCK = 2048;   // 0o4000
const i64 O_DIRECTORY = 65536; // 0o200000
const i64 O_CLOEXEC = 524288;  // 0o2000000

// openat(2) special dirfd: resolve relative paths against the CWD.
const i64 AT_FDCWD = -100;

// lseek(2) whence values.
const i64 SEEK_SET = 0;
const i64 SEEK_CUR = 1;
const i64 SEEK_END = 2;

// Well-known file descriptors.
const i32 STDIN_FD = 0;
const i32 STDOUT_FD = 1;
const i32 STDERR_FD = 2;

// --- Result<i64, i64> syscall helpers ---
//
// Ok(value) carries the successful syscall return; Err(errno) carries the
// positive errno. These helpers keep the pre-enum SysResult API.

impl Result<i64, i64> {
    // Decode a raw syscall return value (-4095..-1 => error).
    Result<i64, i64> from_raw(i64 raw) {
        if (is_errno(raw)) {
            return Result.Err(-raw);
        }
        return Result.Ok(raw);
    }

    bool is_ok(Result<i64, i64> self) {
        return match self { Ok(v) : true, Err(e) : false };
    }

    bool is_err(Result<i64, i64> self) {
        return match self { Ok(v) : false, Err(e) : true };
    }

    // True when this result failed with exactly errno `err`.
    bool err_is(Result<i64, i64> self, i64 err) {
        return self.is_err() && self.errno() == err;
    }

    // The successful value, or 0 when the result is an error.
    i64 value(Result<i64, i64> self) {
        return match self { Ok(v) : v, Err(e) : (i64)0 };
    }

    // The positive errno when the result is an error, or 0 on success.
    i64 errno(Result<i64, i64> self) {
        return match self {
            Ok(v) : (i64)0,
            Err(e) : e
        };
    }

    // Symbolic errno name ("EOK" when the call succeeded).
    str err_name(Result<i64, i64> self) {
        if (self.is_ok()) {
            return "EOK";
        }
        return errno_name(self.errno());
    }
}

// --- Typed syscall front-ends ---

// read(2): read up to `count` bytes from `fd` into `buf`.
// Ok value: number of bytes read (0 = EOF).
Result<i64, i64> try_read(i32 fd, u8* buf, i64 count) {
    return Result<i64, i64>.from_raw(sys_read((i64)fd, (i64)buf, count));
}

// write(2): write `count` bytes from `buf` to `fd`.
// Ok value: number of bytes written.
Result<i64, i64> try_write(i32 fd, u8* buf, i64 count) {
    return Result<i64, i64>.from_raw(sys_write((i64)fd, (i64)buf, count));
}

// open(2): open `path` with O_* `flags`; `mode` is the creation mode
// (only consulted when flags contain O_CREAT). Ok value: new fd.
Result<i64, i64> try_open(str path, i64 flags, i64 mode) {
    return Result<i64, i64>.from_raw(sys_open((i64)path, flags, mode));
}

// openat(2): like open, resolving relative paths against `dirfd`
// (pass AT_FDCWD for the current working directory). Ok value: new fd.
Result<i64, i64> try_openat(i32 dirfd, str path, i64 flags, i64 mode) {
    return Result<i64, i64>.from_raw(sys_openat((i64)dirfd, (i64)path, flags, mode));
}

// close(2): close `fd`. Ok value: 0.
Result<i64, i64> try_close(i32 fd) {
    return Result<i64, i64>.from_raw(sys_close((i64)fd));
}

// mmap(2): map `length` bytes with PROT_*/MAP_* bits. Pass addr = 0 to let
// the kernel choose, fd = -1 with MAP_ANONYMOUS. Ok value: mapping address.
Result<i64, i64> try_mmap(void* addr, i64 length, i64 prot, i64 flags, i32 fd, i64 offset) {
    return Result<i64, i64>.from_raw(sys_mmap((i64)addr, length, prot, flags, (i64)fd, offset));
}

// munmap(2): unmap `length` bytes at page-aligned `addr`. Ok value: 0.
Result<i64, i64> try_munmap(void* addr, i64 length) {
    return Result<i64, i64>.from_raw(sys_munmap((i64)addr, length));
}

// mremap(2): resize the mapping at `old_addr` from `old_size` to `new_size`.
// Pass MREMAP_MAYMOVE to allow relocation. Ok value: new mapping address.
// MREMAP_FIXED is intentionally unsupported (no new_address parameter);
// the kernel receives 0 for it.
Result<i64, i64> try_mremap(void* old_addr, i64 old_size, i64 new_size, i64 flags) {
    return Result<i64, i64>.from_raw(sys_mremap((i64)old_addr, old_size, new_size, flags, 0));
}

// lseek(2): reposition `fd` to `offset` relative to SEEK_*. Ok value: the
// resulting absolute offset.
Result<i64, i64> try_lseek(i32 fd, i64 offset, i64 whence) {
    return Result<i64, i64>.from_raw(sys_lseek((i64)fd, offset, whence));
}

// kill(2): send signal `sig` to `pid` (sig 0 probes existence). Ok value: 0.
Result<i64, i64> try_kill(i32 pid, i32 sig) {
    return Result<i64, i64>.from_raw(sys_kill((i64)pid, (i64)sig));
}

// getpid(2): never fails. Ok value: the calling process id.
Result<i64, i64> try_getpid() {
    return Result<i64, i64>.from_raw(sys_getpid());
}

// exit_group(2): terminate every thread in the process with `code`.
// Does not return.
void exit_group(i64 code) {
    sys_exit_group(code);
    sys_exit(code);
    while (true) {}
}
// --- Socket, fcntl, and poll constants ---

const i64 F_GETFL = 3;
const i64 F_SETFL = 4;
const i64 AF_INET = 2;
const i64 AF_INET6 = 10;
const i64 SOCK_STREAM = 1;
const i64 SOCK_DGRAM = 2;
const i64 SOCK_NONBLOCK = 2048;
const i64 SOCK_CLOEXEC = 524288;
const i64 IPPROTO_TCP = 6;
const i64 IPPROTO_UDP = 17;
const i64 SOL_SOCKET = 1;
const i64 SO_REUSEADDR = 2;
const i64 SO_ERROR = 4;
const i64 SO_RCVTIMEO = 20;
const i64 SHUT_RD = 0;
const i64 SHUT_WR = 1;
const i64 SHUT_RDWR = 2;
const i64 INADDR_ANY = 0;
const i64 POLLIN = 1;
const i64 POLLOUT = 4;
const i64 POLLERR = 8;
const i64 POLLHUP = 16;

// --- PollFd ---
struct PollFd {
    i32 fd;
    i16 events;
    i16 revents;
}

// --- Typed socket/fcntl/poll wrappers ---

Result<i64, i64> try_socket(i64 domain, i64 ty, i64 protocol) {
    return Result<i64, i64>.from_raw(sys_socket(domain, ty, protocol));
}

Result<i64, i64> try_bind(i32 fd, void* addr, i64 addr_len) {
    return Result<i64, i64>.from_raw(sys_bind((i64)fd, (i64)addr, addr_len));
}

Result<i64, i64> try_listen(i32 fd, i64 backlog) {
    return Result<i64, i64>.from_raw(sys_listen((i64)fd, backlog));
}

Result<i64, i64> try_accept4(i32 fd, void* addr, u32* addr_len, i64 flags) {
    return Result<i64, i64>.from_raw(sys_accept4((i64)fd, (i64)addr, (i64)addr_len, flags));
}

Result<i64, i64> try_connect(i32 fd, void* addr, i64 addr_len) {
    return Result<i64, i64>.from_raw(sys_connect((i64)fd, (i64)addr, addr_len));
}

Result<i64, i64> try_shutdown(i32 fd, i64 how) {
    return Result<i64, i64>.from_raw(sys_shutdown((i64)fd, how));
}

Result<i64, i64> try_setsockopt(i32 fd, i64 level, i64 optname, void* optval, i64 optlen) {
    return Result<i64, i64>.from_raw(sys_setsockopt((i64)fd, level, optname, (i64)optval, optlen));
}

Result<i64, i64> try_getsockname(i32 fd, void* addr, u32* addr_len) {
    return Result<i64, i64>.from_raw(sys_getsockname((i64)fd, (i64)addr, (i64)addr_len));
}

Result<i64, i64> try_getpeername(i32 fd, void* addr, u32* addr_len) {
    return Result<i64, i64>.from_raw(sys_getpeername((i64)fd, (i64)addr, (i64)addr_len));
}

Result<i64, i64> try_fcntl(i32 fd, i64 cmd, i64 arg) {
    return Result<i64, i64>.from_raw(sys_fcntl((i64)fd, cmd, arg));
}

Result<i64, i64> try_poll(PollFd* fds, i64 nfds, i64 timeout) {
    return Result<i64, i64>.from_raw(sys_poll((i64)fds, nfds, timeout));
}

Result<i64, i64> try_getsockopt(i32 fd, i64 level, i64 optname, void* optval, u32* optlen) {
    return Result<i64, i64>.from_raw(sys_getsockopt((i64)fd, level, optname, (i64)optval, (i64)optlen));
}

Result<i64, i64> try_sendto(i32 fd, void* buf, i64 len, i64 flags, void* addr, i64 addr_len) {
    return Result<i64, i64>.from_raw(sys_sendto((i64)fd, (i64)buf, len, flags, (i64)addr, addr_len));
}

Result<i64, i64> try_recvfrom(i32 fd, void* buf, i64 len, i64 flags, void* addr, u32* addr_len) {
    return Result<i64, i64>.from_raw(sys_recvfrom((i64)fd, (i64)buf, len, flags, (i64)addr, (i64)addr_len));
}

Result<i64, i64> try_sendmsg(i32 fd, void* msg, i64 flags) {
    return Result<i64, i64>.from_raw(sys_sendmsg((i64)fd, (i64)msg, flags));
}

Result<i64, i64> try_recvmsg(i32 fd, void* msg, i64 flags) {
    return Result<i64, i64>.from_raw(sys_recvmsg((i64)fd, (i64)msg, flags));
}
