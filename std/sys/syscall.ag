if (@cfg(os.linux)) {
/// Pure-Silver syscall wrappers for the Linux syscall ABI.
///
/// Each wrapper passes the syscall number as the first asm input, then the
/// arguments in order; the compiler binds them to the target's syscall
/// registers and returns the kernel's result register as an i64. Failure is
/// a value in -4095..-1 (negated errno).
///
///   x86_64:  rax=num, rdi, rsi, rdx, r10, r8, r9; result rax; `syscall`
///   aarch64: x8=num,  x0,  x1,  x2,  x3,  x4, x5; result x0;  `svc #0`

if (@cfg(arch.aarch64)) {
/// Performs a 0-argument syscall.
i64 syscall0(i64 num) {
    return asm("svc #0", [num]);
}

/// Performs a 1-argument syscall.
i64 syscall1(i64 num, i64 arg1) {
    return asm("svc #0", [num, arg1]);
}

/// Performs a 2-argument syscall.
i64 syscall2(i64 num, i64 arg1, i64 arg2) {
    return asm("svc #0", [num, arg1, arg2]);
}

/// Performs a 3-argument syscall.
i64 syscall3(i64 num, i64 arg1, i64 arg2, i64 arg3) {
    return asm("svc #0", [num, arg1, arg2, arg3]);
}

/// Performs a 4-argument syscall.
i64 syscall4(i64 num, i64 arg1, i64 arg2, i64 arg3, i64 arg4) {
    return asm("svc #0", [num, arg1, arg2, arg3, arg4]);
}

/// Performs a 5-argument syscall.
i64 syscall5(i64 num, i64 arg1, i64 arg2, i64 arg3, i64 arg4, i64 arg5) {
    return asm("svc #0", [num, arg1, arg2, arg3, arg4, arg5]);
}

/// Performs a 6-argument syscall.
i64 syscall6(i64 num, i64 arg1, i64 arg2, i64 arg3, i64 arg4, i64 arg5, i64 arg6) {
    return asm("svc #0", [num, arg1, arg2, arg3, arg4, arg5, arg6]);
}
} else {
/// Performs a 0-argument syscall.
i64 syscall0(i64 num) {
    return asm("syscall", [num]);
}

/// Performs a 1-argument syscall.
i64 syscall1(i64 num, i64 arg1) {
    return asm("syscall", [num, arg1]);
}

/// Performs a 2-argument syscall.
i64 syscall2(i64 num, i64 arg1, i64 arg2) {
    return asm("syscall", [num, arg1, arg2]);
}

/// Performs a 3-argument syscall.
i64 syscall3(i64 num, i64 arg1, i64 arg2, i64 arg3) {
    return asm("syscall", [num, arg1, arg2, arg3]);
}

/// Performs a 4-argument syscall.
i64 syscall4(i64 num, i64 arg1, i64 arg2, i64 arg3, i64 arg4) {
    return asm("syscall", [num, arg1, arg2, arg3, arg4]);
}

/// Performs a 5-argument syscall.
i64 syscall5(i64 num, i64 arg1, i64 arg2, i64 arg3, i64 arg4, i64 arg5) {
    return asm("syscall", [num, arg1, arg2, arg3, arg4, arg5]);
}

/// Performs a 6-argument syscall.
i64 syscall6(i64 num, i64 arg1, i64 arg2, i64 arg3, i64 arg4, i64 arg5, i64 arg6) {
    return asm("syscall", [num, arg1, arg2, arg3, arg4, arg5, arg6]);
}
}
}
