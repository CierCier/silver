// Runtime entry ABI declarations for modules linked into an executable.
// The implementation and initialized storage live only in std.sys.entry.
extern "C" {
    /// Returns the process argument count captured at startup.
    i32 silver_argc();
    /// Returns the process argument vector captured at startup. Do not free it.
    i8** silver_argv();
    /// Returns the current NUL-terminated environment block.
    i8** silver_envp();
    /// Replaces the environment block returned by `silver_envp`. The caller keeps
    /// ownership of `value` and must keep it alive while it is installed.
    void silver_set_envp(i8** value);
}
