// std/rt/thread_registry.ag — always-linked thread bookkeeping for static
// (no-libc) runtimes that use the thread runtime (std/thread.ag).
//
// The registry owns the thread table and the join-all entry point called by
// `_start` (std/sys/entry.ag) after `main` returns but before I/O flush, so
// every spawned thread has finished before the process calls exit_group.
// Because this module is imported by entry.ag it is present in every static
// binary; it is a read-mostly, low-fixed-cost table (g_threads is in .bss, so
// zero pages with no binary footprint) and join-all is a no-op when no threads
// were ever spawned.

// Imported transitively by std.sys.entry and directly by std.thread.
import std.mem.alloc;
import std.atomic;
import std.sys.raw.sync;

// Maximum concurrently live threads (slots are reclaimed by thread_join).
const i64 MAX_THREADS = 64;

// futex(2) operations (Linux x86_64, syscall 202).
const i64 FUTEX_OP_WAIT = 0;
const i64 FUTEX_OP_WAKE = 1;
// Errnos a futex wait can legitimately observe while the flag stays unset:
// EAGAIN (-11): the value changed before we slept (wake raced ahead of us);
// EINTR (-4): a signal interrupted the wait.
const i64 FUTEX_EAGAIN = -11;
const i64 FUTEX_EINTR = -4;
// Bounded spin before blocking: short joins never pay a syscall.
const i64 THREAD_JOIN_MAX_SPINS = 64;

// Per-thread bookkeeping. `tid` doubles as the slot liveness flag:
//   0  = free slot,   <0 = slot claimed but child not yet running,
//   >0 = child thread running/done (raw clone tid).
struct TaskRecord {
    i64 tid;     // raw clone tid; 0 = free slot (see above)
    i64 fn;      // user function address
    i64 arg;     // user argument
    u8* stack;   // child stack base (parent-owned mmap; see thread.ag)
    i64 done;    // atomic: 1 once the child fn returned (thread then exits)
    i64 pack;    // launch pack ptr (compiler-owned); 0 for spawn(): freed by the waiter
}

// Thread table and its guard. .bss, zero-initialized by the OS loader.
TaskRecord g_threads[64];
i32 g_thread_lock;

/// Acquire the registry spinlock (CAS on i32; same pattern as the allocator).
void thread_lock_acquire() {
    while (true) {
        bool acquired = __atomic_cmpxchg_i32(&g_thread_lock, 0, 1, ATOMIC_SEQ_CST, ATOMIC_ACQUIRE);
        if (acquired) {
            return;
        }
    }
}

/// Release the registry spinlock.
void thread_lock_release() {
    __atomic_store_i32(&g_thread_lock, 0, ATOMIC_RELEASE);
}

/// Block on the child's done flag via futex wait. Each iteration re-reads
/// the flag before sleeping, and the kernel atomically re-checks that
/// `*uaddr == 0` when entering FUTEX_WAIT, so a wake that raced ahead of
/// the wait returns -EAGAIN instead of stranding us.
void thread_wait_done_futex(TaskRecord* rec) {
    while (true) {
        if (__atomic_load_i64(&rec.done, ATOMIC_ACQUIRE) == 1) {
            return;
        }
        i64 r = sys_futex((i64)&rec.done, FUTEX_OP_WAIT, 0, 0, 0, 0);
        if (r == FUTEX_EAGAIN || r == FUTEX_EINTR) {
            continue;
        }
    }
}

/// Wake one thread blocked in thread_wait_done_futex on this record.
/// Called by the child after its release-store of `done = 1`.
void thread_wake_done_futex(TaskRecord* rec) {
    sys_futex((i64)&rec.done, FUTEX_OP_WAKE, 1, 0, 0, 0);
}

/// Join one task: wait until the child fn returned, then reclaim the slot.
/// Returns the child's tid. Silently returns -1 for a null record.
i64 thread_join(TaskRecord* rec) {
    if (rec == (TaskRecord*)0) {
        return -1;
    }
    // Adaptive wait: spin briefly (cheap for near-instant joins), then block
    // in the kernel on the done flag. The child never exits without setting
    // done and waking one waiter.
    i64 spins = 0;
    while (true) {
        if (__atomic_load_i64(&rec.done, ATOMIC_ACQUIRE) == 1) {
            break;
        }
        spins = spins + 1;
        if (spins > THREAD_JOIN_MAX_SPINS) {
            thread_wait_done_futex(rec);
            break;
        }
    }
    i64 tid = rec.tid;
    thread_lock_acquire();
    rec.tid = 0;
    thread_lock_release();
    return tid;
}

/// Wait for a `launch`ed task (T1). Spins on the done flag, then atomically
/// claims and returns its pack so the caller can read the result and free it.
/// v1 has no lazy slot-reap (a slot is reclaimed only here or by join_all at
/// process exit), so `rec` stays stable while any waiter may reference it and
/// the returned pack is never freed concurrently.
u8* __silver_wait_done(i64 rec) {
    TaskRecord* r = (TaskRecord*)rec;
    if (r == (TaskRecord*)0) {
        return (u8*)0;
    }
    i64 spins = 0;
    while (true) {
        if (__atomic_load_i64(&r.done, ATOMIC_ACQUIRE) == 1) {
            break;
        }
        spins = spins + 1;
        if (spins > THREAD_JOIN_MAX_SPINS) {
            thread_wait_done_futex(r);
            break;
        }
    }
    thread_lock_acquire();
    u8* pack = (u8*)r.pack;
    r.tid = 0;
    r.fn = 0;
    r.arg = 0;
    r.stack = (u8*)0;
    r.done = 0;
    r.pack = 0;
    thread_lock_release();
    return pack;
}

/// Join every live thread. Called by `_start` before I/O flush / exit.
void __silver_thread_registry_join_all() {
    for (i64 i = 0; i < MAX_THREADS; i = i + 1) {
        // Snapshot tid without taking the lock; a concurrent spawn only ever
        // transitions a slot 0 -> -1 -> tid, and at this stage (process exit)
        // no spawns remain. >0 means a child exists.
        i64 tid = __atomic_load_i64(&g_threads[i].tid, ATOMIC_ACQUIRE);
        if (tid > 0) {
            thread_join(&g_threads[i]);
        }
        // Free any pack a detached (never-waited) `launch` left behind.
        u8* pack = (u8*)g_threads[i].pack;
        if (pack != (u8*)0) {
            mem_free_raw_impl(pack);
            g_threads[i].pack = 0;
        }
    }
}