// std/rt/thread_registry.ag — always-linked thread bookkeeping for static
// (no-libc) runtimes that use the thread runtime (std/thread.ag).
//
// The registry owns the thread table and the join-all entry point called by
// `_start` (std/sys/entry.ag) after `main` returns but before I/O flush, so
// every spawned thread has finished before the process calls exit_group.
// Because this module is imported by entry.ag it is present in every static
// binary; it is a read-mostly, low-fixed-cost table (g_threads is in .bss, so
// zero pages with no binary footprint) and join-all is a no-op when no threads
// were ever spawned.

// Imported transitively by std.sys.entry and directly by std.thread.
import std.mem.alloc;
import std.atomic;
import std.sys.os;

/// Maximum concurrently live threads (slots are reclaimed by thread_join).
/// Spawning fails once this many threads are live.
const i64 MAX_THREADS = 64;

/// Returns the number of usable thread slots: `MAX_THREADS`, or 1 when built
/// with the `launch_failure_test` cfg to exercise slot exhaustion.
i64 thread_registry_capacity() {
    if (@cfg(launch_failure_test)) { return 1; }
    return MAX_THREADS;
}

// futex(2) operations (Linux x86_64, syscall 202).
/// futex(2) wait operation.
const i64 FUTEX_OP_WAIT = 0;
/// futex(2) wake operation.
const i64 FUTEX_OP_WAKE = 1;
// Errnos a futex wait can legitimately observe while the flag stays unset:
// EAGAIN (-11): the value changed before we slept (wake raced ahead of us);
// EINTR (-4): a signal interrupted the wait.
/// futex wait result when the word changed before sleeping; retried.
const i64 FUTEX_EAGAIN = -11;
/// futex wait result when a signal interrupted the wait; retried.
const i64 FUTEX_EINTR = -4;
/// Bounded spin before blocking: short joins never pay a syscall.
const i64 THREAD_JOIN_MAX_SPINS = 64;

/// Per-thread bookkeeping. `tid` doubles as the slot liveness flag:
///   0  = free slot,   <0 = slot claimed but child not yet running,
///   >0 = child thread running/done (raw clone tid).
struct TaskRecord {
    i64 tid;     // raw clone tid; 0 = free slot (see above)
    i64 fn;      // user function address
    i64 arg;     // user argument
    u8* stack;   // child stack base (parent-owned mmap; see thread.ag)
    i64 done;    // atomic: 1 once the child fn returned (thread then exits)
    i64 pack;    // launch pack ptr (compiler-owned); 0 for spawn(): freed by the waiter
    i32 ctid;    // kernel-managed tid via CLONE_CHILD_CLEARTID (cleared to 0 upon thread exit)
    i64 scoped;  // 1 for a launch that borrows from its launcher: joined when the handle drops
    i64 generation; // bumped when a waiter reclaims the slot; older handles are stale
}

/// A `launch` handle is `generation << TASK_HANDLE_SLOT_BITS | (slot + 1)`,
/// so it is never 0 (the failed-launch value) and a copy of a handle that
/// was already waited no longer matches its slot once the slot is reused.
const i64 TASK_HANDLE_SLOT_BITS = 7;
/// Mask for the slot bits of a task handle.
const i64 TASK_HANDLE_SLOT_MASK = 127;

/// Thread table and its guard. .bss, zero-initialized by the OS loader.
/// Internal: guard with `thread_lock_acquire`/`thread_lock_release`.
TaskRecord g_threads[64];
/// Internal: spinlock word for `g_threads` (0 = free, 1 = held).
i32 g_thread_lock;

/// Acquire the registry spinlock (CAS on i32; same pattern as the allocator).
void thread_lock_acquire() {
    while (true) {
        bool acquired = __atomic_cmpxchg_i32(&g_thread_lock, 0, 1, ATOMIC_SEQ_CST, ATOMIC_ACQUIRE);
        if (acquired) {
            return;
        }
    }
}

/// Release the registry spinlock.
void thread_lock_release() {
    __atomic_store_i32(&g_thread_lock, 0, ATOMIC_RELEASE);
}

/// Block on the child's done flag via futex wait. Each iteration re-reads
/// the flag before sleeping, and the kernel atomically re-checks that
/// `*uaddr == 0` when entering FUTEX_WAIT, so a wake that raced ahead of
/// the wait returns -EAGAIN instead of stranding us.
void thread_wait_done_futex(TaskRecord* rec) {
    while (true) {
        if (__atomic_load_i64(&rec.done, ATOMIC_ACQUIRE) == 1) {
            return;
        }
        i64 r = sys_futex((i64)&rec.done, FUTEX_OP_WAIT, 0, 0, 0, 0);
        if (r == FUTEX_EAGAIN || r == FUTEX_EINTR) {
            continue;
        }
    }
}

/// Wake one thread blocked in thread_wait_done_futex on this record.
/// Called by the child after its release-store of `done = 1`.
void thread_wake_done_futex(TaskRecord* rec) {
    sys_futex((i64)&rec.done, FUTEX_OP_WAKE, 1, 0, 0, 0);
}
/// Wait until the kernel clears rec.ctid to 0 upon thread exit via CLONE_CHILD_CLEARTID.
void thread_wait_ctid(TaskRecord* rec) {
    while (true) {
        i32 c = __atomic_load_i32(&rec.ctid, ATOMIC_ACQUIRE);
        if (c == 0) {
            return;
        }
        i64 r = sys_futex((i64)&rec.ctid, FUTEX_OP_WAIT, (i64)c, 0, 0, 0);
        if (r == FUTEX_EAGAIN || r == FUTEX_EINTR) {
            continue;
        }
    }
}


/// Block until `rec`'s thread has finished: spin briefly, then sleep on the
/// futex. Linux waits for the kernel to clear `ctid` (the thread has left its
/// stack); other targets wait for the done flag.
void thread_await_exit(TaskRecord* rec) {
    if (@cfg(os.linux)) {
        i64 spins = 0;
        while (true) {
            if (__atomic_load_i32(&rec.ctid, ATOMIC_ACQUIRE) == 0) {
                break;
            }
            spins = spins + 1;
            if (spins > THREAD_JOIN_MAX_SPINS) {
                thread_wait_ctid(rec);
                break;
            }
        }
    } else {
        i64 spins = 0;
        while (true) {
            if (__atomic_load_i64(&rec.done, ATOMIC_ACQUIRE) == 1) {
                break;
            }
            spins = spins + 1;
            if (spins > THREAD_JOIN_MAX_SPINS) {
                thread_wait_done_futex(rec);
                break;
            }
        }
    }
}

/// Returns the handle `launch` gives out for the task in `rec`.
i64 task_handle(TaskRecord* rec) {
    i64 slot = ((i64)rec - (i64)&g_threads[0]) / @size(TaskRecord);
    i64 generation = __atomic_load_i64(&rec.generation, ATOMIC_ACQUIRE);
    return (generation << TASK_HANDLE_SLOT_BITS) | (slot + 1);
}

/// Returns the record `handle` names, or null when the handle is 0 or stale:
/// its task was already waited, so the slot may hold another task.
TaskRecord* task_handle_record(i64 handle) {
    i64 slot = (handle & TASK_HANDLE_SLOT_MASK) - 1;
    if (slot < 0 || slot >= thread_registry_capacity()) {
        return (TaskRecord*)0;
    }
    TaskRecord* rec = &g_threads[slot];
    if (__atomic_load_i64(&rec.generation, ATOMIC_ACQUIRE) != (handle >> TASK_HANDLE_SLOT_BITS)) {
        return (TaskRecord*)0;
    }
    return rec;
}

/// Ends a stale handle so no later task can reuse it. Caller holds the lock.
void task_retire_generation(TaskRecord* rec) {
    __atomic_store_i64(&rec.generation, rec.generation + 1, ATOMIC_RELEASE);
}

/// Prints `message` to stderr and exits with 134 like `abort()`.
void task_abort(str message) {
    sys_write(2, (i64)message, strlen(message));
    sys_kill(sys_getpid(), 6);  // SIGABRT
    sys_exit_group(134);
}

/// Join one task: wait until the child fn returned, then reclaim the slot.
/// Returns the child's tid. Silently returns -1 for a null record.
i64 thread_join(TaskRecord* rec) {
    if (rec == (TaskRecord*)0) {
        return -1;
    }
    thread_await_exit(rec);
    thread_lock_acquire();
    i64 tid = rec.tid;
    rec.tid = 0;
    task_retire_generation(rec);
    thread_lock_release();
    // The child has exited (done flag set): release its OS resources. On
    // Windows tid is the CreateThread handle and must be closed.
    if (tid > 0) {
        thread_reclaim(tid);
    }
    return tid;
}

/// Wait for a `launch`ed task and claim its pack so the caller can read the
/// result and free it. Aborts when `handle` is stale: a copy of a handle
/// whose task was already waited. Waiting one task from two threads at once
/// is not supported. Internal: called by compiler-generated code with a
/// non-zero handle.
u8* __silver_wait_done(i64 handle) {
    TaskRecord* r = task_handle_record(handle);
    if (r == (TaskRecord*)0) {
        task_abort("wait: task was already waited\n");
    }
    thread_await_exit(r);
    thread_lock_acquire();
    if (r.generation != (handle >> TASK_HANDLE_SLOT_BITS)) {
        thread_lock_release();
        task_abort("wait: task was already waited\n");
    }
    u8* pack = (u8*)r.pack;
    i64 tid = r.tid;
    r.tid = 0;
    r.fn = 0;
    r.arg = 0;
    r.done = 0;
    r.pack = 0;
    r.scoped = 0;
    task_retire_generation(r);
    thread_lock_release();
    // The child has exited: release its OS resources (Windows CreateThread
    // handle). Returned packs are task results, not thread handles.
    if (tid > 0) {
        thread_reclaim(tid);
    }
    return pack;
}

/// Abort for `wait` on a task whose thread never started (registry full,
/// stack mmap failure, or clone error). Exits with 134 like `abort()`.
/// Internal: called by compiler-generated code; never returns.
void __silver_task_not_started() {
    task_abort("wait: task failed to start; check `task.started()` after `launch`\n");
}

/// Join a task handle that is leaving scope unwaited. A scoped task (one
/// launched with borrowed arguments) is joined and its pack returned so the
/// caller can drop the result and free the pack. Returns null for a failed
/// launch, a stale copy of an already-waited handle, or a detached task,
/// which keeps running until the exit-time join.
u8* __silver_task_join_scoped(i64 handle) {
    TaskRecord* r = task_handle_record(handle);
    if (r == (TaskRecord*)0 || r.scoped == 0) {
        return (u8*)0;
    }
    return __silver_wait_done(handle);
}

/// Join every live thread. Called by `_start` before I/O flush / exit.
void __silver_thread_registry_join_all() {
    for (i64 i = 0; i < thread_registry_capacity(); i = i + 1) {
        // Snapshot tid without taking the lock; a concurrent spawn only ever
        // transitions a slot 0 -> -1 -> tid, and at this stage (process exit)
        // no spawns remain. >0 means a child exists.
        i64 tid = __atomic_load_i64(&g_threads[i].tid, ATOMIC_ACQUIRE);
        if (tid > 0) {
            thread_join(&g_threads[i]);
        }
        // Free any pack a detached (never-waited) `launch` left behind.
        u8* pack = (u8*)g_threads[i].pack;
        if (pack != (u8*)0) {
            mem_free_raw_impl(pack);
            g_threads[i].pack = 0;
        }
        // Reclaim the thread stack on process exit.
        if (g_threads[i].stack != (u8*)0) {
            mem_sys_free(g_threads[i].stack, 2097152);
            g_threads[i].stack = (u8*)0;
        }
    }
}