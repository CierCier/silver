// std/rt/backtrace.ag — Runtime stack trace printing.
//
// The compiler emits a symbol table for every function with a body:
//
//   @__silver_bt_entries = global ptr @__silver_bt_data   // BtEntry array
//   @__silver_bt_count   = global i64 N
//
// where each BtEntry is { i64 addr, u8* name, u8* file, i64 line } with
// `addr` resolved to the function's entry address at link time (ptrtoint in
// a global initializer) and file/line taken from the function's AST span.
// Every function is compiled with the "frame-pointer"="all" attribute, so
// the runtime can walk the rbp chain and resolve each return address to a
// function name + source position. The tables are sorted lazily at first
// use, then lookups are binary searches.
//
// Pure Silver + inline asm; no libc dependency. Used by abort() and
// __silver_assert_failed to print a named stack trace before dying.

import std.sys.os;

struct BtEntry {
    i64 addr;
    u8* name;
    u8* file;
    i64 line;
}

// Exact source lines: {function start, offset within function, line, file}.
struct BtLine {
    i64 addr;
    i64 offset;
    i64 line;
    u8* file;
}

// Spilled arguments: per function {start, count, args}, each arg = {name,
// rbp-relative frame offset, byte size}.
struct BtArg {
    u8* name;
    i64 fbreg;
    i64 size;
}

struct BtFnArgs {
    i64 addr;
    i64 count;
    BtArg* args;
}

extern "C" {
    i64 __silver_bt_count;
    BtEntry* __silver_bt_entries;
    i64 __silver_bt_lines_count;
    BtLine* __silver_bt_lines;
    i64 __silver_bt_args_count;
    BtFnArgs* __silver_bt_args;
}

/// Read the current frame pointer (rbp). The asm emitter returns rax.
i64 bt_read_rbp() {
    return asm("movq %rbp, %rax", [], []);
}

/// Write a NUL-terminated string to fd via raw write(2).
void bt_write_cstr(i64 fd, u8* s) {
    i64 len = 0;
    while (s[len] != (u8)0) { len = len + 1; }
    sys_write(fd, (i64)s, len);
}

/// Write `value` in decimal to fd.
void bt_write_dec(i64 fd, i64 value) {
    u8 buf[24];
    i64 n = 0;
    if (value == 0) {
        buf[0] = (u8)'0';
        n = 1;
    } else {
        while (value > 0) {
            buf[n] = (u8)((u8)'0' + (u8)(value % 10));
            n = n + 1;
            value = value / 10;
        }
    }
    i64 i = 0;
    while (i < n / 2) {
        u8 tmp = buf[i];
        buf[i] = buf[n - 1 - i];
        buf[n - 1 - i] = tmp;
        i = i + 1;
    }
    sys_write(fd, (i64)&buf[0], n);
}

/// Write `b` as two lowercase hex digits (no 0x prefix).
void bt_write_hex2(i64 fd, i64 b) {
    u8 buf[2];
    i64 hi = (b >> 4) & (i64)0xF;
    i64 lo = b & (i64)0xF;
    if (hi < 10) { buf[0] = (u8)((u8)'0' + (u8)hi); } else { buf[0] = (u8)((u8)'a' + (u8)(hi - 10)); }
    if (lo < 10) { buf[1] = (u8)((u8)'0' + (u8)lo); } else { buf[1] = (u8)((u8)'a' + (u8)(lo - 10)); }
    sys_write(fd, (i64)&buf[0], 2);
}

/// Write `value` as `0x<16 hex digits>` to fd.
void bt_write_hex(i64 fd, i64 value) {
    u8 buf[19];
    buf[0] = (u8)'0';
    buf[1] = (u8)'x';
    i64 i = 0;
    i64 shift = (i64)60;
    while (i < 16) {
        i64 digit = (value >> shift) & (i64)0xF;
        if (digit < (i64)10) {
            buf[i + 2] = (u8)((u8)'0' + (u8)digit);
        } else {
            buf[i + 2] = (u8)((u8)'a' + (u8)(digit - (i64)10));
        }
        shift = shift - (i64)4;
        i = i + 1;
    }
    buf[18] = (u8)0;
    sys_write(fd, (i64)&buf[0], 19);
}

// -- Lazy sort + binary search ----------------------------------------------
//
// Function addresses are link-time relocations, so the tables cannot be
// pre-sorted by the compiler. On first resolution the entries table is
// sorted by address and the line table by (address, offset); every later
// lookup is O(log N) instead of a linear scan.
//
// The first resolution mutates the process-wide tables in place, so it must
// be serialized: two threads sorting concurrently (or one searching while
// another sorts) would corrupt the tables. A tiny asm spinlock — xchg to
// memory is implicitly locked — guards the one-time initialization; later
// lookups are unlocked reads of stable tables.

i64 g_bt_lock;
i32 g_bt_sorted;

/// Atomically exchange 1 with *addr; returns the previous value.
i64 bt_xchg(i64 addr) {
    return asm("movq $1, %rax\nxchgq %rax, (%rdi)", [0, addr], ["memory"]);
}

/// Read the publication flag through inline asm: the memory clobber makes the
/// load opaque to the optimizer, so a table read can never be hoisted or
/// cached above it. (The x86 load itself is already acquire under TSO; this
/// closes the compiler-level half of the race at any opt level.)
i64 bt_sorted_load(i64 addr) {
    return asm("movl (%rdi), %eax", [0, addr], ["memory"]);
}

void bt_lock_acquire() {
    i64 addr = (i64)&g_bt_lock;
    while (bt_xchg(addr) != 0) {
        i64 _p = asm("pause", [], []);
    }
}

void bt_lock_release() {
    i64 addr = (i64)&g_bt_lock;
    i64 _s = asm("movq $0, (%rdi)", [0, addr], ["memory"]);
}

bool bt_line_before(BtLine a, BtLine b) {
    if (a.addr != b.addr) {
        return a.addr < b.addr;
    }
    return a.offset < b.offset;
}

void bt_qsort_entries(i64 lo, i64 hi) {
    if (lo >= hi) { return; }
    i64 i = lo;
    i64 j = hi;
    i64 pivot = __silver_bt_entries[(lo + hi) / 2].addr;
    while (i <= j) {
        while (__silver_bt_entries[i].addr < pivot) { i = i + 1; }
        while (__silver_bt_entries[j].addr > pivot) { j = j - 1; }
        if (i <= j) {
            BtEntry tmp = __silver_bt_entries[i];
            __silver_bt_entries[i] = __silver_bt_entries[j];
            __silver_bt_entries[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }
    bt_qsort_entries(lo, j);
    bt_qsort_entries(i, hi);
}

void bt_qsort_lines(i64 lo, i64 hi) {
    if (lo >= hi) { return; }
    i64 i = lo;
    i64 j = hi;
    BtLine pivot = __silver_bt_lines[(lo + hi) / 2];
    while (i <= j) {
        while (bt_line_before(__silver_bt_lines[i], pivot)) { i = i + 1; }
        while (bt_line_before(pivot, __silver_bt_lines[j])) { j = j - 1; }
        if (i <= j) {
            BtLine tmp = __silver_bt_lines[i];
            __silver_bt_lines[i] = __silver_bt_lines[j];
            __silver_bt_lines[j] = tmp;
            i = i + 1;
            j = j - 1;
        }
    }
    bt_qsort_lines(lo, j);
    bt_qsort_lines(i, hi);
}

/// One-time in-place sort of both tables (double-checked under the spinlock).
void bt_ensure_sorted() {
    if (bt_sorted_load((i64)&g_bt_sorted) != 0) {
        return;
    }
    bt_lock_acquire();
    if (g_bt_sorted == 0) {
        if (__silver_bt_count > 1) {
            bt_qsort_entries(0, __silver_bt_count - 1);
        }
        if (__silver_bt_lines_count > 1) {
            bt_qsort_lines(0, __silver_bt_lines_count - 1);
        }
        g_bt_sorted = 1;
    }
    bt_lock_release();
}

/// Resolve a return address to the entry whose extent contains it. The
/// binary search finds the largest addr <= ret_addr; the extent is bounded
/// by the next entry's start (the last entry by a 1MB cap — no real Silver
/// function approaches that, while far-larger candidates are stack or heap
/// addresses, not text). Returns -1 when the address is not Silver code.
i64 bt_resolve(i64 ret_addr) {
    i64 count = __silver_bt_count;
    if (count <= 0) {
        return -1;
    }
    bt_ensure_sorted();
    i64 lo = 0;
    i64 hi = count - 1;
    i64 best = -1;
    while (lo <= hi) {
        i64 mid = (lo + hi) / 2;
        if (__silver_bt_entries[mid].addr <= ret_addr) {
            best = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    if (best >= 0) {
        i64 start = __silver_bt_entries[best].addr;
        i64 end = start + 1048576;
        if (best + 1 < count) {
            end = __silver_bt_entries[best + 1].addr;
        }
        if (ret_addr < start || ret_addr >= end) {
            return -1;
        }
        return best;
    }
    return -1;
}

/// Look up the exact source line for a return address: the line table is
/// sorted by (function start, offset), so a composite binary search finds
/// the last entry with (addr, offset) <= (fn_addr, ret_addr - fn_addr).
/// Returns (file, line) via the output pointers, or 0 line when unresolved.
void bt_line_lookup(i64 fn_addr, i64 ret_addr, u8** out_file, i64* out_line) {
    i64 count = __silver_bt_lines_count;
    if (count <= 0) {
        *out_line = 0;
        return;
    }
    bt_ensure_sorted();
    i64 off = ret_addr - fn_addr;
    i64 lo = 0;
    i64 hi = count - 1;
    i64 best = -1;
    while (lo <= hi) {
        i64 mid = (lo + hi) / 2;
        BtLine l = __silver_bt_lines[mid];
        if (l.addr < fn_addr || (l.addr == fn_addr && l.offset <= off)) {
            best = mid;
            lo = mid + 1;
        } else {
            hi = mid - 1;
        }
    }
    if (best >= 0) {
        BtLine l = __silver_bt_lines[best];
        if (l.addr == fn_addr) {
            *out_file = l.file;
            *out_line = l.line;
            return;
        }
    }
    *out_line = 0;
}


/// Print the spilled arguments of the function whose frame pointer is
/// `callee_rbp` (frame base = rbp) and whose start address is `fn_addr`.
void bt_print_args(i64 fd, i64 callee_rbp, i64 fn_addr) {
    i64 i = 0;
    while (i < __silver_bt_args_count) {
        BtFnArgs fa = __silver_bt_args[i];
        if (fa.addr != fn_addr) {
            i = i + 1;
            continue;
        }
        bt_write_cstr(fd, (u8*)"  args: ");
        i64 j = 0;
        while (j < fa.count) {
            BtArg a = fa.args[j];
            bt_write_cstr(fd, a.name);
            bt_write_cstr(fd, (u8*)"=");
            // Assemble the little-endian slot into an unsigned value.
            u8* slot = (u8*)(callee_rbp + a.fbreg);
            i64 nbytes = a.size;
            if (nbytes > 8) { nbytes = 8; }
            if (nbytes < 1) { nbytes = 1; }
            i64 value = 0;
            i64 k = 0;
            while (k < nbytes) {
                i64 b = (i64)slot[k];
                value = value | (b << (k * 8));
                k = k + 1;
            }
            bt_write_dec(fd, value);
            j = j + 1;
            if (j < fa.count) { bt_write_cstr(fd, (u8*)" "); }
        }
        bt_write_cstr(fd, (u8*)"\n");
        return;
    }
}

/// Print a named stack trace to stderr: on Linux the SysV `[rbp]` chain is
/// walked directly; on Windows the frame pointers are REBASED by LLVM
/// (`push rbp; push rsi; ...; mov rbp, rsp; sub N; lea rbp=rsp+K`), so the
/// OS unwinder (RtlVirtualUnwind) provides each frame instead — including
/// the established frame pointer the args table needs.
/// `skip` frames are omitted from the top (the walker's own frame and the
/// abort/assert frame that invoked it).
#[cfg(os.linux)]
void silver_print_backtrace(i64 skip) {
    i64 fd = 2;
    bt_write_cstr(fd, (u8*)"backtrace:
");
    i64 rbp = bt_read_rbp();
    i64 frame = 0;
    i64 printed = 0;
    while (rbp != 0 && printed < 24) {
        // SysV prologue is exactly `push rbp; mov rbp, rsp`: the saved rbp
        // is at [rbp] and the return address at [rbp+8]. A return address
        // that resolves to no Silver function is the boundary to foreign
        // (native/FFI) code — stop there rather than trust an incompatible
        // foreign frame layout.
        i64* saved_ptr = (i64*)rbp;
        i64 s = *saved_ptr;
        i64* ret_ptr = (i64*)(rbp + 8);
        i64 r = *ret_ptr;
        i64 callee_rbp = 0;
        i64 ret_addr = 0;
        if (s > rbp && r != 0 && bt_resolve(r) >= 0) {
            callee_rbp = s;
            ret_addr = r;
        }
        if (callee_rbp == 0) {
            break;  // no Silver caller found: end of the managed chain
        }
        if (frame >= skip) {
            i64 idx = bt_resolve(ret_addr);
            bt_write_cstr(fd, (u8*)"  #");
            bt_write_dec(fd, printed);
            if (idx >= 0) {
                bt_write_cstr(fd, (u8*)"  ");
                BtEntry e = __silver_bt_entries[idx];
                bt_write_cstr(fd, e.name);
                u8* line_file = (u8*)0;
                i64 line_num = 0;
                bt_line_lookup(e.addr, ret_addr, &line_file, &line_num);
                if (line_num > 0 && line_file != (u8*)0) {
                    bt_write_cstr(fd, (u8*)" at ");
                    bt_write_cstr(fd, line_file);
                    bt_write_cstr(fd, (u8*)":");
                    bt_write_dec(fd, line_num);
                } else {
                    bt_write_cstr(fd, (u8*)" at ");
                    bt_write_cstr(fd, e.file);
                    bt_write_cstr(fd, (u8*)":");
                    bt_write_dec(fd, e.line);
                }
                bt_write_cstr(fd, (u8*)" (");
                bt_write_hex(fd, ret_addr);
                bt_write_cstr(fd, (u8*)")
");
                bt_print_args(fd, callee_rbp, e.addr);
            } else {
                bt_write_cstr(fd, (u8*)"  <unknown> (");
                bt_write_hex(fd, ret_addr);
                bt_write_cstr(fd, (u8*)")
");
            }
            printed = printed + 1;
        }
        if (callee_rbp <= rbp) {
            break;
        }
        rbp = callee_rbp;
        frame = frame + 1;
    }
}

// x64 CONTEXT offsets (byte) used by the Windows walker.
// Rsp = 0x98, Rbp = 0xa0, Rip = 0xf8; sizeof(CONTEXT) = 0x4d0 (1232).
const i64 CTX_RSP = 0x98;
const i64 CTX_RIP = 0xf8;
const i64 CTX_SIZE = 0x4d0;

#[cfg(os.windows)]
extern "C" {
    #[link_name("RtlCaptureContext")]
    void win_RtlCaptureContext(void* ctx);
    #[link_name("RtlLookupFunctionEntry")]
    void* win_RtlLookupFunctionEntry(u64 control_pc, u64* image_base, void* history_table);
    #[link_name("RtlVirtualUnwind")]
    void win_RtlVirtualUnwind(u32 handler_type, u64 image_base, u64 control_pc, void* fn_entry, void* ctx, void** handler_data, u64* establisher_frame, void* context_pointers);
}

#[cfg(os.windows)]
i64 ctx_get_rip(u8* ctx) {
    i64* q = (i64*)ctx;
    return q[CTX_RIP / 8];
}

#[cfg(os.windows)]
void silver_print_backtrace(i64 skip) {
    i64 fd = 2;
    bt_write_cstr(fd, (u8*)"backtrace:
");
    // CONTEXT (1232 bytes) must be 16-byte aligned; over-allocate and mask.
    u8 ctxbuf[1248];
    i64 ctx_addr = (((i64)&ctxbuf[0]) + 15) & -16;
    u8* ctx = (u8*)ctx_addr;
    i64 zi = 0;
    while (zi < CTX_SIZE) {
        ctx[zi] = 0;
        zi += 1;
    }
    win_RtlCaptureContext(ctx);

    i64 frame = 0;
    i64 printed = 0;
    i64 rip = ctx_get_rip(ctx);
    while (rip != 0 && printed < 24) {
        // Resolve this frame's function and unwind it: RtlVirtualUnwind
        // updates the context in place to the caller and reports the
        // unwind function's established frame pointer, which — with
        // frame-pointer=all — is exactly the rebased rbp the args table's
        // fbreg offsets are relative to.
        u64 imgbase = 0;
        void* fn_entry = win_RtlLookupFunctionEntry((u64)rip, &imgbase, (void*)0);
        i64 establisher = 0;
        if (fn_entry == (void*)0) {
            // Leaf frame without unwind info: the return address into its
            // caller sits at [rsp]. Print the leaf's own address, advance
            // Rsp past the return-address slot, and continue with the
            // caller's identity (there is no established frame pointer, so
            // no args are recoverable for this frame).
            i64* rsp_q = (i64*)(ctx + CTX_RSP);
            i64 rsp_val = *rsp_q;
            i64* ret_ptr = (i64*)rsp_val;
            i64 ret = *ret_ptr;
            if (ret == 0) {
                break;
            }
            if (frame >= skip) {
                i64 idx = bt_resolve(rip);
                bt_write_cstr(fd, (u8*)"  #");
                bt_write_dec(fd, printed);
                if (idx >= 0) {
                    bt_write_cstr(fd, (u8*)"  ");
                    BtEntry e = __silver_bt_entries[idx];
                    bt_write_cstr(fd, e.name);
                } else {
                    bt_write_cstr(fd, (u8*)"  <unknown>");
                }
                bt_write_cstr(fd, (u8*)" (");
                bt_write_hex(fd, rip);
                bt_write_cstr(fd, (u8*)")
");
                printed = printed + 1;
            }
            *rsp_q = rsp_val + 8;
            rip = ret;
            frame = frame + 1;
            continue;
        }
        void* handler_data = (void*)0;
        u64 establisher_frame = 0;
        win_RtlVirtualUnwind(0, imgbase, (u64)rip, fn_entry, ctx, &handler_data, &establisher_frame, (void*)0);
        // The Windows DWARF emits fbreg relative to the CFA, which equals
        // the caller's rsp restored by the unwind (post-unwind Rsp).
        i64* rsp_q = (i64*)ctx;
        establisher = rsp_q[CTX_RSP / 8];

        if (frame >= skip) {
            i64 idx = bt_resolve(rip);
            bt_write_cstr(fd, (u8*)"  #");
            bt_write_dec(fd, printed);
            if (idx >= 0) {
                bt_write_cstr(fd, (u8*)"  ");
                BtEntry e = __silver_bt_entries[idx];
                bt_write_cstr(fd, e.name);
                u8* line_file = (u8*)0;
                i64 line_num = 0;
                bt_line_lookup(e.addr, rip, &line_file, &line_num);
                if (line_num > 0 && line_file != (u8*)0) {
                    bt_write_cstr(fd, (u8*)" at ");
                    bt_write_cstr(fd, line_file);
                    bt_write_cstr(fd, (u8*)":");
                    bt_write_dec(fd, line_num);
                } else {
                    bt_write_cstr(fd, (u8*)" at ");
                    bt_write_cstr(fd, e.file);
                    bt_write_cstr(fd, (u8*)":");
                    bt_write_dec(fd, e.line);
                }
                bt_write_cstr(fd, (u8*)" (");
                bt_write_hex(fd, rip);
                bt_write_cstr(fd, (u8*)")
");
                bt_print_args(fd, establisher, e.addr);
            } else {
                bt_write_cstr(fd, (u8*)"  <unknown> (");
                bt_write_hex(fd, rip);
                bt_write_cstr(fd, (u8*)")
");
            }
            printed = printed + 1;
        }
        // The context now describes the caller; its Rip is the next
        // frame's return address. The chain ends when the unwinder reports
        // zero (no more unwind info) or the entry frame.
        rip = ctx_get_rip(ctx);
        if (rip == 0) {
            break;
        }
        frame = frame + 1;
    }
}

