/// A view into a contiguous sequence of elements.
///
/// `Slice<T>` represents a non-owning reference to a contiguous sequence of elements in memory,
/// defined by a pointer to the start of the data and a length. It replaces raw `T* + len` pairs
/// across the standard library and is the primary borrow type for contiguous data.

import std.ops;
import std.optional;
import std.iter;
import std.io.file;
import std.mem.alloc;
import std.mem.memory;

/// A view into a contiguous sequence of elements.
struct Slice<T> {
    T* data;
    i64 len;
}

/// Indexed access implementation for Slice.
impl<T> IndexedAccess for Slice<T> {
    type Item = T;

    /// Returns the element at `index`, aborting if out of bounds.
    T __index_get(*self, i64 index) {
        if (@cfg(debug) && (index < 0 || index >= self.len)) {
            STDOUT.write_str("Slice index out of bounds: ");
            STDOUT.write_i64(index);
            STDOUT.write_str(" (len: ");
            STDOUT.write_i64(self.len);
            STDOUT.write_str(")\n");
            abort();
        }
        return self.data[index];
    }

    /// Sets the element at `index` to `value`, aborting if out of bounds.
    void __index_set(*self, i64 index, T value) {
        if (@cfg(debug) && (index < 0 || index >= self.len)) {
            STDOUT.write_str("Slice index out of bounds: ");
            STDOUT.write_i64(index);
            STDOUT.write_str(" (len: ");
            STDOUT.write_i64(self.len);
            STDOUT.write_str(")\n");
            abort();
        }
        self.data[index] = move value;
    }
}

impl<T> Slice<T> {
    /// Create a slice from raw pointer and length.
    Slice<T> from_raw(T* data, i64 len) {
        Slice<T> s;
        s.data = data;
        s.len = len;
        return s;
    }

    /// Returns the length of the slice.
    i64 len(&self) { return self.len; }

    /// Returns true if the slice is empty.
    bool is_empty(&self) { return self.len == 0; }

    /// Returns a pointer to the slice's underlying data.
    T* as_ptr(&self) { return self.data; }

    /// Returns a mutable pointer to the slice's underlying data.
    T* as_mut_ptr(&mut self) { return self.data; }

    /// Returns a sub-slice from `start` with length `n`.
    Slice<T> sub_slice(&self, i64 start, i64 n) {
        if (start < 0 || n < 0 || start + n > self.len) { abort(); }
        Slice<T> s;
        if (n == 0) {
            s.data = (T*)0;
            s.len = 0;
            return s;
        }
        if (self.data == (T*)0) { abort(); }
        s.data = &self.data[start];
        s.len = n;
        return s;
    }

    /// Splits the slice at `mid`, returning (left, right).
    Slice<T> split_at(&self, i64 mid) {
        if (mid < 0 || mid > self.len) { abort(); }
        return self.sub_slice(0, mid);
    }

    /// Returns a sub-slice spanning [start, end) with Python-style negative index clamping.
    Slice<T> __slice_get(&self, i64 start, i64 end) {
        if (start < 0) {
            start = self.len + start;
            if (start < 0) { start = 0; }
        }
        if (end < 0) {
            end = self.len + end;
            if (end < 0) { end = 0; }
        }
        if (start > self.len) { start = self.len; }
        if (end > self.len) { end = self.len; }
        if (end < start) { end = start; }
        return self.sub_slice(start, end - start);
    }

    /// Returns the first element, or None if empty.
    T first(&self) {
        if (self.len == 0) { abort(); }
        return self.data[0];
    }

    /// Returns the last element, or None if empty.
    T last(&self) {
        if (self.len == 0) { abort(); }
        return self.data[self.len - 1];
    }

    /// Returns an iterator over the slice.
    SliceIter<T> iter(&self) {
        SliceIter<T> it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        return it;
    }

    /// Returns an iterator starting from `start`.
    SliceIter<T> iter_from(&self, i64 start) {
        if (start < 0 || start > self.len) { abort(); }
        SliceIter<T> it;
        it.data = self.data;
        it.len = self.len;
        it.idx = start;
        return it;
    }

    /// Returns pointer to element at index, aborting if out of bounds.
    T* get_ptr(&self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return &self.data[index];
    }

    /// Returns element at index wrapped in Optional, or None if out of bounds.
    T get(&self, i64 index) {
        if (index < 0 || index >= self.len) { abort(); }
        return self.data[index];
    }

    /// Reverse slice in-place.
    void reverse(&mut self) {
        if (self.data == (T*)0 || self.len <= 1) { return; }
        i64 i = 0;
        i64 j = self.len - 1;
        while (i < j) {
            T tmp = self.data[i];
            T val_j = self.data[j];
            self.data[i] = move val_j;
            self.data[j] = move tmp;
            i = i + 1;
            j = j - 1;
        }
    }

    /// Returns a reverse iterator over the slice.
    RevIter<T> rev_iter(&self) {
        RevIter<T> r;
        r.data = self.data;
        r.len = self.len;
        r.idx = 0;
        return r;
    }
}

struct SliceIter<T> {
    T* data;
    i64 len;
    i64 idx;
}

impl<T> Iterator for SliceIter<T> {
    type Item = T;
    Optional<T> next(*self) {
        if (self.idx < self.len) {
            T v = self.data[self.idx];
            self.idx = self.idx + 1;
            return Some(v);
        }
        return None;
    }
}

impl<T> IntoIterator for Slice<T> {
    type Item = T;
    type IntoIter = SliceIter<T>;
    SliceIter<T> into_iter(self) {
        SliceIter<T> it;
        it.data = self.data;
        it.len = self.len;
        it.idx = 0;
        return it;
    }
}

impl<T> SliceIter<T> {
    i64 count(*self) {
        i64 c = 0;
        while (true) {
            Optional<T> o = self.next();
            if (o.is_none()) { break; }
            c = c + 1;
        }
        return c;
    }
}

impl Slice<u8> {
    /// Returns true if this byte slice equals a null-terminated C-string `text`.
    bool equals_str(&self, str text) {
        if (text == (str)0) { return self.len == 0; }
        i64 tlen = strlen(text);
        if (self.len != tlen) { return false; }
        if (self.len == 0) { return true; }
        return memcmp((const void*)self.data, (const void*)text, tlen) == 0;
    }

    /// Returns true if this byte slice equals another byte slice `other`.
    bool equals_slice(&self, Slice<u8> other) {
        if (self.len != other.len) { return false; }
        if (self.len == 0) { return true; }
        return memcmp((const void*)self.data, (const void*)other.data, self.len) == 0;
    }

    /// Equality operator against string literal / C-string.
    bool __eq(&self, str other) {
        return self.equals_str(other);
    }

    /// Inequality operator against string literal / C-string.
    bool __ne(&self, str other) {
        return !self.__eq(other);
    }

    /// Equality operator against another Slice<u8>.
    bool __eq(&self, Slice<u8> other) {
        return self.equals_slice(other);
    }

    /// Inequality operator against another Slice<u8>.
    bool __ne(&self, Slice<u8> other) {
        return !self.__eq(other);
    }

    /// Returns true if this slice starts with the C-string `prefix`.
    bool starts_with(&self, str prefix) {
        if (prefix == (str)0) { return false; }
        i64 plen = strlen(prefix);
        if (plen == 0) { return true; }
        if (self.len < plen) { return false; }
        return memcmp((const void*)self.data, (const void*)prefix, plen) == 0;
    }

    /// Returns true if this slice starts with the byte slice `prefix`.
    bool starts_with_slice(&self, Slice<u8> prefix) {
        if (prefix.len == 0) { return true; }
        if (self.len < prefix.len) { return false; }
        return memcmp((const void*)self.data, (const void*)prefix.data, prefix.len) == 0;
    }

    /// Returns true if this slice ends with the C-string `suffix`.
    bool ends_with(&self, str suffix) {
        if (suffix == (str)0) { return false; }
        i64 slen = strlen(suffix);
        if (slen == 0) { return true; }
        if (self.len < slen) { return false; }
        return memcmp((const void*)&self.data[self.len - slen], (const void*)suffix, slen) == 0;
    }

    /// Returns true if this slice ends with the byte slice `suffix`.
    bool ends_with_slice(&self, Slice<u8> suffix) {
        if (suffix.len == 0) { return true; }
        if (self.len < suffix.len) { return false; }
        return memcmp((const void*)&self.data[self.len - suffix.len], (const void*)suffix.data, suffix.len) == 0;
    }

    /// Returns the first index of byte `b`, or -1 if not found.
    i64 find_byte(&self, u8 b) {
        i64 i = 0;
        while (i < self.len) {
            if (self.data[i] == b) { return i; }
            i = i + 1;
        }
        return -1;
    }

    /// Returns the first index of the substring `needle`, or -1 if not found.
    i64 find(&self, str needle) {
        if (needle == (str)0) { return -1; }
        i64 nlen = strlen(needle);
        if (nlen == 0) { return 0; }
        if (self.len < nlen) { return -1; }
        i64 limit = self.len - nlen;
        i64 i = 0;
        while (i <= limit) {
            if (memcmp((const void*)&self.data[i], (const void*)needle, nlen) == 0) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /// Returns the first index of byte slice `needle`, or -1 if not found.
    i64 find_slice(&self, Slice<u8> needle) {
        if (needle.len == 0) { return 0; }
        if (self.len < needle.len) { return -1; }
        i64 limit = self.len - needle.len;
        i64 i = 0;
        while (i <= limit) {
            if (memcmp((const void*)&self.data[i], (const void*)needle.data, needle.len) == 0) {
                return i;
            }
            i = i + 1;
        }
        return -1;
    }

    /// Returns true if this slice contains substring `needle`.
    bool contains(&self, str needle) {
        return self.find(needle) >= 0;
    }

    /// Returns true if this slice contains byte slice `needle`.
    bool contains_slice(&self, Slice<u8> needle) {
        return self.find_slice(needle) >= 0;
    }

    /// Strips leading whitespace (spaces, tabs, newlines, CRs).
    Slice<u8> trim_start(&self) {
        i64 start = 0;
        while (start < self.len) {
            u8 b = self.data[start];
            if (b != (u8)' ' && b != (u8)'\t' && b != (u8)'\n' && b != (u8)'\r') {
                break;
            }
            start = start + 1;
        }
        return self.sub_slice(start, self.len - start);
    }

    /// Strips trailing whitespace (spaces, tabs, newlines, CRs).
    Slice<u8> trim_end(&self) {
        i64 end = self.len;
        while (end > 0) {
            u8 b = self.data[end - 1];
            if (b != (u8)' ' && b != (u8)'\t' && b != (u8)'\n' && b != (u8)'\r') {
                break;
            }
            end = end - 1;
        }
        return self.sub_slice(0, end);
    }

    /// Strips both leading and trailing whitespace.
    Slice<u8> trim(&self) {
        return self.trim_start().trim_end();
    }

    /// Splits slice at the first occurrence of string `delimiter`.
    Optional<[Slice<u8>, Slice<u8>]> split_once(&self, str delimiter) {
        i64 idx = self.find(delimiter);
        if (idx < 0) { return None; }
        i64 dlen = strlen(delimiter);
        Slice<u8> first = self.sub_slice(0, idx);
        Slice<u8> second = self.sub_slice(idx + dlen, self.len - (idx + dlen));
        return Some([first, second]);
    }

    /// Splits slice at the first occurrence of byte `delimiter`.
    Optional<[Slice<u8>, Slice<u8>]> split_once_byte(&self, u8 delimiter) {
        i64 idx = self.find_byte(delimiter);
        if (idx < 0) { return None; }
        Slice<u8> first = self.sub_slice(0, idx);
        Slice<u8> second = self.sub_slice(idx + 1, self.len - (idx + 1));
        return Some([first, second]);
    }

    /// Splits slice at the first occurrence of slice `delimiter`.
    Optional<[Slice<u8>, Slice<u8>]> split_once_slice(&self, Slice<u8> delimiter) {
        i64 idx = self.find_slice(delimiter);
        if (idx < 0) { return None; }
        Slice<u8> first = self.sub_slice(0, idx);
        Slice<u8> second = self.sub_slice(idx + delimiter.len, self.len - (idx + delimiter.len));
        return Some([first, second]);
    }

    /// Parses non-null-terminated ASCII integer with optional leading +/- and whitespace.
    Optional<i64> parse_i64(&self) {
        if (self.len == 0) { return None; }
        i64 i = 0;
        while (i < self.len && (self.data[i] == (u8)' ' || self.data[i] == (u8)'\t')) {
            i = i + 1;
        }
        if (i == self.len) { return None; }
        bool negative = false;
        if (self.data[i] == (u8)'-') {
            negative = true;
            i = i + 1;
        } else if (self.data[i] == (u8)'+') {
            i = i + 1;
        }
        if (i == self.len) { return None; }
        i64 val = 0;
        i64 digits = 0;
        while (i < self.len) {
            u8 c = self.data[i];
            if (c >= (u8)'0' && c <= (u8)'9') {
                val = val * 10 + (i64)(c - (u8)'0');
                digits = digits + 1;
                i = i + 1;
            } else {
                break;
            }
        }
        while (i < self.len && (self.data[i] == (u8)' ' || self.data[i] == (u8)'\t' || self.data[i] == (u8)'\r' || self.data[i] == (u8)'\n')) {
            i = i + 1;
        }
        if (digits == 0 || i != self.len) {
            return None;
        }
        if (negative) {
            val = -val;
        }
        return Some(val);
    }
}

