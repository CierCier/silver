// std/net/http.ag — HTTP/1.0 and HTTP/1.1 client modeled after Go's net/http.
//
// The familiar surface is HttpClient.Get/Post/Head/Do with HttpRequest.new
// (Go's NewRequest), automatic redirect following (301/302/303 rewrite to
// GET, 307/308 preserve), and a Response with status, reason, get_header,
// and status_text. The lower layer (HttpConnection, request/response framing)
// stays exposed for callers that need explicit connection reuse.
import std.error;
import std.fmt;
import std.mem.drop;
import std.mem.vec;
import std.net.cookie;
import std.net.dns;
import std.net.http_status;
import std.net.inet;
import std.net.tcp;
import std.net.transport;
import std.string;
import std.sync;
import std.sys.result;

const i64 HTTP_ERR_IO = -1;
const i64 HTTP_ERR_MALFORMED = -2;
const i64 HTTP_ERR_LIMIT = -3;
const i64 HTTP_ERR_CONNECT = -4;
const i64 HTTP_ERR_DNS = -5;
const i64 HTTP_ERR_REDIRECT = -6;

const i64 HTTP_DEFAULT_MAX_HEADER = 65536;
const i64 HTTP_DEFAULT_MAX_BODY = 16777216;
const i64 HTTP_CHUNK_LINE_MAX = 8192;
const i32 HTTP_DEFAULT_MAX_REDIRECTS = 10;

enum HttpVersion {
    Http10 = 10;
    Http11 = 11;
}

struct HttpRequest {
    HttpVersion version;
    str method;
    str target;
    str host;
    String headers;
    str body;
    bool close;
    str url; // full URL for Go-style requests; null for manual requests
}

struct HttpResponse {
    HttpVersion version;
    i32 status;
    String reason;
    String headers;
    String body;
    i64 content_length;
    bool chunked;
    bool close_delimited;
}

struct HttpClient {
    i64 max_header_bytes;
    i64 max_body_bytes;
    i32 max_redirects;
    bool use_jar; // false = manual Cookie header handling, like Go's nil Jar
    CookieJar jar;
    bool tls_verify; // true = verify peer certificates (Go's default)
    String tls_ca_file; // optional CA bundle; empty = system trust store
    bool use_pool; // keep-alive connection reuse (Go's Transport pooling)
    ConnectionPool pool;
}

struct HttpConnection {
    TcpStream stream;
    u8 tls_state[64]; // opaque TLS transport state (TRANSPORT_TLS_STATE_SIZE)
    bool use_tls;
    HttpVersion version;
}

impl Drop<HttpConnection> for HttpConnection {
    void drop(HttpConnection* self) {
        self.close();
    }
}

// --- Connection pooling (Go's Transport keep-alive pool) ------------------

struct PoolEntry {
    HttpConnection conn;
    u8 host[255];
    u16 port;
    bool https;
    i64 last_used; // unix seconds at release time
}

struct ConnectionPool {
    Vec<PoolEntry> entries;
    RawMutex lock;
    i32 max_idle; // Go's MaxIdleConnsPerHost
}

impl ConnectionPool {
    ConnectionPool new() {
        ConnectionPool pool;
        pool.entries = Vec<PoolEntry>.new();
        pool.lock = RawMutex.new();
        pool.max_idle = 2;
        return pool;
    }
}

impl Drop<ConnectionPool> for ConnectionPool {
    void drop(ConnectionPool* self) {
        i64 i = 0;
        while (i < self.entries.len) {
            PoolEntry e = self.entries.take(i);
            e.conn.close();
            i = i + 1;
        }
        self.entries.len = 0;
        self.entries.drop();
    }
}

/// Remove entry `index` from the pool, returning it. Vec.take leaves the
/// slot in place (len unchanged), so this swaps the last entry into the hole
/// and shrinks len.
PoolEntry http_pool_remove_at(Vec<PoolEntry>* entries, i64 index) {
    i64 last = entries.len - 1;
    PoolEntry entry = entries.data[index];
    if (index != last) {
        entries.data[index] = entries.data[last];
    }
    entries.len = last;
    return entry;
}

bool http_host_eq(str a, str b) {
    u8* pa = (u8*)a;
    u8* pb = (u8*)b;
    i64 i = 0;
    while (true) {
        if (pa[i] != pb[i]) { return false; }
        if (pa[i] == (u8)0) { return true; }
        i = i + 1;
    }
    // Unreachable — the loop above only exits via `return`.
    return false;
}

struct HttpUrl {
    u8 host[255];
    u16 port;
    str path;
    bool https;
}

// --- Byte helpers ---------------------------------------------------------
// Shared byte utilities (http_is_space, http_is_digit, http_lower,
// http_equal_ci, http_parse_i64, http_append_i64) live in std/net/cookie.ag
// so the low-level helpers have a single definition point.

/// Index of the first CRLF at or after `start`, or -1 when none exists.
i64 http_find_crlf(u8* data, i64 len, i64 start) {
    i64 i = start;
    while (i + 1 < len) {
        if (data[i] == (u8)'\r' && data[i + 1] == (u8)'\n') { return i; }
        i = i + 1;
    }
    return -1;
}

/// Parse the hexadecimal integer in `data[start..end]`, allowing surrounding
/// whitespace. Returns false when the range is not a valid integer.
bool http_parse_hex(u8* data, i64 start, i64 end, i64* out) {
    i64 i = start;
    while (i < end && http_is_space(data[i])) { i = i + 1; }
    i64 value = 0;
    i64 digits = 0;
    while (i < end) {
        u8 ch = data[i];
        i64 digit = -1;
        if (ch >= (u8)'0' && ch <= (u8)'9') { digit = (i64)(ch - (u8)'0'); }
        else if (ch >= (u8)'A' && ch <= (u8)'F') { digit = (i64)(ch - (u8)'A') + 10; }
        else if (ch >= (u8)'a' && ch <= (u8)'f') { digit = (i64)(ch - (u8)'a') + 10; }
        else { break; }
        value = value * 16 + digit;
        digits = digits + 1;
        i = i + 1;
    }
    while (i < end && http_is_space(data[i])) { i = i + 1; }
    if (digits == 0 || i != end) { return false; }
    *out = value;
    return true;
}


/// Split "http://host[:port]/path" or "https://host[:port]/path" into
/// host, port, path, and scheme. The scheme is optional and must be plain
/// http or https (https defaults to port 443). `path` is a view into `url`,
/// which must therefore outlive the parsed value.
bool http_parse_url(str url, HttpUrl* out) {
    u8* p = (u8*)url;
    i64 len = strlen(url);
    i64 i = 0;
    bool https = false;
    if (len >= 8 && http_equal_ci(p, 0, 8, "https://")) { https = true; i = 8; }
    else if (len >= 7 && http_equal_ci(p, 0, 7, "http://")) { i = 7; }
    else { return false; }
    i64 host_start = i;
    while (i < len && p[i] != (u8)':' && p[i] != (u8)'/') { i = i + 1; }
    i64 host_len = i - host_start;
    if (host_len == 0 || host_len >= 255) { return false; }
    i64 j = 0;
    while (j < host_len) { out.host[j] = p[host_start + j]; j = j + 1; }
    out.host[j] = (u8)0;
    u16 port = 80;
    if (https) { port = 443; }
    if (i < len && p[i] == (u8)':') {
        i = i + 1;
        i64 port_start = i;
        while (i < len && p[i] != (u8)'/') { i = i + 1; }
        i64 port_value = 0;
        if (port_start == i || !http_parse_i64(p, port_start, i, &port_value)
            || port_value <= 0 || port_value > 65535) {
            return false;
        }
        port = (u16)port_value;
    }
    out.port = port;
    out.https = https;
    out.path = (str)&p[i];
    if (strlen(out.path) == 0) { out.path = "/"; }
    return true;
}

/// Resolve `location` against the absolute `base` URL (Go's
/// Reference.ResolveReference for the common cases): absolute http/https
/// URLs pass through, "//host/path" reuses the base scheme, "/path" reuses
/// the base authority. Path-relative locations are not resolvable here and
/// yield an empty string (callers then return the response instead of
/// following).
String http_resolve_url(str base, str location) {
    String result = String.new();
    u8* loc = (u8*)location;
    i64 loc_len = strlen(location);
    if ((loc_len >= 8 && http_equal_ci(loc, 0, 8, "https://"))
        || (loc_len >= 7 && http_equal_ci(loc, 0, 7, "http://"))) {
        result.push_str(location);
        return move result;
    }
    u8* b = (u8*)base;
    i64 base_len = strlen(base);
    i64 scheme_len = 0;
    if (base_len >= 8 && http_equal_ci(b, 0, 8, "https://")) { scheme_len = 8; }
    else if (base_len >= 7 && http_equal_ci(b, 0, 7, "http://")) { scheme_len = 7; }
    else { return move result; }
    if (loc_len >= 2 && loc[0] == (u8)'/' && loc[1] == (u8)'/') {
        i64 s = 0;
        while (s < scheme_len - 3) { result.push(b[s]); s = s + 1; }
        result.push_str(location);
        return move result;
    }
    if (loc_len >= 1 && loc[0] == (u8)'/') {
        i64 i = scheme_len;
        while (i < base_len && b[i] != (u8)'/') { i = i + 1; }
        i64 s = 0;
        while (s < i) { result.push(b[s]); s = s + 1; }
        result.push_str(location);
        return move result;
    }
    return move result;
}

/// Resolve `host` (IP literal or DNS name) and open a fresh connection.
Result<HttpConnection, Error> http_open(str host, u16 port) {
    u32 ip4 = 0;
    i32 ip = 0;
    if (inet_pton4(host, &ip4)) { ip = (i32)ip4; }
    else { ip = dns_resolve(host); }
    if (ip == 0) {
        return Result<HttpConnection, Error>.Err(Error.new(HTTP_ERR_DNS, "DNS resolution failed"));
    }
    Result<SocketAddr, AddrError> addr_result = SocketAddr.v4_network((u32)ip, port);
    if (addr_result.failed()) {
        return Result<HttpConnection, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed address"));
    }
    SocketAddr addr = addr_result.unwrap();
    TcpStream stream = TcpStream.connect(&addr);
    if (stream.invalid()) {
        return Result<HttpConnection, Error>.Err(Error.new(HTTP_ERR_CONNECT, "connection failed"));
    }
    HttpConnection connection;
    connection.stream = move stream;
    connection.use_tls = false;
    connection.version = HttpVersion.Http11;
    return Result<HttpConnection, Error>.Ok(move connection);
}

/// Read one CRLF-terminated line into `line`, excluding the CRLF itself.
/// Returns false on EOF, read error, or when the line exceeds `max_len`.
bool http_read_line(StreamIo* io, String* line, i64 max_len) {
    line.clear();
    u8 byte[1];
    while (true) {
        Result<i64, Error> r = transport_read(io, &byte[0], 1);
        if (r.is_err() || r.value() == 0) { return false; }
        line.push(byte[0]);
        if (line.ends_with("\r\n")) {
            line.len = line.len - 2;
            line.data[line.len] = (u8)0;
            return true;
        }
        if (line.len > max_len) { return false; }
    }
    // Unreachable — the loop above only exits via `return`.
    return false;
}

// --- Requests -------------------------------------------------------------

impl HttpRequest {
    /// Go's http.NewRequest: full URL, default HTTP/1.1, body optional.
    /// The URL is parsed when the request is sent via HttpClient.do.
    HttpRequest new(str method, str url, str body) {
        HttpRequest request;
        request.version = HttpVersion.Http11;
        request.method = method;
        request.url = url;
        request.target = (str)0;
        request.host = (str)0;
        request.headers = String.new();
        request.body = body;
        request.close = true;
        return move request;
    }

    /// Manual request: explicit version, request target, and Host header.
    /// Sent via HttpClient.do with a fresh connection to port 80.
    HttpRequest new(HttpVersion version, str method, str target, str host) {
        HttpRequest request;
        request.version = version;
        request.method = method;
        request.target = target;
        request.host = host;
        request.headers = String.new();
        request.body = (str)0;
        request.close = true;
        request.url = (str)0;
        return move request;
    }

    void header(&mut HttpRequest self, str name, str value) {
        self.headers.push_str(name);
        self.headers.push_str(": ");
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    void set_body(&mut HttpRequest self, str body) {
        self.body = body;
    }

    /// Go's Request.AddCookie: merge `name=value` into the existing Cookie
    /// header line, or append a new Cookie header when none is set.
    void add_cookie(&mut HttpRequest self, str name, str value) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end && http_equal_ci(data, pos, colon, "cookie")) {
                String head = self.headers.substr(0, end);
                String tail = self.headers.substr(end, len - end);
                String updated = String.new();
                updated.push_str((str)head.data);
                updated.push_str("; ");
                updated.push_str(name);
                updated.push((u8)'=');
                updated.push_str(value);
                updated.push_str((str)tail.data);
                self.headers.drop();
                self.headers = move updated;
                return;
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        self.headers.push_str("Cookie: ");
        self.headers.push_str(name);
        self.headers.push((u8)'=');
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    void keep_alive(&mut HttpRequest self) {
        self.close = false;
    }

    Result<i64, Error> write(HttpRequest* self, StreamIo* io) {
        String head = String.new();
        head.push_str(self.method);
        head.push((u8)' ');
        head.push_str(self.target);
        head.push_str(" HTTP/");
        if (self.version == HttpVersion.Http10) { head.push_str("1.0"); }
        else { head.push_str("1.1"); }
        head.push_str("\r\nHost: ");
        head.push_str(self.host);
        head.push_str("\r\n");
        if (self.body != (str)0) {
            head.push_str("Content-Length: ");
            http_append_i64(&mut head, strlen(self.body));
            head.push_str("\r\n");
        }
        if (self.close) { head.push_str("Connection: close\r\n"); }
        head.push_str((str)self.headers.data);
        head.push_str("\r\n");
        Result<i64, Error> written = transport_write(io, (u8*)head.data, head.len);
        if (written.is_err()) { return written; }
        if (self.body != (str)0 && strlen(self.body) > 0) {
            return transport_write(io, (u8*)self.body, strlen(self.body));
        }
        return Result<i64, Error>.Ok(written.value());
    }
}

impl Drop<HttpRequest> for HttpRequest {
    void drop(HttpRequest* self) {
        self.headers.drop();
    }
}

// --- Responses ------------------------------------------------------------

impl HttpResponse {
    HttpResponse empty() {
        HttpResponse response;
        response.version = HttpVersion.Http11;
        response.status = 0;
        response.reason = String.new();
        response.headers = String.new();
        response.body = String.new();
        response.content_length = -1;
        response.chunked = false;
        response.close_delimited = false;
        return move response;
    }

    Result<i64, Error> read_head(HttpResponse* self, StreamIo* io, i64 max_header) {
        String raw = String.new();
        u8 byte[1];
        while (true) {
            Result<i64, Error> r = transport_read(io, &byte[0], 1);
            if (r.is_err()) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error")); }
            if (r.value() == 0) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response")); }
            raw.push(byte[0]);
            if (raw.len > max_header) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_LIMIT, "response exceeds size limit")); }
            if (raw.ends_with("\r\n\r\n")) { break; }
        }

        // Status line: "HTTP/1.x <3-digit status>[ reason]".
        i64 line_end = raw.find("\r\n");
        if (line_end < 0) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response")); }
        String status_line = raw.substr(0, line_end);
        String version = status_line.substr(5, 3);
        if (version.equals("1.0")) { self.version = HttpVersion.Http10; }
        else if (version.equals("1.1")) { self.version = HttpVersion.Http11; }
        else { return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response")); }
        if (status_line.len < 12 || status_line[8] != (u8)' ') {
            return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
        }
        if (!http_is_digit(status_line[9]) || !http_is_digit(status_line[10])
            || !http_is_digit(status_line[11])) {
            return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
        }
        self.status = (i32)((i64)(status_line[9] - (u8)'0') * 100
            + (i64)(status_line[10] - (u8)'0') * 10
            + (i64)(status_line[11] - (u8)'0'));
        self.reason.drop();
        self.reason = String.new();
        if (status_line.len > 12 && status_line[12] == (u8)' ') {
            self.reason = status_line.substr(13, status_line.len - 13);
        }

        // Headers: CRLF-terminated lines up to the blank line.
        u8* data = raw.data;
        i64 header_start = line_end + 2;
        i64 header_end = raw.len - 2;
        while (header_start < header_end) {
            i64 end = http_find_crlf(data, header_end, header_start);
            if (end < 0) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response")); }
            i64 colon = header_start;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon == end || colon == header_start) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response")); }
            i64 value_start = colon + 1;
            while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
            if (http_equal_ci(data, header_start, colon, "content-length")) {
                if (!http_parse_i64(data, value_start, end, &mut self.content_length)) {
                    return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
                }
            } else if (http_equal_ci(data, header_start, colon, "transfer-encoding")) {
                if (http_equal_ci(data, value_start, end, "chunked")) { self.chunked = true; }
            } else if (http_equal_ci(data, header_start, colon, "connection")) {
                if (http_equal_ci(data, value_start, end, "close")) { self.close_delimited = true; }
            }
            header_start = end + 2;
        }
        self.headers = raw.substr(line_end + 2, raw.len - line_end - 2);
        return Result<i64, Error>.Ok(0);
    }

    Result<i64, Error> read_exact(HttpResponse* self, StreamIo* io, i64 count, i64 max_body) {
        if (count < 0 || count > max_body) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_LIMIT, "response exceeds size limit")); }
        i64 done = 0;
        u8 buf[1024];
        while (done < count) {
            i64 want = count - done;
            if (want > 1024) { want = 1024; }
            Result<i64, Error> r = transport_read(io, &buf[0], want);
            if (r.is_err() || r.value() == 0) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error")); }
            i64 i = 0;
            while (i < r.value()) { self.body.push(buf[i]); i = i + 1; }
            done = done + r.value();
        }
        return Result<i64, Error>.Ok(done);
    }

    Result<i64, Error> read_chunked(HttpResponse* self, StreamIo* io, i64 max_body) {
        i64 total = 0;
        String line = String.new();
        u8 byte[1];
        while (true) {
            if (!http_read_line(io, &line, HTTP_CHUNK_LINE_MAX)) {
                return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error"));
            }
            i64 size = 0;
            if (!http_parse_hex(line.data, 0, line.len, &mut size)) {
                return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
            }
            if (size == 0) {
                // Zero-size chunk: consume trailers until the blank line.
                while (true) {
                    if (!http_read_line(io, &line, HTTP_CHUNK_LINE_MAX)) {
                        return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error"));
                    }
                    if (line.len == 0) { return Result<i64, Error>.Ok(total); }
                }
            }
            if (total + size > max_body) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_LIMIT, "response exceeds size limit")); }
            Result<i64, Error> got = self.read_exact(io, size, max_body);
            if (got.is_err()) { return got; }
            Result<i64, Error> crlf = transport_read(io, &byte[0], 1);
            if (crlf.is_err() || crlf.value() != 1 || byte[0] != (u8)'\r') {
                return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
            }
            crlf = transport_read(io, &byte[0], 1);
            if (crlf.is_err() || crlf.value() != 1 || byte[0] != (u8)'\n') {
                return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
            }
            total = total + size;
        }
        // Unreachable — the loop above only exits via `return`.
        return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
    }

    Result<i64, Error> read_body(HttpResponse* self, StreamIo* io, bool head, i64 max_body) {
        if (http_status_has_no_body(self.status, head)) { return Result<i64, Error>.Ok(0); }
        if (self.chunked) { return self.read_chunked(io, max_body); }
        if (self.content_length >= 0) { return self.read_exact(io, self.content_length, max_body); }
        // No framing headers: the body is close-delimited, read until EOF.
        self.close_delimited = true;
        u8 buf[1024];
        i64 total = 0;
        while (true) {
            Result<i64, Error> r = transport_read(io, &buf[0], 1024);
            if (r.is_err()) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error")); }
            if (r.value() == 0) { return Result<i64, Error>.Ok(total); }
            if (total + r.value() > max_body) { return Result<i64, Error>.Err(Error.new(HTTP_ERR_LIMIT, "response exceeds size limit")); }
            i64 i = 0;
            while (i < r.value()) { self.body.push(buf[i]); i = i + 1; }
            total = total + r.value();
        }
        // Unreachable — the loop above only exits via `return`.
        return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error"));
    }

    /// The value of `name` (case-insensitive) in the response headers, or
    /// an empty string when absent. Mirrors Go's Header.Get.
    String get_header(HttpResponse* self, str name) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, name)) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                return self.headers.substr(value_start, end - value_start);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return String.new();
    }

    /// Go's Response.Cookies: every Set-Cookie header, parsed into owned
    /// cookies. The caller owns the vector and its elements (use
    /// http_cookie_vec_drop to discard, or a CookieJar.set_cookies which
    /// consumes them).
    Vec<Cookie> cookies(HttpResponse* self) {
        Vec<Cookie> out = Vec<Cookie>.new();
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, "set-cookie")) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                http_parse_set_cookie_value(data, value_start, end, &mut out);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return out;
    }

    /// "200 OK"-style status text. Mirrors Go's Response.Status.
    String status_text(HttpResponse* self) {
        String text = String.new();
        http_append_i64(&mut text, (i64)self.status);
        text.push((u8)' ');
        text.push_str((str)self.reason.data);
        return move text;
    }

    /// The Location header value (redirect target), or an empty string.
    String location(HttpResponse* self) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, "location")) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                return self.headers.substr(value_start, end - value_start);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return String.new();
    }

    /// Read the head, skipping interim 1xx responses (100 Continue, 102, 103)
    /// until the final response; 101 Switching Protocols is final.
    Result<i64, Error> read_final_head(HttpResponse* self, StreamIo* io, i64 max_header) {
        Result<i64, Error> h = self.read_head(io, max_header);
        if (h.is_err()) { return h; }
        while (http_status_is_informational(self.status)
            && self.status != (i32)HttpStatus.SwitchingProtocols) {
            h = self.read_head(io, max_header);
            if (h.is_err()) { return h; }
        }
        return Result<i64, Error>.Ok(0);
    }

    Result<i64, Error> read(HttpResponse* self, StreamIo* io, bool head, i64 max_header, i64 max_body) {
        Result<i64, Error> h = self.read_final_head(io, max_header);
        if (h.is_err()) { return h; }
        return self.read_body(io, head, max_body);
    }
}

impl Drop<HttpResponse> for HttpResponse {
    void drop(HttpResponse* self) {
        self.reason.drop();
        self.headers.drop();
        self.body.drop();
    }
}

// --- Streaming responses (Go's Response.Body) -----------------------------
// A streamed response carries the head plus an owned connection; read()
// pulls body bytes incrementally, honoring the framing (content-length,
// chunked, close-delimited). close() returns the connection to the client's
// pool when the body was fully consumed and the peer kept it alive.

struct HttpStream {
    HttpResponse head; // status/headers/reason; body stays empty
    HttpConnection conn; // owned; returned to the pool on close
    HttpClient* pool_owner; // null when the client cannot pool
    u8 key_host[255]; // pool key
    u16 key_port;
    bool key_https;
    i64 body_remaining; // content-length remaining (when content_length >= 0)
    String chunk_line; // reusable line buffer for chunked reads
    i64 chunk_remaining;
    bool chunk_want_size;
    bool body_finished;
    bool stream_active;
}

impl HttpStream {
    HttpStream new(HttpResponse head, HttpConnection conn, HttpClient* owner,
                   str host, u16 port, bool https) {
        HttpStream stream;
        stream.head = move head;
        stream.conn = move conn;
        stream.pool_owner = owner;
        u8* src = (u8*)host;
        i64 k = 0;
        while (k < 254 && src[k] != (u8)0) {
            stream.key_host[k] = src[k];
            k = k + 1;
        }
        stream.key_host[k] = (u8)0;
        stream.key_port = port;
        stream.key_https = https;
        stream.body_remaining = stream.head.content_length;
        stream.chunk_line = String.new();
        stream.chunk_remaining = 0;
        stream.chunk_want_size = true;
        stream.body_finished = false;
        stream.stream_active = true;
        return stream;
    }

    i32 status(HttpStream* self) { return self.head.status; }

    /// The value of `name` (case-insensitive) in the response headers, or an
    /// empty string when absent.
    String get_header(HttpStream* self, str name) {
        return self.head.get_header(name);
    }

    /// "200 OK"-style status text.
    String status_text(HttpStream* self) {
        return self.head.status_text();
    }

    /// Read up to `len` body bytes, honoring the response framing. Returns 0
    /// at end of body. The transport is derived from the owned connection on
    /// each call (a self-referential io field would dangle when the stream
    /// value moves).
    Result<i64, Error> read(HttpStream* self, u8* buf, i64 len) {
        if (!self.stream_active) {
            return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "stream is closed"));
        }
        if (self.body_finished) { return Result<i64, Error>.Ok(0); }
        StreamIo io;
        if (self.conn.use_tls) { io = transport_tls_io(&self.conn.tls_state[0]); }
        else { io = transport_tcp_io(&self.conn.stream); }
        if (self.head.chunked) { return self.read_chunked(&io, buf, len); }
        if (self.head.content_length >= 0) {
            i64 want = len;
            if (want > self.body_remaining) { want = self.body_remaining; }
            Result<i64, Error> r = transport_read(&io, buf, want);
            if (r.failed()) { return r; }
            self.body_remaining = self.body_remaining - r.value();
            if (self.body_remaining <= 0) { self.body_finished = true; }
            return r;
        }
        // Close-delimited: read until EOF.
        Result<i64, Error> r = transport_read(&io, buf, len);
        if (r.failed()) { return r; }
        if (r.value() == 0) { self.body_finished = true; }
        return r;
    }

    /// Framing-aware chunked read: parses chunk sizes and CRLF separators as
    /// needed, returning up to `len` body bytes per call.
    Result<i64, Error> read_chunked(HttpStream* self, StreamIo* io, u8* buf, i64 len) {
        while (true) {
            if (self.chunk_want_size) {
                if (!http_read_line(io, &self.chunk_line, HTTP_CHUNK_LINE_MAX)) {
                    return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error"));
                }
                i64 size = 0;
                if (!http_parse_hex(self.chunk_line.data, 0, self.chunk_line.len, &mut size)) {
                    return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
                }
                if (size == 0) {
                    // Zero-size chunk: consume trailers until the blank line.
                    while (true) {
                        if (!http_read_line(io, &self.chunk_line, HTTP_CHUNK_LINE_MAX)) {
                            return Result<i64, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error"));
                        }
                        if (self.chunk_line.len == 0) {
                            self.body_finished = true;
                            return Result<i64, Error>.Ok(0);
                        }
                    }
                }
                self.chunk_remaining = size;
                self.chunk_want_size = false;
            }
            i64 want = len;
            if (want > self.chunk_remaining) { want = self.chunk_remaining; }
            Result<i64, Error> r = transport_read(io, buf, want);
            if (r.failed()) { return r; }
            self.chunk_remaining = self.chunk_remaining - r.value();
            if (self.chunk_remaining == 0) {
                // Consume the CRLF after the chunk.
                u8 byte[2];
                Result<i64, Error> c1 = transport_read(io, &byte[0], 1);
                if (c1.failed() || c1.value() != 1 || byte[0] != (u8)'\r') {
                    return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
                }
                Result<i64, Error> c2 = transport_read(io, &byte[1], 1);
                if (c2.failed() || c2.value() != 1 || byte[1] != (u8)'\n') {
                    return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
                }
                self.chunk_want_size = true;
            }
            return r;
        }
        // Unreachable — the loop above only exits via `return`.
        return Result<i64, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed response"));
    }

    /// Close the stream: return the connection to the pool when the body was
    /// fully consumed and the peer kept it alive, else close it.
    void close(HttpStream* self) {
        if (!self.stream_active) { return; }
        self.stream_active = false;
        if (self.body_finished && !self.head.close_delimited
            && self.pool_owner != (HttpClient*)0 && self.pool_owner.use_pool) {
            HttpConnection pooled = self.conn;
            // Invalidate our copy so the compiler's field drop cannot close
            // the now-pooled fd.
            self.conn.stream.sock.fd = -1;
            self.pool_owner.release((str)&self.key_host[0], self.key_port, self.key_https,
                move pooled);
        } else {
            self.conn.close();
        }
        self.chunk_line.drop();
        self.head.drop();
    }
}

impl Drop<HttpStream> for HttpStream {
    void drop(HttpStream* self) {
        self.close();
    }
}

// --- Client ---------------------------------------------------------------

impl HttpClient {
    HttpClient new() {
        HttpClient client;
        client.max_header_bytes = HTTP_DEFAULT_MAX_HEADER;
        client.max_body_bytes = HTTP_DEFAULT_MAX_BODY;
        client.max_redirects = HTTP_DEFAULT_MAX_REDIRECTS;
        client.use_jar = false;
        client.jar = CookieJar.new();
        client.tls_verify = true;
        client.tls_ca_file = String.new();
        client.use_pool = true;
        client.pool = ConnectionPool.new();
        return move client;
    }

    void limits(&mut HttpClient self, i64 max_header, i64 max_body) {
        self.max_header_bytes = max_header;
        self.max_body_bytes = max_body;
    }

    void set_max_redirects(&mut HttpClient self, i32 limit) {
        self.max_redirects = limit;
    }

    /// Attach a cookie jar (Go's Client.Jar). When set, the client stores
    /// Set-Cookie responses and sends matching cookies on later requests;
    /// without it the Cookie header is never touched (manual mode).
    void set_jar(&mut HttpClient self, CookieJar jar) {
        self.jar.drop();
        self.jar = move jar;
        self.use_jar = true;
    }

    /// Disable peer certificate verification for https connections (Go's
    /// tls.Config.InsecureSkipVerify).
    void set_insecure_skip_verify(&mut HttpClient self) {
        self.tls_verify = false;
    }

    /// Verify https peers against the CA bundle at `path` instead of the
    /// system trust store (Go's tls.Config.RootCAs).
    void set_ca_file(&mut HttpClient self, str path) {
        self.tls_ca_file.drop();
        self.tls_ca_file = String.from_str(path);
    }

    Result<HttpConnection, Error> connect(HttpClient* self, SocketAddr* addr, HttpVersion version) {
        TcpStream stream = TcpStream.connect(addr);
        if (stream.invalid()) { return Result<HttpConnection, Error>.Err(Error.new(HTTP_ERR_CONNECT, "connection failed")); }
        HttpConnection connection;
        connection.stream = move stream;
        connection.use_tls = false;
        connection.version = version;
        return Result<HttpConnection, Error>.Ok(move connection);
    }

    /// Limit on idle keep-alive connections kept per host (Go's
    /// MaxIdleConnsPerHost; default 2).
    void set_pool_max_idle(&mut HttpClient self, i32 limit) {
        self.pool.max_idle = limit;
    }

    /// Complete the TLS handshake on a fresh connection for an https URL.
    bool tls_handshake(HttpClient* self, HttpConnection* conn, str host, Error* err) {
        bool ok = transport_tls_handshake(&conn.tls_state[0], conn.stream.sock.fd, host,
            self.tls_verify, (str)self.tls_ca_file.data, err);
        if (ok) { conn.use_tls = true; }
        return ok;
    }

    /// Take an idle pooled connection for (host, port, https), or open a
    /// fresh one. `reused` is true when the connection came from the pool;
    /// callers retry once on reused connections whose peer closed.
    Result<HttpConnection, Error> acquire(HttpClient* self, str host, u16 port, bool https, bool* reused) {
        *reused = false;
        if (self.use_pool) {
            self.pool.lock.lock();
            i64 best = -1;
            i64 i = 0;
            while (i < self.pool.entries.len) {
                PoolEntry* e = &self.pool.entries.data[i];
                if (e.port == port && e.https == https
                    && http_host_eq((str)&e.host[0], host)) {
                    if (best < 0 || e.last_used > self.pool.entries.data[best].last_used) {
                        best = i;
                    }
                }
                i = i + 1;
            }
            if (best >= 0) {
                PoolEntry entry = http_pool_remove_at(&self.pool.entries, best);
                self.pool.lock.unlock();
                HttpConnection pooled = entry.conn;
                *reused = true;
                return Result<HttpConnection, Error>.Ok(move pooled);
            }
            self.pool.lock.unlock();
        }
        return http_open(host, port);
    }

    /// Return a fully-read, reusable connection to the pool, or close it.
    /// `conn` must have no unread response data.
    void release(HttpClient* self, str host, u16 port, bool https, HttpConnection conn) {
        if (!self.use_pool) {
            conn.close();
            return;
        }
        self.pool.lock.lock();
        if (self.pool.entries.len >= (i64)self.pool.max_idle) {
            // Close the least recently used idle connection.
            i64 oldest = 0;
            i64 i = 1;
            while (i < self.pool.entries.len) {
                if (self.pool.entries.data[i].last_used < self.pool.entries.data[oldest].last_used) {
                    oldest = i;
                }
                i = i + 1;
            }
            PoolEntry evicted = http_pool_remove_at(&self.pool.entries, oldest);
            evicted.conn.close();
        }
        PoolEntry entry;
        entry.conn = move conn;
        u8* src = (u8*)host;
        i64 k = 0;
        while (k < 254 && src[k] != (u8)0) {
            entry.host[k] = src[k];
            k = k + 1;
        }
        entry.host[k] = (u8)0;
        entry.port = port;
        entry.https = https;
        entry.last_used = http_unix_now();
        self.pool.entries.push(move entry);
        self.pool.lock.unlock();
    }

    /// One round trip: parse the URL, resolve the host, connect, send, and
    /// read the response. `body` is the request body and `headers` a raw
    /// CRLF-terminated header block ("Name: value\r\n..."); either may be
    /// null. Honors the client's configured size limits.
    /// One round trip: parse the URL, acquire a connection (pooled or fresh),
    /// send, and read the response. `body` is the request body and `headers`
    /// a raw CRLF-terminated header block ("Name: value\r\n..."); either may
    /// be null. Honors the client's configured size limits. Keep-alive
    /// connections are returned to the pool when the response is fully read
    /// and the peer did not close.
    Result<HttpResponse, Error> request(HttpClient* self, str method, str url, str body, str headers) {
        HttpUrl parsed;
        if (!http_parse_url(url, &parsed)) {
            return Result<HttpResponse, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed URL"));
        }
        str host = (str)&parsed.host[0];
        bool reused = false;
        Result<HttpConnection, Error> opened = self.acquire(host, parsed.port, parsed.https, &mut reused);
        if (opened.failed()) { return Result<HttpResponse, Error>.Err(opened.get_error()); }
        HttpConnection conn = opened.unwrap();
        if (parsed.https && !reused) {
            Error err;
            if (!self.tls_handshake(&conn, host, &mut err)) {
                return Result<HttpResponse, Error>.Err(move err);
            }
        }
        HttpRequest req = HttpRequest.new(HttpVersion.Http11, method, parsed.path, host);
        if (headers != (str)0) { req.headers.push_str(headers); }
        if (body != (str)0) { req.set_body(body); }
        if (self.use_pool) { req.keep_alive(); }
        Result<HttpResponse, Error> r = conn.send(&req, self.max_header_bytes, self.max_body_bytes);
        if (r.failed() && reused) {

            // The pooled connection's peer closed it while idle; discard and
            // retry once on a fresh connection (nothing was sent).
            conn.close();
            bool reused2 = false;
            Result<HttpConnection, Error> reopened = self.acquire(host, parsed.port, parsed.https, &mut reused2);
            if (!reopened.failed()) {
                HttpConnection fresh = reopened.unwrap();
                bool ok = true;
                if (parsed.https) {
                    Error err;
                    ok = self.tls_handshake(&fresh, host, &mut err);
                    if (!ok) {
                        fresh.close();
                        return Result<HttpResponse, Error>.Err(move err);
                    }
                }
                if (ok) {
                    conn = move fresh;

                    r = conn.send(&req, self.max_header_bytes, self.max_body_bytes);
                }
            }
        }
        if (r.failed()) {
            conn.close();
            return Result<HttpResponse, Error>.Err(r.get_error());
        }
        HttpResponse response = r.unwrap();
        if (self.use_pool && !response.close_delimited) {
            self.release(host, parsed.port, parsed.https, move conn);
        } else {
            conn.close();
        }
        return Result<HttpResponse, Error>.Ok(move response);
    }

    /// One streaming round trip: like `request`, but only the response head
    /// is read; the caller streams the body via HttpStream.read() and closes
    /// it (returning the connection to the pool).
    Result<HttpStream, Error> request_stream(HttpClient* self, str method, str url, str body, str headers) {
        HttpUrl parsed;
        if (!http_parse_url(url, &parsed)) {
            return Result<HttpStream, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "malformed URL"));
        }
        str host = (str)&parsed.host[0];
        bool reused = false;
        Result<HttpConnection, Error> opened = self.acquire(host, parsed.port, parsed.https, &mut reused);
        if (opened.failed()) { return Result<HttpStream, Error>.Err(opened.get_error()); }
        HttpConnection conn = opened.unwrap();
        if (parsed.https && !reused) {
            Error err;
            if (!self.tls_handshake(&conn, host, &mut err)) {
                return Result<HttpStream, Error>.Err(move err);
            }
        }
        HttpRequest req = HttpRequest.new(HttpVersion.Http11, method, parsed.path, host);
        if (headers != (str)0) { req.headers.push_str(headers); }
        if (body != (str)0) { req.set_body(body); }
        if (self.use_pool) { req.keep_alive(); }
        Result<HttpResponse, Error> h = conn.send_head(&req, self.max_header_bytes);
        if (h.failed() && reused) {
            // The pooled connection's peer closed it while idle; retry once.
            conn.close();
            bool reused2 = false;
            Result<HttpConnection, Error> reopened = self.acquire(host, parsed.port, parsed.https, &mut reused2);
            if (!reopened.failed()) {
                HttpConnection fresh = reopened.unwrap();
                bool ok = true;
                if (parsed.https) {
                    Error err;
                    ok = self.tls_handshake(&fresh, host, &mut err);
                    if (!ok) {
                        fresh.close();
                        return Result<HttpStream, Error>.Err(move err);
                    }
                }
                if (ok) {
                    conn = move fresh;
                    h = conn.send_head(&req, self.max_header_bytes);
                }
            }
        }
        if (h.failed()) {
            conn.close();
            return Result<HttpStream, Error>.Err(h.get_error());
        }
        HttpResponse head = h.unwrap();
        HttpStream stream = HttpStream.new(move head, move conn, self, host, parsed.port, parsed.https);
        return Result<HttpStream, Error>.Ok(move stream);
    }

    /// Go's Client.Do: performs `request`, following 301/302/303/307/308
    /// redirects up to max_redirects (default 10). 301/302/303 switch to GET
    /// and drop the body (HEAD stays HEAD); 307/308 preserve method and
    /// body. Location resolves against the current URL (absolute,
    /// protocol-relative, or root-relative); when it cannot be resolved
    /// (e.g. https) the 3xx response is returned as-is. Manual requests
    /// (built with the version/target/host constructor) are sent once to
    /// port 80 without redirect handling.
    Result<HttpResponse, Error> do(HttpClient* self, HttpRequest* request) {
        if (request.url == (str)0) {
            bool reused = false;
            Result<HttpConnection, Error> opened = self.acquire(request.host, 80, false, &mut reused);
            if (opened.failed()) { return Result<HttpResponse, Error>.Err(opened.get_error()); }
            HttpConnection conn = opened.unwrap();
            Result<HttpResponse, Error> r = conn.send(request, self.max_header_bytes, self.max_body_bytes);
            if (r.failed() && reused) {
                conn.close();
                bool reused2 = false;
                Result<HttpConnection, Error> reopened = self.acquire(request.host, 80, false, &mut reused2);
                if (!reopened.failed()) {
                    conn = reopened.unwrap();
                    r = conn.send(request, self.max_header_bytes, self.max_body_bytes);
                }
            }
            if (r.failed()) {
                conn.close();
                return Result<HttpResponse, Error>.Err(r.get_error());
            }
            HttpResponse response = r.unwrap();
            if (self.use_pool && !request.close && !response.close_delimited) {
                self.release(request.host, 80, false, move conn);
            } else {
                conn.close();
            }
            return Result<HttpResponse, Error>.Ok(move response);
        }
        str url = request.url;
        str method = request.method;
        str body = request.body;
        str headers = (str)request.headers.data;
        i32 redirects = 0;
        String next_url = String.new();
        String hop_headers = String.new();
        while (true) {
            str hop_block = headers;
            if (self.use_jar) {
                hop_headers.clear();
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    String cookie_block = self.jar.cookies_for(host, parsed.path, parsed.https);
                    if (cookie_block.len > 0) {
                        if (headers != (str)0) { hop_headers.push_str(headers); }
                        hop_headers.push_str("Cookie: ");
                        hop_headers.push_str((str)cookie_block.data);
                        hop_headers.push_str("\r\n");
                        hop_block = (str)hop_headers.data;
                    }
                    cookie_block.drop();
                }
            }
            Result<HttpResponse, Error> r = self.request(method, url, body, hop_block);
            if (r.failed()) { return r; }
            HttpResponse response = r.unwrap();
            if (self.use_jar) {
                // Store response cookies against the request URL (Go stores
                // against req.URL, so redirect hops update the jar per hop).
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    Vec<Cookie> incoming = response.cookies();
                    self.jar.set_cookies(host, parsed.path, &mut incoming);
                    incoming.drop();
                }
            }
            bool follow = false;
            bool redirect_status = response.status == (i32)HttpStatus.MovedPermanently
                || response.status == (i32)HttpStatus.Found
                || response.status == (i32)HttpStatus.SeeOther
                || response.status == (i32)HttpStatus.TemporaryRedirect
                || response.status == (i32)HttpStatus.PermanentRedirect;
            if (redirect_status) {
                String location = response.location();
                if (location.len > 0) {
                    if (redirects >= self.max_redirects) {
                        return Result<HttpResponse, Error>.Err(Error.new(HTTP_ERR_REDIRECT, "too many redirects"));
                    }
                    next_url = http_resolve_url(url, (str)location.data);
                    if (next_url.len > 0) { follow = true; }
                }
            }
            if (!follow) { return Result<HttpResponse, Error>.Ok(move response); }
            bool preserve = response.status == (i32)HttpStatus.TemporaryRedirect
                || response.status == (i32)HttpStatus.PermanentRedirect;
            if (!preserve && method != "HEAD") { method = "GET"; body = (str)0; }
            url = (str)next_url.data;
            redirects = redirects + 1;
            // The intermediate response drops at loop scope end; the next
            // iteration sends the follow-up request.
        }
        // Unreachable — the loop above only exits via `return`.
        return Result<HttpResponse, Error>.Err(Error.new(HTTP_ERR_REDIRECT, "too many redirects"));
    }

    /// Go's Client.Do returning a streaming body: follows redirects (each
    /// 3xx hop's connection is closed, since its body is discarded) and
    /// returns the final response with the body unread. Manual requests have
    /// no URL to resolve redirects against and cannot stream.
    Result<HttpStream, Error> do_stream(HttpClient* self, HttpRequest* request) {
        if (request.url == (str)0) {
            return Result<HttpStream, Error>.Err(Error.new(HTTP_ERR_MALFORMED, "streaming requires a URL"));
        }
        str url = request.url;
        str method = request.method;
        str body = request.body;
        str headers = (str)request.headers.data;
        i32 redirects = 0;
        String next_url = String.new();
        String hop_headers = String.new();
        while (true) {
            str hop_block = headers;
            if (self.use_jar) {
                hop_headers.clear();
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    String cookie_block = self.jar.cookies_for(host, parsed.path, parsed.https);
                    if (cookie_block.len > 0) {
                        if (headers != (str)0) { hop_headers.push_str(headers); }
                        hop_headers.push_str("Cookie: ");
                        hop_headers.push_str((str)cookie_block.data);
                        hop_headers.push_str("\r\n");
                        hop_block = (str)hop_headers.data;
                    }
                    cookie_block.drop();
                }
            }
            Result<HttpStream, Error> s = self.request_stream(method, url, body, hop_block);
            if (s.failed()) { return s; }
            HttpStream stream = s.unwrap();
            if (self.use_jar) {
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    Vec<Cookie> incoming = stream.head.cookies();
                    self.jar.set_cookies(host, parsed.path, &mut incoming);
                    incoming.drop();
                }
            }
            bool follow = false;
            bool redirect_status = stream.head.status == (i32)HttpStatus.MovedPermanently
                || stream.head.status == (i32)HttpStatus.Found
                || stream.head.status == (i32)HttpStatus.SeeOther
                || stream.head.status == (i32)HttpStatus.TemporaryRedirect
                || stream.head.status == (i32)HttpStatus.PermanentRedirect;
            if (redirect_status) {
                String location = stream.head.location();
                if (location.len > 0) {
                    if (redirects >= self.max_redirects) {
                        return Result<HttpStream, Error>.Err(Error.new(HTTP_ERR_REDIRECT, "too many redirects"));
                    }
                    next_url = http_resolve_url(url, (str)location.data);
                    if (next_url.len > 0) { follow = true; }
                }
            }
            if (!follow) { return Result<HttpStream, Error>.Ok(move stream); }
            bool preserve = stream.head.status == (i32)HttpStatus.TemporaryRedirect
                || stream.head.status == (i32)HttpStatus.PermanentRedirect;
            if (!preserve && method != "HEAD") { method = "GET"; body = (str)0; }
            url = (str)next_url.data;
            redirects = redirects + 1;
            stream.close(); // discard the 3xx hop (its body is unread)
        }
        // Unreachable — the loop above only exits via `return`.
        return Result<HttpStream, Error>.Err(Error.new(HTTP_ERR_REDIRECT, "too many redirects"));
    }

    /// Go's Client.Get with a streaming body: fetch the head, then stream
    /// the body via HttpStream.read().
    Result<HttpStream, Error> get_stream(HttpClient* self, str url) {
        HttpRequest req = HttpRequest.new("GET", url, (str)0);
        return self.do_stream(&req);
    }

    Result<HttpResponse, Error> get(HttpClient* self, str url) {
        HttpRequest req = HttpRequest.new("GET", url, (str)0);
        return self.do(&req);
    }

    Result<HttpResponse, Error> get(HttpClient* self, str url, str body) {
        HttpRequest req = HttpRequest.new("GET", url, body);
        return self.do(&req);
    }

    Result<HttpResponse, Error> get(HttpClient* self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("GET", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> post(HttpClient* self, str url) {
        return self.post(url, (str)0, (str)0);
    }

    /// Go's Client.Post: `content_type` is sent as the Content-Type header
    /// (null omits it). Custom headers go through NewRequest + Do.
    Result<HttpResponse, Error> post(HttpClient* self, str url, str content_type, str body) {
        HttpRequest req = HttpRequest.new("POST", url, body);
        if (content_type != (str)0) { req.header("Content-Type", content_type); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> put(HttpClient* self, str url) {
        return self.put(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> put(HttpClient* self, str url, str body) {
        return self.put(url, body, (str)0);
    }

    Result<HttpResponse, Error> put(HttpClient* self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("PUT", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> delete(HttpClient* self, str url) {
        return self.delete(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> delete(HttpClient* self, str url, str body) {
        return self.delete(url, body, (str)0);
    }

    Result<HttpResponse, Error> delete(HttpClient* self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("DELETE", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> head(HttpClient* self, str url) {
        return self.head(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> head(HttpClient* self, str url, str body) {
        return self.head(url, body, (str)0);
    }

    Result<HttpResponse, Error> head(HttpClient* self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("HEAD", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> patch(HttpClient* self, str url) {
        return self.patch(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> patch(HttpClient* self, str url, str body) {
        return self.patch(url, body, (str)0);
    }

    Result<HttpResponse, Error> patch(HttpClient* self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("PATCH", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }
}

impl Drop<HttpClient> for HttpClient {
    void drop(HttpClient* self) {
        self.jar.drop();
        self.tls_ca_file.drop();
        self.pool.drop();
    }
}

impl HttpConnection {
    /// Write the request and read the response head (interim 1xx skipped),
    /// leaving the body unread. The caller keeps the connection.
    Result<HttpResponse, Error> send_head(HttpConnection* self, HttpRequest* request, i64 max_header) {
        StreamIo io;
        if (self.use_tls) { io = transport_tls_io(&self.tls_state[0]); }
        else { io = transport_tcp_io(&self.stream); }
        Result<i64, Error> written = request.write(&io);
        if (written.is_err()) { return Result<HttpResponse, Error>.Err(Error.new(HTTP_ERR_IO, "I/O error")); }
        HttpResponse response = HttpResponse.empty();
        Result<i64, Error> h = response.read_final_head(&io, max_header);
        if (h.is_err()) { return Result<HttpResponse, Error>.Err(h.get_error()); }
        return Result<HttpResponse, Error>.Ok(move response);
    }

    Result<HttpResponse, Error> send(HttpConnection* self, HttpRequest* request, i64 max_header, i64 max_body) {
        Result<HttpResponse, Error> h = self.send_head(request, max_header);
        if (h.failed()) { return h; }
        HttpResponse response = h.unwrap();
        StreamIo io;
        if (self.use_tls) { io = transport_tls_io(&self.tls_state[0]); }
        else { io = transport_tcp_io(&self.stream); }
        Result<i64, Error> b = response.read_body(&io, request.method == "HEAD", max_body);
        if (b.is_err()) { return Result<HttpResponse, Error>.Err(b.get_error()); }
        if (request.close || response.close_delimited) { self.close(); }
        return Result<HttpResponse, Error>.Ok(move response);
    }

    void close(HttpConnection* self) {
        if (self.use_tls) { transport_tls_close(&self.tls_state[0]); }
        self.stream.close();
    }
}
