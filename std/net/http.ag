// std/net/http.ag — HTTP/1.0 and HTTP/1.1 client modeled after Go's net/http.
//
// The familiar surface is HttpClient.Get/Post/Head/Do with HttpRequest.new
// (Go's NewRequest), automatic redirect following (301/302/303 rewrite to
// GET, 307/308 preserve), and a Response with status, reason, get_header,
// and status_text. The lower layer (HttpConnection, request/response framing)
// stays exposed for callers that need explicit connection reuse.
import std.error;
import std.fmt;
import std.mem.alloc;
import std.mem.drop;
import std.mem.vec;
import std.net.cookie;
import std.net.dns;
import std.net.hpack;
import std.net.http2;
import std.net.http_status;
import std.net.inet;
import std.net.tcp;
import std.net.transport;
import std.string;
import std.sync;
import std.sys.result;

const i64 HTTP_ERR_IO = -1;
const i64 HTTP_ERR_MALFORMED = -2;
const i64 HTTP_ERR_LIMIT = -3;
const i64 HTTP_ERR_CONNECT = -4;
const i64 HTTP_ERR_DNS = -5;
const i64 HTTP_ERR_REDIRECT = -6;
const i64 HTTP_ERR_TIMEOUT = -7;

const i64 HTTP_DEFAULT_MAX_HEADER = 65536;
const i64 HTTP_DEFAULT_MAX_BODY = 16777216;
const i64 HTTP_CHUNK_LINE_MAX = 8192;
const i32 HTTP_DEFAULT_MAX_REDIRECTS = 10;

enum HttpVersion {
    Http10 = 10;
    Http11 = 11;
    Http20 = 20;
}

struct HttpRequest {
    HttpVersion version;
    str method;
    str target;
    str host;
    String headers;
    str body;
    bool close;
    str url; // full URL for Go-style requests; null for manual requests
    String method_str;
    String target_str;
    String host_str;
    String path_str;
    String query_str;
    String body_buf;
    i64 content_length;
    bool chunked;
}

struct HttpResponse {
    HttpVersion version;
    i32 status;
    String reason;
    String headers;
    String body;
    String trailers;
    i64 content_length;
    bool chunked;
    bool close_delimited;
}

struct HttpClient {
    i64 max_header_bytes;
    i64 max_body_bytes;
    i32 max_redirects;
    bool use_jar; // false = manual Cookie header handling, like Go's nil Jar
    CookieJar jar;
    bool tls_verify; // true = verify peer certificates (Go's default)
    String tls_ca_file; // optional CA bundle; empty = system trust store
    bool use_pool; // keep-alive connection reuse (Go's Transport pooling)
    ConnectionPool pool;
    i64 timeout_secs; // per-request socket timeout; 0 = none (Go's Client.Timeout)
}

struct HttpConnection {
    TcpStream stream;
    u8 tls_state[64]; // opaque TLS transport state (TRANSPORT_TLS_STATE_SIZE)
    bool use_tls;
    HttpVersion version;
    bool is_h2;
    // Read buffer: framing reads byte-at-a-time, so the transport serves
    // from this buffer and refills in 4KB chunks instead of one syscall (or
    // SSL_read) per byte. Heap-allocated (4096 bytes) so the connection
    // struct stays small — inline arrays this size made the compiler's
    // struct layout pass superlinear. Empty at response boundaries, so
    // pooled connections carry no stale bytes.
    u8* read_buf;
    i64 read_buf_len;
    i64 read_buf_pos;
}

impl Drop for HttpConnection {
    void drop(*self) {
        self.close();
    }
}

// --- Buffered transport ---------------------------------------------------
// The framing layer reads one byte at a time; this adapter serves those
// bytes from a per-connection buffer, refilling with a single large read
// (4KB) so header/body parsing costs one syscall (or SSL_read) per 4KB
// instead of one per byte.

#[inline(always)]
Result<i64, Error> http_transport_read(void* ctx, u8* buf, i64 len) {
    HttpConnection* conn = (HttpConnection*)ctx;
    i64 avail = conn.read_buf_len - conn.read_buf_pos;
    if (avail <= 0) {
        // Refill the buffer.
        Result<i64, Error> r;
        if (conn.use_tls) {
            Result<i64, Error>(void*, u8*, i64) f = g_tls_provider.read;
            r = f(&conn.tls_state[0], &conn.read_buf[0], 1024);
        } else {
            r = conn.stream.read(&conn.read_buf[0], 1024);
        }
        if (r.failed()) { return r; }
        if (r.value() == 0) { return Ok(0); }
        conn.read_buf_len = r.value();
        conn.read_buf_pos = 0;
        avail = conn.read_buf_len;
    }
    i64 n = len;
    if (n > avail) { n = avail; }
    i64 i = 0;
    while (i < n) {
        buf[i] = conn.read_buf[conn.read_buf_pos + i];
        i = i + 1;
    }
    conn.read_buf_pos = conn.read_buf_pos + n;
    return Ok(n);
}

#[inline(always)]
Result<i64, Error> http_transport_write(void* ctx, u8* buf, i64 len) {
    HttpConnection* conn = (HttpConnection*)ctx;
    if (conn.use_tls) {
        Result<i64, Error>(void*, u8*, i64) f = g_tls_provider.write;
        return f(&conn.tls_state[0], buf, len);
    }
    return conn.stream.write(buf, len);
}

StreamIo http_transport_io(HttpConnection* conn) {
    StreamIo io;
    io.ctx = (void*)conn;
    io.read = http_transport_read;
    io.write = http_transport_write;
    return io;
}

// --- Connection pooling (Go's Transport keep-alive pool) ------------------

struct PoolEntry {
    HttpConnection conn;
    u8 host[255];
    u16 port;
    bool https;
    i64 last_used; // pool sequence at release time (LRU ordering only)
}

// Monotonic sequence for pool LRU ordering — cheaper than a clock syscall
// per release and strictly increasing.
i64 g_pool_seq = 0;

struct ConnectionPool {
    Vec<PoolEntry> entries;
    RawMutex lock;
    i32 max_idle; // Go's MaxIdleConnsPerHost
}

impl ConnectionPool {
    ConnectionPool new() {
        ConnectionPool pool;
        pool.entries = Vec<PoolEntry>.new();
        pool.lock = RawMutex.new();
        pool.max_idle = 2;
        return pool;
    }
}

impl Drop for ConnectionPool {
    void drop(*self) {
        while (self.entries.len > 0) {
            PoolEntry e = self.entries.take(0);
            e.conn.close();
        }
        self.entries.drop();
    }
}

/// Remove entry `index` from the pool, returning it. Swap-remove: the last
/// entry fills the hole and len shrinks (O(1), unlike Vec.take's shift).
PoolEntry http_pool_remove_at(Vec<PoolEntry>* entries, i64 index) {
    i64 last = entries.len - 1;
    PoolEntry entry = entries.data[index];
    entries.data[index].conn.read_buf = (u8*)0;
    if (index != last) {
        entries.data[index] = entries.data[last];
        entries.data[last].conn.read_buf = (u8*)0;
    }
    entries.len = last;
    return entry;
}

bool http_host_eq(str a, str b) {
    u8* pa = (u8*)a;
    u8* pb = (u8*)b;
    i64 i = 0;
    while (true) {
        if (pa[i] != pb[i]) { return false; }
        if (pa[i] == (u8)0) { return true; }
        i = i + 1;
    }
    // Unreachable — the loop above only exits via `return`.
    return false;
}

struct HttpUrl {
    u8 host[255];
    u16 port;
    str path;
    bool https;
}

// --- Byte helpers ---------------------------------------------------------
// Shared byte utilities (http_is_space, http_is_digit, http_lower,
// http_equal_ci, http_parse_i64, http_append_i64) live in std/net/cookie.ag
// so the low-level helpers have a single definition point.

/// Append `block` minus Authorization/Cookie/Cookie2/WWW-Authenticate header
/// lines. Go drops these sensitive headers when a redirect crosses hosts.
void http_strip_sensitive_headers(str block, String* out) {
    u8* data = (u8*)block;
    i64 len = strlen(block);
    i64 pos = 0;
    while (pos < len) {
        i64 end = http_find_crlf(data, len, pos);
        if (end < 0) { end = len; }
        i64 colon = pos;
        while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
        bool sensitive = colon > pos && colon < end
            && (http_equal_ci(data, pos, colon, "authorization")
                || http_equal_ci(data, pos, colon, "cookie")
                || http_equal_ci(data, pos, colon, "cookie2")
                || http_equal_ci(data, pos, colon, "www-authenticate"));
        if (!sensitive) {
            i64 k = pos;
            while (k < end) { out.push(data[k]); k = k + 1; }
            out.push_str("\r\n");
        }
        if (end >= len) { break; }
        pos = end + 2;
    }
}

/// Parse CRLF-separated "Name: value\r\n" header block into HpackField array views.
i64 http_parse_headers_to_hpack(str raw_headers, HpackField* extra, i64 max_extra) {
    if (raw_headers == (str)0) { return 0; }
    u8* data = (u8*)raw_headers;
    i64 len = strlen(raw_headers);
    i64 pos = 0;
    i64 count = 0;
    while (pos < len && count < max_extra) {
        i64 end = http_find_crlf(data, len, pos);
        if (end < 0) { end = len; }
        i64 colon = pos;
        while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
        if (colon > pos && colon < end) {
            i64 value_start = colon + 1;
            while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
            extra[count].name = &data[pos];
            extra[count].name_len = colon - pos;
            extra[count].value = &data[value_start];
            extra[count].value_len = end - value_start;
            count += 1;
        }
        if (end >= len) { break; }
        pos = end + 2;
    }
    return count;
}

/// Index of the first CRLF at or after `start`, or -1 when none exists.
#[inline(always)]
i64 http_find_crlf(u8* data, i64 len, i64 start) {
    i64 i = start;
    while (i + 1 < len) {
        if (data[i] == (u8)'\r' && data[i + 1] == (u8)'\n') { return i; }
        i = i + 1;
    }
    return -1;
}

/// Index of the first CRLFCRLF in the combined stream `carry[0..carry_len)`
/// followed by `data[0..len)`, or -1 when none exists. The carry holds the
/// last few bytes of the previous chunk so a terminator straddling a chunk
/// boundary is still found.
#[inline(always)]
i64 http_find_crlfcrlf(u8* carry, i64 carry_len, u8* data, i64 len) {
    i64 total = carry_len + len;
    i64 i = 0;
    while (i + 4 <= total) {
        u8 b0 = i < carry_len ? carry[i] : data[i - carry_len];
        u8 b1 = i + 1 < carry_len ? carry[i + 1] : data[i + 1 - carry_len];
        u8 b2 = i + 2 < carry_len ? carry[i + 2] : data[i + 2 - carry_len];
        u8 b3 = i + 3 < carry_len ? carry[i + 3] : data[i + 3 - carry_len];
        if (b0 == (u8)'\r' && b1 == (u8)'\n' && b2 == (u8)'\r' && b3 == (u8)'\n') { return i; }
        i = i + 1;
    }
    return -1;
}

/// Parse the hexadecimal integer in `data[start..end]`, allowing surrounding
/// whitespace. Returns false when the range is not a valid integer.
bool http_parse_hex(u8* data, i64 start, i64 end, i64* out) {
    i64 i = start;
    while (i < end && http_is_space(data[i])) { i = i + 1; }
    i64 value = 0;
    i64 digits = 0;
    while (i < end) {
        u8 ch = data[i];
        i64 digit = -1;
        if (ch >= (u8)'0' && ch <= (u8)'9') { digit = (i64)(ch - (u8)'0'); }
        else if (ch >= (u8)'A' && ch <= (u8)'F') { digit = (i64)(ch - (u8)'A') + 10; }
        else if (ch >= (u8)'a' && ch <= (u8)'f') { digit = (i64)(ch - (u8)'a') + 10; }
        else { break; }
        value = value * 16 + digit;
        digits = digits + 1;
        i = i + 1;
    }
    if (digits == 0) { return false; }
    while (i < end && http_is_space(data[i])) { i = i + 1; }
    // Chunk extensions (RFC 9112 §7.1.1): ignore unrecognized chunk extensions starting with ';'
    if (i < end && data[i] == (u8)';') {
        i = end;
    }
    if (i != end) { return false; }
    *out = value;
    return true;
}


/// Split "http://host[:port]/path" or "https://host[:port]/path" into
/// host, port, path, and scheme. The scheme is optional and must be plain
/// http or https (https defaults to port 443). `path` is a view into `url`,
/// which must therefore outlive the parsed value.
bool http_parse_url(str url, HttpUrl* out) {
    u8* p = (u8*)url;
    i64 len = strlen(url);
    i64 i = 0;
    bool https = false;
    if (len >= 8 && http_equal_ci(p, 0, 8, "https://")) { https = true; i = 8; }
    else if (len >= 7 && http_equal_ci(p, 0, 7, "http://")) { i = 7; }
    else { return false; }
    i64 host_start = i;
    while (i < len && p[i] != (u8)':' && p[i] != (u8)'/') { i = i + 1; }
    i64 host_len = i - host_start;
    if (host_len == 0 || host_len >= 255) { return false; }
    // Hosts must be printable ASCII without spaces or control bytes, so the
    // Host header can never be malformed or injected.
    i64 j = 0;
    while (j < host_len) {
        u8 ch = p[host_start + j];
        if (ch < (u8)0x21 || ch > (u8)0x7e) { return false; }
        out.host[j] = ch;
        j = j + 1;
    }
    out.host[j] = (u8)0;
    u16 port = 80;
    if (https) { port = 443; }
    if (i < len && p[i] == (u8)':') {
        i = i + 1;
        i64 port_start = i;
        while (i < len && p[i] != (u8)'/') { i = i + 1; }
        i64 port_value = 0;
        if (port_start == i || !http_parse_i64(p, port_start, i, &port_value)
            || port_value <= 0 || port_value > 65535) {
            return false;
        }
        port = (u16)port_value;
    }
    out.port = port;
    out.https = https;
    out.path = (str)&p[i];
    if (strlen(out.path) == 0) { out.path = "/"; }
    return true;
}

/// Resolve `location` against the absolute `base` URL (Go's
/// Reference.ResolveReference for the common cases): absolute http/https
/// URLs pass through, "//host/path" reuses the base scheme, "/path" reuses
/// the base authority. Path-relative locations are not resolvable here and
/// yield an empty string (callers then return the response instead of
/// following).
String http_resolve_url(str base, str location) {
    String result = String.new();
    u8* loc = (u8*)location;
    i64 loc_len = strlen(location);
    if ((loc_len >= 8 && http_equal_ci(loc, 0, 8, "https://"))
        || (loc_len >= 7 && http_equal_ci(loc, 0, 7, "http://"))) {
        result.push_str(location);
        return move result;
    }
    u8* b = (u8*)base;
    i64 base_len = strlen(base);
    i64 scheme_len = 0;
    if (base_len >= 8 && http_equal_ci(b, 0, 8, "https://")) { scheme_len = 8; }
    else if (base_len >= 7 && http_equal_ci(b, 0, 7, "http://")) { scheme_len = 7; }
    else { return move result; }
    if (loc_len >= 2 && loc[0] == (u8)'/' && loc[1] == (u8)'/') {
        i64 s = 0;
        while (s < scheme_len - 3) { result.push(b[s]); s = s + 1; }
        result.push_str(location);
        return move result;
    }
    if (loc_len >= 1 && loc[0] == (u8)'/') {
        i64 i = scheme_len;
        while (i < base_len && b[i] != (u8)'/') { i = i + 1; }
        i64 s = 0;
        while (s < i) { result.push(b[s]); s = s + 1; }
        result.push_str(location);
        return move result;
    }
    return move result;
}

/// Resolve `host` (IP literal or DNS name) and open a fresh connection,
/// bounding the TCP connect by `timeout_secs` (0 = wait indefinitely).
Result<HttpConnection, Error> http_open(str host, u16 port, i64 timeout_secs) {
    u32 ip4 = 0;
    i32 ip = 0;
    if (inet_pton4(host, &ip4)) { ip = (i32)ip4; }
    else { ip = dns_resolve(host); }
    if (ip == 0) {
        return Err(HTTP_ERR_DNS, "DNS resolution failed");
    }
    Result<SocketAddr, AddrError> addr_result = SocketAddr.v4_network((u32)ip, port);
    if (addr_result.failed()) {
        return Err(HTTP_ERR_MALFORMED, "malformed address");
    }
    SocketAddr addr = addr_result.unwrap();
    Result<TcpStream, Error> connect_result = TcpStream.connect_timeout(&addr, timeout_secs);
    if (connect_result.failed()) {
        Error e = connect_result.get_error();
        if (e.code == ETIMEDOUT) {
            return Err(HTTP_ERR_TIMEOUT, "connection timed out");
        }
        return Err(HTTP_ERR_CONNECT, "connection failed");
    }
    TcpStream stream = connect_result.unwrap();
    HttpConnection connection;
    connection.stream = move stream;
    connection.use_tls = false;
    connection.version = HttpVersion.Http11;
    connection.is_h2 = false;
    connection.read_buf = (u8*)malloc(4096);
    connection.read_buf_len = 0;
    connection.read_buf_pos = 0;
    return Ok(move connection);
}

/// Rewind the buffered transport by `n` bytes — bytes already consumed from
/// the connection's read buffer but logically belonging to the next read
/// (the unconsumed tail of a bulk head/line scan). Only valid immediately
/// after a read that served from the buffer; the buffer always still holds
/// those bytes because the adapter refills only when it is empty.
#[inline(always)]
void http_transport_rewind(StreamIo* io, i64 n) {
    if (n <= 0) { return; }
    HttpConnection* conn = (HttpConnection*)io.ctx;
    conn.read_buf_pos = conn.read_buf_pos - n;
}

/// Read one CRLF-terminated line into `line`, excluding the CRLF itself.
/// Returns false on EOF, read error, or when the line exceeds `max_len`.
/// Reads in 512-byte chunks and scans for the terminator in bulk.
bool http_read_line(StreamIo* io, String* line, i64 max_len) {
    line.clear();
    u8 chunk[512];
    u8 carry[1];
    i64 carry_len = 0;
    while (true) {
        Result<i64, Error> r = transport_read(io, &chunk[0], 512);
        if (r.is_err() || r.value() == 0) { return false; }
        i64 n = r.value();
        i64 strip = 0;   // CRLF bytes already in `line` (straddling CR)
        i64 consume = n; // bytes to take from this chunk
        bool done = false;
        if (carry_len == 1 && carry[0] == (u8)'\r' && n >= 1 && chunk[0] == (u8)'\n') {
            // CR straddles the boundary: strip it from the line, consume the LF.
            strip = 1;
            consume = 1;
            done = true;
        } else {
            i64 found = http_find_crlf(&chunk[0], n, 0);
            if (found >= 0) {
                consume = found + 2; // content + CRLF
                done = true;
            }
        }
        if (line.len + consume - strip - (done ? 2 : 0) > max_len) { return false; }
        line.push_bytes(&chunk[0], consume);
        line.len = line.len - strip - 2;
        line.data[line.len] = (u8)0;
        if (done) {
            http_transport_rewind(io, n - consume);
            return true;
        }
        // Keep the last byte so a boundary-straddling CRLF is found next time.
        carry_len = 1;
        carry[0] = chunk[n - 1];
    }
    // Unreachable — the loop above only exits via `return`.
    return false;
}

// --- Requests -------------------------------------------------------------

impl HttpRequest {
    /// Go's http.NewRequest: full URL, default HTTP/1.1, body optional.
    /// The URL is parsed when the request is sent via HttpClient.do.
    HttpRequest new(str method, str url, str body) {
        HttpRequest request;
        request.version = HttpVersion.Http11;
        request.method = method;
        request.url = url;
        request.target = (str)0;
        request.host = (str)0;
        request.headers = String.new();
        request.body = body;
        request.close = true;
        request.method_str = String.new();
        request.target_str = String.new();
        request.host_str = String.new();
        request.path_str = String.new();
        request.query_str = String.new();
        request.body_buf = String.new();
        request.content_length = -1;
        request.chunked = false;
        return move request;
    }

    /// Manual request: explicit version, request target, and Host header.
    /// Sent via HttpClient.do with a fresh connection to port 80.
    HttpRequest new(HttpVersion version, str method, str target, str host) {
        HttpRequest request;
        request.version = version;
        request.method = method;
        request.target = target;
        request.host = host;
        request.headers = String.new();
        request.body = (str)0;
        request.close = true;
        request.url = (str)0;
        request.method_str = String.new();
        request.target_str = String.new();
        request.host_str = String.new();
        request.path_str = String.new();
        request.query_str = String.new();
        request.body_buf = String.new();
        request.content_length = -1;
        request.chunked = false;
        return move request;
    }

    /// Empty request for server incoming request reading.
    HttpRequest empty() {
        HttpRequest request;
        request.version = HttpVersion.Http11;
        request.method = (str)0;
        request.target = (str)0;
        request.host = (str)0;
        request.headers = String.new();
        request.body = (str)0;
        request.close = false;
        request.url = (str)0;
        request.method_str = String.new();
        request.target_str = String.new();
        request.host_str = String.new();
        request.path_str = String.new();
        request.query_str = String.new();
        request.body_buf = String.new();
        request.content_length = -1;
        request.chunked = false;
        return move request;
    }

    void header(&mut self, str name, str value) {
        self.headers.push_str(name);
        self.headers.push_str(": ");
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    void set_body(&mut self, str body) {
        self.body = body;
    }

    /// Go's Request.AddCookie: merge `name=value` into the existing Cookie
    /// header line, or append a new Cookie header when none is set.
    void add_cookie(&mut self, str name, str value) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end && http_equal_ci(data, pos, colon, "cookie")) {
                String head = self.headers.substr(0, end);
                String tail = self.headers.substr(end, len - end);
                String updated = String.new();
                updated.push_str((str)head.data);
                updated.push_str("; ");
                updated.push_str(name);
                updated.push((u8)'=');
                updated.push_str(value);
                updated.push_str((str)tail.data);
                self.headers.drop();
                self.headers = move updated;
                return;
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        self.headers.push_str("Cookie: ");
        self.headers.push_str(name);
        self.headers.push((u8)'=');
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    void keep_alive(&mut self) {
        self.close = false;
    }

    /// The value of `name` (case-insensitive) in the request headers, or
    /// an empty string when absent. Mirrors Go's Request.Header.Get.
    String get_header(*self, str name) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, name)) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                return self.headers.substr(value_start, end - value_start);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return String.new();
    }

    /// Protocol string e.g. "HTTP/1.1". Mirrors Go's Request.Proto.
    str proto(*self) {
        if (self.version == HttpVersion.Http10) { return "HTTP/1.0"; }
        if (self.version == HttpVersion.Http11) { return "HTTP/1.1"; }
        if (self.version == HttpVersion.Http20) { return "HTTP/2.0"; }
        return "HTTP/1.1";
    }

    /// Request path component without query string. Mirrors Go's req.URL.Path.
    str path(*self) {
        if (self.path_str.len > 0) { return (str)self.path_str.data; }
        if (self.target != (str)0) { return self.target; }
        return "/";
    }

    /// Query string component without '?'. Mirrors Go's req.URL.RawQuery.
    str query(*self) {
        if (self.query_str.len > 0) { return (str)self.query_str.data; }
        return "";
    }

    /// Request body as a null-terminated string.
    str body_str(*self) {
        if (self.body_buf.len > 0) { return (str)self.body_buf.data; }
        if (self.body != (str)0) { return self.body; }
        return "";
    }

    /// Read request head from `io`. Returns:
    /// - Ok(1): request head successfully parsed
    /// - Ok(0): clean EOF on first byte (idle keep-alive disconnect)
    /// - Err: malformed or oversized request
    Result<i64, Error> read_head(*self, StreamIo* io, i64 max_header) {
        String raw = String.new();
        u8 chunk[512];
        u8 carry[3];
        i64 carry_len = 0;
        bool first_read = true;

        while (true) {
            Result<i64, Error> r = transport_read(io, &chunk[0], 512);
            if (r.is_err()) {
                raw.drop();
                return Err(HTTP_ERR_IO, "I/O error");
            }
            i64 n = r.value();
            if (n == 0) {
                raw.drop();
                if (first_read) { return Ok(0); }
                return Err(HTTP_ERR_MALFORMED, "malformed request");
            }
            first_read = false;
            i64 term = http_find_crlfcrlf(&carry[0], carry_len, &chunk[0], n);
            i64 consume = n;
            if (term >= 0) { consume = term + 4 - carry_len; }
            if (raw.len + consume > max_header) {
                raw.drop();
                return Err(HTTP_ERR_LIMIT, "request exceeds size limit");
            }
            raw.push_bytes(&chunk[0], consume);
            if (term >= 0) {
                http_transport_rewind(io, n - consume);
                break;
            }
            carry_len = 0;
            i64 back = consume;
            if (back > 3) { back = 3; }
            while (back > 0) {
                back = back - 1;
                carry[carry_len] = chunk[consume - 1 - back];
                carry_len = carry_len + 1;
            }
        }

        i64 line_end = http_find_crlf(raw.data, raw.len, 0);
        if (line_end < 0) {
            raw.drop();
            return Err(HTTP_ERR_MALFORMED, "malformed request");
        }
        i64 sp1 = 0;
        while (sp1 < line_end && raw.data[sp1] != (u8)' ') { sp1 = sp1 + 1; }
        if (sp1 == 0 || sp1 >= line_end) {
            raw.drop();
            return Err(HTTP_ERR_MALFORMED, "malformed request line");
        }
        i64 sp2 = sp1 + 1;
        while (sp2 < line_end && raw.data[sp2] != (u8)' ') { sp2 = sp2 + 1; }
        if (sp2 == sp1 + 1 || sp2 >= line_end) {
            raw.drop();
            return Err(HTTP_ERR_MALFORMED, "malformed request line");
        }

        self.method_str.clear();
        self.method_str.push_bytes(&raw.data[0], sp1);
        self.method = (str)self.method_str.data;

        self.target_str.clear();
        self.target_str.push_bytes(&raw.data[sp1 + 1], sp2 - sp1 - 1);
        self.target = (str)self.target_str.data;

        i64 qmark = 0;
        i64 tlen = self.target_str.len;
        while (qmark < tlen && self.target_str.data[qmark] != (u8)'?') {
            qmark = qmark + 1;
        }
        self.path_str.clear();
        self.path_str.push_bytes(&self.target_str.data[0], qmark);
        self.query_str.clear();
        if (qmark < tlen) {
            self.query_str.push_bytes(&self.target_str.data[qmark + 1], tlen - qmark - 1);
        }

        i64 vlen = line_end - (sp2 + 1);
        if (vlen == 8 && http_equal_ci(raw.data, sp2 + 1, line_end, "HTTP/1.0")) {
            self.version = HttpVersion.Http10;
            self.close = true;
        } else if (vlen == 8 && http_equal_ci(raw.data, sp2 + 1, line_end, "HTTP/1.1")) {
            self.version = HttpVersion.Http11;
            self.close = false;
        } else {
            raw.drop();
            return Err(HTTP_ERR_MALFORMED, "unsupported HTTP version");
        }

        self.content_length = -1;
        self.chunked = false;
        bool has_content_length = false;
        u8* data = raw.data;
        i64 header_start = line_end + 2;
        i64 header_end = raw.len - 2;

        while (header_start < header_end) {
            i64 end = http_find_crlf(data, header_end, header_start);
            if (end < 0) {
                raw.drop();
                return Err(HTTP_ERR_MALFORMED, "malformed request headers");
            }
            i64 colon = header_start;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon == end || colon == header_start) {
                raw.drop();
                return Err(HTTP_ERR_MALFORMED, "malformed request headers");
            }
            i64 value_start = colon + 1;
            while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }

            if (http_equal_ci(data, header_start, colon, "host")) {
                self.host_str.clear();
                self.host_str.push_bytes(&data[value_start], end - value_start);
                self.host = (str)self.host_str.data;
            } else if (http_equal_ci(data, header_start, colon, "content-length")) {
                i64 cl = 0;
                if (!http_parse_i64(data, value_start, end, &mut cl)) {
                    raw.drop();
                    return Err(HTTP_ERR_MALFORMED, "malformed Content-Length");
                }
                if (has_content_length && cl != self.content_length) {
                    raw.drop();
                    return Err(HTTP_ERR_MALFORMED, "conflicting Content-Length headers");
                }
                self.content_length = cl;
                has_content_length = true;
            } else if (http_equal_ci(data, header_start, colon, "transfer-encoding")) {
                if (http_equal_ci(data, value_start, end, "chunked")) {
                    self.chunked = true;
                }
            } else if (http_equal_ci(data, header_start, colon, "connection")) {
                if (http_equal_ci(data, value_start, end, "close")) {
                    self.close = true;
                } else if (http_equal_ci(data, value_start, end, "keep-alive")) {
                    self.close = false;
                }
            }
            header_start = end + 2;
        }

        if (self.chunked) {
            self.content_length = -1;
        }

        self.headers.clear();
        self.headers.push_bytes(&raw.data[line_end + 2], raw.len - line_end - 2);
        raw.drop();
        return Ok(1);
    }

    Result<i64, Error> read_exact(*self, StreamIo* io, i64 count, i64 max_body) {
        if (count < 0 || count > max_body) { return Err(HTTP_ERR_LIMIT, "request body exceeds limit"); }
        i64 done = 0;
        u8 buf[1024];
        while (done < count) {
            i64 want = count - done;
            if (want > 1024) { want = 1024; }
            Result<i64, Error> r = transport_read(io, &buf[0], want);
            if (r.is_err() || r.value() == 0) { return Err(HTTP_ERR_IO, "I/O error"); }
            self.body_buf.push_bytes(&buf[0], r.value());
            done = done + r.value();
        }
        self.body = (str)self.body_buf.data;
        return Ok(done);
    }

    Result<i64, Error> read_chunked(*self, StreamIo* io, i64 max_body) {
        i64 total = 0;
        String line = String.new();
        u8 byte[1];
        while (true) {
            if (!http_read_line(io, &line, HTTP_CHUNK_LINE_MAX)) {
                line.drop();
                return Err(HTTP_ERR_IO, "I/O error");
            }
            i64 size = 0;
            if (!http_parse_hex(line.data, 0, line.len, &mut size)) {
                line.drop();
                return Err(HTTP_ERR_MALFORMED, "malformed chunk size");
            }
            if (size == 0) {
                while (true) {
                    if (!http_read_line(io, &line, HTTP_CHUNK_LINE_MAX)) {
                        line.drop();
                        return Err(HTTP_ERR_IO, "I/O error");
                    }
                    if (line.len == 0) {
                        line.drop();
                        self.body = (str)self.body_buf.data;
                        return Ok(total);
                    }
                }
            }
            if (total + size > max_body) {
                line.drop();
                return Err(HTTP_ERR_LIMIT, "chunked body exceeds limit");
            }
            Result<i64, Error> got = self.read_exact(io, size, max_body);
            if (got.is_err()) {
                line.drop();
                return got;
            }
            Result<i64, Error> crlf = transport_read(io, &byte[0], 1);
            if (crlf.is_err() || crlf.value() != 1 || byte[0] != (u8)'\r') {
                line.drop();
                return Err(HTTP_ERR_MALFORMED, "malformed chunk ending");
            }
            crlf = transport_read(io, &byte[0], 1);
            if (crlf.is_err() || crlf.value() != 1 || byte[0] != (u8)'\n') {
                line.drop();
                return Err(HTTP_ERR_MALFORMED, "malformed chunk ending");
            }
            total = total + size;
        }
        line.drop();
        return Err(HTTP_ERR_MALFORMED, "malformed request");
    }

    Result<i64, Error> read_body(*self, StreamIo* io, i64 max_body) {
        if (self.chunked) { return self.read_chunked(io, max_body); }
        if (self.content_length > 0) { return self.read_exact(io, self.content_length, max_body); }
        self.body = (str)0;
        return Ok(0);
    }

    Result<i64, Error> write(*self, StreamIo* io) {
        String head = String.new();
        head.push_str(self.method);
        head.push((u8)' ');
        head.push_str(self.target);
        head.push_str(" HTTP/");
        if (self.version == HttpVersion.Http10) { head.push_str("1.0"); }
        else { head.push_str("1.1"); }
        head.push_str("\r\nHost: ");
        head.push_str(self.host);
        head.push_str("\r\n");
        if (self.body != (str)0) {
            head.push_str("Content-Length: ");
            http_append_i64(&mut head, strlen(self.body));
            head.push_str("\r\n");
        }
        if (self.close) { head.push_str("Connection: close\r\n"); }
        head.push_str((str)self.headers.data);
        head.push_str("\r\n");
        Result<i64, Error> written = transport_write(io, (u8*)head.data, head.len);
        if (written.is_err()) { return written; }
        if (self.body != (str)0 && strlen(self.body) > 0) {
            return transport_write(io, (u8*)self.body, strlen(self.body));
        }
        return Ok(written.value());
    }
}

impl Drop for HttpRequest {
    void drop(*self) {
        self.headers.drop();
        self.method_str.drop();
        self.target_str.drop();
        self.host_str.drop();
        self.path_str.drop();
        self.query_str.drop();
        self.body_buf.drop();
    }
}

// --- Responses ------------------------------------------------------------

impl HttpResponse {
    HttpResponse empty() {
        HttpResponse response;
        response.version = HttpVersion.Http11;
        response.status = 0;
        response.reason = String.new();
        response.headers = String.new();
        response.body = String.new();
        response.trailers = String.new();
        response.content_length = -1;
        response.chunked = false;
        response.close_delimited = false;
        return move response;
    }

    Result<i64, Error> read_head(*self, StreamIo* io, i64 max_header) {
        // Phase 1: accumulate the raw head in 512-byte bulk reads, scanning
        // for the CRLFCRLF terminator with a plain loop (plus a 3-byte carry
        // for boundary-straddling terminators). The unconsumed tail — the
        // body start — is rewound into the buffered transport. The old
        // per-byte transport_read(1) + push + ends_with loop cost one
        // buffered call per head byte.
        String raw = String.new();
        u8 chunk[512];
        u8 carry[3];
        i64 carry_len = 0;
        while (true) {
            Result<i64, Error> r = transport_read(io, &chunk[0], 512);
            if (r.is_err()) { return Err(HTTP_ERR_IO, "I/O error"); }
            i64 n = r.value();
            if (n == 0) { return Err(HTTP_ERR_MALFORMED, "malformed response"); }
            i64 term = http_find_crlfcrlf(&carry[0], carry_len, &chunk[0], n);
            i64 consume = n;
            if (term >= 0) { consume = term + 4 - carry_len; }
            if (raw.len + consume > max_header) { return Err(HTTP_ERR_LIMIT, "response exceeds size limit"); }
            raw.push_bytes(&chunk[0], consume);
            if (term >= 0) {
                http_transport_rewind(io, n - consume);
                break;
            }
            // Carry the last 3 bytes so a boundary-straddling terminator is
            // found next time.
            carry_len = 0;
            i64 back = consume;
            if (back > 3) { back = 3; }
            while (back > 0) {
                back = back - 1;
                carry[carry_len] = chunk[consume - 1 - back];
                carry_len = carry_len + 1;
            }
        }

        // Status line: "HTTP/1.x <3-digit status>[ reason]". Parsed in place
        // from the raw head (no intermediate substr allocations).
        i64 line_end = http_find_crlf(raw.data, raw.len, 0);
        if (line_end < 0) { return Err(HTTP_ERR_MALFORMED, "malformed response"); }
        if (line_end < 12 || raw[8] != (u8)' ') {
            return Err(HTTP_ERR_MALFORMED, "malformed response");
        }
        if (raw[5] != (u8)'1' || raw[6] != (u8)'.') {
            return Err(HTTP_ERR_MALFORMED, "malformed response");
        }
        if (raw[7] == (u8)'0') { self.version = HttpVersion.Http10; }
        else if (raw[7] == (u8)'1') { self.version = HttpVersion.Http11; }
        else { return Err(HTTP_ERR_MALFORMED, "malformed response"); }
        if (!http_is_digit(raw[9]) || !http_is_digit(raw[10])
            || !http_is_digit(raw[11])) {
            return Err(HTTP_ERR_MALFORMED, "malformed response");
        }
        self.status = (i32)((i64)(raw[9] - (u8)'0') * 100
            + (i64)(raw[10] - (u8)'0') * 10
            + (i64)(raw[11] - (u8)'0'));
        self.reason.len = 0;
        if (line_end > 12 && raw[12] == (u8)' ') {
            self.reason.push_bytes(&raw.data[13], line_end - 13);
        }

        // Headers: CRLF-terminated lines up to the blank line.
        self.content_length = -1;
        self.chunked = false;
        self.close_delimited = (self.version == HttpVersion.Http10);
        self.trailers.clear();
        bool has_content_length = false;

        u8* data = raw.data;
        i64 header_start = line_end + 2;
        i64 header_end = raw.len - 2;
        while (header_start < header_end) {
            i64 end = http_find_crlf(data, header_end, header_start);
            if (end < 0) { return Err(HTTP_ERR_MALFORMED, "malformed response"); }
            i64 colon = header_start;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon == end || colon == header_start) { return Err(HTTP_ERR_MALFORMED, "malformed response"); }
            i64 value_start = colon + 1;
            while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
            if (http_equal_ci(data, header_start, colon, "content-length")) {
                i64 cl = 0;
                if (!http_parse_i64(data, value_start, end, &mut cl)) {
                    return Err(HTTP_ERR_MALFORMED, "malformed response");
                }
                if (has_content_length && cl != self.content_length) {
                    return Err(HTTP_ERR_MALFORMED, "conflicting Content-Length headers");
                }
                self.content_length = cl;
                has_content_length = true;
            } else if (http_equal_ci(data, header_start, colon, "transfer-encoding")) {
                if (http_equal_ci(data, value_start, end, "chunked")) { self.chunked = true; }
            } else if (http_equal_ci(data, header_start, colon, "connection")) {
                if (http_equal_ci(data, value_start, end, "close")) { self.close_delimited = true; }
            }
            header_start = end + 2;
        }
        // RFC 9112 §6.1: Transfer-Encoding overrides Content-Length to prevent request/response smuggling
        if (self.chunked) {
            self.content_length = -1;
        }
        // Reuse the headers buffer in place: assigning a fresh substr over
        // the String.new() empty buffer would leak it (field overwrites have
        // no pre-drop).
        self.headers.clear();
        self.headers.push_bytes(&raw.data[line_end + 2], raw.len - line_end - 2);
        return Ok(0);
    }

    Result<i64, Error> read_exact(*self, StreamIo* io, i64 count, i64 max_body) {
        if (count < 0 || count > max_body) { return Err(HTTP_ERR_LIMIT, "response exceeds size limit"); }
        i64 done = 0;
        u8 buf[1024];
        while (done < count) {
            i64 want = count - done;
            if (want > 1024) { want = 1024; }
            Result<i64, Error> r = transport_read(io, &buf[0], want);
            if (r.is_err() || r.value() == 0) { return Err(HTTP_ERR_IO, "I/O error"); }
            self.body.push_bytes(&buf[0], r.value());
            done = done + r.value();
        }
        return Ok(done);
    }

    Result<i64, Error> read_chunked(*self, StreamIo* io, i64 max_body) {
        i64 total = 0;
        String line = String.new();
        u8 byte[1];
        while (true) {
            if (!http_read_line(io, &line, HTTP_CHUNK_LINE_MAX)) {
                return Err(HTTP_ERR_IO, "I/O error");
            }
            i64 size = 0;
            if (!http_parse_hex(line.data, 0, line.len, &mut size)) {
                return Err(HTTP_ERR_MALFORMED, "malformed response");
            }
            if (size == 0) {
                // Zero-size chunk: consume trailers until the blank line.
                self.trailers.clear();
                while (true) {
                    if (!http_read_line(io, &line, HTTP_CHUNK_LINE_MAX)) {
                        return Err(HTTP_ERR_IO, "I/O error");
                    }
                    if (line.len == 0) { return Ok(total); }
                    self.trailers.push_str((str)line.data);
                    self.trailers.push_str("\r\n");
                }
            }
            if (total + size > max_body) { return Err(HTTP_ERR_LIMIT, "response exceeds size limit"); }
            Result<i64, Error> got = self.read_exact(io, size, max_body);
            if (got.is_err()) { return got; }
            Result<i64, Error> crlf = transport_read(io, &byte[0], 1);
            if (crlf.is_err() || crlf.value() != 1 || byte[0] != (u8)'\r') {
                return Err(HTTP_ERR_MALFORMED, "malformed response");
            }
            crlf = transport_read(io, &byte[0], 1);
            if (crlf.is_err() || crlf.value() != 1 || byte[0] != (u8)'\n') {
                return Err(HTTP_ERR_MALFORMED, "malformed response");
            }
            total = total + size;
        }
        // Unreachable — the loop above only exits via `return`.
        return Err(HTTP_ERR_MALFORMED, "malformed response");
    }

    Result<i64, Error> read_body(*self, StreamIo* io, bool head, i64 max_body) {
        if (http_status_has_no_body(self.status, head)) { return Ok(0); }
        if (self.chunked) { return self.read_chunked(io, max_body); }
        if (self.content_length >= 0) { return self.read_exact(io, self.content_length, max_body); }
        // No framing headers: the body is close-delimited, read until EOF.
        self.close_delimited = true;
        u8 buf[1024];
        i64 total = 0;
        while (true) {
            Result<i64, Error> r = transport_read(io, &buf[0], 1024);
            if (r.is_err()) { return Err(HTTP_ERR_IO, "I/O error"); }
            if (r.value() == 0) { return Ok(total); }
            if (total + r.value() > max_body) { return Err(HTTP_ERR_LIMIT, "response exceeds size limit"); }
            self.body.push_bytes(&buf[0], r.value());
            total = total + r.value();
        }
        // Unreachable — the loop above only exits via `return`.
        return Err(HTTP_ERR_IO, "I/O error");
    }

    /// The value of `name` (case-insensitive) in the response headers, or
    /// an empty string when absent. Mirrors Go's Header.Get.
    String get_header(*self, str name) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, name)) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                return self.headers.substr(value_start, end - value_start);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return String.new();
    }

    /// Go's Response.Cookies: every Set-Cookie header, parsed into owned
    /// cookies. The caller owns the vector and its elements (use
    /// http_cookie_vec_drop to discard, or a CookieJar.set_cookies which
    /// consumes them).
    Vec<Cookie> cookies(*self) {
        Vec<Cookie> out = Vec<Cookie>.new();
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, "set-cookie")) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                http_parse_set_cookie_value(data, value_start, end, &mut out);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return out;
    }

    /// "200 OK"-style status text. Mirrors Go's Response.Status.
    String status_text(*self) {
        String text = String.new();
        http_append_i64(&mut text, (i64)self.status);
        text.push((u8)' ');
        text.push_str((str)self.reason.data);
        return move text;
    }

    /// The Location header value (redirect target), or an empty string.
    String location(*self) {
        u8* data = self.headers.data;
        i64 len = self.headers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, "location")) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                return self.headers.substr(value_start, end - value_start);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return String.new();
    }

    /// The value of the first trailer field with the given name (case-insensitive), or
    /// an empty string when absent. Trailers are only present on chunked responses
    /// that included trailing header fields after the zero chunk.
    String get_trailer(*self, str name) {
        u8* data = self.trailers.data;
        i64 len = self.trailers.len;
        i64 pos = 0;
        while (pos < len) {
            i64 end = http_find_crlf(data, len, pos);
            if (end < 0) { end = len; }
            i64 colon = pos;
            while (colon < end && data[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end
                && http_equal_ci(data, pos, colon, name)) {
                i64 value_start = colon + 1;
                while (value_start < end && http_is_space(data[value_start])) { value_start = value_start + 1; }
                return self.trailers.substr(value_start, end - value_start);
            }
            if (end >= len) { break; }
            pos = end + 2;
        }
        return String.new();
    }

    /// Read the head, skipping interim 1xx responses (100 Continue, 102, 103)
    /// until the final response; 101 Switching Protocols is final.
    Result<i64, Error> read_final_head(*self, StreamIo* io, i64 max_header) {
        Result<i64, Error> h = self.read_head(io, max_header);
        if (h.is_err()) { return h; }
        while (http_status_is_informational(self.status)
            && self.status != (i32)HttpStatus.SwitchingProtocols) {
            h = self.read_head(io, max_header);
            if (h.is_err()) { return h; }
        }
        return Ok(0);
    }

    Result<i64, Error> read(*self, StreamIo* io, bool head, i64 max_header, i64 max_body) {
        Result<i64, Error> h = self.read_final_head(io, max_header);
        if (h.is_err()) { return h; }
        return self.read_body(io, head, max_body);
    }
}

impl Drop for HttpResponse {
    void drop(*self) {
        self.reason.drop();
        self.headers.drop();
        self.body.drop();
        self.trailers.drop();
    }
}

// --- Streaming responses (Go's Response.Body) -----------------------------
// A streamed response carries the head plus an owned connection; read()
// pulls body bytes incrementally, honoring the framing (content-length,
// chunked, close-delimited). close() returns the connection to the client's
// pool when the body was fully consumed and the peer kept it alive.

struct HttpStream {
    HttpResponse head; // status/headers/reason; body stays empty
    HttpConnection conn; // owned; returned to the pool on close
    HttpClient* pool_owner; // null when the client cannot pool
    u8 key_host[255]; // pool key
    u16 key_port;
    bool key_https;
    i64 body_remaining; // content-length remaining (when content_length >= 0)
    String chunk_line; // reusable line buffer for chunked reads
    i64 chunk_remaining;
    bool chunk_want_size;
    bool body_finished;
    bool stream_active;
}

impl HttpStream {
    HttpStream new(HttpResponse head, HttpConnection conn, HttpClient* owner,
                   str host, u16 port, bool https) {
        HttpStream stream;
        stream.head = move head;
        stream.conn = move conn;
        stream.pool_owner = owner;
        u8* src = (u8*)host;
        i64 k = 0;
        while (k < 254 && src[k] != (u8)0) {
            stream.key_host[k] = src[k];
            k = k + 1;
        }
        stream.key_host[k] = (u8)0;
        stream.key_port = port;
        stream.key_https = https;
        stream.body_remaining = stream.head.content_length;
        stream.chunk_line = String.new();
        stream.chunk_remaining = 0;
        stream.chunk_want_size = true;
        stream.body_finished = false;
        stream.stream_active = true;
        return stream;
    }

    i32 status(*self) { return self.head.status; }

    /// The value of `name` (case-insensitive) in the response headers, or an
    /// empty string when absent.
    String get_header(*self, str name) {
        return self.head.get_header(name);
    }

    /// The value of `name` (case-insensitive) in the response trailers, or an
    /// empty string when absent or before the stream has finished reading.
    String get_trailer(*self, str name) {
        return self.head.get_trailer(name);
    }

    /// "200 OK"-style status text.
    String status_text(*self) {
        return self.head.status_text();
    }

    /// Read up to `len` body bytes, honoring the response framing. Returns 0
    /// at end of body. The transport is derived from the owned connection on
    /// each call (a self-referential io field would dangle when the stream
    /// value moves).
    Result<i64, Error> read(*self, u8* buf, i64 len) {
        if (!self.stream_active) {
            return Err(HTTP_ERR_IO, "stream is closed");
        }
        if (self.body_finished) { return Ok(0); }
        StreamIo io = http_transport_io(&self.conn);
        if (self.head.chunked) { return self.read_chunked(&io, buf, len); }
        if (self.head.content_length >= 0) {
            i64 want = len;
            if (want > self.body_remaining) { want = self.body_remaining; }
            Result<i64, Error> r = transport_read(&io, buf, want);
            if (r.failed()) { return r; }
            self.body_remaining = self.body_remaining - r.value();
            if (self.body_remaining <= 0) { self.body_finished = true; }
            return r;
        }
        // Close-delimited: read until EOF.
        Result<i64, Error> r = transport_read(&io, buf, len);
        if (r.failed()) { return r; }
        if (r.value() == 0) { self.body_finished = true; }
        return r;
    }

    /// Framing-aware chunked read: parses chunk sizes and CRLF separators as
    /// needed, returning up to `len` body bytes per call.
    Result<i64, Error> read_chunked(*self, StreamIo* io, u8* buf, i64 len) {
        while (true) {
            if (self.chunk_want_size) {
                if (!http_read_line(io, &self.chunk_line, HTTP_CHUNK_LINE_MAX)) {
                    return Err(HTTP_ERR_IO, "I/O error");
                }
                i64 size = 0;
                if (!http_parse_hex(self.chunk_line.data, 0, self.chunk_line.len, &mut size)) {
                    return Err(HTTP_ERR_MALFORMED, "malformed response");
                }
                if (size == 0) {
                    // Zero-size chunk: consume trailers until the blank line.
                    self.head.trailers.clear();
                    while (true) {
                        if (!http_read_line(io, &self.chunk_line, HTTP_CHUNK_LINE_MAX)) {
                            return Err(HTTP_ERR_IO, "I/O error");
                        }
                        if (self.chunk_line.len == 0) {
                            self.body_finished = true;
                            return Ok(0);
                        }
                        self.head.trailers.push_str((str)self.chunk_line.data);
                        self.head.trailers.push_str("\r\n");
                    }
                }
                self.chunk_remaining = size;
                self.chunk_want_size = false;
            }
            i64 want = len;
            if (want > self.chunk_remaining) { want = self.chunk_remaining; }
            Result<i64, Error> r = transport_read(io, buf, want);
            if (r.failed()) { return r; }
            self.chunk_remaining = self.chunk_remaining - r.value();
            if (self.chunk_remaining == 0) {
                // Consume the CRLF after the chunk.
                u8 byte[2];
                Result<i64, Error> c1 = transport_read(io, &byte[0], 1);
                if (c1.failed() || c1.value() != 1 || byte[0] != (u8)'\r') {
                    return Err(HTTP_ERR_MALFORMED, "malformed response");
                }
                Result<i64, Error> c2 = transport_read(io, &byte[1], 1);
                if (c2.failed() || c2.value() != 1 || byte[1] != (u8)'\n') {
                    return Err(HTTP_ERR_MALFORMED, "malformed response");
                }
                self.chunk_want_size = true;
            }
            return r;
        }
        // Unreachable — the loop above only exits via `return`.
        return Err(HTTP_ERR_MALFORMED, "malformed response");
    }

    /// Close the stream: return the connection to the pool when the body was
    /// fully consumed and the peer kept it alive, else close it.
    void close(*self) {
        if (!self.stream_active) { return; }
        self.stream_active = false;
        if (self.body_finished && !self.head.close_delimited
            && self.pool_owner != (HttpClient*)0 && self.pool_owner.use_pool) {
            self.conn.clear_timeout();
            HttpConnection pooled = self.conn;
            // Invalidate our copy so the compiler's field drop cannot close
            // the now-pooled fd or free the pooled connection's buffer.
            self.conn.stream.sock.fd = -1;
            self.conn.read_buf = (u8*)0;
            self.pool_owner.release((str)&self.key_host[0], self.key_port, self.key_https,
                move pooled);
        } else {
            self.conn.close();
        }
        self.chunk_line.drop();
        self.head.drop();
    }
}

impl Drop for HttpStream {
    void drop(*self) {
        self.close();
    }
}

// --- Client ---------------------------------------------------------------

impl HttpClient {
    HttpClient new() {
        HttpClient client;
        client.max_header_bytes = HTTP_DEFAULT_MAX_HEADER;
        client.max_body_bytes = HTTP_DEFAULT_MAX_BODY;
        client.max_redirects = HTTP_DEFAULT_MAX_REDIRECTS;
        client.use_jar = false;
        client.jar = CookieJar.new();
        client.tls_verify = true;
        client.tls_ca_file = String.new();
        client.use_pool = true;
        client.pool = ConnectionPool.new();
        client.timeout_secs = 0;
        return move client;
    }

    void limits(&mut self, i64 max_header, i64 max_body) {
        self.max_header_bytes = max_header;
        self.max_body_bytes = max_body;
    }

    void set_max_redirects(&mut self, i32 limit) {
        self.max_redirects = limit;
    }

    /// Attach a cookie jar (Go's Client.Jar). When set, the client stores
    /// Set-Cookie responses and sends matching cookies on later requests;
    /// without it the Cookie header is never touched (manual mode).
    void set_jar(&mut self, CookieJar jar) {
        self.jar.drop();
        self.jar = move jar;
        self.use_jar = true;
    }

    /// Disable peer certificate verification for https connections (Go's
    /// tls.Config.InsecureSkipVerify).
    void set_insecure_skip_verify(&mut self) {
        self.tls_verify = false;
    }

    /// Verify https peers against the CA bundle at `path` instead of the
    /// system trust store (Go's tls.Config.RootCAs).
    void set_ca_file(&mut self, str path) {
        self.tls_ca_file.drop();
        self.tls_ca_file = String.from_str(path);
    }

    Result<HttpConnection, Error> connect(*self, SocketAddr* addr, HttpVersion version) {
        Result<TcpStream, Error> connect_result = TcpStream.connect_timeout(addr, self.timeout_secs);
        if (connect_result.failed()) {
            Error e = connect_result.get_error();
            if (e.code == ETIMEDOUT) {
                return Err(HTTP_ERR_TIMEOUT, "connection timed out");
            }
            return Err(HTTP_ERR_CONNECT, "connection failed");
        }
        TcpStream stream = connect_result.unwrap();
        HttpConnection connection;
        connection.stream = move stream;
        connection.use_tls = false;
        connection.version = version;
        connection.is_h2 = false;
        connection.read_buf = (u8*)malloc(4096);
        connection.read_buf_len = 0;
        connection.read_buf_pos = 0;
        return Ok(move connection);
    }

    /// Limit on idle keep-alive connections kept per host (Go's
    /// MaxIdleConnsPerHost; default 2).
    void set_pool_max_idle(&mut self, i32 limit) {
        self.pool.max_idle = limit;
    }

    /// Bound each request to `secs` seconds (Go's Client.Timeout): blocking
    /// reads and writes on the connection, including the TLS handshake, fail
    /// after the timeout instead of hanging forever. 0 disables (default).
    void set_timeout(&mut self, i64 secs) {
        self.timeout_secs = secs;
    }

    /// Complete the TLS handshake on a fresh connection for an https URL.
    bool tls_handshake(*self, HttpConnection* conn, str host, Error* err) {
        bool ok = transport_tls_handshake(&conn.tls_state[0], conn.stream.sock.fd, host,
            self.tls_verify, (str)self.tls_ca_file.data, err);
        if (ok) { conn.use_tls = true; }
        return ok;
    }

    /// Take an idle pooled connection for (host, port, https), or open a
    /// fresh one. `reused` is true when the connection came from the pool;
    /// callers retry once on reused connections whose peer closed.
    Result<HttpConnection, Error> acquire(*self, str host, u16 port, bool https, bool* reused) {
        *reused = false;
        if (self.use_pool) {
            self.pool.lock.lock();
            i64 best = -1;
            i64 i = 0;
            while (i < self.pool.entries.len) {
                PoolEntry* e = &self.pool.entries.data[i];
                if (e.port == port && e.https == https
                    && http_host_eq((str)&e.host[0], host)) {
                    if (best < 0 || e.last_used > self.pool.entries.data[best].last_used) {
                        best = i;
                    }
                }
                i = i + 1;
            }
            if (best >= 0) {
                PoolEntry entry = http_pool_remove_at(&self.pool.entries, best);
                self.pool.lock.unlock();
                HttpConnection pooled = move entry.conn;
                *reused = true;
                return Ok(move pooled);
            }
            self.pool.lock.unlock();
        }
        return http_open(host, port, self.timeout_secs);
    }

    /// Return a fully-read, reusable connection to the pool, or close it.
    /// `conn` must have no unread response data.
    void release(*self, str host, u16 port, bool https, HttpConnection conn) {
        if (!self.use_pool) {
            conn.close();
            return;
        }
        self.pool.lock.lock();
        if (self.pool.entries.len >= (i64)self.pool.max_idle) {
            // Close the least recently used idle connection.
            i64 oldest = 0;
            i64 i = 1;
            while (i < self.pool.entries.len) {
                if (self.pool.entries.data[i].last_used < self.pool.entries.data[oldest].last_used) {
                    oldest = i;
                }
                i = i + 1;
            }
            PoolEntry evicted = http_pool_remove_at(&self.pool.entries, oldest);
            evicted.conn.close();
        }
        conn.read_buf_len = 0;
        conn.read_buf_pos = 0;
        PoolEntry entry;
        entry.conn = move conn;
        u8* src = (u8*)host;
        i64 k = 0;
        while (k < 254 && src[k] != (u8)0) {
            entry.host[k] = src[k];
            k = k + 1;
        }
        entry.host[k] = (u8)0;
        entry.port = port;
        entry.https = https;
        entry.last_used = g_pool_seq;
        g_pool_seq = g_pool_seq + 1;
        self.pool.entries.push(move entry);
        self.pool.lock.unlock();
    }

    /// One round trip: parse the URL, resolve the host, connect, send, and
    /// read the response. `body` is the request body and `headers` a raw
    /// CRLF-terminated header block ("Name: value\r\n..."); either may be
    /// null. Honors the client's configured size limits.
    /// One round trip: parse the URL, acquire a connection (pooled or fresh),
    /// send, and read the response. `body` is the request body and `headers`
    /// a raw CRLF-terminated header block ("Name: value\r\n..."); either may
    /// be null. Honors the client's configured size limits. Keep-alive
    /// connections are returned to the pool when the response is fully read
    /// and the peer did not close.
    Result<HttpResponse, Error> request(*self, str method, str url, str body, str headers) {
        HttpUrl parsed;
        if (!http_parse_url(url, &parsed)) {
            return Err(HTTP_ERR_MALFORMED, "malformed URL");
        }
        str host = (str)&parsed.host[0];
        bool reused = false;
        Result<HttpConnection, Error> opened = self.acquire(host, parsed.port, parsed.https, &mut reused);
        if (opened.failed()) { return Err(opened.get_error()); }
        HttpConnection conn = opened.unwrap();
        if (self.timeout_secs > 0) { conn.set_timeout(self.timeout_secs); }
        if (parsed.https && !reused) {
            Error err;
            if (!self.tls_handshake(&conn, host, &mut err)) {
                return Err(move err);
            }
        }
        if (conn.is_http2()) {
            StreamIo io = http_transport_io(&conn);
            H2Connection h2c;
            h2_init(&h2c, &io);
            if (h2_send_preface(&h2c) != 0) {
                conn.close();
                return Err(HTTP_ERR_IO, "H2 preface failed");
            }
            HpackField extra[32];
            i64 n_extra = http_parse_headers_to_hpack(headers, &extra[0], 32);
            H2Response h2resp;
            i64 rc = 0;
            if (body != (str)0 && strlen(body) > 0) {
                rc = h2_request_body(&h2c, method, "https", host, parsed.path,
                                     &extra[0], n_extra, (u8*)body, strlen(body), &h2resp);
            } else {
                rc = h2_request(&h2c, method, "https", host, parsed.path,
                                &extra[0], n_extra, &h2resp);
            }
            if (rc != 0) {
                conn.close();
                return Err(HTTP_ERR_IO, "H2 request failed");
            }
            HttpResponse response = HttpResponse.empty();
            response.version = HttpVersion.Http20;
            response.status = (i32)h2resp.status;
            response.reason.push_str(http_status_reason(response.status));
            i64 hi = 0;
            while (hi < h2resp.header_count) {
                response.headers.push_bytes(h2resp.headers[hi].name, h2resp.headers[hi].name_len);
                response.headers.push_str(": ");
                response.headers.push_bytes(h2resp.headers[hi].value, h2resp.headers[hi].value_len);
                response.headers.push_str("\r\n");
                hi += 1;
            }
            i64 ti = 0;
            while (ti < h2resp.trailer_count) {
                response.trailers.push_bytes(h2resp.trailers[ti].name, h2resp.trailers[ti].name_len);
                response.trailers.push_str(": ");
                response.trailers.push_bytes(h2resp.trailers[ti].value, h2resp.trailers[ti].value_len);
                response.trailers.push_str("\r\n");
                ti += 1;
            }
            if (h2resp.body != (u8*)0 && h2resp.body_len > 0) {
                response.body.push_bytes(h2resp.body, h2resp.body_len);
                response.content_length = h2resp.body_len;
            } else {
                response.content_length = 0;
            }
            h2_free_response(&h2resp);
            conn.close();
            return Ok(move response);
        }
        HttpRequest req = HttpRequest.new(HttpVersion.Http11, method, parsed.path, host);
        if (headers != (str)0) { req.headers.push_str(headers); }
        if (body != (str)0) { req.set_body(body); }
        if (self.use_pool) { req.keep_alive(); }
        Result<HttpResponse, Error> r = conn.send(&req, self.max_header_bytes, self.max_body_bytes);
        if (r.failed() && reused) {

            // The pooled connection's peer closed it while idle; discard and
            // retry once on a fresh connection (nothing was sent).
            conn.close();
            bool reused2 = false;
            Result<HttpConnection, Error> reopened = self.acquire(host, parsed.port, parsed.https, &mut reused2);
            if (!reopened.failed()) {
                HttpConnection fresh = reopened.unwrap();
                bool ok = true;
                if (parsed.https) {
                    Error err;
                    ok = self.tls_handshake(&fresh, host, &mut err);
                    if (!ok) {
                        fresh.close();
                        return Err(move err);
                    }
                }
                if (ok) {
                    conn = move fresh;
                    if (self.timeout_secs > 0) { conn.set_timeout(self.timeout_secs); }
                    r = conn.send(&req, self.max_header_bytes, self.max_body_bytes);
                }
            }
        }
        if (r.failed()) {
            if (self.timeout_secs > 0) { conn.clear_timeout(); }
            conn.close();
            return Err(r.get_error());
        }
        HttpResponse response = r.unwrap();
        if (self.timeout_secs > 0) { conn.clear_timeout(); }
        if (self.use_pool && !response.close_delimited) {
            self.release(host, parsed.port, parsed.https, move conn);
        } else {
            conn.close();
        }
        return Ok(move response);
    }

    /// One streaming round trip: like `request`, but only the response head
    /// is read; the caller streams the body via HttpStream.read() and closes
    /// it (returning the connection to the pool).
    /// One streaming round trip: like `request`, but only the response head
    /// is read; the caller streams the body via HttpStream.read() and closes
    /// it (returning the connection to the pool).
    Result<HttpStream, Error> request_stream(*self, str method, str url, str body, str headers) {
        HttpUrl parsed;
        if (!http_parse_url(url, &parsed)) {
            return Err(HTTP_ERR_MALFORMED, "malformed URL");
        }
        str host = (str)&parsed.host[0];
        bool reused = false;
        Result<HttpConnection, Error> opened = self.acquire(host, parsed.port, parsed.https, &mut reused);
        if (opened.failed()) { return Err(opened.get_error()); }
        HttpConnection conn = opened.unwrap();
        if (self.timeout_secs > 0) { conn.set_timeout(self.timeout_secs); }
        if (parsed.https && !reused) {
            Error err;
            if (!self.tls_handshake(&conn, host, &mut err)) {
                return Err(move err);
            }
        }
        HttpRequest req = HttpRequest.new(HttpVersion.Http11, method, parsed.path, host);
        if (headers != (str)0) { req.headers.push_str(headers); }
        if (body != (str)0) { req.set_body(body); }
        if (self.use_pool) { req.keep_alive(); }
        Result<HttpResponse, Error> h = conn.send_head(&req, self.max_header_bytes);
        if (h.failed() && reused) {
            // The pooled connection's peer closed it while idle; retry once.
            conn.close();
            bool reused2 = false;
            Result<HttpConnection, Error> reopened = self.acquire(host, parsed.port, parsed.https, &mut reused2);
            if (!reopened.failed()) {
                HttpConnection fresh = reopened.unwrap();
                bool ok = true;
                if (parsed.https) {
                    Error err;
                    ok = self.tls_handshake(&fresh, host, &mut err);
                    if (!ok) {
                        fresh.close();
                        return Err(move err);
                    }
                }
                if (ok) {
                    conn = move fresh;
                    if (self.timeout_secs > 0) { conn.set_timeout(self.timeout_secs); }
                    h = conn.send_head(&req, self.max_header_bytes);
                }
            }
        }
        if (h.failed()) {
            conn.close();
            return Err(h.get_error());
        }
        HttpResponse head = h.unwrap();
        HttpStream stream = HttpStream.new(move head, move conn, self, host, parsed.port, parsed.https);
        return Ok(move stream);
    }

    /// Go's Client.Do: performs `request`, following 301/302/303/307/308
    /// redirects up to max_redirects (default 10). 301/302/303 switch to GET
    /// and drop the body (HEAD stays HEAD); 307/308 preserve method and
    /// body. Location resolves against the current URL (absolute,
    /// protocol-relative, or root-relative); when it cannot be resolved
    /// (e.g. https) the 3xx response is returned as-is. Manual requests
    /// (built with the version/target/host constructor) are sent once to
    /// port 80 without redirect handling.
    Result<HttpResponse, Error> do(*self, HttpRequest* request) {
        if (request.url == (str)0) {
            bool reused = false;
            Result<HttpConnection, Error> opened = self.acquire(request.host, 80, false, &mut reused);
            if (opened.failed()) { return Err(opened.get_error()); }
            HttpConnection conn = opened.unwrap();
            if (self.timeout_secs > 0) { conn.set_timeout(self.timeout_secs); }
            Result<HttpResponse, Error> r = conn.send(request, self.max_header_bytes, self.max_body_bytes);
            if (r.failed() && reused) {
                conn.close();
                bool reused2 = false;
                Result<HttpConnection, Error> reopened = self.acquire(request.host, 80, false, &mut reused2);
                if (!reopened.failed()) {
                    conn = reopened.unwrap();
                    if (self.timeout_secs > 0) { conn.set_timeout(self.timeout_secs); }
                    r = conn.send(request, self.max_header_bytes, self.max_body_bytes);
                }
            }
            if (r.failed()) {
                if (self.timeout_secs > 0) { conn.clear_timeout(); }
                conn.close();
                return Err(r.get_error());
            }
            HttpResponse response = r.unwrap();
            if (self.timeout_secs > 0) { conn.clear_timeout(); }
            if (self.use_pool && !request.close && !response.close_delimited) {
                self.release(request.host, 80, false, move conn);
            } else {
                conn.close();
            }
            return Ok(move response);
        }
        str url = request.url;
        str method = request.method;
        str body = request.body;
        str headers = (str)request.headers.data;
        i32 redirects = 0;
        String next_url = String.new();
        String hop_headers = String.new();
        String scrubbed = String.new();
        // Origin for sensitive-header scoping (Go: Authorization and Cookie
        // headers are dropped when a redirect leaves the host:port).
        str origin_host = (str)0;
        u16 origin_port = 0;
        {
            HttpUrl parsed0;
            if (http_parse_url(request.url, &parsed0)) {
                origin_host = (str)&parsed0.host[0];
                origin_port = parsed0.port;
            }
        }
        while (true) {
            str hop_block = headers;
            if (self.use_jar) {
                hop_headers.clear();
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    String cookie_block = self.jar.cookies_for(host, parsed.path, parsed.https);
                    if (cookie_block.len > 0) {
                        if (headers != (str)0) { hop_headers.push_str(headers); }
                        hop_headers.push_str("Cookie: ");
                        hop_headers.push_str((str)cookie_block.data);
                        hop_headers.push_str("\r\n");
                        hop_block = (str)hop_headers.data;
                    }
                    cookie_block.drop();
                }
            }
            Result<HttpResponse, Error> r = self.request(method, url, body, hop_block);
            if (r.failed()) { return r; }
            HttpResponse response = r.unwrap();
            if (self.use_jar) {
                // Store response cookies against the request URL (Go stores
                // against req.URL, so redirect hops update the jar per hop).
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    Vec<Cookie> incoming = response.cookies();
                    self.jar.set_cookies(host, parsed.path, &mut incoming);
                    incoming.drop();
                }
            }
            bool follow = false;
            bool redirect_status = response.status == (i32)HttpStatus.MovedPermanently
                || response.status == (i32)HttpStatus.Found
                || response.status == (i32)HttpStatus.SeeOther
                || response.status == (i32)HttpStatus.TemporaryRedirect
                || response.status == (i32)HttpStatus.PermanentRedirect;
            if (redirect_status) {
                String location = response.location();
                if (location.len > 0) {
                    if (redirects >= self.max_redirects) {
                        return Err(HTTP_ERR_REDIRECT, "too many redirects");
                    }
                    next_url = http_resolve_url(url, (str)location.data);
                    if (next_url.len > 0) { follow = true; }
                }
            }
            if (!follow) { return Ok(move response); }
            bool preserve = response.status == (i32)HttpStatus.TemporaryRedirect
                || response.status == (i32)HttpStatus.PermanentRedirect;
            if (!preserve && method != "HEAD") { method = "GET"; body = (str)0; }
            url = (str)next_url.data;
            // Cross-host redirect: drop sensitive headers (Go's rule).
            HttpUrl hop_parsed;
            if (origin_host != (str)0 && http_parse_url(url, &hop_parsed)
                && (!http_host_eq((str)&hop_parsed.host[0], origin_host)
                    || hop_parsed.port != origin_port)) {
                scrubbed.clear();
                http_strip_sensitive_headers(headers, &scrubbed);
                headers = (str)scrubbed.data;
            }
            redirects = redirects + 1;
            // The intermediate response drops at loop scope end; the next
            // iteration sends the follow-up request.
        }
        // Unreachable — the loop above only exits via `return`.
        return Err(HTTP_ERR_REDIRECT, "too many redirects");
    }

    /// Go's Client.Do returning a streaming body: follows redirects (each
    /// 3xx hop's connection is closed, since its body is discarded) and
    /// returns the final response with the body unread. Manual requests have
    /// no URL to resolve redirects against and cannot stream.
    Result<HttpStream, Error> do_stream(*self, HttpRequest* request) {
        if (request.url == (str)0) {
            return Err(HTTP_ERR_MALFORMED, "streaming requires a URL");
        }
        str url = request.url;
        str method = request.method;
        str body = request.body;
        str headers = (str)request.headers.data;
        i32 redirects = 0;
        String next_url = String.new();
        String hop_headers = String.new();
        String scrubbed = String.new();
        // Origin for sensitive-header scoping (Go: Authorization and Cookie
        // headers are dropped when a redirect leaves the host:port).
        str origin_host = (str)0;
        u16 origin_port = 0;
        {
            HttpUrl parsed0;
            if (http_parse_url(request.url, &parsed0)) {
                origin_host = (str)&parsed0.host[0];
                origin_port = parsed0.port;
            }
        }
        while (true) {
            str hop_block = headers;
            if (self.use_jar) {
                hop_headers.clear();
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    String cookie_block = self.jar.cookies_for(host, parsed.path, parsed.https);
                    if (cookie_block.len > 0) {
                        if (headers != (str)0) { hop_headers.push_str(headers); }
                        hop_headers.push_str("Cookie: ");
                        hop_headers.push_str((str)cookie_block.data);
                        hop_headers.push_str("\r\n");
                        hop_block = (str)hop_headers.data;
                    }
                    cookie_block.drop();
                }
            }
            Result<HttpStream, Error> s = self.request_stream(method, url, body, hop_block);
            if (s.failed()) { return s; }
            HttpStream stream = s.unwrap();
            if (self.use_jar) {
                HttpUrl parsed;
                if (http_parse_url(url, &parsed)) {
                    str host = (str)&parsed.host[0];
                    Vec<Cookie> incoming = stream.head.cookies();
                    self.jar.set_cookies(host, parsed.path, &mut incoming);
                    incoming.drop();
                }
            }
            bool follow = false;
            bool redirect_status = stream.head.status == (i32)HttpStatus.MovedPermanently
                || stream.head.status == (i32)HttpStatus.Found
                || stream.head.status == (i32)HttpStatus.SeeOther
                || stream.head.status == (i32)HttpStatus.TemporaryRedirect
                || stream.head.status == (i32)HttpStatus.PermanentRedirect;
            if (redirect_status) {
                String location = stream.head.location();
                if (location.len > 0) {
                    if (redirects >= self.max_redirects) {
                        return Err(HTTP_ERR_REDIRECT, "too many redirects");
                    }
                    next_url = http_resolve_url(url, (str)location.data);
                    if (next_url.len > 0) { follow = true; }
                }
            }
            if (!follow) { return Ok(move stream); }
            bool preserve = stream.head.status == (i32)HttpStatus.TemporaryRedirect
                || stream.head.status == (i32)HttpStatus.PermanentRedirect;
            if (!preserve && method != "HEAD") { method = "GET"; body = (str)0; }
            url = (str)next_url.data;
            // Cross-host redirect: drop sensitive headers (Go's rule).
            HttpUrl hop_parsed;
            if (origin_host != (str)0 && http_parse_url(url, &hop_parsed)
                && (!http_host_eq((str)&hop_parsed.host[0], origin_host)
                    || hop_parsed.port != origin_port)) {
                scrubbed.clear();
                http_strip_sensitive_headers(headers, &scrubbed);
                headers = (str)scrubbed.data;
            }
            redirects = redirects + 1;
            stream.close(); // discard the 3xx hop (its body is unread)
        }
        // Unreachable — the loop above only exits via `return`.
        return Err(HTTP_ERR_REDIRECT, "too many redirects");
    }

    /// Go's Client.Get with a streaming body: fetch the head, then stream
    /// the body via HttpStream.read().
    Result<HttpStream, Error> get_stream(*self, str url) {
        HttpRequest req = HttpRequest.new("GET", url, (str)0);
        return self.do_stream(&req);
    }

    Result<HttpResponse, Error> get(*self, str url) {
        HttpRequest req = HttpRequest.new("GET", url, (str)0);
        return self.do(&req);
    }

    Result<HttpResponse, Error> get(*self, str url, str body) {
        HttpRequest req = HttpRequest.new("GET", url, body);
        return self.do(&req);
    }

    Result<HttpResponse, Error> get(*self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("GET", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> post(*self, str url) {
        return self.post(url, (str)0, (str)0);
    }

    /// Go's Client.Post: `content_type` is sent as the Content-Type header
    /// (null omits it). Custom headers go through NewRequest + Do.
    Result<HttpResponse, Error> post(*self, str url, str content_type, str body) {
        HttpRequest req = HttpRequest.new("POST", url, body);
        if (content_type != (str)0) { req.header("Content-Type", content_type); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> put(*self, str url) {
        return self.put(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> put(*self, str url, str body) {
        return self.put(url, body, (str)0);
    }

    Result<HttpResponse, Error> put(*self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("PUT", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> delete(*self, str url) {
        return self.delete(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> delete(*self, str url, str body) {
        return self.delete(url, body, (str)0);
    }

    Result<HttpResponse, Error> delete(*self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("DELETE", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> head(*self, str url) {
        return self.head(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> head(*self, str url, str body) {
        return self.head(url, body, (str)0);
    }

    Result<HttpResponse, Error> head(*self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("HEAD", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }

    Result<HttpResponse, Error> patch(*self, str url) {
        return self.patch(url, (str)0, (str)0);
    }

    Result<HttpResponse, Error> patch(*self, str url, str body) {
        return self.patch(url, body, (str)0);
    }

    Result<HttpResponse, Error> patch(*self, str url, str body, str headers) {
        HttpRequest req = HttpRequest.new("PATCH", url, body);
        if (headers != (str)0) { req.headers.push_str(headers); }
        return self.do(&req);
    }
}

impl Drop for HttpClient {
    void drop(*self) {
        self.jar.drop();
        self.tls_ca_file.drop();
        self.pool.drop();
    }
}

impl HttpConnection {
    /// Write the request and read the response head (interim 1xx skipped),
    /// leaving the body unread. The caller keeps the connection.
    Result<HttpResponse, Error> send_head(*self, HttpRequest* request, i64 max_header) {
        StreamIo io = http_transport_io(self);
        Result<i64, Error> written = request.write(&io);
        if (written.is_err()) { return Err(HTTP_ERR_IO, "I/O error"); }
        HttpResponse response = HttpResponse.empty();
        Result<i64, Error> h = response.read_final_head(&io, max_header);
        if (h.is_err()) { return Err(h.get_error()); }
        return Ok(move response);
    }

    Result<HttpResponse, Error> send(*self, HttpRequest* request, i64 max_header, i64 max_body) {
        Result<HttpResponse, Error> h = self.send_head(request, max_header);
        if (h.failed()) { return h; }
        HttpResponse response = h.unwrap();
        StreamIo io = http_transport_io(self);
        Result<i64, Error> b = response.read_body(&io, request.method == "HEAD", max_body);
        if (b.is_err()) { return Err(b.get_error()); }
        if (request.close || response.close_delimited) { self.close(); }
        return Ok(move response);
    }

    void close(*self) {
        if (self.use_tls) { transport_tls_close(&self.tls_state[0]); }
        self.stream.close();
        if (self.read_buf != (u8*)0) {
            free((void*)self.read_buf);
            self.read_buf = (u8*)0;
        }
    }

    /// Bound blocking reads and writes to `secs` seconds (Go's Client.Timeout
    /// approximation: each socket operation is bounded, including the TLS
    /// handshake and buffered refills).
    void set_timeout(*self, i64 secs) {
        self.stream.sock.set_recv_timeout(secs);
        self.stream.sock.set_send_timeout(secs);
    }

    /// Remove the read/write timeouts (before returning to the pool).
    void clear_timeout(*self) {
        self.stream.sock.set_recv_timeout(0);
        self.stream.sock.set_send_timeout(0);
    }

    /// True when the connection has negotiated HTTP/2 via ALPN.
    bool is_http2(*self) {
        if (self.is_h2) { return true; }
        if (self.use_tls && transport_tls_is_h2((void*)&self.tls_state[0])) {
            self.is_h2 = true;
            return true;
        }
        return false;
    }

    HttpConnection from_stream(TcpStream stream) {
        HttpConnection conn;
        conn.stream = move stream;
        conn.use_tls = false;
        conn.version = HttpVersion.Http11;
        conn.is_h2 = false;
        conn.read_buf = (u8*)malloc(4096);
        conn.read_buf_len = 0;
        conn.read_buf_pos = 0;
        return move conn;
    }

    void push_back(*self, u8* buf, i64 len) {
        if (len <= 0) { return; }
        if (self.read_buf == (u8*)0) {
            self.read_buf = (u8*)malloc(4096);
        }
        for (i64 i = 0; i < len; i = i + 1) {
            self.read_buf[i] = buf[i];
        }
        self.read_buf_len = len;
        self.read_buf_pos = 0;
    }
}

// --- Server Utilities -----------------------------------------------------

void http_append_hex(String* out, i64 val) {
    if (val == 0) {
        out.push((u8)'0');
        return;
    }
    u8 digits[16];
    i64 n = 0;
    i64 v = val;
    while (v > 0) {
        i64 rem = v % 16;
        if (rem < 10) { digits[n] = (u8)('0' + rem); }
        else { digits[n] = (u8)('a' + (rem - 10)); }
        v = v / 16;
        n = n + 1;
    }
    while (n > 0) {
        n = n - 1;
        out.push(digits[n]);
    }
}

void http_parse_host_port(str addr, String* out_ip, u16* out_port) {
    out_ip.clear();
    if (addr == (str)0 || strlen(addr) == 0) {
        out_ip.push_str("0.0.0.0");
        *out_port = (u16)80;
        return;
    }
    u8* s = (u8*)addr;
    i64 len = strlen(addr);
    if (s[0] == (u8)':') {
        out_ip.push_str("0.0.0.0");
        i64 p = 0;
        http_parse_i64(s, 1, len, &mut p);
        *out_port = (u16)p;
        return;
    }
    i64 colon = -1;
    for (i64 i = 0; i < len; i = i + 1) {
        if (s[i] == (u8)':') { colon = i; break; }
    }
    if (colon >= 0) {
        out_ip.push_bytes(s, colon);
        i64 p = 0;
        http_parse_i64(s, colon + 1, len, &mut p);
        *out_port = (u16)p;
        return;
    }
    out_ip.push_str(addr);
    *out_port = (u16)80;
}

// --- ResponseWriter (Go's http.ResponseWriter) ----------------------------

struct ResponseWriter {
    StreamIo io;
    HttpVersion version;
    i32 status_code;
    String headers;
    bool header_written;
    bool chunked;
    bool close_connection;
    bool is_h2;
    i64 h2_stream_id;
    void* h2_conn_ptr;
}

impl ResponseWriter {
    ResponseWriter new(StreamIo io, HttpVersion version, bool close_conn) {
        ResponseWriter w;
        w.io = io;
        w.version = version;
        w.status_code = 200;
        w.headers = String.new();
        w.header_written = false;
        w.chunked = false;
        w.close_connection = close_conn;
        w.is_h2 = false;
        w.h2_stream_id = 0;
        w.h2_conn_ptr = (void*)0;
        return move w;
    }

    /// Set response header field. Mirrors Go's w.Header().Set(k, v).
    void set_header(&mut self, str name, str value) {
        self.headers.push_str(name);
        self.headers.push_str(": ");
        self.headers.push_str(value);
        self.headers.push_str("\r\n");
    }

    /// Write HTTP status code. Mirrors Go's w.WriteHeader(code).
    void write_header(&mut self, i32 status) {
        if (self.header_written) { return; }
        self.status_code = status;
        self.flush_header(-1);
    }

    void flush_header(&mut self, i64 content_len) {
        if (self.header_written) { return; }
        self.header_written = true;

        if (self.is_h2) {
            h2_send_response_headers((H2Connection*)self.h2_conn_ptr, self.h2_stream_id, self.status_code, (str)self.headers.data, content_len == 0);
            return;
        }

        String wire = String.new();
        wire.push_str("HTTP/1.1 ");
        http_append_i64(&mut wire, (i64)self.status_code);
        wire.push((u8)' ');
        wire.push_str(http_status_reason(self.status_code));
        wire.push_str("\r\n");

        bool has_cl = false;
        u8* hdata = self.headers.data;
        i64 hlen = self.headers.len;
        i64 pos = 0;
        while (pos < hlen) {
            i64 end = http_find_crlf(hdata, hlen, pos);
            if (end < 0) { end = hlen; }
            i64 colon = pos;
            while (colon < end && hdata[colon] != (u8)':') { colon = colon + 1; }
            if (colon > pos && colon < end && http_equal_ci(hdata, pos, colon, "content-length")) {
                has_cl = true;
                break;
            }
            if (end >= hlen) { break; }
            pos = end + 2;
        }

        if (!has_cl) {
            if (content_len >= 0) {
                wire.push_str("Content-Length: ");
                http_append_i64(&mut wire, content_len);
                wire.push_str("\r\n");
            } else if (self.version == HttpVersion.Http11 && !self.close_connection) {
                wire.push_str("Transfer-Encoding: chunked\r\n");
                self.chunked = true;
            }
        }

        if (self.close_connection) {
            wire.push_str("Connection: close\r\n");
        }

        wire.push_str((str)self.headers.data);
        wire.push_str("\r\n");
        transport_write(&self.io, (u8*)wire.data, wire.len);
        wire.drop();
    }

    /// Write response payload. Mirrors Go's w.Write(p).
    Result<i64, Error> write(&mut self, u8* buf, i64 len) {
        if (!self.header_written) {
            self.flush_header(-1);
        }
        if (len <= 0) { return Ok(0); }
        if (self.is_h2) {
            i64 r = h2_send_response_data((H2Connection*)self.h2_conn_ptr, self.h2_stream_id, buf, len, false);
            if (r != 0) { return Err(HTTP_ERR_IO, "HTTP/2 data write failed"); }
            return Ok(len);
        }
        if (self.chunked) {
            return self.write_chunk(buf, len);
        }
        return transport_write(&self.io, buf, len);
    }

    /// Write string response payload.
    Result<i64, Error> write_str(&mut self, str text) {
        if (text == (str)0) { return Ok(0); }
        return self.write((u8*)text, strlen(text));
    }

    Result<i64, Error> write_chunk(&mut self, u8* buf, i64 len) {
        if (len <= 0) { return Ok(0); }
        String ch = String.new();
        http_append_hex(&mut ch, len);
        ch.push_str("\r\n");
        Result<i64, Error> r1 = transport_write(&self.io, (u8*)ch.data, ch.len);
        ch.drop();
        if (r1.is_err()) { return r1; }
        Result<i64, Error> r2 = transport_write(&self.io, buf, len);
        if (r2.is_err()) { return r2; }
        Result<i64, Error> r3 = transport_write(&self.io, (u8*)"\r\n", 2);
        if (r3.is_err()) { return r3; }
        return Ok(len);
    }

    void finish(&mut self) {
        if (!self.header_written) {
            self.flush_header(0);
        }
        if (self.is_h2) {
            h2_send_response_data((H2Connection*)self.h2_conn_ptr, self.h2_stream_id, (u8*)0, 0, true);
            return;
        }
        if (self.chunked) {
            transport_write(&self.io, (u8*)"0\r\n\r\n", 5);
        }
    }
}

impl Drop for ResponseWriter {
    void drop(*self) {
        self.headers.drop();
    }
}

// --- Routing & Multiplexer (Go's http.ServeMux) ---------------------------

struct RouteEntry {
    str pattern;
    void(ResponseWriter*, HttpRequest*) handler;
}

struct ServeMux {
    Vec<RouteEntry> routes;
}

impl ServeMux {
    ServeMux new() {
        ServeMux mux;
        mux.routes = Vec<RouteEntry>.new();
        return move mux;
    }

    void handle_func(&mut self, str pattern, void(ResponseWriter*, HttpRequest*) handler) {
        RouteEntry e;
        e.pattern = pattern;
        e.handler = handler;
        self.routes.push(e);
    }

    void serve_http(&mut self, ResponseWriter* w, HttpRequest* r) {
        str p = r.path();
        i64 plen = strlen(p);
        i64 n = self.routes.len();

        for (i64 i = 0; i < n; i = i + 1) {
            RouteEntry* e = self.routes.get_ptr(i);
            if (strcmp(e.pattern, p) == 0) {
                void(ResponseWriter*, HttpRequest*) h = e.handler;
                h(w, r);
                return;
            }
        }

        i64 best_idx = -1;
        i64 best_len = -1;
        for (i64 i = 0; i < n; i = i + 1) {
            RouteEntry* e = self.routes.get_ptr(i);
            i64 elen = strlen(e.pattern);
            if (elen > best_len && plen >= elen) {
                if (memcmp((const void*)p, (const void*)e.pattern, elen) == 0) {
                    best_idx = i;
                    best_len = elen;
                }
            }
        }

        if (best_idx >= 0) {
            RouteEntry* e = self.routes.get_ptr(best_idx);
            void(ResponseWriter*, HttpRequest*) h = e.handler;
            h(w, r);
            return;
        }

        w.set_header("Content-Type", "text/plain; charset=utf-8");
        w.write_header(404);
        w.write_str("404 page not found\n");
    }
}

impl Drop for ServeMux {
    void drop(*self) {
        self.routes.drop();
    }
}

// --- Server (Go's http.Server) --------------------------------------------

struct HttpServer {
    str addr;
    ServeMux mux;
    ServeMux* custom_mux;
    i64 read_timeout_secs;
    i64 write_timeout_secs;
    i64 max_header_bytes;
    i64 max_body_bytes;
    bool enable_h2;
}

// --- HTTP/2 Connection Reactor --------------------------------------------

void h2_serve_conn(StreamIo* io, ServeMux* mux, i64 max_body) {
    H2Connection c;
    h2_init(&c, io);

    // Send server settings (RFC 9113 §6.5)
    if (h2_send_server_settings(&c) != 0) {
        c.drop();
        return;
    }

    u8* hbuf = alloc<u8>(65536);
    u8* payload = alloc<u8>(16384);
    i64 hlen = 0;
    bool stream_ended = false;
    bool running = true;

    while (running) {
        u8 fh[9];
        if (h2_read_full(&c.io, &fh[0], 9) != 0) { break; }
        i64 flen = ((i64)fh[0] << 16) | ((i64)fh[1] << 8) | (i64)fh[2];
        i64 ftype = (i64)fh[3];
        i64 fflags = (i64)fh[4];
        i64 fsid = (((i64)fh[5] & 0x7F) << 24) | ((i64)fh[6] << 16)
                 | ((i64)fh[7] << 8) | (i64)fh[8];

        if (flen > 16384) {
            h2_send_goaway(&c, fsid, 0x6);
            break;
        }
        if (flen > 0 && h2_read_full(&c.io, payload, flen) != 0) { break; }

        if (ftype == H2_SETTINGS) {
            if ((fflags & H2_FLAG_ACK) == 0) {
                if (h2_apply_settings(&c, payload, flen) != 0) {
                    h2_send_goaway(&c, fsid, 0x1);
                    break;
                }
                if (h2_send_settings_ack(&c) != 0) { break; }
            }
        } else if (ftype == H2_WINDOW_UPDATE) {
            i64 inc = (((i64)payload[0] & 0x7F) << 24) | ((i64)payload[1] << 16)
                    | ((i64)payload[2] << 8) | (i64)payload[3];
            if (fsid == 0) {
                c.conn_window += inc;
                c.peer_conn_window += inc;
            }
        } else if (ftype == H2_PING) {
            if ((fflags & H2_FLAG_ACK) == 0) {
                if (h2_send_frame(&c, H2_PING, H2_FLAG_ACK, 0, payload, flen) != 0) { break; }
            }
        } else if (ftype == H2_GOAWAY) {
            break;
        } else if (ftype == H2_HEADERS || ftype == H2_CONTINUATION) {
            // RFC 9113 §5.1.1: client streams must be odd-numbered
            if (fsid == 0 || (fsid % 2) != 1) {
                h2_send_goaway(&c, fsid, 0x1);
                break;
            }
            if (ftype == H2_HEADERS) {
                stream_ended = (fflags & H2_FLAG_END_STREAM) != 0;
            }
            if (hlen + flen > 65536) {
                h2_send_rst_stream(&c, fsid, 0xb);
                hlen = 0;
                continue;
            }
            if (flen > 0) { silver_rt_memcpy(&hbuf[hlen], payload, flen); }
            hlen += flen;

            if ((fflags & H2_FLAG_END_HEADERS) != 0) {
                HpackField fields[32];
                i64 nf = hpack_decode(&c.hpack, &hbuf[0], hlen, &fields[0], 32);
                hlen = 0;
                if (nf < 0) {
                    h2_send_rst_stream(&c, fsid, 0x1);
                    continue;
                }

                HttpRequest req = HttpRequest.empty();
                req.version = HttpVersion.Http20;

                for (i64 i = 0; i < nf; i = i + 1) {
                    if (strcmp((str)fields[i].name, ":method") == 0) {
                        req.method_str.push_bytes(fields[i].value, fields[i].value_len);
                        req.method = (str)req.method_str.data;
                    } else if (strcmp((str)fields[i].name, ":path") == 0) {
                        req.target_str.push_bytes(fields[i].value, fields[i].value_len);
                        req.target = (str)req.target_str.data;
                        i64 q = 0;
                        i64 qlen = fields[i].value_len;
                        while (q < qlen && fields[i].value[q] != (u8)'?') { q += 1; }
                        req.path_str.push_bytes(fields[i].value, q);
                        if (q < qlen) {
                            req.query_str.push_bytes(&fields[i].value[q + 1], qlen - q - 1);
                        }
                    } else if (strcmp((str)fields[i].name, ":authority") == 0) {
                        req.host_str.push_bytes(fields[i].value, fields[i].value_len);
                        req.host = (str)req.host_str.data;
                    } else if (fields[i].name[0] != (u8)':') {
                        req.header((str)fields[i].name, (str)fields[i].value);
                    }
                }
                hpack_free_fields(&fields[0], nf);

                bool has_end_stream = stream_ended;
                stream_ended = false;
                while (!has_end_stream) {
                    u8 dfh[9];
                    if (h2_read_full(&c.io, &dfh[0], 9) != 0) { break; }
                    i64 dlen = ((i64)dfh[0] << 16) | ((i64)dfh[1] << 8) | (i64)dfh[2];
                    i64 dtype = (i64)dfh[3];
                    i64 dflags = (i64)dfh[4];
                    i64 dsid = (((i64)dfh[5] & 0x7F) << 24) | ((i64)dfh[6] << 16)
                             | ((i64)dfh[7] << 8) | (i64)dfh[8];
                    u8 dpayload[16384];
                    if (dlen > 0 && h2_read_full(&c.io, &dpayload[0], dlen) != 0) { break; }

                    if (dtype == H2_DATA && dsid == fsid) {
                        if (dlen > 0 && req.body_buf.len + dlen <= max_body) {
                            req.body_buf.push_bytes(&dpayload[0], dlen);
                        }
                        c.conn_window -= dlen;
                        if (c.conn_window < 32768) {
                            h2_send_window_update(&c, 0, 65535 - c.conn_window);
                            c.conn_window = 65535;
                        }
                        if ((dflags & H2_FLAG_END_STREAM) != 0) {
                            has_end_stream = true;
                        }
                    } else if (dtype == H2_RST_STREAM && dsid == fsid) {
                        has_end_stream = true;
                    }
                }
                if (req.body_buf.len > 0) {
                    req.body = (str)req.body_buf.data;
                }

                ResponseWriter w = ResponseWriter.new(c.io, HttpVersion.Http20, false);
                w.is_h2 = true;
                w.h2_stream_id = fsid;
                w.h2_conn_ptr = (void*)&c;

                mux.serve_http(&mut w, &mut req);
                w.finish();

                w.drop();
                req.drop();
            }
        }
    }
    free((void*)hbuf);
    free((void*)payload);
    c.drop();
}

impl HttpServer {
    HttpServer new(str addr) {
        HttpServer s;
        s.addr = addr;
        s.mux = ServeMux.new();
        s.custom_mux = (ServeMux*)0;
        s.read_timeout_secs = 30;
        s.write_timeout_secs = 30;
        s.max_header_bytes = HTTP_DEFAULT_MAX_HEADER;
        s.max_body_bytes = HTTP_DEFAULT_MAX_BODY;
        s.enable_h2 = true;
        return move s;
    }

    void handle_func(&mut self, str pattern, void(ResponseWriter*, HttpRequest*) handler) {
        self.mux.handle_func(pattern, handler);
    }

    void set_mux(&mut self, ServeMux* mux) {
        self.custom_mux = mux;
    }

    void serve_conn(&mut self, TcpStream stream) {
        HttpConnection conn = HttpConnection.from_stream(move stream);
        StreamIo io = http_transport_io(&conn);

        // Transparent HTTP/2 prior-knowledge (h2c) detection
        if (self.enable_h2) {
            u8 magic[24];
            Result<i64, Error> mr = transport_read(&io, &magic[0], H2_CLIENT_PREFACE_LEN);
            if (mr.success() && mr.value() == H2_CLIENT_PREFACE_LEN) {
                if (memcmp((const void*)&magic[0], (const void*)H2_CLIENT_PREFACE, H2_CLIENT_PREFACE_LEN) == 0) {
                    if (self.custom_mux != (ServeMux*)0) {
                        h2_serve_conn(&io, self.custom_mux, self.max_body_bytes);
                    } else {
                        h2_serve_conn(&io, &self.mux, self.max_body_bytes);
                    }
                    conn.close();
                    conn.drop();
                    return;
                }
            }
            if (mr.success() && mr.value() > 0) {
                http_transport_rewind(&io, mr.value());
            }
        }

        while (true) {
            HttpRequest req = HttpRequest.empty();
            Result<i64, Error> hr = req.read_head(&io, self.max_header_bytes);
            if (hr.failed() || hr.value() == 0) {
                req.drop();
                break;
            }

            // HTTP/1.1 mandatory Host header check (RFC 9112 §3.2)
            if (req.version == HttpVersion.Http11 && (req.host == (str)0 || strlen(req.host) == 0)) {
                ResponseWriter bad_w = ResponseWriter.new(io, req.version, true);
                bad_w.set_header("Content-Type", "text/plain; charset=utf-8");
                bad_w.set_header("Connection", "close");
                bad_w.write_header(400);
                bad_w.write_str("400 Bad Request: missing required Host header\n");
                bad_w.finish();
                bad_w.drop();
                req.drop();
                break;
            }

            // Expect: 100-continue handling (RFC 9110 §10.1.1)
            String expect = req.get_header("expect");
            if (expect.len > 0 && http_equal_ci(expect.data, 0, expect.len, "100-continue")) {
                transport_write(&io, (u8*)"HTTP/1.1 100 Continue\r\n\r\n", 25);
            }
            expect.drop();

            Result<i64, Error> br = req.read_body(&io, self.max_body_bytes);
            if (br.failed()) {
                req.drop();
                break;
            }

            bool close_conn = req.close;
            ResponseWriter w = ResponseWriter.new(io, req.version, close_conn);
            if (self.custom_mux != (ServeMux*)0) {
                self.custom_mux.serve_http(&mut w, &mut req);
            } else {
                self.mux.serve_http(&mut w, &mut req);
            }
            w.finish();

            w.drop();
            req.drop();

            if (close_conn) {
                break;
            }
        }
        conn.close();
        conn.drop();
    }

    Result<i64, Error> listen_and_serve(&mut self) {
        String ip = String.new();
        u16 port = 80;
        http_parse_host_port(self.addr, &mut ip, &mut port);

        Result<SocketAddr, AddrError> ar = SocketAddr.v4((str)ip.data, port);
        ip.drop();
        if (ar.failed()) {
            return Err(HTTP_ERR_CONNECT, "invalid bind address");
        }
        SocketAddr sa = ar.unwrap();
        TcpListener listener = TcpListener.bind(&sa, 128);
        if (!listener.valid()) {
            return Err(HTTP_ERR_CONNECT, "failed to bind socket");
        }

        while (true) {
            Result<i64, Error> a = listener.accept();
            if (a.failed()) {
                continue;
            }
            TcpStream stream = TcpStream.from_fd((i32)a.value());
            if (self.read_timeout_secs > 0) {
                stream.sock.set_recv_timeout(self.read_timeout_secs);
            }
            if (self.write_timeout_secs > 0) {
                stream.sock.set_send_timeout(self.write_timeout_secs);
            }

            self.serve_conn(move stream);
        }
        return Ok(0);
    }
}

impl Drop for HttpServer {
    void drop(*self) {
        self.mux.drop();
    }
}

// --- Top-Level Go-like Functions ------------------------------------------

ServeMux g_default_mux;

void http_handle_func(str pattern, void(ResponseWriter*, HttpRequest*) handler) {
    g_default_mux.handle_func(pattern, handler);
}

Result<i64, Error> http_listen_and_serve(str addr) {
    HttpServer s = HttpServer.new(addr);
    s.set_mux(&g_default_mux);
    Result<i64, Error> r = s.listen_and_serve();
    s.drop();
    return r;
}

Result<i64, Error> http_listen_and_serve(str addr, void(ResponseWriter*, HttpRequest*) handler) {
    HttpServer s = HttpServer.new(addr);
    s.handle_func("/", handler);
    Result<i64, Error> r = s.listen_and_serve();
    s.drop();
    return r;
}

Result<HttpResponse, Error> http_get(str url) {
    HttpClient client = HttpClient.new();
    Result<HttpResponse, Error> r = client.get(url);
    client.drop();
    return r;
}

Result<HttpResponse, Error> http_post(str url, str content_type, str body) {
    HttpClient client = HttpClient.new();
    Result<HttpResponse, Error> r = client.post(url, content_type, body);
    client.drop();
    return r;
}

