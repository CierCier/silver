// std/net/http2.ag — minimal HTTP/2 client (RFC 7540 / RFC 9113).
//
// Single-stream prior-knowledge or ALPN-negotiated client: client preface,
// SETTINGS exchange, one HEADERS request (END_STREAM), and a HEADERS +
// CONTINUATION + DATA response with receive flow control. Multiplexing and
// request bodies come later. Reads/writes go through the same StreamIo seam
// as the HTTP/1.1 client, so plain TCP (h2c) and TLS (ALPN h2) both work.

import std.error;
import std.mem.alloc;
import std.mem.memory;
import std.net.hpack;
import std.net.transport;

// --- Frame types and flags (RFC 7540 §6) ---------------------------------

const i64 H2_DATA = 0x0;
const i64 H2_HEADERS = 0x1;
const i64 H2_PRIORITY = 0x2;
const i64 H2_RST_STREAM = 0x3;
const i64 H2_SETTINGS = 0x4;
const i64 H2_PUSH_PROMISE = 0x5;
const i64 H2_PING = 0x6;
const i64 H2_GOAWAY = 0x7;
const i64 H2_WINDOW_UPDATE = 0x8;
const i64 H2_CONTINUATION = 0x9;

const i64 H2_FLAG_END_STREAM = 0x1;
const i64 H2_FLAG_ACK = 0x1;
const i64 H2_FLAG_END_HEADERS = 0x4;
const i64 H2_FLAG_PADDED = 0x8;
const i64 H2_FLAG_PRIORITY = 0x20;

// --- SETTINGS parameter ids (RFC 7540 §6.5.2) ----------------------------

const i64 H2_SET_HEADER_TABLE_SIZE = 0x1;
const i64 H2_SET_ENABLE_PUSH = 0x2;
const i64 H2_SET_MAX_CONCURRENT_STREAMS = 0x3;
const i64 H2_SET_INITIAL_WINDOW_SIZE = 0x4;
const i64 H2_SET_MAX_FRAME_SIZE = 0x5;
const i64 H2_SET_MAX_HEADER_LIST_SIZE = 0x6;

const i64 H2_DEFAULT_WINDOW = 65535;
const i64 H2_DEFAULT_MAX_FRAME = 16384;
const i64 H2_MAX_HEADER_BLOCK = 65536;
const i64 H2_MAX_STREAMS = 8;

// --- Connection state -----------------------------------------------------

// --- Response -------------------------------------------------------------

struct H2Response {
    i64 status;                 // from the :status pseudo-header (0 if absent)
    HpackField headers[32];     // decoded header fields (caller frees)
    i64 header_count;
    u8* body;                   // malloc'd body bytes (caller frees)
    i64 body_len;
    i64 body_cap;
}

/// Parse a decimal integer from `len` octets (stops at a non-digit).
i64 h2_parse_int(u8* s, i64 len) {
    i64 v = 0;
    i64 i = 0;
    while (i < len && s[i] >= (u8)'0' && s[i] <= (u8)'9') {
        v = v * 10 + ((i64)s[i] - (i64)'0');
        i += 1;
    }
    return v;
}

/// A pending (multiplexed) response accumulator. `hbuf` collects the
/// HEADERS+CONTINUATION payload until END_HEADERS; `resp` holds the decoded
/// headers and body once the stream completes.
struct H2Stream {
    bool active;
    i64 sid;
    bool end_stream;
    u8 hbuf[4096];
    i64 hlen;
    i64 window;                 // per-stream receive window
    H2Response resp;
}

struct H2Connection {
    StreamIo io;
    HpackDecoder hpack;
    i64 peer_max_frame_size;   // SETTINGS_MAX_FRAME_SIZE (default 16384)
    i64 peer_initial_window;   // SETTINGS_INITIAL_WINDOW_SIZE (default 65535)
    i64 conn_window;           // our receive window (connection)
    i64 stream_window;         // our receive window (stream 1)
    i64 next_stream_id;        // next client stream id (starts at 1)
    H2Stream streams[8]; // see H2_MAX_STREAMS
}

/// Initialize connection state over an already-connected transport.
void h2_init(H2Connection* c, StreamIo* io) {
    c.io = *io;
    hpack_init(&c.hpack);
    c.peer_max_frame_size = H2_DEFAULT_MAX_FRAME;
    c.peer_initial_window = H2_DEFAULT_WINDOW;
    c.conn_window = H2_DEFAULT_WINDOW;
    c.stream_window = H2_DEFAULT_WINDOW;
    c.next_stream_id = 1;
    i64 i = 0;
    while (i < H2_MAX_STREAMS) {
        c.streams[i].active = false;
        c.streams[i].resp.body = (u8*)0;
        c.streams[i].resp.body_len = 0;
        c.streams[i].resp.body_cap = 0;
        i += 1;
    }
}

/// Free a response's body and header fields (idempotent).
void h2_free_response(H2Response* r) {
    if (r.body != (u8*)0) { free(r.body); r.body = (u8*)0; }
    if (r.header_count > 0) {
        hpack_free_fields(&r.headers[0], r.header_count);
        r.header_count = 0;
    }
    r.status = 0;
    r.body_len = 0;
    r.body_cap = 0;
}

/// RAII: a dropped connection releases every pending stream response and
/// the HPACK dynamic table (same owning-type convention as the rest of
/// std/net). Multiplexed responses live in c.streams[*].resp and are owned
/// by the connection — callers read them, never free them by hand.
impl Drop for H2Connection {
    void drop(H2Connection* self) {
        i64 i = 0;
        while (i < H2_MAX_STREAMS) {
            if (self.streams[i].active || self.streams[i].resp.body != (u8*)0
                || self.streams[i].resp.header_count > 0) {
                h2_free_response(&self.streams[i].resp);
            }
            i += 1;
        }
        hpack_clear_table(&self.hpack);
    }
}

// --- Frame header I/O -----------------------------------------------------

/// Write a 9-byte frame header (24-bit length, type, flags, 31-bit stream id).
void h2_put_header(u8* h, i64 len, i64 ftype, i64 flags, i64 stream_id) {
    h[0] = (u8)((len >> 16) & 0xFF);
    h[1] = (u8)((len >> 8) & 0xFF);
    h[2] = (u8)(len & 0xFF);
    h[3] = (u8)ftype;
    h[4] = (u8)flags;
    h[5] = (u8)((stream_id >> 24) & 0x7F); // reserved bit is 0
    h[6] = (u8)((stream_id >> 16) & 0xFF);
    h[7] = (u8)((stream_id >> 8) & 0xFF);
    h[8] = (u8)(stream_id & 0xFF);
}

/// Read exactly `len` bytes into `buf`. Returns 0 on success, -1 on error/EOF.
i64 h2_read_full(StreamIo* io, u8* buf, i64 len) {
    i64 got = 0;
    while (got < len) {
        Result<i64, Error> r = transport_read(io, &buf[got], len - got);
        if (r.failed()) { return -1; }
        if (r.value() == 0) { return -1; }
        got += r.value();
    }
    return 0;
}

/// Write exactly `len` bytes. Returns 0 on success, -1 on error.
i64 h2_write_full(StreamIo* io, u8* buf, i64 len) {
    i64 sent = 0;
    while (sent < len) {
        Result<i64, Error> r = transport_write(io, &buf[sent], len - sent);
        if (r.failed()) { return -1; }
        sent += r.value();
    }
    return 0;
}

/// Send a frame: header + payload. Returns 0 or -1.
i64 h2_send_frame(H2Connection* c, i64 ftype, i64 flags, i64 stream_id, u8* payload, i64 len) {
    u8 header[9];
    h2_put_header(&header[0], len, ftype, flags, stream_id);
    if (h2_write_full(&c.io, &header[0], 9) != 0) { return -1; }
    if (len > 0 && h2_write_full(&c.io, payload, len) != 0) { return -1; }
    return 0;
}

// --- Client preface + SETTINGS (RFC 7540 §3.5) ---------------------------

/// Send the magic client preface and an empty SETTINGS frame.
i64 h2_send_preface(H2Connection* c) {
    u8 magic[24] = {
        0x50, 0x52, 0x49, 0x20, 0x2a, 0x20, 0x48, 0x54, // "PRI * HT"
        0x54, 0x50, 0x2f, 0x32, 0x2e, 0x30, 0x0d, 0x0a, // "TP/2.0\r\n"
        0x0d, 0x0a, 0x53, 0x4d, 0x0d, 0x0a, 0x0d, 0x0a  // "\r\nSM\r\n\r\n"
    };
    if (h2_write_full(&c.io, &magic[0], 24) != 0) { return -1; }
    return h2_send_frame(c, H2_SETTINGS, 0, 0, (u8*)0, 0);
}

/// Send a SETTINGS ACK.
i64 h2_send_settings_ack(H2Connection* c) {
    return h2_send_frame(c, H2_SETTINGS, H2_FLAG_ACK, 0, (u8*)0, 0);
}

/// Send a WINDOW_UPDATE for `increment` on `stream_id`.
i64 h2_send_window_update(H2Connection* c, i64 stream_id, i64 increment) {
    u8 payload[4];
    payload[0] = (u8)((increment >> 24) & 0x7F);
    payload[1] = (u8)((increment >> 16) & 0xFF);
    payload[2] = (u8)((increment >> 8) & 0xFF);
    payload[3] = (u8)(increment & 0xFF);
    return h2_send_frame(c, H2_WINDOW_UPDATE, 0, stream_id, &payload[0], 4);
}

/// Parse a SETTINGS payload (non-ACK), updating peer settings. Returns 0 or -1.
i64 h2_apply_settings(H2Connection* c, u8* payload, i64 len) {
    if (len % 6 != 0) { return -1; }
    i64 i = 0;
    while (i < len) {
        i64 id = ((i64)payload[i] << 8) | (i64)payload[i + 1];
        i64 value = ((i64)payload[i + 2] << 24) | ((i64)payload[i + 3] << 16)
                  | ((i64)payload[i + 4] << 8) | (i64)payload[i + 5];
        if (id == H2_SET_HEADER_TABLE_SIZE) {
            hpack_set_max_size(&c.hpack, value);
        } else if (id == H2_SET_INITIAL_WINDOW_SIZE) {
            c.peer_initial_window = value;
        } else if (id == H2_SET_MAX_FRAME_SIZE) {
            c.peer_max_frame_size = value;
        }
        i += 6;
    }
    return 0;
}


/// Read the response for stream `sid` into `out`. Returns 0 on success, or
/// -1 on protocol/transport error. On error any partially-written body is
/// freed and `out` is left with a null body.
i64 h2_read_response(H2Connection* c, i64 sid, H2Response* out) {
    out.status = 0;
    out.header_count = 0;
    out.body = (u8*)0;
    out.body_len = 0;
    out.body_cap = 0;

    u8 hbuf[65536];
    i64 hlen = 0;
    bool end_stream = false;
    u8* body = (u8*)0;
    i64 body_len = 0;
    i64 body_cap = 0;

    while (!end_stream) {
        u8 fh[9];
        if (h2_read_full(&c.io, &fh[0], 9) != 0) {
            if (body != (u8*)0) { free(body); } h2_free_response(out);
            return -1;
        }
        i64 flen = ((i64)fh[0] << 16) | ((i64)fh[1] << 8) | (i64)fh[2];
        i64 ftype = (i64)fh[3];
        i64 fflags = (i64)fh[4];
        i64 fsid = (((i64)fh[5] & 0x7F) << 24) | ((i64)fh[6] << 16)
                 | ((i64)fh[7] << 8) | (i64)fh[8];

        if (flen > 16384) {
            if (body != (u8*)0) { free(body); } h2_free_response(out);
            return -1;
        }
        u8 payload[16384];
        if (flen > 0 && h2_read_full(&c.io, &payload[0], flen) != 0) {
            if (body != (u8*)0) { free(body); } h2_free_response(out);
            return -1;
        }

        if (ftype == H2_SETTINGS) {
            if ((fflags & H2_FLAG_ACK) == 0) {
                if (h2_apply_settings(c, &payload[0], flen) != 0) {
                    if (body != (u8*)0) { free(body); } h2_free_response(out);
                    return -1;
                }
                if (h2_send_settings_ack(c) != 0) {
                    if (body != (u8*)0) { free(body); } h2_free_response(out);
                    return -1;
                }
            }
        } else if (ftype == H2_WINDOW_UPDATE) {
            i64 inc = (((i64)payload[0] & 0x7F) << 24) | ((i64)payload[1] << 16)
                    | ((i64)payload[2] << 8) | (i64)payload[3];
            if (fsid == 0) { c.conn_window += inc; }
            else if (fsid == sid) { c.stream_window += inc; }
        } else if (fsid == sid && (ftype == H2_HEADERS || ftype == H2_CONTINUATION)) {
            if (hlen + flen > 65536) {
                if (body != (u8*)0) { free(body); } h2_free_response(out);
                return -1;
            }
            if (flen > 0) { silver_rt_memcpy(&hbuf[hlen], &payload[0], flen); }
            hlen += flen;
            if ((fflags & H2_FLAG_END_HEADERS) != 0) {
                i64 n = hpack_decode(&c.hpack, &hbuf[0], hlen, &out.headers[0], 32);
                if (n < 0) {
                    if (body != (u8*)0) { free(body); } h2_free_response(out);
                    return -1;
                }
                out.header_count = n;
                i64 i = 0;
                while (i < n) {
                    if (strcmp((str)out.headers[i].name, ":status") == 0) {
                        out.status = h2_parse_int(out.headers[i].value, out.headers[i].value_len);
                    }
                    i += 1;
                }
                if ((fflags & H2_FLAG_END_STREAM) != 0) { end_stream = true; }
            }
        } else if (fsid == sid && ftype == H2_DATA) {
            if (body_len + flen > body_cap) {
                i64 nc = body_cap * 2;
                if (nc < 4096) { nc = 4096; }
                while (nc < body_len + flen) { nc = nc * 2; }
                if (body == (u8*)0) { body = alloc<u8>(nc); }
                else { body = realloc<u8>(body, nc); }
                body_cap = nc;
            }
            if (flen > 0) { silver_rt_memcpy(&body[body_len], &payload[0], flen); }
            body_len += flen;
            c.conn_window -= flen;
            c.stream_window -= flen;
            if (c.conn_window < 32768) {
                if (h2_send_window_update(c, 0, 65535 - c.conn_window) != 0) {
                    if (body != (u8*)0) { free(body); } h2_free_response(out);
                    return -1;
                }
                c.conn_window = 65535;
            }
            if (c.stream_window < 32768) {
                if (h2_send_window_update(c, sid, 65535 - c.stream_window) != 0) {
                    if (body != (u8*)0) { free(body); } h2_free_response(out);
                    return -1;
                }
                c.stream_window = 65535;
            }
            if ((fflags & H2_FLAG_END_STREAM) != 0) { end_stream = true; }
        } else if (ftype == H2_GOAWAY || (ftype == H2_RST_STREAM && fsid == sid)) {
            if (body != (u8*)0) { free(body); } h2_free_response(out);
            return -1;
        } else if (ftype == H2_PING) {
            if ((fflags & H2_FLAG_ACK) == 0) {
                if (h2_send_frame(c, H2_PING, H2_FLAG_ACK, 0, &payload[0], flen) != 0) {
                    if (body != (u8*)0) { free(body); } h2_free_response(out);
                    return -1;
                }
            }
        }
    }

    out.body = body;
    out.body_len = body_len;
    out.body_cap = body_cap;
    return 0;
}

/// Build the HPACK header block for a request (pseudo-headers + extras).
/// Returns the block length, or -1.
i64 h2_build_headers(str method, str scheme, str authority, str path,
                     HpackField* extra, i64 n_extra, u8* out, i64 cap) {
    HpackField req[16];
    i64 nreq = 0;
    req[0].name = (u8*)":method";   req[0].name_len = 7;
    req[0].value = (u8*)method;     req[0].value_len = strlen(method);
    req[1].name = (u8*)":scheme";   req[1].name_len = 7;
    req[1].value = (u8*)scheme;     req[1].value_len = strlen(scheme);
    req[2].name = (u8*)":authority"; req[2].name_len = 10;
    req[2].value = (u8*)authority;  req[2].value_len = strlen(authority);
    req[3].name = (u8*)":path";     req[3].name_len = 5;
    req[3].value = (u8*)path;       req[3].value_len = strlen(path);
    nreq = 4;
    i64 i = 0;
    while (i < n_extra && nreq < 16) {
        req[nreq] = extra[i];
        nreq += 1;
        i += 1;
    }
    return hpack_encode(&req[0], nreq, out, cap);
}

/// Send the HEADERS (+ DATA) frames for a new stream. Returns the stream id.
i64 h2_send_request_frames(H2Connection* c, str method, str scheme, str authority,
                           str path, HpackField* extra, i64 n_extra,
                           u8* body, i64 body_len) {
    u8 hpack_buf[4096];
    i64 hlen = h2_build_headers(method, scheme, authority, path, extra, n_extra,
                                &hpack_buf[0], 4096);
    if (hlen < 0) { return -1; }
    i64 sid = c.next_stream_id;
    c.next_stream_id += 2;
    i64 hflags = H2_FLAG_END_HEADERS;
    if (body_len == 0) { hflags = hflags | H2_FLAG_END_STREAM; }
    if (h2_send_frame(c, H2_HEADERS, hflags, sid, &hpack_buf[0], hlen) != 0) { return -1; }
    i64 sent = 0;
    while (sent < body_len) {
        i64 chunk = body_len - sent;
        if (chunk > c.peer_max_frame_size) { chunk = c.peer_max_frame_size; }
        i64 dflags = 0;
        if (sent + chunk >= body_len) { dflags = H2_FLAG_END_STREAM; }
        if (h2_send_frame(c, H2_DATA, dflags, sid, &body[sent], chunk) != 0) { return -1; }
        sent += chunk;
    }
    return sid;
}

/// Perform one HTTP/2 request on an established connection. `extra`/`n_extra`
/// are optional additional header fields (borrowed; not freed). Returns 0 or -1.
i64 h2_request_body(H2Connection* c, str method, str scheme, str authority, str path,
                    HpackField* extra, i64 n_extra, u8* body, i64 body_len, H2Response* out) {
    i64 sid = h2_send_request_frames(c, method, scheme, authority, path, extra, n_extra, body, body_len);
    if (sid < 0) { return -1; }
    return h2_read_response(c, sid, out);
}

i64 h2_request(H2Connection* c, str method, str scheme, str authority, str path,
               HpackField* extra, i64 n_extra, H2Response* out) {
    return h2_request_body(c, method, scheme, authority, path, extra, n_extra,
                           (u8*)0, 0, out);
}

/// Convenience: h2c/ALPN single GET over a connected transport. Initializes
/// the connection, sends the preface, performs the request, and frees nothing
/// (the caller frees out.body and out.headers). Returns 0 or -1.
i64 h2_get(StreamIo* io, str scheme, str authority, str path, H2Response* out) {
    H2Connection c;
    h2_init(&c, io);
    if (h2_send_preface(&c) != 0) { return -1; }
    return h2_request(&c, "GET", scheme, authority, path, (HpackField*)0, 0, out);
}

// --- Multiplexing ---------------------------------------------------------

/// Begin a request on a fresh multiplexed stream. Returns the index into
/// `c.streams` (0..H2_MAX_STREAMS-1) whose `resp` will receive the response,
/// or -1 when the stream table is full. Several streams may be begun before
/// h2_wait_all drains the responses.
i64 h2_begin(H2Connection* c, str method, str scheme, str authority, str path,
             HpackField* extra, i64 n_extra, u8* body, i64 body_len) {
    i64 idx = -1;
    i64 i = 0;
    while (i < H2_MAX_STREAMS) {
        if (!c.streams[i].active) { idx = i; break; }
        i += 1;
    }
    if (idx < 0) { return -1; }
    // Release any response data left in this slot from a previous stream.
    h2_free_response(&c.streams[idx].resp);
    i64 sid = h2_send_request_frames(c, method, scheme, authority, path, extra,
                                     n_extra, body, body_len);
    if (sid < 0) { return -1; }
    c.streams[idx].active = true;
    c.streams[idx].sid = sid;
    c.streams[idx].end_stream = false;
    c.streams[idx].hlen = 0;
    c.streams[idx].window = c.peer_initial_window;
    return idx;
}

/// Read frames until every active stream completes, dispatching
/// HEADERS/CONTINUATION/DATA to the owning stream. Returns 0 or -1.
i64 h2_wait_all(H2Connection* c) {
    i64 active = 0;
    i64 i = 0;
    while (i < H2_MAX_STREAMS) {
        if (c.streams[i].active && !c.streams[i].end_stream) { active += 1; }
        i += 1;
    }
    while (active > 0) {
        u8 fh[9];
        if (h2_read_full(&c.io, &fh[0], 9) != 0) { return -1; }
        i64 flen = ((i64)fh[0] << 16) | ((i64)fh[1] << 8) | (i64)fh[2];
        i64 ftype = (i64)fh[3];
        i64 fflags = (i64)fh[4];
        i64 fsid = (((i64)fh[5] & 0x7F) << 24) | ((i64)fh[6] << 16)
                 | ((i64)fh[7] << 8) | (i64)fh[8];
        if (flen > 16384) { return -1; }
        u8 payload[16384];
        if (flen > 0 && h2_read_full(&c.io, &payload[0], flen) != 0) { return -1; }

        i64 sidx = -1;
        i64 j = 0;
        while (j < H2_MAX_STREAMS) {
            if (c.streams[j].active && c.streams[j].sid == fsid) { sidx = j; break; }
            j += 1;
        }

        if (ftype == H2_SETTINGS) {
            if ((fflags & H2_FLAG_ACK) == 0) {
                if (h2_apply_settings(c, &payload[0], flen) != 0) { return -1; }
                if (h2_send_settings_ack(c) != 0) { return -1; }
            }
        } else if (ftype == H2_WINDOW_UPDATE) {
            i64 inc = (((i64)payload[0] & 0x7F) << 24) | ((i64)payload[1] << 16)
                    | ((i64)payload[2] << 8) | (i64)payload[3];
            if (fsid == 0) { c.conn_window += inc; }
            else if (sidx >= 0) { c.streams[sidx].window += inc; }
        } else if (sidx >= 0 && (ftype == H2_HEADERS || ftype == H2_CONTINUATION)) {
            H2Stream* st = &c.streams[sidx];
            if (st.hlen + flen > 4096) { return -1; }
            if (flen > 0) { silver_rt_memcpy(&st.hbuf[st.hlen], &payload[0], flen); }
            st.hlen += flen;
            if ((fflags & H2_FLAG_END_HEADERS) != 0) {
                i64 n = hpack_decode(&c.hpack, &st.hbuf[0], st.hlen, &st.resp.headers[0], 32);
                if (n < 0) { return -1; }
                st.resp.header_count = n;
                i64 k = 0;
                while (k < n) {
                    if (strcmp((str)st.resp.headers[k].name, ":status") == 0) {
                        st.resp.status = h2_parse_int(st.resp.headers[k].value, st.resp.headers[k].value_len);
                    }
                    k += 1;
                }
                if ((fflags & H2_FLAG_END_STREAM) != 0) {
                    st.end_stream = true;
                    st.active = false;
                    active -= 1;
                }
            }
        } else if (sidx >= 0 && ftype == H2_DATA) {
            H2Stream* st = &c.streams[sidx];
            if (st.resp.body_len + flen > st.resp.body_cap) {
                i64 nc = st.resp.body_cap * 2;
                if (nc < 4096) { nc = 4096; }
                while (nc < st.resp.body_len + flen) { nc = nc * 2; }
                if (st.resp.body == (u8*)0) { st.resp.body = alloc<u8>(nc); }
                else { st.resp.body = realloc<u8>(st.resp.body, nc); }
                st.resp.body_cap = nc;
            }
            if (flen > 0) { silver_rt_memcpy(&st.resp.body[st.resp.body_len], &payload[0], flen); }
            st.resp.body_len += flen;
            c.conn_window -= flen;
            st.window -= flen;
            if (c.conn_window < 32768) {
                if (h2_send_window_update(c, 0, 65535 - c.conn_window) != 0) { return -1; }
                c.conn_window = 65535;
            }
            if (st.window < 32768) {
                if (h2_send_window_update(c, fsid, 65535 - st.window) != 0) { return -1; }
                st.window = 65535;
            }
            if ((fflags & H2_FLAG_END_STREAM) != 0) {
                st.end_stream = true;
                st.active = false;
                active -= 1;
            }
        } else if (ftype == H2_GOAWAY || (ftype == H2_RST_STREAM && sidx >= 0)) {
            return -1;
        } else if (ftype == H2_PING) {
            if ((fflags & H2_FLAG_ACK) == 0) {
                if (h2_send_frame(c, H2_PING, H2_FLAG_ACK, 0, &payload[0], flen) != 0) { return -1; }
            }
        }
    }
    return 0;
}
