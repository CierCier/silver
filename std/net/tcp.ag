// std/net/tcp.ag — TCP stream and listener wrappers (Linux x86_64).
//
// TcpStream and TcpListener own a Socket and accept borrowed SocketAddr
// values at the syscall boundary. Constructors retain the existing invalid
// sentinel contract; operation failures use Result<i64, i64>.

import std.sys.result;
import std.sys.socket;
import std.net.socket;
import std.net.inet;
import std.mem.drop;

// --- TcpStream ---

struct TcpStream {
    Socket sock;
}

impl TcpStream {
    TcpStream closed() {
        TcpStream s;
        s.sock = Socket.from_fd(-1);
        return s;
    }

    TcpStream from_fd(i32 fd) {
        TcpStream s;
        s.sock = Socket.from_fd(fd);
        return s;
    }

    bool valid(TcpStream* self) { return self.sock.valid(); }
    bool invalid(TcpStream* self) { return self.sock.invalid(); }

    // Connect to a borrowed address. Returns an invalid stream on failure.
    TcpStream connect(SocketAddr* addr) {
        Socket sock = Socket.new(AddressFamily.INET, SocketType.STREAM, SOCK_CLOEXEC, 0);
        if (sock.invalid()) { return TcpStream.closed(); }

        Result<i64, i64> c = match *addr {
            V4(sa) : try_connect(sock.fd, (void*)&sa, 16),
            V6(sa) : try_connect(sock.fd, (void*)&sa, 28),
            Unix(sa) : try_connect(sock.fd, (void*)&sa, sockaddr_un_len((SockAddrUn*)&sa))
        };
        if (c.is_err()) {
            sock.close();
            return TcpStream.closed();
        }

        TcpStream stream;
        stream.sock = move sock;
        return stream;
    }

    Result<i64, i64> read(TcpStream* self, u8* buf, i64 len) {
        if (self.invalid()) {
            return Result<i64, i64>.Err(EINVAL);
        }
        Result<i64, i64> r = try_read(self.sock.fd, buf, len);
        if (r.err_is(EINTR)) {
            r = try_read(self.sock.fd, buf, len);
        }
        return r;
    }

    Result<i64, i64> write(TcpStream* self, u8* buf, i64 len) {
        if (self.invalid()) {
            return Result<i64, i64>.Err(EINVAL);
        }
        i64 done = 0;
        while (done < len) {
            Result<i64, i64> r =
                try_write(self.sock.fd, (u8*)((i64)buf + done), len - done);
            if (r.is_err()) {
                if (r.err_is(EINTR)) { continue; }
                if (done > 0) { return Result<i64, i64>.Ok(done); }
                return r;
            }
            done = done + r.value();
            if (r.value() == 0) { break; }
        }
        return Result<i64, i64>.Ok(done);
    }

    void close(TcpStream* self) {
        self.sock.close();
    }

    Result<i64, i64> shutdown(TcpStream* self, ShutdownHow how) {
        if (self.invalid()) { return Result<i64, i64>.Err(EINVAL); }
        return try_shutdown(self.sock.fd, how);
    }
}

impl Drop<TcpStream> for TcpStream {
    void drop(TcpStream* self) {
        self.sock.drop();
    }
}

// --- TcpListener ---

struct TcpListener {
    Socket sock;
}

impl TcpListener {
    TcpListener closed() {
        TcpListener listener;
        listener.sock = Socket.from_fd(-1);
        return listener;
    }

    bool valid(TcpListener* self) { return self.sock.valid(); }
    bool invalid(TcpListener* self) { return self.sock.invalid(); }
i32 raw_fd(TcpListener* self) { return self.sock.fd; }

    // Bind a TCP listener: socket + SO_REUSEADDR + bind + listen.
    TcpListener bind(SocketAddr* addr, i64 backlog) {
        Socket sock = Socket.new(AddressFamily.INET, SocketType.STREAM, SOCK_CLOEXEC, 0);
        if (sock.invalid()) { return TcpListener.closed(); }

        i32 optval = 1;
        Result<i64, i64> so = try_setsockopt(
            sock.fd,
            SocketOptionLevel.SOCKET,
            SocketOption.REUSEADDR,
            (void*)&optval,
            4
        );
        if (so.is_err()) {
            sock.close();
            return TcpListener.closed();
        }

        Result<i64, i64> b = match *addr {
            V4(sa) : try_bind(sock.fd, (void*)&sa, 16),
            V6(sa) : try_bind(sock.fd, (void*)&sa, 28),
            Unix(sa) : try_bind(sock.fd, (void*)&sa, sockaddr_un_len((SockAddrUn*)&sa))
        };
        if (b.is_err()) {
            sock.close();
            return TcpListener.closed();
        }

        Result<i64, i64> li = try_listen(sock.fd, backlog);
        if (li.is_err()) {
            sock.close();
            return TcpListener.closed();
        }

        TcpListener listener;
        listener.sock = move sock;
        return listener;
    }

    // Returns the accepted client fd; callers can use TcpStream.from_fd.
    Result<i64, i64> accept(TcpListener* self) {
        if (self.invalid()) {
            return Result<i64, i64>.Err(EINVAL);
        }
        Result<i64, i64> r =
            try_accept4(self.sock.fd, (void*)0, (u32*)0, SOCK_CLOEXEC);
        if (r.err_is(EINTR)) {
            r = try_accept4(self.sock.fd, (void*)0, (u32*)0, SOCK_CLOEXEC);
        }
        return r;
    }
}

impl Drop<TcpListener> for TcpListener {
    void drop(TcpListener* self) {
        self.sock.drop();
    }
}
