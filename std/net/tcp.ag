// std/net/tcp.ag — TCP stream and listener wrappers (Linux x86_64).
//
// TcpStream and TcpListener own a Socket and accept borrowed SocketAddr
// values at the syscall boundary. Constructors retain the existing invalid
// sentinel contract; operation failures use Result<i64, Error>.

import std.error;
import std.mem.drop;
import std.net.inet;
import std.net.socket;
import std.sys.result;
import std.sys.socket;

// --- TcpStream ---

struct TcpStream {
    Socket sock;
}

// Connect `sock` to `addr`. Ok on success; Err carries the errno.
Result<i64, Error> tcp_connect_raw(Socket* sock, SocketAddr* addr) {
    return match *addr {
        V4(sa) : try_connect(sock.fd, (void*)&sa, 16),
        V6(sa) : try_connect(sock.fd, (void*)&sa, 28),
        Unix(sa) : try_connect(sock.fd, (void*)&sa, sockaddr_un_len((SockAddrUn*)&sa))
    };
}

// Clear O_NONBLOCK on `fd` (restore blocking mode) via fcntl(2).
Result<i64, Error> tcp_clear_nonblocking(i32 fd) {
    Result<i64, Error> flags = try_fcntl(fd, F_GETFL, 0);
    if (flags.is_err()) { return flags; }
    return try_fcntl(fd, F_SETFL, flags.value() & ~O_NONBLOCK);
}

// Error payload of a failed syscall Result (positive errno + symbolic name).
Error tcp_syscall_error(Result<i64, Error> r) {
    return Error.new(r.errno(), r.err_name());
}

impl TcpStream {
    TcpStream from_fd(i32 fd) {
        TcpStream s;
        s.sock = Socket.from_fd(fd);
        return s;
    }

    bool valid(*self) { return self.sock.valid(); }
    bool invalid(*self) { return self.sock.invalid(); }

    // Connect to a borrowed address. Err.code is the errno.
    Result<TcpStream, Error> connect(SocketAddr* addr) {
        return TcpStream.connect_timeout(addr, 0);
    }

    // Connect with a deadline. timeout_secs <= 0 waits indefinitely; a
    // positive value bounds the total connect time. Err.code is the
    // underlying errno (ECONNREFUSED, ENETUNREACH, ...), or ETIMEDOUT when
    // the deadline elapsed first.
    Result<TcpStream, Error> connect_timeout(SocketAddr* addr, i64 timeout_secs) {
        Result<i64, Error> fd_r = try_socket(AddressFamily.INET, SocketType.STREAM,
            SOCK_CLOEXEC | SOCK_NONBLOCK, 0);
        if (fd_r.is_err()) {
            return Result<TcpStream, Error>.Err(tcp_syscall_error(fd_r));
        }
        Socket sock = Socket.from_fd((i32)fd_r.value());

        Result<i64, Error> c = tcp_connect_raw(&sock, addr);
        if (c.is_err()) {
            if (c.err_is(EINPROGRESS)) {
                // Connection in progress: wait for completion (or the deadline).
                i64 ms = -1; // infinite
                if (timeout_secs > 0) {
                    ms = timeout_secs * 1000;
                    if (ms > 2147483647) { ms = 2147483647; }
                }
                PollFd pfd = { .fd = sock.fd, .events = (i16)POLLOUT, .revents = 0 };
                Result<i64, Error> pr = try_poll(&pfd, 1, ms);
                if (pr.is_err()) {
                    sock.close();
                    return Result<TcpStream, Error>.Err(tcp_syscall_error(pr));
                }
                if (pr.value() == 0) {
                    sock.close();
                    return Result<TcpStream, Error>.Err(Error.new(ETIMEDOUT, "connect timed out"));
                }
                i32 so_error = 0;
                i64 so_len = 4;
                Result<i64, Error> g = try_getsockopt(sock.fd, SocketOptionLevel.SOCKET,
                    SocketOption.SO_ERROR, (void*)&so_error, (void*)&so_len);
                if (g.is_err()) {
                    sock.close();
                    return Result<TcpStream, Error>.Err(tcp_syscall_error(g));
                }
                if (so_error != 0) {
                    sock.close();
                    return Result<TcpStream, Error>.Err(Error.new((i64)so_error, errno_name((i64)so_error)));
                }
            } else {
                // Immediate failure (refused, unreachable, ...).
                sock.close();
                return Result<TcpStream, Error>.Err(tcp_syscall_error(c));
            }
        }

        // Connected: restore blocking mode and wrap the stream.
        Result<i64, Error> fl = tcp_clear_nonblocking(sock.fd);
        if (fl.is_err()) {
            sock.close();
            return Result<TcpStream, Error>.Err(tcp_syscall_error(fl));
        }
        TcpStream stream;
        stream.sock = move sock;
        return Result<TcpStream, Error>.Ok(move stream);
    }

    Result<i64, Error> read(*self, u8* buf, i64 len) {
        if (self.invalid()) {
            return Result<i64, Error>.Err(Error.new(EINVAL, "stream is invalid"));
        }
        Result<i64, Error> r = try_read(self.sock.fd, buf, len);
        if (r.err_is(EINTR)) {
            r = try_read(self.sock.fd, buf, len);
        }
        return r;
    }

    Result<i64, Error> write(*self, u8* buf, i64 len) {
        if (self.invalid()) {
            return Result<i64, Error>.Err(Error.new(EINVAL, "stream is invalid"));
        }
        i64 done = 0;
        while (done < len) {
            Result<i64, Error> r =
                try_sendto(self.sock.fd, (void*)((i64)buf + done), len - done, 0x4000, (void*)0, 0);
            if (r.is_err()) {
                if (r.err_is(EINTR)) { continue; }
                if (done > 0) { return Result<i64, Error>.Ok(done); }
                return r;
            }
            done = done + r.value();
            if (r.value() == 0) { break; }
        }
        return Result<i64, Error>.Ok(done);
    }

    void close(*self) {
        self.sock.close();
    }

    Result<i64, Error> shutdown(*self, ShutdownHow how) {
        if (self.invalid()) { return Result<i64, Error>.Err(Error.new(EINVAL, "stream is invalid")); }
        return try_shutdown(self.sock.fd, how);
    }
}

impl Drop for TcpStream {
    void drop(*self) {
        self.sock.drop();
    }
}

// --- TcpListener ---

struct TcpListener {
    Socket sock;
}

impl TcpListener {
    TcpListener closed() {
        TcpListener listener;
        listener.sock = Socket.from_fd(-1);
        return listener;
    }

    bool valid(*self) { return self.sock.valid(); }
    bool invalid(*self) { return self.sock.invalid(); }
    i32 raw_fd(*self) { return self.sock.fd; }

    // Bind a TCP listener: socket + SO_REUSEADDR + bind + listen.
    TcpListener bind(SocketAddr* addr, i64 backlog) {
        Socket sock = Socket.new(AddressFamily.INET, SocketType.STREAM, SOCK_CLOEXEC, 0);
        if (sock.invalid()) { return TcpListener.closed(); }

        i32 optval = 1;
        Result<i64, Error> so = try_setsockopt(
            sock.fd,
            SocketOptionLevel.SOCKET,
            SocketOption.REUSEADDR,
            (void*)&optval,
            4
        );
        if (so.is_err()) {
            sock.close();
            return TcpListener.closed();
        }

        Result<i64, Error> b = match *addr {
            V4(sa) : try_bind(sock.fd, (void*)&sa, 16),
            V6(sa) : try_bind(sock.fd, (void*)&sa, 28),
            Unix(sa) : try_bind(sock.fd, (void*)&sa, sockaddr_un_len((SockAddrUn*)&sa))
        };
        if (b.is_err()) {
            sock.close();
            return TcpListener.closed();
        }

        Result<i64, Error> li = try_listen(sock.fd, backlog);
        if (li.is_err()) {
            sock.close();
            return TcpListener.closed();
        }

        TcpListener listener;
        listener.sock = move sock;
        return listener;
    }

    // Returns the accepted client fd; callers can use TcpStream.from_fd.
    Result<i64, Error> accept(*self) {
        if (self.invalid()) {
            return Result<i64, Error>.Err(Error.new(EINVAL, "listener is invalid"));
        }
        Result<i64, Error> r =
            try_accept4(self.sock.fd, (void*)0, (u32*)0, SOCK_CLOEXEC);
        if (r.err_is(EINTR)) {
            r = try_accept4(self.sock.fd, (void*)0, (u32*)0, SOCK_CLOEXEC);
        }
        return r;
    }
}

impl Drop for TcpListener {
    void drop(*self) {
        self.sock.drop();
    }
}
