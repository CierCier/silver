// Operator overloading traits.
//
// Each trait defines a method named `__<op>` so the existing
// operator_method_name → resolve_operator_overload path works unchanged.

trait Add<A, B>        { A __add(A self, B other); }
trait Sub<A, B>        { A __sub(A self, B other); }
trait Mul<A, B>        { A __mul(A self, B other); }
trait Div<A, B>        { A __div(A self, B other); }
trait Mod<A, B>        { A __mod(A self, B other); }
trait Neg<A>           { A __neg(A self); }

trait Eq<A>   { bool __eq(A self, A other); }
trait Ne<A>   { bool __ne(A self, A other); }
trait Lt<A>   { bool __lt(A self, A other); }
trait Gt<A>   { bool __gt(A self, A other); }
trait Le<A>   { bool __le(A self, A other); }
trait Ge<A>   { bool __ge(A self, A other); }

trait IndexedAccess<Container> {
    type Item;
    Item __index_get(Container* self, i64 index);
    void __index_set(Container* self, i64 index, Item value);
}
