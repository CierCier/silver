import std.mem.memory;
// Operator overloading traits.
//
// Each trait defines a method named `__<op>` so the existing
// operator_method_name → resolve_operator_overload path works unchanged.
// `Self` is the implicit first type parameter (the operand the operator is
// defined on); remaining parameters are the other operand types.

trait Add<B>        { Self __add(self, B other); }
trait Sub<B>        { Self __sub(self, B other); }
trait Mul<B>        { Self __mul(self, B other); }
trait Div<B>        { Self __div(self, B other); }
trait Mod<B>        { Self __mod(self, B other); }
trait Neg           { Self __neg(self); }

trait Eq<A>   { bool __eq(*self, A* other); }
trait Ne<A>   { bool __ne(*self, A* other); }
trait Lt<A>   { bool __lt(*self, A* other); }
trait Gt<A>   { bool __gt(*self, A* other); }
trait Le<A>   { bool __le(*self, A* other); }
trait Ge<A>   { bool __ge(*self, A* other); }

trait IndexedAccess {
    type Item;
    Item __index_get(*self, i64 index);
    void __index_set(*self, i64 index, Item value);
}

trait SliceAccess {
    type Output;
    Output __slice_get(*self, i64 start, i64 end);
}

// Compare trait for ordering algorithms (heapsort, binary search, etc.).
// Returns < 0 when *self sorts before *other, 0 when equal, > 0 when after.
trait Compare {
    i32 compare(*self, Self* other);
}

impl Compare for i8 {
    i32 compare(*self, i8* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for i16 {
    i32 compare(*self, i16* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for i32 {
    i32 compare(*self, i32* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for i64 {
    i32 compare(*self, i64* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for i128 {
    i32 compare(*self, i128* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for u8 {
    i32 compare(*self, u8* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for u16 {
    i32 compare(*self, u16* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for u32 {
    i32 compare(*self, u32* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for u64 {
    i32 compare(*self, u64* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for u128 {
    i32 compare(*self, u128* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for f32 {
    i32 compare(*self, f32* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for f64 {
    i32 compare(*self, f64* other) {
        if (*self < *other) { return -1; }
        if (*self > *other) { return 1; }
        return 0;
    }
}
impl Compare for bool {
    i32 compare(*self, bool* other) {
        if (!*self && *other) { return -1; }
        if (*self && !*other) { return 1; }
        return 0;
    }
}
impl Compare for str {
    i32 compare(*self, str* other) {
        return strcmp(*self, *other);
    }
}
