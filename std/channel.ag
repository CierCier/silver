// std/channel.ag — Multi-producer, multi-consumer FIFO channels (Bounded & Unbounded).
//
// Channel<T> is a thread-safe FIFO queue supporting:
//   - Unbounded mode (Channel<T>.unbounded() / Channel<T>.new()):
//     send() pushes a value and wakes one blocked receiver; it never blocks.
//   - Bounded mode (Channel<T>.bounded(cap)):
//     send() blocks when the buffer reaches capacity until space is freed.
//   - Optional-based receive:
//     recv() blocks until a value is available (returning Some(val)) or until
//     the channel is closed and drained (returning None).
//     try_recv() is non-blocking, returning Some(val) or None.
//   - Graceful shutdown:
//     close() marks the channel closed and wakes all blocked senders & receivers.
//
// Sending, receiving, closing and inspecting take `&self`, so producers and
// consumers share one channel by `&Channel<T>`. `mu` guards `queue`, `head`
// and `closed`; those methods reach them through a raw pointer to the
// channel, only while holding `mu`. `capacity` never changes after
// construction. Only `destroy` needs exclusive access.

import std.atomic;
import std.mem.alloc;
import std.mem.vec;
import std.sync;
import std.optional;

/// A thread-safe multi-producer, multi-consumer FIFO queue.
/// Unbounded channels never block on send; bounded channels block senders at
/// capacity. Share a channel by reference; do not copy or move it while other
/// threads use it, because waiters sleep on its futex words.
struct Channel<T> {
    RawMutex mu;
    Vec<T> queue;
    i64 head;       // index of the front element
    i64 capacity;   // 0 = unbounded, > 0 = bounded capacity
    bool closed;
    i32 send_sigs;  // futex word for senders waiting on available capacity
    i32 recv_sigs;  // futex word for receivers waiting on available values
}

impl<T> Channel<T> {
    /// A fresh, unbounded channel.
    Channel<T> new() {
        Channel<T> c;
        c.mu = RawMutex.new();
        c.queue = Vec<T>.new();
        c.head = 0;
        c.capacity = 0;
        c.closed = false;
        c.send_sigs = 0;
        c.recv_sigs = 0;
        return c;
    }

    /// An unbounded channel (alias for new()).
    Channel<T> unbounded() {
        return Channel<T>.new();
    }

    /// A bounded channel with backpressure when full.
    /// `cap <= 0` creates an UNBOUNDED channel (matching `capacity()`'s
    /// "0 = unbounded" convention) instead of silently clamping to 1.
    Channel<T> bounded(i64 cap) {
        Channel<T> c;
        c.mu = RawMutex.new();
        c.queue = Vec<T>.new();
        c.head = 0;
        if (cap < 0) {
            c.capacity = 0;
        } else {
            c.capacity = cap;
        }
        c.closed = false;
        c.send_sigs = 0;
        c.recv_sigs = 0;
        return c;
    }

    /// Send `value` (ownership moves in).
    /// If bounded and full, blocks until capacity is available or channel is closed.
    /// Returns true on success, false if the channel was closed. Thread-safe.
    bool send(&self, T value) {
        Channel<T>* state = self;
        while (true) {
            self.mu.lock();
            if (state.closed) {
                self.mu.unlock();
                return false;
            }
            i64 count = state.queue.len() - state.head;
            if (self.capacity > 0 && count >= self.capacity) {
                i32 expected = __atomic_load_i32(&self.send_sigs, ATOMIC_SEQ_CST);
                self.mu.unlock();
                futex_wait(&self.send_sigs, expected);
            } else {
                state.queue.push(move value);
                self.mu.unlock();
                __atomic_fetch_add_i32(&self.recv_sigs, 1, ATOMIC_SEQ_CST);
                futex_wake(&self.recv_sigs, 1);
                return true;
            }
        }
        return false;
    }

    /// Try to send `value` without blocking.
    /// Returns true if queued, false if channel is full or closed. Thread-safe.
    bool try_send(&self, T value) {
        Channel<T>* state = self;
        self.mu.lock();
        if (state.closed) {
            self.mu.unlock();
            return false;
        }
        i64 count = state.queue.len() - state.head;
        if (self.capacity > 0 && count >= self.capacity) {
            self.mu.unlock();
            return false;
        }
        state.queue.push(move value);
        self.mu.unlock();
        __atomic_fetch_add_i32(&self.recv_sigs, 1, ATOMIC_SEQ_CST);
        futex_wake(&self.recv_sigs, 1);
        return true;
    }

    /// Block until a value is available or the channel is closed and drained.
    /// Returns Some(value) if received, None if the channel is closed and empty.
    /// Ownership of the value moves to the caller. Thread-safe.
    Optional<T> recv(&self) {
        Channel<T>* state = self;
        while (true) {
            self.mu.lock();
            if (state.head < state.queue.len()) {
                T value = state.queue.get(state.head);
                state.head = state.head + 1;
                state.compact();
                self.mu.unlock();
                if (self.capacity > 0) {
                    __atomic_fetch_add_i32(&self.send_sigs, 1, ATOMIC_SEQ_CST);
                    futex_wake(&self.send_sigs, 1);
                }
                return Some(move value);
            }
            if (state.closed) {
                self.mu.unlock();
                return None;
            }
            i32 expected = __atomic_load_i32(&self.recv_sigs, ATOMIC_SEQ_CST);
            self.mu.unlock();
            futex_wait(&self.recv_sigs, expected);
        }
        return None;
    }

    /// Try to receive a value without blocking.
    /// Returns Some(value) if available, None if empty or closed. Thread-safe.
    Optional<T> try_recv(&self) {
        Channel<T>* state = self;
        self.mu.lock();
        if (state.head < state.queue.len()) {
            T value = state.queue.get(state.head);
            state.head = state.head + 1;
            state.compact();
            self.mu.unlock();
            if (self.capacity > 0) {
                __atomic_fetch_add_i32(&self.send_sigs, 1, ATOMIC_SEQ_CST);
                futex_wake(&self.send_sigs, 1);
            }
            return Some(move value);
        }
        self.mu.unlock();
        return None;
    }

    /// Number of values currently buffered. Thread-safe; the count may be
    /// stale as soon as it returns.
    i64 len(&self) {
        self.mu.lock();
        i64 n = self.queue.len() - self.head;
        self.mu.unlock();
        return n;
    }

    /// Channel capacity (0 if unbounded). Fixed at construction, so reading
    /// it needs no lock.
    i64 capacity(&self) {
        return self.capacity;
    }

    /// Returns true if the channel is closed. Thread-safe.
    bool is_closed(&self) {
        self.mu.lock();
        bool c = self.closed;
        self.mu.unlock();
        return c;
    }

    /// Mark the channel as closed and wake all blocked senders & receivers.
    /// Thread-safe and idempotent.
    void close(&self) {
        Channel<T>* state = self;
        self.mu.lock();
        state.closed = true;
        self.mu.unlock();
        __atomic_fetch_add_i32(&self.recv_sigs, 1, ATOMIC_SEQ_CST);
        futex_wake(&self.recv_sigs, 2147483647);
        __atomic_fetch_add_i32(&self.send_sigs, 1, ATOMIC_SEQ_CST);
        futex_wake(&self.send_sigs, 2147483647);
    }

    /// Drop the values still queued and free the backing queue (no
    /// sends/recvs after this).  Needs exclusive
    /// access: no other thread may still use the channel.  Resets all
    /// bookkeeping so a destroyed channel is left in a coherent state:
    /// closed (rejecting further sends), empty, unbounded, and with cleared
    /// futex words — a reuse or double-destroy cannot observe stale values.
    void destroy(&mut self) {
        self.mu.lock();
        self.discard_received();
        self.queue.drop();
        self.capacity = 0;
        self.closed = true;
        self.mu.unlock();
        __atomic_store_i32(&self.send_sigs, 0, ATOMIC_SEQ_CST);
        __atomic_store_i32(&self.recv_sigs, 0, ATOMIC_SEQ_CST);
    }

    /// Shift the live suffix to the front once the consumed prefix grows
    /// large, so a long-running producer/consumer pair does not grow the
    /// backing buffer without bound. Internal: the caller must hold `mu`.
    void compact(&mut self) {
        if (self.head >= 1024) {
            self.discard_received();
        }
    }

    /// Forget the slots before `head`. Receiving moved their values out, so
    /// they are relocated over, never dropped. Internal: the caller must
    /// hold `mu` or own the channel exclusively.
    void discard_received(&mut self) {
        i64 n = self.queue.len - self.head;
        if (self.head > 0 && n > 0) {
            silver_rt_memmove((u8*)self.queue.data, (u8*)&self.queue.data[self.head], n * @size(T));
        }
        self.queue.len = n;
        self.head = 0;
    }
}
