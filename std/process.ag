// std/process.ag — process management: spawning, waiting, and exit status.

import std.display;
import std.error;
import std.mem.alloc;
import std.mem.drop;
import std.mem.vec;
import std.result;
import std.string;
import std.sys.entry_api;
import std.sys.os;
import std.sys.raw.process;

/// Exit status of a terminated child process.
struct ExitStatus {
    i32 code;
    bool exited;
    i32 signal;
}

impl ExitStatus {
    /// True if the process exited cleanly with status 0.
    bool success(&self) {
        return self.exited && self.code == 0;
    }

    /// Exit code (0-255) if the process exited normally, or -1 otherwise.
    i32 exit_code(&self) {
        if (self.exited) {
            return self.code;
        }
        return -1;
    }

    /// Terminating signal number if killed by a signal, or 0 otherwise.
    i32 termsig(&self) {
        return self.signal;
    }
}

/// `exit status: 0` for clean exits, `signal: 9` for signal kills.
impl Display for ExitStatus {
    void fmt(*self, BufWriter* out) {
        if (self.exited) {
            @fprint(out, "exit status: {}", self.code);
        } else {
            @fprint(out, "signal: {}", self.signal);
        }
    }
}

/// A running child process.
struct Child {
    i64 pid;
    /// Windows process handle owned by this Child (0 when unknown: waiting
    /// then opens the process by pid). Unused on Linux.
    i64 handle;
}

/// A Windows Child owns its process handle until `wait_status`; dropping it
/// first closes the handle without waiting for or stopping the child.
impl Drop for Child {
    void drop(*self) {
        if (@cfg(os.windows)) {
            if (self.handle > 0) {
                win_CloseHandle(self.handle);
                self.handle = 0;
            }
        }
    }
}

impl Child {
    /// The process ID of the child.
    i64 id(&self) {
        return self.pid;
    }

    /// Wait for the child to exit and return its ExitStatus.
#[cfg(os.linux)]
    ExitStatus wait_status(&mut self) {
        ExitStatus st;
        st.code = -1;
        st.exited = false;
        st.signal = 0;
        if (self.pid <= 0) {
            return st;
        }
        i32 status = 0;
        i64 r = sys_wait4(self.pid, (i64)&status, 0, 0);
        if (r > 0) {
            self.pid = 0;
            i32 term_sig = status & 0x7F;
            if (term_sig == 0) {
                st.exited = true;
                st.code = (status >> 8) & 0xFF;
            } else {
                st.exited = false;
                st.signal = term_sig;
            }
        }
        return st;
    }

    /// Wait for the child to exit and return its ExitStatus. Windows has no
    /// signals: every termination reports `exited` with the process exit
    /// code (`kill` uses 137, the shell's 128 + SIGKILL).
#[cfg(os.windows)]
    ExitStatus wait_status(&mut self) {
        ExitStatus st;
        st.code = -1;
        st.exited = false;
        st.signal = 0;
        if (self.pid <= 0) {
            return st;
        }
        i64 h = self.handle;
        if (h <= 0) {
            h = win_OpenProcess(WIN_PROCESS_WAIT_ACCESS, 0, (u32)self.pid);
            if (h == 0) {
                return st;
            }
        }
        u32 code = 0;
        if (win_WaitForSingleObject(h, WIN_INFINITE) == 0 && win_GetExitCodeProcess(h, &code) != 0) {
            st.exited = true;
            st.code = (i32)code;
        }
        win_CloseHandle(h);
        self.handle = 0;
        self.pid = 0;
        return st;
    }

    /// Send SIGKILL to the child process (TerminateProcess with exit code
    /// 137 on Windows).
    void kill(&self) {
        if (self.pid <= 0) {
            return;
        }
        if (@cfg(os.windows)) {
            if (self.handle > 0) {
                win_TerminateProcess(self.handle, 137);
            }
        } else {
            sys_kill(self.pid, 9); // SIGKILL
        }
    }
}

/// A process builder for launching external commands.
struct Command {
    String program;
    Vec<String> args;
    Vec<String> env_vars;
    bool clear_env;
}

impl Command {
    /// Starts a command for program `prog` with no arguments, inheriting the
    /// parent environment. Copies `prog`; nothing runs until `spawn`.
    Command new(str prog) {
        Command cmd;
        cmd.program = String.from_str(prog);
        cmd.args = Vec<String>.new();
        cmd.env_vars = Vec<String>.new();
        cmd.clear_env = false;
        return cmd;
    }

    /// Appends one argument (copied). Arguments are passed as-is, with no shell
    /// splitting or quoting.
    void arg(&mut self, str a) {
        self.args.push(String.from_str(a));
    }

    /// Adds `key=val` to the child's environment (copied). Applied in addition to
    /// the inherited environment unless the environment was cleared. Does not
    /// validate `key`; a key containing `=` produces a malformed entry.
    void env(&mut self, str key, str val) {
        String entry = String.from_str(key);
        entry.push((u8)'=');
        entry.push_str(val);
        self.env_vars.push(move entry);
    }

    /// Spawn the command as a child process.
#[cfg(os.linux)]
    Result<Child, i64> spawn(&self) {
        i64 pid = sys_fork();
        if (pid < 0) {
            return Result<Child, i64>.Err(pid);
        }
        if (pid == 0) {
            // Child process: construct argv
            i64 argc = self.args.len() + 2;
            str* argv = (str*)alloc<str>(argc);
            argv[0] = self.program.to_str();
            for (i64 i = 0; i < self.args.len(); i = i + 1) {
                String* s = self.args.get_ptr(i);
                argv[i + 1] = s.to_str();
            }
            argv[argc - 1] = (str)0;

            // Construct envp
            str* envp = (str*)0;
            if (self.env_vars.len() > 0) {
                i64 envc = self.env_vars.len() + 1;
                envp = (str*)alloc<str>(envc);
                for (i64 i = 0; i < self.env_vars.len(); i = i + 1) {
                    String* e = self.env_vars.get_ptr(i);
                    envp[i] = e.to_str();
                }
                envp[envc - 1] = (str)0;
            } else if (!self.clear_env) {
                envp = (str*)silver_envp();
            }

            sys_execve((i64)self.program.to_str(), (i64)&argv[0], (i64)envp);
            sys_exit(127);
        }
        Child c;
        c.pid = pid;
        c.handle = 0;
        return Result<Child, i64>.Ok(move c);
    }

    /// Spawn the command as a child process (CreateProcessW). The program is
    /// found as Windows does (the PATH search appends `.exe`); arguments are
    /// quoted so the child's CommandLineToArgvW sees them unchanged. The
    /// child inherits the standard handles and the environment from
    /// `std.env` (including `set_var` changes) plus this command's `env`
    /// entries, which override same-named (case-insensitive) variables.
    /// Unlike Linux, where exec runs after fork and a missing program exits
    /// 127, a program that cannot start is an Err(-errno) here.
#[cfg(os.windows)]
    Result<Child, i64> spawn(&self) {
        String line = String.new();
        win_append_quoted_arg(&mut line, self.program.to_str());
        for (i64 i = 0; i < self.args.len(); i = i + 1) {
            line.push((u8)' ');
            win_append_quoted_arg(&mut line, self.args.get_ptr(i).to_str());
        }
        u16* wline = win_wide_dup(line.to_str());
        u16* wenv = win_env_block(self);

        u64 si[13]; // STARTUPINFOW (104 bytes)
        for (i64 i = 0; i < 13; i = i + 1) { si[i] = 0; }
        si[0] = 104;                                    // cb
        si[7] = (u64)WIN_STARTF_USESTDHANDLES << 32;    // dwFlags at 60
        si[10] = (u64)win_GetStdHandle(WIN_STD_INPUT);  // hStdInput at 80
        si[11] = (u64)win_GetStdHandle(WIN_STD_OUTPUT); // hStdOutput at 88
        si[12] = (u64)win_GetStdHandle(WIN_STD_ERROR);  // hStdError at 96
        u64 pi[3]; // PROCESS_INFORMATION
        pi[0] = 0;
        pi[1] = 0;
        pi[2] = 0;

        i32 ok = win_CreateProcessW((u16*)0, wline, (u8*)0, (u8*)0, 1,
            WIN_CREATE_UNICODE_ENVIRONMENT, wenv, (u16*)0, (u8*)&si[0], (u8*)&pi[0]);
        i64 err = win_last_errno();
        free((void*)wline);
        free((void*)wenv);
        if (ok == 0) {
            return Result<Child, i64>.Err(-err);
        }
        win_CloseHandle((i64)pi[1]); // primary thread handle
        Child c;
        c.pid = (i64)(pi[2] & 0xFFFFFFFF);
        c.handle = (i64)pi[0];
        return Result<Child, i64>.Ok(move c);
    }

    /// Spawn the command and wait for it to complete.
    /// Err(-ENOSYS) on WASI, which cannot spawn processes.
    Result<ExitStatus, i64> status(&self) {
        if (@cfg(os.wasi)) {
            return Result<ExitStatus, i64>.Err(-38); // ENOSYS
        } else {
            Result<Child, i64> res = self.spawn();
            if (res.is_err()) {
                return Result<ExitStatus, i64>.Err(res.unwrap_err());
            }
            Child c = res.unwrap();
            ExitStatus st = c.wait_status();
            return Result<ExitStatus, i64>.Ok(st);
        }
    }
}

/// Terminate the current process immediately with an exit code.
void exit(i32 code) {
    sys_exit_group((i64)code);
}

/// Return the process ID of the calling process.
i64 getpid() {
    return sys_getpid();
}

/// Return the process ID of the parent process.
#[cfg(os.linux)]
i64 getppid() {
    return sys_getppid();
}

/// Return the process ID of the parent process: the creator's id, which
/// Windows does not reparent (the creator may have exited since).
#[cfg(os.windows)]
i64 getppid() {
    // PROCESS_BASIC_INFORMATION (48 bytes): InheritedFromUniqueProcessId at 40.
    u64 info[6];
    for (i64 i = 0; i < 6; i = i + 1) { info[i] = 0; }
    u32 returned = 0;
    if (win_NtQueryInformationProcess(win_GetCurrentProcess(), 0, (u8*)&info[0], 48, &returned) != 0) {
        return -1;
    }
    return (i64)info[5];
}

if (@cfg(os.windows)) {
extern "C" {
    /// Win32 `CreateProcessW`.
    #[link_name("CreateProcessW")]
    i32 win_CreateProcessW(u16* app, u16* cmdline, u8* process_attrs, u8* thread_attrs,
        i32 inherit, u32 flags, u16* env, u16* cwd, u8* startup, u8* info);
    /// Win32 `GetExitCodeProcess`.
    #[link_name("GetExitCodeProcess")]
    i32 win_GetExitCodeProcess(i64 process, u32* code);
    /// ntdll `NtQueryInformationProcess`.
    #[link_name("NtQueryInformationProcess")]
    i32 win_NtQueryInformationProcess(i64 process, i32 class, u8* info, u32 len, u32* returned);
}

/// CreateProcessW flag: `env` is a UTF-16 block.
const u32 WIN_CREATE_UNICODE_ENVIRONMENT = 0x400;
/// STARTUPINFOW flag: use the hStd* handles.
const u32 WIN_STARTF_USESTDHANDLES = 0x100;
/// OpenProcess rights for waiting: SYNCHRONIZE | QUERY_LIMITED_INFORMATION.
const u32 WIN_PROCESS_WAIT_ACCESS = 0x00101000;

/// Appends `arg` to a command line, quoted by the MSVC argv rules: quotes
/// only when needed; backslashes double only before a quote.
void win_append_quoted_arg(String* line, str arg) {
    i64 len = strlen(arg);
    bool quote = len == 0;
    for (i64 i = 0; i < len; i = i + 1) {
        u8 c = (u8)arg[i];
        if (c == (u8)' ' || c == (u8)9 || c == (u8)10 || c == (u8)11 || c == (u8)'"') {
            quote = true;
        }
    }
    if (!quote) {
        line.push_str(arg);
        return;
    }
    line.push((u8)'"');
    i64 i = 0;
    while (i < len) {
        i64 slashes = 0;
        while (i < len && (u8)arg[i] == (u8)92) { // backslash
            slashes += 1;
            i += 1;
        }
        if (i == len) {
            // Before the closing quote: double them.
            for (i64 k = 0; k < slashes * 2; k = k + 1) { line.push((u8)92); }
        } else if ((u8)arg[i] == (u8)'"') {
            for (i64 k = 0; k < slashes * 2 + 1; k = k + 1) { line.push((u8)92); }
            line.push((u8)'"');
            i += 1;
        } else {
            for (i64 k = 0; k < slashes; k = k + 1) { line.push((u8)92); }
            line.push((u8)arg[i]);
            i += 1;
        }
    }
    line.push((u8)'"');
}

/// The UTF-16 environment block ("K=V", NUL-separated, double
/// NUL-terminated) for spawning `cmd`: the current `std.env` entries unless
/// cleared, minus names `cmd` overrides, then `cmd`'s entries, sorted by name
/// case-insensitively as Windows expects. Free functions in this block rather
/// than `Command` methods, so no compiler sees them off Windows. The caller
/// frees the block.
u16* win_env_block(Command* cmd) {
    Vec<String> entries = Vec<String>.new();
    i8** env = silver_envp();
    if (!cmd.clear_env && env != (i8**)0) {
        for (i64 i = 0; env[i] != (i8*)0; i = i + 1) {
            str entry = (str)env[i];
            if (!win_env_overrides(cmd, entry)) {
                entries.push(String.from_str(entry));
            }
        }
    }
    for (i64 i = 0; i < cmd.env_vars.len(); i = i + 1) {
        entries.push(String.from_str(cmd.env_vars.get_ptr(i).to_str()));
    }
    // Insertion sort: environment blocks are small.
    for (i64 i = 1; i < entries.len(); i = i + 1) {
        i64 j = i;
        while (j > 0 && win_env_name_compare(entries.get_ptr(j - 1).to_str(), entries.get_ptr(j).to_str()) > 0) {
            entries.swap(j - 1, j);
            j -= 1;
        }
    }
    i64 units = 2;
    for (i64 i = 0; i < entries.len(); i = i + 1) {
        units += win_utf16_len((u8*)entries.get_ptr(i).to_str()) + 1;
    }
    u16* block = alloc<u16>(units);
    i64 off = 0;
    for (i64 i = 0; i < entries.len(); i = i + 1) {
        off += win_utf8_to_utf16((u8*)entries.get_ptr(i).to_str(), &block[off]) + 1;
    }
    // Final terminator; an empty block needs two.
    block[off] = (u16)0;
    block[off + 1] = (u16)0;
    return block;
}

/// Byte length of the name in environment entry `entry` ("KEY=value"):
/// up to the first '=' after position 0.
i64 win_env_name_len(str entry) {
    i64 n = 1;
    while (entry[n] != 0 && entry[n] != 61) { // '='
        n += 1;
    }
    return n;
}

/// Orders environment entries by name, case-insensitively: -1, 0, or 1.
i32 win_env_name_compare(str a, str b) {
    return win_names_compare_ci((u8*)a, win_env_name_len(a), (u8*)b, win_env_name_len(b));
}

/// True when one of `cmd`'s `env` entries names the variable of `entry`
/// ("KEY=value"), compared with Windows' case-insensitive name rules.
bool win_env_overrides(Command* cmd, str entry) {
    for (i64 i = 0; i < cmd.env_vars.len(); i = i + 1) {
        if (win_env_name_compare(cmd.env_vars.get_ptr(i).to_str(), entry) == 0) {
            return true;
        }
    }
    return false;
}

/// Heap UTF-16 copy of NUL-terminated UTF-8 `text`. The caller frees it.
u16* win_wide_dup(str text) {
    u16* out = alloc<u16>(win_utf16_len((u8*)text) + 1);
    win_utf8_to_utf16((u8*)text, out);
    return out;
}
}
