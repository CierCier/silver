// expected_exit: 42
import std.test;

struct Managed<T> { T item; T sibling; }
impl<T> Drop for Managed<T> { void drop(Managed<T>* self) {} }
enum CopyChoice { Number(i64); Empty; }

T move_field<T>(Managed<T> parent) {
    return move parent.item;
}

i32 main() {
    Managed<CopyChoice> parent = {
        .item = CopyChoice.Number(40),
        .sibling = CopyChoice.Empty,
    };
    CopyChoice item = move_field(move parent);
    i64 payload = match item {
        Number(value) : value,
        Empty : 0
    };
    assert_eq_i64(40, payload, "generic invocation moves a Copy enum field");
    return 42;
}
