// compile_flags: --no-cache
import std.test;

trait ReadValue<A> {
    i64 read_value(&self, A argument);
}

struct Reader {
    i64 base;
}

impl ReadValue<i64> for Reader {
    i64 read_value(&self, i64 argument) { return self.base + argument; }
}

impl ReadValue<str> for Reader {
    i64 read_value(&self, str argument) { return self.base + strlen(argument); }
}

i32 main() {
    Reader reader;
    reader.base = 10;
    assert_eq_i64(17, reader.read_value((i64)7), "integer trait implementation");
    assert_eq_i64(13, reader.read_value("abc"), "string trait implementation");
    assert_eq_i64(10, reader.base, "overloads preserve borrowed receiver");
    return done();
}
