// Test suite for HashSet<K> — hash set backed by HashMap<K, bool>.
import std.test;
import std.collections.set;

i32 main() {
    STDOUT.write_str("=== HashSet Tests ===\n\n");

    // --- new ---
    STDOUT.write_str("--- new ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        assert_eq_i64(0, s.len(), "new set len 0");
        assert_true(s.is_empty(), "new set is empty");
        s.drop();
    }

    // --- insert and contains ---
    STDOUT.write_str("\n--- insert and contains ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.insert(10);
        s.insert(20);
        s.insert(30);
        assert_eq_i64(3, s.len(), "len 3 after 3 inserts");
        assert_true(!s.is_empty(), "not empty after inserts");
        assert_true(s.contains(10), "contains 10");
        assert_true(s.contains(20), "contains 20");
        assert_true(s.contains(30), "contains 30");
        assert_true(!s.contains(99), "does not contain 99");
        s.drop();
    }

    // --- duplicate insert ---
    STDOUT.write_str("\n--- duplicate insert ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.insert(42);
        assert_eq_i64(1, s.len(), "len 1 after first insert");
        s.insert(42);
        // HashMap replaces, so len stays the same
        assert_eq_i64(1, s.len(), "len still 1 after duplicate insert");
        assert_true(s.contains(42), "still contains 42");
        s.drop();
    }

    // --- erase ---
    STDOUT.write_str("\n--- erase ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.insert(1);
        s.insert(2);
        s.insert(3);
        assert_eq_i64(3, s.len(), "len 3 before erase");
        assert_true(!s.erase(99), "erase missing returns false");
        assert_eq_i64(3, s.len(), "len unchanged after failed erase");
        assert_true(s.erase(2), "erase existing returns true");
        assert_eq_i64(2, s.len(), "len 2 after erase");
        assert_true(!s.contains(2), "no longer contains 2");
        assert_true(s.contains(1), "still contains 1");
        assert_true(s.contains(3), "still contains 3");
        s.drop();
    }

    // --- clear ---
    STDOUT.write_str("\n--- clear ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.insert(1);
        s.insert(2);
        s.insert(3);
        s.clear();
        assert_eq_i64(0, s.len(), "len 0 after clear");
        assert_true(s.is_empty(), "is_empty after clear");
        assert_true(!s.contains(1), "no longer contains 1 after clear");
        s.insert(99);
        assert_true(s.contains(99), "can insert after clear");
        s.drop();
    }


    // --- take ---
    STDOUT.write_str("\n--- take ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.insert(11);
        s.insert(22);
        Optional<i64> taken = s.take(11);
        assert_true(taken.is_some(), "take(11) returns some");
        assert_eq_i64(taken.unwrap(), 11, "taken key is 11");
        assert_eq_i64(s.len(), 1, "len=1 after take");
        assert_true(!s.contains(11), "11 gone after take");
        assert_true(s.contains(22), "22 still present");

        Optional<i64> gone = s.take(999);
        assert_true(gone.is_none(), "take(missing) returns none");
        assert_eq_i64(s.len(), 1, "len unchanged after missing take");
        s.drop();
    }

    // --- reserve ---
    STDOUT.write_str("\n--- reserve ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.reserve(500);
        assert_eq_i64(s.len(), 0, "len=0 after reserve on empty");
        i64 i = 0;
        while (i < 200) {
            s.insert(i);
            i = i + 1;
        }
        assert_eq_i64(s.len(), 200, "len=200 after 200 inserts (reserved)");
        i = 0;
        while (i < 200) {
            assert_true(s.contains(i), "contains after reserve growth");
            i = i + 1;
        }
        s.drop();
    }

    // --- drain ---
    STDOUT.write_str("\n--- drain ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        s.insert(1);
        s.insert(2);
        s.insert(3);
        HashSetDrain<i64> dr = s.drain();
        i64 sum = 0;
        i64 count = 0;
        while (true) {
            Optional<i64> opt = dr.next();
            if (opt.is_none()) { break; }
            sum = sum + opt.unwrap();
            count = count + 1;
        }
        assert_eq_i64(count, 3, "drain yields 3 keys");
        assert_eq_i64(sum, 6, "drain sums to 6");
        assert_eq_i64(s.len(), 0, "set empty after drain");
        s.insert(99);
        assert_true(s.contains(99), "set reusable after drain");
        s.drop();
    }

    // --- insert returns bool ---
    STDOUT.write_str("\n--- insert bool ---\n");
    {
        HashSet<i64> s = HashSet<i64>.new();
        assert_true(s.insert(10), "insert 10 returns true");
        assert_true(!s.insert(10), "insert dup 10 returns false");
        assert_eq_i64(s.len(), 1, "len 1 after dup insert");
        s.drop();
    }

    // --- union ---
    STDOUT.write_str("\n--- union ---\n");
    {
        HashSet<i64> a = HashSet<i64>.new();
        a.insert(1); a.insert(2); a.insert(3);
        HashSet<i64> b = HashSet<i64>.new();
        b.insert(3); b.insert(4); b.insert(5);
        HashSet<i64> u = a.union(&b);
        assert_eq_i64(u.len(), 5, "union len 5");
        assert_true(u.contains(1), "union contains 1");
        assert_true(u.contains(2), "union contains 2");
        assert_true(u.contains(3), "union contains 3");
        assert_true(u.contains(4), "union contains 4");
        assert_true(u.contains(5), "union contains 5");
        u.drop(); a.drop(); b.drop();
    }

    // --- intersection ---
    STDOUT.write_str("\n--- intersection ---\n");
    {
        HashSet<i64> a = HashSet<i64>.new();
        a.insert(1); a.insert(2); a.insert(3); a.insert(4);
        HashSet<i64> b = HashSet<i64>.new();
        b.insert(3); b.insert(4); b.insert(5);
        HashSet<i64> inter = a.intersection(&b);
        assert_eq_i64(inter.len(), 2, "intersection len 2");
        assert_true(inter.contains(3), "intersection contains 3");
        assert_true(inter.contains(4), "intersection contains 4");
        assert_true(!inter.contains(1), "intersection not contains 1");
        inter.drop(); a.drop(); b.drop();
    }

    // --- difference ---
    STDOUT.write_str("\n--- difference ---\n");
    {
        HashSet<i64> a = HashSet<i64>.new();
        a.insert(1); a.insert(2); a.insert(3);
        HashSet<i64> b = HashSet<i64>.new();
        b.insert(3); b.insert(4);
        HashSet<i64> d = a.difference(&b);
        assert_eq_i64(d.len(), 2, "difference len 2");
        assert_true(d.contains(1), "difference contains 1");
        assert_true(d.contains(2), "difference contains 2");
        assert_true(!d.contains(3), "difference not contains 3");
        d.drop(); a.drop(); b.drop();
    }

    // --- symmetric_difference ---
    STDOUT.write_str("\n--- symmetric_difference ---\n");
    {
        HashSet<i64> a = HashSet<i64>.new();
        a.insert(1); a.insert(2); a.insert(3);
        HashSet<i64> b = HashSet<i64>.new();
        b.insert(3); b.insert(4); b.insert(5);
        HashSet<i64> sd = a.symmetric_difference(&b);
        assert_eq_i64(sd.len(), 4, "symdiff len 4");
        assert_true(sd.contains(1), "symdiff contains 1");
        assert_true(sd.contains(2), "symdiff contains 2");
        assert_true(sd.contains(4), "symdiff contains 4");
        assert_true(sd.contains(5), "symdiff contains 5");
        assert_true(!sd.contains(3), "symdiff not contains 3");
        sd.drop(); a.drop(); b.drop();
    }

    // --- is_subset / is_superset / is_disjoint ---
    STDOUT.write_str("\n--- subset / disjoint ---\n");
    {
        HashSet<i64> a = HashSet<i64>.new();
        a.insert(1); a.insert(2);
        HashSet<i64> b = HashSet<i64>.new();
        b.insert(1); b.insert(2); b.insert(3);
        HashSet<i64> c = HashSet<i64>.new();
        c.insert(4); c.insert(5);
        assert_true(a.is_subset(&b), "a subset b");
        assert_true(!b.is_subset(&a), "b not subset a");
        assert_true(b.is_superset(&a), "b superset a");
        assert_true(a.is_disjoint(&c), "a disjoint c");
        assert_true(!a.is_disjoint(&b), "a not disjoint b");
        // empty set is subset of any
        HashSet<i64> empty = HashSet<i64>.new();
        assert_true(empty.is_subset(&a), "empty subset a");
        assert_true(empty.is_disjoint(&a), "empty disjoint a");
        empty.drop(); a.drop(); b.drop(); c.drop();
    }
    return done();
}
