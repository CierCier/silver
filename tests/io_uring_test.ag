// Integration test for Linux io_uring asynchronous I/O framework
// Verifies ring setup, SQE submission, CQE reaping, NOP, async file I/O, and socket send/recv.

import std.error;
import std.io.file;
import std.mem.memory;
import std.net.inet;
import std.net.socket;
import std.net.tcp;
import std.sys.io_uring;
import std.sys.raw.fs;
import std.sys.raw.socket;
import std.sys.result;
import std.sys.socket;
import std.test;
import std.time;

// io_uring is kernel-dependent (5.1+). gVisor and older kernels return
// ENOSYS from io_uring_setup; probe once so the kernel-dependent cases
// degrade to a skip note instead of aborting, while real kernels still
// exercise the full protocol.
bool g_uring_checked = false;
bool g_uring_available = false;

bool io_uring_available() {
    if (!g_uring_checked) {
        g_uring_checked = true;
        Result<IoUring, Error> probe = IoUring.new(1);
        if (probe.is_ok()) {
            g_uring_available = true;
            IoUring ring = probe.unwrap();
            ring.close();
        } else {
            Error probe_err = probe.get_error();
            // ENOSYS: the kernel does not implement io_uring. Any other error
            // is a real failure — staying available makes the cases run and
            // fail loudly instead of masking the regression behind a skip.
            g_uring_available = probe_err.code != 38;
        }
    }
    return g_uring_available;
}

void test_io_uring_structures() {
    test_start("io_uring struct layouts");
    assert_true(@size(IoUringSqe) == 64, "IoUringSqe 64 bytes");
    assert_true(@size(IoUringCqe) == 16, "IoUringCqe 16 bytes");
    assert_true(@size(IoUringParams) == 120, "IoUringParams 120 bytes");
    assert_true(@size(IoSqringOffsets) == 40, "IoSqringOffsets 40 bytes");
    assert_true(@size(IoCqringOffsets) == 40, "IoCqringOffsets 40 bytes");
}

void test_io_uring_nop() {
    test_start("io_uring NOP submission and completion");

    if (!io_uring_available()) {
        @println("  [SKIP] io_uring_setup unavailable on this kernel (ENOSYS)");
        return;
    }

    Result<IoUring, Error> ring_res = IoUring.new(4);
    @assert(ring_res.is_ok());
    IoUring ring = ring_res.unwrap();
    @assert(ring.is_valid());

    IoUringSqe* sqe = ring.get_sqe();
    assert_true(sqe != (IoUringSqe*)0, "got sqe slot");

    ring.prep_nop(sqe, 0x1337);

    Result<i64, Error> submit_res = ring.submit_and_wait(1);
    assert_true(submit_res.is_ok(), "submit NOP");

    IoUringCqe cqe;
    bool has_cqe = ring.peek_cqe(&cqe);
    assert_true(has_cqe, "got completion");
    assert_true(cqe.user_data == 0x1337, "user_data matches");
    assert_true(cqe.res == 0, "NOP result is 0");

    ring.cqe_seen(&cqe);

    // No more completions
    assert_true(!ring.peek_cqe(&cqe), "ring drained");
}

void test_io_uring_file_io() {
    test_start("io_uring async file write and read");

    if (!io_uring_available()) {
        @println("  [SKIP] io_uring_setup unavailable on this kernel (ENOSYS)");
        return;
    }

    str path = "__silver_uring_test.txt";
    Result<i64, Error> wr_fd = try_open(path, O_RDWR | O_CREAT | O_TRUNC, 438);
    @assert(wr_fd.is_ok());
    i32 fd = (i32)wr_fd.value();

    Result<IoUring, Error> ring_res = IoUring.new(8);
    @assert(ring_res.is_ok());
    IoUring ring = ring_res.unwrap();

    // 1. Async Write
    IoUringSqe* sqe_w = ring.get_sqe();
    assert_true(sqe_w != (IoUringSqe*)0, "got write sqe");
    str text = "Hello from Silver io_uring async!";
    ring.prep_write(sqe_w, fd, (void*)text, 33, 0, 0xcafe);

    Result<i64, Error> sub1 = ring.submit_and_wait(1);
    assert_true(sub1.is_ok(), "submitted write");

    IoUringCqe cqe_w;
    assert_true(ring.peek_cqe(&cqe_w), "peek write cqe");
    assert_true(cqe_w.user_data == 0xcafe, "write cqe user_data");
    assert_true(cqe_w.res == 33, "wrote 33 bytes");
    ring.cqe_seen(&cqe_w);

    // 2. Async Read back at offset 0
    u8 read_buf[64];
    memset((void*)&read_buf[0], (u8)0, 64);

    IoUringSqe* sqe_r = ring.get_sqe();
    assert_true(sqe_r != (IoUringSqe*)0, "got read sqe");
    ring.prep_read(sqe_r, fd, (void*)&read_buf[0], 33, 0, 0xbabe);

    Result<i64, Error> sub2 = ring.submit_and_wait(1);
    assert_true(sub2.is_ok(), "submitted read");

    IoUringCqe cqe_r;
    assert_true(ring.peek_cqe(&cqe_r), "peek read cqe");
    assert_true(cqe_r.user_data == 0xbabe, "read cqe user_data");
    assert_true(cqe_r.res == 33, "read 33 bytes");
    ring.cqe_seen(&cqe_r);

    assert_true(memcmp((void*)&read_buf[0], (void*)text, 33) == 0, "file contents match");

    try_close(fd);
    sys_unlink((i64)path);
}

void test_io_uring_socket_io() {
    test_start("io_uring async socket send and recv");

    if (!io_uring_available()) {
        @println("  [SKIP] io_uring_setup unavailable on this kernel (ENOSYS)");
        return;
    }

    SocketAddr addr = SocketAddr.v4("127.0.0.1", (u16)0).unwrap();
    TcpListener listener = TcpListener.bind(&addr, 16);
    SockAddrIn sa;
    u32 slen = 16;
    try_getsockname(listener.raw_fd(), (void*)&sa, &slen);
    SocketAddr local = SocketAddr.v4("127.0.0.1", ntoh16(sa.sin_port)).unwrap();

    Result<TcpStream, Error> client_res = TcpStream.connect(&local);
    assert_true(client_res.is_ok(), "client connected");
    TcpStream client = client_res.unwrap();

    Result<i64, Error> accept_res = listener.accept();
    assert_true(accept_res.is_ok(), "server accepted");
    TcpStream server = TcpStream.from_fd((i32)accept_res.value());

    Result<IoUring, Error> ring_res = IoUring.new(8);
    assert_true(ring_res.is_ok(), "created socket ring");
    IoUring ring = ring_res.unwrap();

    // Submit async send on client socket
    IoUringSqe* sqe_s = ring.get_sqe();
    assert_true(sqe_s != (IoUringSqe*)0, "got send sqe");
    str msg = "async socket uring message!";
    ring.prep_send(sqe_s, client.sock.fd, (void*)msg, 27, 0, 0x1111);

    // Submit async recv on server socket in same batch!
    u8 recv_buf[64];
    memset((void*)&recv_buf[0], (u8)0, 64);
    IoUringSqe* sqe_r = ring.get_sqe();
    assert_true(sqe_r != (IoUringSqe*)0, "got recv sqe");
    ring.prep_recv(sqe_r, server.sock.fd, (void*)&recv_buf[0], 64, 0, 0x2222);

    // Submit both and wait for 2 completions
    Result<i64, Error> sub = ring.submit_and_wait(2);
    assert_true(sub.is_ok(), "submitted batch");

    // Reap both completions
    i64 completed = 0;
    while (completed < 2) {
        IoUringCqe cqe;
        if (ring.peek_cqe(&cqe)) {
            if (cqe.user_data == 0x1111) {
                assert_true(cqe.res == 27, "send completed 27 bytes");
            } else if (cqe.user_data == 0x2222) {
                assert_true(cqe.res == 27, "recv completed 27 bytes");
            } else {
                assert_true(false, "unexpected user_data");
            }
            ring.cqe_seen(&cqe);
            completed += 1;
        }
    }

    assert_true(memcmp((void*)&recv_buf[0], (void*)msg, 27) == 0, "socket message match");

    // A one-byte transfer completes once, with result 1.
    IoUringSqe* one_send = ring.get_sqe();
    ring.prep_send(one_send, client.sock.fd, (void*)"z", 1, 0, 0x3333);
    u8 one_byte[4];
    memset((void*)&one_byte[0], (u8)0, 4);
    IoUringSqe* one_recv = ring.get_sqe();
    ring.prep_recv(one_recv, server.sock.fd, (void*)&one_byte[0], 4, 0, 0x4444);
    Result<i64, Error> one_sub = ring.submit_and_wait(2);
    assert_true(one_sub.is_ok(), "submitted one-byte batch");
    i64 one_results = 0;
    IoUringCqe one_cqe;
    while (ring.peek_cqe(&one_cqe)) {
        assert_true(one_cqe.res == 1, "one-byte transfer completes with 1");
        ring.cqe_seen(&one_cqe);
        one_results += 1;
    }
    assert_true(one_results == 2, "one-byte send and recv each complete once");
    assert_true(one_byte[0] == (u8)'z', "one-byte payload arrives");
}

/// Sleeps briefly, then writes one byte to `fd`, so the byte arrives while
/// the ring is already waiting.
void late_write(i64 fd) {
    sleep_ms(50);
    sys_write(fd, (i64)"w", 1);
}

void test_io_uring_many_pending() {
    test_start("io_uring wait wakes on any of many pending reads");

    if (!io_uring_available()) {
        @println("  [SKIP] io_uring_setup unavailable on this kernel (ENOSYS)");
        return;
    }

    // More pending reads than one fixed-size wait batch holds; data arrives
    // only on the last one, after the wait has begun.
    i64 count = 65;
    i32 fds[130];
    for (i64 i = 0; i < count; i = i + 1) {
        @assert(sys_pipe2((i64)&fds[i * 2], 0) == 0);
    }
    Result<IoUring, Error> ring_res = IoUring.new(128);
    @assert(ring_res.is_ok());
    IoUring ring = ring_res.unwrap();
    u8 bufs[65];
    for (i64 i = 0; i < count; i = i + 1) {
        IoUringSqe* sqe = ring.get_sqe();
        assert_true(sqe != (IoUringSqe*)0, "got pending read sqe");
        ring.prep_read(sqe, fds[i * 2], (void*)&bufs[i], 1, (u64)0, (u64)i);
    }
    Result<i64, Error> queued = ring.submit();
    assert_true(queued.is_ok(), "queued every read");

    Task<void> writer = launch late_write((i64)fds[(count - 1) * 2 + 1]);
    Result<i64, Error> waited = ring.submit_and_wait(1);
    wait writer;
    assert_true(waited.is_ok(), "wait returned");

    IoUringCqe cqe;
    assert_true(ring.peek_cqe(&cqe), "the late read completed");
    assert_true(cqe.user_data == (u64)(count - 1) && cqe.res == 1, "completion is the last read");
    ring.cqe_seen(&cqe);
    ring.close();
    for (i64 i = 0; i < count * 2; i = i + 1) {
        sys_close((i64)fds[i]);
    }
}

void test_io_uring_connect() {
    test_start("io_uring connect completes once connected");

    if (!io_uring_available()) {
        @println("  [SKIP] io_uring_setup unavailable on this kernel (ENOSYS)");
        return;
    }

    SocketAddr addr = SocketAddr.v4("127.0.0.1", (u16)0).unwrap();
    TcpListener listener = TcpListener.bind(&addr, 4);
    SockAddrIn sa;
    u32 slen = 16;
    try_getsockname(listener.raw_fd(), (void*)&sa, &slen);
    Result<IoUring, Error> ring_res = IoUring.new(4);
    @assert(ring_res.is_ok());
    IoUring ring = ring_res.unwrap();

    // A blocking socket, then a non-blocking one: both complete with the
    // connect's final result, not with EINPROGRESS.
    for (i64 nonblocking = 0; nonblocking < 2; nonblocking = nonblocking + 1) {
        i64 flags = nonblocking == 1 ? SOCK_NONBLOCK : (i64)0;
        i64 fd = sys_socket((i64)AddressFamily.INET, (i64)SocketType.STREAM | flags, 0);
        assert_true(fd >= 0, "created connect socket");
        IoUringSqe* sqe = ring.get_sqe();
        ring.prep_connect(sqe, (i32)fd, (void*)&sa, 16, (u64)(0x5550 + nonblocking));
        Result<i64, Error> sub = ring.submit_and_wait(1);
        assert_true(sub.is_ok(), "submitted connect");
        IoUringCqe cqe;
        assert_true(ring.peek_cqe(&cqe), "connect completed");
        assert_true(cqe.user_data == (u64)(0x5550 + nonblocking) && cqe.res == 0, "connect result is 0");
        ring.cqe_seen(&cqe);
        Result<i64, Error> accepted = listener.accept();
        assert_true(accepted.is_ok(), "listener sees the connection");
        sys_close(accepted.value());
        sys_close(fd);
    }
    ring.close();
}

i32 main() {
    test_io_uring_structures();
    test_io_uring_nop();
    test_io_uring_file_io();
    test_io_uring_socket_io();
    test_io_uring_many_pending();
    test_io_uring_connect();
    return done();
}
