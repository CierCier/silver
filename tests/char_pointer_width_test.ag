// compile_flags: --no-cache
// error_contains: char
// A `char` is a 32-bit Unicode scalar, so a `char*` must never alias a byte
// buffer: storing through one would write four bytes into a one-byte array.
void put_char(char* target) {
    target[0] = (char)0x1f642;
}

i32 main() {
    u8 bytes[1] = {0};
    put_char(&bytes[0]);
    return 0;
}
