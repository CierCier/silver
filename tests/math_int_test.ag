// Test suite for pure-Silver integer math helpers.
import std.test;
import std.math_int;

i32 main() {
    STDOUT.write_str("=== Math Int Tests ===\n\n");

    // --- abs_i64 ---
    STDOUT.write_str("--- abs_i64 ---\n");
    {
        assert_eq_i64(0, abs_i64(0), "abs_i64(0) = 0");
        assert_eq_i64(5, abs_i64(5), "abs_i64(5) = 5");
        assert_eq_i64(5, abs_i64(-5), "abs_i64(-5) = 5");
        assert_eq_i64(42, abs_i64(42), "abs_i64(42) = 42");
        assert_eq_i64(42, abs_i64(-42), "abs_i64(-42) = 42");
    }

    // --- min_i64 / max_i64 ---
    STDOUT.write_str("\n--- min_i64 / max_i64 ---\n");
    {
        assert_eq_i64(3, min_i64(3, 7), "min(3, 7) = 3");
        assert_eq_i64(-10, min_i64(-10, 5), "min(-10, 5) = -10");
        assert_eq_i64(7, max_i64(3, 7), "max(3, 7) = 7");
        assert_eq_i64(5, max_i64(-10, 5), "max(-10, 5) = 5");
    }

    // --- gcd_i64 ---
    STDOUT.write_str("\n--- gcd_i64 ---\n");
    {
        assert_eq_i64(6, gcd_i64(12, 18), "gcd(12, 18) = 6");
        assert_eq_i64(1, gcd_i64(17, 13), "gcd(17, 13) = 1");
        assert_eq_i64(7, gcd_i64(0, 7), "gcd(0, 7) = 7");
        assert_eq_i64(7, gcd_i64(7, 0), "gcd(7, 0) = 7");
        assert_eq_i64(0, gcd_i64(0, 0), "gcd(0, 0) = 0");
        assert_eq_i64(6, gcd_i64(-12, 18), "gcd(-12, 18) = 6");
        assert_eq_i64(6, gcd_i64(-12, -18), "gcd(-12, -18) = 6");
    }

    // --- lcm_i64 ---
    STDOUT.write_str("\n--- lcm_i64 ---\n");
    {
        assert_eq_i64(36, lcm_i64(12, 18), "lcm(12, 18) = 36");
        assert_eq_i64(0, lcm_i64(0, 5), "lcm(0, 5) = 0");
        assert_eq_i64(0, lcm_i64(5, 0), "lcm(5, 0) = 0");
        assert_eq_i64(0, lcm_i64(0, 0), "lcm(0, 0) = 0");
        assert_eq_i64(36, lcm_i64(-12, 18), "lcm(-12, 18) = 36");
    }

    // --- mod_pow_i64 ---
    STDOUT.write_str("\n--- mod_pow_i64 ---\n");
    {
        assert_eq_i64(8, mod_pow_i64(2, 3, 100), "2^3 mod 100 = 8");
        assert_eq_i64(0, mod_pow_i64(2, 3, 0), "2^3 mod 0 = 0");
        assert_eq_i64(1, mod_pow_i64(5, 0, 10), "5^0 mod 10 = 1");
        assert_eq_i64(1, mod_pow_i64(5, -3, 10), "5^(-3) mod 10 = 1");
        assert_eq_i64(24, mod_pow_i64(2, 10, 1000), "2^10 mod 1000 = 24");
        assert_eq_i64(0, mod_pow_i64(10, 2, 10), "10^2 mod 10 = 0");
        // Large exponent smoke test
        assert_eq_i64(1, mod_pow_i64(7, 1000, 3), "7^1000 mod 3 = 1");
    }
    // --- signum_i64 / clamp_i64 ---
    STDOUT.write_str("\n--- signum_i64 / clamp_i64 ---\n");
    {
        assert_eq_i64(1, signum_i64(50), "signum(50) = 1");
        assert_eq_i64(-1, signum_i64(-50), "signum(-50) = -1");
        assert_eq_i64(0, signum_i64(0), "signum(0) = 0");

        assert_eq_i64(5, clamp_i64(5, 0, 10), "clamp(5, 0, 10) = 5");
        assert_eq_i64(0, clamp_i64(-5, 0, 10), "clamp(-5, 0, 10) = 0");
        assert_eq_i64(10, clamp_i64(15, 0, 10), "clamp(15, 0, 10) = 10");
    }

    // --- isqrt_i64 ---
    STDOUT.write_str("\n--- isqrt_i64 ---\n");
    {
        assert_eq_i64(0, isqrt_i64(0), "isqrt(0) = 0");
        assert_eq_i64(1, isqrt_i64(1), "isqrt(1) = 1");
        assert_eq_i64(1, isqrt_i64(3), "isqrt(3) = 1");
        assert_eq_i64(2, isqrt_i64(4), "isqrt(4) = 2");
        assert_eq_i64(3, isqrt_i64(9), "isqrt(9) = 3");
        assert_eq_i64(3, isqrt_i64(15), "isqrt(15) = 3");
        assert_eq_i64(4, isqrt_i64(16), "isqrt(16) = 4");
        assert_eq_i64(100, isqrt_i64(10000), "isqrt(10000) = 100");
    }

    // --- ext_gcd_i64 and mod_inv_i64 ---
    STDOUT.write_str("\n--- ext_gcd_i64 / mod_inv_i64 ---\n");
    {
        i64 x = 0;
        i64 y = 0;
        i64 g = ext_gcd_i64(30, 20, &x, &y);
        assert_eq_i64(10, g, "gcd(30, 20) = 10");
        assert_eq_i64(10, 30 * x + 20 * y, "30*x + 20*y = 10");

        // mod_inv(3, 11) -> 3 * 4 = 12 = 1 (mod 11) -> 4
        assert_eq_i64(4, mod_inv_i64(3, 11).unwrap(), "mod_inv(3, 11) = 4");
        // mod_inv(6, 9) -> gcd != 1 -> None
        assert_true(mod_inv_i64(6, 9).is_none(), "mod_inv(6, 9) is none");
    }

    // --- chinese_remainder_i64 ---
    STDOUT.write_str("\n--- chinese_remainder_i64 ---\n");
    {
        // x = 2 (mod 3), x = 3 (mod 5), x = 2 (mod 7) -> x = 23 (mod 105)
        i64 rems[3];
        rems[0] = 2;
        rems[1] = 3;
        rems[2] = 2;
        i64 mods[3];
        mods[0] = 3;
        mods[1] = 5;
        mods[2] = 7;
        Optional<i64> crt = chinese_remainder_i64(&rems[0], &mods[0], 3);
        assert_true(crt.is_some(), "crt is some");
        assert_eq_i64(23, crt.unwrap(), "crt(2%3, 3%5, 2%7) = 23");
    }

    return done();
}
