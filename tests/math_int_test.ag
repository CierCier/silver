// Test suite for pure-Silver integer math helpers.
import std.test;
import std.math_int;

i32 main() {
    STDOUT.write_str("=== Math Int Tests ===\n\n");

    // --- abs_i64 ---
    STDOUT.write_str("--- abs_i64 ---\n");
    {
        assert_eq_i64(0, abs_i64(0), "abs_i64(0) = 0");
        assert_eq_i64(5, abs_i64(5), "abs_i64(5) = 5");
        assert_eq_i64(5, abs_i64(-5), "abs_i64(-5) = 5");
        assert_eq_i64(42, abs_i64(42), "abs_i64(42) = 42");
        assert_eq_i64(42, abs_i64(-42), "abs_i64(-42) = 42");
    }

    // --- min_i64 / max_i64 ---
    STDOUT.write_str("\n--- min_i64 / max_i64 ---\n");
    {
        assert_eq_i64(3, min_i64(3, 7), "min(3, 7) = 3");
        assert_eq_i64(-10, min_i64(-10, 5), "min(-10, 5) = -10");
        assert_eq_i64(7, max_i64(3, 7), "max(3, 7) = 7");
        assert_eq_i64(5, max_i64(-10, 5), "max(-10, 5) = 5");
    }

    // --- gcd_i64 ---
    STDOUT.write_str("\n--- gcd_i64 ---\n");
    {
        assert_eq_i64(6, gcd_i64(12, 18), "gcd(12, 18) = 6");
        assert_eq_i64(1, gcd_i64(17, 13), "gcd(17, 13) = 1");
        assert_eq_i64(7, gcd_i64(0, 7), "gcd(0, 7) = 7");
        assert_eq_i64(7, gcd_i64(7, 0), "gcd(7, 0) = 7");
        assert_eq_i64(0, gcd_i64(0, 0), "gcd(0, 0) = 0");
        assert_eq_i64(6, gcd_i64(-12, 18), "gcd(-12, 18) = 6");
        assert_eq_i64(6, gcd_i64(-12, -18), "gcd(-12, -18) = 6");
    }

    // --- lcm_i64 ---
    STDOUT.write_str("\n--- lcm_i64 ---\n");
    {
        assert_eq_i64(36, lcm_i64(12, 18), "lcm(12, 18) = 36");
        assert_eq_i64(0, lcm_i64(0, 5), "lcm(0, 5) = 0");
        assert_eq_i64(0, lcm_i64(5, 0), "lcm(5, 0) = 0");
        assert_eq_i64(0, lcm_i64(0, 0), "lcm(0, 0) = 0");
        assert_eq_i64(36, lcm_i64(-12, 18), "lcm(-12, 18) = 36");
    }

    // --- mod_pow_i64 ---
    STDOUT.write_str("\n--- mod_pow_i64 ---\n");
    {
        assert_eq_i64(8, mod_pow_i64(2, 3, 100), "2^3 mod 100 = 8");
        assert_eq_i64(0, mod_pow_i64(2, 3, 0), "2^3 mod 0 = 0");
        assert_eq_i64(1, mod_pow_i64(5, 0, 10), "5^0 mod 10 = 1");
        assert_eq_i64(1, mod_pow_i64(5, -3, 10), "5^(-3) mod 10 = 1");
        assert_eq_i64(24, mod_pow_i64(2, 10, 1000), "2^10 mod 1000 = 24");
        assert_eq_i64(0, mod_pow_i64(10, 2, 10), "10^2 mod 10 = 0");
        // Large exponent smoke test
        assert_eq_i64(1, mod_pow_i64(7, 1000, 3), "7^1000 mod 3 = 1");
    }

    return done();
}
