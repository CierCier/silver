import std.mem.box;
import std.test;

i64 payload_drops = 0;

struct Payload { i64 value; }
impl Drop for Payload {
    void drop(*self) { payload_drops += 1; }
}

&i64* box_slot_view(&i64* slot) { return slot; }

void box_retarget(&mut i64* slot, i64* replacement) {
    *slot = replacement;
}

i32 main() {
    {
        Box<i64> number = Box<i64>.new(17);
        i64* value = number.get();
        assert_eq_i64(17, *value, "Box stores its value");
        *value = 42;
        assert_eq_i64(42, *number.get(), "get borrows the stored value");
    }
    {
        Box<i64> first = Box<i64>.new(17);
        Box<i64> second = Box<i64>.new(23);
        i64* slot = first.get();
        {
            &i64* view = box_slot_view(&slot);
            assert_eq_i64(17, **view, "forwarded slot reference reads Box pointer");
        }
        box_retarget(&mut slot, second.get());
        assert_eq_i64(23, *slot, "mutable slot reference retargets Box pointer");
        *slot = 31;
        assert_eq_i64(17, *first.get(), "retargeting preserves the first Box");
        assert_eq_i64(31, *second.get(), "retargeted pointer updates the second Box");
    }
    {
        Payload payload = { .value = 9 };
        Box<Payload> owned = Box<Payload>.new(move payload);
        Payload* value = owned.get();
        assert_eq_i64(9, value.value, "Box takes ownership of its payload");
        assert_eq_i64(0, payload_drops, "payload remains alive inside Box");
    }
    assert_eq_i64(1, payload_drops, "Box destroys the payload exactly once");
    return done();
}
