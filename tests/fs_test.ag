import std.fs;
import std.test;
import std.string;

i32 main() {
    test_start("std.fs: native filesystem operations");

    str test_file = "/tmp/__silver_fs_test_file.txt";
    str test_dir = "/tmp/__silver_fs_test_dir";

    // Clean up any stale files from prior runs
    if (exists(test_file)) {
        remove_file(test_file);
    }
    if (exists(test_dir)) {
        remove_dir(test_dir);
    }

    // Test 1: exists on non-existent file
    assert_true(!exists(test_file), "test_file does not exist initially");

    // Test 2: write_file
    bool wrote = write_file(test_file, "Hello Silver Filesystem!");
    assert_true(wrote, "write_file succeeded");
    assert_true(exists(test_file), "test_file exists after write");

    // Test 3: file_size
    i64 sz = file_size(test_file);
    assert_eq_i64(sz, 24, "file_size matches content length");

    // Test 4: read_file
    Result<String, Error> res = read_file(test_file);
    assert_true(res.is_ok(), "read_file succeeded");
    if (res.is_ok()) {
        String content = res.unwrap();
        assert_true(content.equals("Hello Silver Filesystem!"), "read_file content matches");
        content.drop();
    }

    // Test 5: remove_file
    bool removed = remove_file(test_file);
    assert_true(removed, "remove_file succeeded");
    assert_true(!exists(test_file), "test_file no longer exists");

    // Test 6: directory creation and removal
    bool dir_created = create_dir(test_dir);
    assert_true(dir_created, "create_dir succeeded");
    assert_true(exists(test_dir), "test_dir exists");

    bool dir_removed = remove_dir(test_dir);
    assert_true(dir_removed, "remove_dir succeeded");
    assert_true(!exists(test_dir), "test_dir no longer exists");

    // Test 7: is_file and is_dir and metadata
    write_file(test_file, "file content");
    assert_true(is_file(test_file), "test_file is_file is true");
    assert_true(!is_dir(test_file), "test_file is_dir is false");
    Result<Metadata, Error> meta = metadata(test_file);
    assert_true(meta.is_ok(), "metadata succeeds for file");
    if (meta.is_ok()) {
        Metadata m = meta.unwrap();
        assert_eq_i64(12, m.size, "metadata size matches");
        assert_true(m.is_file, "metadata is_file is true");
        assert_true(!m.is_dir, "metadata is_dir is false");
    }

    // Test 8: rename and copy_file
    str ren_file = "/tmp/__silver_fs_test_file_renamed.txt";
    str copy_dest = "/tmp/__silver_fs_test_file_copy.txt";
    if (exists(ren_file)) { remove_file(ren_file); }
    if (exists(copy_dest)) { remove_file(copy_dest); }

    bool ren_ok = rename(test_file, ren_file);
    assert_true(ren_ok, "rename succeeded");
    assert_true(!exists(test_file), "old path does not exist after rename");
    assert_true(exists(ren_file), "new path exists after rename");

    bool copy_ok = copy_file(ren_file, copy_dest);
    assert_true(copy_ok, "copy_file succeeded");
    assert_true(exists(copy_dest), "copy dest exists");
    assert_eq_i64(12, file_size(copy_dest), "copied file has same size");

    remove_file(ren_file);
    remove_file(copy_dest);

    // Test 9: read_dir
    create_dir(test_dir);
    str inner_file = "/tmp/__silver_fs_test_dir/inner.txt";
    write_file(inner_file, "inner data");
    assert_true(is_dir(test_dir), "test_dir is_dir is true");
    assert_true(!is_file(test_dir), "test_dir is_file is false");

    Result<Vec<String>, Error> rd = read_dir(test_dir);
    assert_true(rd.is_ok(), "read_dir succeeds");
    if (rd.is_ok()) {
        Vec<String> entries = rd.unwrap();
        assert_true(entries.len() >= 1, "read_dir found at least 1 entry");
        bool found_inner = false;
        for (i64 i = 0; i < entries.len(); i = i + 1) {
            String* s = entries.get_ptr(i);
            if (s.equals("inner.txt")) {
                found_inner = true;
            }
            s.drop();
        }
        assert_true(found_inner, "read_dir found inner.txt");
        entries.drop();
    }

    remove_file(inner_file);
    remove_dir(test_dir);

    // Test 10: remove_dir_all
    str recur_dir = "/tmp/__silver_fs_test_recur";
    str recur_sub = "/tmp/__silver_fs_test_recur/subdir";
    str recur_f1 = "/tmp/__silver_fs_test_recur/file1.txt";
    str recur_f2 = "/tmp/__silver_fs_test_recur/subdir/file2.txt";
    if (exists(recur_dir)) { remove_dir_all(recur_dir); }
    create_dir(recur_dir);
    create_dir(recur_sub);
    write_file(recur_f1, "f1");
    write_file(recur_f2, "f2");
    assert_true(exists(recur_f1), "recur_f1 exists");
    assert_true(exists(recur_f2), "recur_f2 exists");
    bool r_all = remove_dir_all(recur_dir);
    assert_true(r_all, "remove_dir_all succeeded");
    assert_true(!exists(recur_dir), "recur_dir no longer exists");

    return done();
}
