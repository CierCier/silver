// expected_compile_failure
struct Leaf { i64 value; }
impl Drop for Leaf { void drop(Leaf* self) {} }
struct Parent { Leaf item; Leaf sibling; }
impl Drop for Parent { void drop(Parent* self) {} }
struct Sink { i64 marker; }

impl Sink {
    void take(Sink* self, Leaf value) {}
}

i32 main() {
    Parent parent;
    parent.item.value = 1;
    parent.sibling.value = 2;
    Sink sink;
    sink.marker = 3;
    sink.take(parent.item);
    return 0;
}
