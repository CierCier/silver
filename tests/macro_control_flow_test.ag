import std.sys.entry;

macro i32 maximum(i32 left, i32 right) {
    if (left > right) {
        return left;
    } else {
        return right;
    }
}

i32 main() {
    i32 left = 12;
    i32 right = 7;
    if (@maximum(left, right) != 12) { return 1; }
    if (@maximum(right, left) != 12) { return 2; }
    if (@maximum(3, 9) != 9) { return 3; }
    return 0;
}
