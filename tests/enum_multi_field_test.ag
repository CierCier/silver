import std.test;

// Enum with a multi-field tuple variant.
// Match extraction covers all fields and preserves wildcard positions.
enum Point { Coords(i32, i32); }

i32 main() {
    Point p = Point.Coords(10, 20);
    i32 sum = match p { Coords(a, b) : a + b };
    assert_eq_i32(30, sum, "multi-field enum extraction");
    i32 second = match p { Coords(_, b) : b };
    assert_eq_i32(20, second, "wildcard preserves payload position");
    return done();
}
