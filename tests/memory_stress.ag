// Heavy memory-model stress test.
// Exercises RAII drop flags, move chains, by-value params, return-by-value,
// cross-linked structs, nested owned fields, raw heap pressure, realloc, and memmove.
import std.test;
import std.mem;

// ---------------- Assertions (local helpers for arg order) ----------------
void pass(str msg) {
    tests_passed = tests_passed + 1;
    STDOUT.write_str("  [PASS] ");
    STDOUT.write_str(msg);
    STDOUT.write_str("\n");
}

void fail(str msg) {
    tests_failed = tests_failed + 1;
    STDERR.write_str("  [FAIL] ");
    STDERR.write_str(msg);
    STDERR.write_str("\n");
}

void assert_true(bool cond, str msg) {
    if (cond) { pass(msg); } else { fail(msg); }
}

void assert_eq_i32(i32 got, i32 expected, str msg) {
    if (got == expected) {
        pass(msg);
    } else {
        tests_failed = tests_failed + 1;
        STDERR.write_str("  [FAIL] ");
        STDERR.write_str(msg);
        STDERR.write_str(" (expected ");
        STDERR.write_i64((i64)expected);
        STDERR.write_str(", got ");
        STDERR.write_i64((i64)got);
        STDERR.write_str(")\n");
    }
}

void assert_eq_i64(i64 got, i64 expected, str msg) {
    if (got == expected) {
        pass(msg);
    } else {
        tests_failed = tests_failed + 1;
        STDERR.write_str("  [FAIL] ");
        STDERR.write_str(msg);
        STDERR.write_str(" (expected ");
        STDERR.write_i64(expected);
        STDERR.write_str(", got ");
        STDERR.write_i64(got);
        STDERR.write_str(")\n");
    }
}


// ---------------- Raw cross-linked graph node ----------------
i32 node_drop_count = 0;
i32 node_payload_free_count = 0;
i64 node_payload_words_freed = 0;

struct RawNode {
    i32 id;
    i32* payload;
    i64 payload_words;
    bool owns_payload;
    RawNode* next;
    RawNode* prev;
    RawNode* alias;
}

impl RawNode {
    RawNode new(i32 id, i64 payload_words) {
        RawNode n;
        n.id = id;
        n.payload_words = payload_words;
        n.payload = alloc<i32>(payload_words);
        n.owns_payload = true;
        n.next = (RawNode*)0;
        n.prev = (RawNode*)0;
        n.alias = (RawNode*)0;
        for (i64 i = 0; i < payload_words; i = i + 1) {
            n.payload[i] = id * 1000 + (i32)i;
        }
        return move n;
    }

    i32 checksum_edges(RawNode* self) {
        i32 sum = self.id;
        if (self.next != (RawNode*)0) {
            sum = sum + self.next.id;
        }
        if (self.prev != (RawNode*)0) {
            sum = sum + self.prev.id;
        }
        if (self.alias != (RawNode*)0) {
            sum = sum + self.alias.id;
        }
        return sum;
    }

    bool payload_ok(RawNode* self) {
        if (self.payload == (i32*)0) {
            return false;
        }
        if (self.payload[0] != self.id * 1000) {
            return false;
        }
        if (self.payload[self.payload_words - 1] != self.id * 1000 + (i32)(self.payload_words - 1)) {
            return false;
        }
        return true;
    }
}

impl Drop for RawNode {
    void drop(RawNode* self) {
        node_drop_count = node_drop_count + 1;
        if (self.owns_payload && self.payload != (i32*)0) {
            node_payload_free_count = node_payload_free_count + 1;
            node_payload_words_freed = node_payload_words_freed + self.payload_words;
            free(self.payload);
            self.payload = (i32*)0;
            self.owns_payload = false;
        }
        self.next = (RawNode*)0;
        self.prev = (RawNode*)0;
        self.alias = (RawNode*)0;
        self.id = -(self.id);
    }
}

// ---------------- Nested owner ----------------
i32 leaf_drop_count = 0;
i32 pair_drop_count = 0;
i64 leaf_bytes_freed = 0;

struct OwnedLeaf {
    i32 id;
    i8* bytes;
    i64 len;
    bool owns;
}

impl OwnedLeaf {
    OwnedLeaf new(i32 id, i64 len) {
        OwnedLeaf leaf;
        leaf.id = id;
        leaf.len = len;
        leaf.bytes = alloc<i8>(len);
        leaf.owns = true;
        for (i64 i = 0; i < len; i = i + 1) {
            leaf.bytes[i] = (i8)((id + (i32)i) % 127);
        }
        return move leaf;
    }

    i32 first(OwnedLeaf* self) {
        return (i32)(self.bytes[0]);
    }

    bool valid(OwnedLeaf* self) {
        return self.owns && self.bytes != (i8*)0 && self.len > 0;
    }

    i64 size(&self) {
        return self.len;
    }

    i32 into_first(self) {
        return self.first();
    }
}

impl Drop for OwnedLeaf {
    void drop(OwnedLeaf* self) {
        leaf_drop_count = leaf_drop_count + 1;
        if (self.owns && self.bytes != (i8*)0) {
            leaf_bytes_freed = leaf_bytes_freed + self.len;
            free(self.bytes);
            self.bytes = (i8*)0;
            self.owns = false;
        }
        self.id = -(self.id);
    }
}

struct PairOwner {
    i32 id;
    OwnedLeaf left;
    OwnedLeaf right;
    PairOwner* peer;
}

impl PairOwner {
    PairOwner new(i32 id, i64 left_len, i64 right_len) {
        PairOwner p;
        p.id = id;
        p.left = OwnedLeaf.new(id * 10 + 1, left_len);
        p.right = OwnedLeaf.new(id * 10 + 2, right_len);
        p.peer = (PairOwner*)0;
        return move p;
    }

    i32 sum(PairOwner* self) {
        return self.id + self.left.id + self.right.id;
    }
}

impl Drop for PairOwner {
    void drop(PairOwner* self) {
        pair_drop_count = pair_drop_count + 1;
        // left and right are dropped automatically via cascading.
        self.peer = (PairOwner*)0;
        self.id = -(self.id);
    }
}

PairOwner make_pair(i32 id) {
    PairOwner p = PairOwner.new(id, 64, 96);
    return move p;
}

PairOwner forward_pair(PairOwner p) {
    return move p;
}

void consume_pair(PairOwner p) {
    // Parameter p must be dropped at function exit.
}

PairOwner choose_pair(i32 flag) {
    if (flag > 0) {
        PairOwner a = PairOwner.new(31, 128, 256);
        return move a;
    } else {
        PairOwner b = PairOwner.new(32, 256, 128);
        return move b;
    }
}

PairOwner early_pair() {
    PairOwner p = PairOwner.new(40, 33, 44);
    RawNode scratch = RawNode.new(777, 32);
    if (scratch.payload_ok()) {
        return move p;
    }
    return move p;
}

void reset_owner_counters() {
    leaf_drop_count = 0;
    pair_drop_count = 0;
    leaf_bytes_freed = 0;
}

void reset_node_counters() {
    node_drop_count = 0;
    node_payload_free_count = 0;
    node_payload_words_freed = 0;
}

// ---------------- Test cases ----------------
void stress_cross_linked_nodes() {
    STDOUT.write_str("\n--- Cross-linked RawNode graph ---\n");
    reset_node_counters();
    {
        RawNode a = RawNode.new(1, 128);
        RawNode b = RawNode.new(2, 129);
        RawNode c = RawNode.new(3, 130);
        RawNode d = RawNode.new(4, 131);
        RawNode e = RawNode.new(5, 132);
        RawNode f = RawNode.new(6, 133);

        a.next = &b; b.prev = &a;
        b.next = &c; c.prev = &b;
        c.next = &d; d.prev = &c;
        d.next = &e; e.prev = &d;
        e.next = &f; f.prev = &e;
        f.next = &a; a.prev = &f;

        a.alias = &d;
        b.alias = &e;
        c.alias = &f;
        d.alias = &a;
        e.alias = &b;
        f.alias = &c;

        assert_true(a.payload_ok(), "a payload edges are intact");
        assert_true(f.payload_ok(), "f payload edges are intact");
        assert_eq_i32(a.checksum_edges(), 13, "a edge checksum includes id/next/prev/alias");
        assert_eq_i32(c.checksum_edges(), 15, "c edge checksum includes id/next/prev/alias");

        a.next.payload[10] = 4242;
        assert_eq_i32(b.payload[10], 4242, "cross-reference write through next pointer");
        d.alias.payload[20] = 9090;
        assert_eq_i32(a.payload[20], 9090, "cross-reference write through alias pointer");
    }
    assert_eq_i32(node_drop_count, 6, "six graph nodes dropped once");
    assert_eq_i32(node_payload_free_count, 6, "six graph payloads freed once");
    assert_eq_i64(node_payload_words_freed, 783, "all graph payload word counts accounted");
}

void stress_owner_moves_and_params() {
    STDOUT.write_str("\n--- Nested owner moves, returns, params ---\n");

    reset_owner_counters();
    {
        PairOwner p = make_pair(10);
        PairOwner q = forward_pair(move p);
        assert_eq_i32(q.sum(), 213, "forwarded pair contents survive move chain");
    }
    assert_eq_i32(pair_drop_count, 1, "forwarded pair dropped once");
    assert_eq_i32(leaf_drop_count, 2, "forwarded pair leaves dropped once each");
    assert_eq_i64(leaf_bytes_freed, 160, "forwarded pair leaf bytes accounted");

    reset_owner_counters();
    {
        PairOwner p = PairOwner.new(20, 11, 13);
        consume_pair(move p);
    }
    assert_eq_i32(pair_drop_count, 1, "by-value parameter dropped in callee");
    assert_eq_i32(leaf_drop_count, 2, "by-value parameter leaves dropped");
    assert_eq_i64(leaf_bytes_freed, 24, "by-value parameter leaf bytes accounted");

    reset_owner_counters();
    {
        PairOwner p = choose_pair(1);
        assert_eq_i32(p.sum(), 654, "positive conditional return preserved contents");
    }
    assert_eq_i32(pair_drop_count, 1, "positive conditional return dropped once");
    assert_eq_i32(leaf_drop_count, 2, "positive conditional leaves dropped");

    reset_owner_counters();
    reset_node_counters();
    {
        PairOwner p = early_pair();
        assert_eq_i32(p.sum(), 843, "early return preserves returned owner");
    }
    assert_eq_i32(pair_drop_count, 1, "early-returned pair dropped once");
    assert_eq_i32(leaf_drop_count, 2, "early-returned pair leaves dropped");
    assert_eq_i32(node_drop_count, 1, "early-return scratch node dropped once");
    assert_eq_i32(node_payload_free_count, 1, "early-return scratch payload freed");

    // OwnedLeaf's fields are all Copy, but its Drop frees memory, so a
    // plain `=` must transfer ownership rather than duplicate it.
    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(1, 8);
        OwnedLeaf b = a;
        assert_eq_i32(b.first(), 1, "implicitly moved leaf keeps its bytes");
    }
    assert_eq_i32(leaf_drop_count, 1, "implicit let transfer drops once");
    assert_eq_i64(leaf_bytes_freed, 8, "implicit let transfer frees once");

    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(2, 4);
        OwnedLeaf b = OwnedLeaf.new(3, 16);
        b = a;
        assert_eq_i32(b.first(), 2, "assigned leaf holds the source bytes");
    }
    assert_eq_i32(leaf_drop_count, 2, "assignment drops the old value and the moved one");
    assert_eq_i64(leaf_bytes_freed, 20, "assignment frees both buffers once");

    reset_owner_counters();
    {
        OwnedLeaf l = OwnedLeaf.new(4, 2);
        OwnedLeaf r = OwnedLeaf.new(5, 3);
        PairOwner p = { .id = 6, .left = l, .right = r, .peer = (PairOwner*)0 };
        assert_eq_i32(p.sum(), 15, "initializer took both leaves");
    }
    assert_eq_i32(pair_drop_count, 1, "initializer-built pair dropped once");
    assert_eq_i32(leaf_drop_count, 2, "initializer sources drop only through the pair");
    assert_eq_i64(leaf_bytes_freed, 5, "initializer sources free once");
}

void stress_loop_churn() {
    STDOUT.write_str("\n--- Loop churn and scope pressure ---\n");
    reset_node_counters();
    reset_owner_counters();

    for (i32 i = 0; i < 40; i = i + 1) {
        RawNode n = RawNode.new(1000 + i, 64 + (i % 7));
        assert_true(n.payload_ok(), "loop node payload valid");
        if (i % 3 == 0) {
            PairOwner p = PairOwner.new(2000 + i, 16, 24);
            assert_true(p.sum() > 0, "loop nested owner valid");
        }
    }

    assert_eq_i32(node_drop_count, 40, "loop nodes dropped at each iteration scope");
    assert_eq_i32(node_payload_free_count, 40, "loop node payloads freed");
    assert_eq_i32(pair_drop_count, 14, "loop pair owners dropped for selected iterations");
    assert_eq_i32(leaf_drop_count, 28, "loop pair leaves dropped for selected iterations");
    assert_eq_i64(leaf_bytes_freed, 560, "loop pair leaf bytes accounted");
}

// ---------------- Conditional and borrowed transfers ----------------
i32 deferred_leaf_id = 0;

/// A defer names the `outer` leaf visible where it was written, even when
/// the return runs it inside a scope with another leaf of that name.
i32 defer_sees_outer_leaf() {
    OwnedLeaf leaf = OwnedLeaf.new(21, 1);
    defer deferred_leaf_id = leaf.id;
    {
        OwnedLeaf leaf = OwnedLeaf.new(22, 1);
        return leaf.id;
    }
}

i64 leaf_count(Slice<OwnedLeaf> leaves) {
    return leaves.len();
}

void keep_leaf(OwnedLeaf leaf) {
    assert_eq_i32(leaf.first(), 25, "match binding moved its payload out");
}

struct LeafSlot {
    [OwnedLeaf, i64] pair;
}

/// A non-generic enum whose payload owns a leaf, held by a plain struct.
enum LeafEvent { Held(OwnedLeaf); Idle; }

struct EventHolder {
    LeafEvent event;
    i64 serial;
}

/// Takes an event and drops it at its end.
void consume_event(LeafEvent event) {}

/// Returns the holder's event, which moves it out of the holder.
LeafEvent event_of(i32 id) {
    EventHolder holder;
    holder.event = LeafEvent.Held(OwnedLeaf.new(id, 2));
    holder.serial = 1;
    return holder.event;
}

/// Takes a leaf and drops it at its end.
void keep_leaf_id(OwnedLeaf leaf) {}

i32 leaf_id_of(OwnedLeaf leaf) {
    return leaf.id;
}

/// A variant with two owned payloads.
enum LeafTwin { Both(OwnedLeaf, OwnedLeaf); Neither; }

struct TwinHolder {
    i32 id;
    LeafTwin twin;
}

/// Refills `place` with a fresh leaf and yields `id`, so a later element of
/// an aggregate can reinitialize what an earlier element moved.
macro refill_leaf(place, id) {
    place = OwnedLeaf.new(id, 1);
    return id;
}

/// Two leaves and no destructor of its own, so a field can move out.
struct LeafPair {
    OwnedLeaf left;
    OwnedLeaf right;
}

LeafPair leaf_pair(i32 id) {
    LeafPair pair;
    pair.left = OwnedLeaf.new(id, 2);
    pair.right = OwnedLeaf.new(id + 1, 3);
    return move pair;
}

OwnedLeaf left_of_new_pair(i32 id) {
    return leaf_pair(id).left;
}

i32 first_of(OwnedLeaf leaf) {
    return leaf.first();
}

void stress_conditional_and_borrowed_transfers() {
    STDOUT.write_str("\n--- Conditional and borrowed transfers ---\n");
    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(20, 4);
        bool pick = leaf_drop_count == 0;
        OwnedLeaf b = pick ? a : OwnedLeaf.new(19, 2);
        assert_eq_i32(b.first(), 20, "conditional took the leaf");
    }
    assert_eq_i32(leaf_drop_count, 1, "conditional transfer drops once");
    assert_eq_i64(leaf_bytes_freed, 4, "conditional transfer frees once");

    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(20, 4);
        bool pick = leaf_drop_count != 0;
        OwnedLeaf b = pick ? a : OwnedLeaf.new(19, 2);
        assert_eq_i32(b.first(), 19, "conditional built the other leaf");
    }
    assert_eq_i32(leaf_drop_count, 2, "both leaves drop once when the other arm runs");
    assert_eq_i64(leaf_bytes_freed, 6, "both leaves free once when the other arm runs");

    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(25, 4);
        keep_leaf(leaf_drop_count == 0 ? a : OwnedLeaf.new(25, 2));
    }
    assert_eq_i32(leaf_drop_count, 1, "a conditional argument moves its leaf into the callee");
    assert_eq_i64(leaf_bytes_freed, 4, "a conditional argument frees its leaf once");

    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(25, 4);
        keep_leaf(leaf_drop_count != 0 ? a : OwnedLeaf.new(25, 2));
    }
    assert_eq_i32(leaf_drop_count, 2, "the unused leaf drops at scope exit");
    assert_eq_i64(leaf_bytes_freed, 6, "both conditional-argument leaves free once");

    reset_owner_counters();
    assert_eq_i32(defer_sees_outer_leaf(), 22, "inner leaf returned its id");
    assert_eq_i32(deferred_leaf_id, 21, "defer read the leaf in its own scope");
    assert_eq_i32(leaf_drop_count, 2, "both shadowing leaves dropped once");

    reset_owner_counters();
    {
        Vec<OwnedLeaf> leaves = Vec<OwnedLeaf>.new();
        leaves.push(OwnedLeaf.new(23, 2));
        leaves.push(OwnedLeaf.new(24, 3));
        assert_eq_i64(leaf_count(leaves), 2, "slice parameter viewed the vec");
        i64(Slice<OwnedLeaf>) count = leaf_count;
        assert_eq_i64(count(leaves), 2, "a local callable's slice parameter viewed the vec");
        assert_eq_i64(leaves.len(), 2, "vec still owns its leaves after the call");
    }
    assert_eq_i32(leaf_drop_count, 2, "vec viewed as a slice drops its leaves once");
    assert_eq_i64(leaf_bytes_freed, 5, "vec viewed as a slice frees once");

    reset_owner_counters();
    {
        Vec<OwnedLeaf> leaves = Vec<OwnedLeaf>.new();
        leaves.push(OwnedLeaf.new(40, 1));
        leaves.push(OwnedLeaf.new(41, 2));
        leaves.push(OwnedLeaf.new(42, 3));
        leaves.push(OwnedLeaf.new(43, 4));
        Vec<i32> ids = Vec<i32>.new();
        ids.push(leaves.get_ref(1).first());
        assert_eq_i32(ids.get(0), 41, "get copied a Copy element out");
        assert_eq_i32(leaf_drop_count, 0, "a borrowed element is not dropped");
        {
            OwnedLeaf last = leaves.pop();
            OwnedLeaf first = leaves.take(0);
            OwnedLeaf swapped = leaves.swap_remove(0);
            assert_eq_i32(last.first() + first.first() + swapped.first(), 124, "pop, take, and swap_remove moved the elements out");
        }
        assert_eq_i32(leaf_drop_count, 3, "taken elements drop once with their new owners");
        assert_eq_i64(leaves.len(), 1, "the vec still owns one element");
        ids.drop();
    }
    assert_eq_i32(leaf_drop_count, 4, "the vec drops only the element it still owns");
    assert_eq_i64(leaf_bytes_freed, 10, "each element frees once");

    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(29, 4);
        bool outer = leaf_drop_count == 0;
        bool inner = leaf_drop_count != 0;
        OwnedLeaf b = outer ? (inner ? a : OwnedLeaf.new(30, 2)) : OwnedLeaf.new(31, 1);
        assert_eq_i32(b.first(), 30, "nested conditional built the inner leaf");
    }
    assert_eq_i32(leaf_drop_count, 2, "nested conditional drops each leaf once");
    assert_eq_i64(leaf_bytes_freed, 6, "nested conditional frees each leaf once");

    reset_owner_counters();
    {
        Optional<OwnedLeaf> maybe = Optional<OwnedLeaf>.Some(OwnedLeaf.new(25, 6));
        match maybe {
            Some(move leaf): keep_leaf(move leaf),
            None: {},
        };
    }
    assert_eq_i32(leaf_drop_count, 1, "moved payload binding drops once");
    assert_eq_i64(leaf_bytes_freed, 6, "moved payload binding frees once");

    // A `move` binding owns its payload: it drops once whether a local
    // takes it, the arm only reads it, or the arm yields a Copy field.
    reset_owner_counters();
    {
        Optional<OwnedLeaf> maybe = Optional<OwnedLeaf>.Some(OwnedLeaf.new(32, 2));
        match maybe {
            Some(move leaf): { OwnedLeaf kept = leaf; },
            None: {},
        };
        Optional<OwnedLeaf> other = Optional<OwnedLeaf>.Some(OwnedLeaf.new(33, 3));
        match other {
            Some(move leaf): { i32 id = leaf.first(); },
            None: {},
        };
        Optional<OwnedLeaf> third = Optional<OwnedLeaf>.Some(OwnedLeaf.new(34, 4));
        i64 len = match third {
            Some(move leaf): leaf.len,
            None: 0,
        };
        assert_eq_i64(len, 4, "an arm yielded a Copy field of its binding");
    }
    assert_eq_i32(leaf_drop_count, 3, "each move binding drops its payload once");
    assert_eq_i64(leaf_bytes_freed, 9, "each move binding frees its payload once");

    reset_owner_counters();
    {
        EventHolder holder;
        holder.event = LeafEvent.Held(OwnedLeaf.new(37, 3));
        holder.serial = 1;
        LeafEvent taken = move holder.event;
    }
    assert_eq_i32(leaf_drop_count, 1, "an enum field moved out drops its payload once");
    assert_eq_i64(leaf_bytes_freed, 3, "an enum field moved out frees its payload once");

    // A by-value use of such a field moves it the same way.
    reset_owner_counters();
    {
        EventHolder holder;
        holder.event = LeafEvent.Held(OwnedLeaf.new(38, 1));
        holder.serial = 1;
        LeafEvent taken = holder.event;
        EventHolder other;
        other.event = LeafEvent.Held(OwnedLeaf.new(39, 2));
        other.serial = 2;
        consume_event(other.event);
        LeafEvent returned = event_of(40);
        EventHolder third;
        third.event = LeafEvent.Held(OwnedLeaf.new(41, 4));
        third.serial = 3;
        bool pick = third.serial == 3;
        LeafEvent picked = pick ? third.event : LeafEvent.Idle;
        EventHolder fourth;
        fourth.event = LeafEvent.Held(OwnedLeaf.new(42, 8));
        fourth.serial = 4;
        EventHolder rebuilt = { .event = fourth.event, .serial = 5 };
        EventHolder fifth;
        fifth.event = LeafEvent.Held(OwnedLeaf.new(43, 16));
        fifth.serial = 6;
        [LeafEvent, i64] paired = [fifth.event, 7];
        assert_eq_i32(leaf_drop_count, 1, "only the consumed event dropped early");
    }
    assert_eq_i32(leaf_drop_count, 6, "an enum field used by value drops its payload once");
    assert_eq_i64(leaf_bytes_freed, 33, "an enum field used by value frees its payload once");

    // An aggregate owns each element as it builds it, so a later element
    // that refills the moved source leaves the new leaf with its source.
    reset_owner_counters();
    {
        LeafPair pair = leaf_pair(44);
        [OwnedLeaf, i32] first = [pair.left, @refill_leaf(pair.left, 46)];
        OwnedLeaf solo = OwnedLeaf.new(47, 4);
        [OwnedLeaf, i32] second = [solo, @refill_leaf(solo, 48)];
        assert_eq_i32(first[0].first(), 44, "the tuple kept the moved leaf");
        assert_eq_i32(pair.left.first(), 46, "the refilled field holds the new leaf");
        assert_eq_i32(solo.first(), 48, "the refilled local holds the new leaf");
    }
    assert_eq_i32(leaf_drop_count, 5, "a refilled aggregate source drops each leaf once");
    assert_eq_i64(leaf_bytes_freed, 11, "a refilled aggregate source frees each leaf once");

    // Moving one payload of a two-payload arm out leaves the arm owning the
    // other, named or not, which drops at the arm's end.
    reset_owner_counters();
    {
        LeafTwin named = LeafTwin.Both(OwnedLeaf.new(49, 1), OwnedLeaf.new(50, 2));
        match named {
            Both(move left, right): { OwnedLeaf kept = move left; OwnedLeaf other = right; },
            Neither: {},
        };
        assert_eq_i32(leaf_drop_count, 2, "a named sibling of a moved payload drops in its arm");
        LeafTwin unnamed = LeafTwin.Both(OwnedLeaf.new(51, 4), OwnedLeaf.new(52, 8));
        match unnamed {
            Both(move left, _): { keep_leaf_id(move left); },
            Neither: {},
        };
        LeafTwin both = LeafTwin.Both(OwnedLeaf.new(53, 16), OwnedLeaf.new(54, 32));
        match both {
            Both(move left, move right): { OwnedLeaf kept = move right; },
            Neither: {},
        };
    }
    assert_eq_i32(leaf_drop_count, 6, "each payload of a partly moved arm drops once");
    assert_eq_i64(leaf_bytes_freed, 63, "each payload of a partly moved arm frees once");

    // The same holds when the matched enum is a field: the holder must not
    // free the payloads its arm already owns.
    reset_owner_counters();
    {
        TwinHolder holder;
        holder.id = 1;
        holder.twin = LeafTwin.Both(OwnedLeaf.new(55, 64), OwnedLeaf.new(56, 128));
        match holder.twin {
            Both(move left, _): { keep_leaf_id(move left); },
            Neither: {},
        };
    }
    assert_eq_i32(leaf_drop_count, 2, "a partly moved field enum drops each payload once");
    assert_eq_i64(leaf_bytes_freed, 192, "a partly moved field enum frees each payload once");

    // A payload binding that reuses the scrutinee's name must not hide the
    // enum's own storage from the move-out, in a statement or a value match.
    reset_owner_counters();
    {
        LeafTwin shadowed = LeafTwin.Both(OwnedLeaf.new(57, 256), OwnedLeaf.new(58, 512));
        match shadowed {
            Both(move left, shadowed): { keep_leaf_id(move left); },
            Neither: {},
        };
        LeafTwin valued = LeafTwin.Both(OwnedLeaf.new(59, 1024), OwnedLeaf.new(60, 2048));
        i32 taken = match valued {
            Both(move valued, right): leaf_id_of(move valued),
            Neither: 0,
        };
        assert_eq_i32(taken, 59, "a value match yields the moved payload's id");
    }
    assert_eq_i32(leaf_drop_count, 4, "a payload named like its scrutinee drops each payload once");
    assert_eq_i64(leaf_bytes_freed, 3840, "a payload named like its scrutinee frees each payload once");

    // An arm block drops its own locals and runs its defers at the arm's end.
    reset_owner_counters();
    deferred_leaf_id = 0;
    {
        Optional<OwnedLeaf> maybe = Optional<OwnedLeaf>.Some(OwnedLeaf.new(35, 1));
        match maybe {
            Some(leaf): {
                OwnedLeaf extra = OwnedLeaf.new(36, 5);
                defer deferred_leaf_id = leaf.id;
            },
            None: {},
        };
        assert_eq_i32(leaf_drop_count, 1, "an arm block dropped its local");
        assert_eq_i32(deferred_leaf_id, 35, "an arm block ran its defer");
    }
    assert_eq_i32(leaf_drop_count, 2, "an arm local and the payload drop once");
    assert_eq_i64(leaf_bytes_freed, 6, "an arm local and the payload free once");

    reset_owner_counters();
    {
        OwnedLeaf a = OwnedLeaf.new(26, 7);
        LeafSlot slot = { .pair = [a, 1] };
        assert_eq_i32(slot.pair[0].first(), 26, "tuple field took the leaf");
    }
    assert_eq_i32(leaf_drop_count, 1, "tuple element in an initializer drops once");
    assert_eq_i64(leaf_bytes_freed, 7, "tuple element in an initializer frees once");

    reset_owner_counters();
    {
        i32 first = OwnedLeaf.new(27, 3).first();
        assert_eq_i32(first, 27, "temporary was readable");
        assert_eq_i32(leaf_drop_count, 0, "a temporary lives to the end of its block");
    }
    assert_eq_i32(leaf_drop_count, 1, "a temporary drops once at block exit");
    i64 pass = 0;
    while (pass < 3) {
        i32 _id = OwnedLeaf.new(28, 1).first();
        pass += 1;
    }
    assert_eq_i32(leaf_drop_count, 4, "a loop body drops its temporary on each pass");

    reset_owner_counters();
    {
        bool taken = leaf_drop_count == 0;
        i32 hit = taken ? OwnedLeaf.new(32, 2).first() : 0;
        i32 miss = taken ? 0 : OwnedLeaf.new(33, 5).first();
        assert_eq_i32(hit + miss, 32, "only the arm that ran built a temporary");
    }
    assert_eq_i32(leaf_drop_count, 1, "only the temporary of the arm that ran drops");
    assert_eq_i64(leaf_bytes_freed, 2, "only the temporary of the arm that ran frees");

    reset_owner_counters();
    {
        bool ready = leaf_drop_count > 0;
        bool skipped = ready && OwnedLeaf.new(35, 2).valid();
        bool evaluated = !ready && OwnedLeaf.new(36, 3).valid();
        assert_true(!skipped && evaluated, "only the evaluated operand built a temporary");
    }
    assert_eq_i32(leaf_drop_count, 1, "a skipped operand's temporary never drops");
    assert_eq_i64(leaf_bytes_freed, 3, "only the evaluated operand's temporary frees");

    reset_owner_counters();
    {
        OwnedLeaf.new(34, 3).drop();
    }
    assert_eq_i32(leaf_drop_count, 1, "an explicitly dropped temporary drops once");
    assert_eq_i64(leaf_bytes_freed, 3, "an explicitly dropped temporary frees once");

    reset_owner_counters();
    {
        Optional<i64> pick = Optional<i64>.Some(1);
        i32 id = (match pick { Some(n): OwnedLeaf.new(37, 2), None: OwnedLeaf.new(38, 9) }).id;
        Optional<OwnedLeaf> missing = Optional<OwnedLeaf>.None;
        i64 len = (missing ? OwnedLeaf.new(39, 4)).size();
        assert_eq_i64((i64)id + len, 41, "a match result and a fallback were readable");
        assert_eq_i32(leaf_drop_count, 0, "a match or fallback result lives to the end of its block");
    }
    assert_eq_i32(leaf_drop_count, 2, "a match or fallback result drops once");
    assert_eq_i64(leaf_bytes_freed, 6, "a match or fallback result frees once");

    reset_owner_counters();
    {
        Optional<OwnedLeaf> first = Optional<OwnedLeaf>.Some(OwnedLeaf.new(40, 2));
        Optional<OwnedLeaf> second = first;
        OwnedLeaf kept = OwnedLeaf.new(41, 3);
        OwnedLeaf taken = second ? kept;
        OwnedLeaf named = OwnedLeaf.new(42, 4);
        Optional<OwnedLeaf> missing = Optional<OwnedLeaf>.None;
        OwnedLeaf used = missing ? named;
        assert_eq_i32(taken.first() + used.first(), 82, "a payload and a named fallback were taken");
        assert_eq_i32(leaf_drop_count, 0, "a moved Optional and its fallbacks are still owned");
    }
    assert_eq_i32(leaf_drop_count, 3, "a moved Optional and a named fallback drop once");
    assert_eq_i64(leaf_bytes_freed, 9, "a moved Optional and a named fallback free once");

    // A field moved out of a call result leaves; its temporary keeps and
    // drops only the sibling.
    reset_owner_counters();
    {
        OwnedLeaf named = leaf_pair(43).left;
        OwnedLeaf returned = left_of_new_pair(45);
        i32 consumed = first_of(leaf_pair(49).left) + leaf_pair(51).right.into_first();
        OwnedLeaf assigned = OwnedLeaf.new(70, 1);
        assigned = leaf_pair(53).left;
        i32 id = leaf_pair(55).left.id;
        i64 size = leaf_pair(57).right.size();
        LeafPair rebuilt = { .left = leaf_pair(59).left, .right = OwnedLeaf.new(72, 1) };
        i32 kept = named.first() + returned.first() + assigned.first() + rebuilt.left.first();
        assert_eq_i32(consumed + kept, 301, "each moved field kept its own bytes");
        assert_eq_i64((i64)id + size, 58, "a Copy field and a borrowed field were readable");
    }
    assert_eq_i32(leaf_drop_count, 18, "a field moved out of a temporary drops once");
    assert_eq_i64(leaf_bytes_freed, 42, "a field moved out of a temporary frees once");

    // A shadowing local takes the outer value it names.
    reset_owner_counters();
    {
        OwnedLeaf leaf = OwnedLeaf.new(61, 2);
        {
            OwnedLeaf leaf = leaf;
            assert_eq_i32(leaf.first(), 61, "a shadowing local read the outer value");
        }
        assert_eq_i32(leaf_drop_count, 1, "a shadowing local drops the value it took");
    }
    assert_eq_i32(leaf_drop_count, 1, "a shadowed local does not drop again");
    assert_eq_i64(leaf_bytes_freed, 2, "a shadowed value frees once");
}

void stress_defer_and_break_continue() {
    STDOUT.write_str("\n--- Defer, break, continue with owned locals ---\n");
    reset_node_counters();
    reset_owner_counters();
    i32 defer_marker = 0;

    {
        PairOwner p = PairOwner.new(50, 12, 14);
        defer {
            defer_marker = defer_marker + 10;
        }
    }
    assert_eq_i32(defer_marker, 10, "defer executed when owned block exits");
    assert_eq_i32(pair_drop_count, 1, "owned value dropped with defer present");
    assert_eq_i32(leaf_drop_count, 2, "nested leaves dropped with defer present");

    reset_owner_counters();
    {
        OwnedLeaf outer_leaf = OwnedLeaf.new(52, 3);
        Optional<i64> pick = Optional<i64>.Some(1);
        OwnedLeaf yielded = match pick {
            Some(n): {
                OwnedLeaf inner = OwnedLeaf.new(53, 4);
                defer { defer_marker = defer_marker + 1; }
                outer_leaf;
            },
            None: OwnedLeaf.new(54, 5),
        };
        assert_eq_i32(defer_marker, 11, "a yielding block ran its defer");
        assert_eq_i32(leaf_drop_count, 1, "a yielding block dropped its own local");
        assert_eq_i32(yielded.first(), 52, "a value block handed out the outer leaf");
    }
    assert_eq_i32(leaf_drop_count, 2, "a leaf yielded by a value block drops once");
    assert_eq_i64(leaf_bytes_freed, 7, "a leaf yielded by a value block frees once");

    reset_node_counters();
    for (i32 i = 0; i < 10; i = i + 1) {
        RawNode n = RawNode.new(3000 + i, 24);
        if (i == 5) {
            break;
        }
    }
    assert_eq_i32(node_drop_count, 6, "break drops current and prior loop locals");
    assert_eq_i32(node_payload_free_count, 6, "break frees current and prior loop payloads");

    reset_node_counters();
    for (i32 i = 0; i < 9; i = i + 1) {
        RawNode n = RawNode.new(4000 + i, 25);
        if (i % 2 == 0) {
            continue;
        }
    }
    assert_eq_i32(node_drop_count, 9, "continue drops every iteration local");
    assert_eq_i32(node_payload_free_count, 9, "continue frees every iteration payload");
}

void stress_large_raw_memory() {
    STDOUT.write_str("\n--- Large raw heap, realloc, memmove ---\n");

    i64 large_size = 4000000;
    i8* big = alloc<i8>(large_size);
    for (i64 i = 0; i < large_size; i = i + 4096) {
        big[i] = (i8)((i / 4096) % 127);
    }
    big[large_size - 1] = 99;

    bool sparse_ok = true;
    for (i64 i = 0; i < large_size; i = i + 4096) {
        if (big[i] != (i8)((i / 4096) % 127)) {
            sparse_ok = false;
        }
    }
    assert_true(sparse_ok, "sparse writes across 4MB allocation survive");
    assert_eq_i32((i32)big[large_size - 1], 99, "last byte of 4MB allocation writable");

    big = realloc<i8>(big, 8000000);
    assert_true(big != (i8*)0, "realloc to 8MB returned non-null");
    assert_eq_i32((i32)big[large_size - 1], 99, "realloc preserved tail byte");
    big[7999999] = 77;
    assert_eq_i32((i32)big[7999999], 77, "new realloc tail byte writable");

    // Overlap move: [0..4095] -> [2048..6143]
    for (i64 i = 0; i < 4096; i = i + 1) {
        big[i] = (i8)(i % 101);
    }
    memmove(&big[2048], big, 4096);
    bool move_ok = true;
    for (i64 i = 0; i < 4096; i = i + 1) {
        if (big[2048 + i] != (i8)(i % 101)) {
            move_ok = false;
        }
    }
    assert_true(move_ok, "overlapping memmove preserved copied pattern");

    free(big);
}

i32 main() {
    STDOUT.write_str("=== Memory Stress Torture Test ===\n");

    stress_cross_linked_nodes();
    stress_owner_moves_and_params();
    stress_loop_churn();
    stress_conditional_and_borrowed_transfers();
    stress_defer_and_break_continue();
    stress_large_raw_memory();

    return done();
}
