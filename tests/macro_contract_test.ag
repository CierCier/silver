// compile_flags: --no-cache
import std.test;

i32 evaluations = 0;
i32 tick() { evaluations += 1; return evaluations; }

macro i32 twice(i32 value) { return value + value; }
macro i32 ignore(i32 value) { return 7; }
macro i32 first(i32... values) { return values[0]; }
macro i32 count(i32... values) { return values.len; }
macro void accumulate(i32* total, i32... values) {
    for value in values { *total += value; }
}

i32 main() {
    assert_eq_i32(3, @twice(tick()), "macro arguments substitute at each use");
    assert_eq_i32(2, evaluations, "repeated macro argument runs twice");
    assert_eq_i32(7, @ignore(tick()), "unused macro argument is not evaluated");
    assert_eq_i32(2, evaluations, "unused argument has no side effects");
    assert_eq_i32(2, @count(tick(), tick()), "variadic count is compile time");
    assert_eq_i32(2, evaluations, "variadic count does not evaluate expressions");
    assert_eq_i32(3, @first(tick(), tick()), "index substitutes only selected argument");
    assert_eq_i32(3, evaluations, "unselected argument is not evaluated");
    i32 total = 0;
    @accumulate(&total, tick(), tick());
    assert_eq_i32(9, total, "variadic loop evaluates each argument");
    @accumulate(&total);
    assert_eq_i32(9, total, "empty variadic loop has no iterations");
    return done();
}
