// Test suite for std.string - String type
import std.test;
import std.string;
import std.mem.vec;
import std.hash;

/// Free the String elements of a Vec before dropping the Vec itself (Vec
/// owns the backing buffer only, never its elements).
void drop_vec_strings(Vec<String>* v) {
    i64 i = 0;
    while (i < v.len()) {
        String* p = v.get_ptr(i);
        String elem = *p;
        elem.drop();
        i = i + 1;
    }
    v.drop();
}

i32 main(){
    // -- Existing tests ---------------------------------------------------
    String s = String.new();
    assert_eq_i64(s.len, 0, "New string has length 0");
    assert_eq_i64(s.capacity, 16, "New string has initial capacity 16");
    assert_true(s.data != (u8*)0, "New string has non-null data pointer");
    s.drop();

    String s1 = String.with_capacity(32);
    assert_eq_i64(s1.len, 0, "String with_capacity has length 0");
    assert_eq_i64(s1.capacity, 32, "String with_capacity has specified capacity 32");
    assert_true(s1.data != (u8*)0, "String with_capacity has non-null data pointer");
    s1.drop();

    // Test push
    String s2 = String.new();
    s2.push((u8)97); // 'a'
    s2.push((u8)98); // 'b'
    assert_eq_i64(s2.len(), 2, "Length is 2 after two pushes via len() method");
    assert_eq_i32((i32)s2.data[0], 97, "First char is 'a'");
    assert_eq_i32((i32)s2.data[1], 98, "Second char is 'b'");
    assert_eq_i32((i32)s2.data[2], 0, "Null terminator is correct");

    // Test push_str
    s2.push_str("cde");
    assert_eq_i64(s2.len(), 5, "Length is 5 after push_str");
    assert_eq_i32((i32)s2.data[2], 99, "Third char is 'c'");
    assert_eq_i32((i32)s2.data[3], 100, "Fourth char is 'd'");
    assert_eq_i32((i32)s2.data[4], 101, "Fifth char is 'e'");
    assert_eq_i32((i32)s2.data[5], 0, "Null terminator is correct after push_str");

    // Test clone and equals
    String s3 = s2.clone();
    assert_eq_i64(s3.len(), s2.len(), "Cloned string has same length");
    assert_true(s2.equals("abcde"), "String equals literal");
    
    // Modify original and check equality
    s2.push((u8)102); // 'f'
    assert_false(s2.equals("abcde"), "Modified string no longer equals old literal");
    assert_true(s2.equals("abcdef"), "Modified string equals updated literal");
    
    // Test to_str
    STDOUT.write_str("to_str: \"");
    STDOUT.write_str((str)s3.to_str());
    STDOUT.write_str("\"\n");
    check(true, "to_str runs without crashing");

    // Test clear
    s3.clear();
    assert_eq_i64(s3.len(), 0, "Length is 0 after clear");
    
    s2.drop();
    s3.drop();

    test_start("from_str");
    {
        String fs1 = String.from_str("hello");
        assert_eq_i64(fs1.len(), 5, "from_str('hello') has len 5");
        assert_eq_str("hello", (str)fs1.to_str(), "from_str('hello') content");
        fs1.drop();

        String fs2 = String.from_str("");
        assert_eq_i64(fs2.len(), 0, "from_str('') has len 0");
        assert_eq_str("", (str)fs2.to_str(), "from_str('') content");
        fs2.drop();
    }

    test_start("trim");
    {
        String t1 = String.from_str("  hello  ");
        String tr1 = t1.trim();
        assert_eq_str("hello", (str)tr1.to_str(), "trim('  hello  ')");
        tr1.drop();
        t1.drop();

        String t2 = String.from_str("no_ws");
        String tr2 = t2.trim();
        assert_eq_str("no_ws", (str)tr2.to_str(), "trim('no_ws')");
        tr2.drop();
        t2.drop();

        String t3 = String.from_str("   ");
        String tr3 = t3.trim();
        assert_eq_str("", (str)tr3.to_str(), "trim('   ') empty");
        tr3.drop();
        t3.drop();

        String t4 = String.from_str("\t\n a \r");
        String tr4 = t4.trim();
        assert_eq_str("a", (str)tr4.to_str(), "trim('\\t\\n a \\r')");
        tr4.drop();
        t4.drop();
    }

    test_start("starts_with");
    {
        String sw = String.from_str("hello world");
        assert_true(sw.starts_with("hello"), "starts_with 'hello'");
        assert_true(sw.starts_with("h"), "starts_with 'h'");
        assert_false(sw.starts_with("world"), "starts_with 'world'");
        assert_true(sw.starts_with(""), "starts_with empty prefix");
        assert_false(sw.starts_with((str)0), "starts_with null prefix");
        sw.drop();
    }

    test_start("ends_with");
    {
        String ew = String.from_str("hello world");
        assert_true(ew.ends_with("world"), "ends_with 'world'");
        assert_true(ew.ends_with("d"), "ends_with 'd'");
        assert_false(ew.ends_with("hello"), "ends_with 'hello'");
        assert_true(ew.ends_with(""), "ends_with empty suffix");
        assert_false(ew.ends_with((str)0), "ends_with null suffix");
        ew.drop();
    }

    test_start("contains");
    {
        String cs = String.from_str("hello world");
        assert_true(cs.contains("hello"), "contains 'hello'");
        assert_true(cs.contains("world"), "contains 'world'");
        assert_true(cs.contains("lo wo"), "contains 'lo wo'");
        assert_false(cs.contains("xyz"), "contains 'xyz'");
        assert_true(cs.contains(""), "contains empty");
        assert_false(cs.contains((str)0), "contains null");
        cs.drop();
    }

    test_start("find");
    {
        String fs = String.from_str("hello world");
        assert_eq_i64(fs.find("hello"), 0, "find 'hello' at 0");
        assert_eq_i64(fs.find("world"), 6, "find 'world' at 6");
        assert_eq_i64(fs.find("o"), 4, "find first 'o' at 4");
        assert_eq_i64(fs.find("xyz"), -1, "find 'xyz' returns -1");
        assert_eq_i64(fs.find(""), 0, "find empty returns 0");
        assert_eq_i64(fs.find((str)0), -1, "find null returns -1");
        fs.drop();
    }

    test_start("substr");
    {
        String ss = String.from_str("hello world");
        String sub1 = ss.substr(0, 5);
        assert_eq_str("hello", (str)sub1.to_str(), "substr(0,5)");
        sub1.drop();

        String sub2 = ss.substr(6, 5);
        assert_eq_str("world", (str)sub2.to_str(), "substr(6,5)");
        sub2.drop();

        String sub3 = ss.substr(6, 100);
        assert_eq_str("world", (str)sub3.to_str(), "substr(6,100) truncated");
        sub3.drop();

        String sub4 = ss.substr(-5, 10);
        assert_eq_str("hello worl", (str)sub4.to_str(), "substr(-5,10) clamped start");
        sub4.drop();

        String sub5 = ss.substr(100, 5);
        assert_eq_str("", (str)sub5.to_str(), "substr(100,5) start beyond len");
        sub5.drop();

        String sub6 = ss.substr(0, 0);
        assert_eq_str("", (str)sub6.to_str(), "substr(0,0) empty");
        sub6.drop();

        String sub7 = ss.substr(3, -1);
        assert_eq_str("", (str)sub7.to_str(), "substr(3,-1) negative len");
        sub7.drop();

        ss.drop();
    }

    test_start("split");
    {
        String sp = String.from_str("a,b,c");
        SplitIter sit = sp.split(",");
        Optional<str> part0 = sit.next();
        assert_true(part0.is_some(), "split[0] is_some");
        assert_eq_str("a", part0.unwrap(), "split[0] = 'a'");

        Optional<str> part1 = sit.next();
        assert_true(part1.is_some(), "split[1] is_some");
        assert_eq_str("b", part1.unwrap(), "split[1] = 'b'");

        Optional<str> part2 = sit.next();
        assert_true(part2.is_some(), "split[2] is_some");
        assert_eq_str("c", part2.unwrap(), "split[2] = 'c'");

        Optional<str> part3 = sit.next();
        assert_true(part3.is_none(), "split[3] is_none");
        sp.drop();
    }

    test_start("split consecutive delimiters");
    {
        String sp2 = String.from_str("a,,b");
        SplitIter sit2 = sp2.split(",");
        Optional<str> p0 = sit2.next();
        assert_eq_str("a", p0.unwrap(), "consecutive[0] = 'a'");
        Optional<str> p1 = sit2.next();
        assert_eq_str("", p1.unwrap(), "consecutive[1] = ''");
        Optional<str> p2 = sit2.next();
        assert_eq_str("b", p2.unwrap(), "consecutive[2] = 'b'");
        assert_true(sit2.next().is_none(), "consecutive[3] is_none");
        sp2.drop();
    }

    test_start("split trailing delimiter");
    {
        String sp3 = String.from_str("x,");
        SplitIter sit3 = sp3.split(",");
        Optional<str> q0 = sit3.next();
        assert_eq_str("x", q0.unwrap(), "trailing[0] = 'x'");
        Optional<str> q1 = sit3.next();
        assert_eq_str("", q1.unwrap(), "trailing[1] = ''");
        assert_true(sit3.next().is_none(), "trailing[2] is_none");
        sp3.drop();
    }

    test_start("split empty string");
    {
        String sp4 = String.from_str("");
        SplitIter sit4 = sp4.split(",");
        Optional<str> r0 = sit4.next();
        assert_true(r0.is_some(), "empty split yields one");
        assert_eq_str("", r0.unwrap(), "empty split yields ''");
        assert_true(sit4.next().is_none(), "empty split second is_none");
        sp4.drop();
    }

    test_start("split null delimiter");
    {
        String sp5 = String.from_str("hello");
        SplitIter sit5 = sp5.split((str)0);
        Optional<str> s0 = sit5.next();
        assert_true(s0.is_some(), "null delim yields one");
        assert_eq_str("hello", s0.unwrap(), "null delim yields whole string");
        assert_true(sit5.next().is_none(), "null delim second is_none");
        sp5.drop();
    }

    test_start("join");
    {
        Vec<String> v = Vec<String>.new();
        v.push(String.from_str("a"));
        v.push(String.from_str("b"));
        v.push(String.from_str("c"));
        String j = String.join(",", &v);
        assert_eq_str("a,b,c", (str)j.to_str(), "join 'a,b,c'");
        j.drop();
        drop_vec_strings(&v);
    }

    test_start("join single element");
    {
        Vec<String> v2 = Vec<String>.new();
        v2.push(String.from_str("only"));
        String j2 = String.join(",", &v2);
        assert_eq_str("only", (str)j2.to_str(), "join single element");
        j2.drop();
        drop_vec_strings(&v2);
    }

    test_start("join empty vec");
    {
        Vec<String> v3 = Vec<String>.new();
        String j3 = String.join(",", &v3);
        assert_eq_str("", (str)j3.to_str(), "join empty vec");
        j3.drop();
        drop_vec_strings(&v3);
    }

    test_start("replace");
    {
        String s = String.from_str("hello world hello");
        String r = s.replace("hello", "hi");
        assert_eq_str("hi world hi", (str)r.to_str(), "replace 'hello' -> 'hi'");
        r.drop();
        s.drop();
    }
    {
        String s = String.from_str("a,b,c");
        String r = s.replace(",", " :: ");
        assert_eq_str("a :: b :: c", (str)r.to_str(), "replace ',' -> ' :: '");
        r.drop();
        s.drop();
    }
    {
        String s = String.from_str("no match here");
        String r = s.replace("xyz", "abc");
        assert_eq_str("no match here", (str)r.to_str(), "replace no match -> clone");
        r.drop();
        s.drop();
    }
    {
        String s = String.from_str("remove-the-dashes");
        String r = s.replace("-", "");
        assert_eq_str("removethedashes", (str)r.to_str(), "replace '-' -> '' (delete)");
        r.drop();
        s.drop();
    }
    {
        String s = String.from_str("unchanged");
        String r = s.replace((str)0, "x");
        assert_eq_str("unchanged", (str)r.to_str(), "replace null needle -> clone");
        r.drop();
        s.drop();
    }
    {
        String s = String.from_str("cut--this");
        String r = s.replace("--", (str)0);
        assert_eq_str("cutthis", (str)r.to_str(), "replace '--' -> null (delete)");
        r.drop();
        s.drop();
    }
    {
        String s = String.from_str("aaa");
        String r = s.replace("aa", "X");
        assert_eq_str("Xa", (str)r.to_str(), "replace 'aa' -> 'X' in 'aaa'");
        r.drop();
        s.drop();
    }
    // String + String and String + str now work: the __add overloads free
    // their by-value operands at callee exit (no null-out leak) and the
    // result owns a fresh buffer.
    test_start("concat String + String");
    {
        String a = String.from_str("hello ");
        String b = String.from_str("world");
        String c = a + b;
        assert_eq_str("hello world", (str)c.to_str(), "String + String concatenates");
        c.drop();
    }

    test_start("concat String + str");
    {
        String a = String.from_str("foo");
        String c = a + "bar";
        assert_eq_str("foobar", (str)c.to_str(), "String + str concatenates");
        c.drop();
    }

    // String -> str cast: borrowed NUL-terminated view; the String keeps
    // ownership of the buffer (the by-value cast copy nulls its pointer).
    test_start("String cast to str");
    {
        String sc = String.from_str("hello");
        str v = (str)sc;
        u8* p = (u8*)v;
        assert_true(
            p[0] == (u8)'h' && p[4] == (u8)'o' && p[5] == (u8)0,
            "cast str view is NUL-terminated"
        );
        sc.push((u8)'!');
        str v2 = (str)sc;
        assert_eq_str("hello!", v2, "String still owns its buffer after cast");
        sc.drop();
    }
    test_start("String == and != operators");
    {
        String s_a = String.from_str("hello");
        String s_b = String.from_str("hello");
        String s_c = String.from_str("world");
        assert_true(s_a == s_b, "distinct String allocations with same text are ==");
        assert_false(s_a == s_c, "different Strings are not ==");
        assert_true(s_a != s_c, "different Strings are !=");
        assert_false(s_a != s_b, "identical Strings are not !=");
        assert_true(s_a == "hello", "String == str literal");
        assert_false(s_a == "world", "String == different str literal is false");
        assert_true(s_a != "world", "String != different str literal is true");
        assert_true(s_a < s_c, "String < comparison ('hello' < 'world')");
        assert_false(s_c < s_a, "String < comparison ('world' < 'hello' is false)");
        assert_true(s_c > s_a, "String > comparison ('world' > 'hello')");
        assert_true(s_a <= s_b, "String <= comparison (same)");
        assert_true(s_a >= s_b, "String >= comparison (same)");
        s_a.drop();
        s_b.drop();
        s_c.drop();
    }

    test_start("String @hash content equality");
    {
        String h1 = String.from_str("advent_of_code");
        String h2 = String.from_str("advent_of_code");
        assert_eq_i64(@hash(h1), @hash(h2), "@hash of two String instances with same content match");
        assert_eq_i64(@hash(h1), @hash("advent_of_code"), "@hash(String) matches @hash(str)");
        h1.drop();
        h2.drop();
    }
    test_start("SplitIter drop restores mutated byte on early break");
    {
        String s_split = String.from_str("apple,banana,cherry,date");
        SplitIter it = s_split.split(",");
        Optional<str> first = it.next();
        assert_true(first.is_some(), "first token present");
        assert_eq_str("apple", first.unwrap(), "first token is 'apple'");
        // Drop iterator before consuming the rest
        it.drop();
        // Original string must be completely intact (no NUL byte replacing ',')
        assert_eq_str("apple,banana,cherry,date", (str)s_split.to_str(), "String intact after early iterator drop");
        s_split.drop();
    }
    test_start("parse_i64 and parse_i64_radix");
    {
        assert_eq_i64(12345, parse_i64("12345").unwrap(), "parse positive decimal");
        assert_eq_i64(-6789, parse_i64("-6789").unwrap(), "parse negative decimal");
        assert_eq_i64(42, parse_i64("  +42  ").unwrap(), "parse with whitespace and +");
        assert_eq_i64(255, parse_i64_radix("0xFF", 16).unwrap(), "parse hex 0xFF");
        assert_eq_i64(10, parse_i64_radix("0b1010", 2).unwrap(), "parse binary 0b1010");
        assert_true(parse_i64("invalid").is_none(), "parse non-number returns none");

        String s_num = String.from_str(" -999 ");
        assert_eq_i64(-999, s_num.parse_i64().unwrap(), "String.parse_i64");
        s_num.drop();
    }

    test_start("extract_ints");
    {
        String line = String.from_str("Sensor at x=2, y=-18: closest beacon is at x=-2, y=15");
        Vec<i64> ints = line.extract_ints();
        assert_eq_i64(4, ints.len(), "extracted 4 integers");
        assert_eq_i64(2, ints[0], "first int is 2");
        assert_eq_i64(-18, ints[1], "second int is -18");
        assert_eq_i64(-2, ints[2], "third int is -2");
        assert_eq_i64(15, ints[3], "fourth int is 15");
        ints.drop();
        line.drop();
    }

    test_start("lines and words");
    {
        String multiline = String.from_str("first line\r\nsecond line\nthird line");
        Vec<String> lns = multiline.lines();
        assert_eq_i64(3, lns.len(), "3 lines extracted");
        String* l0 = lns.get_ptr(0);
        String* l1 = lns.get_ptr(1);
        String* l2 = lns.get_ptr(2);
        assert_true(l0.equals("first line"), "line 1 match");
        assert_true(l1.equals("second line"), "line 2 match");
        assert_true(l2.equals("third line"), "line 3 match");
        drop_vec_strings(&mut lns);
        multiline.drop();

        String sentence = String.from_str("  apple   banana \t cherry\n");
        Vec<String> wds = sentence.words();
        assert_eq_i64(3, wds.len(), "3 words extracted");
        String* w0 = wds.get_ptr(0);
        String* w1 = wds.get_ptr(1);
        String* w2 = wds.get_ptr(2);
        assert_true(w0.equals("apple"), "word 1");
        assert_true(w1.equals("banana"), "word 2");
        assert_true(w2.equals("cherry"), "word 3");
        drop_vec_strings(&mut wds);
        sentence.drop();
    }
    test_start("split_once, strip_prefix, strip_suffix, trim_start, trim_end");
    {
        String kv = String.from_str("key=value:123");
        Optional<[String, String]> pair_opt = kv.split_once("=");
        assert_true(pair_opt.is_some(), "split_once found =");
        let [k, v] = pair_opt.unwrap();
        assert_true(k == "key", "first is 'key'");
        assert_true(v == "value:123", "second is 'value:123'");
        k.drop();
        v.drop();
        kv.drop();

        String url = String.from_str("https://example.com/path");
        String path_str = url.strip_prefix("https://example.com");
        assert_true(path_str == "/path", "strip_prefix removed domain");
        path_str.drop();
        url.drop();

        String file_name = String.from_str("document.txt");
        String stem = file_name.strip_suffix(".txt");
        assert_true(stem == "document", "strip_suffix removed extension");
        stem.drop();
        file_name.drop();

        String padded = String.from_str("  \t padded string \n ");
        String t_start = padded.trim_start();
        assert_true(t_start == "padded string \n ", "trim_start");
        String t_end = padded.trim_end();
        assert_true(t_end == "  \t padded string", "trim_end");
        t_start.drop();
        t_end.drop();
        padded.drop();
    }
    test_start("read_to_string and read_lines");
    {
        str tmp_path = "/tmp/silver_string_read_test.txt";
        Result<i64, Error> r_w = try_open(tmp_path, O_WRONLY | O_CREAT | O_TRUNC, 438);
        if (r_w.is_ok()) {
            i32 fd = (i32)r_w.value();
            str content = "alpha\nbeta\ngamma\n";
            try_write(fd, (u8*)content, strlen(content));
            try_close(fd);

            Result<String, Error> res_s = read_to_string(tmp_path);
            assert_true(res_s.success(), "read_to_string ok");
            String content_str = res_s.unwrap();
            assert_true(content_str == "alpha\nbeta\ngamma\n", "read_to_string matches");
            content_str.drop();

            Result<Vec<String>, Error> res_l = read_lines(tmp_path);
            assert_true(res_l.success(), "read_lines ok");
            Vec<String> lns = res_l.unwrap();
            assert_eq_i64(3, lns.len(), "3 lines from file");
            String* line0 = lns.get_ptr(0);
            String* line1 = lns.get_ptr(1);
            String* line2 = lns.get_ptr(2);
            assert_true(line0.equals("alpha"), "line 0 is alpha");
            assert_true(line1.equals("beta"), "line 1 is beta");
            assert_true(line2.equals("gamma"), "line 2 is gamma");
            drop_vec_strings(&mut lns);
        }
    }

    return done();
}
