// Test suite for generic container element drop glue (§4.2)
// Verifies that Vec<T>, Deque<T>, HashMap<K, V>, HashSet<K>, and BinaryHeap<T>
// run per-element destructors on drop.
import std.test;
import std.mem.vec;
import std.collections.deque;
import std.collections.heap;
import std.map;
import std.collections.set;
import std.mem.box;
import std.mem.rc;

i64 g_drops = 0;

struct DropSpy {
    i64 val;
}

struct VecSlot { Vec<DropSpy> values; }

void replace_borrowed_values(&mut VecSlot slot, Vec<DropSpy> replacement) {
    slot.values = move replacement;
}

i64 g_parent_drops = 0;
struct PartialDropParent { DropSpy item; i64 required; }
struct NestedDropSlot { VecSlot inner; DropSpy sibling; }
struct BorrowedDropSlot { DropSpy item; }

void transfer_borrowed_item(&mut BorrowedDropSlot target, &mut BorrowedDropSlot source) {
    target.item = move source.item;
}

void initialize_borrowed_item(&mut PartialDropParent parent) {
    parent.item = new_drop_spy(22);
}

void initialize_borrowed_scalar(&mut PartialDropParent parent) {
    parent.required = 1;
}

impl Drop for PartialDropParent {
    void drop(*self) {
        // The counter never reads storage that a partial value may lack.
        g_parent_drops = g_parent_drops + 1;
    }
}

DropSpy new_drop_spy(i64 value) {
    DropSpy spy;
    spy.val = value;
    return move spy;
}

void early_partial_cleanup() {
    PartialDropParent parent;
    parent.item = new_drop_spy(8);
    return;
}

void early_nested_cleanup() {
    NestedDropSlot slot;
    slot.inner.values = Vec<DropSpy>.new();
    slot.inner.values.push(new_drop_spy(9));
    slot.sibling = new_drop_spy(10);
    Vec<DropSpy> taken = move slot.inner.values;
    slot.inner.values = Vec<DropSpy>.new();
    slot.inner.values.push(new_drop_spy(11));
    return;
}

impl Drop for DropSpy {
    void drop(*self) {
        g_drops = g_drops + 1;
    }
}

impl DropSpy {
    bool __lt(&self, &DropSpy other) {
        return self.val < other.val;
    }
    bool __eq(&self, &DropSpy other) {
        return self.val == other.val;
    }
}

enum WrappedVec { Payload(VecPayload); }
enum GenericWrappedVec { Payload(PayloadEnvelope<VecPayload>); }
enum PayloadEnvelope<T> { Value(T); }
enum VecPayload { Values(Vec<DropSpy>); }
enum BoundaryPayload<T> { Empty = 65534; Value(T); }
enum UnsignedPayload { Value(DropSpy) = 65535; }
enum SignedPayload { Low(DropSpy) = -32768; High(DropSpy) = 32767; }

DropSpy unwrap_boundary_payload(BoundaryPayload<DropSpy> payload) {
    return match payload {
        Empty: { DropSpy empty; empty.val = -1; empty; },
        Value(move spy): spy,
    };
}

Vec<DropSpy> unwrap_vec(WrappedVec wrapped) {
    return match wrapped {
        Payload(move payload): match payload {
            Values(move values): { values; },
        },
    };
}

[Vec<DropSpy>, i32] unwrap_vec_pair(GenericWrappedVec wrapped) {
    return match wrapped {
        Payload(move envelope): match envelope {
            Value(move payload): match payload {
                Values(move values): [values, 7],
            },
        },
    };
}

void consume_values(Vec<DropSpy> values) {
    assert_eq_i64(1, values.len(), "consuming call receives the Vec");
}

bool same_reference(&i32 left, &i32 right) {
    return left == right;
}

i32 main() {
    STDOUT.write_str("=== Collection Drop Glue Tests ===\n\n");

    test_start("reference equality compares referent addresses");
    {
        i32 left = 1;
        i32 right = 1;
        &i32 left_ref = &left;
        &i32 same_ref = &left;
        &i32 other_ref = &right;
        assert_true(left_ref == same_ref, "references to the same place compare equal");
        assert_true(left_ref != other_ref, "references to different places compare unequal");
        assert_true(same_reference(left_ref, same_ref), "reference equality works in functions");
        assert_true((match true { true: left_ref, false: other_ref, }) == same_ref,
            "reference equality accepts a match expression on the left");
        assert_true(same_ref == (match true { true: left_ref, false: other_ref, }),
            "reference equality accepts a match expression on the right");
    }

    test_start("borrowed replacement updates the original owner's cleanup state");
    g_drops = 0;
    {
        VecSlot slot;
        slot.values = Vec<DropSpy>.new();
        slot.values.push(new_drop_spy(20));
        Vec<DropSpy> replacement = Vec<DropSpy>.new();
        replacement.push(new_drop_spy(21));
        replace_borrowed_values(&mut slot, move replacement);
        assert_eq_i64(1, g_drops, "borrowed overwrite drops the old element immediately");
    }
    assert_eq_i64(2, g_drops, "caller cleanup drops the replacement once");

    test_start("borrowed moves clear the source owner's field state");
    g_drops = 0;
    {
        BorrowedDropSlot target;
        target.item = new_drop_spy(23);
        BorrowedDropSlot source;
        source.item = new_drop_spy(24);
        transfer_borrowed_item(&mut target, &mut source);
        assert_eq_i64(1, g_drops, "old target drops after ownership transfer");
    }
    assert_eq_i64(2, g_drops, "moved source does not drop twice");

    test_start("borrowed initialization preserves partial custom Drop parents");
    g_drops = 0;
    g_parent_drops = 0;
    {
        PartialDropParent parent;
        initialize_borrowed_item(&mut parent);
        assert_eq_i64(0, g_drops, "empty borrowed field skips predrop");
    }
    assert_eq_i64(1, g_drops, "caller cleans the initialized borrowed child");
    assert_eq_i64(0, g_parent_drops, "missing scalar keeps parent partial");
    {
        PartialDropParent parent;
        initialize_borrowed_item(&mut parent);
        initialize_borrowed_scalar(&mut parent);
    }
    assert_eq_i64(2, g_drops, "both borrowed child values drop once");
    assert_eq_i64(1, g_parent_drops, "borrowed scalar initialization enables parent Drop");

    test_start("direct overwrite drops the initialized old value before replacement");
    g_drops = 0;
    {
        DropSpy value = new_drop_spy(1);
        value = new_drop_spy(2);
        assert_eq_i64(1, g_drops, "overwrite drops the old value once");
    }
    assert_eq_i64(2, g_drops, "replacement drops once at scope exit");

    test_start("empty owned field initialization skips predrop");
    g_drops = 0;
    {
        PartialDropParent parent;
        parent.item = new_drop_spy(3);
        assert_eq_i64(0, g_drops, "unset field has no old value");
    }
    assert_eq_i64(1, g_drops, "partial parent cascades its initialized field");

    test_start("unset scalar sibling keeps custom Drop parent partial");
    g_drops = 0;
    g_parent_drops = 0;
    {
        PartialDropParent parent;
        parent.item = new_drop_spy(4);
    }
    assert_eq_i64(0, g_parent_drops, "one owned field does not initialize the parent");
    assert_eq_i64(1, g_drops, "partial parent cleans the owned field");
    {
        PartialDropParent parent;
        parent.item = new_drop_spy(5);
        parent.required = 6;
    }
    assert_eq_i64(1, g_parent_drops, "all required fields enable the parent destructor");
    assert_eq_i64(2, g_drops, "complete parent cascades the owned field once");

    test_start("nested field move and reinitialization preserve every owner");
    g_drops = 0;
    {
        NestedDropSlot slot;
        slot.inner.values = Vec<DropSpy>.new();
        slot.inner.values.push(new_drop_spy(6));
        slot.sibling = new_drop_spy(7);
        Vec<DropSpy> taken = move slot.inner.values;
        slot.inner.values = Vec<DropSpy>.new();
        slot.inner.values.push(new_drop_spy(8));
        assert_eq_i64(0, g_drops, "move transfers the original buffer without dropping it");
    }
    assert_eq_i64(3, g_drops, "moved value, reinitialized field, and sibling each drop once");

    test_start("early returns clean partial and reinitialized local owners");
    g_drops = 0;
    g_parent_drops = 0;
    early_partial_cleanup();
    assert_eq_i64(0, g_parent_drops, "early return skips partial parent destructor");
    assert_eq_i64(1, g_drops, "early return cleans initialized child");
    early_nested_cleanup();
    assert_eq_i64(4, g_drops, "early return cleans moved and reinitialized nested values");

    test_start("declarations reset owner state on each loop iteration and branch");
    g_drops = 0;
    g_parent_drops = 0;
    for (i64 iteration = 0; iteration < 4; iteration = iteration + 1) {
        PartialDropParent parent;
        parent.item = new_drop_spy(iteration);
        if (iteration == 0) { parent.required = 1; }
    }
    assert_eq_i64(4, g_drops, "each iteration cleans its initialized child");
    assert_eq_i64(1, g_parent_drops, "later iterations do not inherit the initialized scalar");

    test_start("fixed array elements keep independent initialization state");
    g_drops = 0;
    g_parent_drops = 0;
    {
        PartialDropParent parents[2];
        parents[0].item = new_drop_spy(12);
        parents[1].item = new_drop_spy(13);
        parents[1].required = 14;
    }
    assert_eq_i64(2, g_drops, "both initialized array children drop once");
    assert_eq_i64(1, g_parent_drops, "only the complete element runs its parent destructor");

    test_start("struct comparisons use overloaded methods");
    {
        DropSpy low;
        low.val = 1;
        DropSpy high;
        high.val = 2;
        DropSpy same;
        same.val = 1;
        assert_true(low < high, "less-than calls __lt");
        assert_true(low == same, "equality calls __eq");
    }

    // 1. Vec<DropSpy>
    test_start("Vec drops contained elements");
    {
        g_drops = 0;
        {
            Vec<DropSpy> v = Vec<DropSpy>.new();
            i64 i = 0;
            while (i < 5) {
                DropSpy d;
                d.val = i;
                v.push(move d);
                i = i + 1;
            }
        }
        assert_eq_i64(5, g_drops, "Vec dropped 5 elements");
    }

    test_start("context-inferred lambda parameters borrow and consume owned values");
    g_drops = 0;
    {
        DropSpy left;
        left.val = 3;
        DropSpy right;
        right.val = 6;
        void(&mut DropSpy) bump = (&mut value) => { value.val += 1; };
        i64(&DropSpy) read = (&value) => value.val;
        i64(DropSpy, DropSpy) sum = (move a, move b) => a.val + b.val;
        bump(&mut left);
        assert_eq_i64(4, read(&left), "borrowed parameter preserves outside ownership");
        assert_eq_i64(10, sum(move left, move right), "context infers both moved parameters");
        assert_eq_i64(2, g_drops, "moved parameters drop exactly once on return");
    }
    assert_eq_i64(2, g_drops, "caller does not drop consumed parameters again");

    test_start("Vec captured by an uncalled lambda drops its elements");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        let _take = () => move values;
    }
    assert_eq_i64(1, g_drops, "uncalled capture drops the owned Vec once");

    test_start("Vec transferred through a lambda keeps its elements alive");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        let take = () => move values;
        Vec<DropSpy> received = take();
        assert_eq_i64(1, received.len(), "transferred Vec retains its element");
        assert_eq_i64(0, g_drops, "capture transfer preserves the element");
    }
    assert_eq_i64(1, g_drops, "transferred Vec drops its element once");

    test_start("Vec survives nested shared captures");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        let outer = () => {
            let inner = () => values.len();
            return inner();
        };
        assert_eq_i64(1, outer(), "nested capture sees the Vec");
        assert_eq_i64(1, values.len(), "shared capture preserves outside access");
        assert_eq_i64(0, g_drops, "shared captures do not destroy elements");
    }
    assert_eq_i64(1, g_drops, "nested shared captures leave one Vec owner");

    test_start("Vec match block transfers owned elements through forward enum payloads");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        VecPayload payload = VecPayload.Values(move values);
        WrappedVec wrapped = WrappedVec.Payload(move payload);
        Vec<DropSpy> received = unwrap_vec(move wrapped);
        DropSpy* element = received.get_ptr(0);
        assert_eq_i64(1, received.len(), "match result retains the Vec element");
        assert_eq_i64(42, element.val, "forward enum layout preserves the element");
        assert_eq_i64(0, g_drops, "match cleanup preserves the yielded Vec");
    }
    assert_eq_i64(1, g_drops, "yielded Vec drops its element once");

    test_start("lambda tuple transfers its owned Vec capture");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        let take = () => [values, 7];
        let [received, tag] = take();
        assert_eq_i64(1, received.len(), "lambda tuple retains its element");
        assert_eq_i32(7, tag, "lambda tuple retains its tag");
        assert_eq_i64(0, g_drops, "tuple capture transfer preserves the element");
    }
    assert_eq_i64(1, g_drops, "lambda tuple drops its Vec once");

    test_start("lambda tuple copies a field from a Drop owner");
    g_drops = 0;
    {
        DropSpy owner;
        owner.val = 7;
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy element;
        element.val = 42;
        values.push(move element);
        let take = () => [owner.val, values];
        let [tag, received] = take();
        assert_eq_i64(7, tag, "tuple copies the field value");
        assert_eq_i64(7, owner.val, "copying the field leaves its Drop owner usable");
        assert_eq_i64(1, received.len(), "tuple transfers the owned Vec");
        assert_eq_i64(0, g_drops, "copied field and Vec transfer preserve both owners");
    }
    assert_eq_i64(2, g_drops, "field owner and Vec element each drop once");

    test_start("lambda match transfers the selected Vec capture");
    g_drops = 0;
    {
        Vec<DropSpy> left = Vec<DropSpy>.new();
        Vec<DropSpy> right = Vec<DropSpy>.new();
        DropSpy first;
        first.val = 17;
        left.push(move first);
        DropSpy second;
        second.val = 25;
        right.push(move second);
        bool choose_left = true;
        let take = () => match choose_left { true: left, false: right, };
        Vec<DropSpy> received = take();
        DropSpy* element = received.get_ptr(0);
        assert_eq_i64(17, element.val, "match preserves the selected capture");
        assert_eq_i64(1, g_drops, "unselected capture drops when the lambda is consumed");
    }
    assert_eq_i64(2, g_drops, "selected capture drops once at scope exit");

    test_start("shadowed lambda locals preserve the outer Vec");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        i32 number = 42;
        DropSpy element = { .val = number };
        values.push(move element);
        let build = (bool filled) => match filled {
            true: {
                Vec<DropSpy> values = Vec<DropSpy>.new();
                DropSpy element;
                element.val = 7;
                values.push(move element);
                values;
            },
            false: { Vec<DropSpy> values = Vec<DropSpy>.new(); values; },
        };
        Vec<DropSpy> first = build(true);
        Vec<DropSpy> second = build(false);
        DropSpy* original = values.get_ptr(0);
        assert_eq_i64(42, original.val, "initializer conversion and outer element are preserved");
        assert_eq_i64(1, first.len(), "first call returns its local Vec");
        assert_eq_i64(0, second.len(), "second call creates a fresh local Vec");
        assert_eq_i64(0, g_drops, "outer and returned elements remain live");
    }
    assert_eq_i64(2, g_drops, "outer and returned Vec elements each drop once");

    test_start("lambda struct initializer transfers its owned Vec capture");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        let take = () => {
            VecSlot slot = { .values = values };
            return move slot;
        };
        VecSlot received = take();
        assert_eq_i64(1, received.values.len(), "struct initializer retains the captured Vec");
        assert_eq_i64(0, g_drops, "struct capture transfer preserves the element");
    }
    assert_eq_i64(1, g_drops, "lambda struct drops its Vec once");

    test_start("match tuple transfers a Vec through a generic forward payload");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        VecPayload payload = VecPayload.Values(move values);
        PayloadEnvelope<VecPayload> envelope = PayloadEnvelope<VecPayload>.Value(move payload);
        GenericWrappedVec wrapped = GenericWrappedVec.Payload(move envelope);
        let [received, tag] = unwrap_vec_pair(move wrapped);
        DropSpy* element = received.get_ptr(0);
        assert_eq_i64(42, element.val, "generic forward payload preserves the element");
        assert_eq_i32(7, tag, "match tuple retains its tag");
        assert_eq_i64(0, g_drops, "match tuple preserves the yielded Vec");
    }
    assert_eq_i64(1, g_drops, "match tuple drops its Vec once");

    test_start("a consuming call followed by break has no ownership back edge");
    g_drops = 0;
    {
        Vec<DropSpy> values = Vec<DropSpy>.new();
        DropSpy value;
        value.val = 42;
        values.push(move value);
        while (true) {
            consume_values(move values);
            break;
        }
        assert_eq_i64(1, g_drops, "call drops its argument before break");
    }
    assert_eq_i64(1, g_drops, "loop exit does not drop the consumed Vec again");

    // 2. Deque<DropSpy>
    test_start("Deque drops contained elements across ring buffer");
    {
        g_drops = 0;
        {
            Deque<DropSpy> dq = Deque<DropSpy>.new();
            i64 i = 0;
            while (i < 8) {
                DropSpy d;
                d.val = i;
                dq.push_back(move d);
                i = i + 1;
            }
            // Pop 2 from front to shift head, then push 4 more to wrap
            dq.pop_front();
            dq.pop_front();
            while (i < 12) {
                DropSpy d;
                d.val = i;
                dq.push_back(move d);
                i = i + 1;
            }
        }
        // 10 elements remaining in dq are dropped at scope exit
        assert_eq_i64(10, g_drops, "Deque dropped all 10 elements including wrapped slots");
    }

    // 3. HashMap<i64, DropSpy>
    test_start("HashMap drops values and keys");
    {
        g_drops = 0;
        {
            HashMap<i64, DropSpy> m = HashMap<i64, DropSpy>.new();
            i64 i = 0;
            while (i < 7) {
                DropSpy d;
                d.val = i;
                m.insert(i, move d);
                i = i + 1;
            }
        }
        assert_eq_i64(7, g_drops, "HashMap dropped 7 values");
    }

    // 4. HashSet<DropSpy>
    test_start("HashSet drops keys");
    {
        g_drops = 0;
        {
            HashSet<DropSpy> s = HashSet<DropSpy>.new();
            i64 i = 0;
            while (i < 6) {
                DropSpy d;
                d.val = i;
                s.insert(move d);
                i = i + 1;
            }
        }
        assert_eq_i64(6, g_drops, "HashSet dropped 6 keys");
    }

    test_start("HashSet for-in drops yielded and remaining keys once");
    {
        g_drops = 0;
        HashSet<DropSpy> s = HashSet<DropSpy>.new();
        i64 i = 0;
        while (i < 3) {
            DropSpy d;
            d.val = i + 1;
            s.insert(move d);
            i = i + 1;
        }
        i64 sum = 0;
        for item in s {
            sum = sum + item.val;
        }
        assert_eq_i64(6, sum, "for-in yields all keys");
        assert_eq_i64(3, g_drops, "iterator and loop drop every key once");
    }

    test_start("HashSet for-in break drops remaining keys once");
    {
        g_drops = 0;
        HashSet<DropSpy> s = HashSet<DropSpy>.new();
        i64 i = 0;
        while (i < 3) {
            DropSpy d;
            d.val = i + 1;
            s.insert(move d);
            i = i + 1;
        }
        for _item in s {
            break;
        }
        assert_eq_i64(3, g_drops, "break drops current and remaining keys once");
    }

    // 5. BinaryHeap<DropSpy>
    test_start("BinaryHeap drops elements");
    {
        g_drops = 0;
        {
            BinaryHeap<DropSpy> h = BinaryHeap<DropSpy>.new();
            i64 i = 0;
            while (i < 4) {
                DropSpy d;
                d.val = i;
                h.push(move d);
                i = i + 1;
            }
        }
        assert_eq_i64(4, g_drops, "BinaryHeap dropped 4 elements");
    }

    // 6. Primitive collections do not invoke drop
    test_start("Primitive collections have zero drop overhead");
    {
        g_drops = 0;
        {
            Vec<i64> v = Vec<i64>.new();
            v.push(10);
            v.push(20);
            Deque<i32> dq = Deque<i32>.new();
            dq.push_back(1);
            HashMap<i64, i64> m = HashMap<i64, i64>.new();
            m.insert(1, 2);
        }
        assert_eq_i64(0, g_drops, "No drops for primitive collections");
    }

    // 7. Box<DropSpy> drops contained element
    test_start("Box drops contained element");
    {
        g_drops = 0;
        {
            DropSpy d;
            d.val = 42;
            Box<DropSpy> _b = Box<DropSpy>.new(move d);
        }
        assert_eq_i64(1, g_drops, "Box dropped contained element on exit");
    }

    // 8. Rc<DropSpy> drops contained element on last handle drop
    test_start("Rc drops contained element on last handle drop");
    {
        g_drops = 0;
        {
            DropSpy d;
            d.val = 99;
            Rc<DropSpy> r1 = Rc<DropSpy>.new(move d);
            {
                Rc<DropSpy> _r2 = r1.clone(&r1);
                assert_eq_i64(0, g_drops, "No drop while 2 handles exist");
            }
            assert_eq_i64(0, g_drops, "No drop while 1 handle exists");
        }
        assert_eq_i64(1, g_drops, "Rc dropped contained element when refcount hits 0");
    }

    // 9. Vec<DropSpy>.clear() drops elements and allows reuse
    test_start("Vec.clear() drops elements and allows reuse");
    {
        g_drops = 0;
        {
            Vec<DropSpy> v = Vec<DropSpy>.new();
            for (i64 i = 0; i < 3; i = i + 1) {
                DropSpy d;
                d.val = i;
                v.push(move d);
            }
            assert_eq_i64(0, g_drops, "No drops before clear");
            v.clear();
            assert_eq_i64(3, g_drops, "Vec.clear dropped 3 elements");
            assert_eq_i64(0, v.len(), "Vec is empty after clear");

            DropSpy d2;
            d2.val = 100;
            v.push(move d2);
        }
        assert_eq_i64(4, g_drops, "Vec dropped reused element on scope exit");
    }

    // 10. Deque<DropSpy>.clear() drops elements and allows reuse
    test_start("Deque.clear() drops elements and allows reuse");
    {
        g_drops = 0;
        {
            Deque<DropSpy> dq = Deque<DropSpy>.new();
            for (i64 i = 0; i < 4; i = i + 1) {
                DropSpy d;
                d.val = i;
                dq.push_back(move d);
            }
            assert_eq_i64(0, g_drops, "No drops before clear");
            dq.clear();
            assert_eq_i64(4, g_drops, "Deque.clear dropped 4 elements");
            assert_eq_i64(0, dq.len(), "Deque is empty after clear");

            DropSpy d2;
            d2.val = 200;
            dq.push_back(move d2);
        }
        assert_eq_i64(5, g_drops, "Deque dropped reused element on scope exit");
    }

    // 11. HashMap<i64, DropSpy>.clear() drops entries and allows reuse
    test_start("HashMap.clear() drops entries and allows reuse");
    {
        g_drops = 0;
        {
            HashMap<i64, DropSpy> m = HashMap<i64, DropSpy>.new();
            for (i64 i = 0; i < 5; i = i + 1) {
                DropSpy d;
                d.val = i;
                m.insert(i, move d);
            }
            assert_eq_i64(0, g_drops, "No drops before clear");
            m.clear();
            assert_eq_i64(5, g_drops, "HashMap.clear dropped 5 values");
            assert_eq_i64(0, m.len(), "HashMap is empty after clear");

            DropSpy d2;
            d2.val = 300;
            m.insert(99, move d2);
        }
        assert_eq_i64(6, g_drops, "HashMap dropped reused element on scope exit");
    }

    // 12. HashSet<DropSpy>.clear() drops entries and allows reuse
    test_start("HashSet.clear() drops entries and allows reuse");
    {
        g_drops = 0;
        {
            HashSet<DropSpy> s = HashSet<DropSpy>.new();
            for (i64 i = 0; i < 3; i = i + 1) {
                DropSpy d;
                d.val = i;
                s.insert(move d);
            }
            assert_eq_i64(0, g_drops, "No drops before clear");
            s.clear();
            assert_eq_i64(3, g_drops, "HashSet.clear dropped 3 keys");
            assert_eq_i64(0, s.len(), "HashSet is empty after clear");

            DropSpy d2;
            d2.val = 400;
            s.insert(move d2);
        }
        assert_eq_i64(4, g_drops, "HashSet dropped reused element on scope exit");
    }

    // 13. BinaryHeap<DropSpy>.clear() drops entries and allows reuse
    test_start("BinaryHeap.clear() drops entries and allows reuse");
    {
        g_drops = 0;
        {
            BinaryHeap<DropSpy> h = BinaryHeap<DropSpy>.new();
            for (i64 i = 0; i < 4; i = i + 1) {
                DropSpy d;
                d.val = i;
                h.push(move d);
            }
            assert_eq_i64(0, g_drops, "No drops before clear");
            h.clear();
            assert_eq_i64(4, g_drops, "BinaryHeap.clear dropped 4 elements");
            assert_eq_i64(0, h.len(), "BinaryHeap is empty after clear");

            DropSpy d2;
            d2.val = 500;
            h.push(move d2);
        }
        assert_eq_i64(5, g_drops, "BinaryHeap dropped reused element on scope exit");
    }

    test_start("boundary enum tags preserve payload dispatch and cleanup");
    g_drops = 0;
    {
        DropSpy spy;
        spy.val = 65535;
        BoundaryPayload<DropSpy> payload = BoundaryPayload<DropSpy>.Value(move spy);
        DropSpy received = unwrap_boundary_payload(move payload);
        assert_eq_i64(65535, received.val, "generic u16 boundary payload matches");
        if (received.val != 65535) { return 1; }
    }
    assert_eq_i64(1, g_drops, "moved boundary payload drops exactly once");
    if (g_drops != 1) { return 1; }
    {
        DropSpy spy;
        spy.val = 1;
        UnsignedPayload payload = UnsignedPayload.Value(move spy);
    }
    assert_eq_i64(2, g_drops, "unmatched u16 boundary payload drops");
    if (g_drops != 2) { return 1; }
    {
        DropSpy low;
        low.val = 2;
        SignedPayload low_payload = SignedPayload.Low(move low);
        DropSpy high;
        high.val = 3;
        SignedPayload high_payload = SignedPayload.High(move high);
    }
    assert_eq_i64(4, g_drops, "signed boundary payloads each drop once");
    if (g_drops != 4) { return 1; }

    return done();
}
