// Test suite for Deque<T> — ring-buffer double-ended queue.
import std.test;
import std.collections.deque;

i32 main() {
    STDOUT.write_str("=== Deque Tests ===\n\n");

    // --- new ---
    STDOUT.write_str("--- new ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        assert_eq_i64(0, d.len(), "new deque len 0");
        assert_true(d.is_empty(), "new deque is empty");
        d.drop();
    }

    // --- push_back / pop_front (FIFO) ---
    STDOUT.write_str("\n--- push_back / pop_front ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_back(10);
        d.push_back(20);
        d.push_back(30);
        assert_eq_i64(10, d.pop_front(), "pop_front 10");
        assert_eq_i64(20, d.pop_front(), "pop_front 20");
        assert_eq_i64(30, d.pop_front(), "pop_front 30");
        assert_true(d.is_empty(), "empty after pops");
        d.drop();
    }

    // --- push_front / pop_back (reverse FIFO) ---
    STDOUT.write_str("\n--- push_front / pop_back ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_front(10);
        d.push_front(20);
        d.push_front(30);
        assert_eq_i64(10, d.pop_back(), "pop_back 10");
        assert_eq_i64(20, d.pop_back(), "pop_back 20");
        assert_eq_i64(30, d.pop_back(), "pop_back 30");
        assert_true(d.is_empty(), "empty after reverse pops");
        d.drop();
    }

    // --- push_front / pop_front (LIFO on front) ---
    STDOUT.write_str("\n--- push_front / pop_front ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_front(1);
        d.push_front(2);
        d.push_front(3);
        assert_eq_i64(3, d.pop_front(), "pop_front 3");
        assert_eq_i64(2, d.pop_front(), "pop_front 2");
        assert_eq_i64(1, d.pop_front(), "pop_front 1");
        d.drop();
    }

    // --- push_back / pop_back (LIFO on back) ---
    STDOUT.write_str("\n--- push_back / pop_back ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_back(1);
        d.push_back(2);
        d.push_back(3);
        assert_eq_i64(3, d.pop_back(), "pop_back 3");
        assert_eq_i64(2, d.pop_back(), "pop_back 2");
        assert_eq_i64(1, d.pop_back(), "pop_back 1");
        d.drop();
    }

    // --- interleaved push at both ends ---
    STDOUT.write_str("\n--- interleaved push both ends ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_back(10);
        d.push_back(20);
        d.push_front(5);
        d.push_front(1);
        // order: front [1, 5, 10, 20] back
        assert_eq_i64(1, d.pop_front(), "pop_front 1");
        assert_eq_i64(20, d.pop_back(), "pop_back 20");
        assert_eq_i64(5, d.pop_front(), "pop_front 5");
        assert_eq_i64(10, d.pop_back(), "pop_back 10");
        assert_true(d.is_empty(), "empty after interleaved");
        d.drop();
    }

    // --- front / back peek ---
    STDOUT.write_str("\n--- front / back ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_back(100);
        d.push_back(200);
        d.push_front(50);
        assert_eq_i64(50, d.front(), "front is 50");
        assert_eq_i64(200, d.back(), "back is 200");
        assert_eq_i64(3, d.len(), "len unchanged after peeks");
        d.drop();
    }

    // --- resize ---
    STDOUT.write_str("\n--- resize ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        i64 i = 0;
        while (i < 50) {
            d.push_back(i);
            i = i + 1;
        }
        assert_eq_i64(50, d.len(), "len 50 after 50 push_back");
        i = 0;
        bool all_correct = true;
        while (i < 50) {
            i64 val = d.pop_front();
            if (val != i) {
                all_correct = false;
            }
            i = i + 1;
        }
        assert_true(all_correct, "resize preserves order");
        d.drop();
    }

    // --- clear ---
    STDOUT.write_str("\n--- clear ---\n");
    {
        Deque<i64> d = Deque<i64>.new();
        d.push_back(1);
        d.push_back(2);
        d.push_front(0);
        d.clear();
        assert_eq_i64(0, d.len(), "len 0 after clear");
        assert_true(d.is_empty(), "is_empty after clear");
        d.push_back(42);
        assert_eq_i64(42, d.pop_front(), "can use after clear");
        d.drop();
    }

    return done();
}
