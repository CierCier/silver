// tests/cfg_global_block_test.ag — top-level `if (@cfg(...))` composition.
//
// Global cfg blocks let each platform live in its own file:
//   if (@cfg(os.linux)) { import cfg_platform.linux; }
//   else { import cfg_platform.windows; }
// Dead branches (and their imports) are dropped before import lowering,
// so only the live platform's file is ever resolved. Portable: the else
// branch covers windows/macos, and assertions branch on @cfg the same way.

import std.sys.entry;
import std.test;

if (@cfg(os.linux)) {
    import cfg_platform.linux;
} else {
    import cfg_platform.windows;
}

if (@cfg(os.linux)) {
    i32 block_val() { return 1; }
} else {
    i32 block_val() { return 2; }
}

if (@cfg(os.linux)) {
    i32 chain_val() { return 1; }
} else if (@cfg(os.windows)) {
    i32 chain_val() { return 2; }
} else {
    i32 chain_val() { return 3; }
}

if (@cfg(os.linux) && @cfg(debug)) {
    i32 combo_val() { return 10; }
} else {
    i32 combo_val() { return 20; }
}

if (!@cfg(missing_key_xyz)) {
    i32 neg_val() { return 100; }
} else {
    i32 neg_val() { return 200; }
}

struct PlatStruct { i64 x; }
if (@cfg(os.linux)) {
    impl PlatStruct {
        i64 get(PlatStruct* self) { return 7; }
    }
} else {
    impl PlatStruct {
        i64 get(PlatStruct* self) { return 8; }
    }
}

i32 main() {
    test_start("global block fn");
    i64 e = 0;
    if (@cfg(os.linux)) { e = 1; } else { e = 2; }
    assert_eq_i64(e, block_val(), "if/else picks live branch");

    test_start("global block import");
    i64 p = 0;
    if (@cfg(os.linux)) { p = 11; } else { p = 22; }
    assert_eq_i64(p, cfg_platform_val(), "conditional import picks live file");

    test_start("global else-if");
    i64 c = 0;
    if (@cfg(os.linux)) { c = 1; } else if (@cfg(os.windows)) { c = 2; } else { c = 3; }
    assert_eq_i64(c, chain_val(), "else-if chain");

    test_start("global and-combo");
    i64 k = 0;
    if (@cfg(os.linux) && @cfg(debug)) { k = 10; } else { k = 20; }
    assert_eq_i64(k, combo_val(), "&& folds at top level");

    test_start("global not");
    assert_eq_i64(100, neg_val(), "!missing folds true");

    test_start("global impl block");
    PlatStruct s = { .x = 1 };
    i64 g = 0;
    if (@cfg(os.linux)) { g = 7; } else { g = 8; }
    assert_eq_i64(g, s.get(), "impl in block");

    return done();
}
