// compile_flags: --leak-check
import std.test;
import std.fs;
import std.io.file;
import std.io.byte_stream;
import std.string;
import std.optional;
import std.sys.io_vec;
import std.sys.result;

if (!@cfg(os.wasi)) {
/// writev/readv/sendfile on files: whole-vector transfers, file positions,
/// and sendfile's explicit-offset contract (the position stays put).
void check_vectored_file_io() {
    test_start("writev, readv, and sendfile on files");
    str src_path = "silver_iovec_src.bin";
    str dst_path = "silver_iovec_dst.bin";
    Result<i64, Error> src_r = try_open(src_path, O_RDWR | O_CREAT | O_TRUNC, 420);
    Result<i64, Error> dst_r = try_open(dst_path, O_RDWR | O_CREAT | O_TRUNC, 420);
    assert_true(src_r.is_ok() && dst_r.is_ok(), "opened scratch files");
    if (src_r.is_err() || dst_r.is_err()) { return; }
    i32 src = (i32)src_r.value();
    i32 dst = (i32)dst_r.value();

    IoVec out[2] = { IoVec.new((void*)"hello ", 6), IoVec.new((void*)"world", 5) };
    assert_eq_i64(11, try_writev(src, &out[0], 2).value(), "writev writes both buffers");
    assert_eq_i64(11, try_lseek(src, 0, SEEK_CUR).value(), "writev advances the position");

    try_lseek(src, 0, SEEK_SET);
    u8 head[6];
    u8 tail[8];
    IoVec parts[2] = { IoVec.new((void*)&head[0], 6), IoVec.new((void*)&tail[0], 8) };
    assert_eq_i64(11, try_readv(src, &parts[0], 2).value(), "readv returns the bytes available");
    tail[5] = (u8)0;
    assert_true(head[0] == (u8)'h' && head[5] == (u8)' ', "readv fills the first buffer");
    assert_eq_str("world", (str)&tail[0], "readv scatters the rest into the second");

    // Start away from where the read ends, so a missing restore shows.
    try_lseek(src, 2, SEEK_SET);
    i64 offset = 6;
    assert_eq_i64(5, try_sendfile(dst, src, &offset, 5).value(), "sendfile at an offset");
    assert_eq_i64(11, offset, "sendfile advances the offset");
    assert_eq_i64(2, try_lseek(src, 0, SEEK_CUR).value(), "explicit offset leaves the position");

    try_lseek(src, 0, SEEK_SET);
    assert_eq_i64(11, try_sendfile(dst, src, (i64*)0, 64).value(), "sendfile stops at EOF");
    assert_eq_i64(11, try_lseek(src, 0, SEEK_CUR).value(), "null offset advances the position");

    try_lseek(dst, 0, SEEK_SET);
    u8 copied[17];
    assert_eq_i64(16, try_read(dst, &copied[0], 16).value(), "destination holds both copies");
    copied[16] = (u8)0;
    assert_eq_str("worldhello world", (str)&copied[0], "sendfile copied the right bytes");

    try_close(src);
    try_close(dst);
    assert_true(remove_file(src_path) && remove_file(dst_path), "removed scratch files");
}
}

void check_float_writer_growth() {
    u8 scratch[64];
    BufWriter writer = {
        .data = (i64)&scratch[0], .len = 0, .cap = -64, .fd = -1,
        .list_next = (BufWriter*)0, .list_prev = (BufWriter*)0,
        .mode = IOMODE_MEMORY
    };
    u64 bits = (u64)6103021453049119613;
    writer.write_f64(*(f64*)&bits);
    assert_eq_i64(writer.len, 101, "large float grows the writer buffer");
    u8* data = (u8*)writer.data;
    bool large_ok = writer.len == 101 && data[0] == (u8)'1';
    for (i64 i = 1; i < writer.len; i += 1) {
        large_ok = large_ok && data[i] == (u8)'0';
    }
    assert_true(large_ok, "large float preserves every digit");

    writer.len = 0;
    bits = (u64)9223372036854775809;
    writer.write_f64(*(f64*)&bits);
    assert_eq_i64(writer.len, 327, "negative subnormal grows the writer buffer");
    data = (u8*)writer.data;
    bool small_ok = writer.len == 327 && data[0] == (u8)'-'
        && data[1] == (u8)'0' && data[2] == (u8)'.' && data[326] == (u8)'5';
    for (i64 i = 3; i < writer.len - 1; i += 1) {
        small_ok = small_ok && data[i] == (u8)'0';
    }
    assert_true(small_ok, "negative subnormal preserves every digit");
}

i32 main() {
    STDOUT.write_str("=== I/O Tests ===\n\n");

    // Test: write_str basic functionality
    STDOUT.write_str("--- write_str Tests ---\n");

    STDOUT.write_str("Test string\n");

    // Test: write_i64
    STDOUT.write_str("\n--- write_i64 Tests ---\n");
    STDOUT.write_str("Integer: ");
    STDOUT.write_i64(42);
    STDOUT.write_str("\n");

    STDOUT.write_str("Long: ");
    STDOUT.write_i64(9223372036854775807);
    STDOUT.write_str("\n");

    // Test: write_f64
    check_float_writer_growth();
    STDOUT.write_str("\n--- write_f64 Tests ---\n");
    STDOUT.write_str("Float: ");
    STDOUT.write_f64(3.14159);
    STDOUT.write_str("\n");

    // Test: write_str with string
    str str_val = "hello";
    STDOUT.write_str("String: ");
    STDOUT.write_str(str_val);
    STDOUT.write_str("\n");

    // Test: write_u64
    STDOUT.write_str("Hex: 255 = ");
    STDOUT.write_u64(255);
    STDOUT.write_str("\n");

    // Test: write_bool
    STDOUT.write_str("bool true = ");
    STDOUT.write_bool(true);
    STDOUT.write_str(", bool false = ");
    STDOUT.write_bool(false);
    STDOUT.write_str("\n");

    // Test: println wrapper
    STDOUT.write_str("\n--- println Tests ---\n");

    i32 pret = println("Line from println");
    assert_true(pret > 0, "println returns positive value");

    // Test: Multiple write_str calls
    STDOUT.write_str("\n--- Multiple write_str ---\n");

    STDOUT.write_str("Three values: ");
    STDOUT.write_i64(1);
    STDOUT.write_str(", ");
    STDOUT.write_i64(2);
    STDOUT.write_str(", ");
    STDOUT.write_i64(3);
    STDOUT.write_str("\n");

    // Test: Escape sequences
    STDOUT.write_str("\n--- Escape Sequences ---\n");

    STDOUT.write_str("Tab:\tafter tab\n");
    STDOUT.write_str("Quote: \"quoted\"\n");
    STDOUT.write_str("Backslash: \\\n");

    // Test: Empty string
    STDOUT.write_str("\n--- Edge Cases ---\n");

    STDOUT.write_str("");


    // Test: eprintln
    STDOUT.write_str("\n--- eprintln Tests ---\n");
    eprintln("stderr message via eprintln");

    // Test: File write_line and read_line
    {
        str test_path = "test_silver_io_read_line.txt";
        File out_f = File.open(test_path, "w");
        assert_true(out_f.is_open, "opened test file for writing");
        out_f.write_line("first line");
        out_f.write_line("second line");
        out_f.close();

        File in_f = File.open(test_path, "r");
        assert_true(in_f.is_open, "opened test file for reading");
        Optional<String> l1 = in_f.read_line();
        assert_true(l1.is_some(), "read first line");
        String s1 = l1.unwrap();
        assert_eq_str(s1.to_str(), "first line\n", "first line content matches");
        s1.drop();

        Optional<String> l2 = in_f.read_line();
        assert_true(l2.is_some(), "read second line");
        String s2 = l2.unwrap();
        assert_eq_str(s2.to_str(), "second line\n", "second line content matches");
        s2.drop();

        Optional<String> l3 = in_f.read_line();
        assert_true(l3.is_none(), "read EOF is none");
        in_f.close();
    }

    if (!@cfg(os.wasi)) {
        check_vectored_file_io(); // WASI has no vectored I/O seam
    }

    // Summary
    return done();
}
