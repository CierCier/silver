// tests/http2_test.ag — HTTP/2 client against native Silver HTTP/2 server.
//
// Verifies the client preface/SETTINGS exchange, a HEADERS request with
// HPACK, and the HEADERS+DATA response (status, headers, body).
// Spawns the server on a different thread using `launch` and runs the client.

import std.error;
import std.fmt;
import std.mem.alloc;
import std.mem.memory;
import std.net.hpack;
import std.net.http;
import std.net.http2;
import std.net.inet;
import std.net.tcp;
import std.net.transport;
import std.sys.entry;
import std.test;

Result<i64, Error> tcp_io_read(void* ctx, u8* buf, i64 len) {
    TcpStream* s = (TcpStream*)ctx;
    return s.read(buf, len);
}

Result<i64, Error> tcp_io_write(void* ctx, u8* buf, i64 len) {
    TcpStream* s = (TcpStream*)ctx;
    return s.write(buf, len);
}

void handle_hello(ResponseWriter* w, HttpRequest* r) {
    w.set_header("content-type", "text/plain");
    w.write_header(200);
    w.write_str("hello h2");
}

void handle_echo(ResponseWriter* w, HttpRequest* r) {
    w.set_header("content-type", "text/plain");
    w.write_header(200);
    w.write_str(r.body_str());
}

void server_worker(i32 fd) {
    TcpListener listener = TcpListener.from_fd(fd);
    HttpServer s = HttpServer.new("127.0.0.1:0");
    s.handle_func("/hello", handle_hello);
    s.handle_func("/echo", handle_echo);

    Result<i64, Error> a = listener.accept();
    if (a.success()) {
        TcpStream stream = TcpStream.from_fd((i32)a.value());
        s.serve_conn(move stream);
    }
    s.drop();
}

i32 main() {
    test_start("http2: h2c hello");

    Result<SocketAddr, AddrError> addr = SocketAddr.v4("127.0.0.1", (u16)0);
    assert_true(addr.success(), "address valid");
    SocketAddr a = addr.unwrap();

    TcpListener listener = TcpListener.bind(&a, 16);
    assert_true(listener.valid(), "listener valid");

    SockAddrIn sa;
    u32 len = 16;
    try_getsockname(listener.raw_fd(), (void*)&sa, &len);
    u16 port = ntoh16(sa.sin_port);

    i32 lfd = listener.take_fd();
    Task<void> srv = launch server_worker(lfd);

    Result<SocketAddr, AddrError> target_addr = SocketAddr.v4("127.0.0.1", port);
    assert_true(target_addr.success(), "target address valid");
    SocketAddr ta = target_addr.unwrap();

    Result<TcpStream, Error> cr = TcpStream.connect_timeout(&ta, 2);
    assert_true(cr.success(), "h2c connect ok");
    TcpStream s = cr.unwrap();
    StreamIo io;
    io.ctx = (void*)&s;
    io.read = tcp_io_read;
    io.write = tcp_io_write;

    H2Connection c;
    h2_init(&c, &io);
    assert_eq_i64(0, h2_send_preface(&c), "preface sent");

    String auth = String.from_str("127.0.0.1:");
    u8 digits[8];
    i64 n = itoa((i64)port, &digits[0]);
    for (i64 i = 0; i < n; i = i + 1) { auth.push(digits[i]); }
    str authority = (str)auth.data;

    H2Response resp;
    i64 rc = h2_request(&c, "GET", "http", authority, "/hello", (HpackField*)0, 0, &resp);
    assert_eq_i64(0, rc, "h2 request succeeded");
    assert_eq_i64(200, resp.status, ":status is 200");
    assert_eq_i64(8, resp.body_len, "body length");
    assert_true(resp.body != (u8*)0, "body present");
    assert_true(memcmp((const void*)resp.body, (const void*)"hello h2", 8) == 0, "body is hello h2");

    // check a decoded header (content-type)
    bool found_ct = false;
    i64 i = 0;
    while (i < resp.header_count) {
        if (strcmp((str)resp.headers[i].name, "content-type") == 0) {
            assert_eq_str("text/plain", (str)resp.headers[i].value, "content-type value");
            found_ct = true;
        }
        i += 1;
    }
    assert_true(found_ct, "content-type header present");
    i64 ct_len = 0;
    u8* ct_val = h2_response_get_header(&resp, "content-type", &ct_len);
    assert_true(ct_val != (u8*)0, "content-type found via h2_response_get_header");
    assert_eq_i64(0, resp.rst_error, "no rst error");

    free(resp.body);
    hpack_free_fields(&resp.headers[0], resp.header_count);

    // second request on the same connection: 404 path
    test_start("http2: h2c 404");
    H2Response resp2;
    rc = h2_request(&c, "GET", "http", authority, "/missing", (HpackField*)0, 0, &resp2);
    assert_eq_i64(0, rc, "h2 request (404) succeeded");
    assert_eq_i64(404, resp2.status, ":status is 404");
    free(resp2.body);
    hpack_free_fields(&resp2.headers[0], resp2.header_count);

    // POST with a body (DATA frame), echoed by the server
    test_start("http2: h2c POST echo");
    HpackField extra[2];
    extra[0].name = (u8*)"content-type";   extra[0].name_len = 12;
    extra[0].value = (u8*)"text/plain";    extra[0].value_len = 10;
    extra[1].name = (u8*)"content-length"; extra[1].name_len = 14;
    extra[1].value = (u8*)"10";            extra[1].value_len = 2;
    u8* body = (u8*)"hello post";
    H2Response resp3;
    rc = h2_request_body(&c, "POST", "http", authority, "/echo",
                         &extra[0], 2, body, 10, &resp3);
    assert_eq_i64(0, rc, "POST succeeded");
    assert_eq_i64(200, resp3.status, "POST status 200");
    assert_eq_i64(10, resp3.body_len, "echo length");
    assert_true(memcmp((const void*)resp3.body, (const void*)"hello post", 10) == 0, "echo body");
    free(resp3.body);
    hpack_free_fields(&resp3.headers[0], resp3.header_count);

    // CONTINUATION: set peer_max_frame_size low to force CONTINUATION frames
    test_start("http2: h2c CONTINUATION frames");
    c.peer_max_frame_size = 64;
    HpackField cont_extra[2];
    cont_extra[0].name = (u8*)"x-long-custom-header"; cont_extra[0].name_len = 20;
    cont_extra[0].value = (u8*)"some-long-value-that-exceeds-the-tiny-frame-size-limit"; cont_extra[0].value_len = 53;
    cont_extra[1].name = (u8*)"x-second-header"; cont_extra[1].name_len = 15;
    cont_extra[1].value = (u8*)"another-value-to-ensure-continuation"; cont_extra[1].value_len = 36;
    H2Response resp_cont;
    rc = h2_request(&c, "GET", "http", authority, "/hello", &cont_extra[0], 2, &resp_cont);
    assert_eq_i64(0, rc, "h2 request with CONTINUATION succeeded");
    assert_eq_i64(200, resp_cont.status, ":status is 200");
    assert_eq_i64(8, resp_cont.body_len, "body length");
    free(resp_cont.body);
    hpack_free_fields(&resp_cont.headers[0], resp_cont.header_count);
    c.peer_max_frame_size = H2_DEFAULT_MAX_FRAME;

    // multiplexed: three concurrent GETs on fresh streams
    test_start("http2: h2c multiplexed streams");
    i64 s0 = h2_begin(&c, "GET", "http", authority, "/hello", (HpackField*)0, 0, (u8*)0, 0);
    i64 s1 = h2_begin(&c, "GET", "http", authority, "/hello", (HpackField*)0, 0, (u8*)0, 0);
    i64 s2 = h2_begin(&c, "GET", "http", authority, "/hello", (HpackField*)0, 0, (u8*)0, 0);
    assert_true(s0 >= 0 && s1 >= 0 && s2 >= 0, "streams allocated");
    assert_eq_i64(0, h2_wait_all(&c), "multiplexed responses complete");
    i64 mi = 0;
    while (mi < 3) {
        i64 idx = 0;
        if (mi == 0) { idx = s0; }
        else if (mi == 1) { idx = s1; }
        else { idx = s2; }
        assert_eq_i64(200, c.streams[idx].resp.status, "mux status 200");
        assert_eq_i64(8, c.streams[idx].resp.body_len, "mux body length");
        assert_true(memcmp((const void*)c.streams[idx].resp.body, (const void*)"hello h2", 8) == 0, "mux body");
        mi += 1;
    }

    c.drop();
    s.close();
    wait srv;
    auth.drop();

    return done();
}
