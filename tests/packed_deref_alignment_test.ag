// compile_flags: -O2
// Pointers to #[packed] fields can be unaligned; loads and stores through
// them must not assume natural alignment.
import std.test;

#[packed]
struct Packed {
    u8 tag;
    u32 value;
}

u32 read_through(u32* p) {
    return *p;
}

void write_through(u32* p, u32 v) {
    *p = v;
}

i32 main() {
    test_start("deref of packed field pointer");
    {
        Packed p;
        p.tag = (u8)1;
        p.value = 0x11223344;
        assert_eq_i64((i64)0x11223344, (i64)read_through(&p.value), "load through pointer");
        write_through(&p.value, 0x55667788);
        assert_eq_i64((i64)0x55667788, (i64)p.value, "store through pointer");
        assert_eq_i64(1, (i64)p.tag, "neighbour untouched");
    }
    return done();
}
