struct AlignPair {
    i8 tag;
    i64 value;
}

u64 align_of<T>() {
    return @align(T);
}

i32 main() {
    i32 x = 0;

    @assert(!(@align(i8) != 1), "@align(i8) != 1");
    @assert(!(@align(i32) != 4), "@align(i32) != 4");
    @assert(!(@align(i64) != 8), "@align(i64) != 8");
    @assert(!(@align(AlignPair) != 8), "@align(AlignPair) != 8");
    @assert(!(@align(x) != 4), "@align(x) != 4");
    @assert(!(align_of<i64>() != 8), "align_of<i64>() != 8");

    return 0;
}
