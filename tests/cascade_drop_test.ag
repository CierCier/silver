import std.mem;

i32 outer_drop_count = 0;
i32 inner_total = 0;
i32 inherent_drop_count = 0;

struct Inner {
    i32 id;
}

impl Inner {
    Inner new(i32 id) {
        Inner t;
        t.id = id;
        return move t;
    }
}

impl Drop for Inner {
    void drop(Inner* self) {
        inner_total = inner_total + 1;
    }
}

struct Outer {
    Inner a;
    Inner b;
}

impl Outer {
    Outer new(i32 id_a, i32 id_b) {
        Outer o;
        o.a = Inner.new(id_a);
        o.b = Inner.new(id_b);
        return move o;
    }
}

impl Drop for Outer {
    void drop(Outer* self) {
        outer_drop_count = outer_drop_count + 1;
        // No manual field drops — cascading handles them automatically.
    }
}

struct InherentOnly {
    i32 id;
}

impl InherentOnly {
    InherentOnly new(i32 id) {
        InherentOnly t;
        t.id = id;
        return move t;
    }

    void manual_drop(InherentOnly* self) {
        inherent_drop_count = inherent_drop_count + 1;
    }
}

i32 main() {
    {
        outer_drop_count = 0;
        inner_total = 0;
        {
            Outer o = Outer.new(1, 2);
        }
        @assert(!(outer_drop_count != 1), "outer_drop_count != 1");
        @assert(!(inner_total != 2), "inner_total != 2");
    }

    {
        outer_drop_count = 0;
        inner_total = 0;
        {
            Outer o = Outer.new(3, 4);
            Outer p = move o;
        }
        @assert(!(outer_drop_count != 1), "outer_drop_count != 1");
        @assert(!(inner_total != 2), "inner_total != 2");
    }

    {
        inherent_drop_count = 0;
        {
            InherentOnly x = InherentOnly.new(5);
        }
        @assert(!(inherent_drop_count != 0), "inherent_drop_count != 0");
    }

    return 0;
}
