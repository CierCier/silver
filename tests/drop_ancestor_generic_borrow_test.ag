// expected_exit: 42
import std.test;

struct Leaf { i64 value; }
impl Drop for Leaf { void drop(Leaf* self) {} }
struct Managed<T> { T item; T sibling; }
impl<T> Drop for Managed<T> { void drop(Managed<T>* self) {} }

i64 read_item<T>(&Managed<Leaf> parent, T _marker) {
    return parent.item.value;
}

i64 read_callback(Managed<Leaf>* parent) {
    return parent.item.value;
}

impl Managed<Leaf> {
    i64 read_method(&Managed<Leaf> self) {
        return self.item.value;
    }
}

i32 main() {
    Leaf item = { .value = 40 };
    Leaf sibling = { .value = 2 };
    Managed<Leaf> parent = { .item = move item, .sibling = move sibling };
    i64 value = read_item<i64>(&parent, 0);
    assert_eq_i64(40, value, "generic call borrows a custom-Drop parent");
    assert_eq_i64(40, parent.read_method(), "method call borrows a custom-Drop parent");
    i64(Managed<Leaf>*) callback = &read_callback;
    assert_eq_i64(40, callback(&parent),
                  "function pointer borrows a custom-Drop parent");
    return 42;
}
