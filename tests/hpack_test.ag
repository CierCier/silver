// tests/hpack_test.ag - HPACK golden vectors (RFC 7541 Appendix C).
//
// Decodes the C.3/C.4 request and C.5/C.6 response examples (raw and
// Huffman), checks the C.1 integer examples, and round-trips a request
// through the encoder back into the decoder.

import std.net.hpack;
import std.sys.entry;
import std.test;

i32 main() {
    HpackDecoder d;
    HpackField hdr[16];
    i64 n = 0;

    // C.3.1 first request (no Huffman)
    u8 c31[20] = {
        0x82, 0x86, 0x84, 0x41, 0x0f, 0x77, 0x77, 0x77, 0x2e, 0x65, 0x78, 0x61,
        0x6d, 0x70, 0x6c, 0x65, 0x2e, 0x63, 0x6f, 0x6d
    };
    hpack_init(&d);
    n = hpack_decode(&d, &c31[0], 20, &hdr[0], 16);
    assert_eq_i64(4, n, "c31 field count");
    assert_eq_str(":method", (str)hdr[0].name, "c31[0] name");
    assert_eq_str("GET", (str)hdr[0].value, "c31[0] value");
    assert_eq_str(":scheme", (str)hdr[1].name, "c31[1] name");
    assert_eq_str("http", (str)hdr[1].value, "c31[1] value");
    assert_eq_str(":path", (str)hdr[2].name, "c31[2] name");
    assert_eq_str("/", (str)hdr[2].value, "c31[2] value");
    assert_eq_str(":authority", (str)hdr[3].name, "c31[3] name");
    assert_eq_str("www.example.com", (str)hdr[3].value, "c31[3] value");
    hpack_free_fields(&hdr[0], n);

    // C.3.2 second request - dynamic table now holds :authority (idx 62)
    u8 c32v[14] = {
        0x82, 0x86, 0x84, 0xbe, 0x58, 0x08, 0x6e, 0x6f, 0x2d, 0x63, 0x61, 0x63,
        0x68, 0x65
    };
    n = hpack_decode(&d, &c32v[0], 14, &hdr[0], 16);
    assert_eq_i64(5, n, "c32 field count");
    assert_eq_str(":method", (str)hdr[0].name, "c32[0] name");
    assert_eq_str("GET", (str)hdr[0].value, "c32[0] value");
    assert_eq_str(":scheme", (str)hdr[1].name, "c32[1] name");
    assert_eq_str("http", (str)hdr[1].value, "c32[1] value");
    assert_eq_str(":path", (str)hdr[2].name, "c32[2] name");
    assert_eq_str("/", (str)hdr[2].value, "c32[2] value");
    assert_eq_str(":authority", (str)hdr[3].name, "c32[3] name");
    assert_eq_str("www.example.com", (str)hdr[3].value, "c32[3] value");
    assert_eq_str("cache-control", (str)hdr[4].name, "c32[4] name");
    assert_eq_str("no-cache", (str)hdr[4].value, "c32[4] value");
    hpack_free_fields(&hdr[0], n);

    // C.3.3 third request - cache-control pushes :authority to idx 63
    u8 c33[29] = {
        0x82, 0x87, 0x85, 0xbf, 0x40, 0x0a, 0x63, 0x75, 0x73, 0x74, 0x6f, 0x6d,
        0x2d, 0x6b, 0x65, 0x79, 0x0c, 0x63, 0x75, 0x73, 0x74, 0x6f, 0x6d, 0x2d,
        0x76, 0x61, 0x6c, 0x75, 0x65
    };
    n = hpack_decode(&d, &c33[0], 29, &hdr[0], 16);
    assert_eq_i64(5, n, "c33 field count");
    assert_eq_str(":method", (str)hdr[0].name, "c33[0] name");
    assert_eq_str("GET", (str)hdr[0].value, "c33[0] value");
    assert_eq_str(":scheme", (str)hdr[1].name, "c33[1] name");
    assert_eq_str("https", (str)hdr[1].value, "c33[1] value");
    assert_eq_str(":path", (str)hdr[2].name, "c33[2] name");
    assert_eq_str("/index.html", (str)hdr[2].value, "c33[2] value");
    assert_eq_str(":authority", (str)hdr[3].name, "c33[3] name");
    assert_eq_str("www.example.com", (str)hdr[3].value, "c33[3] value");
    assert_eq_str("custom-key", (str)hdr[4].name, "c33[4] name");
    assert_eq_str("custom-value", (str)hdr[4].value, "c33[4] value");
    hpack_free_fields(&hdr[0], n);

    // C.4.1 first request (Huffman)
    u8 c41[17] = {
        0x82, 0x86, 0x84, 0x41, 0x8c, 0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b,
        0xa0, 0xab, 0x90, 0xf4, 0xff
    };
    hpack_init(&d);
    n = hpack_decode(&d, &c41[0], 17, &hdr[0], 16);
    assert_eq_i64(4, n, "c41 field count");
    assert_eq_str(":method", (str)hdr[0].name, "c41[0] name");
    assert_eq_str("GET", (str)hdr[0].value, "c41[0] value");
    assert_eq_str(":scheme", (str)hdr[1].name, "c41[1] name");
    assert_eq_str("http", (str)hdr[1].value, "c41[1] value");
    assert_eq_str(":path", (str)hdr[2].name, "c41[2] name");
    assert_eq_str("/", (str)hdr[2].value, "c41[2] value");
    assert_eq_str(":authority", (str)hdr[3].name, "c41[3] name");
    assert_eq_str("www.example.com", (str)hdr[3].value, "c41[3] value");
    hpack_free_fields(&hdr[0], n);

    // C.5.1 first response (no Huffman)
    u8 c51[70] = {
        0x48, 0x03, 0x33, 0x30, 0x32, 0x58, 0x07, 0x70, 0x72, 0x69, 0x76, 0x61,
        0x74, 0x65, 0x61, 0x1d, 0x4d, 0x6f, 0x6e, 0x2c, 0x20, 0x32, 0x31, 0x20,
        0x4f, 0x63, 0x74, 0x20, 0x32, 0x30, 0x31, 0x33, 0x20, 0x32, 0x30, 0x3a,
        0x31, 0x33, 0x3a, 0x32, 0x31, 0x20, 0x47, 0x4d, 0x54, 0x6e, 0x17, 0x68,
        0x74, 0x74, 0x70, 0x73, 0x3a, 0x2f, 0x2f, 0x77, 0x77, 0x77, 0x2e, 0x65,
        0x78, 0x61, 0x6d, 0x70, 0x6c, 0x65, 0x2e, 0x63, 0x6f, 0x6d
    };
    hpack_init(&d);
    n = hpack_decode(&d, &c51[0], 70, &hdr[0], 16);
    assert_eq_i64(4, n, "c51 field count");
    assert_eq_str(":status", (str)hdr[0].name, "c51[0] name");
    assert_eq_str("302", (str)hdr[0].value, "c51[0] value");
    assert_eq_str("cache-control", (str)hdr[1].name, "c51[1] name");
    assert_eq_str("private", (str)hdr[1].value, "c51[1] value");
    assert_eq_str("date", (str)hdr[2].name, "c51[2] name");
    assert_eq_str("Mon, 21 Oct 2013 20:13:21 GMT", (str)hdr[2].value, "c51[2] value");
    assert_eq_str("location", (str)hdr[3].name, "c51[3] name");
    assert_eq_str("https://www.example.com", (str)hdr[3].value, "c51[3] value");
    hpack_free_fields(&hdr[0], n);

    // C.6.1 first response (Huffman)
    u8 c61[54] = {
        0x48, 0x82, 0x64, 0x02, 0x58, 0x85, 0xae, 0xc3, 0x77, 0x1a, 0x4b, 0x61,
        0x96, 0xd0, 0x7a, 0xbe, 0x94, 0x10, 0x54, 0xd4, 0x44, 0xa8, 0x20, 0x05,
        0x95, 0x04, 0x0b, 0x81, 0x66, 0xe0, 0x82, 0xa6, 0x2d, 0x1b, 0xff, 0x6e,
        0x91, 0x9d, 0x29, 0xad, 0x17, 0x18, 0x63, 0xc7, 0x8f, 0x0b, 0x97, 0xc8,
        0xe9, 0xae, 0x82, 0xae, 0x43, 0xd3
    };
    hpack_init(&d);
    n = hpack_decode(&d, &c61[0], 54, &hdr[0], 16);
    assert_eq_i64(4, n, "c61 field count");
    assert_eq_str(":status", (str)hdr[0].name, "c61[0] name");
    assert_eq_str("302", (str)hdr[0].value, "c61[0] value");
    assert_eq_str("cache-control", (str)hdr[1].name, "c61[1] name");
    assert_eq_str("private", (str)hdr[1].value, "c61[1] value");
    assert_eq_str("date", (str)hdr[2].name, "c61[2] name");
    assert_eq_str("Mon, 21 Oct 2013 20:13:21 GMT", (str)hdr[2].value, "c61[2] value");
    assert_eq_str("location", (str)hdr[3].name, "c61[3] name");
    assert_eq_str("https://www.example.com", (str)hdr[3].value, "c61[3] value");
    hpack_free_fields(&hdr[0], n);

    // C.6.2 second response - dynamic table references (idx 65/64/63)
    u8 c62[8] = {
        0x48, 0x83, 0x64, 0x0e, 0xff, 0xc1, 0xc0, 0xbf
    };
    n = hpack_decode(&d, &c62[0], 8, &hdr[0], 16);
    assert_eq_i64(4, n, "c62 field count");
    assert_eq_str(":status", (str)hdr[0].name, "c62[0] name");
    assert_eq_str("307", (str)hdr[0].value, "c62[0] value");
    assert_eq_str("cache-control", (str)hdr[1].name, "c62[1] name");
    assert_eq_str("private", (str)hdr[1].value, "c62[1] value");
    assert_eq_str("date", (str)hdr[2].name, "c62[2] name");
    assert_eq_str("Mon, 21 Oct 2013 20:13:21 GMT", (str)hdr[2].value, "c62[2] value");
    assert_eq_str("location", (str)hdr[3].name, "c62[3] name");
    assert_eq_str("https://www.example.com", (str)hdr[3].value, "c62[3] value");
    hpack_free_fields(&hdr[0], n);

    // C.6.3 third response - evictions + set-cookie
    u8 c63[79] = {
        0x88, 0xc1, 0x61, 0x96, 0xd0, 0x7a, 0xbe, 0x94, 0x10, 0x54, 0xd4, 0x44,
        0xa8, 0x20, 0x05, 0x95, 0x04, 0x0b, 0x81, 0x66, 0xe0, 0x84, 0xa6, 0x2d,
        0x1b, 0xff, 0xc0, 0x5a, 0x83, 0x9b, 0xd9, 0xab, 0x77, 0xad, 0x94, 0xe7,
        0x82, 0x1d, 0xd7, 0xf2, 0xe6, 0xc7, 0xb3, 0x35, 0xdf, 0xdf, 0xcd, 0x5b,
        0x39, 0x60, 0xd5, 0xaf, 0x27, 0x08, 0x7f, 0x36, 0x72, 0xc1, 0xab, 0x27,
        0x0f, 0xb5, 0x29, 0x1f, 0x95, 0x87, 0x31, 0x60, 0x65, 0xc0, 0x03, 0xed,
        0x4e, 0xe5, 0xb1, 0x06, 0x3d, 0x50, 0x07
    };
    n = hpack_decode(&d, &c63[0], 79, &hdr[0], 16);
    assert_eq_i64(6, n, "c63 field count");
    assert_eq_str(":status", (str)hdr[0].name, "c63[0] name");
    assert_eq_str("200", (str)hdr[0].value, "c63[0] value");
    assert_eq_str("cache-control", (str)hdr[1].name, "c63[1] name");
    assert_eq_str("private", (str)hdr[1].value, "c63[1] value");
    assert_eq_str("date", (str)hdr[2].name, "c63[2] name");
    assert_eq_str("Mon, 21 Oct 2013 20:13:22 GMT", (str)hdr[2].value, "c63[2] value");
    assert_eq_str("location", (str)hdr[3].name, "c63[3] name");
    assert_eq_str("https://www.example.com", (str)hdr[3].value, "c63[3] value");
    assert_eq_str("content-encoding", (str)hdr[4].name, "c63[4] name");
    assert_eq_str("gzip", (str)hdr[4].value, "c63[4] value");
    assert_eq_str("set-cookie", (str)hdr[5].name, "c63[5] name");
    assert_eq_str("foo=ASDJKHQKBZXOQWEOPIUAXQWEOIU; max-age=3600; version=1", (str)hdr[5].value, "c63[5] value");
    hpack_free_fields(&hdr[0], n);

    // C.1 integer examples
    u8 e10[1] = { 0x0a };
    i64 p = 0;
    assert_eq_i64(10, hpack_int_decode(&e10[0], &p, 1, 5), "C.1.1 10 in 5 bits");
    u8 e1337[3] = { 0x1f, 0x9a, 0x0a };
    p = 0;
    assert_eq_i64(1337, hpack_int_decode(&e1337[0], &p, 3, 5), "C.1.2 1337 in 5 bits");
    u8 e42[1] = { 0x2a };
    p = 0;
    assert_eq_i64(42, hpack_int_decode(&e42[0], &p, 1, 8), "C.1.3 42 at octet boundary");

    // Round-trip: encode the C.3.1 header list, then decode it back.
    HpackField req[4];
    req[0].name = (u8*)":method";   req[0].name_len = 7;   req[0].value = (u8*)"GET";       req[0].value_len = 3;
    req[1].name = (u8*)":scheme";   req[1].name_len = 7;   req[1].value = (u8*)"http";      req[1].value_len = 4;
    req[2].name = (u8*)":path";     req[2].name_len = 5;   req[2].value = (u8*)"/";         req[2].value_len = 1;
    req[3].name = (u8*)":authority";req[3].name_len = 10;  req[3].value = (u8*)"www.example.com"; req[3].value_len = 15;
    u8 enc[256];
    i64 enc_len = hpack_encode(&req[0], 4, &enc[0], 256);
    assert_true(enc_len > 0, "hpack_encode wrote bytes");
    hpack_init(&d);
    n = hpack_decode(&d, &enc[0], enc_len, &hdr[0], 16);
    assert_eq_i64(4, n, "round-trip field count");
    assert_eq_str(":method", (str)hdr[0].name, "round-trip :method");
    assert_eq_str("GET", (str)hdr[0].value, "round-trip GET");
    assert_eq_str(":authority", (str)hdr[3].name, "round-trip :authority");
    assert_eq_str("www.example.com", (str)hdr[3].value, "round-trip authority value");
    hpack_free_fields(&hdr[0], n);

    // Huffman encoder: "www.example.com" must match the C.4.1 bytes, and
    // round-trip back through the decoder.
    u8 huff[64];
    i64 huff_len = hpack_huff_encode((u8*)"www.example.com", 15, &huff[0], 64);
    assert_eq_i64(12, huff_len, "huffman encoded length");
    u8 expect[12] = { 0xf1, 0xe3, 0xc2, 0xe5, 0xf2, 0x3a, 0x6b, 0xa0, 0xab, 0x90, 0xf4, 0xff };
    i64 k = 0;
    while (k < 12) {
        assert_eq_i64((i64)expect[k], (i64)huff[k], "huffman byte matches");
        k += 1;
    }
    u8 dec[64];
    i64 dlen = hpack_huff_decode(&huff[0], 12, &dec[0], 64);
    assert_eq_i64(15, dlen, "huffman round-trip length");
    assert_true(memcmp((const void*)&dec[0], (const void*)"www.example.com", 15) == 0, "huffman round-trip");

    return done();
}
