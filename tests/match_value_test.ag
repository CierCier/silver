// Test suite for match on non-enum scrutinees: integer, float, string,
// bool, and char literal patterns, plus multi-binding enum payloads.
import std.test;

enum Rect2 { R(i64, i64); E; }

i32 main() {
    test_start("match i64");
    {
        i64 x = 2;
        i64 r = match x { 0 : 100, 1 : 200, 2 : 300, _ : -1 };
        assert_eq_i64(300, r, "i64 literal arm selected");
    }

    test_start("match f64");
    {
        f64 x = 1.5;
        f64 r = match x { 1.5 : 10.0, 2.5 : 20.0, _ : 0.0 };
        if (r != 10.0) { tests_failed += 1; @eprintln("  [FAIL] f64 literal arm selected"); }
        else { tests_passed += 1; @println("  [PASS] f64 literal arm selected"); }
    }

    test_start("match str");
    {
        str x = "hi";
        i64 r = match x { "hi" : 1, "bye" : 2, _ : 0 };
        assert_eq_i64(1, r, "str literal arm selected");
    }

    test_start("match bool");
    {
        bool x = true;
        i64 r = match x { true : 7, false : 9 };
        assert_eq_i64(7, r, "bool literal arm selected");
    }

    test_start("match char");
    {
        char x = 'a';
        i64 r = match x { 'a' : 1, 'b' : 2, _ : 0 };
        assert_eq_i64(1, r, "char literal arm selected");
    }

    test_start("match multi-binding enum payload");
    {
        Rect2 r = Rect2.R(3, 4);
        i64 sum = match r { R(w, h) : w + h, E : 0 };
        assert_eq_i64(7, sum, "multi-binding payload extracted");
    }

    test_start("match f64 enum payload binds real type");
    {
        Shape2 s = Shape2.C(2.5);
        f64 v = match s { C(r) : r, N : 0.0 };
        if (v != 2.5) { tests_failed += 1; @eprintln("  [FAIL] f64 payload bound with real type"); }
        else { tests_passed += 1; @println("  [PASS] f64 payload bound with real type"); }
    }

    return done();
}

enum Shape2 { C(f64); N; }
