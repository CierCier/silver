import std.string;
import std.io.file;
import std.display;

struct NativeLabel { i64 value; }
struct NativeTemporaryLabel { i64 value; }
enum NativeStatus { Pending; Ready; }
struct NativePoint { i64 x; i64 y; }
struct NativeLine { NativePoint point; str tag; NativeStatus status; }
i64 temporary_label_calls = 0;
i64 displayed_temporary_label = 0;

NativeTemporaryLabel make_temporary_label() {
    temporary_label_calls = temporary_label_calls + 1;
    NativeTemporaryLabel label;
    label.value = temporary_label_calls;
    return label;
}

impl Display for NativeLabel {
    void fmt(*self, BufWriter* out) {
        @fprint(out, "{}", self.value);
    }
}

impl Display for NativeTemporaryLabel {
    void fmt(*self, BufWriter* out) {
        displayed_temporary_label = self.value;
        @fprint(out, "{}", self.value);
    }
}

i32 main() {
    bool flag = true;
    i64 negative = -12;
    u64 positive = (u64)34;
    f64 fraction = 1.25;
    String rendered = @format("escaped {{}}: {} | {} | {} | {} | {}", negative, positive, fraction, flag, 'x');
    @println("{}", rendered);
    NativeLabel label = { .value = 73 };
    String custom = @format("label: {}", label);
    @println("{}", custom);
    String temporary_custom = @format("temporary: {}", make_temporary_label());
    if (temporary_label_calls != 1) { return 11; }
    if (displayed_temporary_label != 1) { return 12; }
    NativeStatus status = NativeStatus.Ready;
    NativePoint point = { .x = 1, .y = 2 };
    NativePoint inner = { .x = 3, .y = 4 };
    NativeLine line;
    line.point = inner;
    line.tag = "seg";
    line.status = status;
    String debug = @format("point: {} | line: {}", point, line);
    @println("{}", debug);
    String enum_name = @format("status: {}", status);
    @println("{}", enum_name);
    @print("print:{}|", 7);
    @println("println:{}", 8);
    @eprint("eprint:{}|", 9);
    @eprintln("eprintln:{}", 10);
    return 0;
}
