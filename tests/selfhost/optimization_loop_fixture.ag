// Runtime benchmark for scalar promotion across control-flow boundaries.
import std.io;
import std.mem.alloc;

i32 main() {
    i64 n = 1000000;
    i64* values = (i64*)malloc(n * 8);
    i64 i = 0;
    while (i < n) { values[i] = i % 251; i = i + 1; }
    i64 sum = 0;
    i64 round = 0;
    while (round < 30) {
        i = 0;
        while (i < n) { sum = sum + values[i]; i = i + 1; }
        round = round + 1;
    }
    @println("{}", sum);
    free((u8*)values);
    if (sum != 3749943600) { return 1; }
    return 0;
}
