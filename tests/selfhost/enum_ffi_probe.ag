enum Linkage {
    External0 = 0;
    Internal8 = 8;
}
enum PositiveLinkage { PositiveLow = 0; PositiveHigh = 32769; }
enum NegativeLinkage { NegativeZero = 0; NegativeOne = -1; }

struct Span { u32 file; }
struct Nested { Span span; }

#[link("enum_ffi_probe")]
extern "C" {
    void LLVMSetLinkage(void* value, Linkage linkage);
    i32 silver_test_get_linkage_i32();
    void silver_test_set_positive_linkage(PositiveLinkage linkage);
    i32 silver_test_get_positive_linkage();
    void silver_test_set_negative_linkage(NegativeLinkage linkage);
    i32 silver_test_get_negative_linkage();
}

i32 state = 0;

void* choose_linkage(
    void* first, void* _second, void* _third, void* _fourth,
    str _outer_name, str _inner_name,
    void* _fifth, void* _sixth, void* _seventh,
    bool flag
) {
    LLVMSetLinkage(first, flag ? Linkage.External0 : Linkage.Internal8);
    return first;
}

i32 main() {
    Nested nested;
    u32 source = 2;
    nested.span.file = 3;
    bool flag = source <= 1 || (u32)nested.span.file == source;
    void* value = (void*)&state;

    if (choose_linkage(value, value, value, value, "outer", "inner",
                       value, value, value, flag) != value) { return 1; }
    if (silver_test_get_linkage_i32() != 8) { return 2; }

    nested.span.file = source;
    flag = source <= 1 || (u32)nested.span.file == source;
    if (choose_linkage(value, value, value, value, "outer", "inner",
                       value, value, value, flag) != value) { return 4; }
    if (silver_test_get_linkage_i32() != 0) { return 5; }

    nested.span.file = 3;
    flag = source <= 1 || (u32)nested.span.file == source;
    if (choose_linkage(value, value, value, value, "outer", "inner",
                       value, value, value, flag) != value) { return 7; }
    if (silver_test_get_linkage_i32() != 8) { return 8; }
    silver_test_set_positive_linkage(PositiveLinkage.PositiveHigh);
    if (silver_test_get_positive_linkage() != 32769) { return 9; }
    silver_test_set_negative_linkage(NegativeLinkage.NegativeOne);
    if (silver_test_get_negative_linkage() != -1) { return 10; }
    return 42;
}
