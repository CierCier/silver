i64 identity(i64 x) {
    return x;
}

i64 test_prompt_spec(i64 input) {
    i64 result = identity(match input {
        0: {
            i64 local = 1;
            return local;
        },
        _: 2,
    });
    return result;
}

i64 test_prompt_spec_let(i64 input) {
    let result = identity(match input {
        0: {
            let local = 10;
            return local;
        },
        _: 20,
    });
    return result;
}

struct ScopeHolder {}
impl ScopeHolder {
    i64 evaluate(i64 x) {
        return x;
    }
}

i64 test_static_call_nested(i64 input) {
    i64 result = ScopeHolder.evaluate(match input {
        0: {
            i64 local = 50;
            return local;
        },
        _: 60,
    });
    return result;
}

void PascalCall(i64 _x) {}

void test_standalone_bracket(i64 input) {
    [identity(match input {
        0: {
            i64 local = 100;
            local;
        },
        _: 200,
    })];
}

void test_standalone_static_call(i64 input) {
    ScopeHolder.evaluate(match input {
        0: {
            i64 local = 50;
            local;
        },
        _: 60,
    });
}

void test_standalone_pascal_call(i64 input) {
    PascalCall(match input {
        0: {
            i64 local = 1;
            local;
        },
        _: 2,
    });
}

macro i64 mac_identity(i64 val) {
    return val;
}

i64 test_macro_call(i64 input) {
    i64 result = @mac_identity(match input {
        0: {
            i64 local = 77;
            return local;
        },
        _: 88,
    });
    return result;
}

i32 main() {
    return 0;
}
