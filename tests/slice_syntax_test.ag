import std.test;
import std.slice;
import std.mem.vec;
import std.string;

i32 main() {
    test_start("Array slicing");
    {
        i32 arr[5];
        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;
        arr[4] = 50;

        Slice<i32> s1 = arr[1:4];
        assert_eq_i64(3, s1.len, "arr[1:4].len == 3");
        assert_eq_i64(20, s1[0], "arr[1:4][0] == 20");
        assert_eq_i64(30, s1[1], "arr[1:4][1] == 30");
        assert_eq_i64(40, s1[2], "arr[1:4][2] == 40");

        Slice<i32> s_all = arr[:];
        assert_eq_i64(5, s_all.len, "arr[:].len == 5");
        assert_eq_i64(10, s_all[0], "arr[:][0] == 10");
        assert_eq_i64(50, s_all[4], "arr[:][4] == 50");

        Slice<i32> s_start = arr[2:];
        assert_eq_i64(3, s_start.len, "arr[2:].len == 3");
        assert_eq_i64(30, s_start[0], "arr[2:][0] == 30");
        assert_eq_i64(50, s_start[2], "arr[2:][2] == 50");

        Slice<i32> s_end = arr[:3];
        assert_eq_i64(3, s_end.len, "arr[:3].len == 3");
        assert_eq_i64(10, s_end[0], "arr[:3][0] == 10");
        assert_eq_i64(30, s_end[2], "arr[:3][2] == 30");

        // Negative indexing on arrays
        Slice<i32> s_neg = arr[:-1];
        assert_eq_i64(4, s_neg.len, "arr[:-1].len == 4");
        assert_eq_i64(40, s_neg[3], "arr[:-1][3] == 40");

        Slice<i32> s_neg2 = arr[-3:-1];
        assert_eq_i64(2, s_neg2.len, "arr[-3:-1].len == 2");
        assert_eq_i64(30, s_neg2[0], "arr[-3:-1][0] == 30");
        assert_eq_i64(40, s_neg2[1], "arr[-3:-1][1] == 40");
    }

    test_start("Subslice slicing");
    {
        i32 arr[5];
        arr[0] = 10;
        arr[1] = 20;
        arr[2] = 30;
        arr[3] = 40;
        arr[4] = 50;

        Slice<i32> s1 = arr[1:4];
        Slice<i32> sub = s1[1:3];
        assert_eq_i64(2, sub.len, "sub.len == 2");
        assert_eq_i64(30, sub[0], "sub[0] == 30");
        assert_eq_i64(40, sub[1], "sub[1] == 40");
    }

    test_start("Vector slicing");
    {
        Vec<i32> v;
        v.push(100);
        v.push(200);
        v.push(300);
        v.push(400);

        Slice<i32> v_slice = v[1:3];
        assert_eq_i64(2, v_slice.len, "v[1:3].len == 2");
        assert_eq_i64(200, v_slice[0], "v[1:3][0] == 200");
        assert_eq_i64(300, v_slice[1], "v[1:3][1] == 300");

        Slice<i32> v_neg = v[:-1];
        assert_eq_i64(3, v_neg.len, "v[:-1].len == 3");
        assert_eq_i64(300, v_neg[2], "v[:-1][2] == 300");
    }

    test_start("String slicing");
    {
        String str_val = String.from_str("hello world");
        Slice<u8> str_slice = str_val[0:5];
        assert_eq_i64(5, str_slice.len, "str_val[0:5].len == 5");
        assert_eq_i64(104, (i64)str_slice[0], "str_slice[0] == 'h'");
        assert_eq_i64(111, (i64)str_slice[4], "str_slice[4] == 'o'");
    }

    done();
    return 0;
}
