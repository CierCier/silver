// Test suite for HashMap::entry() and HashMapEntryRef<K, V>.
//
// The entry API is the headline feature of this round: it provides
// `or_insert`, `or_insert_with`, `take`, and in-place mutation via
// `&mut HashMapEntryRef`.  These tests cover both the occupied and
// vacant branches, plus the takeover path (entry on occupied key, then
// `take`).

import std.test;
import std.map;

i64 default_factory_calls = 0;

i64 make_default() {
    default_factory_calls = default_factory_calls + 1;
    return (i64)42;
}

void double_through_ptr(i64* p) {
    *p = *p * (i64)2;
}

i32 main() {
    STDOUT.write_str("=== HashMap Entry API Tests ===\n\n");

    // --- or_insert on a vacant entry ---
    STDOUT.write_str("--- or_insert on vacant ---\n");
    {
        HashMap<i32, i64> m = HashMap<i32, i64>.new();
        HashMapEntryRef<i32, i64> e = m.entry(7);
        assert_true(e.is_vacant(), "new entry for missing key is vacant");
        assert_true(!e.was_present(), "vacant entry: was_present is false");
        i64* p = e.or_insert((i64)100);
        assert_eq_i64(*p, 100, "or_insert default returned via ptr");
        assert_eq_i64(m.get(7), 100, "or_insert stored in map");
        assert_eq_i64(m.len(), 1, "len=1 after or_insert on vacant");
        m.drop();
    }

    // --- or_insert on an occupied entry ---
    STDOUT.write_str("\n--- or_insert on occupied ---\n");
    {
        HashMap<i32, i64> m = HashMap<i32, i64>.new();
        m.insert(7, (i64)70);
        HashMapEntryRef<i32, i64> e = m.entry(7);
        assert_true(!e.is_vacant(), "entry for present key is occupied");
        assert_true(e.was_present(), "was_present true on first sight");
        i64* p = e.or_insert((i64)999);
        // The default is consumed; the existing value is returned.
        assert_eq_i64(*p, 70, "or_insert on occupied returns existing");
        assert_eq_i64(m.get(7), 70, "or_insert on occupied did NOT replace");
        assert_eq_i64(m.len(), 1, "len unchanged after occupied or_insert");
        m.drop();
    }

    // --- or_insert_with: lazy default ---
    STDOUT.write_str("\n--- or_insert_with ---\n");
    {
        HashMap<i32, i64> m = HashMap<i32, i64>.new();
        default_factory_calls = 0;
        HashMapEntryRef<i32, i64> e1 = m.entry(99);
        i64* p1 = e1.or_insert_with(make_default);
        assert_eq_i64(*p1, 42, "or_insert_with inserted default");
        assert_eq_i64(default_factory_calls, 1, "factory called once on vacant");

        HashMapEntryRef<i32, i64> e2 = m.entry(99);
        i64* p2 = e2.or_insert_with(make_default);
        assert_eq_i64(*p2, 42, "or_insert_with returned existing");
        assert_eq_i64(default_factory_calls, 1, "factory NOT called on occupied");
        m.drop();
    }

    // --- take moves the value out and removes the entry ---
    STDOUT.write_str("\n--- take ---\n");
    {
        HashMap<i32, i64> m = HashMap<i32, i64>.new();
        m.insert(5, (i64)500);
        assert_eq_i64(m.len(), 1, "len=1 before take");
        HashMapEntryRef<i32, i64> e = m.entry(5);
        Optional<i64> taken = e.take();
        assert_true(taken.is_some(), "take returned some");
        assert_eq_i64(taken.unwrap(), 500, "take returned 500");
        assert_eq_i64(m.len(), 0, "len=0 after take");
        assert_true(!m.contains_key(5), "key 5 gone after take");

        // take on a vacant entry.
        HashMapEntryRef<i32, i64> e2 = m.entry(5);
        Optional<i64> taken2 = e2.take();
        assert_true(taken2.is_none(), "take on vacant returns none");
        m.drop();
    }

    // --- get_mut_ptr: in-place mutation via entry ---
    STDOUT.write_str("\n--- get_mut_ptr / direct mutation ---\n");
    {
        HashMap<i32, i64> m = HashMap<i32, i64>.new();
        m.insert(3, (i64)30);
        HashMapEntryRef<i32, i64> e = m.entry(3);
        i64* p = e.get_mut_ptr();
        assert_true((i64)p != 0, "get_mut_ptr returns non-null for occupied");
        *p = *p + (i64)5;
        assert_eq_i64(m.get(3), 35, "mutation via get_mut_ptr visible");

        // get_mut_ptr on vacant returns null.
        HashMapEntryRef<i32, i64> e2 = m.entry(999);
        i64* p2 = e2.get_mut_ptr();
        assert_true((i64)p2 == 0, "get_mut_ptr returns null for vacant");
        m.drop();
    }

    // --- and_modify: closure-style mutation ---
    STDOUT.write_str("\n--- and_modify ---\n");
    {
        HashMap<i32, i64> m = HashMap<i32, i64>.new();
        m.insert(8, (i64)8);
        m.insert(9, (i64)9);

        HashMapEntryRef<i32, i64> e8 = m.entry(8);
        e8.and_modify(double_through_ptr);
        assert_eq_i64(m.get(8), 16, "and_modify doubled value of key 8");

        HashMapEntryRef<i32, i64> e9 = m.entry(9);
        e9.and_modify(double_through_ptr);
        assert_eq_i64(m.get(9), 18, "and_modify doubled value of key 9");

        // and_modify on vacant is a no-op.
        HashMapEntryRef<i32, i64> e404 = m.entry(404);
        e404.and_modify(double_through_ptr);
        assert_true(!m.contains_key(404), "and_modify did NOT create key 404");
        m.drop();
    }

    // --- counter pattern: counting occurrences with entry ---
    STDOUT.write_str("\n--- counter idiom ---\n");
    {
        HashMap<i32, i64> counts = HashMap<i32, i64>.new();
        i32 keys[5];
        keys[0] = 1; keys[1] = 2; keys[2] = 1; keys[3] = 3; keys[4] = 1;
        i32 i = 0;
        while (i < 5) {
            HashMapEntryRef<i32, i64> e = counts.entry(keys[i]);
            i64* p = e.or_insert((i64)0);
            *p = *p + (i64)1;
            i = i + 1;
        }
        assert_eq_i64(counts.get(1), 3, "count[1] = 3");
        assert_eq_i64(counts.get(2), 1, "count[2] = 1");
        assert_eq_i64(counts.get(3), 1, "count[3] = 1");
        assert_eq_i64(counts.len(), 3, "3 distinct keys");
        counts.drop();
    }

    return done();
}
