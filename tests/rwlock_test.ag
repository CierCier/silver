// tests/rwlock_test.ag — Test suite for RwLock<T> (writer-priority read-write lock).

import std.test;
import std.thread;
import std.atomic;
import std.sync;
import std.sys.raw.thread;
import std.sys.entry;

RwLock<i64> g_rw;
i64 g_read_matches = 0;
WaitGroup g_wg;
i64 g_readers[4];

void reader_worker(i64 _arg) {
    ReadGuard<i64> r = g_rw.read();
    if (r.get() == 100) {
        __atomic_fetch_add_i64(&g_read_matches, 1, ATOMIC_SEQ_CST);
    }
    g_wg.done();
}

void writer_worker(i64 _arg) {
    WriteGuard<i64> w = g_rw.write();
    w.set(200);
    g_wg.done();
}

i32 main() {
    STDOUT.write_str("=== RwLock Tests ===\n\n");

    // Test 1: Concurrent readers
    STDOUT.write_str("--- Test 1: Concurrent Readers ---\n");
    {
        g_rw = RwLock<i64>.new(100);
        g_read_matches = 0;
        g_wg.add(4);

        for (i64 i = 0; i < 4; i = i + 1) {
            TaskRecord* h = thread_spawn(reader_worker, 0);
            @assert(!(h == (TaskRecord*)0), "failed to spawn reader_worker");
            g_readers[i] = (i64)h;
        }

        g_wg.wait_all();
        for (i64 i = 0; i < 4; i = i + 1) {
            @assert(!(thread_join((TaskRecord*)g_readers[i]) < 0), "failed to join reader_worker");
        }

        assert_eq_i64(4, g_read_matches, "all 4 concurrent readers read correct value");
    }

    // Test 2: Exclusive Writer
    STDOUT.write_str("\n--- Test 2: Exclusive Writer ---\n");
    {
        g_wg.add(1);
        TaskRecord* hw = thread_spawn(writer_worker, 0);
        @assert(!(hw == (TaskRecord*)0), "failed to spawn writer_worker");

        g_wg.wait_all();
        @assert(!(thread_join(hw) < 0), "failed to join writer_worker");

        ReadGuard<i64> r = g_rw.read();
        assert_eq_i64(200, r.get(), "writer updated value to 200");
    }

    // Test 3: try_lock behavior
    STDOUT.write_str("\n--- Test 3: try_lock ---\n");
    {
        RawRwLock raw = RawRwLock.new();
        @assert(raw.try_read_lock(), "initial try_read_lock succeeds");
        @assert(raw.try_read_lock(), "second concurrent try_read_lock succeeds");
        @assert(!raw.try_write_lock(), "try_write_lock fails while readers hold lock");

        raw.read_unlock();
        raw.read_unlock();

        @assert(raw.try_write_lock(), "try_write_lock succeeds when unlocked");
        @assert(!raw.try_read_lock(), "try_read_lock fails while writer holds lock");
        @assert(!raw.try_write_lock(), "second try_write_lock fails while writer holds lock");

        raw.write_unlock();
        @assert(raw.try_read_lock(), "try_read_lock succeeds after write_unlock");
        raw.read_unlock();
    }

    STDOUT.write_str("\n=== All RwLock Tests Passed ===\n");
    return 0;
}
