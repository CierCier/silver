// compile_flags: --no-cache

import std.test;

// Moving one payload out of a multi-payload variant must keep the other
// payloads owned by the matched value, so each is destroyed exactly once.

i64 drops = 0;

struct Tok {
    i64 id;
}

impl Drop for Tok {
    void drop(Tok* self) {
        drops += 1;
    }
}

enum Both {
    Two(Tok, Tok);
    Empty;
}

Tok mk(i64 id) {
    Tok t;
    t.id = id;
    return move t;
}

Both make_both() {
    Tok a = mk(1);
    Tok b = mk(2);
    Both result = Both.Two(move a, move b);
    return move result;
}

i64 take_first_block(Both value) {
    Tok picked = match value {
        Two(move first, second): { first; },
        Empty: mk(9),
    };
    return picked.id;
}

i64 take_second(Both value) {
    Tok picked = match value {
        Two(first, move second): second,
        Empty: mk(9),
    };
    return picked.id;
}

i64 consumed = 0;

void consume(Tok token) {
    consumed += token.id;
}

i64 take_first_after_consuming_second(Both value) {
    Tok picked = match value {
        Two(move first, second): { consume(second); first; },
        Empty: mk(9),
    };
    return picked.id;
}

enum Single {
    One(Tok);
    Nothing;
}

Single make_single() {
    Tok a = mk(5);
    Single result = Single.One(move a);
    return move result;
}

// Each path that transfers the payload must clear the matched value's
// cleanup on its own; the later path must not rely on an earlier one.
i64 consume_on_either_path(Single value, bool flag) {
    match value {
        One(text): {
            if (flag) {
                consume(move text);
                return 1;
            }
            consume(move text);
            return 2;
        },
        Nothing: { return 0; },
    }
    return -1;
}

i64 borrow_only(Both value) {
    match value {
        Two(first, second): { return first.id + second.id; },
        Empty: { return 0; },
    }
    return -1;
}

i32 main() {
    test_start("block arm moves first, keeps second");
    {
        Both value = make_both();
        assert_eq_i64(1, take_first_block(move value), "first payload extracted");
    }
    assert_eq_i64(2, drops, "both payloads dropped once");

    test_start("plain arm moves second, keeps first");
    drops = 0;
    {
        Both value = make_both();
        assert_eq_i64(2, take_second(move value), "second payload extracted");
    }
    assert_eq_i64(2, drops, "both payloads dropped once");

    test_start("arm without move leaves cleanup to the value");
    drops = 0;
    {
        Both value = make_both();
        assert_eq_i64(3, borrow_only(move value), "payloads read");
    }
    assert_eq_i64(2, drops, "both payloads dropped once");
    test_start("payload consumed by value is not dropped again");
    drops = 0;
    {
        Both value = make_both();
        assert_eq_i64(1, take_first_after_consuming_second(move value), "first payload extracted");
    }
    assert_eq_i64(2, drops, "consumed and extracted payloads dropped once each");
    test_start("payload consumed on either branch is dropped once");
    drops = 0;
    {
        Single value = make_single();
        assert_eq_i64(2, consume_on_either_path(move value, false), "second path taken");
    }
    assert_eq_i64(1, drops, "payload dropped once on the later path");
    drops = 0;
    {
        Single value = make_single();
        assert_eq_i64(1, consume_on_either_path(move value, true), "first path taken");
    }
    assert_eq_i64(1, drops, "payload dropped once on the first path");
    return done();
}
