// Test suite for Vec<T> — contiguous growable array
import std.test;  // assert_eq_i64, assert_eq_i32, assert_true, done, STDOUT
import std.mem;
import std.string;

i32 compound_trace = 0;
i32 compound_targets = 0;
i32 compound_indices = 0;
i32 compound_rhs_calls = 0;

struct CompoundCell { i32 value; }

impl CompoundCell {
    CompoundCell __add(&self, CompoundCell other) {
        compound_trace = compound_trace * 10 + 4;
        CompoundCell result = { .value = self.value + other.value };
        return result;
    }
}

i32* compound_pointer(i32* value) {
    compound_targets = compound_targets + 1;
    compound_trace = compound_trace * 10 + 1;
    return value;
}

CompoundCell* compound_cell(CompoundCell* value) {
    compound_targets = compound_targets + 1;
    compound_trace = compound_trace * 10 + 1;
    return value;
}

Vec<i32>* compound_vec(Vec<i32>* value) {
    compound_targets = compound_targets + 1;
    compound_trace = compound_trace * 10 + 1;
    return value;
}

i64 compound_index() {
    compound_indices = compound_indices + 1;
    compound_trace = compound_trace * 10 + 2;
    return 0;
}

i32 compound_rhs() {
    compound_rhs_calls = compound_rhs_calls + 1;
    compound_trace = compound_trace * 10 + 3;
    return 3;
}

CompoundCell compound_cell_rhs() {
    CompoundCell result = { .value = compound_rhs() };
    return result;
}

CompoundCell* compound_rhs_pointer(CompoundCell* value) {
    compound_rhs_calls = compound_rhs_calls + 1;
    compound_trace = compound_trace * 10 + 3;
    return value;
}

bool test_compound_access() {
    bool correct = true;
    compound_targets = 0;
    compound_indices = 0;
    compound_rhs_calls = 0;
    compound_trace = 0;
    i32 value = 10;
    i32* value_ptr = &value;
    *compound_pointer(value_ptr) += compound_rhs();
    assert_eq_i64(value, 13, "pointer compound result");
    assert_eq_i64(compound_trace, 13, "pointer target precedes RHS once");
    correct = correct && value == 13 && compound_trace == 13;

    compound_trace = 0;
    CompoundCell cell = { .value = 10 };
    CompoundCell* cell_ptr = &cell;
    compound_cell(cell_ptr).value += compound_rhs();
    assert_eq_i64(cell.value, 13, "field compound result");
    assert_eq_i64(compound_trace, 13, "field target precedes RHS once");
    correct = correct && cell.value == 13 && compound_trace == 13;

    compound_trace = 0;
    i32 values[2];
    values[0] = 10;
    values[1] = 20;
    values[compound_index()] += compound_rhs();
    assert_eq_i64(values[0], 13, "array compound result");
    assert_eq_i64(values[1], 20, "array neighbor unchanged");
    assert_eq_i64(compound_trace, 23, "array index precedes RHS once");
    correct = correct && values[0] == 13 && values[1] == 20 && compound_trace == 23;

    compound_trace = 0;
    *compound_cell(cell_ptr) += compound_cell_rhs();
    assert_eq_i64(cell.value, 16, "overloaded compound result");
    assert_eq_i64(compound_trace, 134, "overloaded target, RHS, operator order");
    correct = correct && cell.value == 16 && compound_trace == 134;

    compound_trace = 0;
    CompoundCell other = { .value = 3 };
    CompoundCell* other_ptr = &other;
    *compound_cell(cell_ptr) += *compound_rhs_pointer(other_ptr);
    assert_eq_i64(cell.value, 19, "overloaded compound dereferenced RHS result");
    assert_eq_i64(compound_trace, 134, "overloaded RHS pointer evaluated once");
    correct = correct && cell.value == 19 && compound_trace == 134;

    compound_trace = 0;
    Vec<i32> vector = Vec<i32>.new();
    vector.push(10);
    Vec<i32>* vector_ptr = &vector;
    (*compound_vec(vector_ptr))[compound_index()] += compound_rhs();
    assert_eq_i64(vector[0], 13, "Vec compound result");
    assert_eq_i64(compound_trace, 123, "Vec receiver, index, RHS order");
    assert_eq_i64(compound_targets, 5, "compound targets evaluated once");
    assert_eq_i64(compound_indices, 2, "compound indices evaluated once");
    assert_eq_i64(compound_rhs_calls, 6, "compound RHS evaluated once");
    correct = correct && vector[0] == 13 && compound_trace == 123
        && compound_targets == 5 && compound_indices == 2 && compound_rhs_calls == 6;
    vector.drop();
    return correct;
}

i32 compound_drops = 0;

struct CompoundResource { i32 value; }
struct CompoundHolder { CompoundResource resource; }

impl Drop for CompoundResource {
    void drop(*self) { compound_drops = compound_drops + 1; }
}

impl CompoundResource {
    CompoundResource __add(&self, CompoundResource* other) {
        CompoundResource result = { .value = self.value + other.value };
        other.value = other.value + 1;
        return result;
    }
}

CompoundResource* compound_resource_rhs(CompoundResource* value) {
    compound_trace = compound_trace * 10 + 3;
    return value;
}

Vec<i32> compound_temporary_vec() {
    compound_trace = compound_trace * 10 + 1;
    Vec<i32> result = Vec<i32>.new();
    result.push(10);
    return result;
}

bool test_compound_ownership() {
    bool correct = true;
    compound_drops = 0;
    compound_trace = 0;
    {
        CompoundResource value = { .value = 10 };
        CompoundResource other = { .value = 3 };
        value += compound_resource_rhs(&other);
        assert_eq_i64(value.value, 13, "borrowed compound result");
        assert_eq_i64(other.value, 4, "compound RHS retains mutable reference");
        assert_eq_i64(compound_trace, 3, "borrowed RHS evaluated once");
        assert_eq_i64(compound_drops, 1, "compound drops overwritten local once");
        correct = correct && value.value == 13 && other.value == 4
            && compound_trace == 3 && compound_drops == 1;
    }
    assert_eq_i64(compound_drops, 3, "compound result and borrowed RHS drop once");
    correct = correct && compound_drops == 3;

    compound_drops = 0;
    {
        CompoundHolder holder;
        holder.resource.value = 10;
        CompoundResource other = { .value = 3 };
        holder.resource += &other;
        assert_eq_i64(holder.resource.value, 13, "owned field compound result");
        assert_eq_i64(compound_drops, 1, "compound drops overwritten field once");
        correct = correct && holder.resource.value == 13 && compound_drops == 1;
    }
    assert_eq_i64(compound_drops, 3, "compound field drop flags remain live");
    correct = correct && compound_drops == 3;

    {
        String text = String.from_str("a");
        text += "b";
        assert_eq_i64(text.len, 2, "by-value compound receiver result");
        assert_eq_i64(text.data[1], 98, "by-value compound receiver contents");
        correct = correct && text.len == 2 && text.data[1] == 98;
    }
    compound_trace = 0;
    compound_temporary_vec()[compound_index()] += compound_rhs();
    assert_eq_i64(compound_trace, 123, "temporary Vec receiver evaluated once before RHS");
    return correct && compound_trace == 123;
}

i32 main() {
    STDOUT.write_str("=== Vec Tests ===\n\n");
    if (!test_compound_access()) { return 1; }
    if (!test_compound_ownership()) { return 1; }

    // --- Basic new ---
    STDOUT.write_str("--- Vec.new ---\n");
    {
        Vec<i32> v = Vec<i32>.new();
        assert_eq_i64(v.len(), 0, "new vec has len 0");
        assert_eq_i64(v.capacity(), 0, "new vec has capacity 0");
        assert_true(v.is_empty(), "new vec is empty");
        v.drop();
    }

    // --- Push and grow ---
    STDOUT.write_str("\n--- Push and grow ---\n");
    {
        Vec<i32> v = Vec<i32>.new();
        i32 i = 0;
        while (i < 20) {
            v.push(i * 10);
            i = i + 1;
        }
        assert_eq_i64(v.len(), 20, "len=20 after 20 pushes");
        assert_true(v.capacity() >= 20, "capacity grew beyond 20");
        assert_true(!v.is_empty(), "not empty after pushes");

        i = 0;
        bool all_correct = true;
        while (i < 20) {
            if (v.get(i) != i * 10) {
                all_correct = false;
            }
            i = i + 1;
        }
        assert_true(all_correct, "all values correct via get");

        i = 0;
        bool ptr_correct = true;
        while (i < 20) {
            i32* ptr = v.get_ptr(i);
            if (*ptr != i * 10) {
                ptr_correct = false;
            }
            i = i + 1;
        }
        assert_true(ptr_correct, "all values correct via get_ptr");

        i = 0;
        bool index_correct = true;
        while (i < 20) {
            if (v[i] != i * 10) {
                index_correct = false;
            }
            i = i + 1;
        }
        assert_true(index_correct, "all values correct via [] getter");

        v.drop();
    }

    // --- Set and index_set ---
    STDOUT.write_str("\n--- Set and __index_set ---\n");
    {
        Vec<i32> v = Vec<i32>.new();
        v.push(1);
        v.push(2);
        v.push(3);

        v.set(1, 99);
        assert_eq_i32(v.get(1), 99, "set updates index 1 to 99");
        assert_eq_i32(v.get(0), 1, "index 0 unchanged after set");
        assert_eq_i32(v.get(2), 3, "index 2 unchanged after set");

        v[1] = 200;
        assert_eq_i32(v.get(1), 200, "__index_set updates index 1 to 200");
        assert_eq_i32(v.get(0), 1, "index 0 unchanged after __index_set");
        assert_eq_i32(v.get(2), 3, "index 2 unchanged after __index_set");

        v.drop();
    }

    // --- Pop ---
    STDOUT.write_str("\n--- Pop ---\n");
    {
        Vec<i32> v = Vec<i32>.new();
        v.push(10);
        v.push(20);
        v.push(30);
        assert_eq_i64(v.len(), 3, "len=3 before pop");
        assert_eq_i32(v.pop(), 30, "pop returns 30");
        assert_eq_i64(v.len(), 2, "len=2 after pop");
        assert_eq_i32(v.pop(), 20, "pop returns 20");
        assert_eq_i64(v.len(), 1, "len=1 after second pop");
        assert_eq_i32(v.pop(), 10, "pop returns 10");
        assert_eq_i64(v.len(), 0, "len=0 after third pop");

        v.drop();
    }

    // --- Reserve ---
    STDOUT.write_str("\n--- Reserve ---\n");
    {
        Vec<i32> v = Vec<i32>.new();
        v.push(1);
        v.push(2);
        v.push(3);
        i64 old_len = v.len();

        v.reserve(64);
        assert_true(v.capacity() >= 64, "capacity >= 64 after reserve(64)");
        assert_eq_i64(v.len(), old_len, "len unchanged after reserve");
        assert_eq_i32(v.get(0), 1, "value at 0 preserved after reserve");
        assert_eq_i32(v.get(2), 3, "value at 2 preserved after reserve");

        v.drop();
    }

    // --- Clear ---
    STDOUT.write_str("\n--- Clear ---\n");
    {
        Vec<i32> v = Vec<i32>.new();
        v.push(10);
        v.push(20);
        v.push(30);
        i64 old_cap = v.capacity();

        v.clear();
        assert_eq_i64(v.len(), 0, "len=0 after clear");
        assert_eq_i64(v.capacity(), old_cap, "capacity unchanged after clear");
        assert_true(v.is_empty(), "is_empty after clear");

        // Can push again after clear
        v.push(99);
        assert_eq_i32(v.get(0), 99, "can push after clear");
        assert_eq_i64(v.len(), 1, "len=1 after clear and push");

        v.drop();
    }

    // --- Vec<f64> smoke test ---
    STDOUT.write_str("\n--- Vec<f64> ---\n");
    {
        Vec<f64> v = Vec<f64>.new();
        v.push(3.14);
        v.push(2.718);
        assert_eq_i64(v.len(), 2, "f64 vec len=2 after 2 pushes");

        v.drop();
    }

    // --- Vec<i32*> pointer storage ---
    STDOUT.write_str("\n--- Vec<i32*> pointer storage ---\n");
    {
        Vec<i32*> v = Vec<i32*>.new();
        i32* p1 = alloc<i32>();
        *p1 = 42;
        i32* p2 = alloc<i32>();
        *p2 = 99;
        v.push(p1);
        v.push(p2);

        i32* r1 = v.get(0);
        i32* r2 = v.get(1);
        assert_eq_i32(*r1, 42, "pointer value 42 via get");
        assert_eq_i32(*r2, 99, "pointer value 99 via get");

        free(p1);
        free(p2);
        v.drop();
    }
    // --- swap, swap_remove, reverse, try_pop ---
    STDOUT.write_str("\n--- swap, swap_remove, reverse, try_pop ---\n");
    {
        Vec<i64> v = Vec<i64>.new();
        v.push(10);
        v.push(20);
        v.push(30);
        v.push(40);

        // swap 0 and 3 -> [40, 20, 30, 10]
        v.swap(0, 3);
        assert_eq_i64(40, v[0], "v[0] is 40 after swap");
        assert_eq_i64(10, v[3], "v[3] is 10 after swap");

        // reverse -> [10, 30, 20, 40]
        v.reverse();
        assert_eq_i64(10, v[0], "v[0] is 10 after reverse");
        assert_eq_i64(30, v[1], "v[1] is 30 after reverse");
        assert_eq_i64(20, v[2], "v[2] is 20 after reverse");
        assert_eq_i64(40, v[3], "v[3] is 40 after reverse");

        // swap_remove(1) -> removes 30, swaps in 40 -> [10, 40, 20], len=3
        i64 rem = v.swap_remove(1);
        assert_eq_i64(30, rem, "swap_remove returned 30");
        assert_eq_i64(3, v.len(), "len is 3 after swap_remove");
        assert_eq_i64(40, v[1], "v[1] is 40 after swap_remove");

        // try_pop -> 20, 40, 10, None
        assert_eq_i64(20, v.try_pop().unwrap(), "try_pop 20");
        assert_eq_i64(40, v.try_pop().unwrap(), "try_pop 40");
        assert_eq_i64(10, v.try_pop().unwrap(), "try_pop 10");
        assert_true(v.try_pop().is_none(), "try_pop is none when empty");

        v.drop();
    }

    return done();
}
