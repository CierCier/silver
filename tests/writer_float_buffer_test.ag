// compile_flags: --no-cache --leak-check
import std.io.file;

i32 main() {
    u8 scratch[64];
    BufWriter writer = {
        .data = (i64)&scratch[0], .len = 0, .cap = -64, .fd = -1,
        .list_next = (BufWriter*)0, .list_prev = (BufWriter*)0,
        .mode = IOMODE_MEMORY
    };
    u64 large_bits = (u64)6103021453049119613;
    f64 large = *(f64*)&large_bits;
    writer.write_f64(large);
    if (writer.len != 101) { return 1; }
    u8* data = (u8*)writer.data;
    if (data[0] != (u8)'1') { return 2; }
    for (i64 i = 1; i < writer.len; i += 1) {
        if (data[i] != (u8)'0') { return 3; }
    }
    writer.len = 0;
    u64 bits = (u64)9223372036854775809;
    f64 small = *(f64*)&bits;
    writer.write_f64(small);
    if (writer.len != 327) { return 4; }
    data = (u8*)writer.data;
    if (data[0] != (u8)'-' || data[1] != (u8)'0'
        || data[2] != (u8)'.' || data[326] != (u8)'5') { return 5; }
    for (i64 i = 3; i < 326; i += 1) {
        if (data[i] != (u8)'0') { return 6; }
    }
    return 0;
}
