// Multi-dimensional global arrays preserve declarator dimension order and
// recursively flatten flat, nested, and partial constant initializers.

i32 flat_global[2][3] = {1, 2, 3, 4, 5, 6};
i32 nested_global[2][3] = {{7, 8, 9}, {10, 11, 12}};
i32 partial_global[2][3] = {13};
i32 cube_global[2][2][2] = {14, 15, 16, 17, 18, 19, 20, 21};

i32 main() {
    i32* flat = (i32*)&flat_global;
    i32* nested = (i32*)&nested_global;
    i32* partial = (i32*)&partial_global;
    i32* cube = (i32*)&cube_global;
    i32 local_nested[2][3] = {{22, 23, 24}, {25, 26, 27}};
    i32* local = (i32*)&local_nested;
    if (flat[0] != 1 || flat[5] != 6
        || nested[0] != 7 || nested[5] != 12
        || partial[0] != 13 || partial[1] != 0 || partial[5] != 0
        || cube[0] != 14 || cube[7] != 21
        || local[0] != 22 || local[5] != 27) {
        return 1;
    }
    return 0;
}
