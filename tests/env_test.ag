import std.env;
import std.test;
import std.string;
import std.optional;
import std.mem.vec;

i32 main() {
    test_start("std.env: environment and process info");

    // Test 1: Lookup standard environment variable (PATH is always set in linux/unix environments)
    Optional<String> path_opt = var("PATH");
    assert_true(path_opt.is_some(), "var('PATH') is some");
    if (path_opt.is_some()) {
        String path_val = path_opt.unwrap();
        assert_true(path_val.len() > 0, "PATH length > 0");
        path_val.drop();
    }

    // Test 2: Lookup non-existent variable
    Optional<String> missing = var("__SILVER_NON_EXISTENT_VAR_12345__");
    assert_true(missing.is_none(), "non-existent variable is none");

    // Test 3: Current directory
    String cwd = current_dir();
    assert_true(cwd.len() > 0, "current_dir is not empty");
    // WASI has no getcwd: the seam reports "." (the preopened working dir).
    if (@cfg(os.wasi)) {
        assert_true(cwd.equals("."), "current_dir is . on wasm");
    } else if (@cfg(os.windows)) {
        // Drive-absolute ("C:\...") or UNC ("\\server\...").
        bool drive = cwd.len() >= 3 && cwd.data[1] == (u8)':' && cwd.data[2] == (u8)'\\';
        assert_true(drive || cwd.starts_with("\\\\"), "current_dir is absolute");
    } else {
        assert_true(cwd.starts_with("/"), "current_dir starts with /");
    }
    cwd.drop();

    // Test 4: Command-line arguments
    Vec<String> argv = args();
    assert_true(argv.len() >= 1, "argv has at least program name");
    argv.drop();

    // Test 5: set_var and remove_var
    set_var("__SILVER_DYNAMIC_TEST_VAR__", "dynamic_value_123");
    Optional<String> dyn_val = var("__SILVER_DYNAMIC_TEST_VAR__");
    assert_true(dyn_val.is_some(), "dynamic var is some after set_var");
    if (dyn_val.is_some()) {
        String s = dyn_val.unwrap();
        assert_true(s.equals("dynamic_value_123"), "dynamic var matches set value");
        s.drop();
    }
    if (@cfg(os.windows)) {
        // Windows variable names are case-insensitive, as in the OS.
        Optional<String> folded = var("__silver_dynamic_test_var__");
        assert_true(folded.is_some(), "var lookup folds case on windows");
        set_var("__Silver_Dynamic_Test_Var__", "replaced");
        Optional<String> replaced = var("__SILVER_DYNAMIC_TEST_VAR__");
        assert_true(replaced.is_some() && replaced.unwrap().equals("replaced"),
            "set_var replaces a differently-cased name on windows");
    }
    remove_var("__SILVER_DYNAMIC_TEST_VAR__");
    Optional<String> rem_val = var("__SILVER_DYNAMIC_TEST_VAR__");
    assert_true(rem_val.is_none(), "dynamic var is none after remove_var");

    return done();
}
