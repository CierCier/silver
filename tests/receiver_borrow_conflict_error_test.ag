// A mutable method receiver overlaps a live shared borrow of its receiver.

struct Counter {
    i64 value;
}

impl Counter {
    void bump(&mut Counter self) {
        self.value = self.value + 1;
    }
}

i64 main() {
    Counter counter;
    &Counter shared = &counter;
    counter.bump();
    return shared.value;
}
