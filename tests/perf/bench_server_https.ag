// tests/perf/bench_server_https.ag — Apache Bench (ab) target for the std
// HTTPS server (std.net.http HttpServer.serve_tls_conn over std.net.tls).
//
// Same acceptor-pool model as bench_server_http.ag: MAX_THREADS workers all
// blocked in accept(), each owning a private HttpServer; every connection
// gets a fresh OpenSSL SSL object via transport_tls_accept (SSL_new per
// connection), so concurrent handshakes share no mutable state.
//
//   ./target/debug/agc -O2 tests/perf/bench_server_https.ag -o /tmp/bench_https
//   (run from the repo root: the cert path is relative)
//   /tmp/bench_https &
//   ab -k -n 20000 -c 8 https://127.0.0.1:18443/plaintext

import std.error;
import std.net.http;
import std.net.inet;
import std.net.tcp;
import std.net.tls;
import std.sys.entry;
import std.sys.raw.misc;
import std.sys.raw.process;
import std.thread;

const i64 BENCH_PORT = 18443;
const i64 N_WORKERS = 63; // + main thread = 64 (thread registry ceiling)

struct SigAction {
    i64 handler;
    i64 flags;
    i64 restorer;
    i64 mask;
}

void ignore_sigpipe() {
    SigAction act;
    act.handler = 1; // SIG_IGN
    act.flags = 0;
    act.restorer = 0;
    act.mask = 0;
    sys_rt_sigaction(13, (i64)&act, 0, 8);
}

void handle_plaintext(ResponseWriter* w, HttpRequest* _r) {
    w.set_header("Content-Type", "text/plain");
    w.write_header(200);
    w.write_str("Hello, World!");
}

void tls_acceptor_worker(i64 arg) {
    i32 lfd = (i32)arg;
    TcpListener listener = TcpListener.from_fd(lfd);
    HttpServer s = HttpServer.new("127.0.0.1:18443");
    // Default idle timeout is 50ms; a shared-CI sandbox can deschedule the
    // client longer than that, closing the connection mid-benchmark (RST).
    s.set_keep_alive_timeout_ms(5000);
    s.get("/plaintext", handle_plaintext);

    while (true) {
        Result<i64, Error> a = listener.accept();
        match a {
            Ok(fd) : {
                TcpStream stream = TcpStream.from_fd((i32)fd);
                stream.set_nodelay(true);
                s.serve_tls_conn(move stream, "tests/certs/server.pem", "tests/certs/server.pem");
            },
            Err(e) : { continue; },
        };
    }
}

i32 main() {
    ignore_sigpipe();
    tls_init();

    Result<SocketAddr, AddrError> br = SocketAddr.v4("127.0.0.1", (u16)BENCH_PORT);
    if (br.failed()) {
        @eprintln("bad bind addr");
        return 1;
    }
    SocketAddr addr = br.unwrap();
    TcpListener listener = TcpListener.bind(&addr, 512);
    if (!listener.valid()) {
        @eprintln("bind failed on port {}", BENCH_PORT);
        return 1;
    }
    @println("bench_server_https: listening on https://127.0.0.1:{}", BENCH_PORT);

    i64 lfd = listener.take_fd();
    i64 spawned = 0;
    while (spawned < N_WORKERS) {
        TaskRecord* h = thread_spawn(tls_acceptor_worker, lfd);
        if (h == (TaskRecord*)0) { break; }
        spawned = spawned + 1;
    }
    @println("bench_server_https: {} acceptor workers", spawned);

    tls_acceptor_worker(lfd);
    return 0;
}
