// tests/mem_intrinsics_test.ag — SIMD memory intrinsics.
//
// strlen (SSE2 pcmpeqb), memcmp (16-byte blocks), memmove (forward and
// backward SIMD overlap copies) and memcpy/memset. run_tests.sh compiles
// every test with the cpu.* cfg flags, so the SIMD paths are live here;
// buffers are heap-allocated (above 4GB) to exercise full-width pointers.

import std.mem.alloc;
import std.mem.memory;
import std.sys.entry;

i32 main() {
    // strlen
    str s = "hello world, this is a fairly long string for testing purposes!";
    i64 l = strlen(s);
    STDOUT.write_str("strlen=");
    STDOUT.write_i64(l);
    STDOUT.write_str("\n");
    if (l != 63) { return 1; }
    if (strlen("") != 0) { return 2; }
    if (strlen("x") != 1) { return 3; }
    // strcmp
    if (strcmp("abc", "abc") != 0) { return 4; }
    if (strcmp("abc", "abd") >= 0) { return 5; }
    if (strcmp("abd", "abc") <= 0) { return 6; }
    if (strcmp("abc", "abcd") >= 0) { return 7; }
    // memcmp equal + differing
    if (memcmp((const void*)"abcdefghijklmnopqrstuvwxyz", (const void*)"abcdefghijklmnopqrstuvwxyz", 26) != 0) { return 8; }
    if (memcmp((const void*)"abcdefghijklmnopqrstuvwxyz", (const void*)"abcdefghijklmnopqrstuvwxYz", 26) <= 0) { return 9; }
    // memcmp on malloc'd buffers (page-edge safety)
    i64 N = 4096 * 8;
    u8* a = (u8*)malloc(N);
    u8* b = (u8*)malloc(N);
    i64 i = 0;
    while (i < N) { a[i] = (u8)(i % 251); b[i] = a[i]; i = i + 1; }
    if (memcmp(a, b, N) != 0) { return 10; }
    a[N - 100] = (u8)(a[N - 100] + 1);
    if (memcmp(a, b, N) <= 0) { return 11; }

    // memmove forward + backward overlap
    u8* buf = (u8*)malloc(4096);
    i = 0;
    while (i < 4096) { buf[i] = (u8)(i % 7); i = i + 1; }
    // forward: shift right by 100
    memmove((u8*)((i64)buf + 100), buf, 3000);
    i = 0;
    while (i < 3000) { if (buf[100 + i] != (u8)(i % 7)) { return 12; } i = i + 1; }
    // backward: shift left by 50
    memmove((u8*)((i64)buf + 50), (u8*)((i64)buf + 150), 2000);
    i = 0;
    while (i < 2000) { if (buf[50 + i] != (u8)((50 + i) % 7)) { return 13; } i = i + 1; }
    STDOUT.write_str("all intrinsics ok\n");
    return 0;
}
