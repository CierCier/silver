// tests/mem_intrinsics_test.ag — SIMD memory intrinsics.
//
// strlen (SSE2 pcmpeqb), memcmp (16-byte blocks), memmove (forward and
// backward SIMD overlap copies) and memcpy/memset. run_tests.sh compiles
// every test with the cpu.* cfg flags, so the SIMD paths are live here;
// buffers are heap-allocated (above 4GB) to exercise full-width pointers.

import std.mem.alloc;
import std.mem.memory;
import std.string;
import std.sys.entry;

i32 main() {
    // strlen
    str s = "hello world, this is a fairly long string for testing purposes!";
    i64 l = strlen(s);
    STDOUT.write_str("strlen=");
    STDOUT.write_i64(l);
    STDOUT.write_str("\n");
    @assert(!(l != 63), "l != 63");
    @assert(!(strlen("") != 0), "check");
    @assert(!(strlen("x") != 1), "check");
    // strcmp
    @assert(!(strcmp("abc", "abc") != 0), "check");
    @assert(!(strcmp("abc", "abd") >= 0), "check");
    @assert(!(strcmp("abd", "abc") <= 0), "check");
    @assert(!(strcmp("abc", "abcd") >= 0), "check");
    // memcmp equal + differing
    @assert(!(memcmp((const void*)"abcdefghijklmnopqrstuvwxyz", (const void*)"abcdefghijklmnopqrstuvwxyz", 26) != 0), "check");
    @assert(!(memcmp((const void*)"abcdefghijklmnopqrstuvwxyz", (const void*)"abcdefghijklmnopqrstuvwxYz", 26) <= 0), "check");
    // memcmp on malloc'd buffers (page-edge safety)
    i64 N = 4096 * 8;
    u8* a = (u8*)malloc(N);
    u8* b = (u8*)malloc(N);
    i64 i = 0;
    while (i < N) { a[i] = (u8)(i % 251); b[i] = a[i]; i = i + 1; }
    @assert(!(memcmp(a, b, N) != 0), "memcmp(a, b, N) != 0");
    a[N - 100] = (u8)(a[N - 100] + 1);
    @assert(!(memcmp(a, b, N) <= 0), "memcmp(a, b, N) <= 0");

    // memmove forward + backward overlap
    u8* buf = (u8*)malloc(4096);
    i = 0;
    while (i < 4096) { buf[i] = (u8)(i % 7); i = i + 1; }
    // forward: shift right by 100
    memmove((u8*)((i64)buf + 100), buf, 3000);
    i = 0;
    while (i < 3000) { @assert(!(buf[100 + i] != (u8)(i % 7)), "buf[100 + i] != (u8)(i % 7)"); i = i + 1; }
    // backward: shift left by 50
    memmove((u8*)((i64)buf + 50), (u8*)((i64)buf + 150), 2000);
    i = 0;
    while (i < 2000) { @assert(!(buf[50 + i] != (u8)((50 + i) % 7)), "buf[50 + i] != (u8)((50 + i) % 7)"); i = i + 1; }
    // mem_find_byte: first occurrence, absent, heap buffer above 4GB near the end.
    @assert(!(mem_find_byte((u8*)"hello world", (u8)'w', 11) != 6), "check");
    @assert(!(mem_find_byte((u8*)"hello world", (u8)'x', 11) != -1), "check");
    @assert(!(mem_find_byte((u8*)"abcabc", (u8)'b', 6) != 1), "check");
    u8* hay = (u8*)malloc(4096 * 8);
    i = 0;
    while (i < 4096 * 8) { hay[i] = (u8)'a'; i = i + 1; }
    hay[4096 * 8 - 3] = (u8)'Z';
    @assert(!(mem_find_byte(hay, (u8)'Z', 4096 * 8) != 4096 * 8 - 3), "mem_find_byte(hay, (u8)'Z', 4096 * 8) != 4096 * 8 - 3");
    @assert(!(memchr(hay, (i32)'Z', 4096 * 8) != (u8*)((i64)hay + 4096 * 8 - 3)), "memchr pointer match");
    @assert(!(memchr(hay, (i32)'?', 4096 * 8) != (u8*)0), "memchr null when absent");

    // String single-byte search fast paths (SSE2 memchr).
    String q = String.from_str("the quick brown fox");
    @assert(!(!q.contains("q")), "check");
    @assert(!(q.contains("z")), "check");
    @assert(!(q.find("q") != 4), "check");
    @assert(!(q.find("brown") != 10), "check");
    @assert(!(q.find("zz") != -1), "check");
    String t = String.from_str("aaaaab");
    @assert(!(t.find("b") != 5), "check");

    STDOUT.write_str("all intrinsics ok\n");
    return 0;
}
