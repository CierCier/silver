// tests/net_test.ag — Integration tests for std/net/tcp.ag and std/net/inet.ag.
//
// Tests: TCP echo (bind, connect, accept, send, recv) and connection refused.

import std.error;
import std.net.tcp;
import std.net.inet;
import std.sys.result;
import std.mem;
import std.test;

i32 main() {
    // Test A: TCP echo
    test_start("tcp echo");
    Result<SocketAddr, AddrError> bind_result =
        SocketAddr.v4("127.0.0.1", (u16)0);
    assert_true(bind_result.success(), "bind address valid");
    SocketAddr bind_addr = bind_result.unwrap();
    TcpListener listener = TcpListener.bind(&bind_addr, 1);
    assert_true(listener.valid(), "listener bind ok");
    SockAddrIn sa;
    u32 len = 16;
    Result<i64, Error> gn = try_getsockname(listener.raw_fd(), (void*)&sa, &len);
    assert_true(gn.is_ok(), "getsockname ok");
    Result<SocketAddr, AddrError> conn_result =
        SocketAddr.v4("127.0.0.1", ntoh16(sa.sin_port));
    assert_true(conn_result.success(), "connect address valid");
    SocketAddr conn_addr = conn_result.unwrap();
    Result<TcpStream, Error> client_result = TcpStream.connect(&conn_addr);
    assert_true(client_result.success(), "connect ok");
    TcpStream client = client_result.unwrap();
    Result<i64, Error> w = client.write((u8*)"hello", 5);
    assert_true(w.is_ok(), "write ok");
    assert_eq_i64(5, w.value(), "wrote 5 bytes");
    Result<i64, Error> a = listener.accept();
    assert_true(a.is_ok(), "accept ok");
    TcpStream server = TcpStream.from_fd((i32)a.value());
    u8* msg = alloc<u8>(8);
    Result<i64, Error> r = server.read(msg, 7);
    assert_true(r.is_ok(), "read ok");
    assert_eq_i64(5, r.value(), "read 5 bytes");
    msg[r.value()] = (u8)0;
    assert_eq_str("hello", (str)msg, "echo message matches");
    free(msg);

    // Test B: connection refused
    test_start("tcp connect refused");
    Result<SocketAddr, AddrError> refused_result =
        SocketAddr.v4("127.0.0.1", (u16)9999);
    assert_true(refused_result.success(), "refused address valid");
    SocketAddr refused_addr = refused_result.unwrap();
    Result<TcpStream, Error> refused = TcpStream.connect(&refused_addr);
    assert_true(refused.failed(), "connect refused returns error");
    Error refused_err = refused.get_error();
    assert_eq_i64(refused_err.code, ECONNREFUSED, "refused errno");

    return done();
}
