import std.test;

[T, T] make_pair<T>(T first, T second) {
    return [first, second];
}

i32 main() {
    [i32, i32] small = make_pair((i32)17, (i32)25);
    let [small_first, small_second] = small;
    assert_eq_i32(small_first, 17, "generic tuple return keeps first i32");
    assert_eq_i32(small_second, 25, "generic tuple return keeps second i32");

    [i64, i64] wide = make_pair((i64)10000000001, (i64)10000000009);
    let [wide_first, wide_second] = wide;
    assert_eq_i64(wide_first, 10000000001, "generic tuple return keeps first i64");
    assert_eq_i64(wide_second, 10000000009, "generic tuple return keeps second i64");
    return done();
}
