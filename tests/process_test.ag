import std.test;
import std.process;
import std.sys.raw.process;
import std.mem.vec;
import std.slice;

void bounds_child(i32 container, i32 operation, i64 index, bool empty) {
    i32 array[3] = {10, 20, 30};
    Vec<i32> vec = Vec<i32>.new();
    if (!empty) { vec.push(10); vec.push(20); vec.push(30); }
    Slice<i32> slice = Slice<i32>.from_raw(&array[0], empty ? 0 : 3);
    if (container == 0) {
        if (operation == 0) { exit(array[index]); }
        if (operation == 1) { array[index] = 41; }
        if (operation == 2) { array[index] += 1; }
        if (operation == 3) { i32* p = &array[index]; exit(*p); }
    } else if (container == 1) {
        if (operation == 0) { exit(slice[index]); }
        if (operation == 1) { slice[index] = 41; }
        if (operation == 2) { slice[index] += 1; }
        if (operation == 3) { exit(*slice.get_ptr(index)); }
    } else {
        if (operation == 0) { exit(vec[index]); }
        if (operation == 1) { vec[index] = 41; }
        if (operation == 2) { vec[index] += 1; }
        if (operation == 3) { exit(*vec.get_ptr(index)); }
    }
    exit(42);
}

void array_boundary_child(i32 boundary) {
    i32 array[1] = {17};
    i8 negative = -1;
    u64 high = (u64)0x8000000000000000;
    u128 wide = (u128)1 << 64;
    i128 low = -((i128)1 << 64);
    if (boundary == 0) { exit(array[negative]); }
    if (boundary == 1) { exit(array[high]); }
    if (boundary == 2) { exit(array[wide]); }
    if (boundary == 3) { exit(array[low]); }
    exit(42);
}

i32* compound_fail_target() {
    exit(23);
    return (i32*)0;
}

i64 compound_fail_index() {
    exit(23);
    return 0;
}

i32 compound_forbidden_rhs() {
    exit(24);
    return 1;
}

i32 main() {
    test_start("native process management");

    // 1. Process identity
    i64 pid = getpid();
    assert_true(pid > 0, "getpid returns positive pid");
    i64 ppid = getppid();
    assert_true(ppid > 0, "getppid returns positive ppid");

    // 2. Command spawn and wait: success case
    Command cmd_true = Command.new("/usr/bin/env");
    cmd_true.arg("sh");
    cmd_true.arg("-c");
    cmd_true.arg("exit 0");
    Result<Child, i64> r1 = cmd_true.spawn();
    assert_true(r1.is_ok(), "spawn sh exit 0 succeeds");
    Child c1 = r1.unwrap();
    assert_true(c1.id() > 0, "child pid is positive");
    ExitStatus st1 = c1.wait_status();
    assert_true(st1.exited, "c1 exited normally");
    assert_true(st1.success(), "c1 status success");
    assert_eq_i32(0, st1.exit_code(), "c1 exit code is 0");

    // 3. Command spawn and wait: exit code 42
    Command cmd_42 = Command.new("/usr/bin/env");
    cmd_42.arg("sh");
    cmd_42.arg("-c");
    cmd_42.arg("exit 42");
    Result<Child, i64> r2 = cmd_42.spawn();
    assert_true(r2.is_ok(), "spawn sh exit 42 succeeds");
    Child c2 = r2.unwrap();
    ExitStatus st2 = c2.wait_status();
    assert_true(st2.exited, "c2 exited normally");
    assert_true(!st2.success(), "c2 status not success");
    assert_eq_i32(42, st2.exit_code(), "c2 exit code is 42");

    // 4. Command status shorthand
    Command cmd_shorthand = Command.new("/usr/bin/env");
    cmd_shorthand.arg("sh");
    cmd_shorthand.arg("-c");
    cmd_shorthand.arg("exit 7");
    Result<ExitStatus, i64> r3 = cmd_shorthand.status();
    assert_true(r3.is_ok(), "cmd.status() succeeds");
    ExitStatus st3 = r3.unwrap();
    assert_eq_i32(7, st3.exit_code(), "cmd.status() exit code is 7");

    // 5. Non-existent binary fails with exit code 127
    Command cmd_none = Command.new("/bin/nonexistent_command_xyz_12345");
    Result<ExitStatus, i64> r4 = cmd_none.status();
    assert_true(r4.is_ok(), "exec of nonexistent binary spawns and exits 127");
    assert_eq_i32(127, r4.unwrap().exit_code(), "nonexistent binary exits 127");

    test_start("compound target failure stops evaluation");
    for (i32 mode = 0; mode < 2; mode = mode + 1) {
        i64 child_pid = sys_fork();
        assert_true(child_pid >= 0, "fork compound failure child");
        if (child_pid < 0) { return 1; }
        if (child_pid == 0) {
            if (mode == 0) {
                *compound_fail_target() += compound_forbidden_rhs();
            } else {
                i32 values[1];
                values[0] = 10;
                values[compound_fail_index()] += compound_forbidden_rhs();
            }
            exit(25);
        }
        if (child_pid > 0) {
            Child child;
            child.pid = child_pid;
            ExitStatus status = child.wait_status();
            assert_true(status.exited, "compound failure child exits normally");
            assert_eq_i32(status.exit_code(), 23, "target or index exits before RHS and store");
            if (!status.exited || status.exit_code() != 23) { return 1; }
        }
    }

    for (i32 container = 0; container < 3; container += 1) {
        for (i32 operation = 0; operation < 4; operation += 1) {
            for (i32 boundary = 0; boundary < 3; boundary += 1) {
                if (container == 0 && boundary == 2) { continue; }
                i64 child_pid = sys_fork();
                assert_true(child_pid >= 0, "fork bounds child");
                if (child_pid < 0) { return 1; }
                if (child_pid == 0) {
                    bounds_child(container, operation, boundary == 0 ? -1 : (boundary == 1 ? 3 : 0), boundary == 2);
                } else if (child_pid > 0) {
                    Child child;
                    child.pid = child_pid;
                    ExitStatus status = child.wait_status();
                    assert_eq_i32(status.termsig(), 6, "invalid public access aborts with SIGABRT");
                    if (status.termsig() != 6) { return 1; }
                }
            }
        }
    }
    for (i32 boundary = 0; boundary < 4; boundary += 1) {
        i64 child_pid = sys_fork();
        assert_true(child_pid >= 0, "fork array boundary child");
        if (child_pid < 0) { return 1; }
        if (child_pid == 0) { array_boundary_child(boundary); }
        Child child;
        child.pid = child_pid;
        ExitStatus status = child.wait_status();
        assert_eq_i32(6, status.termsig(), "wide and negative array access aborts");
        if (status.termsig() != 6) { return 1; }
    }
    return done();
}
