// tests/compound_bitwise_test.ag — Comprehensive test for bitwise compound assignment operators:
// &=, |=, ^=, <<=, >>= for both primitives and custom struct types.

import std.io;
import std.sys.entry;
import std.test;
import std.ops;

struct Flags {
    u32 val;
}

impl Flags {
    Flags __bitand(Flags self, Flags other) {
        Flags r;
        r.val = self.val & other.val;
        return r;
    }
    Flags __bitor(Flags self, Flags other) {
        Flags r;
        r.val = self.val | other.val;
        return r;
    }
    Flags __bitxor(Flags self, Flags other) {
        Flags r;
        r.val = self.val ^ other.val;
        return r;
    }
    Flags __shl(Flags self, u32 shift) {
        Flags r;
        r.val = self.val << shift;
        return r;
    }
    Flags __shr(Flags self, u32 shift) {
        Flags r;
        r.val = self.val >> shift;
        return r;
    }
}

i32 main() {
    test_start("primitive bitwise compound assignments");
    {
        i32 a = 0b1111_0000;
        a &= 0b1010_1010;
        assert_eq_i32(0b1010_0000, a, "i32 &=");

        a |= 0b0000_0101;
        assert_eq_i32(0b1010_0101, a, "i32 |=");

        a ^= 0b1111_1111;
        assert_eq_i32(0b0101_1010, a, "i32 ^=");

        i64 b = 1;
        b <<= 10;
        assert_eq_i64(1024, b, "i64 <<=");

        b >>= 3;
        assert_eq_i64(128, b, "i64 >>=");
    }

    test_start("signed vs unsigned right shift semantics");
    {
        // Signed arithmetic right shift preserves sign bit
        i32 neg = -16;
        neg >>= 2;
        assert_eq_i32(-4, neg, "i32 negative right shift preserves sign");

        // Unsigned logical right shift fills with zeros
        u32 u = 0x8000_0000;
        u >>= 4;
        assert_eq_u64((u64)0x0800_0000, (u64)u, "u32 unsigned right shift zero fills");
    }

    test_start("loop accumulation with bitwise compound assignments");
    {
        u32 mask = 0;
        u32 i = 0;
        while (i < 8) {
            mask |= (1 << i);
            i += 1;
        }
        assert_eq_u64(255, (u64)mask, "loop accumulation with |=");

        // Clear even bits using &=
        mask &= 0b1010_1010;
        assert_eq_u64(0b1010_1010, (u64)mask, "bit clearing with &=");

        // Toggle bits with ^=
        mask ^= 0b1111_1111;
        assert_eq_u64(0b0101_0101, (u64)mask, "bit toggling with ^=");
    }

    test_start("custom struct bitwise compound assignment overloading");
    {
        Flags f;
        f.val = 0b1100;
        Flags mask;
        mask.val = 0b1010;

        f &= mask;
        assert_eq_u64(0b1000, (u64)f.val, "custom struct &=");

        Flags bit;
        bit.val = 0b0001;
        f |= bit;
        assert_eq_u64(0b1001, (u64)f.val, "custom struct |=");

        Flags toggle;
        toggle.val = 0b1111;
        f ^= toggle;
        assert_eq_u64(0b0110, (u64)f.val, "custom struct ^=");

        f <<= 2;
        assert_eq_u64(0b01_1000, (u64)f.val, "custom struct <<=");

        f >>= 3;
        assert_eq_u64(0b0011, (u64)f.val, "custom struct >>=");
    }

    test_start("custom struct binary bitwise operations");
    {
        Flags a;
        a.val = 0b1100;
        Flags b;
        b.val = 0b1010;

        Flags and_res = a & b;
        assert_eq_u64(0b1000, (u64)and_res.val, "custom struct binary &");

        Flags or_res = a | b;
        assert_eq_u64(0b1110, (u64)or_res.val, "custom struct binary |");

        Flags xor_res = a ^ b;
        assert_eq_u64(0b0110, (u64)xor_res.val, "custom struct binary ^");

        Flags shl_res = a << 2;
        assert_eq_u64(0b11_0000, (u64)shl_res.val, "custom struct binary <<");

        Flags shr_res = a >> 2;
        assert_eq_u64(0b0011, (u64)shr_res.val, "custom struct binary >>");
    }

    test_start("compound bitwise assignments on complex lvalues");
    {
        u32 arr[3];
        arr[0] = 0b1111;
        arr[1] = 0b1010;
        arr[2] = 0b0101;
        arr[1] &= 0b1100;
        assert_eq_u64(0b1000, (u64)arr[1], "array element &=");

        arr[2] |= 0b1010;
        assert_eq_u64(0b1111, (u64)arr[2], "array element |=");

        arr[0] ^= 0b0011;
        assert_eq_u64(0b1100, (u64)arr[0], "array element ^=");

        u32 target = 0b1100;
        u32* p = &target;
        (*p) &= 0b1010;
        assert_eq_u64(0b1000, (u64)target, "dereferenced pointer &=");
    }

    return done();
}

