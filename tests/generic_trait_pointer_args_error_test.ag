// compile_flags: --no-cache
// error_contains: View
trait View<T> {}
struct Bag<T> { T value; }
impl<T> View<T*> for Bag<T> {}
struct Methods { i32 unused; }
impl Methods {
    i32 probe<T: View<i64*>>(&self, T _value) { return 0; }
}

i32 main() {
    Methods methods;
    Bag<i32> bag = { .value = 1 };
    return methods.probe(bag);
}
