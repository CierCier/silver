// Void-valued match arms still branch to the selected arm and merge cleanly.

i64 observed = 0;

void record(i64 value) {
    observed = value;
}

i64 main() {
    i64 key = 2;
    match key {
        1 : record(1),
        2 : record(2),
        _ : record(3),
    };

    if (observed != 2) { return 1; }

    return 0;
}
