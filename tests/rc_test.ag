// Test suite for Rc<T> — reference-counted smart pointer
// Uses the public Rc API (new/clone/get/drop) against the co-allocated
// RcBox<T> { count, value } layout.
import std.test;  // assert_true, assert_eq_i32, done, STDOUT
import std.mem;

i32 main() {
    STDOUT.write_str("=== Rc Test Suite ===\n\n");

    // Test 1: Rc.new with primitive
    STDOUT.write_str("--- Test 1: Rc.new with primitive ---\n");
    {
        Rc<i32> r = Rc<i32>.new(42);
        i32* rp = r.get(&r);
        assert_eq_i32(*rp, 42, "Rc has value 42");
        r.drop();
    }

    // Test 2: Rc.clone
    STDOUT.write_str("--- Test 2: Rc.clone ---\n");
    {
        Rc<i32> a = Rc<i32>.new(42);
        Rc<i32> b = a.clone(&a);
        i32* pa = a.get(&a);
        i32* pb = b.get(&b);
        assert_eq_i32(*pa, 42, "clone: original handle reads 42");
        assert_eq_i32(*pb, 42, "clone: cloned handle reads 42");
        assert_true(pa == pb, "clone: both handles point to same data");
        b.drop();
        a.drop();
    }

    // Test 3: Shared mutation
    STDOUT.write_str("--- Test 3: Shared mutation ---\n");
    {
        Rc<i32> a = Rc<i32>.new(100);
        Rc<i32> b = a.clone(&a);
        i32* pa = a.get(&a);
        *pa = 200;
        i32* pb = b.get(&b);
        assert_eq_i32(*pa, 200, "shared mutation: original sees 200");
        assert_eq_i32(*pb, 200, "shared mutation: clone sees 200");
        b.drop();
        a.drop();
    }

    // Test 4: Three-way sharing
    STDOUT.write_str("--- Test 4: Three-way sharing ---\n");
    {
        Rc<i32> a = Rc<i32>.new(1);
        Rc<i32> b = a.clone(&a);
        Rc<i32> cc = a.clone(&a);
        i32* pa = a.get(&a);
        *pa = 42;
        i32* pb = b.get(&b);
        i32* pc = cc.get(&cc);
        assert_eq_i32(*pa, 42, "three-way: a reads 42");
        assert_eq_i32(*pb, 42, "three-way: b reads 42");
        assert_eq_i32(*pc, 42, "three-way: cc reads 42");
        assert_true(pa == pb, "three-way: a and b share pointer");
        assert_true(pb == pc, "three-way: b and cc share pointer");
        cc.drop();
        b.drop();
        a.drop();
    }

    // Test 5: from_ptr adopts the caller's allocation
    STDOUT.write_str("--- Test 5: from_ptr adoption ---\n");
    {
        // The Rc consumes the heap allocation (frees it at construction
        // after relocating the value into its co-allocated box). The
        // --leak-check run verifies neither the box nor the adopted
        // allocation leaks.
        i32* p = alloc<i32>();
        *p = 777;
        Rc<i32> r = Rc<i32>.from_ptr(p);
        i32* rp = r.get(&r);
        assert_eq_i32(*rp, 777, "from_ptr: Rc reads adopted value");
        r.drop();
    }

    return done();
}
