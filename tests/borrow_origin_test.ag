// End-to-end coverage for reference parameters and reference receivers.
struct Pair {
    i64 left;
    i64 right;
}

i64* first(&Pair pair) {
    return &pair.left;
}

i64* choose_second(&Pair first_pair, &Pair second_pair) {
    return &second_pair.right;
}

impl Pair {
    i64* right_ref(&Pair self) {
        return &self.right;
    }

    i64* get_mut(&mut Pair self) {
        return &self.left;
    }

    void bump(&mut Pair self) {
        self.left = self.left + 1;
    }
}

i64 read_through_raw(Pair* pair) {
    i64* right = pair.right_ref();
    return *right;
}

i64 read_through_ref(&Pair pair) {
    i64* right = pair.right_ref();
    return *right;
}

void bump_through_ref(&mut Pair pair) {
    pair.bump();
}

i64 main() {
    Pair first_pair;
    first_pair.left = 10;
    first_pair.right = 11;

    Pair second_pair;
    second_pair.left = 20;
    second_pair.right = 21;

    i64* left = first(&first_pair);
    @assert(!(*left != 10), "*left != 10");

    i64* chosen = choose_second(&first_pair, &second_pair);
    @assert(!(*chosen != 21), "*chosen != 21");

    i64* method_result = second_pair.right_ref();

    @assert(!(read_through_raw(&second_pair) != 21), "read_through_raw(&second_pair) != 21");

    @assert(!(read_through_ref(&second_pair) != 21), "read_through_ref(&second_pair) != 21");
    @assert(!(*method_result != 21), "*method_result != 21");

    bump_through_ref(&mut second_pair);
    @assert(!(second_pair.left != 21), "second_pair.left != 21");

    i64* mutable_origin = second_pair.get_mut();
    @assert(!(*mutable_origin != 21), "*mutable_origin != 21");
    *mutable_origin = 25; // write through the &mut-receiver borrow
    @assert(!(second_pair.left != 25), "second_pair.left != 25");

    first_pair.bump();
    @assert(!(first_pair.left != 11), "first_pair.left != 11");

    return 0;
}
