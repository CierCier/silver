// compile_flags: --static-runtime
// Thread registry slot reuse: 200 sequential launch/wait cycles. The
// registry holds 64 slots, so this fails unless `wait` reclaims each one.
import std.thread;
import std.sys.entry;

i64 counter = 0;

void worker(i64 val) {
    counter = counter + val;
}

i32 main() {
    for (i64 i = 0; i < 200; i = i + 1) {
        Task<void> t = launch worker(1);
        if (!t.started()) {
            return 1;
        }
        wait t;
    }
    if (counter != 200) {
        return 2;
    }
    return 0;
}
