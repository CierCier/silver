// Compiled with -O2: checks must survive debug assertion removal.
import std.sys.entry;

#[cfg(release)]
i32 release_mode() { return 1; }
#[cfg(debug)]
i32 debug_mode() { return 2; }
#[cfg(arch.x86_64)]
i32 arch_x86_64() { return 3; }
#[cfg(os.linux)]
i32 os_linux() { return 4; }
#[cfg(os.windows)]
i32 os_windows() { return 5; }

i32 main() {
    if (!@cfg(release) || @cfg(debug) || release_mode() != 1) { return 1; }
    if (!@cfg(arch.x86_64) || arch_x86_64() != 3) { return 2; }
    i32 platforms = 0;
    if (@cfg(os.linux)) {
        if (os_linux() != 4) { return 3; }
        platforms += 1;
    }
    if (@cfg(os.windows)) {
        if (os_windows() != 5) { return 4; }
        platforms += 1;
    }
    return platforms == 1 ? 0 : 5;
}
