// Root and imported native units each emit a launch trampoline.
// compile_flags: -I tests/modules
import launch_state_unit;
import std.thread;

i64 root_work() {
    return 42;
}

i32 main() {
    Task<i64> task = launch root_work();
    if (wait task != 42) { return 1; }
    if (launch_state_unit_result() != 43) { return 2; }
    return 0;
}
