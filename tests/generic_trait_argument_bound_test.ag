// compile_flags: --no-cache
import std.test;

// The implementation's type parameter appears only in the trait arguments, so
// the bound check must infer it from the requested trait arguments instead of
// requiring the owner to carry it.
trait View<T> {
    i64 view(&self);
}

impl<T> View<T> for i32 {
    i64 view(&self) { return 7; }
}

struct Bag<T> { T value; }
impl<T> View<T*> for Bag<T> {
    i64 view(&self) { return 8; }
}
impl<T> View<&T> for i64 {
    i64 view(&self) { return 10; }
}

trait Marker { i64 marker(&self); }
impl Marker for Bag<T> {
    i64 marker(&self) { return 9; }
}

struct Holder { i32 unused; }

impl Holder {
    i64 probe<U: View<i64>>(&self, U _value) { return 1; }
    i64 pointer<U: View<i32*>>(&self, U _value) { return 2; }
    i64 implicit<U: Marker>(&self, U _value) { return 3; }
    i64 reference<U: View<&i32>>(&self, U _value) { return 4; }
}

i32 main() {
    Holder holder = { .unused = 0 };
    assert_eq_i64(1, holder.probe((i32)5), "generic trait argument bound");
    Bag<i32> bag = { .value = 5 };
    assert_eq_i64(2, holder.pointer(bag), "pointer trait argument bound");
    assert_eq_i64(3, holder.implicit(bag), "implicit implementation parameter");
    assert_eq_i64(4, holder.reference((i64)5), "reference trait argument inference");
    return done();
}
