// tests/http_server_test.ag — Verification of Go-like HTTP server API:
// - ResponseWriter (set_header, write_header, write_str, chunked output)
// - ServeMux (exact routes, prefix routes, 404 page not found)
// - HttpRequest server parsing (path, query, proto, get_header, body_str)
// - HTTP/1.1 RFC 9112 §3.2 mandatory Host header validation (400 Bad Request)
// - Package-level convenience functions: http_get, http_post

import std.error;
import std.fmt;
import std.net.http;
import std.net.inet;
import std.net.tcp;
import std.sys.entry;
import std.test;
import std.thread;

void handle_hello(ResponseWriter* w, HttpRequest* _r) {
    w.set_header("Content-Type", "text/plain; charset=utf-8");
    w.set_header("X-Silver-Server", "true");
    w.write_header(200);
    w.write_str("hello from silver server");
}

Result<i64, Error> discard_write(void* _ctx, u8* _buf, i64 len) {
    return Ok(len);
}

void check_route(ServeMux* mux, str method, str path, i32 status, str allow) {
    StreamIo io;
    io.ctx = (void*)0;
    io.write = discard_write;
    HttpRequest request = HttpRequest.new(HttpVersion.Http11, method, path, "localhost");
    ResponseWriter writer = ResponseWriter.new(io, HttpVersion.Http11, true);
    mux.serve_http(&mut writer, &mut request);
    assert_eq_i32(status, writer.status_code, path);
    if (allow != "") {
        assert_true(writer.headers.contains(allow), "Allow header matches route methods");
    }
}

void check_route_methods() {
    ServeMux mux = ServeMux.new();
    mux.get("/exact", handle_hello);
    mux.get("/prefix/", handle_hello);
    mux.handle_func("*", "/wildcard", handle_hello);
    mux.handle_func("", "/empty/", handle_hello);
    mux.handle_func((str)0, "/null", handle_hello);

    check_route(&mut mux, "PATCH", "/wildcard", 200, "");
    check_route(&mut mux, "DELETE", "/empty/child", 200, "");
    check_route(&mut mux, "PUT", "/null", 200, "");
    check_route(&mut mux, (str)0, "/exact", 200, "");
    check_route(&mut mux, "HEAD", "/exact", 200, "");
    check_route(&mut mux, "HEAD", "/prefix/child", 200, "");
    check_route(&mut mux, "GET", "/prefix/child", 200, "");
    check_route(&mut mux, "POST", "/prefix/child", 405, "Allow: GET\r\n");
    check_route(&mut mux, "POST", "/exact", 405, "Allow: GET\r\n");
}

void server_worker(i32 fd) {
    TcpListener listener = TcpListener.from_fd(fd);
    HttpServer s = HttpServer.new("127.0.0.1:0");
    s.set_workers(2);
    assert_eq_i64(s.workers, 2, "s.workers == 2");
    s.get("/hello", handle_hello);
    s.post("/echo", |ResponseWriter* w, HttpRequest* r| {
        w.set_header("Content-Type", "text/plain");
        w.write_header(200);
        w.write_str(r.body_str());
    });
    s.get("/search", |ResponseWriter* w, HttpRequest* r| {
        w.set_header("Content-Type", "text/plain");
        w.write_header(200);
        w.write_str(r.query());
    });

    // Serve 6 test requests (4 successful/not found, 2 method not allowed)
    i64 count = 0;
    while (count < 6) {
        Result<i64, Error> a = listener.accept();
        match a {
            Ok(fd) : {
                TcpStream stream = TcpStream.from_fd((i32)fd);
                s.serve_conn(move stream);
                count = count + 1;
            },
            Err(e) : { continue; },
        };
    }
    s.drop();
}

i32 main() {
    test_start("http server: Go-like API");
    check_route_methods();

    Result<SocketAddr, AddrError> bind_result = SocketAddr.v4("127.0.0.1", (u16)0);
    assert_true(bind_result.success(), "bind_result.success()");
    SocketAddr bind_addr = bind_result.unwrap();

    TcpListener listener = TcpListener.bind(&bind_addr, 16);
    assert_true(listener.valid(), "listener valid");

    SockAddrIn sa;
    u32 len = 16;
    try_getsockname(listener.raw_fd(), (void*)&sa, &len);
    u16 port = ntoh16(sa.sin_port);

    i32 lfd = listener.take_fd();
    Task<void> srv = launch server_worker(lfd);

    // Test 1: GET /hello
    String url = String.from_str("http://127.0.0.1:");
    u8 digits[8];
    i64 n = itoa((i64)port, &digits[0]);
    for (i64 i = 0; i < n; i = i + 1) { url.push(digits[i]); }
    url.push_str("/hello");

    Result<HttpResponse, Error> r1 = http_get((str)url.data);
    assert_true(r1.success(), "GET /hello success");
    HttpResponse resp1 = r1.unwrap();
    assert_eq_i64((i64)resp1.status, 200, "status 200");
    assert_true(strcmp((str)resp1.body.data, "hello from silver server") == 0, "hello body");
    String h_srv = resp1.get_header("X-Silver-Server");
    assert_true(strcmp((str)h_srv.data, "true") == 0, "X-Silver-Server header");
    h_srv.drop();
    resp1.drop();

    // Test 2: POST /echo with body
    String url_echo = String.from_str("http://127.0.0.1:");
    for (i64 i = 0; i < n; i = i + 1) { url_echo.push(digits[i]); }
    url_echo.push_str("/echo");

    Result<HttpResponse, Error> r2 = http_post((str)url_echo.data, "text/plain", "silver rocks!");
    assert_true(r2.success(), "POST /echo success");
    HttpResponse resp2 = r2.unwrap();
    assert_eq_i64((i64)resp2.status, 200, "status 200");
    assert_true(strcmp((str)resp2.body.data, "silver rocks!") == 0, "echo body match");
    resp2.drop();

    // Test 3: GET /search?q=testing&page=1
    String url_q = String.from_str("http://127.0.0.1:");
    for (i64 i = 0; i < n; i = i + 1) { url_q.push(digits[i]); }
    url_q.push_str("/search?q=testing&page=1");

    Result<HttpResponse, Error> r3 = http_get((str)url_q.data);
    assert_true(r3.success(), "GET /search success");
    HttpResponse resp3 = r3.unwrap();
    assert_eq_i64((i64)resp3.status, 200, "status 200");
    assert_true(strcmp((str)resp3.body.data, "q=testing&page=1") == 0, "query string match");
    resp3.drop();

    // Test 4: GET /nonexistent -> 404 page not found
    String url_404 = String.from_str("http://127.0.0.1:");
    for (i64 i = 0; i < n; i = i + 1) { url_404.push(digits[i]); }
    url_404.push_str("/nonexistent");

    Result<HttpResponse, Error> r4 = http_get((str)url_404.data);
    assert_true(r4.success(), "GET 404 success");
    HttpResponse resp4 = r4.unwrap();
    assert_eq_i64((i64)resp4.status, 404, "status 404");
    assert_true(strcmp((str)resp4.body.data, "404 page not found\n") == 0, "404 body");
    resp4.drop();

    // Test 5: POST /hello -> 405 Method Not Allowed (only GET is registered)
    Result<HttpResponse, Error> r5 = http_post((str)url.data, "text/plain", "invalid method payload");
    assert_true(r5.success(), "POST /hello completed");
    HttpResponse resp5 = r5.unwrap();
    assert_eq_i64((i64)resp5.status, 405, "status 405 Method Not Allowed");
    String allow5 = resp5.get_header("Allow");
    assert_true(allow5.contains("GET"), "Allow header specifies GET");
    allow5.drop();
    resp5.drop();

    // Test 6: GET /echo -> 405 Method Not Allowed (only POST is registered)
    Result<HttpResponse, Error> r6 = http_get((str)url_echo.data);
    assert_true(r6.success(), "GET /echo completed");
    HttpResponse resp6 = r6.unwrap();
    assert_eq_i64((i64)resp6.status, 405, "status 405 Method Not Allowed");
    String allow6 = resp6.get_header("Allow");
    assert_true(allow6.contains("POST"), "Allow header specifies POST");
    allow6.drop();
    resp6.drop();

    url.drop();
    url_echo.drop();
    url_q.drop();
    url_404.drop();
    wait srv;
    return 0;
}
