// Integration test for the `std.atomic` module and the compiler's `__atomic_*`
// intrinsics (atomic load/store, atomicrmw, cmpxchg, fence).
//
// Exercises every atomic type (AtomicI8/AtomicI32/AtomicI64/AtomicBool) and
// each operation via the public `std.atomic` API, plus a small spin lock built
// on compare_exchange to exercise the memory-ordering guarantees in a
// realistic pattern.
import std.atomic;

i64 checks_passed() {
    return 0;
}

i64 spin_lock(AtomicI32* lock) {
    while (!lock.compare_exchange(0, 1)) {
        // spin: keep trying until the lock is acquired
    }
    return 0;
}

i64 spin_unlock(AtomicI32* lock) {
    lock.set(0);
    return 0;
}

i64 main() {
    // --- AtomicI32 ---
    {
        AtomicI32 c = AtomicI32.new(0);
        c.set(42);
        @assert(!(c.get() != 42), "c.get() != 42");

        i32 old = c.fetch_add(5);
        @assert(!(old != 42), "old != 42");
        @assert(!(c.get() != 47), "c.get() != 47");

        i32 old2 = c.fetch_sub(7);
        @assert(!(old2 != 47), "old2 != 47");
        @assert(!(c.get() != 40), "c.get() != 40");

        i32 old3 = c.swap(100);
        @assert(!(old3 != 40), "old3 != 40");
        @assert(!(c.get() != 100), "c.get() != 100");

        @assert(!(!c.compare_exchange(100, 200)), "!c.compare_exchange(100, 200)");
        @assert(!(c.get() != 200), "c.get() != 200");

        // Failing CAS leaves the value untouched.
        @assert(!(c.compare_exchange(999, 1)), "c.compare_exchange(999, 1)");
        @assert(!(c.get() != 200), "c.get() != 200");

        // Monotonic variants still operate atomically.
        i32 m = c.fetch_add_monotonic(10);
        @assert(!(m != 200), "m != 200");
        @assert(!(c.get_monotonic() != 210), "c.get_monotonic() != 210");
        c.set_monotonic(300);
        @assert(!(c.get() != 300), "c.get() != 300");
    }

    // --- AtomicI64 ---
    {
        AtomicI64 c = AtomicI64.new(0);
        c.set(1000000);
        @assert(!(c.get() != 1000000), "c.get() != 1000000");
        i64 old = c.fetch_add(999999);
        @assert(!(old != 1000000), "old != 1000000");
        @assert(!(c.get() != 1999999), "c.get() != 1999999");
        @assert(!(!c.compare_exchange(1999999, 2000000)), "!c.compare_exchange(1999999, 2000000)");
        @assert(!(c.get() != 2000000), "c.get() != 2000000");
    }

    // --- AtomicI8 ---
    {
        AtomicI8 small = AtomicI8.new(3);
        i8 old = small.fetch_add(2);
        @assert(!(old != 3), "old != 3");
        @assert(!(small.get() != 5), "small.get() != 5");
        @assert(!(!small.compare_exchange(5, 9)), "!small.compare_exchange(5, 9)");
        @assert(!(small.get() != 9), "small.get() != 9");
    }

    // --- AtomicBool ---
    {
        AtomicBool flag = AtomicBool.new(true);
        @assert(!(!flag.get()), "!flag.get()");
        flag.set(false);
        @assert(!(flag.get()), "flag.get()");
        bool old = flag.swap(true);
        @assert(!(old), "old");
        @assert(!(!flag.get()), "!flag.get()");
        @assert(!(!flag.compare_exchange(true, false)), "!flag.compare_exchange(true, false)");
        @assert(!(flag.get()), "flag.get()");
    }

    // --- Spinlock built on cmpxchg (memory-ordering sanity) ---
    {
        AtomicI32 lock = AtomicI32.new(0);
        spin_lock(&lock);
        // Critical section: a thread acquires exactly once.
        @assert(!(lock.get() != 1), "lock.get() != 1");
        spin_unlock(&lock);
        @assert(!(lock.get() != 0), "lock.get() != 0");
    }

    // --- Fences ---
    {
        AtomicI32 x = AtomicI32.new(0);
        AtomicBool ready = AtomicBool.new(false);
        // Writer side pattern: store then release-fence.
        x.set(9);
        fence_release();
        ready.set(true);
        // Reader side pattern: acquire-fence then load.
        if (ready.get()) {
            fence_acquire();
            @assert(!(x.get() != 9), "x.get() != 9");
        }
        fence_seq_cst();
        fence_acq_rel();
    }

    // --- Ordering constants are usable directly with the intrinsics ---
    {
        i32 value = 0;
        __atomic_store_i32(&value, 7, ATOMIC_SEQ_CST);
        i32 v = __atomic_load_i32(&value, ATOMIC_ACQUIRE);
        @assert(!(v != 7), "v != 7");
        __atomic_fence(ATOMIC_ACQ_REL);
    }

    return checks_passed();
}