// tests/http_test.ag — HTTP/1.0 and HTTP/1.1 client tests.
//
// The loopback cases preload a deterministic response before the client sends
// its request. Framing cases (content length, chunked) are single-threaded;
// the convenience-verb cases run a small server thread that accepts the
// client's connection, serves the response, and captures the request. The
// public API case requires internet access: it GETs api.ipify.org and checks
// the JSON shape.

import std.fmt;
import std.net.http;
import std.net.inet;
import std.net.tcp;
import std.sys.entry;
import std.test;
import std.thread;

const str HTTP_OK_WIRE =
    "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello";

// Shared server-thread state (single active case at a time).
TcpListener g_listener;
u8 g_req_head[1024];
u8 g_req_body[64];

struct ServerJob {
    str wire;
    i64 body_len;
    i32 status;
}

ServerJob g_job;

/// Server side of a convenience-verb case: accept, preload the response, and
/// capture the client's request head and body for verification.
void server_main(i64 unused) {
    Result<i64, Error> accept_result = g_listener.accept();
    if (accept_result.failed()) { g_job.status = 6; return; }
    TcpStream server = TcpStream.from_fd((i32)accept_result.value());
    Result<i64, Error> server_write =
        server.write((u8*)g_job.wire, strlen(g_job.wire));
    if (server_write.failed()) { g_job.status = 7; return; }

    i64 hlen = 0;
    u8 byte[1];
    while (true) {
        Result<i64, Error> r = server.read(&byte[0], 1);
        if (r.is_err() || r.value() == 0) { g_job.status = 10; return; }
        g_req_head[hlen] = byte[0];
        hlen = hlen + 1;
        if (hlen >= 1023) { g_job.status = 10; return; }
        if (hlen >= 4 && g_req_head[hlen - 4] == (u8)'\r'
            && g_req_head[hlen - 3] == (u8)'\n'
            && g_req_head[hlen - 2] == (u8)'\r'
            && g_req_head[hlen - 1] == (u8)'\n') { break; }
    }
    g_req_head[hlen] = (u8)0;
    i64 done = 0;
    while (done < g_job.body_len) {
        Result<i64, Error> r = server.read(&g_req_body[done], g_job.body_len - done);
        if (r.is_err() || r.value() == 0) { g_job.status = 10; return; }
        done = done + r.value();
    }
    g_job.status = 0;
}

/// Bind an ephemeral loopback listener; report its port.
i32 bind_loopback(TcpListener* listener, u16* port) {
    Result<SocketAddr, AddrError> bind_result =
        SocketAddr.v4("127.0.0.1", (u16)0);
    @assert(!(bind_result.failed()), "bind_result.failed()");
    SocketAddr bind_addr = bind_result.unwrap();
    *listener = TcpListener.bind(&bind_addr, 1);
    @assert(!(!listener.valid()), "!listener.valid()");
    SockAddrIn sa;
    u32 len = 16;
    Result<i64, Error> name_result =
        try_getsockname(listener.raw_fd(), (void*)&sa, &len);
    @assert(!(name_result.failed()), "name_result.failed()");
    *port = ntoh16(sa.sin_port);
    return 0;
}

/// Build "http://127.0.0.1:<port><path>".
String build_url(u16 port, str path) {
    String url = String.from_str("http://127.0.0.1:");
    u8 digits[8];
    i64 n = itoa((i64)port, &digits[0]);
    i64 i = 0;
    while (i < n) { url.push(digits[i]); i = i + 1; }
    url.push_str(path);
    return url;
}

 i32 run_http_case(HttpVersion version, str response_wire) {
    TcpListener listener;
    u16 port = 0;
    i32 r = bind_loopback(&listener, &port);
    if (r != 0) { return r; }
    Result<SocketAddr, AddrError> connect_result =
        SocketAddr.v4("127.0.0.1", port);
    @assert(!(connect_result.failed()), "connect_result.failed()");
    SocketAddr connect_addr = connect_result.unwrap();

    HttpClient client = HttpClient.new();
    Result<HttpConnection, Error> connection_result =
        client.connect(&connect_addr, version);
    @assert(!(connection_result.failed()), "connection_result.failed()");
    HttpConnection connection = connection_result.unwrap();

    Result<i64, Error> accept_result = listener.accept();
    @assert(!(accept_result.failed()), "accept_result.failed()");
    TcpStream server = TcpStream.from_fd((i32)accept_result.value());
    Result<i64, Error> server_write =
        server.write((u8*)response_wire, strlen(response_wire));
    @assert(!(server_write.failed()), "server_write.failed()");

    HttpRequest request = HttpRequest.new(version, "GET", "/status", "fixture.test");
    Result<HttpResponse, Error> response_result =
        connection.send(&request, 65536, 1024);
    @assert(!(response_result.failed()), "response_result.failed()");
    HttpResponse response = response_result.unwrap();
    @assert(!(response.status != 200), "response.status != 200");
    @assert(!(!response.body.equals("hello")), "check");
    return 0;
}

/// Loopback case for the convenience verbs. `body`/`headers` select the
/// helper arity: POST is called with body+headers, PUT with body, HEAD bare.
i32 run_verb_case(str verb, str body, str headers) {
    @assert(!(verb != "POST" && verb != "PUT" && verb != "HEAD"), "check");
    u16 port = 0;
    i32 r = bind_loopback(&g_listener, &port);
    if (r != 0) { return r; }
    Result<SocketAddr, AddrError> connect_result =
        SocketAddr.v4("127.0.0.1", port);
    @assert(!(connect_result.failed()), "connect_result.failed()");
    SocketAddr connect_addr = connect_result.unwrap();

    g_job.wire = HTTP_OK_WIRE;
    g_job.body_len = 0;
    if (body != (str)0) { g_job.body_len = strlen(body); }
    g_job.status = -1;
    TaskRecord* server_handle = thread_spawn(server_main, 0);
    @assert(!(server_handle == (TaskRecord*)0), "server_handle == (TaskRecord*)0");

    HttpClient client = HttpClient.new();
    String url = build_url(port, "/submit");
    Result<HttpResponse, Error> response_result;
    if (verb == "POST") {
        // Go style: NewRequest + Do, custom headers via req.header().
        HttpRequest req = HttpRequest.new("POST", (str)url.data, body);
        req.header("X-Token", "abc");
        response_result = client.do(&req);
    }
    else if (verb == "PUT") { response_result = client.put((str)url.data, body); }
    else { response_result = client.head((str)url.data); }
    if (response_result.failed()) { thread_join(server_handle); return 8; }
    HttpResponse response = response_result.unwrap();
    if (response.status != 200) { thread_join(server_handle); return 9; }
    @assert(!(thread_join(server_handle) < 0), "thread_join(server_handle) < 0");
    if (g_job.status != 0) { return g_job.status; }

    // Verify what the server captured.
    String head = String.from_str((str)&g_req_head[0]);
    @assert(!(!head.starts_with(verb)), "!head.starts_with(verb)");
    @assert(!(head.find("/submit") < 0), "check");
    @assert(!(headers != (str)0 && head.find(headers) < 0), "headers != (str)0 && head.find(headers) < 0");
    if (g_job.body_len > 0
        && memcmp(&g_req_body[0], (const void*)body, g_job.body_len) != 0) { return 14; }
    return 0;
}

/// Loopback GET against `wire`; check status, reason phrase, body, and
/// (optionally) the Location header. `expected_location` null skips the check.
i32 run_wire_case(str wire, i32 expected_status, str expected_body,
                  str expected_location, str expected_reason) {
    TcpListener listener;
    u16 port = 0;
    i32 r = bind_loopback(&listener, &port);
    if (r != 0) { return r; }
    Result<SocketAddr, AddrError> connect_result =
        SocketAddr.v4("127.0.0.1", port);
    @assert(!(connect_result.failed()), "connect_result.failed()");
    SocketAddr connect_addr = connect_result.unwrap();

    HttpClient client = HttpClient.new();
    Result<HttpConnection, Error> connection_result =
        client.connect(&connect_addr, HttpVersion.Http11);
    @assert(!(connection_result.failed()), "connection_result.failed()");
    HttpConnection connection = connection_result.unwrap();

    Result<i64, Error> accept_result = listener.accept();
    @assert(!(accept_result.failed()), "accept_result.failed()");
    TcpStream server = TcpStream.from_fd((i32)accept_result.value());
    Result<i64, Error> server_write =
        server.write((u8*)wire, strlen(wire));
    @assert(!(server_write.failed()), "server_write.failed()");

    HttpRequest request = HttpRequest.new(HttpVersion.Http11, "GET", "/status", "fixture.test");
    Result<HttpResponse, Error> response_result =
        connection.send(&request, 65536, 1024);
    @assert(!(response_result.failed()), "response_result.failed()");
    HttpResponse response = response_result.unwrap();
    @assert(!(response.status != expected_status), "response.status != expected_status");
    @assert(!(!response.reason.equals(expected_reason)), "!response.reason.equals(expected_reason)");
    @assert(!(!response.body.equals(expected_body)), "!response.body.equals(expected_body)");
    if (expected_location != (str)0) {
        String loc = response.location();
        @assert(!(!loc.equals(expected_location)), "!loc.equals(expected_location)");
    }
    return 0;
}

/// Capture one request head into g_req_head; false on EOF or overflow.
bool capture_head(TcpStream* stream) {
    i64 hlen = 0;
    u8 byte[1];
    while (true) {
        Result<i64, Error> r = stream.read(&byte[0], 1);
        if (r.is_err() || r.value() == 0) { return false; }
        g_req_head[hlen] = byte[0];
        hlen = hlen + 1;
        if (hlen >= 1023) { return false; }
        if (hlen >= 4 && g_req_head[hlen - 4] == (u8)'\r'
            && g_req_head[hlen - 3] == (u8)'\n'
            && g_req_head[hlen - 2] == (u8)'\r'
            && g_req_head[hlen - 1] == (u8)'\n') { break; }
    }
    g_req_head[hlen] = (u8)0;
    return true;
}

/// Two-connection server for redirect cases: serve `g_job.wire` (the 3xx),
/// then capture the follow-up request and serve `g_second_wire`. The second
/// connection reads `g_second_body_len` body bytes (the rewritten request
/// may drop the body).
str g_second_wire;
i64 g_second_body_len;
void redirect_server_main(i64 unused) {
    Result<i64, Error> a1 = g_listener.accept();
    if (a1.failed()) { g_job.status = 6; return; }
    TcpStream s1 = TcpStream.from_fd((i32)a1.value());
    Result<i64, Error> w1 = s1.write((u8*)g_job.wire, strlen(g_job.wire));
    if (w1.failed()) { g_job.status = 7; return; }
    if (!capture_head(&s1)) { g_job.status = 10; return; }
    s1.close();

    Result<i64, Error> a2 = g_listener.accept();
    if (a2.failed()) { g_job.status = 8; return; }
    TcpStream s2 = TcpStream.from_fd((i32)a2.value());
    if (!capture_head(&s2)) { g_job.status = 10; return; }
    i64 done = 0;
    while (done < g_second_body_len) {
        Result<i64, Error> r = s2.read(&g_req_body[done], g_second_body_len - done);
        if (r.is_err() || r.value() == 0) { g_job.status = 10; return; }
        done = done + r.value();
    }
    Result<i64, Error> w2 = s2.write((u8*)g_second_wire, strlen(g_second_wire));
    if (w2.failed()) { g_job.status = 9; return; }
    s2.close();
    g_job.status = 0;
}

/// Serve the same redirect `g_job.wire` three times (initial request plus
/// two follow-ups), then exit.
void redirect_loop_server_main(i64 unused) {
    i32 i = 0;
    while (i < 3) {
        Result<i64, Error> a = g_listener.accept();
        if (a.failed()) { g_job.status = 6; return; }
        TcpStream s = TcpStream.from_fd((i32)a.value());
        if (!capture_head(&s)) { g_job.status = 10; return; }
        Result<i64, Error> w = s.write((u8*)g_job.wire, strlen(g_job.wire));
        if (w.failed()) { g_job.status = 7; return; }
        s.close();
        i = i + 1;
    }
    g_job.status = 0;
}

/// Redirect case: `first_wire` is the 3xx response, `second_wire` the final
/// response. After the round trip, verifies the follow-up request line
/// (`expected_method` + `expected_target`) and captured body.
i32 run_redirect_case(str first_wire, str second_wire, str method, str body,
                      str expected_method, str expected_target,
                      str expected_second_body) {
    u16 port = 0;
    i32 r = bind_loopback(&g_listener, &port);
    if (r != 0) { return r; }
    Result<SocketAddr, AddrError> connect_result =
        SocketAddr.v4("127.0.0.1", port);
    @assert(!(connect_result.failed()), "connect_result.failed()");
    SocketAddr connect_addr = connect_result.unwrap();

    g_job.wire = first_wire;
    g_second_wire = second_wire;
    g_job.body_len = 0;
    if (body != (str)0) { g_job.body_len = strlen(body); }
    g_second_body_len = 0;
    if (expected_second_body != (str)0) { g_second_body_len = strlen(expected_second_body); }
    g_job.status = -1;
    TaskRecord* server_handle = thread_spawn(redirect_server_main, 0);
    @assert(!(server_handle == (TaskRecord*)0), "server_handle == (TaskRecord*)0");

    HttpClient client = HttpClient.new();
    String url = build_url(port, "/start");
    HttpRequest req = HttpRequest.new(method, (str)url.data, body);
    Result<HttpResponse, Error> response_result = client.do(&req);
    if (response_result.failed()) { thread_join(server_handle); return 8; }
    HttpResponse response = response_result.unwrap();
    if (response.status != 200) { thread_join(server_handle); return 9; }
    if (!response.body.equals("hello")) { thread_join(server_handle); return 10; }
    @assert(!(thread_join(server_handle) < 0), "thread_join(server_handle) < 0");
    if (g_job.status != 0) { return g_job.status; }

    String head = String.from_str((str)&g_req_head[0]);
    @assert(!(!head.starts_with(expected_method)), "!head.starts_with(expected_method)");
    @assert(!(head.find(expected_target) < 0), "head.find(expected_target) < 0");
    if (g_second_body_len > 0
        && memcmp(&g_req_body[0], (const void*)expected_second_body, g_second_body_len) != 0) {
        return 13;
    }
    return 0;
}

/// GET `/?format=json` from api.ipify.org and check the JSON shape.
i32 run_get_public_case() {
    HttpClient client = HttpClient.new();
    Result<HttpResponse, Error> response_result =
        client.get("http://api.ipify.org/?format=json");
    @assert(!(response_result.failed()), "response_result.failed()");
    HttpResponse response = response_result.unwrap();
    @assert(!(response.status != 200), "response.status != 200");
    @assert(!(!response.body.starts_with("{\"ip\":\"")), "check");
    return 0;
}

 i32 main() {
    test_start("HTTP/1.1 client");
    assert_eq_i64(0, run_http_case(HttpVersion.Http11,
        "HTTP/1.1 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"),
        "HTTP/1.1 response parsed");

    test_start("HTTP/1.0 client");
    assert_eq_i64(0, run_http_case(HttpVersion.Http10,
        "HTTP/1.0 200 OK\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"),
        "HTTP/1.0 response parsed");

    test_start("HTTP/1.1 chunked");
    assert_eq_i64(0, run_http_case(HttpVersion.Http11,
        "HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\nConnection: close\r\n\r\n"
        "5\r\nhello\r\n0\r\n\r\n"),
        "HTTP/1.1 chunked response parsed");

    test_start("client.post convenience");
    assert_eq_i64(0, run_verb_case("POST", "payload", "X-Token: abc\r\n"),
        "POST with body and headers");

    test_start("client.put convenience");
    assert_eq_i64(0, run_verb_case("PUT", "data", (str)0),
        "PUT with body");

    test_start("client.head convenience");
    assert_eq_i64(0, run_verb_case("HEAD", (str)0, (str)0),
        "HEAD request");

    test_start("http status helpers");
    assert_eq_i64((i64)(i32)HttpStatus.NotFound, 404, "HttpStatus.NotFound == 404");
    assert_true(http_status_is_redirect(301), "301 is redirect");
    assert_true(http_status_is_success(200), "200 is success");
    assert_true(http_status_has_no_body(204, false), "204 has no body");
    assert_true(http_status_has_no_body(205, false), "205 has no body");
    assert_true(!http_status_has_no_body(200, false), "200 has a body");
    assert_true(strcmp(http_status_reason(404), "Not Found") == 0, "reason(404)");

    test_start("204 no content");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 204 No Content\r\nConnection: close\r\n\r\n",
        204, "", (str)0, "No Content"),
        "204 parsed with empty body");

    test_start("205 reset content");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 205 Reset Content\r\nConnection: close\r\n\r\n",
        205, "", (str)0, "Reset Content"),
        "205 parsed with empty body");

    test_start("304 not modified");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 304 Not Modified\r\nConnection: close\r\n\r\n",
        304, "", (str)0, "Not Modified"),
        "304 parsed with empty body");

    test_start("404 with body");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 404 Not Found\r\nContent-Length: 4\r\nConnection: close\r\n\r\nnope",
        404, "nope", (str)0, "Not Found"),
        "404 parsed with body");

    test_start("interim 100 skipped");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 100 Continue\r\n\r\n"
        "HTTP/1.1 200 OK\r\nContent-Length: 2\r\nConnection: close\r\n\r\nhi",
        200, "hi", (str)0, "OK"),
        "100 Continue skipped, final 200 parsed");

    test_start("301 location");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 301 Moved Permanently\r\nLocation: http://example.com/\r\nContent-Length: 0\r\nConnection: close\r\n\r\n",
        301, "", "http://example.com/", "Moved Permanently"),
        "301 parsed with Location header");

    test_start("302 followed");
    assert_eq_i64(0, run_redirect_case(
        "HTTP/1.1 302 Found\r\nLocation: /final\r\nContent-Length: 0\r\n\r\n",
        HTTP_OK_WIRE, "GET", (str)0, "GET", "/final", (str)0),
        "302 followed to /final");

    test_start("301 rewrites POST to GET");
    assert_eq_i64(0, run_redirect_case(
        "HTTP/1.1 301 Moved Permanently\r\nLocation: /final\r\nContent-Length: 0\r\n\r\n",
        HTTP_OK_WIRE, "POST", "payload", "GET", "/final", (str)0),
        "301 followed, POST rewritten to GET without body");

    test_start("307 preserves POST and body");
    assert_eq_i64(0, run_redirect_case(
        "HTTP/1.1 307 Temporary Redirect\r\nLocation: /final\r\nContent-Length: 0\r\n\r\n",
        HTTP_OK_WIRE, "POST", "payload", "POST", "/final", "payload"),
        "307 followed, method and body preserved");

    test_start("redirect limit");
    // A 302 pointing back to /start: the client must stop after 2 follows.
    u16 port = 0;
    i32 r = bind_loopback(&g_listener, &port);
    if (r != 0) { assert_true(false, "bind loopback"); }
    else {
        Result<SocketAddr, AddrError> connect_result =
            SocketAddr.v4("127.0.0.1", port);
        assert_true(!connect_result.failed(), "v4 addr");
        SocketAddr connect_addr = connect_result.unwrap();
        g_job.wire = "HTTP/1.1 302 Found\r\nLocation: /start\r\nContent-Length: 0\r\n\r\n";
        g_job.body_len = 0;
        g_second_body_len = 0;
        g_job.status = -1;
        TaskRecord* server_handle = thread_spawn(redirect_loop_server_main, 0);
        if (server_handle == (TaskRecord*)0) { assert_true(false, "spawn server"); }
        else {
            HttpClient client = HttpClient.new();
            client.set_max_redirects(2);
            String url = build_url(port, "/start");
            HttpRequest req = HttpRequest.new("GET", (str)url.data, (str)0);
            Result<HttpResponse, Error> response_result = client.do(&req);
            thread_join(server_handle);
            assert_true(response_result.failed(), "redirect limit errors");
            if (response_result.failed()) {
                Error e = response_result.get_error();
                assert_eq_i64(e.code, HTTP_ERR_REDIRECT, "HTTP_ERR_REDIRECT code");
            }
        }
    }

    test_start("response header and status text");
    assert_eq_i64(0, run_wire_case(
        "HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello",
        200, "hello", (str)0, "OK"),
        "200 with content-type parsed");
    {
        TcpListener listener;
        u16 port2 = 0;
        i32 r2 = bind_loopback(&listener, &port2);
        if (r2 != 0) { assert_true(false, "bind loopback"); }
        else {
            Result<SocketAddr, AddrError> connect_result =
                SocketAddr.v4("127.0.0.1", port2);
            assert_true(!connect_result.failed(), "v4 addr");
            SocketAddr connect_addr = connect_result.unwrap();
            HttpClient client = HttpClient.new();
            Result<HttpConnection, Error> connection_result =
                client.connect(&connect_addr, HttpVersion.Http11);
            assert_true(!connection_result.failed(), "connect");
            HttpConnection connection = connection_result.unwrap();
            Result<i64, Error> accept_result = listener.accept();
            assert_true(!accept_result.failed(), "accept");
            TcpStream server = TcpStream.from_fd((i32)accept_result.value());
            Result<i64, Error> server_write = server.write(
                (u8*)"HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello",
                strlen("HTTP/1.1 200 OK\r\nContent-Type: text/plain\r\nContent-Length: 5\r\nConnection: close\r\n\r\nhello"));
            assert_true(!server_write.failed(), "server write");
            HttpRequest request = HttpRequest.new(HttpVersion.Http11, "GET", "/h", "fixture.test");
            Result<HttpResponse, Error> response_result =
                connection.send(&request, 65536, 1024);
            assert_true(!response_result.failed(), "send");
            HttpResponse response = response_result.unwrap();
            String ct = response.get_header("Content-Type");
            assert_true(ct.equals("text/plain"), "get_header Content-Type");
            String cl = response.get_header("content-length");
            assert_true(cl.equals("5"), "get_header case-insensitive");
            String missing = response.get_header("X-Nope");
            assert_eq_i64(missing.len, 0, "get_header absent is empty");
            String text = response.status_text();
            assert_true(text.equals("200 OK"), "status_text");
        }
    }

    test_start("malformed host rejected");
    {
        HttpClient client = HttpClient.new();
        Result<HttpResponse, Error> r = client.get("http://bad host/");
        assert_true(r.failed(), "host with space rejected");
        if (r.failed()) {
            Error e = r.get_error();
            assert_eq_i64(e.code, HTTP_ERR_MALFORMED, "malformed URL error");
        }
        Result<HttpResponse, Error> r2 = client.get("http://host\tevil/");
        assert_true(r2.failed(), "control char host rejected");
    }

    test_start("client.get public API");
    assert_eq_i64(0, run_get_public_case(), "GET convenience against public API");

    return done();
}
