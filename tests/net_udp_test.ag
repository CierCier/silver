// tests/net_udp_test.ag — Integration tests for std/net/socket.ag.
//
// Tests: UdpSocket create, bind, send_to, recv_from, local_port, close.

import std.net.socket;
import std.net.inet;
import std.sys.socket;
import std.sys.raw.socket;
import std.sys.os_linux;
import std.test;

i32 main() {
    test_start("udp create and bind");

    UdpSocket sock = UdpSocket.new();
    assert_true(sock.valid(), "create udp socket");

    Result<SocketAddr, AddrError> bind_result =
        SocketAddr.v4("127.0.0.1", (u16)0);
    SocketAddr addr = bind_result.unwrap();
    assert_true(sock.bind(&addr), "bind to port 0");

    // Verify we got a non-zero port.
    u16 port = sock.local_port();
    assert_true(port != (u16)0, "got non-zero port");

    // Close and verify.
    sock.close();
    assert_true(sock.invalid(), "close marks invalid");

    test_start("udp send and recv");
    UdpSocket a = UdpSocket.new();
    UdpSocket b = UdpSocket.new();

    Result<SocketAddr, AddrError> bind_a_result =
        SocketAddr.v4("127.0.0.1", (u16)0);
    SocketAddr bind_a = bind_a_result.unwrap();
    assert_true(a.bind(&bind_a), "bind sender socket");
    u16 port_a = a.local_port();

    Result<SocketAddr, AddrError> dst_result =
        SocketAddr.v4("127.0.0.1", port_a);
    SocketAddr dst = dst_result.unwrap();

    // b -> a
    i64 sent = b.send_to((u8*)"hello", 5, &dst);
    assert_eq_i64(5, sent, "send 5 bytes");

    // a recv
    u8 buf[64];
    SocketAddr src;
    i64 got = a.recv_from(buf, 5, &src);
    assert_eq_i64(5, got, "recv 5 bytes");

    test_start("udp unix and v6 constructors");
    UdpSocket unix_sock = UdpSocket.new_unix();
    assert_true(unix_sock.valid(), "create unix datagram socket");
    unix_sock.close();

    Result<SocketAddr, AddrError> v6_res = SocketAddr.v6("::1", (u16)0);
    if (v6_res.success()) {
        SocketAddr v6_addr = v6_res.unwrap();
        // Address parsing succeeds even when the host has IPv6 loopback off.
        i64 probe_fd = sys_socket((i64)AddressFamily.INET6,
            (i64)SocketType.DGRAM | SOCK_CLOEXEC, 0);
        if (probe_fd >= 0) {
            SockAddrIn6 probe_addr = SockAddrIn6.v6((u16)0, "::1");
            bool host_supports_v6 = sys_bind(probe_fd, (i64)&probe_addr, 28) == 0;
            sys_close(probe_fd);
            if (host_supports_v6) {
                UdpSocket v6_sock = UdpSocket.bind_addr(&v6_addr);
                assert_true(v6_sock.valid(), "bind_addr on v6 succeeds");
                v6_sock.close();
            } else {
                @println("  [SKIP] IPv6 loopback unavailable on this host");
            }
        } else {
            @println("  [SKIP] IPv6 datagram sockets unavailable on this host");
        }
    }

    return done();
}
