// Test suite for std.bytes
import std.test;
import std.bytes;

i32 main() {
    test_start("new - empty bytes");
    {
        Bytes b = Bytes.new();
        assert_eq_i64(b.len(), 0, "new Bytes has len 0");
        assert_eq_i64(b.capacity(), 0, "new Bytes has cap 0");
        b.drop();
    }

    test_start("with_capacity");
    {
        Bytes b = Bytes.with_capacity(32);
        assert_eq_i64(b.len(), 0, "with_capacity has len 0");
        assert_eq_i64(b.capacity(), 32, "with_capacity has specified capacity");
        b.drop();
    }

    test_start("push and len");
    {
        Bytes b = Bytes.new();
        b.push((u8)65); // 'A'
        b.push((u8)66); // 'B'
        b.push((u8)67); // 'C'
        assert_eq_i64(b.len(), 3, "len is 3 after three pushes");
        assert_eq_i32((i32)b.get(0), 65, "get(0) is 'A'");
        assert_eq_i32((i32)b.get(1), 66, "get(1) is 'B'");
        assert_eq_i32((i32)b.get(2), 67, "get(2) is 'C'");
        b.drop();
    }

    test_start("push grows capacity");
    {
        Bytes b = Bytes.with_capacity(2);
        b.push((u8)1);
        b.push((u8)2);
        assert_eq_i64(b.capacity(), 2, "capacity still 2 before growth");
        b.push((u8)3);
        assert_eq_i64(b.len(), 3, "len is 3 after pushing past capacity");
        assert_true(b.capacity() >= 3, "capacity grew to fit");
        b.drop();
    }

    test_start("extend");
    {
        Bytes b = Bytes.new();
        u8 src[3];
        src[0] = (u8)10;
        src[1] = (u8)20;
        src[2] = (u8)30;
        b.extend(src, 3);
        assert_eq_i64(b.len(), 3, "len is 3 after extend");
        assert_eq_i32((i32)b.get(0), 10, "extend[0] = 10");
        assert_eq_i32((i32)b.get(1), 20, "extend[1] = 20");
        assert_eq_i32((i32)b.get(2), 30, "extend[2] = 30");
        b.drop();
    }

    test_start("extend empty");
    {
        Bytes b = Bytes.new();
        b.extend((u8*)0, 0);
        assert_eq_i64(b.len(), 0, "extend with empty is no-op");
        b.drop();
    }

    test_start("get and set indexing");
    {
        Bytes b = Bytes.new();
        b.push((u8)100);
        b.push((u8)200);
        b.push((u8)255);
        assert_eq_i32((i32)b.get(2), 255, "get(2) = 255");
        b.set(1, (u8)150);
        assert_eq_i32((i32)b.get(1), 150, "after set(1, 150) = 150");
        b.drop();
    }

    test_start("as_ptr");
    {
        Bytes b = Bytes.new();
        b.push((u8)42);
        u8* ptr = b.as_ptr();
        assert_true(ptr != (u8*)0, "as_ptr returns non-null");
        assert_eq_i32((i32)ptr[0], 42, "ptr[0] = 42");
        b.drop();
    }

    test_start("clear");
    {
        Bytes b = Bytes.new();
        b.push((u8)1);
        b.push((u8)2);
        b.clear();
        assert_eq_i64(b.len(), 0, "len is 0 after clear");
        b.push((u8)99);
        assert_eq_i32((i32)b.get(0), 99, "can push after clear");
        b.drop();
    }

    test_start("indexed access via []");
    {
        Bytes b = Bytes.new();
        b.push((u8)7);
        b.push((u8)8);
        assert_eq_i32((i32)b[0], 7, "b[0] = 7");
        assert_eq_i32((i32)b[1], 8, "b[1] = 8");
        b[1] = (u8)9;
        assert_eq_i32((i32)b[1], 9, "b[1] = 9 after assignment");
        b.drop();
    }

    test_start("find, rfind, count, contains");
    {
        Bytes b = Bytes.new();
        u8 sample[10];
        sample[0] = (u8)'a';
        sample[1] = (u8)'b';
        sample[2] = (u8)'c';
        sample[3] = (u8)'b';
        sample[4] = (u8)'a';
        sample[5] = (u8)'d';
        sample[6] = (u8)'b';
        sample[7] = (u8)'e';
        sample[8] = (u8)'f';
        sample[9] = (u8)'b';
        b.extend(sample, 10);

        assert_eq_i64(b.find((u8)'b'), 1, "find first 'b'");
        assert_eq_i64(b.rfind((u8)'b'), 9, "rfind last 'b'");
        assert_eq_i64(b.count((u8)'b'), 4, "count 'b' = 4");
        assert_true(b.contains((u8)'d'), "contains 'd'");
        assert_true(!b.contains((u8)'z'), "!contains 'z'");
        assert_eq_i64(b.find((u8)'z'), -1, "find 'z' = -1");
        assert_eq_i64(b.rfind((u8)'z'), -1, "rfind 'z' = -1");

        b.drop();
    }

    test_start("starts_with, ends_with, equals");
    {
        Bytes b1 = Bytes.new();
        Bytes b2 = Bytes.new();
        u8 p1[4];
        p1[0] = (u8)'T'; p1[1] = (u8)'E'; p1[2] = (u8)'S'; p1[3] = (u8)'T';
        b1.extend(p1, 4);
        b2.extend(p1, 4);

        assert_true(b1.equals(&b2), "b1 == b2");
        assert_true(b1.starts_with(p1, 2), "starts_with TE");
        assert_true(b1.ends_with(&p1[2], 2), "ends_with ST");

        b2.push((u8)'!');
        assert_true(!b1.equals(&b2), "b1 != b2 after push");

        b1.drop();
        b2.drop();
    }

    return done();
}
