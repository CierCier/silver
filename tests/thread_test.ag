// Thread runtime integration test: spawn/join on real 1:1 OS threads.
//
// Spawns N threads that each run a worker incrementing a shared atomic
// counter (with per-thread spacing so the sum is deterministic), joins every
// thread, then verifies the counter reached exactly the expected total and
// that a second spawn/join cycle still works (registry slot reclamation).
// Also exercises the _start join-all path: a thread left running when `main`
// returns is joined before exit_group.

import std.thread;
import std.atomic;
import std.sys.entry;

i64 g_counter;

void worker(i64 tid) {
    // Spaced increments: thread t adds (t+1) to the counter.
    __atomic_fetch_add_i64(&g_counter, tid + 1, ATOMIC_RELEASE);
}

i64 main() {
    i64 nthreads = 4;

    // Round 1: spawn all, join all. Expected counter = 1+2+3+4 = 10.
    TaskRecord* h0 = thread_spawn(worker, 0);
    TaskRecord* h1 = thread_spawn(worker, 1);
    TaskRecord* h2 = thread_spawn(worker, 2);
    TaskRecord* h3 = thread_spawn(worker, 3);
    if (h0 == (TaskRecord*)0 || h1 == (TaskRecord*)0 || h2 == (TaskRecord*)0 || h3 == (TaskRecord*)0) {
        return 1;
    }
    if (thread_join(h0) < 0 || thread_join(h1) < 0 || thread_join(h2) < 0 || thread_join(h3) < 0) {
        return 2;
    }
    if (__atomic_load_i64(&g_counter, ATOMIC_ACQUIRE) != 10) {
        return 3;
    }

    // Round 2: slots were reclaimed by join — spawn again and join all four.
    // The counter must reach the full sum again, proving concurrent runs of
    // independent spawn/join cycles are correct.
    g_counter = 0;
    h0 = thread_spawn(worker, 0);
    h1 = thread_spawn(worker, 1);
    h2 = thread_spawn(worker, 2);
    h3 = thread_spawn(worker, 3);
    if (h0 == (TaskRecord*)0 || h1 == (TaskRecord*)0 || h2 == (TaskRecord*)0 || h3 == (TaskRecord*)0) {
        return 4;
    }
    if (thread_join(h0) < 0 || thread_join(h1) < 0 || thread_join(h2) < 0 || thread_join(h3) < 0) {
        return 5;
    }
    if (__atomic_load_i64(&g_counter, ATOMIC_ACQUIRE) != 10) {
        return 6;
    }

    // Round 3: spawn one thread and return WITHOUT joining. The join-all hook
    // in _start must wait for it before exit_group; if the registry were not
    // linked (e.g. entry.ag lost its import) the binary would fail to link,
    // and if join-all hung the suite timeout would fire. The worker's
    // increment races the exit only if join-all is missing — with it, the
    // thread always finishes before exit_group.
    h0 = thread_spawn(worker, 0);
    if (h0 == (TaskRecord*)0) {
        return 7;
    }
    return 0;
}