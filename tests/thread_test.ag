// Thread runtime integration test: launch/wait on real 1:1 OS threads.
//
// Launches N tasks that each add to a shared atomic counter (with per-task
// spacing so the sum is deterministic), waits for every task, then checks
// the counter reached exactly the expected total and that a second
// launch/wait round still works (registry slot reclamation).
// Also exercises the _start join-all path: a task left running when `main`
// returns is joined before exit_group.

import std.thread;
import std.atomic;
import std.mem.vec;
import std.sys.entry;

i64 g_counter;

void worker(i64 index) {
    // Spaced increments: task t adds (t+1) to the counter.
    __atomic_fetch_add_i64(&g_counter, index + 1, ATOMIC_RELEASE);
}

/// Launches four workers and waits for all of them. Returns false when a
/// launch fails.
bool run_round() {
    Vec<Task<void>> tasks = Vec<Task<void>>.new();
    bool started = true;
    for (i64 i = 0; i < 4; i = i + 1) {
        Task<void> task = launch worker(i);
        started = started && task.started();
        tasks.push(move task);
    }
    while (tasks.len() > 0) {
        Task<void> task = tasks.pop();
        if (task.started()) {
            wait task;
        }
    }
    tasks.drop();
    return started;
}

i64 main() {
    // Round 1: launch all, wait all. Expected counter = 1+2+3+4 = 10.
    @assert(run_round(), "round 1 launches");
    @assert(__atomic_load_i64(&g_counter, ATOMIC_ACQUIRE) == 10, "round 1 total");

    // Round 2: `wait` reclaimed the slots, so launching again works and the
    // counter reaches the full sum again.
    g_counter = 0;
    @assert(run_round(), "round 2 launches");
    @assert(__atomic_load_i64(&g_counter, ATOMIC_ACQUIRE) == 10, "round 2 total");

    // Round 3: launch one task and return WITHOUT waiting. It borrows
    // nothing, so dropping its handle does not join it; the join-all hook in
    // _start must wait for it before exit_group.
    Task<void> detached = launch worker(0);
    @assert(detached.started(), "round 3 launch");
    return 0;
}
