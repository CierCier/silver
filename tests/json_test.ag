import std.io.file;
import std.json;

#[serialize]
struct User {
    i32 id "json:id db:user_id";
    str name "json:name";
}
impl ToJson for User {
    void to_json(User* self, JsonWriter* out) {
        out.begin_object();
        out.field("id");
        out.write_i64((i64)self.id);
        out.field("name");
        out.write_string(self.name);
        out.end_object();
    }
}
impl User {
    User new(i32 id, str name) {
        User user;
        user.id = id;
        user.name = name;
        return move user;
    }
}

#[serialize]
struct Product {
    i32 id "json:product_id";
    str title;
    f64 price;
}


i32 main() {
    User user = User.new(7, "Ada");
    str encoded = @json(user);
    Optional<i32> some = Some(7);
    Optional<i32> none = None;
    str some_json = @json(some);
    str none_json = @json(none);
    Result<String, JsonError> decoded = @from_json(String, "\"Ada\"");
    @assert(!(decoded.failed()), "decoded.failed()");
    String decoded_name = decoded.unwrap();
    @assert(!(!decoded_name.equals("Ada")), "check");
    @assert(!(encoded != "{\"id\":7,\"name\":\"Ada\"}"), "check");
    @assert(!(some_json != "7"), "check");
    @assert(!(none_json != "null"), "check");

    // Test synthesized #[serialize] Product
    Product prod = { .id = 42, .title = "Keyboard", .price = 79.99 };
    str prod_json = @json(prod);
    @assert(!(prod_json != "{\"product_id\":42,\"title\":\"Keyboard\",\"price\":79.99}"), "prod_json check");

    Result<Product, JsonError> decoded_prod = @from_json(Product, "{\"product_id\":10,\"title\":\"Mouse\",\"price\":29.5}");
    @assert(!decoded_prod.failed(), "decoded_prod succeeded");
    Product p = decoded_prod.unwrap();
    @assert(p.id == 10, "p.id == 10");
    @assert(p.title == "Mouse", "p.title == Mouse");
    @assert(p.price == 29.5, "p.price == 29.5");

    // --- full scalar coverage: encode + decode round trips ---
    i8 n8 = -12;
    i16 n16 = -1234;
    i32 n32 = -123456;
    i64 n64 = -123456789;
    u8 p8 = 250;
    u16 p16 = 60000;
    u32 p32 = 4000000000;
    u64 p64 = 18000000000000000000;
    f32 half = 2.5;
    f64 quarter = -3.25;
    @assert(!(@json(n8) != "-12"), "check");
    @assert(!(@json(n16) != "-1234"), "check");
    @assert(!(@json(n32) != "-123456"), "check");
    @assert(!(@json(n64) != "-123456789"), "check");
    @assert(!(@json(p8) != "250"), "check");
    @assert(!(@json(p16) != "60000"), "check");
    @assert(!(@json(p32) != "4000000000"), "check");
    @assert(!(@json(p64) != "18000000000000000000"), "check");
    @assert(!(@json(half) != "2.5"), "check");
    @assert(!(@json(quarter) != "-3.25"), "check");

    Result<i8, JsonError> d8 = @from_json(i8, "-12");
    Result<i16, JsonError> d16 = @from_json(i16, "-1234");
    Result<u8, JsonError> du8 = @from_json(u8, "250");
    Result<u16, JsonError> du16 = @from_json(u16, "60000");
    Result<u32, JsonError> du32 = @from_json(u32, "4000000000");
    Result<u64, JsonError> du64 = @from_json(u64, "18000000000000000000");
    Result<f32, JsonError> df32 = @from_json(f32, "2.5");
    Result<f64, JsonError> df64 = @from_json(f64, "-3.25");
    Result<f64, JsonError> dexp = @from_json(f64, "2.5e3");
    @assert(!(d8.failed() || d8.unwrap() != n8), "d8.failed() || d8.unwrap() != n8");
    @assert(!(d16.failed() || d16.unwrap() != n16), "d16.failed() || d16.unwrap() != n16");
    @assert(!(du8.failed() || du8.unwrap() != p8), "du8.failed() || du8.unwrap() != p8");
    @assert(!(du16.failed() || du16.unwrap() != p16), "du16.failed() || du16.unwrap() != p16");
    @assert(!(du32.failed() || du32.unwrap() != p32), "du32.failed() || du32.unwrap() != p32");
    @assert(!(du64.failed() || du64.unwrap() != p64), "du64.failed() || du64.unwrap() != p64");
    @assert(!(df32.failed() || df32.unwrap() != half), "df32.failed() || df32.unwrap() != half");
    @assert(!(df64.failed() || df64.unwrap() != quarter), "df64.failed() || df64.unwrap() != quarter");
    @assert(!(dexp.failed() || dexp.unwrap() != 2500.0), "dexp.failed() || dexp.unwrap() != 2500.0");

    // --- Optional round trips, null decodes to None ---
    Optional<i32> fsome = Some(7);
    Optional<f64> fhalf = Some(2.5);
    Optional<f64> fnone = None;
    @assert(!(@json(fsome) != "7"), "check");
    @assert(!(@json(fhalf) != "2.5"), "check");
    @assert(!(@json(fnone) != "null"), "check");
    Result<Optional<i32>, JsonError> osome = @from_json(Optional<i32>, "7");
    Result<Optional<i32>, JsonError> onone = @from_json(Optional<i32>, "null");
    Result<Optional<f64>, JsonError> ofhalf = @from_json(Optional<f64>, "2.5");
    Result<Optional<f64>, JsonError> ofnone = @from_json(Optional<f64>, "null");
    @assert(!(osome.failed()), "osome.failed()");
    Optional<i32> o1 = osome.unwrap();
    @assert(!(!o1.is_some() || o1.unwrap() != 7), "!o1.is_some() || o1.unwrap() != 7");
    @assert(!(onone.failed()), "onone.failed()");
    Optional<i32> o2 = onone.unwrap();
    @assert(!(o2.is_some()), "o2.is_some()");
    @assert(!(ofhalf.failed()), "ofhalf.failed()");
    Optional<f64> o3 = ofhalf.unwrap();
    @assert(!(!o3.is_some() || o3.unwrap() != 2.5), "!o3.is_some() || o3.unwrap() != 2.5");
    @assert(!(ofnone.failed()), "ofnone.failed()");
    Optional<f64> o4 = ofnone.unwrap();
    @assert(!(o4.is_some()), "o4.is_some()");

    // --- strict number grammar tests (valid vs malformed) ---
    Result<f64, JsonError> v_zero = @from_json(f64, "0");
    Result<f64, JsonError> v_neg_zero = @from_json(f64, "-0");
    Result<f64, JsonError> v_frac = @from_json(f64, "0.5");
    Result<f64, JsonError> v_exp_plus = @from_json(f64, "1.5E+2");
    Result<f64, JsonError> v_exp_minus = @from_json(f64, "1.5e-2");
    @assert(!v_zero.failed() && v_zero.unwrap() == 0.0, "valid 0");
    @assert(!v_neg_zero.failed() && v_neg_zero.unwrap() == 0.0, "valid -0");
    @assert(!v_frac.failed() && v_frac.unwrap() == 0.5, "valid 0.5");
    @assert(!v_exp_plus.failed() && v_exp_plus.unwrap() == 150.0, "valid 1.5E+2");
    @assert(!v_exp_minus.failed() && v_exp_minus.unwrap() == 0.015, "valid 1.5e-2");

    // Malformed exponents must fail
    Result<f64, JsonError> bad_exp1 = @from_json(f64, "1e");
    Result<f64, JsonError> bad_exp2 = @from_json(f64, "1e+");
    Result<f64, JsonError> bad_exp3 = @from_json(f64, "1e-");
    Result<f64, JsonError> bad_exp4 = @from_json(f64, "1E");
    Result<f64, JsonError> bad_exp5 = @from_json(f64, "-2.5e");
    @assert(bad_exp1.failed(), "malformed '1e' must fail");
    @assert(bad_exp2.failed(), "malformed '1e+' must fail");
    @assert(bad_exp3.failed(), "malformed '1e-' must fail");
    @assert(bad_exp4.failed(), "malformed '1E' must fail");
    @assert(bad_exp5.failed(), "malformed '-2.5e' must fail");

    // Malformed decimals must fail
    Result<f64, JsonError> bad_dec1 = @from_json(f64, "1.");
    Result<f64, JsonError> bad_dec2 = @from_json(f64, "0.");
    @assert(bad_dec1.failed(), "malformed '1.' must fail");
    @assert(bad_dec2.failed(), "malformed '0.' must fail");

    // Invalid leading zeros must fail
    Result<i64, JsonError> bad_lead1 = @from_json(i64, "01");
    Result<i64, JsonError> bad_lead2 = @from_json(i64, "00");
    Result<i64, JsonError> bad_lead3 = @from_json(i64, "-05");
    Result<f64, JsonError> bad_lead4 = @from_json(f64, "01.5");
    @assert(bad_lead1.failed(), "leading zero '01' must fail");
    @assert(bad_lead2.failed(), "leading zero '00' must fail");
    @assert(bad_lead3.failed(), "leading zero '-05' must fail");
    @assert(bad_lead4.failed(), "leading zero '01.5' must fail");

    STDOUT.write_str(encoded);
    STDOUT.write_str("\n");
    return 0;
}
