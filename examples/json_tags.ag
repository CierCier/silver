// examples/json_tags.ag — JSON serialization with field metadata tags & #[serialize].
//
// Demonstrates:
// 1. Struct field metadata tags ("json:key", "db:column", "yaml:key")
// 2. #[serialize] attribute for automatic ToJson and FromJson synthesis
// 3. Serializing tagged structs with @json(...)
// 4. Deserializing strongly-typed structs and primitives with @from_json(...)

import std.io;
import std.json;
import std.optional;

/// User profile struct with #[serialize] and metadata tags for JSON and database mapping.
#[serialize]
struct UserProfile {
    i32 id "json:id db:user_id";
    str username "json:username db:handle";
    str email "json:email";
    bool is_admin "json:is_admin";
}

/// Server configuration struct with multi-format metadata tags and extensible #[serialize(json, yaml)].
#[serialize(json, yaml)]
struct ServerConfig {
    str host "json:host yaml:Host";
    i32 port "json:port yaml:Port";
    bool tls "json:tls yaml:TLS";
}

i32 main() {
    // 1. Serialize UserProfile struct with @json (using synthesized ToJson)
    UserProfile profile;
    profile.id = 101;
    profile.username = "alice";
    profile.email = "alice@example.com";
    profile.is_admin = true;

    str profile_json = @json(profile);
    @println("UserProfile JSON:\n  {}", profile_json);

    // 2. Deserialize JSON string directly into UserProfile struct with @from_json
    Result<UserProfile, JsonError> decoded_profile = @from_json(
        UserProfile,
        "{\"id\":102,\"username\":\"bob\",\"email\":\"bob@example.com\",\"is_admin\":false}"
    );
    if (!decoded_profile.failed()) {
        UserProfile user = decoded_profile.unwrap();
        @println("\nDecoded UserProfile struct:");
        @println("  id: {}, username: {}, email: {}, is_admin: {}",
            user.id, user.username, user.email, user.is_admin);
    }

    // 3. Serialize ServerConfig struct with @json
    ServerConfig config;
    config.host = "127.0.0.1";
    config.port = 8080;
    config.tls = true;

    str config_json = @json(config);
    @println("\nServerConfig JSON:\n  {}", config_json);

    // 4. Deserialize JSON string into primitive types using @from_json
    Result<String, JsonError> decoded_name = @from_json(String, "\"alice\"");
    if (!decoded_name.failed()) {
        String name = decoded_name.unwrap();
        @println("\nDecoded string: {}", (str)name.to_str());
    }

    Result<i32, JsonError> decoded_port = @from_json(i32, "8080");
    if (!decoded_port.failed()) {
        @println("Decoded integer: {}", decoded_port.unwrap());
    }

    // 5. Optionals and null handling in JSON
    Optional<i32> maybe_val = Optional<i32>.some(42);
    Optional<i32> no_val = Optional<i32>.none();
    @println("\nOptional Some(42) -> {}", @json(maybe_val));
    @println("Optional None     -> {}", @json(no_val));

    return 0;
}
