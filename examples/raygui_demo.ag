// examples/raygui_demo.ag
// Complete interactive GUI showcase built in Silver using raylib + raygui via AGSM.

import vendor.gfx.raylib;
import vendor.gfx.raygui;
import std.sys.entry;

Color make_color(u8 r, u8 g, u8 b, u8 a) {
    Color c;
    c.r = r;
    c.g = g;
    c.b = b;
    c.a = a;
    return move c;
}

Rectangle make_rect(f32 x, f32 y, f32 width, f32 height) {
    Rectangle r;
    r.x = x;
    r.y = y;
    r.width = width;
    r.height = height;
    return move r;
}

i32 main() {
    i32 screen_width = 860;
    i32 screen_height = 580;

    InitWindow(screen_width, screen_height, (const i8*)"Silver + RayGUI Interactive Showcase");
    SetTargetFPS(60);

    // State
    i32 click_count = 0;
    bool show_pulse = true;
    bool dark_canvas = false;
    f32 shape_size = 55.0;
    f32 progress_val = 0.25;
    bool auto_progress = true;
    f32 pulse_phase = 0.0;

    // Palette
    Color bg_light = make_color(245, 246, 250, 255);
    Color canvas_dark = make_color(24, 28, 36, 255);
    Color canvas_light = make_color(230, 235, 245, 255);
    Color primary_blue = make_color(52, 152, 219, 255);
    Color pulse_cyan = make_color(46, 204, 113, 160);
    Color accent_orange = make_color(230, 126, 34, 255);

    while (!WindowShouldClose()) {
        // Animation updates
        if (auto_progress) {
            progress_val = progress_val + 0.003;
            if (progress_val > 1.0) {
                progress_val = 0.0;
            }
        }
        pulse_phase = pulse_phase + 0.05;
        if (pulse_phase > 6.283) {
            pulse_phase = 0.0;
        }

        BeginDrawing();
        ClearBackground(bg_light);

        // Header / Window Box
        WindowBox(make_rect(10.0, 10.0, 840.0, 560.0), (const i8*)"Silver Language — RayGUI Controls Demo");

        // Left Controls Panel
        GroupBox(make_rect(25.0, 45.0, 390.0, 480.0), (const i8*)"Interactive Control Panel");

        Label(make_rect(40.0, 65.0, 360.0, 24.0), (const i8*)"Welcome to the native Silver GUI demo!");

        // Buttons Section
        if (Button(make_rect(40.0, 95.0, 170.0, 35.0), (const i8*)"Increment Count (+1)") != 0) {
            click_count = click_count + 1;
        }
        if (Button(make_rect(220.0, 95.0, 170.0, 35.0), (const i8*)"Reset Counter") != 0) {
            click_count = 0;
        }

        // Toggles & Checkboxes
        CheckBox(make_rect(40.0, 145.0, 20.0, 20.0), (const i8*)"Dark Canvas Theme", &dark_canvas);
        CheckBox(make_rect(40.0, 175.0, 20.0, 20.0), (const i8*)"Enable Visual Pulse Ring", &show_pulse);
        CheckBox(make_rect(40.0, 205.0, 20.0, 20.0), (const i8*)"Auto-Advance Progress Bar", &auto_progress);

        // Slider for Shape Size
        Label(make_rect(40.0, 240.0, 360.0, 20.0), (const i8*)"Adjust Shape Radius:");
        Slider(make_rect(40.0, 265.0, 300.0, 22.0), (const i8*)"15", (const i8*)"120", &shape_size, 15.0, 120.0);

        // Progress Bar
        Label(make_rect(40.0, 300.0, 360.0, 20.0), (const i8*)"Live Progress Indicator:");
        ProgressBar(make_rect(40.0, 325.0, 300.0, 22.0), (const i8*)"0%", (const i8*)"100%", &progress_val, 0.0, 1.0);

        // Action Trigger Button
        if (Button(make_rect(40.0, 365.0, 350.0, 35.0), (const i8*)"Trigger Pulse Burst (+10 Clicks)") != 0) {
            click_count = click_count + 10;
            if (shape_size < 110.0) {
                shape_size = shape_size + 5.0;
            }
        }

        // Info Summary Card inside Controls
        Panel(make_rect(40.0, 415.0, 350.0, 95.0), (const i8*)0);
        Label(make_rect(50.0, 422.0, 330.0, 20.0), (const i8*)"• Compiled statically via LLVM & AGSM");
        Label(make_rect(50.0, 444.0, 330.0, 20.0), (const i8*)"• Zero-cost C wrapper ABI interop");
        Label(make_rect(50.0, 466.0, 330.0, 20.0), (const i8*)"• Deterministic drop flags and RAII safety");
        Label(make_rect(50.0, 488.0, 330.0, 20.0), (const i8*)"• Press ESC or close window to exit");

        // Right Preview Canvas Area
        GroupBox(make_rect(435.0, 45.0, 400.0, 480.0), (const i8*)"Dynamic Rendering Viewport");

        // Canvas Background Box
        Color cur_canvas_bg = canvas_light;
        if (dark_canvas) {
            cur_canvas_bg = canvas_dark;
        }
        DrawRectangle(450, 70, 370, 350, cur_canvas_bg);
        DrawRectangleLines(450, 70, 370, 350, make_color(180, 190, 205, 255));

        // Center of viewport: (635, 245)
        i32 center_x = 635;
        i32 center_y = 245;

        // Visual pulse ring effect
        if (show_pulse) {
            f32 ring_radius = shape_size + 15.0 + (pulse_phase * 4.0);
            DrawCircleLines(center_x, center_y, ring_radius, pulse_cyan);
            DrawCircleLines(center_x, center_y, ring_radius + 6.0, make_color(52, 152, 219, 90));
        }

        // Main Shape
        DrawCircle(center_x, center_y, shape_size, primary_blue);
        DrawCircleLines(center_x, center_y, shape_size, make_color(255, 255, 255, 200));

        // Inner decorative circle
        f32 inner_radius = shape_size * 0.4;
        if (inner_radius > 4.0) {
            DrawCircle(center_x, center_y, inner_radius, accent_orange);
        }

        // Live Metric Badges
        Panel(make_rect(450.0, 435.0, 370.0, 75.0), (const i8*)0);

        Label(make_rect(465.0, 445.0, 170.0, 24.0), (const i8*)"Total Button Clicks:");
        DrawRectangle(620, 445, 60, 24, make_color(52, 152, 219, 40));
        DrawRectangleLines(620, 445, 60, 24, primary_blue);

        // Draw simple digits badge
        i32 count_display = click_count;
        if (count_display > 999) { count_display = 999; }
        DrawText((const i8*)"ACTIVE", 628, 449, 12, primary_blue);

        Label(make_rect(465.0, 475.0, 170.0, 24.0), (const i8*)"Engine FPS Monitor:");
        DrawText((const i8*)"60 FPS", 628, 479, 12, make_color(46, 204, 113, 255));

        // Bottom Footer
        Label(make_rect(30.0, 535.0, 800.0, 20.0), (const i8*)"Silver Language Native GUI Showcase — Powered by Raylib & RayGUI");

        EndDrawing();
    }

    CloseWindow();
    return 0;
}
