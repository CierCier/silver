// examples/threading.ag — idiomatic threading in Silver.
//
// The concurrency building blocks, with the routine procedures for each:
//
//   launch f(args...)   spawn a thread; every argument is MOVED into the
//                       child.  Arguments must be Send: primitives, owned
//                       containers (Vec/Box/String/Bytes/HashMap), and
//                       structs with value fields qualify; Rc, GC handles,
//                       raw pointers, and references do not (Send gate).
//   Task<T>             the handle; T is the callee's return type.
//   wait t              join t and move out its result (consumes the handle).
//   defer wait t;       join on EVERY exit path of the enclosing scope,
//                       early returns included.
//   Mutex<T>/Guard<T>   RAII-guarded shared value; the guard unlocks on
//                       drop, so the lock can never be left held.
//   WaitGroup           counter coordinated with add/done/wait_all.
//   Channel<T>          unbounded MPSC FIFO: send(T) / recv() / close().
//
// There is NO auto-join at scope exit: an unwaited Task keeps running and
// is reaped by the exit-time join-all.  `wait` (or `defer wait`) is the
// only way to observe completion.
//
// The runtime entry point (std.sys.entry) is imported automatically; every
// binary links statically against the pure-Silver runtime (no libc).

import std.thread;   // launch/wait runtime (threads are joined at exit)
import std.sync;     // Mutex<T>, Guard<T>, WaitGroup
import std.channel;  // Channel<T>

// --- 1. Shared state: Mutex<T> + Guard<T> (RAII) --------------------------
// A zero-initialized global `Mutex<i64>` is a valid unlocked mutex holding
// 0, so globals need no constructor call.

Mutex<i64> g_counter;
WaitGroup g_wg;

void worker_inc(i64 n) {
    for (i64 i = 0; i < n; i = i + 1) {
        Guard<i64> g = g_counter.lock();  // RAII: unlocks when g drops
        g.set(g.get() + 1);
    }
    g_wg.done();
}

// --- 2. Message passing: Channel<T> (MPSC) --------------------------------
// Many senders, one consumer.  send() moves the value in; recv() blocks
// until a value is available.  FIFO order is preserved.

Channel<i64> g_ch;

void producer(i64 first, i64 count) {
    for (i64 i = 0; i < count; i = i + 1) {
        g_ch.send(first + i);
    }
}

// --- 3. Routine procedures ------------------------------------------------
// A task that returns a value: `wait` moves the result out of the handle.

i64 compute(i64 x) {
    return x * 2;
}

// Deferred join: the sanctioned join-on-scope-exit idiom.  `defer wait t;`
// runs on every exit path of this function, early returns included.

i64 run_with_deferred_join(i64 x) {
    Task<i64> t = launch compute(x);
    defer wait t;
    if (x < 0) {
        return -1;   // the deferred wait still joins t before returning
    }
    return 0;
}

// --- main -----------------------------------------------------------------

i64 main() {
    // 1. Four tasks increment a Mutex-guarded counter; a WaitGroup
    //    coordinates completion (wait_all instead of wait-ing each task).
    g_wg.add(4);
    Task<void> t0 = launch worker_inc(2500);
    Task<void> t1 = launch worker_inc(2500);
    Task<void> t2 = launch worker_inc(2500);
    Task<void> t3 = launch worker_inc(2500);
    g_wg.wait_all();
    {
        Guard<i64> g = g_counter.lock();  // scope-end drop releases the lock
        if (g.get() != 10000) { return 1; }
    }

    // 2. Two producers feed one consumer; the sum of 0..499 and 1000..1499
    //    is 749500 regardless of interleaving.
    Task<void> p0 = launch producer(0, 500);
    Task<void> p1 = launch producer(1000, 500);
    i64 sum = 0;
    i64 received = 0;
    while (received < 1000) {
        sum = sum + g_ch.recv();
        received = received + 1;
    }
    wait p0;
    wait p1;
    if (sum != 749500) { return 2; }
    g_ch.close();  // frees the queue buffer for a leak-check-clean exit

    // 3. Join a task and read its result.
    Task<i64> t = launch compute(21);
    i64 r = wait t;
    if (r != 42) { return 3; }

    // 4. Deferred join fires on the early-return path too.
    if (run_with_deferred_join(-1) != -1) { return 4; }

    return 0;
}
