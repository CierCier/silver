import frontend.ast;
import std.result;

const i64 FORMAT_MAX_BYTES = 16777216;

struct SourceFormatOptions {
    i64 tab_size;
    bool insert_spaces;
    bool insert_final_newline;
}

enum SourceFormatError { InvalidSyntax; InvalidOptions; OutputLimit; ChangedTokens; }

struct SourceFormatWriter {
    String text;
    Vec<TokenKind> groups;
    i64 depth;
    SourceFormatOptions options;
    str newline;
    bool failed;
}

impl SourceFormatWriter {
    bool line_start(SourceFormatWriter* self) {
        return self.text.len() == 0 || self.text.data[self.text.len() - 1] == (u8)'\n'
            || self.text.data[self.text.len() - 1] == (u8)'\r';
    }

    void line(SourceFormatWriter* self) {
        if (self.text.len() == 0 || self.text.data[self.text.len() - 1] == (u8)'\n') { return; }
        if (self.text.data[self.text.len() - 1] == (u8)'\r') {
            if (strcmp(self.newline, "\r") != 0) { self.text.push('\n'); }
        } else { self.text.push_str(self.newline); }
    }

    void space(SourceFormatWriter* self) {
        if (!self.line_start() && self.text.data[self.text.len() - 1] != (u8)' '
            && self.text.data[self.text.len() - 1] != (u8)'\t') { self.text.push(' '); }
    }

    void indent(SourceFormatWriter* self) {
        if (!self.line_start()) { return; }
        i64 count = self.depth;
        if (self.options.insert_spaces) { count *= self.options.tab_size; }
        if (count > FORMAT_MAX_BYTES - self.text.len()) { self.failed = true; return; }
        i64 i = 0;
        while (i < count) { self.text.push(self.options.insert_spaces ? ' ' : '\t'); i += 1; }
    }
}

str source_newline(str text, TokenStream* tokens) {
    i64 i = 0; i64 token = 0;
    while (token < tokens.len()) {
        Token* current = tokens.get(token);
        while (i < current.span.start) {
            if (text[i] == '\r') { return text[i + 1] == '\n' ? "\r\n" : "\r"; }
            if (text[i] == '\n') { return i > 0 && text[i - 1] == '\r' ? "\r\n" : "\n"; }
            i += 1;
        }
        i = current.span.end; token += 1;
    }
    return "\n";
}

bool format_preserves_spacing(TokenKind kind) {
    return kind == TokenKind.Star || kind == TokenKind.BitwiseAnd || kind == TokenKind.Less
        || kind == TokenKind.Greater || kind == TokenKind.RightShift || kind == TokenKind.LeftShift;
}

bool format_space_before(Token* previous, Token* current) {
    if (previous == (Token*)0) { return false; }
    TokenKind before = previous.kind; TokenKind kind = current.kind;
    if (kind == TokenKind.Semicolon || kind == TokenKind.Comma || kind == TokenKind.RightParen
        || kind == TokenKind.RightBracket || kind == TokenKind.Dot || kind == TokenKind.DoubleColon
        || kind == TokenKind.Colon || kind == TokenKind.LeftBracket || kind == TokenKind.Increment || kind == TokenKind.Decrement) { return false; }
    if (before == TokenKind.LeftParen || before == TokenKind.LeftBracket || before == TokenKind.Dot
        || before == TokenKind.DoubleColon || before == TokenKind.At || before == TokenKind.Not || before == TokenKind.BitwiseNot) { return false; }
    if (kind == TokenKind.LeftParen) {
        return before == TokenKind.If || before == TokenKind.While || before == TokenKind.For
            || before == TokenKind.Match || before == TokenKind.Return;
    }
    if (format_preserves_spacing(kind) || format_preserves_spacing(before)) {
        return current.span.start > previous.span.end;
    }
    return true;
}

bool format_syntax_valid(TokenStream* tokens) {
    DiagnosticBag diagnostics = DiagnosticBag.new(); NodePool pool = NodePool.new(); SyntaxTree tree;
    parse(tokens, &diagnostics, &pool, &tree); bool valid = diagnostics.is_empty(); pool.destroy(); return valid;
}

bool format_same_tokens(TokenStream* before, TokenStream* after) {
    if (before.len() != after.len()) { return false; }
    i64 i = 0;
    while (i < before.len()) {
        Token* left = before.get(i); Token* right = after.get(i);
        if (left.kind != right.kind || !left.text.equals(right.text.to_str())
            || (left.kind == TokenKind.Comment && left.comment_kind != right.comment_kind)) { return false; }
        i += 1;
    }
    return true;
}

bool format_has_blank_line(str text, i64 begin, i64 end) {
    i64 lines = 0;
    while (begin < end) {
        if (text[begin] == '\r') {
            lines += 1; if (begin + 1 < end && text[begin + 1] == '\n') { begin += 1; }
        } else if (text[begin] == '\n') { lines += 1; }
        if (lines >= 2) { return true; } begin += 1;
    }
    return false;
}

Result<String, SourceFormatError> format_source(str text, SourceFormatOptions* options) {
    if (options.tab_size <= 0 || options.tab_size > 256) { return Result<String, SourceFormatError>.err(SourceFormatError.InvalidOptions); }
    TokenStream tokens = TokenStream.new(); DiagnosticBag diagnostics = DiagnosticBag.new();
    lex(String.from_str(text), &tokens, &diagnostics);
    if (!diagnostics.is_empty() || !format_syntax_valid(&tokens)) { return Result<String, SourceFormatError>.err(SourceFormatError.InvalidSyntax); }
    SourceFormatWriter writer; writer.text = String.new(); writer.groups = Vec<TokenKind>.new();
    writer.depth = 0; writer.options = *options; writer.newline = source_newline(text, &tokens); writer.failed = false;
    i64 i = 0; Token* previous = (Token*)0;
    while (i < tokens.len() && tokens.get(i).kind != TokenKind.Eof && !writer.failed) {
        Token* token = tokens.get(i); TokenKind kind = token.kind;
        Token* next = i + 1 < tokens.len() ? tokens.get(i + 1) : (Token*)0;
        if (kind == TokenKind.RightBrace) {
            if (writer.depth > 0) { writer.depth -= 1; }
            if (previous != (Token*)0 && previous.kind != TokenKind.LeftBrace) { writer.line(); }
        }
        // A blank line can keep a doc comment detached from the next declaration.
        if (previous != (Token*)0 && format_has_blank_line(text, previous.span.end, token.span.start)) {
            writer.line(); writer.text.push_str(writer.newline);
        }
        if (kind == TokenKind.Comment && previous != (Token*)0 && token.span.start_line > previous.span.end_line) { writer.line(); }
        if (!writer.line_start() && format_space_before(previous, token)
            && !(kind == TokenKind.RightBrace && previous != (Token*)0 && previous.kind == TokenKind.LeftBrace)) { writer.space(); }
        writer.indent();
        i64 length = token.span.end - token.span.start;
        if (length > FORMAT_MAX_BYTES - writer.text.len()) { writer.failed = true; break; }
        writer.text.push_bytes((u8*)text + token.span.start, length);
        if (is_open(token)) { writer.groups.push(kind); }
        else if (is_close(token) && writer.groups.len() > 0) { writer.groups.pop(); }
        if (kind == TokenKind.LeftBrace) {
            writer.depth += 1;
            if (next != (Token*)0 && next.kind != TokenKind.RightBrace) { writer.line(); }
        } else if (kind == TokenKind.RightBrace) {
            if (next == (Token*)0 || (next.kind != TokenKind.Semicolon && next.kind != TokenKind.Comma
                && next.kind != TokenKind.RightParen && next.kind != TokenKind.RightBracket
                && next.kind != TokenKind.Dot && next.kind != TokenKind.Else)) { writer.line(); }
        } else if (kind == TokenKind.Semicolon) {
            if (writer.groups.len() == 0 || writer.groups.get(writer.groups.len() - 1) != TokenKind.LeftParen) { writer.line(); }
        } else if (kind == TokenKind.Comma) {
            if (writer.groups.len() > 0 && writer.groups.get(writer.groups.len() - 1) == TokenKind.LeftBrace) { writer.line(); }
        } else if (kind == TokenKind.Comment) {
            if (text[token.span.start + 1] == '/'
                || next == (Token*)0 || next.span.start_line > token.span.end_line) { writer.line(); }
        }
        previous = token; i += 1;
    }
    if (writer.failed || writer.text.len() > FORMAT_MAX_BYTES) { return Result<String, SourceFormatError>.err(SourceFormatError.OutputLimit); }
    i64 source_length = strlen(text);
    bool final_newline = options.insert_final_newline || (source_length > 0 && (text[source_length - 1] == '\n' || text[source_length - 1] == '\r'));
    if (final_newline) { writer.line(); }
    else {
        i64 length = writer.text.len();
        while (length > 0 && (writer.text.data[length - 1] == (u8)'\n' || writer.text.data[length - 1] == (u8)'\r')) { length -= 1; }
        if (length < writer.text.len()) { writer.text = writer.text.substr(0, length); }
    }
    if (writer.text.len() > FORMAT_MAX_BYTES) { return Result<String, SourceFormatError>.err(SourceFormatError.OutputLimit); }
    TokenStream checked = TokenStream.new(); DiagnosticBag errors = DiagnosticBag.new();
    lex(writer.text.clone(), &checked, &errors);
    if (!errors.is_empty() || !format_same_tokens(&tokens, &checked)) { return Result<String, SourceFormatError>.err(SourceFormatError.ChangedTokens); }
    return Result<String, SourceFormatError>.ok(move writer.text);
}
