// Owner initialization plans: the typed storage tree of each local binding
// in every cfg-active function, built before expression checking. Move and
// initialization rules are checked on the typed body by frontend.move_flow.
import std.mem.vec;
import frontend.ast;
import frontend.bindings;
import frontend.cfg;
import frontend.diagnostics;
import frontend.init_plan;
import frontend.module_loader;
import frontend.symbols;
import frontend.typecheck_expr;
import frontend.types;

/// Returns a function item's body block, or null.
SyntaxNode* ownership_function_body(SyntaxNode* function) {
    if (function == (SyntaxNode*)0) {
        return (SyntaxNode*)0;
    }
    SyntaxNode* child = function.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Block) {
            return child;
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

/// Appends a plan for every typed local binding of `function` to `plans`.
/// A generic binding's plan stays empty until its types are specialized.
void ownership_collect_plans(SyntaxNode* function, SymbolTable* symbols, SyntaxNode* root,
                             Vec<InitOwnerPlan>* plans) {
    Vec<Binding> bindings = Vec<Binding>.new();
    collect_function_bindings(function, &bindings);
    Vec<u32> binding_types = Vec<u32>.new();
    typecheck_binding_types(symbols, &symbols.types, root, &bindings, &binding_types);
    Span body = ownership_function_body(function).span;
    i64 i = 0;
    while (i < bindings.len()) {
        Binding* binding = bindings.get_ptr(i);
        u32 type_id = binding_types.get(i);
        if (type_id != TYPE_UNKNOWN) {
            InitOwnerPlan plan = InitOwnerPlan.new(symbols.names.intern(binding.name),
                type_id, binding.span, body);
            if (!init_plan_build(&plan, &symbols.types, &symbols.names, root)) {
                plan.nodes.len = 0;
                plan.projections.len = 0;
            }
            plans.push(move plan);
        }
        i += 1;
    }
}

/// Registers source struct layouts and builds the owner plans of every
/// cfg-active function of `tree`. The caller owns the returned plans.
Vec<InitOwnerPlan> build_owner_plans(SyntaxTree* tree, SymbolTable* symbols,
                                     DiagnosticBag* diagnostics, CfgSet* cfg) {
    Vec<InitOwnerPlan> plans = Vec<InitOwnerPlan>.new();
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    cfg_collect_items(tree.root, cfg, diagnostics, &items);
    i64 i = 0;
    while (i < items.len()) {
        if (items.get(i).kind == NodeKind.Struct) {
            module_register_source_struct(&symbols.types, items.get(i));
        }
        i += 1;
    }
    i = 0;
    while (i < items.len()) {
        SyntaxNode* item = items.get(i);
        if (item.kind == NodeKind.Function && ownership_function_body(item) != (SyntaxNode*)0) {
            ownership_collect_plans(item, symbols, tree.root, &plans);
        }
        i += 1;
    }
    return move plans;
}
