// Initial ownership pass: track explicit move/wait transfers in a function
// and report a later read of the same local. The pass is deliberately
// conservative and will grow alongside the typed place model.
import frontend.types;
import std.mem.vec;
import std.mem.memory;
import std.intern;
import std.collections.bitset;
import frontend.ast;
import frontend.diagnostics;
import frontend.cfg;
import frontend.messages;
const u32 MAX_OWNERSHIP_SCAN_DEPTH = 256;


struct EnumPayload {
    str enum_name;
    str variant_name;
    str type_name;
}

struct OwnershipVar {
    u32 name_id;
    u32 type_id;
    Span declaration_span;
    Span scope;
}

struct MoveOrigin {
    u32 name_id;
    u32 variable_index;
    Span span;
    bool active;
}


struct OwnershipAnalyzer {
    Interner names;
    BitSet moved_set;
    BitSet observed_set;
    Vec<MoveOrigin> move_origins;
    Vec<str> drop_types;
    TypeTable type_table;
    Vec<OwnershipVar> variables;
    Vec<EnumPayload> enum_payloads;
    DiagnosticBag* diagnostics;
    bool failed;
    bool depth_error_reported;
}
bool ownership_path_prefix(str prefix, str path) {
    i64 prefix_len = strlen(prefix);
    i64 i = 0;
    while (i < prefix_len) {
        if (path[i] == 0 || prefix[i] != path[i]) {
            return false;
        }
        i += 1;
    }
    return path[prefix_len] == 0 || path[prefix_len] == (u8)'.'
        || path[prefix_len] == (u8)'[' || path[prefix_len] == (u8)'*';
}

bool ownership_place_overlaps(str left, str right) {
    return ownership_path_prefix(left, right) || ownership_path_prefix(right, left);
}

bool ownership_place_is_within(str place, str parent) {
    return ownership_path_prefix(parent, place);
}

impl OwnershipAnalyzer {
    OwnershipAnalyzer new(DiagnosticBag* diagnostics) {
        OwnershipAnalyzer analyzer;
        analyzer.names = Interner.new();
        analyzer.moved_set = BitSet.new();
        analyzer.type_table = TypeTable.new();
        analyzer.variables = Vec<OwnershipVar>.new();
        analyzer.observed_set = BitSet.new();
        analyzer.drop_types = Vec<str>.new();
        analyzer.enum_payloads = Vec<EnumPayload>.new();
        analyzer.diagnostics = diagnostics;
        analyzer.failed = false;
        analyzer.depth_error_reported = false;
        return analyzer;
    }

    i64 variable_index(OwnershipAnalyzer* self, str place, Span use_span) {
        String root = String.new();
        i64 i = 0;
        while (place[i] == (u8)'*') { i += 1; }
        while (place[i] != 0 && place[i] != (u8)'.' && place[i] != (u8)'['
            && place[i] != (u8)'*') {
            root.push(place[i]);
            i += 1;
        }
        u32 root_id = self.names.intern(root.to_str());
        root.drop();
        i64 selected = -1;
        i64 selected_scope_width = 0;
        i = 0;
        while (i < self.variables.len()) {
            OwnershipVar* variable = self.variables.get_ptr(i);
            Span scope = variable.scope;
            if (variable.name_id == root_id
                && variable.declaration_span.start <= use_span.start
                && scope.start <= use_span.start && use_span.end <= scope.end) {
                i64 scope_width = scope.end - scope.start;
                if (selected < 0 || scope_width < selected_scope_width
                    || (scope_width == selected_scope_width
                        && variable.declaration_span.start
                            > self.variables.get_ptr(selected).declaration_span.start)) {
                    selected = i;
                    selected_scope_width = scope_width;
                }
            }
            i += 1;
        }
        return selected;
    }

    bool needs_move_tracking(OwnershipAnalyzer* self, str place, Span use_span) {
        i64 index = self.variable_index(place, use_span);
        if (index < 0) { return false; }
        OwnershipVar* variable = self.variables.get_ptr(index);
        str type_name = self.type_table.type_name(variable.type_id);
        if (contains_drop_type(self, type_name)) { return true; }
        return !self.type_table.properties(variable.type_id).is_copy;
    }

    void observe(OwnershipAnalyzer* self, str place, Span span) {
        i64 variable_index = self.variable_index(place, span);
        if (variable_index < 0) { return; }
        u32 place_id = self.names.intern(place);
        Span origin_span = span;
        u32 moved_name_id = 0;
        bool moved = false;
        i64 i = self.move_origins.len() - 1;
        while (i >= 0) {
            MoveOrigin* origin = self.move_origins.get_ptr(i);
            if (origin.active && origin.variable_index == (u32)variable_index
                && ownership_place_overlaps(self.names.get(origin.name_id), place)) {
                origin_span = origin.span;
                moved_name_id = origin.name_id;
                moved = true;
                break;
            }
            i -= 1;
        }
        if (moved) {
            String message = use_of_moved_value(self.names.get(moved_name_id));
            String note = String.from_str(note_value_moved_here());
            self.diagnostics.error_with_note(span, move message, origin_span, move note);
            self.failed = true;
        }
        self.observed_set.set((i64)place_id);
    }

    void transfer(OwnershipAnalyzer* self, str place, Span span, bool continues) {
        i64 variable_index = self.variable_index(place, span);
        if (variable_index < 0 || !self.needs_move_tracking(place, span)) { return; }
        self.observe(place, span);
        if (!continues) { return; }
        MoveOrigin origin;
        origin.name_id = self.names.intern(place);
        origin.variable_index = (u32)variable_index;
        origin.span = span;
        origin.active = true;
        self.move_origins.push(origin);
        self.moved_set.set((i64)origin.name_id);
    }

    void reinitialize(OwnershipAnalyzer* self, str place, Span span) {
        i64 variable_index = self.variable_index(place, span);
        if (variable_index < 0) { return; }
        i64 i = 0;
        while (i < self.move_origins.len()) {
            MoveOrigin* origin = self.move_origins.get_ptr(i);
            str moved = self.names.get(origin.name_id);
            if (origin.active && origin.variable_index == (u32)variable_index
                && ownership_place_is_within(moved, place)) {
                origin.active = false;
            }
            i += 1;
        }
        u32 name_id = self.names.intern(place);
        self.moved_set.clear_bit((i64)name_id);
    }
}

bool ownership_text_equals(str left, str right) {
    return strcmp(left, right) == 0;
}

bool contains_drop_type(OwnershipAnalyzer* analyzer, str name) {
    i64 i = 0;
    while (i < analyzer.drop_types.len()) {
        if (ownership_text_equals(analyzer.drop_types.get(i), name)) {
            return true;
        }
        i += 1;
    }
    return false;
}

void collect_drop_impl(OwnershipAnalyzer* analyzer, SyntaxNode* item) {
    if (item.kind != NodeKind.Impl) {
        return;
    }
    SyntaxNode* child = item.first_child;
    bool saw_drop = false;
    bool saw_for = false;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Token && ownership_text_equals(child.text, "Drop")) {
            saw_drop = true;
        } else if (saw_drop && child.kind == NodeKind.Token && ownership_text_equals(child.text, "for")) {
            saw_for = true;
        } else if (saw_for && child.kind == NodeKind.Token && child.token_kind == TokenKind.Identifier) {
            analyzer.drop_types.push(child.text);
            analyzer.type_table.mark_type_needs_drop(child.text);
            return;
        }
        child = child.next_sibling;
    }
}

void collect_enum(OwnershipAnalyzer* analyzer, SyntaxNode* item) {
    if (item.kind != NodeKind.Enum) {
        return;
    }
    SyntaxNode* child = item.first_child;
    str enum_name = "";
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Token && ownership_text_equals(child.text, "enum")) {
            child = child.next_sibling;
            if (child != (SyntaxNode*)0 && child.token_kind == TokenKind.Identifier) {
                enum_name = child.text;
            }
            break;
        }
        child = child.next_sibling;
    }
    if (strlen(enum_name) == 0) {
        return;
    }
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Block) {
            SyntaxNode* variant = child.first_child;
            while (variant != (SyntaxNode*)0) {
                if (variant.kind == NodeKind.Token && variant.token_kind == TokenKind.Identifier) {
                    SyntaxNode* payload = variant.next_sibling;
                    if (payload != (SyntaxNode*)0 && payload.kind == NodeKind.Parenthesized) {
                        SyntaxNode* payload_type = payload.first_child;
                        if (payload_type != (SyntaxNode*)0 && payload_type.kind == NodeKind.Token) {
                            EnumPayload info;
                            info.enum_name = enum_name;
                            info.variant_name = variant.text;
                            info.type_name = payload_type.text;
                            analyzer.enum_payloads.push(move info);
                        }
                    }
                }
                variant = variant.next_sibling;
            }
            break;
        }
        child = child.next_sibling;
    }
}

void ownership_depth_error(OwnershipAnalyzer* analyzer, SyntaxNode* node) {
    if (!analyzer.depth_error_reported) {
        String message = String.from_str("ownership analysis nesting exceeds maximum depth (256)");
        analyzer.diagnostics.error(node.span, move message);
        analyzer.failed = true;
        analyzer.depth_error_reported = true;
    }
}

SyntaxNode* first_group_leaf(OwnershipAnalyzer* analyzer, SyntaxNode* node, u32 depth) {
    if (depth >= MAX_OWNERSHIP_SCAN_DEPTH) {
        ownership_depth_error(analyzer, node);
        return (SyntaxNode*)0;
    }
    if (node == (SyntaxNode*)0) {
        return (SyntaxNode*)0;
    }
    if (node.kind == NodeKind.Token) {
        return node;
    }
    return first_group_leaf(analyzer, node.first_child, depth + 1);
}

void scan_constructor_group(OwnershipAnalyzer* analyzer, SyntaxNode* node, u32 depth) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (depth >= MAX_OWNERSHIP_SCAN_DEPTH) {
        ownership_depth_error(analyzer, node);
        return;
    }
    if (node.kind == NodeKind.Parenthesized && node.parent != (SyntaxNode*)0) {
        SyntaxNode* previous = (SyntaxNode*)0;
        SyntaxNode* before_previous = (SyntaxNode*)0;
        SyntaxNode* before_third = (SyntaxNode*)0;
        SyntaxNode* child = node.parent.first_child;
        while (child != (SyntaxNode*)0 && child != node) {
            before_third = before_previous;
            before_previous = previous;
            previous = child;
            child = child.next_sibling;
        }
        if (previous != (SyntaxNode*)0 && before_previous != (SyntaxNode*)0 && before_third != (SyntaxNode*)0
            && previous.kind == NodeKind.Token && previous.token_kind == TokenKind.Identifier
            && before_previous.text == "."
            && before_third.token_kind == TokenKind.Identifier) {
            i64 i = 0;
            while (i < analyzer.enum_payloads.len()) {
                EnumPayload* info = analyzer.enum_payloads.get_ptr(i);
                if (ownership_text_equals(info.enum_name, before_third.text)
                    && ownership_text_equals(info.variant_name, previous.text)
                    && contains_drop_type(analyzer, info.type_name)) {
                    SyntaxNode* payload = first_group_leaf(analyzer, node, depth + 1);
                    if (payload != (SyntaxNode*)0 && payload.token_kind == TokenKind.Identifier
                        && !ownership_text_equals(payload.text, "move")) {
                        String message = String.from_str("payload of type '");
                        message.push_str(info.type_name);
                        message.push_str("' must be moved into the enum (it owns a resource)");
                        analyzer.diagnostics.error(payload.span, move message);
                        analyzer.failed = true;
                    }
                }
                i += 1;
            }
        }
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        scan_constructor_group(analyzer, child, depth + 1);
        child = child.next_sibling;
    }
}

void collect_struct_properties(OwnershipAnalyzer* analyzer, SyntaxNode* item) {
    if (item.kind != NodeKind.Struct) { return; }
    str struct_name = "";
    SyntaxNode* block = (SyntaxNode*)0;
    SyntaxNode* child = item.first_child;
    while (child != (SyntaxNode*)0) {
        if (ownership_text_equals(child.text, "struct")) {
            child = child.next_sibling;
            if (child != (SyntaxNode*)0 && child.token_kind == TokenKind.Identifier) {
                struct_name = child.text;
            }
        } else if (child.kind == NodeKind.Block) {
            block = child;
        }
        child = child.next_sibling;
    }
    if (strlen(struct_name) == 0 || block == (SyntaxNode*)0) { return; }
    Vec<u32> fields = Vec<u32>.new();
    child = block.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.token_kind == TokenKind.Identifier && child.next_sibling != (SyntaxNode*)0
            && child.next_sibling.token_kind == TokenKind.Identifier) {
            fields.push(analyzer.type_table.parse_type_name(child.text));
            child = child.next_sibling;
        }
        child = child.next_sibling;
    }
    analyzer.type_table.register_struct_properties(struct_name, &fields);
    fields.drop();
}

void collect_type_information(OwnershipAnalyzer* analyzer, SyntaxTree* tree, CfgSet* cfg) {
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    cfg_collect_items(tree.root, cfg, (DiagnosticBag*)0, &items);
    i64 i = 0;
    while (i < items.len()) {
        collect_drop_impl(analyzer, items.get(i));
        collect_enum(analyzer, items.get(i));
        collect_struct_properties(analyzer, items.get(i));
        i += 1;
    }
    items.drop();
}

void collect_match_ranges(OwnershipAnalyzer* analyzer, SyntaxNode* node, Vec<Span>* ranges, u32 depth) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (depth >= MAX_OWNERSHIP_SCAN_DEPTH) {
        ownership_depth_error(analyzer, node);
        return;
    }
    if (node.kind == NodeKind.Token && ownership_text_equals(node.text, "match") && node.parent != (SyntaxNode*)0) {
        SyntaxNode* sibling = node.next_sibling;
        while (sibling != (SyntaxNode*)0) {
            if (sibling.kind == NodeKind.Block) {
                ranges.push(sibling.span);
                break;
            }
            sibling = sibling.next_sibling;
        }
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        collect_match_ranges(analyzer, child, ranges, depth + 1);
        child = child.next_sibling;
    }
}

bool span_contains(Span range, Span value) {
    return value.start >= range.start && value.end <= range.end;
}

bool move_in_match_guard(Vec<SyntaxNode*>* leaves, i64 move_index, Vec<Span>* ranges) {
    SyntaxNode* move_node = leaves.get(move_index);
    i64 range_index = 0;
    while (range_index < ranges.len()) {
        Span range = ranges.get(range_index);
        if (!span_contains(range, move_node.span)) {
            range_index += 1;
            continue;
        }
        i64 i = move_index - 1;
        while (i >= 0 && leaves.get(i).span.start >= range.start) {
            if (ownership_text_equals(leaves.get(i).text, ":")) {
                return false;
            }
            i -= 1;
        }
        bool comma = false;
        i = move_index + 1;
        while (i < leaves.len() && leaves.get(i).span.end <= range.end) {
            SyntaxNode* node = leaves.get(i);
            if (ownership_text_equals(node.text, ":")) {
                return false;
            }
            if (ownership_text_equals(node.text, ",")) {
                comma = true;
            }
            if (comma && (ownership_text_equals(node.text, "==") || ownership_text_equals(node.text, "!=")
                || ownership_text_equals(node.text, "<") || ownership_text_equals(node.text, ">")
                || ownership_text_equals(node.text, "<=") || ownership_text_equals(node.text, ">="))) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    return false;
}

bool ownership_assignment_after(Vec<SyntaxNode*>* leaves, i64 end) {
    if (end + 1 >= leaves.len()) { return false; }
    str op = leaves.get(end + 1).text;
    return ownership_text_equals(op, "=") || ownership_text_equals(op, "+=")
        || ownership_text_equals(op, "-=") || ownership_text_equals(op, "*=")
        || ownership_text_equals(op, "/=") || ownership_text_equals(op, "%=")
        || ownership_text_equals(op, "&=") || ownership_text_equals(op, "|=")
        || ownership_text_equals(op, "^=");
}

String ownership_parse_place(Vec<SyntaxNode*>* leaves, i64 start, i64* end) {
    String place = String.new();
    i64 i = start;
    if (i > 0 && ownership_text_equals(leaves.get(i - 1).text, "*")) {
        place.push_str("*");
    }
    place.push_str(leaves.get(i).text);
    while (i + 1 < leaves.len()) {
        SyntaxNode* next = leaves.get(i + 1);
        if (ownership_text_equals(next.text, ".") && i + 2 < leaves.len()
            && leaves.get(i + 2).token_kind == TokenKind.Identifier) {
            place.push_str(".");
            place.push_str(leaves.get(i + 2).text);
            i += 2;
        } else if (ownership_text_equals(next.text, "[")) {
            place.push_str("[]");
            i += 1;
            i64 bracket_depth = 1;
            while (i + 1 < leaves.len() && bracket_depth > 0) {
                i += 1;
                if (ownership_text_equals(leaves.get(i).text, "[")) { bracket_depth += 1; }
                else if (ownership_text_equals(leaves.get(i).text, "]")) { bracket_depth -= 1; }
            }
        } else {
            break;
        }
    }
    *end = i;
    return place;
}

bool ownership_place_is_call(Vec<SyntaxNode*>* leaves, i64 end) {
    if (end < 0 || end >= leaves.len()) {
        return false;
    }
    SyntaxNode* next = leaves.get(end).next_sibling;
    if (next != (SyntaxNode*)0 && next.kind == NodeKind.Parenthesized) {
        return true;
    }
    if (next == (SyntaxNode*)0 || next.kind != NodeKind.Token
        || !ownership_text_equals(next.text, "<")) {
        return false;
    }
    i64 depth = 1;
    next = next.next_sibling;
    while (next != (SyntaxNode*)0) {
        if (next.kind == NodeKind.Token) {
            if (ownership_text_equals(next.text, "<")) {
                depth += 1;
            } else if (ownership_text_equals(next.text, ">")) {
                depth -= 1;
            } else if (ownership_text_equals(next.text, ">>")) {
                depth -= 2;
            }
            if (depth <= 0) {
                next = next.next_sibling;
                return next != (SyntaxNode*)0 && next.kind == NodeKind.Parenthesized;
            }
        }
        next = next.next_sibling;
    }
    return false;
}
bool ownership_place_is_slice(Vec<SyntaxNode*>* leaves, i64 end) {
    if (end < 0 || end >= leaves.len()) { return false; }
    SyntaxNode* bracket = leaves.get(end).next_sibling;
    if (bracket == (SyntaxNode*)0 || bracket.kind != NodeKind.Bracket) { return false; }
    SyntaxNode* child = bracket.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Token && ownership_text_equals(child.text, ":")) {
            return true;
        }
        child = child.next_sibling;
    }
    return false;
}


Span ownership_binding_scope(SyntaxNode* name, SyntaxNode* function) {
    SyntaxNode* parent = name.parent;
    while (parent != (SyntaxNode*)0 && parent != function) {
        if (parent.kind == NodeKind.Block) {
            return parent.span;
        }
        parent = parent.parent;
    }
    return function.span;
}

void collect_ownership_variables(OwnershipAnalyzer* analyzer, SyntaxNode* function, CfgSet* cfg) {
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    cfg_collect_live_leaves(function, cfg, &leaves);
    i64 i = 0;
    while (i < leaves.len()) {
        SyntaxNode* type_node = leaves.get(i);
        if (type_node.kind != NodeKind.Token || type_node.token_kind != TokenKind.Identifier
            || ownership_text_equals(type_node.text, "return")
            || ownership_text_equals(type_node.text, "move")
            || ownership_text_equals(type_node.text, "wait")) {
            i += 1;
            continue;
        }
        String type_name = String.new();
        type_name.push_str(type_node.text);
        i64 name_index = i + 1;
        if (name_index < leaves.len() && ownership_text_equals(leaves.get(name_index).text, "<")) {
            i64 depth = 0;
            while (name_index < leaves.len()) {
                str text = leaves.get(name_index).text;
                type_name.push_str(text);
                if (ownership_text_equals(text, "<")) {
                    depth += 1;
                } else if (ownership_text_equals(text, ">")) {
                    depth -= 1;
                } else if (ownership_text_equals(text, ">>")) {
                    depth -= 2;
                }
                name_index += 1;
                if (depth <= 0) { break; }
            }
        }
        while (name_index < leaves.len()
            && (ownership_text_equals(leaves.get(name_index).text, "*")
                || ownership_text_equals(leaves.get(name_index).text, "&"))) {
            type_name.push_str(leaves.get(name_index).text);
            name_index += 1;
        }
        if (name_index < leaves.len() && leaves.get(name_index).token_kind == TokenKind.Identifier) {
            SyntaxNode* name = leaves.get(name_index);
            OwnershipVar variable;
            variable.name_id = analyzer.names.intern(name.text);
            variable.type_id = analyzer.type_table.parse_type_name(type_name.to_str());
            variable.declaration_span = name.span;
            variable.scope = ownership_binding_scope(name, function);
            analyzer.variables.push(variable);
        }
        type_name.drop();
        i += 1;
    }
    leaves.drop();
}

void check_move_sequences(OwnershipAnalyzer* analyzer, SyntaxNode* function, CfgSet* cfg) {
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    cfg_collect_live_leaves(function, cfg, &leaves);
    Vec<Span> match_ranges = Vec<Span>.new();
    collect_match_ranges(analyzer, function, &match_ranges, 0);
    collect_ownership_variables(analyzer, function, cfg);
    i64 i = 0;
    while (i < leaves.len()) {
        SyntaxNode* node = leaves.get(i);
        if (ownership_text_equals(node.text, "return") && i + 1 < leaves.len()
            && leaves.get(i + 1).token_kind == TokenKind.Identifier) {
            i64 return_end = i + 1;
            String returned = ownership_parse_place(&leaves, i + 1, &return_end);
            bool non_consuming = ownership_place_is_call(&leaves, return_end)
                || ownership_place_is_slice(&leaves, return_end);
            if (non_consuming) {
                analyzer.observe(returned.to_str(), leaves.get(i + 1).span);
            } else {
                analyzer.transfer(returned.to_str(), leaves.get(i + 1).span, false);
            }
            returned.drop();
            i = return_end + 1;
            continue;
        }
        if ((ownership_text_equals(node.text, "move") || ownership_text_equals(node.text, "wait"))
            && i + 1 < leaves.len() && leaves.get(i + 1).token_kind == TokenKind.Identifier) {
            i64 end = i + 1;
            String place = ownership_parse_place(&leaves, i + 1, &end);
            if (ownership_text_equals(node.text, "move") && move_in_match_guard(&leaves, i, &match_ranges)) {
                String message = String.from_str("cannot move out of payload in a match arm with a guard");
                analyzer.diagnostics.error(leaves.get(i + 1).span, move message);
                analyzer.failed = true;
            }
            bool continues = i == 0 || !ownership_text_equals(leaves.get(i - 1).text, "return");
            bool non_consuming = ownership_place_is_call(&leaves, end)
                || ownership_place_is_slice(&leaves, end);
            if (non_consuming) {
                analyzer.observe(place.to_str(), leaves.get(i + 1).span);
            } else {
                analyzer.transfer(place.to_str(), leaves.get(i + 1).span, continues);
            }
            place.drop();
            i = end + 1;
            continue;
        }
        if (node.kind == NodeKind.Token && node.token_kind == TokenKind.Identifier) {
            bool member_name = i > 0 && ownership_text_equals(leaves.get(i - 1).text, ".");
            if (!member_name) {
                i64 end = i;
                String place = ownership_parse_place(&leaves, i, &end);
                if (ownership_assignment_after(&leaves, end)) {
                    analyzer.reinitialize(place.to_str(), node.span);
                    if (ownership_text_equals(leaves.get(end + 1).text, "=")
                        && end + 2 < leaves.len()
                        && leaves.get(end + 2).token_kind == TokenKind.Identifier
                        && !ownership_text_equals(leaves.get(end + 2).text, "move")) {
                        i64 source_end = end + 2;
                        String source = ownership_parse_place(&leaves, end + 2, &source_end);
                        bool non_consuming = ownership_place_is_call(&leaves, source_end)
                            || ownership_place_is_slice(&leaves, source_end);
                        if (non_consuming) {
                            analyzer.observe(source.to_str(), leaves.get(end + 2).span);
                        } else {
                            analyzer.transfer(source.to_str(), leaves.get(end + 2).span, true);
                            i = source_end;
                        }
                        source.drop();
                    }
                }
                place.drop();
                i = end;
            }
        }
        i += 1;
    }
    leaves.drop();
    match_ranges.drop();
}

bool check_ownership(SyntaxTree* tree, DiagnosticBag* diagnostics, CfgSet* cfg) {
    bool ok = true;
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    cfg_collect_items(tree.root, cfg, diagnostics, &items);
    i64 i = 0;
    while (i < items.len()) {
        if (items.get(i).kind == NodeKind.Function) {
            OwnershipAnalyzer analyzer = OwnershipAnalyzer.new(diagnostics);
            collect_type_information(&analyzer, tree, cfg);
            scan_constructor_group(&analyzer, items.get(i), 0);
            check_move_sequences(&analyzer, items.get(i), cfg);
            if (analyzer.failed) {
                ok = false;
            }
        }
        i += 1;
    }
    items.drop();
    return ok;
}
