// Syntactic queries over top-level items shared by lowering and codegen.
// These walk the lossless CST directly so enum and method shapes resolve the
// same way in every pass without a separate registry.
import std.mem.vec;
import std.string;
import frontend.ast;
import frontend.ast_expr;
import frontend.lexer;
import frontend.symbols;
import frontend.types;

SyntaxNode* find_item_by_name(SyntaxNode* root, NodeKind kind, str name) {
    if (root == (SyntaxNode*)0) {
        return (SyntaxNode*)0;
    }
    SyntaxNode* child = root.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == kind) {
            SyntaxNode* id = item_identifier(child);
            if (id != (SyntaxNode*)0 && strcmp(id.text, name) == 0) {
                return child;
            }
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

SyntaxNode* find_enum_item(SyntaxNode* root, str name) {
    return find_item_by_name(root, NodeKind.Enum, name);
}

bool item_has_attribute(SyntaxNode* item, str name) {
    if (item == (SyntaxNode*)0) { return false; }
    SyntaxNode* child = item.first_child;
    while (child != (SyntaxNode*)0
        && !(child.kind == NodeKind.Token
             && (child.token_kind == TokenKind.Struct || child.token_kind == TokenKind.Enum
                 || child.token_kind == TokenKind.Type))) {
        if (child.kind == NodeKind.Token && child.text == "#") {
            SyntaxNode* bracket = child.next_sibling;
            if (bracket != (SyntaxNode*)0 && bracket.kind == NodeKind.Bracket) {
                SyntaxNode* attribute = bracket.first_child;
                if (attribute != (SyntaxNode*)0 && attribute.kind == NodeKind.Token
                    && strcmp(attribute.text, name) == 0) {
                    return true;
                }
                child = bracket;
            }
        }
        child = child.next_sibling;
    }
    return false;
}

String item_attribute_string(SyntaxNode* start, SyntaxNode* end, str name) {
    SyntaxNode* cursor = start;
    while (cursor != (SyntaxNode*)0 && cursor != end) {
        SyntaxNode* bracket = (SyntaxNode*)0;
        if (cursor.kind == NodeKind.Attribute) {
            bracket = cursor;
        } else if (cursor.kind == NodeKind.Token && cursor.text == "#") {
            bracket = cursor.next_sibling;
        }
        if (bracket != (SyntaxNode*)0
            && (bracket.kind == NodeKind.Attribute || bracket.kind == NodeKind.Bracket)) {
            SyntaxNode* attribute = bracket.first_child;
            if (attribute != (SyntaxNode*)0 && attribute.kind == NodeKind.Token
                && strcmp(attribute.text, name) == 0) {
                SyntaxNode* value = attribute.next_sibling;
                while (value != (SyntaxNode*)0) {
                    if (value.kind == NodeKind.Token && strlen(value.text) >= 2
                        && value.text[0] == '"'
                        && value.text[strlen(value.text) - 1] == '"') {
                        return unescape_string_literal(value.text);
                    }
                    SyntaxNode* child = value.first_child;
                    while (child != (SyntaxNode*)0) {
                        if (child.kind == NodeKind.Token && strlen(child.text) >= 2
                            && child.text[0] == '"'
                            && child.text[strlen(child.text) - 1] == '"') {
                            return unescape_string_literal(child.text);
                        }
                        child = child.next_sibling;
                    }
                    value = value.next_sibling;
                }
            }
            if (bracket != cursor) { cursor = bracket; }
        }
        cursor = cursor.next_sibling;
    }
    return String.new();
}

String item_extern_link_name(SyntaxNode* root, str function_name) {
    SyntaxNode* item = root == (SyntaxNode*)0 ? (SyntaxNode*)0 : root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Extern) {
            SyntaxNode* block = item.first_child;
            while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                block = block.next_sibling;
            }
            SyntaxNode* cursor = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.first_child;
            while (cursor != (SyntaxNode*)0) {
                if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                    cursor = cursor.next_sibling;
                    continue;
                }
                SyntaxNode* declaration = cursor;
                SyntaxNode* name = (SyntaxNode*)0;
                SyntaxNode* parameters = (SyntaxNode*)0;
                SyntaxNode* scan = cursor;
                while (scan != (SyntaxNode*)0
                    && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
                    if (scan.kind == NodeKind.Parenthesized) {
                        parameters = scan;
                        break;
                    }
                    if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                        name = scan;
                    }
                    scan = scan.next_sibling;
                }
                if (name != (SyntaxNode*)0 && parameters != (SyntaxNode*)0
                    && strcmp(name.text, function_name) == 0) {
                    return item_attribute_string(declaration, name, "link_name");
                }
                if (parameters != (SyntaxNode*)0) {
                    cursor = parameters.next_sibling;
                    if (cursor != (SyntaxNode*)0 && cursor.kind == NodeKind.Token
                        && cursor.token_kind == TokenKind.Semicolon) {
                        cursor = cursor.next_sibling;
                    }
                } else {
                    cursor = cursor.next_sibling;
                }
            }
        }
        item = item.next_sibling;
    }
    return String.new();
}

i64 items_parse_int(str text) {
    if (text == (str)0) {
        return 0;
    }
    i64 len = strlen(text);
    if (len == 0) {
        return 0;
    }
    i64 i = 0;
    bool neg = false;
    if (text[0] == (u8)45) {
        neg = true;
        i += 1;
    }
    if (i + 2 <= len && text[i] == (u8)48 && (text[i + 1] == (u8)120 || text[i + 1] == (u8)88)) {
        i += 2;
        i64 value = 0;
        while (i < len) {
            u8 ch = (u8)text[i];
            i64 digit = -1;
            if (ch >= (u8)48 && ch <= (u8)57) {
                digit = (i64)(ch - (u8)48);
            } else if (ch >= (u8)97 && ch <= (u8)102) {
                digit = (i64)(ch - (u8)97) + 10;
            } else if (ch >= (u8)65 && ch <= (u8)70) {
                digit = (i64)(ch - (u8)65) + 10;
            }
            if (digit < 0) {
                break;
            }
            value = value * 16 + digit;
            i += 1;
        }
        return neg ? -value : value;
    }
    i64 value = 0;
    while (i < len) {
        u8 ch = (u8)text[i];
        if (ch < (u8)48 || ch > (u8)57) {
            break;
        }
        value = value * 10 + (i64)(ch - (u8)48);
        i += 1;
    }
    return neg ? -value : value;
}

// Walk one enum item body. For each variant calls the visitor logic inline:
// reports name, tag, payload arity, and payload type texts.
bool enum_each_variant(SyntaxNode* item, Vec<SyntaxNode*>* names, Vec<i64>* tags,
                       Vec<i64>* arities) {
    if (item == (SyntaxNode*)0) {
        return false;
    }
    SyntaxNode* block = item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return false;
    }
    i64 next_tag = 0;
    SyntaxNode* cursor = block.first_child;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier) {
            SyntaxNode* variant = cursor;
            i64 tag = next_tag;
            i64 arity = 0;
            SyntaxNode* scan = cursor.next_sibling;
            while (scan != (SyntaxNode*)0
                && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
                if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Assign) {
                    SyntaxNode* value = scan.next_sibling;
                    if (value != (SyntaxNode*)0 && value.kind == NodeKind.Token
                        && (value.token_kind == TokenKind.IntLiteral || value.token_kind == TokenKind.Minus)) {
                        if (value.token_kind == TokenKind.Minus && value.next_sibling != (SyntaxNode*)0
                            && value.next_sibling.kind == NodeKind.Token
                            && value.next_sibling.token_kind == TokenKind.IntLiteral) {
                            String combined = String.from_str("-");
                            combined.push_str(value.next_sibling.text);
                            tag = items_parse_int(combined.to_str());
                            combined.drop();
                        } else {
                            tag = items_parse_int(value.text);
                        }
                    }
                }
                if (scan.kind == NodeKind.Parenthesized) {
                    SyntaxNode* part = scan.first_child;
                    i64 count = 0;
                    bool seen = false;
                    while (part != (SyntaxNode*)0) {
                        if (part.kind != NodeKind.Token || part.token_kind != TokenKind.Comma) {
                            if (!seen) {
                                seen = true;
                            }
                        } else if (seen) {
                            count += 1;
                        }
                        part = part.next_sibling;
                    }
                    if (seen) {
                        arity = count + 1;
                    }
                }
                scan = scan.next_sibling;
            }
            names.push(variant);
            tags.push(tag);
            arities.push(arity);
            next_tag = tag + 1;
        }
        cursor = cursor.next_sibling;
    }
    return true;
}

bool enum_variant_info(SyntaxNode* root, str enum_name, str variant_name,
                       i64* tag_out, i64* arity_out) {
    SyntaxNode* item = find_enum_item(root, enum_name);
    if (item == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> names = Vec<SyntaxNode*>.new();
    Vec<i64> tags = Vec<i64>.new();
    Vec<i64> arities = Vec<i64>.new();
    enum_each_variant(item, &names, &tags, &arities);
    bool found = false;
    i64 i = 0;
    while (i < names.len()) {
        if (strcmp(names.get(i).text, variant_name) == 0) {
            *tag_out = tags.get(i);
            *arity_out = arities.get(i);
            found = true;
            break;
        }
        i += 1;
    }
    names.drop();
    tags.drop();
    arities.drop();
    return found;
}

bool find_variant_enum(SyntaxNode* root, str variant_name, SyntaxNode** enum_out) {
    if (root == (SyntaxNode*)0) {
        return false;
    }
    if (strcmp(variant_name, "None") == 0 || strcmp(variant_name, "Some") == 0) {
        SyntaxNode* opt = find_enum_item(root, "Optional");
        if (opt != (SyntaxNode*)0) {
            *enum_out = opt;
            return true;
        }
    }
    if (strcmp(variant_name, "Ok") == 0 || strcmp(variant_name, "Err") == 0) {
        SyntaxNode* res = find_enum_item(root, "Result");
        if (res != (SyntaxNode*)0) {
            *enum_out = res;
            return true;
        }
    }
    SyntaxNode* child = root.first_child;
    SyntaxNode* found = (SyntaxNode*)0;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Enum) {
            Vec<SyntaxNode*> names = Vec<SyntaxNode*>.new();
            Vec<i64> tags = Vec<i64>.new();
            Vec<i64> arities = Vec<i64>.new();
            enum_each_variant(child, &names, &tags, &arities);
            i64 i = 0;
            while (i < names.len()) {
                if (strcmp(names.get(i).text, variant_name) == 0) {
                    if (found != (SyntaxNode*)0) {
                        names.drop();
                        tags.drop();
                        arities.drop();
                        return false;
                    }
                    found = child;
                }
                i += 1;
            }
            names.drop();
            tags.drop();
            arities.drop();
        }
        child = child.next_sibling;
    }
    *enum_out = found;
    return found != (SyntaxNode*)0;
}

void append_node_tokens(SyntaxNode* node, String* out) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (node.kind == NodeKind.Token) {
        out.push_str(node.text);
        return;
    }
    if (node.kind == NodeKind.Bracket) {
        out.push_str("[");
        SyntaxNode* c = node.first_child;
        while (c != (SyntaxNode*)0) {
            append_node_tokens(c, out);
            c = c.next_sibling;
        }
        out.push_str("]");
        return;
    }
    if (node.kind == NodeKind.Parenthesized) {
        out.push_str("(");
        SyntaxNode* c = node.first_child;
        while (c != (SyntaxNode*)0) {
            append_node_tokens(c, out);
            c = c.next_sibling;
        }
        out.push_str(")");
        return;
    }
    SyntaxNode* c = node.first_child;
    while (c != (SyntaxNode*)0) {
        append_node_tokens(c, out);
        c = c.next_sibling;
    }
}

u32 type_id_from_text(TypeTable* types, str text) {
    if (text == (str)0) {
        return TYPE_UNKNOWN;
    }
    i64 len = strlen(text);
    i64 start = 0;
    while (start < len && (text[start] == (u8)32 || text[start] == (u8)9)) {
        start += 1;
    }
    if (start + 5 <= len && text[start] == (u8)'c' && text[start + 1] == (u8)'o'
        && text[start + 2] == (u8)'n' && text[start + 3] == (u8)'s' && text[start + 4] == (u8)'t'
        && (start + 5 == len || text[start + 5] == (u8)' ' || text[start + 5] == (u8)'\t' || text[start + 5] == (u8)'*')) {
        start += 5;
        while (start < len && (text[start] == (u8)32 || text[start] == (u8)9)) {
            start += 1;
        }
    }
    bool is_reference = false;
    bool ref_mutable = false;
    if (start < len && text[start] == (u8)38) {
        is_reference = true;
        start += 1;
        if (start + 3 <= len && text[start] == (u8)109 && text[start + 1] == (u8)117
            && text[start + 2] == (u8)116) {
            ref_mutable = true;
            start += 3;
        }
        while (start < len && (text[start] == (u8)32 || text[start] == (u8)9)) {
            start += 1;
        }
        if (start + 5 <= len && text[start] == (u8)'c' && text[start + 1] == (u8)'o'
            && text[start + 2] == (u8)'n' && text[start + 3] == (u8)'s' && text[start + 4] == (u8)'t'
            && (start + 5 == len || text[start + 5] == (u8)' ' || text[start + 5] == (u8)'\t' || text[start + 5] == (u8)'*')) {
            start += 5;
            while (start < len && (text[start] == (u8)32 || text[start] == (u8)9)) {
                start += 1;
            }
        }
    }
    i64 end = len;
    while (end > start && (text[end - 1] == (u8)32 || text[end - 1] == (u8)9)) {
        end -= 1;
    }
    i64 stars = 0;
    while (end > start && text[end - 1] == (u8)42) {
        stars += 1;
        end -= 1;
    }
    while (end > start && (text[end - 1] == (u8)32 || text[end - 1] == (u8)9)) {
        end -= 1;
    }
    if (end <= start) {
        return TYPE_UNKNOWN;
    }
    String base = String.new();
    i64 i = start;
    while (i < end) {
        if (text[i] != (u8)32 && text[i] != (u8)9) {
            base.push(text[i]);
        }
        i += 1;
    }
    u32 result = types.parse_type_name(base.to_str());
    base.drop();
    while (stars > 0) {
        result = types.get_pointer(result, true);
        stars -= 1;
    }
    if (is_reference) {
        result = types.get_reference(result, ref_mutable);
    }
    return result;
}

u32 type_id_from_declarator(TypeTable* types, str base_type, SyntaxNode* suffix) {
    Vec<SyntaxNode*> dimensions = Vec<SyntaxNode*>.new();
    SyntaxNode* cursor = suffix;
    while (cursor != (SyntaxNode*)0 && cursor.kind == NodeKind.Bracket) {
        dimensions.push(cursor);
        cursor = cursor.next_sibling;
    }

    String type_text = String.from_str(base_type);
    i64 i = dimensions.len();
    while (i > 0) {
        i -= 1;
        append_node_tokens(dimensions.get(i), &type_text);
    }
    u32 result = type_id_from_text(types, type_text.to_str());
    type_text.drop();
    dimensions.drop();
    return result;
}

bool enum_payload_type_text(SyntaxNode* root, str enum_name, str variant_name,
                            i64 field_index, String* out) {
    SyntaxNode* item = find_enum_item(root, enum_name);
    if (item == (SyntaxNode*)0) {
        return false;
    }
    SyntaxNode* block = item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return false;
    }
    SyntaxNode* cursor = block.first_child;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier
            && strcmp(cursor.text, variant_name) == 0) {
            SyntaxNode* payload = cursor.next_sibling;
            if (payload == (SyntaxNode*)0 || payload.kind != NodeKind.Parenthesized) {
                return false;
            }
            i64 index = 0;
            SyntaxNode* part = payload.first_child;
            while (part != (SyntaxNode*)0) {
                SyntaxNode* part_end = part;
                while (part_end != (SyntaxNode*)0
                    && !(part_end.kind == NodeKind.Token && part_end.token_kind == TokenKind.Comma)) {
                    part_end = part_end.next_sibling;
                }
                if (index == field_index) {
                    SyntaxNode* tok = part;
                    while (tok != (SyntaxNode*)0 && tok != part_end) {
                        if (tok.kind == NodeKind.Token) {
                            out.push_str(tok.text);
                        }
                        tok = tok.next_sibling;
                    }
                    return out.len > 0;
                }
                index += 1;
                part = (part_end == (SyntaxNode*)0) ? part_end : part_end.next_sibling;
            }
            return false;
        }
        cursor = cursor.next_sibling;
    }
    return false;
}

bool method_matches_variant(str method_name, str variant_name) {
    return method_name != (str)0 && variant_name != (str)0
        && strcmp(method_name, variant_name) == 0;
}

bool item_first_parameter_is_self(SyntaxNode* parameters) {
    if (parameters == (SyntaxNode*)0) { return false; }
    SyntaxNode* cursor = parameters.first_child;
    SyntaxNode* last_identifier = (SyntaxNode*)0;
    i64 angle_depth = 0;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Comma && angle_depth == 0) {
            break;
        }
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier) {
            last_identifier = cursor;
        }
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Less) {
            angle_depth += 1;
        } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Greater) {
            angle_depth -= 1;
        }
        cursor = cursor.next_sibling;
    }
    return last_identifier != (SyntaxNode*)0 && strcmp(last_identifier.text, "self") == 0;
}

bool impl_has_method(SyntaxNode* root, str owner_name, str method_name,
                    bool instance_method) {
    if (root == (SyntaxNode*)0 || owner_name == (str)0 || method_name == (str)0) {
        return false;
    }
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                SyntaxNode* member = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.first_child;
                while (member != (SyntaxNode*)0) {
                    if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Semicolon) {
                        member = member.next_sibling;
                        continue;
                    }
                    SyntaxNode* name = (SyntaxNode*)0;
                    SyntaxNode* parameters = (SyntaxNode*)0;
                    SyntaxNode* scan = member;
                    while (scan != (SyntaxNode*)0
                        && scan.kind != NodeKind.Block
                        && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
                        if (scan.kind == NodeKind.Parenthesized) {
                            parameters = scan;
                            break;
                        }
                        if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                            name = scan;
                        }
                        scan = scan.next_sibling;
                    }
                    if (name != (SyntaxNode*)0 && parameters != (SyntaxNode*)0
                        && strcmp(name.text, method_name) == 0
                        && item_first_parameter_is_self(parameters) == instance_method) {
                        return true;
                    }
                    while (scan != (SyntaxNode*)0
                        && scan.kind != NodeKind.Block
                        && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
                        scan = scan.next_sibling;
                    }
                    member = scan == (SyntaxNode*)0 ? scan : scan.next_sibling;
                }
            }
        }
        item = item.next_sibling;
    }
    return false;
}

bool impl_has_static_method(SyntaxNode* root, str owner_name, str method_name) {
    return impl_has_method(root, owner_name, method_name, false);
}

bool impl_has_instance_method(SyntaxNode* root, str owner_name, str method_name) {
    return impl_has_method(root, owner_name, method_name, true);
}

i64 enum_variant_count(SyntaxNode* root, str enum_name) {
    SyntaxNode* item = find_enum_item(root, enum_name);
    if (item == (SyntaxNode*)0) {
        return -1;
    }
    Vec<SyntaxNode*> names = Vec<SyntaxNode*>.new();
    Vec<i64> tags = Vec<i64>.new();
    Vec<i64> arities = Vec<i64>.new();
    enum_each_variant(item, &names, &tags, &arities);
    i64 count = names.len();
    names.drop();
    tags.drop();
    arities.drop();
    return count;
}

SyntaxNode* impl_target_identifier(SyntaxNode* impl_item) {
    SyntaxNode* child = impl_item.first_child;
    SyntaxNode* first_ident = (SyntaxNode*)0;
    SyntaxNode* after_for_ident = (SyntaxNode*)0;
    bool saw_impl = false;
    bool saw_for = false;
    i64 angle_depth = 0;
    while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
        if (child.kind == NodeKind.Token) {
            if (child.token_kind == TokenKind.Impl) {
                saw_impl = true;
            } else if (child.token_kind == TokenKind.For || strcmp(child.text, "for") == 0) {
                saw_for = true;
            } else if (child.token_kind == TokenKind.Less || strcmp(child.text, "<") == 0) {
                angle_depth += 1;
            } else if ((child.token_kind == TokenKind.Greater || strcmp(child.text, ">") == 0) && angle_depth > 0) {
                angle_depth -= 1;
            } else if ((node_is_identifier(child) || is_primitive_type_token(child.token_kind)
                || strcmp(child.text, "Vec") == 0 || strcmp(child.text, "Optional") == 0)
                && angle_depth == 0) {
                if (saw_for && after_for_ident == (SyntaxNode*)0) {
                    after_for_ident = child;
                } else if (saw_impl && first_ident == (SyntaxNode*)0) {
                    first_ident = child;
                }
            }
        }
        child = child.next_sibling;
    }
    if (after_for_ident != (SyntaxNode*)0) {
        return after_for_ident;
    }
    return first_ident;
}
