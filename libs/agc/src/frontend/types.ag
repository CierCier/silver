// libs/agc/src/frontend/types.ag — Canonical TypeTable & TypeId representation.
import std.intern;
import std.mem.vec;
import std.string;

const u32 TYPE_UNKNOWN = 0;
const u32 TYPE_VOID = 1;
const u32 TYPE_BOOL = 2;
const u32 TYPE_I8 = 3;
const u32 TYPE_I16 = 4;
const u32 TYPE_I32 = 5;
const u32 TYPE_I64 = 6;
const u32 TYPE_I128 = 7;
const u32 TYPE_U8 = 8;
const u32 TYPE_U16 = 9;
const u32 TYPE_U32 = 10;
const u32 TYPE_U64 = 11;
const u32 TYPE_U128 = 12;
const u32 TYPE_F32 = 13;
const u32 TYPE_F64 = 14;
const u32 TYPE_F80 = 15;
const u32 TYPE_C32 = 16;
const u32 TYPE_C64 = 17;
const u32 TYPE_C80 = 18;
const u32 TYPE_STR = 19;
const u32 TYPE_CHAR = 20;
const u32 TYPE_PRIMITIVE_MAX = 20;

enum TypeKind {
    Unknown;
    Void;
    Bool;
    I8;
    I16;
    I32;
    I64;
    I128;
    U8;
    U16;
    U32;
    U64;
    U128;
    F32;
    F64;
    F80;
    C32;
    C64;
    C80;
    Str;
    Char;
    Pointer;
    Reference;
    Array;
    Slice;
    Named;
    TypeParam;
    Function;
    Tuple;
}

struct TypeProperties {
    bool is_copy;
    bool needs_drop;
}

bool type_name_needs_drop(str name) {
    return strcmp(name, "String") == 0 || strcmp(name, "Vec") == 0
        || strcmp(name, "VecIter") == 0 || strcmp(name, "Bytes") == 0
        || strcmp(name, "HashMap") == 0 || strcmp(name, "HashSet") == 0
        || strcmp(name, "Deque") == 0 || strcmp(name, "BinaryHeap") == 0
        || strcmp(name, "Queue") == 0 || strcmp(name, "Box") == 0
        || strcmp(name, "Rc") == 0 || strcmp(name, "Arena") == 0
        || strcmp(name, "File") == 0 || strcmp(name, "BufWriter") == 0
        || strcmp(name, "Scanner") == 0 || strcmp(name, "ByteStream") == 0
        || strcmp(name, "Channel") == 0 || strcmp(name, "RawMutex") == 0
        || strcmp(name, "Mutex") == 0 || strcmp(name, "Socket") == 0
        || strcmp(name, "TcpStream") == 0 || strcmp(name, "TcpListener") == 0
        || strcmp(name, "UdpSocket") == 0 || strcmp(name, "HttpConnection") == 0
        || strcmp(name, "Set") == 0 || strcmp(name, "Map") == 0;
}

bool type_name_is_move_only(str name) {
    return strcmp(name, "Task") == 0;
}


struct TypeEntry {
    TypeKind kind;
    u32 inner;
    u32 name_id;
    i64 count;
    bool is_mut;
}

struct TypeSubst {
    u32 name_id;
    u32 type_id;
}

struct TypeStructProperties {
    u32 name_id;
    u32 field_start;
    u32 field_count;
    u32 field_name_start;
    u32 field_name_count;
    u32 type_param_start;
    u32 type_param_count;
    bool needs_drop;
}

struct TypeMethodParam {
    u32 owner_name_id;
    u32 method_name_id;
    i64 param_count;
    i64 parameter_index;
    u32 param_type;
    bool is_value;
}

struct TypeTable {
    Interner names;
    Vec<TypeEntry> types;
    Vec<TypeSubst> subst;
    Vec<u32> type_args;
    Vec<TypeStructProperties> struct_properties;
    Vec<u32> struct_fields;
    Vec<u32> struct_field_names;
    Vec<u32> struct_type_params;
    Vec<u32> packed_structs;
    Vec<TypeMethodParam> method_params;
}
TypeProperties type_properties_at(TypeTable* table, u32 id, u32 depth) {
    TypeProperties properties;
    properties.is_copy = false;
    properties.needs_drop = false;
    if (depth >= 256 || (i64)id >= table.types.len()) {
        return properties;
    }
    TypeEntry* entry = table.types.get_ptr((i64)id);
    if ((id >= TYPE_BOOL && id <= TYPE_C80) || id == TYPE_CHAR
        || entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference
        || entry.kind == TypeKind.Function) {
        properties.is_copy = true;
        return properties;
    }
    if (entry.kind == TypeKind.Array || entry.kind == TypeKind.Slice) {
        TypeProperties element = type_properties_at(table, entry.inner, depth + 1);
        if (entry.kind == TypeKind.Slice) {
            element.is_copy = true;
        }
        return element;
    }
    if (entry.kind == TypeKind.Tuple) {
        properties.is_copy = true;
        i64 i = 0;
        while (i < entry.count) {
            TypeProperties element = type_properties_at(table, table.type_args.get(entry.inner + (u32)i), depth + 1);
            if (!element.is_copy) { properties.is_copy = false; }
            if (element.needs_drop) { properties.needs_drop = true; }
            i += 1;
        }
        return properties;
    }
    if (entry.kind == TypeKind.Named) {
        str name = table.names.get(entry.name_id);
        properties.needs_drop = type_name_needs_drop(name);
        properties.is_copy = !properties.needs_drop && !type_name_is_move_only(name);
        if (type_name_is_move_only(name)) {
            return properties;
        }
        i64 i = 0;
        while (i < entry.count) {
            TypeProperties argument = type_properties_at(table, table.type_args.get(entry.inner + i), depth + 1);
            if (!argument.is_copy) { properties.is_copy = false; }
            if (argument.needs_drop) { properties.needs_drop = true; }
            i += 1;
        }
        i = 0;
        while (i < table.struct_properties.len()) {
            TypeStructProperties* definition = table.struct_properties.get_ptr(i);
            if (definition.name_id == entry.name_id) {
                if (definition.needs_drop) {
                    properties.needs_drop = true;
                    properties.is_copy = false;
                }
                u32 field_index = definition.field_start;
                u32 field_end = field_index + definition.field_count;
                while (field_index < field_end) {
                    TypeProperties field = type_properties_at(table, table.struct_fields.get(field_index), depth + 1);
                    if (!field.is_copy) { properties.is_copy = false; }
                    if (field.needs_drop) { properties.needs_drop = true; }
                    field_index += 1;
                }
                break;
            }
            i += 1;
        }
    }
    return properties;
}

bool type_is_ident_char(u8 c) {
    return (c >= (u8)'a' && c <= (u8)'z')
        || (c >= (u8)'A' && c <= (u8)'Z')
        || (c >= (u8)'0' && c <= (u8)'9')
        || c == (u8)'_';
}

impl TypeTable {
    TypeTable new() {
        TypeTable table;
        table.names = Interner.new();
        table.types = Vec<TypeEntry>.new();
        table.subst = Vec<TypeSubst>.new();
        table.type_args = Vec<u32>.new();
        table.struct_properties = Vec<TypeStructProperties>.new();
        table.struct_fields = Vec<u32>.new();
        table.struct_field_names = Vec<u32>.new();
        table.struct_type_params = Vec<u32>.new();
        table.packed_structs = Vec<u32>.new();
        table.method_params = Vec<TypeMethodParam>.new();
        // 0: Unknown
        table.add_prim(TypeKind.Unknown, "unknown");
        // 1: Void
        table.add_prim(TypeKind.Void, "void");
        // 2: Bool
        table.add_prim(TypeKind.Bool, "bool");
        // 3..7: Signed integers
        table.add_prim(TypeKind.I8, "i8");
        table.add_prim(TypeKind.I16, "i16");
        table.add_prim(TypeKind.I32, "i32");
        table.add_prim(TypeKind.I64, "i64");
        table.add_prim(TypeKind.I128, "i128");
        // 8..12: Unsigned integers
        table.add_prim(TypeKind.U8, "u8");
        table.add_prim(TypeKind.U16, "u16");
        table.add_prim(TypeKind.U32, "u32");
        table.add_prim(TypeKind.U64, "u64");
        table.add_prim(TypeKind.U128, "u128");
        // 13..15: Floats
        table.add_prim(TypeKind.F32, "f32");
        table.add_prim(TypeKind.F64, "f64");
        table.add_prim(TypeKind.F80, "f80");
        // 16..18: Complex
        table.add_prim(TypeKind.C32, "c32");
        table.add_prim(TypeKind.C64, "c64");
        table.add_prim(TypeKind.C80, "c80");
        // 19: Str
        table.add_prim(TypeKind.Str, "str");
        // 20: Char
        table.add_prim(TypeKind.Char, "char");

        return move table;
    }

    void add_prim(TypeTable* self, TypeKind kind, str name) {
        TypeEntry entry;
        entry.kind = kind;
        entry.inner = 0;
        entry.name_id = self.names.intern(name);
        entry.count = 0;
        entry.is_mut = false;
        self.types.push(move entry);
    }

    u32 get_pointer(TypeTable* self, u32 inner, bool is_mut) {
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.Pointer && cur.inner == inner && cur.is_mut == is_mut) {
                return (u32)i;
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Pointer;
        entry.inner = inner;
        entry.name_id = 0;
        entry.count = 0;
        entry.is_mut = is_mut;
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 get_reference(TypeTable* self, u32 inner, bool is_mut) {
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.Reference && cur.inner == inner && cur.is_mut == is_mut) {
                return (u32)i;
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Reference;
        entry.inner = inner;
        entry.name_id = 0;
        entry.count = 0;
        entry.is_mut = is_mut;
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 get_array(TypeTable* self, u32 inner, i64 count) {
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.Array && cur.inner == inner && cur.count == count) {
                return (u32)i;
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Array;
        entry.inner = inner;
        entry.name_id = 0;
        entry.count = count;
        entry.is_mut = false;
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 get_tuple(TypeTable* self, Vec<u32>* elements) {
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.Tuple && cur.count == elements.len()) {
                bool same = true;
                i64 element = 0;
                while (element < cur.count) {
                    if (self.type_args.get(cur.inner + (u32)element) != elements.get(element)) {
                        same = false;
                        break;
                    }
                    element += 1;
                }
                if (same) { return (u32)i; }
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Tuple;
        entry.inner = (u32)self.type_args.len();
        entry.name_id = 0;
        entry.count = elements.len();
        entry.is_mut = false;
        i = 0;
        while (i < elements.len()) {
            self.type_args.push(elements.get(i));
            i += 1;
        }
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 get_function(TypeTable* self, u32 result_type, Vec<u32>* parameters) {
        String signature = String.from_str(self.type_name(result_type));
        signature.push((u8)'(');
        i64 i = 0;
        while (i < parameters.len()) {
            if (i > 0) { signature.push((u8)','); }
            signature.push_str(self.type_name(parameters.get(i)));
            i += 1;
        }
        signature.push((u8)')');
        u32 name_id = self.names.intern(signature.to_str());
        signature.drop();
        i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* existing = self.types.get_ptr(i);
            if (existing.kind == TypeKind.Function && existing.name_id == name_id) {
                return (u32)i;
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Function;
        // Function signatures store the return type before their parameters.
        entry.inner = (u32)self.type_args.len();
        entry.name_id = name_id;
        entry.count = parameters.len();
        entry.is_mut = false;
        self.type_args.push(result_type);
        i = 0;
        while (i < parameters.len()) {
            self.type_args.push(parameters.get(i));
            i += 1;
        }
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }


    // Monomorphization substitution frames (FE-001/P0-002): while emitting a
    // specialized generic instance, type parameters resolve to concrete ids.
    // Frames are backend-driver-private; the stack is always empty during
    // checking, so normal type operations are unaffected.
    void push_subst(TypeTable* self, u32 name_id, u32 type_id) {
        TypeSubst binding;
        binding.name_id = name_id;
        binding.type_id = type_id;
        self.subst.push(move binding);
    }

    void pop_subst(TypeTable* self, i64 count) {
        while (count > 0 && self.subst.len() > 0) {
            self.subst.pop();
            count -= 1;
        }
    }

    u32 resolve_subst(TypeTable* self, u32 id) {
        if ((i64)id >= self.types.len()) { return id; }
        TypeEntry* source = self.types.get_ptr((i64)id);
        TypeKind kind = source.kind;
        u32 inner_id = source.inner;
        u32 name_id = source.name_id;
        i64 count = source.count;
        bool is_mut = source.is_mut;
        if (kind == TypeKind.TypeParam || (kind == TypeKind.Named && count == 0)) {
            i64 i = self.subst.len() - 1;
            while (i >= 0) {
                TypeSubst* binding = self.subst.get_ptr(i);
                if (binding.name_id == name_id) {
                    if (binding.type_id == id) { return id; }
                    return self.resolve_subst(binding.type_id);
                }
                i -= 1;
            }
            return id;
        }
        if (kind == TypeKind.Pointer || kind == TypeKind.Reference) {
            u32 inner = self.resolve_subst(inner_id);
            return inner == inner_id ? id
                : (kind == TypeKind.Pointer
                    ? self.get_pointer(inner, is_mut)
                    : self.get_reference(inner, is_mut));
        }
        if (kind == TypeKind.Array) {
            u32 inner = self.resolve_subst(inner_id);
            return inner == inner_id ? id : self.get_array(inner, count);
        }
        if (kind == TypeKind.Tuple) {
            Vec<u32> elements = Vec<u32>.new();
            bool changed = false;
            i64 i = 0;
            while (i < count) {
                u32 old_element = self.type_args.get(inner_id + (u32)i);
                u32 element = self.resolve_subst(old_element);
                if (element != old_element) { changed = true; }
                elements.push(element);
                i += 1;
            }
            if (changed) {
                u32 result = self.get_tuple(&elements);
                elements.drop();
                return result;
            }
            elements.drop();
        }
        if (kind == TypeKind.Function) {
            u32 result_type = self.resolve_subst(self.type_args.get(inner_id));
            Vec<u32> parameters = Vec<u32>.new();
            i64 i = 0;
            while (i < count) {
                parameters.push(self.resolve_subst(self.type_args.get(inner_id + 1 + (u32)i)));
                i += 1;
            }
            u32 result = self.get_function(result_type, &parameters);
            parameters.drop();
            return result;
        }
        if (kind == TypeKind.Named && count > 0) {
            Vec<u32> args = Vec<u32>.new();
            bool changed = false;
            i64 a = 0;
            while (a < count) {
                u32 old_arg = self.type_args.get(inner_id + a);
                u32 arg = self.resolve_subst(old_arg);
                if (arg != old_arg) { changed = true; }
                args.push(arg);
                a += 1;
            }
            if (changed) {
                u32 result = self.get_named_args(self.names.get(name_id), &args);
                args.drop();
                return result;
            }
            args.drop();
        }
        return id;
    }

    u32 get_named(TypeTable* self, str name) {
        u32 name_id = self.names.intern(name);
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.Named && cur.name_id == name_id && cur.count == 0) {
                return (u32)i;
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Named;
        entry.inner = 0;
        entry.name_id = name_id;
        entry.count = 0;
        entry.is_mut = false;
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 get_named_args(TypeTable* self, str name, Vec<u32>* args) {
        u32 name_id = self.names.intern(name);
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.Named && cur.name_id == name_id
                && cur.count == args.len()) {
                bool same = true;
                i64 a = 0;
                while (a < cur.count) {
                    if (self.type_args.get(cur.inner + a) != args.get(a)) {
                        same = false;
                        break;
                    }
                    a += 1;
                }
                if (same) { return (u32)i; }
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.Named;
        entry.inner = self.type_args.len();
        entry.name_id = name_id;
        entry.count = args.len();
        entry.is_mut = false;
        i64 a = 0;
        while (a < args.len()) {
            self.type_args.push(args.get(a));
            a += 1;
        }
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 get_type_param(TypeTable* self, str name) {
        u32 name_id = self.names.intern(name);
        i64 i = (i64)(TYPE_PRIMITIVE_MAX + 1);
        while (i < self.types.len()) {
            TypeEntry* cur = self.types.get_ptr(i);
            if (cur.kind == TypeKind.TypeParam && cur.name_id == name_id) {
                return (u32)i;
            }
            i += 1;
        }
        TypeEntry entry;
        entry.kind = TypeKind.TypeParam;
        entry.inner = 0;
        entry.name_id = name_id;
        entry.count = 0;
        entry.is_mut = false;
        self.types.push(move entry);
        return (u32)(self.types.len() - 1);
    }

    u32 parse_type_name(TypeTable* self, str name) {
        if (name == (str)0) { return TYPE_UNKNOWN; }
        i64 len = strlen(name);
        if (len == 0) { return TYPE_UNKNOWN; }
        i64 start = 0;
        while (start < len && (name[start] == (u8)32 || name[start] == (u8)9)) { start += 1; }
        while (len > start && (name[len - 1] == (u8)32 || name[len - 1] == (u8)9)) { len -= 1; }
        if (start >= len) { return TYPE_UNKNOWN; }

        bool has_space = false;
        i64 scan = start;
        while (scan < len) {
            if (name[scan] == (u8)32 || name[scan] == (u8)9) { has_space = true; break; }
            scan += 1;
        }
        if (has_space) {
            String compact = String.new();
            scan = start;
            while (scan < len) {
                if (name[scan] == (u8)32 || name[scan] == (u8)9) {
                    if (scan > start && scan + 1 < len
                        && type_is_ident_char(name[scan - 1])
                        && type_is_ident_char(name[scan + 1])) {
                        compact.push((u8)' ');
                        while (scan + 1 < len && (name[scan + 1] == (u8)32 || name[scan + 1] == (u8)9)) {
                            scan += 1;
                        }
                    }
                } else {
                    compact.push(name[scan]);
                }
                scan += 1;
            }
            if (compact.len() < len - start) {
                u32 result = self.parse_type_name(compact.to_str());
                compact.drop();
                return result;
            }
            compact.drop();
        }

        if (name[len - 1] == (u8)')') {
            i64 open = -1;
            i64 pdepth = 0;
            i64 pi = len - 1;
            while (pi >= start) {
                if (name[pi] == (u8)')') { pdepth += 1; }
                else if (name[pi] == (u8)'(') {
                    pdepth -= 1;
                    if (pdepth == 0) { open = pi; break; }
                }
                pi -= 1;
            }
            if (open > start) {
                String result_text = String.new();
                pi = start;
                while (pi < open) { result_text.push(name[pi]); pi += 1; }
                u32 result_type = self.parse_type_name(result_text.to_str());
                result_text.drop();
                if (result_type == TYPE_UNKNOWN) { return TYPE_UNKNOWN; }
                Vec<u32> parameters = Vec<u32>.new();
                i64 p_start = open + 1;
                i64 angle = 0;
                i64 square = 0;
                pdepth = 0;
                pi = p_start;
                while (pi < len) {
                    bool separator = pi == len - 1;
                    if (!separator) {
                        if (name[pi] == (u8)'<') { angle += 1; }
                        else if (name[pi] == (u8)'>') { angle -= 1; }
                        else if (name[pi] == (u8)'[') { square += 1; }
                        else if (name[pi] == (u8)']') { square -= 1; }
                        else if (name[pi] == (u8)'(') { pdepth += 1; }
                        else if (name[pi] == (u8)')') { pdepth -= 1; }
                        else if (name[pi] == (u8)',' && angle == 0 && square == 0 && pdepth == 0) {
                            separator = true;
                        }
                    }
                    if (separator) {
                        if (pi == p_start) {
                            if (pi == len - 1 && p_start == open + 1) { break; }
                            parameters.drop();
                            return TYPE_UNKNOWN;
                        }
                        String parameter = String.new();
                        i64 j = p_start;
                        while (j < pi) { parameter.push(name[j]); j += 1; }
                        u32 parameter_type = self.parse_type_name(parameter.to_str());
                        parameter.drop();
                        if (parameter_type == TYPE_UNKNOWN) {
                            parameters.drop();
                            return TYPE_UNKNOWN;
                        }
                        parameters.push(parameter_type);
                        p_start = pi + 1;
                    }
                    pi += 1;
                }
                u32 result = self.get_function(result_type, &parameters);
                parameters.drop();
                return result;
            }
        }
        if (name[start] == (u8)38) {
            bool is_mut = false;
            i64 ref_start = start + 1;
            while (ref_start < len && (name[ref_start] == (u8)32 || name[ref_start] == (u8)9)) {
                ref_start += 1;
            }
            if (ref_start + 3 <= len && name[ref_start] == (u8)'m' && name[ref_start + 1] == (u8)'u'
                && name[ref_start + 2] == (u8)'t'
                && (ref_start + 3 == len || name[ref_start + 3] == (u8)' ' || name[ref_start + 3] == (u8)'\t'
                    || name[ref_start + 3] == (u8)'*')) {
                is_mut = true;
                ref_start += 3;
                while (ref_start < len && (name[ref_start] == (u8)32 || name[ref_start] == (u8)9)) {
                    ref_start += 1;
                }
            }
            if (ref_start + 5 <= len && name[ref_start] == (u8)'c' && name[ref_start + 1] == (u8)'o'
                && name[ref_start + 2] == (u8)'n' && name[ref_start + 3] == (u8)'s' && name[ref_start + 4] == (u8)'t'
                && (ref_start + 5 == len || name[ref_start + 5] == (u8)' ' || name[ref_start + 5] == (u8)'\t'
                    || name[ref_start + 5] == (u8)'*')) {
                ref_start += 5;
                while (ref_start < len && (name[ref_start] == (u8)32 || name[ref_start] == (u8)9)) {
                    ref_start += 1;
                }
            }
            if (ref_start >= len) { return TYPE_UNKNOWN; }
            String inner_text = String.new();
            i64 k = ref_start;
            while (k < len) { inner_text.push(name[k]); k += 1; }
            u32 inner = self.parse_type_name(inner_text.to_str());
            inner_text.drop();
            if (inner == TYPE_UNKNOWN) { return TYPE_UNKNOWN; }
            return self.get_reference(inner, is_mut);
        }
        if (start + 5 <= len && name[start] == (u8)'c' && name[start + 1] == (u8)'o'
            && name[start + 2] == (u8)'n' && name[start + 3] == (u8)'s' && name[start + 4] == (u8)'t'
            && (name[start + 5] == (u8)' ' || name[start + 5] == (u8)'\t')) {
            start += 5;
            while (start < len && (name[start] == (u8)32 || name[start] == (u8)9)) { start += 1; }
            if (start >= len) { return TYPE_UNKNOWN; }
            String rest = String.new();
            i64 k = start;
            while (k < len) { rest.push(name[k]); k += 1; }
            u32 result = self.parse_type_name(rest.to_str());
            rest.drop();
            return result;
        }
        if (name[len - 1] == (u8)93) {
            i64 open = len - 1;
            i64 square_depth = 0;
            while (open >= start) {
                if (name[open] == (u8)93) {
                    square_depth += 1;
                } else if (name[open] == (u8)91) {
                    square_depth -= 1;
                    if (square_depth == 0) { break; }
                }
                open -= 1;
            }
            if (open >= start) {
                i64 count = 0;
                bool digits = false;
                i64 d = open + 1;
                while (d < len - 1 && name[d] >= (u8)48 && name[d] <= (u8)57) {
                    digits = true;
                    count = count * 10 + ((i64)name[d] - 48);
                    d += 1;
                }
                if (open > start && digits && d == len - 1 && count > 0) {
                    String base = String.new();
                    i64 i = start;
                    while (i < open) { base.push(name[i]); i += 1; }
                    u32 inner = self.parse_type_name(base.to_str());
                    base.drop();
                    return self.get_array(inner, count);
                }
                i64 comma = open + 1;
                while (comma < len - 1 && name[comma] != (u8)',') { comma += 1; }
                if (comma < len - 1) {
                    Vec<u32> elements = Vec<u32>.new();
                    i64 part_start = open + 1;
                    i64 square_depth = 0;
                    i64 angle_depth = 0;
                    i64 paren_depth = 0;
                    i64 part = part_start;
                    bool valid = true;
                    while (part <= len - 1) {
                        bool separator = part == len - 1;
                        if (!separator) {
                            if (name[part] == (u8)'[') { square_depth += 1; }
                            else if (name[part] == (u8)']') { square_depth -= 1; }
                            else if (name[part] == (u8)'<') { angle_depth += 1; }
                            else if (name[part] == (u8)'>') { angle_depth -= 1; }
                            else if (name[part] == (u8)'(') { paren_depth += 1; }
                            else if (name[part] == (u8)')') { paren_depth -= 1; }
                            else if (name[part] == (u8)',' && square_depth == 0 && angle_depth == 0 && paren_depth == 0) {
                                separator = true;
                            }
                        }
                        if (separator) {
                            if (part == part_start) { valid = false; break; }
                            String element_text = String.new();
                            i64 j = part_start;
                            while (j < part) { element_text.push(name[j]); j += 1; }
                            u32 element_id = self.parse_type_name(element_text.to_str());
                            element_text.drop();
                            if (element_id == TYPE_UNKNOWN) { valid = false; break; }
                            elements.push(element_id);
                            part_start = part + 1;
                        }
                        part += 1;
                    }
                    if (valid && elements.len() > 1) {
                        u32 tuple_id = self.get_tuple(&elements);
                        elements.drop();
                        return tuple_id;
                    }
                    elements.drop();
                }
            }
        }
        if (name[len - 1] == (u8)42 || name[len - 1] == (u8)38) {
            bool pointer = name[len - 1] == (u8)42;
            String base = String.new();
            i64 i = start;
            while (i < len - 1) { base.push(name[i]); i += 1; }
            u32 inner = self.parse_type_name(base.to_str());
            base.drop();
            return pointer ? self.get_pointer(inner, true) : self.get_reference(inner, false);
        }
        i64 first = 0;
        while (first < len && (name[first] == (u8)32 || name[first] == (u8)9)) { first += 1; }
        i64 open_angle = -1;
        i64 depth = 0;
        i64 i = first;
        while (i < len) {
            if (name[i] == (u8)'<') {
                if (depth == 0) { open_angle = i; }
                depth += 1;
            } else if (name[i] == (u8)'>') {
                depth -= 1;
                if (depth < 0) { return TYPE_UNKNOWN; }
            }
            i += 1;
        }
        if (open_angle >= 0 && depth == 0 && name[len - 1] == (u8)'>') {
            String base = String.new();
            i = first;
            while (i < open_angle) {
                if (name[i] != (u8)32 && name[i] != (u8)9) { base.push(name[i]); }
                i += 1;
            }
            if (base.len() == 0) { base.drop(); return TYPE_UNKNOWN; }
            Vec<u32> args = Vec<u32>.new();
            i64 arg_start = open_angle + 1;
            i64 angle = 0;
            i64 square = 0;
            i64 paren = 0;
            i = arg_start;
            while (i <= len - 1) {
                bool separator = i == len - 1;
                if (i < len - 1) {
                    if (name[i] == (u8)'<') { angle += 1; }
                    else if (name[i] == (u8)'>') { angle -= 1; }
                    else if (name[i] == (u8)'[') { square += 1; }
                    else if (name[i] == (u8)']') { square -= 1; }
                    else if (name[i] == (u8)'(') { paren += 1; }
                    else if (name[i] == (u8)')') { paren -= 1; }
                    else if (name[i] == (u8)',' && angle == 0 && square == 0 && paren == 0) {
                        separator = true;
                    }
                }
                if (separator) {
                    String arg_text = String.new();
                    i64 a = arg_start;
                    while (a < i) { arg_text.push(name[a]); a += 1; }
                    if (arg_text.len() == 0) {
                        arg_text.drop(); args.drop(); base.drop(); return TYPE_UNKNOWN;
                    }
                    args.push(self.parse_type_name(arg_text.to_str()));
                    arg_text.drop();
                    arg_start = i + 1;
                }
                i += 1;
            }
            u32 result = self.get_named_args(base.to_str(), &args);
            args.drop();
            base.drop();
            return self.resolve_subst(result);
        }
        if (strcmp(name, "void") == 0) { return TYPE_VOID; }
        if (strcmp(name, "bool") == 0) { return TYPE_BOOL; }
        if (strcmp(name, "i8") == 0) { return TYPE_I8; }
        if (strcmp(name, "i16") == 0) { return TYPE_I16; }
        if (strcmp(name, "i32") == 0) { return TYPE_I32; }
        if (strcmp(name, "i64") == 0) { return TYPE_I64; }
        if (strcmp(name, "i128") == 0) { return TYPE_I128; }
        if (strcmp(name, "u8") == 0) { return TYPE_U8; }
        if (strcmp(name, "u16") == 0) { return TYPE_U16; }
        if (strcmp(name, "u32") == 0) { return TYPE_U32; }
        if (strcmp(name, "u64") == 0) { return TYPE_U64; }
        if (strcmp(name, "u128") == 0) { return TYPE_U128; }
        if (strcmp(name, "f32") == 0) { return TYPE_F32; }
        if (strcmp(name, "f64") == 0) { return TYPE_F64; }
        if (strcmp(name, "f80") == 0) { return TYPE_F80; }
        if (strcmp(name, "c32") == 0) { return TYPE_C32; }
        if (strcmp(name, "c64") == 0) { return TYPE_C64; }
        if (strcmp(name, "c80") == 0) { return TYPE_C80; }
        if (strcmp(name, "str") == 0) { return TYPE_STR; }
        if (strcmp(name, "char") == 0) { return TYPE_CHAR; }
        u32 probe_id = self.names.intern(name);
        i64 si = self.subst.len() - 1;
        while (si >= 0) {
            TypeSubst* binding = self.subst.get_ptr(si);
            if (binding.name_id == probe_id) { return self.resolve_subst(binding.type_id); }
            si -= 1;
        }
        return self.get_named(name);
    }

    TypeEntry* get(TypeTable* self, u32 id) {
        if ((i64)id >= self.types.len()) {
            return self.types.get_ptr(0);
        }
        return self.types.get_ptr((i64)id);
    }

    str type_name(TypeTable* self, u32 id) {
        if ((i64)id >= self.types.len()) {
            return "unknown";
        }
        TypeEntry* entry = self.types.get_ptr((i64)id);
        TypeKind kind = entry.kind;
        u32 inner = entry.inner;
        u32 name_id = entry.name_id;
        i64 count = entry.count;

        if (kind == TypeKind.Pointer) {
            if (name_id != 0) {
                return self.names.get(name_id);
            }
            str inner_name = self.type_name(inner);
            String formatted = String.from_str(inner_name);
            formatted.push((u8)'*');
            u32 cached_id = self.names.intern(formatted.to_str());
            formatted.drop();
            self.types.get_ptr((i64)id).name_id = cached_id;
            return self.names.get(cached_id);
        }
        if (kind == TypeKind.Reference) {
            if (name_id != 0) {
                return self.names.get(name_id);
            }
            str inner_name = self.type_name(inner);
            String formatted = String.from_str("&");
            if (entry.is_mut) {
                formatted.push_str("mut ");
            }
            formatted.push_str(inner_name);
            u32 cached_id = self.names.intern(formatted.to_str());
            formatted.drop();
            self.types.get_ptr((i64)id).name_id = cached_id;
            return self.names.get(cached_id);
        }
        if (kind == TypeKind.Array) {
            if (name_id != 0) {
                return self.names.get(name_id);
            }
            str inner_name = self.type_name(inner);
            String formatted = String.from_str(inner_name);
            formatted.push((u8)'[');
            String digits = String.new();
            i64 c = count;
            if (c == 0) { digits.push((u8)'0'); }
            while (c > 0) {
                digits.push((u8)('0' + (c % 10)));
                c = c / 10;
            }
            i64 left = 0;
            i64 right = digits.len() - 1;
            while (left < right) {
                u8 temp = digits.data[left];
                digits.data[left] = digits.data[right];
                digits.data[right] = temp;
                left += 1;
                right -= 1;
            }
            formatted.push_str(digits.to_str());
            digits.drop();
            formatted.push((u8)']');
            u32 cached_id = self.names.intern(formatted.to_str());
            formatted.drop();
            self.types.get_ptr((i64)id).name_id = cached_id;
            return self.names.get(cached_id);
        }
        if (kind == TypeKind.Tuple) {
            String formatted = String.from_str("[");
            i64 i = 0;
            while (i < count) {
                if (i > 0) { formatted.push_str(", "); }
                formatted.push_str(self.type_name(self.type_args.get(inner + (u32)i)));
                i += 1;
            }
            formatted.push((u8)']');
            u32 cached_id = self.names.intern(formatted.to_str());
            formatted.drop();
            self.types.get_ptr((i64)id).name_id = cached_id;
            return self.names.get(cached_id);
        }
        if (kind == TypeKind.Named && count > 0) {
            str base_name = self.names.get(name_id);
            String formatted = String.from_str(base_name);
            formatted.push((u8)'<');
            i64 i = 0;
            while (i < count) {
                if (i > 0) {
                    formatted.push((u8)',');
                }
                u32 arg_id = self.type_args.get(inner + (u32)i);
                formatted.push_str(self.type_name(arg_id));
                i += 1;
            }
            formatted.push((u8)'>');
            u32 formatted_id = self.names.intern(formatted.to_str());
            formatted.drop();
            return self.names.get(formatted_id);
        }
        if (name_id != 0) {
            return self.names.get(name_id);
        }
        return "unknown";
    }

    TypeProperties properties(TypeTable* self, u32 id) {
        return type_properties_at(self, id, 0);
    }
    void register_struct_properties(TypeTable* self, str name, Vec<u32>* fields) {
        u32 name_id = self.names.intern(name);
        u32 start = (u32)self.struct_fields.len();
        i64 i = 0;
        while (i < fields.len()) {
            self.struct_fields.push(fields.get(i));
            i += 1;
        }
        i = 0;
        while (i < self.struct_properties.len()) {
            TypeStructProperties* existing = self.struct_properties.get_ptr(i);
            if (existing.name_id == name_id) {
                existing.field_start = start;
                existing.field_count = (u32)fields.len();
                return;
            }
            i += 1;
        }
        TypeStructProperties definition;
        definition.name_id = name_id;
        definition.field_start = start;
        definition.field_count = (u32)fields.len();
        definition.field_name_start = 0;
        definition.field_name_count = 0;
        definition.type_param_start = 0;
        definition.type_param_count = 0;
        definition.needs_drop = false;
        self.struct_properties.push(definition);
    }

    void mark_struct_packed(TypeTable* self, str name) {
        u32 name_id = self.names.intern(name);
        i64 i = 0;
        while (i < self.packed_structs.len()) {
            if (self.packed_structs.get(i) == name_id) { return; }
            i += 1;
        }
        self.packed_structs.push(name_id);
    }

    bool struct_is_packed(TypeTable* self, str name) {
        u32 name_id = self.names.intern(name);
        i64 i = 0;
        while (i < self.packed_structs.len()) {
            if (self.packed_structs.get(i) == name_id) { return true; }
            i += 1;
        }
        return false;
    }
    void register_struct_field_names(TypeTable* self, str name, Vec<u32>* names) {
        u32 name_id = self.names.intern(name);
        u32 start = (u32)self.struct_field_names.len();
        i64 i = 0;
        while (i < names.len()) {
            self.struct_field_names.push(names.get(i));
            i += 1;
        }
        i = 0;
        while (i < self.struct_properties.len()) {
            TypeStructProperties* definition = self.struct_properties.get_ptr(i);
            if (definition.name_id == name_id) {
                definition.field_name_start = start;
                definition.field_name_count = (u32)names.len();
                return;
            }
            i += 1;
        }
    }
    void register_struct_type_params(TypeTable* self, str name, Vec<u32>* params) {
        u32 name_id = self.names.intern(name);
        u32 start = (u32)self.struct_type_params.len();
        i64 i = 0;
        while (i < params.len()) {
            self.struct_type_params.push(params.get(i));
            i += 1;
        }
        i = 0;
        while (i < self.struct_properties.len()) {
            TypeStructProperties* definition = self.struct_properties.get_ptr(i);
            if (definition.name_id == name_id) {
                definition.type_param_start = start;
                definition.type_param_count = (u32)params.len();
                return;
            }
            i += 1;
        }
    }
    void mark_type_needs_drop(TypeTable* self, str name) {
        u32 name_id = self.names.intern(name);
        i64 i = 0;
        while (i < self.struct_properties.len()) {
            TypeStructProperties* definition = self.struct_properties.get_ptr(i);
            if (definition.name_id == name_id) {
                definition.needs_drop = true;
                return;
            }
            i += 1;
        }
        TypeStructProperties definition;
        definition.name_id = name_id;
        definition.field_start = 0;
        definition.field_count = 0;
        definition.field_name_start = 0;
        definition.field_name_count = 0;
        definition.type_param_start = 0;
        definition.type_param_count = 0;
        definition.needs_drop = true;
        self.struct_properties.push(definition);
    }

    void register_method_param(TypeTable* self, str owner, str method,
                               i64 param_count, i64 index, u32 param_type,
                               bool is_value) {
        String base_owner = String.new();
        i64 oi = 0;
        while (owner[oi] != 0 && owner[oi] != (u8)'<') {
            base_owner.push(owner[oi]);
            oi += 1;
        }
        u32 owner_name_id = self.names.intern(base_owner.to_str());
        base_owner.drop();
        u32 method_name_id = self.names.intern(method);
        i64 i = 0;
        while (i < self.method_params.len()) {
            TypeMethodParam* entry = self.method_params.get_ptr(i);
            if (entry.owner_name_id == owner_name_id
                && entry.method_name_id == method_name_id
                && entry.param_count == param_count
                && entry.parameter_index == index
                && (entry.param_type == param_type || param_type == TYPE_UNKNOWN)) {
                entry.is_value = is_value;
                if (param_type != TYPE_UNKNOWN) {
                    entry.param_type = param_type;
                }
                return;
            }
            i += 1;
        }
        TypeMethodParam param;
        param.owner_name_id = owner_name_id;
        param.method_name_id = method_name_id;
        param.param_count = param_count;
        param.parameter_index = index;
        param.param_type = param_type;
        param.is_value = is_value;
        self.method_params.push(param);
    }

    bool method_param_is_value(TypeTable* self, str owner, str method,
                               i64 param_count, i64 index, u32 arg_type) {
        String base_owner = String.new();
        i64 oi = 0;
        while (owner[oi] != 0 && owner[oi] != (u8)'<') {
            base_owner.push(owner[oi]);
            oi += 1;
        }
        u32 owner_name_id = self.names.intern(base_owner.to_str());
        base_owner.drop();
        u32 method_name_id = self.names.intern(method);
        if (arg_type != TYPE_UNKNOWN) {
            i64 i = 0;
            while (i < self.method_params.len()) {
                TypeMethodParam* entry = self.method_params.get_ptr(i);
                if (entry.owner_name_id == owner_name_id
                    && entry.method_name_id == method_name_id
                    && (param_count == 0 || entry.param_count == param_count)
                    && entry.parameter_index == index
                    && entry.param_type == arg_type) {
                    return entry.is_value;
                }
                i += 1;
            }
        }
        if (param_count > 0) {
            i64 i = 0;
            while (i < self.method_params.len()) {
                TypeMethodParam* entry = self.method_params.get_ptr(i);
                if (entry.owner_name_id == owner_name_id
                    && entry.method_name_id == method_name_id
                    && entry.param_count == param_count
                    && entry.parameter_index == index) {
                    return entry.is_value;
                }
                i += 1;
            }
        }
        i64 i = 0;
        while (i < self.method_params.len()) {
            TypeMethodParam* entry = self.method_params.get_ptr(i);
            if (entry.owner_name_id == owner_name_id
                && entry.method_name_id == method_name_id
                && entry.parameter_index == index) {
                return entry.is_value;
            }
            i += 1;
        }
        return false;
    }


    bool is_copy(TypeTable* self, u32 id) {
        return self.properties(id).is_copy;
    }
}

bool type_is_primitive(u32 id) {
    return id >= TYPE_VOID && id <= TYPE_PRIMITIVE_MAX;
}

bool type_is_integer(u32 id) {
    return id >= TYPE_I8 && id <= TYPE_U128;
}

bool type_is_signed_integer(u32 id) {
    return id >= TYPE_I8 && id <= TYPE_I128;
}

bool type_is_unsigned_integer(u32 id) {
    return id >= TYPE_U8 && id <= TYPE_U128;
}

bool type_is_float(u32 id) {
    return id >= TYPE_F32 && id <= TYPE_F80;
}

bool type_is_numeric(u32 id) {
    return id >= TYPE_I8 && id <= TYPE_C80;
}

bool types_is_primitive_name(str name) {
    if (strlen(name) == 0) { return false; }
    if (strcmp(name, "void") == 0 || strcmp(name, "bool") == 0
        || strcmp(name, "str") == 0 || strcmp(name, "char") == 0) {
        return true;
    }
    if (name[0] == (u8)'i' || name[0] == (u8)'u') {
        return strcmp(name, "i8") == 0 || strcmp(name, "i16") == 0
            || strcmp(name, "i32") == 0 || strcmp(name, "i64") == 0
            || strcmp(name, "i128") == 0 || strcmp(name, "u8") == 0
            || strcmp(name, "u16") == 0 || strcmp(name, "u32") == 0
            || strcmp(name, "u64") == 0 || strcmp(name, "u128") == 0;
    }
    if (name[0] == (u8)'f' || name[0] == (u8)'c') {
        return strcmp(name, "f32") == 0 || strcmp(name, "f64") == 0
            || strcmp(name, "f80") == 0 || strcmp(name, "c32") == 0
            || strcmp(name, "c64") == 0 || strcmp(name, "c80") == 0;
    }
    return false;
}
