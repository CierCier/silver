// libs/agc/src/frontend/messages.ag — Centralized diagnostic message catalog and typo suggestions.
import std.mem.vec;
import std.string;

/// Diagnostic text: "cannot borrow owned storage without its
/// initialization-state capability". Returns an owned string.
String reference_state_unavailable() {
    return String.from_str("cannot borrow owned storage without its initialization-state capability");
}

/// Diagnostic text: "cannot represent owner initialization plan for '{}':
/// unresolved inline layout or more than 65536 nodes / 256 projection
/// levels". Returns an owned string.
String init_plan_unrepresentable(str type_name) {
    return @format("cannot represent owner initialization plan for '{}': unresolved inline layout or more than 65536 nodes / 256 projection levels", type_name);
}

/// Diagnostic text: "owner initialization update has no resolved inline
/// place". Returns an owned string.
String init_plan_unknown_place() {
    return String.from_str("owner initialization update has no resolved inline place");
}

/// Diagnostic text: "enum variant '{}' discriminant or automatic successor
/// exceeds the supported integer range". Returns an owned string.
String enum_discriminant_overflow(str name) {
    return @format("enum variant '{}' discriminant or automatic successor exceeds the supported integer range", name);
}

/// Diagnostic text: "enum discriminant exceeds the supported 16-bit tag range
/// {}", with the signed or unsigned range. Returns an owned string.
String enum_tag_out_of_range(bool signed_tag) {
    str range = signed_tag ? "-32768..32767" : "0..65535";
    return @format("enum discriminant exceeds the supported 16-bit tag range {}", range);
}

/// Diagnostic text: "payload enum variant '{}' has duplicate discriminant
/// {}". Returns an owned string.
String enum_payload_duplicate_discriminant(str name, i64 value) {
    return @format("payload enum variant '{}' has duplicate discriminant {}", name, value);
}

