/// Returns the smallest of three values.
i64 min3(i64 a, i64 b, i64 c) {
    i64 m = a;
    if (b < m) { m = b; }
    if (c < m) { m = c; }
    return m;
}

/// Returns the Levenshtein edit distance between `s1` and `s2` (byte-wise).
/// Strings longer than 48 bytes return 999, meaning "too far".
i64 levenshtein(str s1, str s2) {
    i64 l1 = strlen(s1);
    i64 l2 = strlen(s2);
    if (l1 == 0) { return l2; }
    if (l2 == 0) { return l1; }
    if (l1 > 48 || l2 > 48) { return 999; }

    i64 d[2500];
    for (i64 i = 0; i <= l1; i = i + 1) {
        d[i * 50] = i;
    }
    for (i64 j = 0; j <= l2; j = j + 1) {
        d[j] = j;
    }
    for (i64 i = 1; i <= l1; i = i + 1) {
        for (i64 j = 1; j <= l2; j = j + 1) {
            i64 cost = 0;
            if (s1[i - 1] != s2[j - 1]) {
                cost = 1;
            }
            d[i * 50 + j] = min3(
                d[(i - 1) * 50 + j] + 1,
                d[i * 50 + (j - 1)] + 1,
                d[(i - 1) * 50 + (j - 1)] + cost
            );
        }
    }
    return d[l1 * 50 + l2];
}

/// Returns the candidate closest to `target` within `max_dist` edits (the
/// first one on ties), or "" when none is close enough. Borrows the result
/// from `candidates`.
str fuzzy_suggest(str target, Vec<str>* candidates, i64 max_dist) {
    i64 best_dist = max_dist + 1;
    str best_cand = "";
    i64 i = 0;
    while (i < candidates.len()) {
        str cand = candidates.get(i);
        i64 dist = levenshtein(target, cand);
        if (dist < best_dist) {
            best_dist = dist;
            best_cand = cand;
        }
        i += 1;
    }
    if (best_dist <= max_dist) {
        return best_cand;
    }
    return "";
}

/// Diagnostic text: "unsupported C callback signature: use ABI-compatible
