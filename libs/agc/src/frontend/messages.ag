/// Diagnostic text: "macro '@{}' expects [at least ]{} argument(s), got {}".
/// Returns an owned string.
String macro_arity(str name, i64 fixed, bool variadic, i64 got) {
    str qualifier = variadic ? "at least " : "";
    return @format("macro '@{}' expects {}{} argument(s), got {}", name, qualifier, fixed, got);
}

/// Diagnostic text: "macro '@{}' requires its variadic parameter to be last".
/// Returns an owned string.
String macro_variadic_must_be_last(str name) {
    return @format("macro '@{}' requires its variadic parameter to be last", name);
}

/// Diagnostic text: "invalid optimization level '{}'; expected 0, 1, 2, 3, s,
/// z, or fast". Returns an owned string.
String invalid_optimization_level(str level) {
    String message = String.from_str("invalid optimization level '");
    message.push_str(level);
    message.push_str("'; expected 0, 1, 2, 3, s, z, or fast");
    return move message;
}

/// Diagnostic text: "LLVM optimization failed: {}". Returns an owned string.
String llvm_optimization_failed(str detail) {
    String message = String.from_str("LLVM optimization failed: ");
    message.push_str(detail);
    return move message;
}

/// Returns the suffix ", did you mean '{}'?" for appending to a message.
String did_you_mean(str suggestion) {
    String s = String.from_str(", did you mean '");
    s.push_str(suggestion);
    s.push_str("'?");
    return move s;
}

