/// `unknown_type`, plus a "did you mean" suffix when `suggestion` is non-empty.
String unknown_type_with_suggestion(str name, str suggestion) {
    String s = unknown_type(name);
    if (strlen(suggestion) > 0) {
        s.push_str(did_you_mean(suggestion).to_str());
    }
    return move s;
}

