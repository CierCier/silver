/// Diagnostic text: "import '{}' has submodule config '{}', but prebuilt
/// artifact '{}' is missing; stage1 requires a prebuilt .agm artifact".
/// Returns an owned string.
String missing_submodule_artifact(str name, str config_path, str artifact_path) {
    String message = String.from_str("import `");
    message.push_str(name);
    message.push_str("` has submodule config `");
    message.push_str(config_path);
    message.push_str("`, but prebuilt artifact `");
    message.push_str(artifact_path);
    message.push_str("` is missing; stage1 requires a prebuilt .agm artifact");
    return move message;
}

