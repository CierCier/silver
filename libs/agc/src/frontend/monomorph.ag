// libs/agc/src/frontend/monomorph.ag — Monomorphization request collection and symbol mangling.
import std.intern;
import std.mem.vec;
import std.string;
import frontend.ast;
import frontend.ast_expr;
import frontend.bindings;
import frontend.items;
import frontend.messages;
import frontend.typecheck_expr;
import frontend.types;

struct MonoMethodTemplate {
    SyntaxNode* ret_start;
    SyntaxNode* name_node;
    SyntaxNode* params_node;
    SyntaxNode* body_node;
    u32 receiver_depth;
}

bool mono_contains_type_param(Vec<u32>* params, u32 name_id) {
    i64 i = 0;
    while (i < params.len()) {
        if (params.get(i) == name_id) {
            return true;
        }
        i += 1;
    }
    return false;
}

void mono_collect_param_segment(SyntaxNode* start, SyntaxNode* end, TypeTable* types, Vec<u32>* out) {
    SyntaxNode* cursor = start;
    while (cursor != (SyntaxNode*)0 && cursor != end) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Const) {
            return;
        }
        if (cursor.kind == NodeKind.Token && node_is_identifier(cursor)) {
            u32 name_id = types.names.intern(cursor.text);
            if (!mono_contains_type_param(out, name_id)) {
                out.push(name_id);
            }
            return;
        }
        cursor = cursor.next_sibling;
    }
}

void mono_collect_generic_parameters(SyntaxNode* less, TypeTable* types, Vec<u32>* out) {
    if (less == (SyntaxNode*)0 || less.kind != NodeKind.Token || less.token_kind != TokenKind.Less) {
        return;
    }
    i64 depth = 1;
    SyntaxNode* segment_start = less.next_sibling;
    SyntaxNode* cursor = segment_start;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token) {
            if (cursor.token_kind == TokenKind.Less) {
                depth += 1;
            } else if (cursor.token_kind == TokenKind.Greater) {
                depth -= 1;
                if (depth == 0) {
                    mono_collect_param_segment(segment_start, cursor, types, out);
                    return;
                }
            } else if (cursor.token_kind == TokenKind.Comma && depth == 1) {
                mono_collect_param_segment(segment_start, cursor, types, out);
                segment_start = cursor.next_sibling;
            }
        }
        cursor = cursor.next_sibling;
    }
}

void mono_collect_target_parameters(SyntaxNode* target, TypeTable* types, Vec<u32>* declared, Vec<u32>* out) {
    if (target == (SyntaxNode*)0) {
        return;
    }
    SyntaxNode* less = target.next_sibling;
    if (less == (SyntaxNode*)0 || less.kind != NodeKind.Token || less.token_kind != TokenKind.Less) {
        return;
    }
    i64 depth = 1;
    SyntaxNode* cursor = less.next_sibling;
    while (cursor != (SyntaxNode*)0 && depth > 0) {
        if (cursor.kind == NodeKind.Token) {
            if (cursor.token_kind == TokenKind.Less) {
                depth += 1;
            } else if (cursor.token_kind == TokenKind.Greater) {
                depth -= 1;
            } else if (cursor.token_kind == TokenKind.Identifier) {
                u32 name_id = types.names.intern(cursor.text);
                if (mono_contains_type_param(declared, name_id) && !mono_contains_type_param(out, name_id)) {
                    out.push(name_id);
                }
            }
        }
        cursor = cursor.next_sibling;
    }
}

bool mono_match_target_args(SyntaxNode* target, TypeTable* types, Vec<u32>* declared_params, Vec<u32>* arg_ids, Vec<u32>* out_param_ids) {
    if (target == (SyntaxNode*)0) { return false; }
    SyntaxNode* less = target.next_sibling;
    if (less == (SyntaxNode*)0 || less.kind != NodeKind.Token || less.token_kind != TokenKind.Less) {
        return arg_ids.len() == 0;
    }
    i64 depth = 1;
    SyntaxNode* seg_start = less.next_sibling;
    SyntaxNode* cursor = seg_start;
    i64 arg_idx = 0;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token) {
            if (cursor.token_kind == TokenKind.Less) {
                depth += 1;
            } else if (cursor.token_kind == TokenKind.Greater) {
                depth -= 1;
                if (depth == 0) {
                    if (arg_idx >= arg_ids.len()) { return false; }
                    String seg_text = String.new();
                    SyntaxNode* s = seg_start;
                    while (s != (SyntaxNode*)0 && s != cursor) {
                        if (s.kind == NodeKind.Token) { seg_text.push_str(s.text); }
                        s = s.next_sibling;
                    }
                    u32 name_id = types.names.intern(seg_text.to_str());
                    if (mono_contains_type_param(declared_params, name_id)) {
                        out_param_ids.push(name_id);
                    } else {
                        u32 seg_type_id = type_id_from_text(types, seg_text.to_str());
                        if (seg_type_id == TYPE_UNKNOWN) {
                            seg_type_id = types.parse_type_name(seg_text.to_str());
                        }
                        if (seg_type_id != arg_ids.get(arg_idx)) {
                            seg_text.drop();
                            return false;
                        }
                        out_param_ids.push(0);
                    }
                    seg_text.drop();
                    arg_idx += 1;
                    if (arg_idx != arg_ids.len()) { return false; }
                    i64 i = 0;
                    while (i < out_param_ids.len()) {
                        i64 j = 0;
                        while (j < i) {
                            if (out_param_ids.get(i) != 0
                                && out_param_ids.get(i) == out_param_ids.get(j)
                                && arg_ids.get(i) != arg_ids.get(j)) { return false; }
                            j += 1;
                        }
                        i += 1;
                    }
                    return true;
                }
            } else if (cursor.token_kind == TokenKind.Comma && depth == 1) {
                if (arg_idx >= arg_ids.len()) { return false; }
                String seg_text = String.new();
                SyntaxNode* s = seg_start;
                while (s != (SyntaxNode*)0 && s != cursor) {
                    if (s.kind == NodeKind.Token) { seg_text.push_str(s.text); }
                    s = s.next_sibling;
                }
                u32 name_id = types.names.intern(seg_text.to_str());
                if (mono_contains_type_param(declared_params, name_id)) {
                    out_param_ids.push(name_id);
                } else {
                    u32 seg_type_id = type_id_from_text(types, seg_text.to_str());
                    if (seg_type_id == TYPE_UNKNOWN) {
                        seg_type_id = types.parse_type_name(seg_text.to_str());
                    }
                    if (seg_type_id != arg_ids.get(arg_idx)) {
                        seg_text.drop();
                        return false;
                    }
                    out_param_ids.push(0);
                }
                seg_text.drop();
                arg_idx += 1;
                seg_start = cursor.next_sibling;
            }
        }
        cursor = cursor.next_sibling;
    }
    return false;
}

void mono_collect_struct_parameters(SyntaxNode* root, str base, TypeTable* types, Vec<u32>* out) {
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Struct || item.kind == NodeKind.Enum) {
            SyntaxNode* name_node = item_identifier(item);
            if (name_node != (SyntaxNode*)0 && strcmp(name_node.text, base) == 0) {
                SyntaxNode* cursor = name_node.next_sibling;
                while (cursor != (SyntaxNode*)0 && cursor.kind != NodeKind.Block) {
                    if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Less) {
                        mono_collect_generic_parameters(cursor, types, out);
                        return;
                    }
                    cursor = cursor.next_sibling;
                }
                return;
            }
        }
        item = item.next_sibling;
    }
}

// Find an impl block for `base` defining `method`, matching type arguments `arg_ids`.
// Collects the impl-level type parameter names (deduped, in order) for substitution.
// For specialized concrete impls, param_ids will be empty (no substitution needed).
bool mono_find_method_template(SyntaxNode* root, TypeTable* types, str base, str method,
                               u32 receiver_depth, Vec<u32>* arg_ids,
                               MonoMethodTemplate* out, Vec<u32>* param_ids,
                               i64 value_arg_count, bool static_method,
                               AstPool* call_pool, u32 call_args, SyntaxNode* required_name) {
    if (root == (SyntaxNode*)0) {
        return false;
    }
    bool found_any = false;
    i64 best_specificity = -1;
    bool best_concrete_owner = false;
    bool best_generic_method = true;
    MonoMethodTemplate generic_template;
    Vec<u32> generic_params = Vec<u32>.new();

    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0) {
                String target_base = String.new();
                i64 bi = 0;
                while (target.text[bi] != (u8)0 && target.text[bi] != (u8)60) {
                    target_base.push(target.text[bi]);
                    bi += 1;
                }
                bool is_base = strcmp(target_base.to_str(), base) == 0;
                target_base.drop();
                if (is_base && impl_target_pointer_depth(item) == receiver_depth) {
                    SyntaxNode* block = item.first_child;
                    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                        block = block.next_sibling;
                    }
                    if (block != (SyntaxNode*)0) {
                        SyntaxNode* cursor = block.first_child;
                        while (cursor != (SyntaxNode*)0) {
                            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                                cursor = cursor.next_sibling;
                                continue;
                            }
                            SyntaxNode* current_ret = cursor;
                            SyntaxNode* current_name = (SyntaxNode*)0;
                            SyntaxNode* current_params = (SyntaxNode*)0;
                            SyntaxNode* current_body = (SyntaxNode*)0;
                            SyntaxNode* scan = cursor;
                            bool hit_semi = false;
                            SyntaxNode* semi_node = (SyntaxNode*)0;
                            while (scan != (SyntaxNode*)0) {
                                if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon) {
                                    hit_semi = true;
                                    semi_node = scan;
                                    break;
                                }
                                if (scan.kind == NodeKind.Block) {
                                    current_body = scan;
                                    break;
                                }
                                if (scan.kind == NodeKind.Parenthesized) {
                                    current_params = scan;
                                    if (scan.next_sibling != (SyntaxNode*)0 && scan.next_sibling.kind == NodeKind.Block) {
                                        current_body = scan.next_sibling;
                                        break;
                                    }
                                }
                                if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                                    current_name = scan;
                                }
                                scan = scan.next_sibling;
                            }
                            if (hit_semi) {
                                cursor = semi_node.next_sibling;
                                continue;
                            }
                            current_name = item_method_name(current_ret, current_params);
                            if (current_body != (SyntaxNode*)0 && current_body.kind == NodeKind.Block) {
                                if (current_name != (SyntaxNode*)0 && strcmp(current_name.text, method) == 0
                                    && current_params != (SyntaxNode*)0) {
                                    if (value_arg_count >= 0) {
                                        Vec<Binding> params = Vec<Binding>.new();
                                        collect_parameter_bindings(current_params, &params);
                                        bool matches_call = params.len() == value_arg_count + (static_method ? 0 : 1)
                                            && item_first_parameter_is_self(current_params) != static_method;
                                        params.drop();
                                        if (!matches_call) {
                                            cursor = current_body.next_sibling;
                                            continue;
                                        }
                                    }
                                    Vec<u32> declared_params = Vec<u32>.new();
                                    SyntaxNode* impl_head = item.first_child;
                                    while (impl_head != (SyntaxNode*)0 && impl_head.kind != NodeKind.Block) {
                                        if (impl_head.kind == NodeKind.Token && impl_head.token_kind == TokenKind.Impl) {
                                            SyntaxNode* generic_open = impl_head.next_sibling;
                                            if (generic_open != (SyntaxNode*)0 && generic_open.kind == NodeKind.Token
                                                && generic_open.token_kind == TokenKind.Less) {
                                                mono_collect_generic_parameters(generic_open, types, &declared_params);
                                            }
                                            break;
                                        }
                                        impl_head = impl_head.next_sibling;
                                    }
                                    if (declared_params.len() == 0) {
                                        mono_collect_struct_parameters(root, base, types, &declared_params);
                                    }
                                    Vec<u32> candidate_params = Vec<u32>.new();
                                    bool matched = mono_match_target_args(target, types, &declared_params, arg_ids, &candidate_params);
                                    declared_params.drop();
                                    if (matched && (required_name == (SyntaxNode*)0 || current_name == required_name)) {
                                        MonoMethodTemplate candidate;
                                        candidate.ret_start = current_ret;
                                        candidate.name_node = current_name;
                                        candidate.params_node = current_params;
                                        candidate.body_node = current_body;
                                        candidate.receiver_depth = receiver_depth;
                                        bool generic_method = item_method_is_generic(current_name);
                                        i64 specificity = 0;
                                        if (call_pool != (AstPool*)0) {
                                            Vec<u32> names = Vec<u32>.new();
                                            Vec<u32> args = Vec<u32>.new();
                                            i64 copy_index = 0;
                                            while (copy_index < candidate_params.len()) {
                                                names.push(candidate_params.get(copy_index));
                                                args.push(arg_ids.get(copy_index));
                                                copy_index += 1;
                                            }
                                            String failure = String.new();
                                            u32 receiver_type = arg_ids.len() == 0
                                                ? types.parse_type_name(base) : types.get_named_args(base, arg_ids);
                                            specificity = mono_match_method_call(call_pool, root, types,
                                                receiver_type, call_args, static_method, &candidate,
                                                &names, &args, &failure);
                                            names.drop();
                                            args.drop();
                                            failure.drop();
                                        }
                                        bool concrete_owner = receiver_binding_count(&candidate_params, candidate_params.len()) == 0;
                                        bool preferred = !found_any || specificity > best_specificity
                                            || (specificity == best_specificity
                                                && ((concrete_owner && !best_concrete_owner)
                                                    || (concrete_owner == best_concrete_owner
                                                        && !generic_method && best_generic_method)));
                                        if ((specificity >= 0 || generic_method) && preferred) {
                                            best_specificity = specificity;
                                            best_concrete_owner = concrete_owner;
                                            best_generic_method = generic_method;
                                            found_any = true;
                                            generic_template = candidate;
                                            generic_params.clear();
                                            i64 cp = 0;
                                            while (cp < candidate_params.len()) {
                                                generic_params.push(candidate_params.get(cp));
                                                cp += 1;
                                            }
                                        }
                                    }
                                    candidate_params.drop();
                                }
                                cursor = current_body.next_sibling;
                                continue;
                            }
                            cursor = cursor.next_sibling;
                        }
                    }
                }
            }
        }
        item = item.next_sibling;
    }
    if (found_any) {
        out.ret_start = generic_template.ret_start;
        out.name_node = generic_template.name_node;
        out.params_node = generic_template.params_node;
        out.body_node = generic_template.body_node;
        out.receiver_depth = generic_template.receiver_depth;
        i64 cp = 0;
        while (cp < generic_params.len()) {
            param_ids.push(generic_params.get(cp));
            cp += 1;
        }
        generic_params.drop();
        return true;
    }
    generic_params.drop();
    return false;
}
bool mono_unify_free_parameter(TypeTable* types, u32 formal_id, u32 actual_id,
                               Vec<u32>* param_ids, Vec<u32>* inferred,
                               bool numeric_literal) {
    if (actual_id == TYPE_UNKNOWN) { return false; }
    TypeEntry* formal = types.get(formal_id);
    TypeEntry* actual = types.get(actual_id);
    if (formal.kind == TypeKind.Named && formal.count == 0) {
        i64 i = 0;
        while (i < param_ids.len()) {
            if (formal.name_id == param_ids.get(i)) {
                u32* found = inferred.get_ptr(i);
                if (*found == TYPE_UNKNOWN) {
                    *found = actual_id;
                    return true;
                }
                return *found == actual_id
                    || (numeric_literal && type_is_numeric(*found) && type_is_numeric(actual_id));
            }
            i += 1;
        }
    }
    if (formal.kind == TypeKind.Function
        && (actual.kind == TypeKind.Pointer || actual.kind == TypeKind.Reference)
        && types.get(actual.inner).kind == TypeKind.Function) {
        return mono_unify_free_parameter(types, formal_id, actual.inner, param_ids,
            inferred, numeric_literal);
    }
    if ((formal.kind == TypeKind.Pointer || formal.kind == TypeKind.Reference)
        && types.get(formal.inner).kind == TypeKind.Function
        && actual.kind == TypeKind.Function) {
        return mono_unify_free_parameter(types, formal.inner, actual_id, param_ids,
            inferred, numeric_literal);
    }
    if ((formal.kind == TypeKind.Reference && actual.kind == TypeKind.Pointer)
        || (formal.kind == TypeKind.Pointer && actual.kind == TypeKind.Reference)) {
        return mono_unify_free_parameter(types, formal.inner, actual.inner, param_ids, inferred,
            numeric_literal);
    }
    if (formal.kind != actual.kind) { return false; }
    if (formal.kind == TypeKind.Pointer || formal.kind == TypeKind.Reference) {
        return mono_unify_free_parameter(types, formal.inner, actual.inner, param_ids, inferred,
            numeric_literal);
    }
    if (formal.kind == TypeKind.Array) {
        return formal.count == actual.count
            && mono_unify_free_parameter(types, formal.inner, actual.inner, param_ids, inferred,
                numeric_literal);
    }
    if (formal.kind == TypeKind.Function) {
        if (formal.count != actual.count
            || !mono_unify_free_parameter(types, types.type_args.get(formal.inner),
                types.type_args.get(actual.inner), param_ids, inferred, numeric_literal)) {
            return false;
        }
        i64 i = 0;
        while (i < formal.count) {
            if (!mono_unify_free_parameter(types,
                    types.type_args.get(formal.inner + 1 + (u32)i),
                    types.type_args.get(actual.inner + 1 + (u32)i),
                    param_ids, inferred, numeric_literal)) {
                return false;
            }
            i += 1;
        }
        return true;
    }
    if (formal.kind == TypeKind.Named || formal.kind == TypeKind.Tuple) {
        if (formal.count != actual.count
            || (formal.kind == TypeKind.Named && formal.name_id != actual.name_id)) { return false; }
        i64 i = 0;
        while (i < formal.count) {
            if (!mono_unify_free_parameter(types, types.type_args.get(formal.inner + i),
                    types.type_args.get(actual.inner + i), param_ids, inferred, numeric_literal)) {
                return false;
            }
            i += 1;
        }
        return true;
    }
    return formal_id == actual_id
        || (numeric_literal && type_is_numeric(formal_id) && type_is_numeric(actual_id));
}

// Receiver arguments occupy the prefix; method arguments follow in declaration
// order. Concrete impl targets have zero placeholders in the binding-name list.
bool mono_resolve_generic_method(AstPool* pool, SyntaxNode* root, TypeTable* types,
                                 u32 receiver_type, str method, u32 args_start,
                                 bool static_method, MonoMethodTemplate* template,
                                 Vec<u32>* param_ids, Vec<u32>* arg_ids,
                                 String* failure) {
    if (pool == (AstPool*)0 || root == (SyntaxNode*)0) { return false; }
    receiver_type = types.resolve_subst(receiver_type);
    TypeEntry* receiver = types.get(receiver_type);
    u32 depth = 0;
    while (receiver.kind == TypeKind.Pointer || receiver.kind == TypeKind.Reference) {
        receiver_type = receiver.inner;
        depth += 1;
        receiver = types.get(receiver_type);
    }
    if (receiver.kind != TypeKind.Named && !type_is_primitive(receiver_type)) { return false; }
    str base = types.names.get(receiver.name_id);
    i64 count = receiver.count;
    u32 start = receiver.inner;
    i64 i = 0;
    while (i < count) {
        arg_ids.push(types.resolve_subst(types.type_args.get(start + (u32)i)));
        i += 1;
    }
    bool found = mono_find_method_template(root, types, base, method, depth,
        arg_ids, template, param_ids, (i64)pool.args.get((i64)args_start), static_method,
        pool, args_start, (SyntaxNode*)0);
    if (!found && depth > 0) {
        found = mono_find_method_template(root, types, base, method, 0,
            arg_ids, template, param_ids, (i64)pool.args.get((i64)args_start), static_method,
            pool, args_start, (SyntaxNode*)0);
    }
    if (!found || !item_method_is_generic(template.name_node)) { return false; }
    mono_match_method_call(pool, root, types, receiver_type, args_start,
        static_method, template, param_ids, arg_ids, failure);
    return true;
}

i64 mono_type_specificity(TypeTable* types, u32 type_id, Vec<u32>* method_params) {
    TypeEntry* entry = types.get(type_id);
    if (entry.kind == TypeKind.Named && entry.count == 0
        && mono_contains_type_param(method_params, entry.name_id)) { return 0; }
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference
        || entry.kind == TypeKind.Array || entry.kind == TypeKind.Slice) {
        return 1 + mono_type_specificity(types, entry.inner, method_params);
    }
    i64 score = 1;
    if (entry.kind == TypeKind.Named || entry.kind == TypeKind.Tuple) {
        i64 i = 0;
        while (i < entry.count) {
            score += mono_type_specificity(types, types.type_args.get(entry.inner + (u32)i), method_params);
            i += 1;
        }
    }
    return score;
}

i64 mono_match_method_call(AstPool* pool, SyntaxNode* root, TypeTable* types,
                            u32 receiver_type, u32 args_start, bool static_method,
                            MonoMethodTemplate* template, Vec<u32>* param_ids,
                            Vec<u32>* arg_ids, String* failure) {
    i64 count = arg_ids.len();
    i64 i = 0;
    while (param_ids.len() < count) { param_ids.push(0); }
    Vec<u32> method_params = Vec<u32>.new();
    mono_collect_generic_parameters(template.name_node.next_sibling, types, &method_params);
    Vec<u32> inferred = Vec<u32>.new();
    i = 0;
    while (i < count) {
        if (param_ids.get(i) != 0) { types.push_subst(param_ids.get(i), arg_ids.get(i)); }
        i += 1;
    }
    u32 self_type = receiver_type;
    u32 self_depth = 0;
    while (self_depth < template.receiver_depth) {
        self_type = types.get_pointer(self_type, true);
        self_depth += 1;
    }
    types.push_subst(types.names.intern("Self"), self_type);
    i64 receiver_bindings = receiver_binding_count(param_ids, count) + 1;
    i = 0;
    while (i < method_params.len()) {
        u32 name = method_params.get(i);
        u32 shadow = types.get_named(types.names.get(name));
        types.push_subst(name, shadow);
        inferred.push(TYPE_UNKNOWN);
        i += 1;
    }
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(template.params_node, &params);
    u32 arg_count = pool.args.get((i64)args_start);
    i64 offset = static_method ? 0 : 1;
    bool matched = pool != (AstPool*)0 && params.len() == (i64)arg_count + offset;
    i64 specificity = 0;
    i = 0;
    while (matched && i < (i64)arg_count) {
        Binding* param = params.get_ptr(i + offset);
        String text = binding_parameter_type_text(param);
        u32 formal = types.parse_type_name(text.to_str());
        text.drop();
        if (!binding_has_function_type(param)) {
            if (param.declared_type.kind == ProjectionTypeKind.Reference) {
                formal = types.get_reference(formal, param.declared_type.is_mutable);
            } else if (param.declared_type.kind == ProjectionTypeKind.Pointer) {
                formal = types.get_pointer(formal, true);
            }
        }
        u32 actual_id = pool.args.get((i64)args_start + 1 + i);
        specificity += mono_type_specificity(types, formal, &method_params);
        if (method_params.len() == 0) {
            i64 argument_score = 0;
            matched = typecheck_method_argument_score(pool, types, root, receiver_type,
                actual_id, formal, &argument_score);
        } else {
            AstExpr* actual = pool.get_expr(actual_id);
            bool literal = actual.kind == ExprKind.Literal && type_is_numeric(actual.aux);
            matched = mono_unify_free_parameter(types, formal,
                types.resolve_subst(actual.inferred_type), &method_params, &inferred, literal);
        }
        i += 1;
    }
    types.pop_subst(method_params.len());
    i = 0;
    while (i < method_params.len()) {
        if (inferred.get(i) == TYPE_UNKNOWN) { matched = false; }
        param_ids.push(method_params.get(i));
        arg_ids.push(inferred.get(i));
        types.push_subst(method_params.get(i), inferred.get(i));
        i += 1;
    }
    if (!matched) { failure.push_str(generic_method_inference_failed()); }
    else if (item_method_is_generic(template.name_node)) {
        mono_check_method_bounds(root, types, template, failure);
    }
    types.pop_subst(method_params.len() + receiver_bindings);
    params.drop();
    inferred.drop();
    method_params.drop();
    return matched && failure.len() == 0 ? specificity : -1;
}

i64 receiver_binding_count(Vec<u32>* param_ids, i64 count) {
    i64 bindings = 0;
    i64 i = 0;
    while (i < count) {
        if (param_ids.get(i) != 0) { bindings += 1; }
        i += 1;
    }
    return bindings;
}

void mono_push_method_bindings(TypeTable* types, Vec<u32>* param_ids, Vec<u32>* arg_ids) {
    i64 i = 0;
    while (i < param_ids.len()) {
        if (param_ids.get(i) != 0) { types.push_subst(param_ids.get(i), arg_ids.get(i)); }
        i += 1;
    }
}

void mono_check_method_bounds(SyntaxNode* root, TypeTable* types,
                              MonoMethodTemplate* template, String* failure) {
    mono_check_bound_list(root, types, template.name_node.next_sibling.next_sibling,
        template.params_node, failure, 0);
    if (failure.len() > 0) { return; }
    SyntaxNode* cursor = template.params_node.next_sibling;
    if (cursor != (SyntaxNode*)0 && cursor != template.body_node) {
        if (strcmp(cursor.text, "where") != 0) {
            failure.push_str(generic_method_unsupported_bound());
            return;
        }
        mono_check_bound_list(root, types, cursor.next_sibling, template.body_node, failure, 0);
    }
}

void mono_check_bound_list(SyntaxNode* root, TypeTable* types, SyntaxNode* cursor,
                           SyntaxNode* end, String* failure, u32 depth) {
    u32 parameter = 0;
    bool bound = false;
    while (cursor != (SyntaxNode*)0 && cursor != end && cursor.kind != NodeKind.Block) {
        if (cursor.kind == NodeKind.Token) {
            if (cursor.token_kind == TokenKind.Greater) { break; }
            if (cursor.token_kind == TokenKind.Comma) { parameter = 0; bound = false; }
            else if (cursor.token_kind == TokenKind.Colon) { bound = true; }
            else if (cursor.token_kind == TokenKind.Identifier) {
                if (parameter == 0) { parameter = types.parse_type_name(cursor.text); }
                else if (bound && !mono_type_implements_trait(root, types, parameter, cursor.text, depth + 1)) {
                    failure.push_str(generic_method_bound_failed(types.type_name(parameter), cursor.text).to_str());
                    return;
                }
            } else if (cursor.token_kind != TokenKind.Plus) {
                failure.push_str(generic_method_unsupported_bound());
                return;
            }
        }
        cursor = cursor.next_sibling;
    }
}

bool mono_type_implements_trait(SyntaxNode* root, TypeTable* types, u32 type_id, str trait_name, u32 depth) {
    if (depth > 64) { return false; }
    u32 owner_type = types.resolve_subst(type_id);
    u32 pointer_depth = 0;
    while (types.get(owner_type).kind == TypeKind.Pointer) {
        owner_type = types.get(owner_type).inner;
        pointer_depth += 1;
    }
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* cursor = item.first_child;
            SyntaxNode* trait_node = (SyntaxNode*)0;
            while (cursor != (SyntaxNode*)0 && cursor.kind != NodeKind.Block) {
                if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.For) {
                    break;
                }
                if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier) {
                    trait_node = cursor;
                }
                cursor = cursor.next_sibling;
            }
            if (cursor != (SyntaxNode*)0 && cursor.kind != NodeKind.Block
                && trait_node != (SyntaxNode*)0 && strcmp(trait_node.text, trait_name) == 0) {
                SyntaxNode* target = impl_target_identifier(item);
                if (target != (SyntaxNode*)0 && impl_target_pointer_depth(item) == pointer_depth) {
                    if (!item_method_is_generic(target)
                        && types.parse_type_name(target.text) == owner_type) { return true; }
                    TypeEntry* actual = types.get(owner_type);
                    if (actual.kind == TypeKind.Named && actual.count > 0
                        && strcmp(types.names.get(actual.name_id), target.text) == 0) {
                        Vec<u32> args = Vec<u32>.new();
                        i64 i = 0;
                        while (i < actual.count) {
                            args.push(types.type_args.get(actual.inner + (u32)i));
                            i += 1;
                        }
                        Vec<u32> declared = Vec<u32>.new();
                        SyntaxNode* head = item.first_child;
                        while (head != (SyntaxNode*)0 && head.token_kind != TokenKind.Impl) {
                            head = head.next_sibling;
                        }
                        SyntaxNode* generics = head == (SyntaxNode*)0 ? (SyntaxNode*)0 : head.next_sibling;
                        mono_collect_generic_parameters(generics, types, &declared);
                        Vec<u32> params = Vec<u32>.new();
                        bool matched = mono_match_target_args(target, types, &declared, &args, &params);
                        if (matched) {
                            mono_push_method_bindings(types, &params, &args);
                            String impl_failure = String.new();
                            if (generics != (SyntaxNode*)0 && generics.token_kind == TokenKind.Less) {
                                mono_check_bound_list(root, types, generics.next_sibling, target,
                                    &impl_failure, depth);
                            }
                            SyntaxNode* scan = target.next_sibling;
                            while (scan != (SyntaxNode*)0 && scan.kind != NodeKind.Block) {
                                if (strcmp(scan.text, "where") == 0) {
                                    mono_check_bound_list(root, types, scan.next_sibling,
                                        (SyntaxNode*)0, &impl_failure, depth);
                                    break;
                                }
                                scan = scan.next_sibling;
                            }
                            matched = impl_failure.len() == 0;
                            impl_failure.drop();
                            types.pop_subst(receiver_binding_count(&params, params.len()));
                        }
                        args.drop();
                        params.drop();
                        declared.drop();
                        if (matched) { return true; }
                    }
                }
            }
        }
        item = item.next_sibling;
    }
    return false;
}

enum MonomorphKind {
    Function;
    Struct;
    ImplMethod;
}

struct MonomorphRequest {
    MonomorphKind kind;
    u32 template_name_id;
    u32 type_args_start;
    u16 type_args_count;
    Span call_span;
    u32 mangled_name_id;
}

struct MonomorphCollector {
    Interner names;
    Vec<u32> type_arg_ids;
    Vec<MonomorphRequest> requests;
    u32 max_generations;
}

String sanitize_name(str s) {
    String out = String.new();
    i64 len = strlen(s);
    i64 i = 0;
    bool last_underscore = false;
    while (i < len) {
        char ch = s[i];
        bool is_alnum = (ch >= 'a' && ch <= 'z') || (ch >= 'A' && ch <= 'Z') || (ch >= '0' && ch <= '9');
        if (is_alnum) {
            out.push(ch);
            last_underscore = false;
        } else if (ch == '*') {
            out.push_str("ptr_");
            last_underscore = true;
        } else if (ch == '&') {
            out.push_str("ref_");
            last_underscore = true;
        } else if (!last_underscore) {
            out.push('_');
            last_underscore = true;
        }
        i += 1;
    }
    if (out.len() == 0) {
        out.push('_');
    }
    return move out;
}

String mangle_instance_name(str template_name, TypeTable* types, Vec<u32>* type_arg_ids, u32 start, u16 count) {
    String mangled = String.from_str(template_name);
    mangled.push_str("__");
    i64 i = 0;
    while (i < (i64)count) {
        u32 tid = type_arg_ids.get((i64)start + i);
        str ty_name = types.type_name(tid);
        String sanitized = sanitize_name(ty_name);
        mangled.push_str(sanitized.to_str());
        sanitized.drop();
        if (i + 1 < (i64)count) {
            mangled.push('_');
        }
        i += 1;
    }
    return move mangled;
}

impl MonomorphCollector {
    MonomorphCollector new() {
        MonomorphCollector collector;
        collector.names = Interner.new();
        collector.type_arg_ids = Vec<u32>.new();
        collector.requests = Vec<MonomorphRequest>.new();
        collector.max_generations = 256;
        return move collector;
    }

    i64 find_existing(MonomorphCollector* self, u32 mangled_id) {
        i64 i = 0;
        while (i < self.requests.len()) {
            if (self.requests.get_ptr(i).mangled_name_id == mangled_id) {
                return i;
            }
            i += 1;
        }
        return -1;
    }

    u32 request_instance(MonomorphCollector* self, MonomorphKind kind, str template_name,
                         Vec<u32>* arg_ids, Span call_span, TypeTable* types) {
        u32 start = (u32)self.type_arg_ids.len();
        u16 count = (u16)arg_ids.len();
        i64 i = 0;
        while (i < arg_ids.len()) {
            self.type_arg_ids.push(arg_ids.get(i));
            i += 1;
        }
        String mangled = mangle_instance_name(template_name, types, &self.type_arg_ids, start, count);
        u32 mangled_id = self.names.intern(mangled.to_str());
        mangled.drop();

        i64 existing = self.find_existing(mangled_id);
        if (existing >= 0) {
            return mangled_id;
        }

        MonomorphRequest req;
        req.kind = kind;
        req.template_name_id = self.names.intern(template_name);
        req.type_args_start = start;
        req.type_args_count = count;
        req.call_span = call_span;
        req.mangled_name_id = mangled_id;
        self.requests.push(move req);

        return mangled_id;
    }

    i64 count(MonomorphCollector* self) {
        return self.requests.len();
    }

    MonomorphRequest* get(MonomorphCollector* self, i64 index) {
        return self.requests.get_ptr(index);
    }
}
