    u32 add_assert(AstPool* self, u32 condition_id, u32 message_id, bool enabled, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Assert;
        expr.inner0 = condition_id;
        expr.inner1 = message_id;
        expr.aux = enabled ? (u32)1 : (u32)0;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        expr.resolved_callee_id = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_struct_lit(AstPool* self, u32 struct_name_id, u32 fields_start, u32 field_count, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.StructLit;
        expr.inner0 = struct_name_id;
        expr.inner1 = fields_start;
