    }

    AstExpr* get_expr(AstPool* self, u32 id) {
        if ((i64)id >= self.exprs.len()) {
            return self.exprs.get_ptr(0);
        }
        return self.exprs.get_ptr((i64)id);
    }

    AstStmt* get_stmt(AstPool* self, u32 id) {
        if ((i64)id >= self.stmts.len()) {
            return self.stmts.get_ptr(0);
        }
        return self.stmts.get_ptr((i64)id);
    }

    MatchArm* get_arm(AstPool* self, u32 id) {
        if ((i64)id >= self.arms.len()) {
            return self.arms.get_ptr(0);
        }
        return self.arms.get_ptr((i64)id);
    }
}
