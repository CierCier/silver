// libs/agc/src/frontend/ast_expr.ag — Lowered typed expression and statement representations.
import std.intern;
import std.mem.vec;
import std.string;
import frontend.ast;
import frontend.lexer;
import frontend.types;

enum ExprKind {
    Literal;       // aux = literal type_id
    Var;           // aux = name_id
    Unary;         // aux = op token kind, inner0 = operand
    Binary;        // aux = op token kind, inner0 = lhs, inner1 = rhs
    Call;          // inner0 = callee_id, inner1 = args_start, aux = args_count
    MethodCall;    // inner0 = receiver_id, aux = method_name_id, inner1 = args_start
    Field;         // inner0 = target_id, aux = field_name_id
    Index;         // inner0 = target_id, inner1 = index_id
    Cast;          // inner0 = expr_id, aux = target_type_id
    Move;          // aux = var_name_id
    Ternary;       // inner0 = cond_id, inner1 = then_id, aux = else_id
    UnwrapOr;      // inner0 = value_id, inner1 = fallback_id
    Match;         // inner0 = scrutinee_id, inner1 = arms_start, aux = arms_count
    Asm;           // inner0 = code_text_id, inner1 = args_start, aux = args_count
    SizeOf;        // aux = type_id
    AlignOf;       // aux = type_id
    ArrayLit;      // inner1 = elems_start, aux = elem_count (pool.args[start] = count, then ids)
    Format;        // inner0 = format string literal id, inner1 = args_start, aux = args_count
    Hash;          // inner0 = arg expr id (builtin @hash, always i64)
    Assert;        // inner0 = condition, inner1 = message, aux = enabled (debug cfg)
    StructLit;     // inner0 = struct name id, inner1 = fields_start, aux = field count (pool.args: name,expr pairs)
}

struct AstExpr {
    ExprKind kind;
    u32 inner0;
    u32 inner1;
    u32 aux;
    Span span;
    u32 inferred_type;
    u32 generic_args_start;
    u32 generic_args_count;
    u32 resolved_callee_id; // interned name ID plus one; zero means unresolved
}

enum StmtKind {
    Let;           // aux = var_name_id, inner0 = type_id, inner1 = init_expr_id
    ResetLocal;    // aux = var_name_id; restore a consumed local to zero
    Assign;        // inner0 = target_expr_id, inner1 = val_expr_id
    Expr;          // inner0 = expr_id
    Return;        // inner0 = expr_id
    If;            // inner0 = cond_expr_id, inner1 = then_block_id, aux = else_block_id
    While;         // inner0 = cond, inner1 = body block, aux = optional step stmt
    Break;
    Continue;
    Defer;         // inner0 = block_id
    Block;         // inner0 = block_stmts_start, aux = block_stmts_count
}

struct AstStmt {
    StmtKind kind;
    u32 inner0;
    u32 inner1;
    u32 aux;
    Span span;
}

enum MatchPatternKind {
    Wildcard;
    Variant;
    Binding;
    Literal;
}

struct MatchArm {
    MatchPatternKind pattern;
    u32 enum_name_id;
    u32 variant_name_id;
    u32 bindings_start;
    u32 bindings_count;
    u32 literal_id;
    u32 guard_id;
    u32 value_id;
    u32 body_stmt_id;
    Span span;
}

struct AstAsm {
    u32 code_id;
    u32 constraints_id;
    u32 args_start;
    u32 args_count;
}

String unescape_string_literal(str text) {
    String out = String.new();
    if (text == (str)0) { return move out; }
    i64 len = strlen(text);
    i64 start = 0;
    i64 end = len;
    if (len >= 2 && text[0] == '"' && text[len - 1] == '"') {
        start = 1;
        end = len - 1;
    }
    i64 i = start;
    while (i < end) {
        if (text[i] == '\\' && i + 1 < end) {
            i += 1;
            u8 next = (u8)text[i];
            if (next == (u8)'n') { out.push((u8)10); }
            else if (next == (u8)'r') { out.push((u8)13); }
            else if (next == (u8)'t') { out.push((u8)9); }
            else if (next == (u8)'0') { out.push((u8)0); }
            else if (next == (u8)'\\') { out.push((u8)'\\'); }
            else if (next == (u8)'"') { out.push((u8)'"'); }
            else { out.push(next); }
        } else {
            out.push((u8)text[i]);
        }
        i += 1;
    }
    return move out;
}

struct AstPool {
    Vec<AstExpr> exprs;
    Vec<AstStmt> stmts;
    Vec<u32> args;
    Vec<u32> generic_type_args;
    Vec<u32> block_stmts;
    Vec<MatchArm> arms;
    Vec<u32> arm_bindings;
    Vec<AstAsm> asms;
}

impl AstPool {
    AstPool new() {
        AstPool pool;
        pool.exprs = Vec<AstExpr>.new();
        pool.stmts = Vec<AstStmt>.new();
        pool.args = Vec<u32>.new();
        pool.generic_type_args = Vec<u32>.new();
        pool.block_stmts = Vec<u32>.new();
        pool.arms = Vec<MatchArm>.new();
        pool.arm_bindings = Vec<u32>.new();
        pool.asms = Vec<AstAsm>.new();

        // 0: Dummy null arm
        MatchArm null_arm;
        null_arm.pattern = MatchPatternKind.Wildcard;
        null_arm.enum_name_id = 0;
        null_arm.variant_name_id = 0;
        null_arm.bindings_start = 0;
        null_arm.bindings_count = 0;
        null_arm.literal_id = 0;
        null_arm.guard_id = 0;
        null_arm.value_id = 0;
        null_arm.body_stmt_id = 0;
        null_arm.span = Span.synthetic();
        pool.arms.push(move null_arm);

        // 0: Dummy null expr
        AstExpr null_expr;
        null_expr.kind = ExprKind.Literal;
        null_expr.inner0 = 0;
        null_expr.inner1 = 0;
        null_expr.aux = TYPE_UNKNOWN;
        null_expr.span = Span.synthetic();
        null_expr.inferred_type = TYPE_UNKNOWN;
        null_expr.generic_args_start = 0;
        null_expr.generic_args_count = 0;
        null_expr.resolved_callee_id = 0;
        pool.exprs.push(move null_expr);

        // 0: Dummy null stmt. Statement IDs share the same 0-means-null
        // convention as expressions (llvm_emit_stmt returns early on 0),
        // so index 0 must never be a real statement. Previously the
        // typecheck probe pool accidentally pre-filled the pool and masked
        // this; single lowering exposed lone-`return 42` mains emitting an
        // empty body.
        AstStmt null_stmt;
        null_stmt.kind = StmtKind.Expr;
        null_stmt.inner0 = 0;
        null_stmt.inner1 = 0;
        null_stmt.aux = 0;
        null_stmt.span = Span.synthetic();
        pool.stmts.push(move null_stmt);

        return move pool;
    }

    u32 add_literal(AstPool* self, u32 type_id, Span span) {
        return self.add_literal_val(type_id, 0, span);
    }

    u32 add_literal_val(AstPool* self, u32 type_id, u32 val_id, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Literal;
        expr.inner0 = val_id;
        expr.inner1 = 0;
        expr.aux = type_id;
        expr.span = span;
        expr.inferred_type = type_id;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_var(AstPool* self, u32 name_id, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Var;
        expr.inner0 = 0;
        expr.inner1 = 0;
        expr.aux = name_id;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_binary(AstPool* self, TokenKind op, u32 lhs, u32 rhs, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Binary;
        expr.inner0 = lhs;
        expr.inner1 = rhs;
        expr.aux = (u32)op;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_unary(AstPool* self, TokenKind op, u32 operand, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Unary;
        expr.inner0 = operand;
        expr.inner1 = 0;
        expr.aux = (u32)op;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_ternary(AstPool* self, u32 cond_id, u32 then_id, u32 else_id, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Ternary;
        expr.inner0 = cond_id;
        expr.inner1 = then_id;
        expr.aux = else_id;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_unwrap_or(AstPool* self, u32 value_id, u32 fallback_id, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.UnwrapOr;
        expr.inner0 = value_id;
        expr.inner1 = fallback_id;
        expr.aux = 0;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_match_arm(AstPool* self, MatchPatternKind pattern, u32 enum_name_id,
                      u32 variant_name_id, u32 bindings_start, u32 bindings_count,
                      u32 literal_id, u32 guard_id, u32 value_id, u32 body_stmt_id, Span span) {
        MatchArm arm;
        arm.pattern = pattern;
        arm.enum_name_id = enum_name_id;
        arm.variant_name_id = variant_name_id;
        arm.bindings_start = bindings_start;
        arm.bindings_count = bindings_count;
        arm.literal_id = literal_id;
        arm.guard_id = guard_id;
        arm.value_id = value_id;
        arm.body_stmt_id = body_stmt_id;
        arm.span = span;
        self.arms.push(move arm);
        return (u32)(self.arms.len() - 1);
    }

    u32 add_match(AstPool* self, u32 scrutinee_id, u32 arms_start, u32 arms_count, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Match;
        expr.inner0 = scrutinee_id;
        expr.inner1 = arms_start;
        expr.aux = arms_count;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_move(AstPool* self, u32 operand_id, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Move;
        expr.inner0 = operand_id;
        expr.inner1 = 0;
        expr.aux = 0;
        if (operand_id < (u32)self.exprs.len()) {
            AstExpr* op = self.get_expr(operand_id);
            if (op.kind == ExprKind.Var) {
                expr.aux = op.aux;
            }
        }
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_asm(AstPool* self, u32 code_id, u32 constraints_id, u32 args_start, u32 args_count, Span span) {
        AstAsm item;
        item.code_id = code_id;
        item.constraints_id = constraints_id;
        item.args_start = args_start;
        item.args_count = args_count;
        self.asms.push(move item);
        u32 asm_idx = (u32)(self.asms.len() - 1);
        AstExpr expr;
        expr.kind = ExprKind.Asm;
        expr.inner0 = 0;
        expr.inner1 = 0;
        expr.aux = asm_idx;
        expr.span = span;
        expr.inferred_type = TYPE_I64;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_call(AstPool* self, u32 callee, u32 args_start, u32 args_count, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Call;
        expr.inner0 = callee;
        expr.inner1 = args_start;
        expr.aux = args_count;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        expr.resolved_callee_id = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_generic_call(AstPool* self, u32 callee, u32 args_start, u32 args_count,
                         u32 generic_start, u32 generic_count, Span span) {
        u32 call_id = self.add_call(callee, args_start, args_count, span);
        AstExpr* call = self.exprs.get_ptr((i64)call_id);
        call.generic_args_start = generic_start;
        call.generic_args_count = generic_count;
        return call_id;
    }

    u32 add_array_lit(AstPool* self, u32 elems_start, u32 elem_count, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.ArrayLit;
        expr.inner0 = 0;
        expr.inner1 = elems_start;
        expr.aux = elem_count;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
        return (u32)(self.exprs.len() - 1);
    }

    u32 add_format(AstPool* self, u32 format_id, u32 args_start, u32 args_count, Span span) {
        AstExpr expr;
        expr.kind = ExprKind.Format;
        expr.inner0 = format_id;
        expr.inner1 = args_start;
        expr.aux = args_count;
        expr.span = span;
        expr.inferred_type = TYPE_UNKNOWN;
        expr.generic_args_start = 0;
        expr.generic_args_count = 0;
        self.exprs.push(move expr);
