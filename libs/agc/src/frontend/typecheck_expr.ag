// libs/agc/src/frontend/typecheck_expr.ag — Unified expression and statement type checking.
import std.intern;
import std.mem.vec;
import std.string;
import frontend.ast;
import frontend.ast_expr;
import frontend.bindings;
import frontend.callback_abi;
import frontend.diagnostics;
import frontend.expressions;
import frontend.items;
import frontend.lexer;
import frontend.lower_expr;
import frontend.symbols;
import frontend.sync_sugar;
import frontend.messages;
import frontend.monomorph;
import frontend.move_flow;
import frontend.types;
import frontend.cfg;
/// Nesting limit for expression type checking; deeper code reports an error.
const u32 MAX_TYPE_CHECK_DEPTH = 256;

/// Returns true when `s` starts with `prefix`; false for null.
bool typecheck_str_starts_with(str s, str prefix) {
    if (s == (str)0 || prefix == (str)0) { return false; }
    i64 slen = strlen(s);
    i64 plen = strlen(prefix);
    if (slen < plen) { return false; }
    i64 i = 0;
    while (i < plen) {
        if (s[i] != prefix[i]) { return false; }
        i += 1;
    }
    return true;
}


/// One local in scope: interned name and type id.
struct LocalVar {
    u32 name_id;
    u32 type_id;
}

/// The locals in scope during expression checking, innermost last, plus
/// the current nesting depth. `launched_call` is the call a `launch` wraps;
/// the launch pass judges how its reference parameters are borrowed.
struct TypeEnv {
    Vec<LocalVar> locals;
    u32 expression_depth;
    u32 expected_return;
    u32 launched_call;
}

impl TypeEnv {
    /// Creates an empty environment.
    TypeEnv new() {
        TypeEnv env;
        env.locals = Vec<LocalVar>.new();
        env.expression_depth = 0;
        env.expected_return = TYPE_UNKNOWN;
        env.launched_call = 0;
        return move env;
    }

    /// Returns a copy for a nested scope. `insert` replaces a binding in place,
    /// so a scope's own declarations must not reach the enclosing environment.
    TypeEnv child(TypeEnv* self) {
        TypeEnv env = TypeEnv.new();
        env.expression_depth = self.expression_depth;
        env.expected_return = self.expected_return;
        i64 i = 0;
        while (i < self.locals.len()) {
            env.locals.push(self.locals.get(i));
            i += 1;
        }
        return move env;
    }

    /// Binds `name_id` to `type_id`, replacing an existing binding.
    void insert(TypeEnv* self, u32 name_id, u32 type_id) {
        i64 i = 0;
        while (i < self.locals.len()) {
            LocalVar* cur = self.locals.get_ptr(i);
            if (cur.name_id == name_id) {
                cur.type_id = type_id;
                return;
            }
            i += 1;
        }
        LocalVar var;
        var.name_id = name_id;
        var.type_id = type_id;
        self.locals.push(move var);
    }

    /// Returns the innermost type bound to `name_id`, or `TYPE_UNKNOWN`.
    u32 lookup(TypeEnv* self, u32 name_id) {
        i64 i = self.locals.len() - 1;
        while (i >= 0) {
            LocalVar* cur = self.locals.get_ptr(i);
            if (cur.name_id == name_id) {
                return cur.type_id;
            }
            i -= 1;
        }
        return TYPE_UNKNOWN;
    }
}

/// Returns true for 8-bit integer types (byte buffers). `char` is excluded.
bool type_is_byte_like(u32 id) {
    // `char` is a 32-bit Unicode scalar, not a byte: accepting it here would
    // let a `u8*` pass as a `char*` and a char store would write four bytes
    // into a one-byte buffer.
    return id == TYPE_U8 || id == TYPE_I8;
}

/// Returns true for numeric types and `char`.
bool type_is_numeric_or_char(u32 id) {
    return type_is_numeric(id) || id == TYPE_CHAR;
}

/// Parses a literal index in any integer radix; returns -1 when malformed.
i64 typecheck_literal_index(str text) {
    i64 value = 0;
    return items_parse_enum_tag(text, false, &value) ? value : -1;
}

/// True when `type_id` mentions an unknown type or a type parameter. The
/// checker has no substitution for it, so it cannot judge the type.
bool typecheck_type_is_unresolved(TypeTable* types, u32 type_id, i64 depth) {
    // Past the depth limit the type is compared as written, not waved through.
    if (depth > 16) { return false; }
    type_id = types.resolve_subst(type_id);
    TypeEntry* entry = types.get(type_id);
    if (entry.kind == TypeKind.Unknown || entry.kind == TypeKind.TypeParam) {
        return true;
    }
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference
        || entry.kind == TypeKind.Array) {
        return typecheck_type_is_unresolved(types, entry.inner, depth + 1);
    }
    if (entry.kind == TypeKind.Named) {
        i64 i = 0;
        while (i < entry.count) {
            if (typecheck_type_is_unresolved(types, types.type_args.get(entry.inner + (u32)i),
                                             depth + 1)) {
                return true;
            }
            i += 1;
        }
    }
    return false;
}

/// True when `type_id` is a bare name with no recorded struct facts: an
/// unbound type parameter, or an enum the type table does not describe.
bool typecheck_is_opaque_name(TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(types.resolve_subst(type_id));
    if (entry.kind != TypeKind.Named || entry.count != 0) { return false; }
    i64 i = 0;
    while (i < types.struct_properties.len()) {
        if (types.struct_properties.get_ptr(i).name_id == entry.name_id) { return false; }
        i += 1;
    }
    return true;
}

/// True when generic type arguments `expected` and `actual` have the same
/// representation. Codegen passes a `Cell<i32>` unconverted, so it is not
/// a `Cell<i64>` even though `i32` converts to `i64`. Unresolved arguments
/// and bare names without struct facts (an unbound parameter, as in
/// `Optional.none()`) are not judged.
bool typecheck_same_type_arg(TypeTable* types, u32 expected, u32 actual, i64 depth) {
    expected = types.resolve_subst(expected);
    actual = types.resolve_subst(actual);
    if (expected == actual || typecheck_type_is_unresolved(types, expected, 0)
        || typecheck_type_is_unresolved(types, actual, 0)
        || typecheck_is_opaque_name(types, expected) || typecheck_is_opaque_name(types, actual)) {
        return true;
    }
    TypeEntry* exp_entry = types.get(expected);
    TypeEntry* act_entry = types.get(actual);
    if (depth > 16 || exp_entry.kind != act_entry.kind || exp_entry.count != act_entry.count) {
        return false;
    }
    if (exp_entry.kind == TypeKind.Reference && exp_entry.is_mut != act_entry.is_mut) {
        return false;
    }
    if (exp_entry.kind == TypeKind.Pointer || exp_entry.kind == TypeKind.Reference
        || exp_entry.kind == TypeKind.Array) {
        return typecheck_same_type_arg(types, exp_entry.inner, act_entry.inner, depth + 1);
    }
    if (exp_entry.kind == TypeKind.Tuple
        || (exp_entry.kind == TypeKind.Named && exp_entry.name_id == act_entry.name_id)) {
        i64 count = exp_entry.count;
        u32 exp_start = exp_entry.inner;
        u32 act_start = act_entry.inner;
        i64 arg = 0;
        while (arg < count) {
            if (!typecheck_same_type_arg(types, types.type_args.get(exp_start + (u32)arg),
                                         types.type_args.get(act_start + (u32)arg),
                                         depth + 1)) {
                return false;
            }
            arg += 1;
        }
        return true;
    }
    return false;
}

/// Returns true when `actual` is acceptable where `expected` is required.
/// Unresolved types always match, as do pointers or references where either
/// side points to `void`. Numeric, `char`, and `bool` primitives convert
/// implicitly, as in stage0.
bool types_match(TypeTable* types, u32 expected, u32 actual) {
    if (expected == actual) {
        return true;
    }
    if (typecheck_type_is_unresolved(types, expected, 0)
        || typecheck_type_is_unresolved(types, actual, 0)) {
        return true;
    }
    TypeEntry* exp_entry = types.get(expected);
    TypeEntry* act_entry = types.get(actual);
    if ((exp_entry.kind == TypeKind.Pointer || exp_entry.kind == TypeKind.Reference)
        && (act_entry.kind == TypeKind.Pointer || act_entry.kind == TypeKind.Reference)) {
        if (exp_entry.inner == TYPE_VOID || exp_entry.inner == TYPE_UNKNOWN
            || act_entry.inner == TYPE_VOID || act_entry.inner == TYPE_UNKNOWN) {
            return true;
        }
        if (exp_entry.inner == act_entry.inner) {
            return true;
        }
        if (type_is_byte_like(exp_entry.inner) && type_is_byte_like(act_entry.inner)) {
            return true;
        }
        TypeEntry* act_inner_entry = types.get(act_entry.inner);
        if (act_entry.kind == TypeKind.Reference && act_inner_entry.kind == TypeKind.Pointer) {
            return exp_entry.inner == act_inner_entry.inner || exp_entry.inner == TYPE_VOID;
        }
        // `&r` of a reference `r` reborrows through it, as in stage0.
        if (exp_entry.kind == TypeKind.Reference && act_inner_entry.kind == TypeKind.Reference) {
            return exp_entry.inner == act_inner_entry.inner;
        }
    }
    if ((exp_entry.kind == TypeKind.Pointer || exp_entry.kind == TypeKind.Reference)
        && act_entry.kind == TypeKind.Array) {
        if (exp_entry.inner == TYPE_VOID || exp_entry.inner == TYPE_UNKNOWN
            || exp_entry.inner == act_entry.inner
            || (type_is_byte_like(exp_entry.inner) && type_is_byte_like(act_entry.inner))) {
            return true;
        }
    }
    if (expected == TYPE_STR && (act_entry.kind == TypeKind.Pointer || act_entry.kind == TypeKind.Reference)) {
        if (type_is_byte_like(act_entry.inner) || act_entry.inner == TYPE_VOID || act_entry.inner == TYPE_STR) {
            return true;
        }
    }
    if (actual == TYPE_STR && (exp_entry.kind == TypeKind.Pointer || exp_entry.kind == TypeKind.Reference)) {
        if (type_is_byte_like(exp_entry.inner) || exp_entry.inner == TYPE_VOID || exp_entry.inner == TYPE_STR) {
            return true;
        }
    }
    if (exp_entry.kind == TypeKind.Named && act_entry.kind == TypeKind.Named) {
        str exp_name = types.names.get(exp_entry.name_id);
        str act_name = types.names.get(act_entry.name_id);
        i64 i = 0;
        while (exp_name[i] != (u8)0 && act_name[i] != (u8)0 && exp_name[i] == act_name[i]) {
            i += 1;
        }
        if ((exp_name[i] == (u8)0 || exp_name[i] == (u8)60)
            && (act_name[i] == (u8)0 || act_name[i] == (u8)60)) {
            // `Cell<str>` is not a `Cell<i64>`: compare recorded type arguments.
            if (exp_entry.name_id == act_entry.name_id && exp_entry.count > 0
                && exp_entry.count == act_entry.count) {
                return typecheck_same_type_arg(types, expected, actual, 0);
            }
            return true;
        }
    }
    if (type_is_numeric_or_char(expected) && type_is_numeric_or_char(actual)) {
        return true;
    }
    // Tuple elements convert like scalars: `[text, 0]` from a match arm
    // types its literal as i32 but fills an `[String, i64]`.
    if (exp_entry.kind == TypeKind.Tuple && act_entry.kind == TypeKind.Tuple
        && exp_entry.count == act_entry.count) {
        i64 count = exp_entry.count;
        u32 exp_start = exp_entry.inner;
        u32 act_start = act_entry.inner;
        i64 element = 0;
        while (element < count) {
            if (!types_match(types, types.type_args.get(exp_start + (u32)element),
                             types.type_args.get(act_start + (u32)element))) {
                return false;
            }
            element += 1;
        }
        return true;
    }
    return false;
}

/// True when `type_id` names an enum whose variants carry no payload.
bool typecheck_is_unit_enum(SyntaxNode* root, TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(type_id);
    if (entry.kind != TypeKind.Named || entry.count != 0) { return false; }
    SyntaxNode* item = find_enum_item(root, types.names.get(entry.name_id));
    if (item == (SyntaxNode*)0) { return false; }
    Vec<SyntaxNode*> names = Vec<SyntaxNode*>.new();
    Vec<i64> tags = Vec<i64>.new();
    Vec<i64> arities = Vec<i64>.new();
    bool unit = enum_each_variant(item, &names, &tags, &arities);
    i64 i = 0;
    while (unit && i < names.len()) {
        SyntaxNode* payload = names.get(i).next_sibling;
        if (arities.get(i) > 0 || (payload != (SyntaxNode*)0 && payload.kind == NodeKind.Block)) {
            unit = false;
        }
        i += 1;
    }
    return unit;
}

/// True when `actual_type` converts to `expected_type` between numeric,
/// `char`, and `bool` primitives, or between a unit enum and an integer,
/// `char`, `bool`, or another unit enum, as in stage0.
bool typecheck_scalar_conversion(SyntaxNode* root, TypeTable* types, u32 actual_type,
                                 u32 expected_type) {
    if (root == (SyntaxNode*)0 || actual_type == TYPE_UNKNOWN || expected_type == TYPE_UNKNOWN) {
        return false;
    }
    bool actual_enum = typecheck_is_unit_enum(root, types, actual_type);
    bool expected_enum = typecheck_is_unit_enum(root, types, expected_type);
    bool actual_scalar = type_is_numeric_or_char(actual_type) || actual_type == TYPE_BOOL;
    bool expected_scalar = type_is_numeric_or_char(expected_type) || expected_type == TYPE_BOOL;
    if (actual_scalar && expected_scalar) {
        return true;
    }
    // Codegen converts a unit enum only through its integer tag.
    if ((actual_enum || expected_enum)
        && (actual_enum || type_is_integer(actual_type) || actual_type == TYPE_CHAR
            || actual_type == TYPE_BOOL)
        && (expected_enum || type_is_integer(expected_type) || expected_type == TYPE_CHAR
            || expected_type == TYPE_BOOL)) {
        return true;
    }
    return false;
}

/// True when `actual_type` converts to `expected_type` without a written
/// cast: by a scalar conversion or through a user `cast` block.
bool typecheck_implicit_cast(SyntaxNode* root, TypeTable* types, u32 actual_type,
                             u32 expected_type) {
    if (typecheck_scalar_conversion(root, types, actual_type, expected_type)) {
        return true;
    }
    if (root == (SyntaxNode*)0 || actual_type == TYPE_UNKNOWN || expected_type == TYPE_UNKNOWN) {
        return false;
    }
    TypeEntry* act_entry = types.get(actual_type);
    while (act_entry.kind == TypeKind.Pointer || act_entry.kind == TypeKind.Reference) {
        actual_type = act_entry.inner;
        act_entry = types.get(actual_type);
    }
    if (act_entry.kind != TypeKind.Named) {
        return false;
    }
    str act_name = types.names.get(act_entry.name_id);
    str exp_name = types.type_name(expected_type);
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, act_name) == 0) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                if (block != (SyntaxNode*)0) {
                    SyntaxNode* cursor = block.first_child;
                    while (cursor != (SyntaxNode*)0) {
                        if (cursor.kind == NodeKind.Token
                            && (cursor.token_kind == TokenKind.Cast || strcmp(cursor.text, "cast") == 0)) {
                            SyntaxNode* scan = cursor.next_sibling;
                            String target_type_str = String.new();
                            while (scan != (SyntaxNode*)0 && scan.kind != NodeKind.Parenthesized && scan.kind != NodeKind.Block) {
                                append_node_tokens(scan, &target_type_str);
                                scan = scan.next_sibling;
                            }
                            bool matches = strcmp(target_type_str.to_str(), exp_name) == 0;
                            target_type_str.drop();
                            if (matches) {
                                return true;
                            }
                        }
                        cursor = cursor.next_sibling;
                    }
                }
            }
        }
        item = item.next_sibling;
    }
    return false;
}

/// Like `types_match`, but integer and float literals also fold into any
/// width of the same kind.
bool types_match_value(TypeTable* types, u32 expected, u32 actual, bool actual_is_literal) {
    if (types_match(types, expected, actual)) {
        return true;
    }
    if (!actual_is_literal) {
        return false;
    }
    // Integer and float literals fold into the expected width, mirroring the
    // stage0 literal promotion (`i64 a = 5` is accepted).
    if ((type_is_integer(expected) || expected == TYPE_CHAR) && (type_is_integer(actual) || actual == TYPE_CHAR)) {
        return true;
    }
    if (type_is_float(expected) && type_is_float(actual)) {
        return true;
    }
    return false;
}

/// Returns true when an array or vector argument coerces to a slice
/// parameter.
bool typecheck_slice_argument_coercion(TypeTable* types, u32 expected, u32 actual) {
    expected = types.resolve_subst(expected);
    actual = types.resolve_subst(actual);
    TypeEntry* expected_entry = types.get(expected);
    if (expected_entry.kind != TypeKind.Named || expected_entry.count != 1
        || strcmp(types.names.get(expected_entry.name_id), "Slice") != 0) {
        return false;
    }
    u32 element_type = types.resolve_subst(
        types.type_args.get(expected_entry.inner));
    TypeEntry* actual_entry = types.get(actual);
    while (actual_entry.kind == TypeKind.Pointer
        || actual_entry.kind == TypeKind.Reference) {
        actual = types.resolve_subst(actual_entry.inner);
        actual_entry = types.get(actual);
    }
    if (actual_entry.kind == TypeKind.Array) {
        return types.resolve_subst(actual_entry.inner) == element_type;
    }
    if (actual == TYPE_STR) {
        return element_type == TYPE_U8;
    }
    if (actual_entry.kind == TypeKind.Named
        && actual_entry.count == 1
        && (strcmp(types.names.get(actual_entry.name_id), "Vec") == 0
            || strcmp(types.names.get(actual_entry.name_id), "Slice") == 0)) {
        return types.resolve_subst(types.type_args.get(actual_entry.inner))
            == element_type;
    }
    return false;
}

/// True when `type_id` is fully known: no unknown, type parameter, function,
/// tuple, or slice anywhere inside it.
bool typecheck_type_is_concrete(TypeTable* types, u32 type_id, i64 depth) {
    if (depth > 16) { return false; }
    type_id = types.resolve_subst(type_id);
    TypeEntry* entry = types.get(type_id);
    if (entry.kind == TypeKind.Unknown || entry.kind == TypeKind.Void
        || entry.kind == TypeKind.TypeParam || entry.kind == TypeKind.Function
        || entry.kind == TypeKind.Tuple || entry.kind == TypeKind.Slice) {
        return false;
    }
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference
        || entry.kind == TypeKind.Array) {
        return typecheck_type_is_concrete(types, entry.inner, depth + 1);
    }
    if (entry.kind == TypeKind.Named) {
        i64 i = 0;
        while (i < entry.count) {
            if (!typecheck_type_is_concrete(types, types.type_args.get(entry.inner + (u32)i),
                                            depth + 1)) {
                return false;
            }
            i += 1;
        }
    }
    return true;
}

/// True when an argument of type `actual` cannot bind to reference
/// parameter type `expected`: the value it points at, or the value itself
/// for an implicit borrow, is not the parameter's pointee. Types that are
/// not fully known are not judged.
bool typecheck_reference_argument_mismatch(TypeTable* types, u32 expected, u32 actual) {
    expected = types.resolve_subst(expected);
    actual = types.resolve_subst(actual);
    TypeEntry* parameter = types.get(expected);
    if (parameter.kind != TypeKind.Reference) { return false; }
    u32 pointee = actual;
    TypeEntry* argument = types.get(actual);
    if (argument.kind == TypeKind.Pointer || argument.kind == TypeKind.Reference) {
        pointee = argument.inner;
        // `&r` where `r` is already a reference reborrows through it.
        TypeEntry* through = types.get(types.resolve_subst(pointee));
        if (through.kind == TypeKind.Reference
            && types.get(types.resolve_subst(parameter.inner)).kind != TypeKind.Reference) {
            pointee = through.inner;
        }
    }
    if (!typecheck_type_is_concrete(types, parameter.inner, 0)
        || !typecheck_type_is_concrete(types, pointee, 0)) {
        return false;
    }
    // `types_match` lets any two numbers match, but an `&mut i64` over an
    // `i32` writes 8 bytes. An implicit borrow into `&T` converts the value
    // first, so only a real borrow or a mutable parameter needs one layout.
    u32 expected_pointee = types.resolve_subst(parameter.inner);
    pointee = types.resolve_subst(pointee);
    if ((argument.kind == TypeKind.Pointer || argument.kind == TypeKind.Reference
            || parameter.is_mut)
        && type_is_numeric_or_char(expected_pointee) && type_is_numeric_or_char(pointee)) {
        return expected_pointee != pointee
            && !(type_is_byte_like(expected_pointee) && type_is_byte_like(pointee));
    }
    return !types_match(types, parameter.inner, pointee)
        && !typecheck_slice_argument_coercion(types, expected, actual);
}

/// Returns true when a call argument fits its parameter (value matching or
/// slice coercion).
bool typecheck_call_argument_matches(TypeTable* types, u32 expected, u32 actual,
                                     bool actual_is_literal) {
    return types_match_value(types, expected, actual, actual_is_literal)
        || typecheck_slice_argument_coercion(types, expected, actual);
}

/// True when a value of type `actual` passed to an immutable `&T` parameter
/// is borrowed implicitly, as in stage0. `&mut T` still needs `&mut place`,
/// and overload selection prefers a by-value match over this borrow.
bool typecheck_implicit_borrow(TypeTable* types, u32 expected, u32 actual,
                               bool actual_is_literal) {
    TypeEntry* parameter = types.get(types.resolve_subst(expected));
    return parameter.kind == TypeKind.Reference && !parameter.is_mut
        && types_match_value(types, parameter.inner, actual, actual_is_literal);
}

/// Reports passing a byte pointer where a `char*` is expected (or the
/// reverse); the element widths differ.
void typecheck_char_pointer_argument(TypeTable* types, u32 expected, u32 actual,
                                     Span span, DiagnosticBag* diagnostics, bool* ok) {
    TypeEntry* expected_entry = types.get(types.resolve_subst(expected));
    TypeEntry* actual_entry = types.get(types.resolve_subst(actual));
    u32 expected_element = expected_entry.kind == TypeKind.Str ? TYPE_U8 : TYPE_UNKNOWN;
    u32 actual_element = actual_entry.kind == TypeKind.Str ? TYPE_U8 : TYPE_UNKNOWN;
    if (expected_entry.kind == TypeKind.Pointer || expected_entry.kind == TypeKind.Reference) {
        expected_element = expected_entry.inner;
    }
    if (actual_entry.kind == TypeKind.Pointer || actual_entry.kind == TypeKind.Reference
        || actual_entry.kind == TypeKind.Array) {
        actual_element = actual_entry.inner;
    }
    if ((expected_element == TYPE_CHAR && type_is_byte_like(actual_element))
        || (actual_element == TYPE_CHAR && type_is_byte_like(expected_element))) {
        diagnostics.error(span, pointer_argument_type_mismatch(
            types.type_name(expected), types.type_name(actual)));
        *ok = false;
    }
}

/// Returns true when expression `expr_id` is a literal.
bool expr_is_literal(AstPool* pool, u32 expr_id) {
    if (expr_id == 0) {
        return false;
    }
    return pool.get_expr(expr_id).kind == ExprKind.Literal;
}

/// True when aggregate element `element_id` fills a slot of type `expected`
/// with a scalar conversion. Element stores do not run user `cast` blocks.
bool typecheck_element_fits(AstPool* pool, SyntaxNode* root, TypeTable* types, u32 expected,
                            u32 element_id) {
    u32 actual = pool.get_expr(element_id).inferred_type;
    return types_match_value(types, expected, actual, expr_is_literal(pool, element_id))
        || typecheck_scalar_conversion(root, types, actual, expected);
}

/// True when `expr_id` is a `[a, b]` literal whose elements fill the tuple
/// type `expected`. Equal element types infer an array, so `[1, 2]` reaches
/// an `[i64, i64]` only through this check.
bool typecheck_tuple_literal_fits(AstPool* pool, SyntaxNode* root, TypeTable* types,
                                  u32 expected, u32 expr_id) {
    AstExpr* literal = pool.get_expr(expr_id);
    TypeEntry* tuple = types.get(types.resolve_subst(expected));
    if (literal.kind != ExprKind.ArrayLit || tuple.kind != TypeKind.Tuple
        || tuple.count != (i64)literal.aux) {
        return false;
    }
    i64 count = tuple.count;
    u32 tuple_start = tuple.inner;
    u32 elements_start = literal.inner1 + 1;
    i64 i = 0;
    while (i < count) {
        u32 element_id = pool.args.get((i64)elements_start + i);
        if (!typecheck_element_fits(pool, root, types,
                types.resolve_subst(types.type_args.get(tuple_start + (u32)i)), element_id)) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Returns the promotion rank of a numeric type (0 for non-numeric).
u32 numeric_rank(u32 id) {
    if (id == TYPE_BOOL) { return 1; }
    if (id == TYPE_I8) { return 10; }
    if (id == TYPE_U8) { return 11; }
    if (id == TYPE_I16) { return 20; }
    if (id == TYPE_U16) { return 21; }
    if (id == TYPE_CHAR) { return 29; }
    if (id == TYPE_I32) { return 30; }
    if (id == TYPE_U32) { return 31; }
    if (id == TYPE_I64) { return 40; }
    if (id == TYPE_U64) { return 41; }
    if (id == TYPE_I128) { return 50; }
    if (id == TYPE_U128) { return 51; }
    if (id == TYPE_F32) { return 60; }
    if (id == TYPE_F64) { return 70; }
    if (id == TYPE_F80) { return 80; }
    if (id == TYPE_C32) { return 90; }
    if (id == TYPE_C64) { return 100; }
    if (id == TYPE_C80) { return 110; }
    return 0;
}

/// Returns the wider of two numeric types by rank, or the known one.
u32 common_numeric_type(u32 left, u32 right) {
    if (left == right) { return left; }
    if (type_is_numeric(left) && type_is_numeric(right)) {
        return numeric_rank(left) >= numeric_rank(right) ? left : right;
    }
    return left != TYPE_UNKNOWN ? left : right;
}

/// Returns the first function item named `name` with `arity` parameters
/// (any arity when -1), or null.
SyntaxNode* find_function_by_name_and_arity(SyntaxNode* root, str name, i64 arity) {
    if (root == (SyntaxNode*)0) { return (SyntaxNode*)0; }
    RootIndex* index = root_index(root);
    SyntaxNode* fallback = (SyntaxNode*)0;
    i64 entry = index.find(name);
    while (entry >= 0) {
        SyntaxNode* child = index.item(entry);
        entry = index.after(entry);
        if (child.kind != NodeKind.Function) { continue; }
        if (arity < 0) {
            return child;
        }
        Vec<Binding> params = Vec<Binding>.new();
        collect_parameter_bindings(binding_function_parameters(child), &params);
        i64 p_len = params.len();
        bool accepts_arity = binding_parameters_accept_arity(&params, arity);
        params.drop();
        if (p_len == arity || accepts_arity) {
            return child;
        }
        if (fallback == (SyntaxNode*)0) {
            fallback = child;
        }
    }
    return fallback;
}

/// Returns the first function item named `name`, or null.
SyntaxNode* find_function_by_name(SyntaxNode* root, str name) {
    return find_function_by_name_and_arity(root, name, -1);
}

/// Returns a function item's declared return type id (`TYPE_VOID` when
/// omitted).
u32 function_return_type_id(TypeTable* types, SyntaxNode* function) {
    if (function == (SyntaxNode*)0) { return TYPE_VOID; }
    SyntaxNode* parameters = binding_function_parameters(function);
    SyntaxNode* name = function_identifier(function);
    if (name == (SyntaxNode*)0) { return TYPE_VOID; }
    String ret_text = String.new();
    SyntaxNode* child = function.first_child;
    while (child != (SyntaxNode*)0 && child != name && child != parameters) {
        if (child.kind == NodeKind.Token && strcmp(child.text, "#") == 0) {
            // Skip attributes and declaration qualifiers before the return type.
            child = child.next_sibling;
            if (child != (SyntaxNode*)0 && child.kind == NodeKind.Bracket) {
                child = child.next_sibling;
            }
            continue;
        }
        if (child.kind == NodeKind.Token
            && (child.token_kind == TokenKind.Private || strcmp(child.text, "pub") == 0
                || strcmp(child.text, "static") == 0
                || strcmp(child.text, "extern") == 0)) {
            child = child.next_sibling;
            continue;
        }
        append_node_tokens(child, &ret_text);
        child = child.next_sibling;
    }
    u32 ret_type = type_id_from_text(types, ret_text.to_str());
    ret_text.drop();
    if (ret_type == TYPE_UNKNOWN || ret_type == 0) {
        return TYPE_VOID;
    }
    return ret_type;
}

/// Returns true when a function item declares type parameters.
bool typecheck_is_generic_function(SyntaxNode* function) {
    SyntaxNode* id = function_identifier(function);
    if (id == (SyntaxNode*)0) { return false; }
    SyntaxNode* node = id.next_sibling;
    while (node != (SyntaxNode*)0 && node.kind != NodeKind.Parenthesized) {
        if (node.kind == NodeKind.Token && node.token_kind == TokenKind.Less) { return true; }
        node = node.next_sibling;
    }
    return false;
}

/// Type arguments of one generic call: `params[i]` is a callee type
/// parameter name and `bound[i]` its type, or unknown when not inferred.
struct CalleeTypeArgs {
    Vec<u32> params;
    Vec<u32> bound;
}

impl CalleeTypeArgs {
    /// Returns `type_id` with the callee's type parameters substituted.
    u32 resolve(CalleeTypeArgs* self, TypeTable* types, u32 type_id) {
        return self.substitute(types, type_id, 0);
    }

    /// Replaces the callee's own parameters in a signature type. A bound type
    /// is already resolved in the caller, so it is returned as is: resolving
    /// it again could rebind a caller struct named like a callee parameter.
    u32 substitute(CalleeTypeArgs* self, TypeTable* types, u32 type_id, i64 depth) {
        if (depth > 16 || (i64)type_id >= types.types.len()) { return type_id; }
        TypeEntry* entry = types.get(type_id);
        TypeKind kind = entry.kind;
        u32 inner = entry.inner;
        u32 name_id = entry.name_id;
        i64 count = entry.count;
        bool is_mut = entry.is_mut;
        if (kind == TypeKind.TypeParam || (kind == TypeKind.Named && count == 0)) {
            i64 p = 0;
            while (p < self.params.len()) {
                if (self.params.get(p) == name_id) { return self.bound.get(p); }
                p += 1;
            }
            return types.resolve_subst(type_id);
        }
        if (kind == TypeKind.Pointer || kind == TypeKind.Reference || kind == TypeKind.Array) {
            u32 element = self.substitute(types, inner, depth + 1);
            if (kind == TypeKind.Pointer) { return types.get_pointer(element, is_mut); }
            if (kind == TypeKind.Reference) { return types.get_reference(element, is_mut); }
            return types.get_array(element, count);
        }
        if (kind == TypeKind.Tuple || (kind == TypeKind.Named && count > 0)) {
            Vec<u32> args = Vec<u32>.new();
            i64 i = 0;
            while (i < count) {
                args.push(self.substitute(types, types.type_args.get(inner + (u32)i), depth + 1));
                i += 1;
            }
            u32 result = kind == TypeKind.Tuple ? types.get_tuple(&args)
                : types.get_named_args(types.names.get(name_id), &args);
            args.drop();
            return result;
        }
        if (kind == TypeKind.Function) {
            u32 result_type = self.substitute(types, types.type_args.get(inner), depth + 1);
            Vec<u32> parameters = Vec<u32>.new();
            i64 i = 0;
            while (i < count) {
                parameters.push(self.substitute(types, types.type_args.get(inner + 1 + (u32)i),
                                                depth + 1));
                i += 1;
            }
            u32 result = types.get_function(result_type, &parameters);
            parameters.drop();
            return result;
        }
        return types.resolve_subst(type_id);
    }
}

/// Binds unbound callee type parameters in `declared` to the matching parts
/// of `actual`: `T` binds directly, views and arrays compare their element,
/// a view parameter also accepts an implicit borrow, and generic named types
/// compare their type arguments.
void typecheck_infer_type_args(TypeTable* types, CalleeTypeArgs* args, u32 declared,
                               u32 actual, i64 depth) {
    if (depth > 16) { return; }
    actual = types.resolve_subst(actual);
    if (typecheck_type_is_unresolved(types, actual, 0)) { return; }
    TypeEntry* declared_entry = types.get(declared);
    TypeEntry* actual_entry = types.get(actual);
    bool actual_is_view = actual_entry.kind == TypeKind.Pointer
        || actual_entry.kind == TypeKind.Reference;
    if (declared_entry.kind == TypeKind.Named && declared_entry.count == 0) {
        i64 p = 0;
        while (p < args.params.len()) {
            if (args.params.get(p) == declared_entry.name_id
                && args.bound.get(p) == TYPE_UNKNOWN) {
                *args.bound.get_ptr(p) = actual;
            }
            p += 1;
        }
    } else if (declared_entry.kind == TypeKind.Pointer
               || declared_entry.kind == TypeKind.Reference) {
        typecheck_infer_type_args(types, args, declared_entry.inner,
            actual_is_view ? actual_entry.inner : actual, depth + 1);
    } else if (declared_entry.kind == TypeKind.Array && actual_entry.kind == TypeKind.Array) {
        typecheck_infer_type_args(types, args, declared_entry.inner, actual_entry.inner,
                                  depth + 1);
    } else if (declared_entry.kind == TypeKind.Tuple && actual_entry.kind == TypeKind.Array
               && declared_entry.count == actual_entry.count) {
        // `["a", "b"]` is typed as an array until it fills the tuple.
        i64 i = 0;
        while (i < declared_entry.count) {
            typecheck_infer_type_args(types, args,
                types.type_args.get(declared_entry.inner + (u32)i), actual_entry.inner,
                depth + 1);
            i += 1;
        }
    } else if (declared_entry.count == actual_entry.count
               && ((declared_entry.kind == TypeKind.Tuple && actual_entry.kind == TypeKind.Tuple)
                   || (declared_entry.kind == TypeKind.Named
                       && actual_entry.kind == TypeKind.Named
                       && declared_entry.name_id == actual_entry.name_id))) {
        i64 i = 0;
        while (i < declared_entry.count) {
            typecheck_infer_type_args(types, args,
                types.type_args.get(declared_entry.inner + (u32)i),
                types.type_args.get(actual_entry.inner + (u32)i), depth + 1);
            i += 1;
        }
    }
}

/// Binds generic `callee`'s type parameters for `call`. Explicit type
/// arguments win; otherwise non-literal arguments bind them structurally,
/// since a literal adapts to its parameter. Unbound parameters stay
/// unknown so the checker never compares a bare `T`.
CalleeTypeArgs typecheck_callee_type_args(AstPool* pool, TypeTable* types, SyntaxNode* callee,
                                          AstExpr* call, Vec<Binding>* parameters,
                                          Vec<u32>* argument_types) {
    CalleeTypeArgs args = { .params = Vec<u32>.new(), .bound = Vec<u32>.new() };
    SyntaxNode* id = function_identifier(callee);
    if (id == (SyntaxNode*)0) { return move args; }
    mono_collect_generic_parameters(id.next_sibling, types, &args.params);
    bool explicit_args = (i64)call.generic_args_count == args.params.len();
    i64 i = 0;
    while (i < args.params.len()) {
        args.bound.push(explicit_args
            ? types.resolve_subst(pool.generic_type_args.get((i64)call.generic_args_start + i))
            : TYPE_UNKNOWN);
        i += 1;
    }
    i = 0;
    while (!explicit_args && i < argument_types.len() && i < parameters.len()) {
        if (!expr_is_literal(pool, pool.args.get((i64)call.inner1 + i))) {
            typecheck_infer_type_args(types, &args,
                typecheck_parameter_type_id(types, parameters.get_ptr(i)),
                argument_types.get(i), 0);
        }
        i += 1;
    }
    return move args;
}

/// Returns a stable canonical spelling of type `type_id` for signature keys.
String typecheck_canonical_type(TypeTable* types, u32 type_id, u32 depth) {
    if (depth >= 64 || (i64)type_id >= types.types.len()) {
        return String.from_str("unknown");
    }
    TypeEntry* entry = types.types.get_ptr((i64)type_id);
    if (entry.kind == TypeKind.Void) { return String.from_str("unit"); }
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference
        || entry.kind == TypeKind.Array || entry.kind == TypeKind.Slice) {
        String inner = typecheck_canonical_type(types, entry.inner, depth + 1);
        String result = String.new();
        if (entry.kind == TypeKind.Pointer) {
            result.push('*');
            if (entry.is_mut) { result.push_str("mut "); }
            result.push_str(inner.to_str());
        } else if (entry.kind == TypeKind.Reference) {
            result.push('&');
            result.push_str(inner.to_str());
        } else if (entry.kind == TypeKind.Slice) {
            result.push_str("Slice<");
            result.push_str(inner.to_str());
            result.push('>');
        } else {
            result.push_str("Array<");
            result.push_str(inner.to_str());
            result.push_str(", ");
            result.push_display(&entry.count);
            result.push('>');
        }
        inner.drop();
        return move result;
    }
    if (entry.kind == TypeKind.Tuple) {
        String result = String.from_str("[");
        i64 i = 0;
        while (i < entry.count) {
            if (i > 0) { result.push_str(", "); }
            String element = typecheck_canonical_type(
                types, types.type_args.get(entry.inner + (u32)i), depth + 1);
            result.push_str(element.to_str());
            element.drop();
            i += 1;
        }
        result.push(']');
        return move result;
    }
    if (entry.kind == TypeKind.Named && entry.count > 0) {
        String result = String.from_str(types.names.get(entry.name_id));
        result.push('<');
        i64 i = 0;
        while (i < entry.count) {
            if (i > 0) { result.push(','); }
            String arg = typecheck_canonical_type(types, types.type_args.get(entry.inner + (u32)i), depth + 1);
            result.push_str(arg.to_str());
            arg.drop();
            i += 1;
        }
        result.push('>');
        return move result;
    }
    return String.from_str(types.names.get(entry.name_id));
}

/// Returns true when a function's last parameter is variadic.
bool typecheck_function_is_variadic(SyntaxNode* function) {
    SyntaxNode* params = binding_function_parameters(function);
    if (params == (SyntaxNode*)0) { return false; }
    SyntaxNode* child = params.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Token && child.token_kind == TokenKind.DotDotDot) { return true; }
        child = child.next_sibling;
    }
    return false;
}

/// Returns the `name(param types)` key that identifies one overload.
String typecheck_free_signature_key(TypeTable* types, str name, SyntaxNode* function) {
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(binding_function_parameters(function), &params);
    String key = String.from_str(name);
    key.push('(');
    i64 i = 0;
    while (i < params.len()) {
        if (i > 0) { key.push(','); }
        Binding* param = params.get_ptr(i);
        u32 type_id = types.resolve_subst(typecheck_parameter_type_id(types, param));
        String param_type = typecheck_canonical_type(types, type_id, 0);
        key.push_str(param_type.to_str());
        param_type.drop();
        i += 1;
    }
    if (typecheck_function_is_variadic(function)) { key.push_str("..."); }
    key.push_str(") -> ");
    String ret_type = typecheck_canonical_type(types, function_return_type_id(types, function), 0);
    key.push_str(ret_type.to_str());
    ret_type.drop();
    params.drop();
    return move key;
}

/// Returns the 64-bit FNV-1a hash of `value`.
u64 typecheck_fnv1a64(str value) {
    u64 hash = (u64)-3750763034362895579;
    i64 i = 0;
    while (i < strlen(value)) {
        hash = (hash ^ (u64)value[i]) * (u64)1099511628211;
        i += 1;
    }
    return hash;
}

/// Returns `name__<16 hex digits>`, the symbol of one free-function
/// overload, from the hash of its signature key.
String typecheck_overloaded_free_symbol(TypeTable* types, str name, SyntaxNode* function) {
    String key = typecheck_free_signature_key(types, name, function);
    u64 hash = typecheck_fnv1a64(key.to_str());
    String symbol = String.from_str(name);
    symbol.push_str("__");
    i64 shift = 60;
    while (shift >= 0) {
        u8 digit = (u8)((hash >> (u64)shift) & (u64)15);
        u8 rendered = (u8)0;
        if (digit < 10) { rendered = (u8)'0' + digit; }
        else { rendered = (u8)'a' + digit - (u8)10; }
        symbol.push(rendered);
        shift -= 4;
    }
    key.drop();
    return move symbol;
}

/// Returns true when two function items have the same name and parameters.
bool typecheck_same_free_signature(TypeTable* types, SyntaxNode* left, SyntaxNode* right) {
    SyntaxNode* left_id = function_identifier(left);
    SyntaxNode* right_id = function_identifier(right);
    if (left_id == (SyntaxNode*)0 || right_id == (SyntaxNode*)0) { return false; }
    String left_key = typecheck_free_signature_key(types, left_id.text, left);
    String right_key = typecheck_free_signature_key(types, right_id.text, right);
    bool same = strcmp(left_key.to_str(), right_key.to_str()) == 0;
    left_key.drop();
    right_key.drop();
    return same;
}

/// Returns true when `name` has more than one distinct free overload.
bool typecheck_has_free_overloads(TypeTable* types, SyntaxNode* root, str name) {
    SyntaxNode* first = (SyntaxNode*)0;
    RootIndex* index = root_index(root);
    i64 entry = index.find(name);
    while (entry >= 0) {
        SyntaxNode* item = index.item(entry);
        entry = index.after(entry);
        if (item.kind == NodeKind.Function && !typecheck_is_generic_function(item)) {
            if (first == (SyntaxNode*)0) { first = item; }
            else if (!typecheck_same_free_signature(types, first, item)) { return true; }
        }
    }
    return false;
}

/// Returns a parameter's type id, ignoring variadic wrapping.
u32 typecheck_parameter_base_type_id(TypeTable* types, Binding* param) {
    if (param.declared_type.kind == ProjectionTypeKind.Array) {
        String element = binding_declared_type_text(&param.declared_type);
        String slice = String.from_str("Slice<");
        slice.push_str(element.to_str());
        slice.push('>');
        u32 type_id = types.parse_type_name(slice.to_str());
        element.drop();
        slice.drop();
        return type_id;
    }
    bool exact_function_type = binding_has_function_type(param);
    String declared = binding_parameter_type_text(param);
    u32 type_id = types.parse_type_name(declared.to_str());
    if (!exact_function_type && param.declared_type.kind == ProjectionTypeKind.Pointer) {
        type_id = types.get_pointer(type_id, true);
    } else if (!exact_function_type && param.declared_type.kind == ProjectionTypeKind.Reference) {
        type_id = types.get_reference(type_id, param.declared_type.is_mutable);
    } else if (!exact_function_type && type_id == TYPE_VOID) {
        type_id = types.get_pointer(type_id, true);
    }
    declared.drop();
    return type_id;
}

/// Returns a parameter's type id; a variadic parameter becomes a slice.
u32 typecheck_parameter_type_id(TypeTable* types, Binding* param) {
    u32 type_id = typecheck_parameter_base_type_id(types, param);
    if (!binding_is_variadic_parameter(param) || type_id == TYPE_UNKNOWN) {
        return type_id;
    }
    String element_type = typecheck_canonical_type(types, type_id, 0);
    String slice_type = String.from_str("Slice<");
    slice_type.push_str(element_type.to_str());
    slice_type.push('>');
    u32 slice_id = types.parse_type_name(slice_type.to_str());
    element_type.drop();
    slice_type.drop();
    return slice_id;
}

/// Returns the interned symbol id of an overload's mangled name.
u32 typecheck_overload_symbol_id(TypeTable* types, Interner* names, str name,
                                 SyntaxNode* function) {
    String symbol = typecheck_overloaded_free_symbol(types, name, function);
    u32 symbol_id = names.intern(symbol.to_str());
    symbol.drop();
    return symbol_id;
}

/// True when type checking inferred the type of every argument of `call`.
bool typecheck_arguments_known(AstPool* pool, AstExpr* call) {
    i64 i = 0;
    while (i < (i64)call.aux) {
        if (pool.get_expr(pool.args.get((i64)call.inner1 + i)).inferred_type == TYPE_UNKNOWN) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Returns true when every argument of the method call whose arguments
/// start at `args_start` has an inferred type.
bool typecheck_method_arguments_known(AstPool* pool, u32 args_start) {
    i64 count = (i64)pool.args.get((i64)args_start);
    i64 i = 0;
    while (i < count) {
        if (pool.get_expr(pool.args.get((i64)args_start + 1 + i)).inferred_type == TYPE_UNKNOWN) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Returns the non-generic overload of `name` whose symbol is `symbol_id`,
/// or null.
SyntaxNode* typecheck_overload_by_symbol(TypeTable* types, Interner* names, SyntaxNode* root,
                                         str name, u32 symbol_id) {
    RootIndex* index = root_index(root);
    i64 entry = index.find(name);
    while (entry >= 0) {
        SyntaxNode* item = index.item(entry);
        entry = index.after(entry);
        if (item.kind == NodeKind.Function && !typecheck_is_generic_function(item)
            && typecheck_overload_symbol_id(types, names, name, item) == symbol_id) {
            return item;
        }
    }
    return (SyntaxNode*)0;
}

/// Resolves a free-function call to the overload whose parameters fit its
/// arguments. Returns null when none fits or several do; sets `*overloaded`
/// and `*ambiguous` for the caller to report.
/// The declaration of the one imported Silver function `name` that takes
/// `arity` arguments, or null. Its signature decides how each argument is
/// passed, as for a local function.
SyntaxNode* typecheck_imported_function(SymbolTable* symbols, str name, i64 arity) {
    SyntaxNode* found = (SyntaxNode*)0;
    i64 index = 0;
    while (index < symbols.symbols.len()) {
        Symbol* symbol = symbols.symbols.get_ptr(index);
        index += 1;
        if (symbol.kind != SymbolKind.Function
            || strcmp(symbols.names.get(symbol.name_id), name) != 0) {
            continue;
        }
        if (symbol.c_abi || symbol.declaration == (SyntaxNode*)0
            || symbol.declaration.kind != NodeKind.Function) {
            return (SyntaxNode*)0;
        }
        Vec<Binding> params = Vec<Binding>.new();
        collect_parameter_bindings(binding_function_parameters(symbol.declaration), &params);
        bool fits = binding_parameters_accept_arity(&params, arity);
        params.drop();
        if (!fits) { continue; }
        if (found != (SyntaxNode*)0) { return (SyntaxNode*)0; }
        found = symbol.declaration;
    }
    return found;
}

SyntaxNode* typecheck_resolve_free_function(AstPool* pool, TypeTable* types,
                                           SymbolTable* symbols, SyntaxNode* root,
                                           TypeEnv* env, str name, AstExpr* call,
                                           DiagnosticBag* diagnostics, bool* ok,
                                           bool* overloaded, bool* ambiguous,
                                           bool* no_match, u32* resolved_symbol_id) {
    *overloaded = false;
    *ambiguous = false;
    *no_match = false;
    *resolved_symbol_id = 0;
    // Written type arguments select a generic declaration, as codegen does,
    // even when a plain function of the same name comes first.
    if (call.generic_args_count > 0) {
        RootIndex* generic_index = root_index(root);
        i64 generic_entry = generic_index.find(name);
        while (generic_entry >= 0) {
            SyntaxNode* item = generic_index.item(generic_entry);
            generic_entry = generic_index.after(generic_entry);
            if (item.kind != NodeKind.Function || !typecheck_is_generic_function(item)) {
                continue;
            }
            Vec<Binding> params = Vec<Binding>.new();
            collect_parameter_bindings(binding_function_parameters(item), &params);
            bool fits = params.len() == (i64)call.aux;
            params.drop();
            if (fits) { return item; }
        }
    }
    if (!typecheck_has_free_overloads(types, root, name)) {
        SyntaxNode* local = find_function_by_name_and_arity(root, name, (i64)call.aux);
        return local != (SyntaxNode*)0 ? local
            : typecheck_imported_function(symbols, name, (i64)call.aux);
    }
    *overloaded = true;

    Vec<u32> actual_types = Vec<u32>.with_capacity((i64)call.aux);
    i64 arg_index = 0;
    while (arg_index < (i64)call.aux) {
        u32 arg_id = pool.args.get((i64)call.inner1 + arg_index);
        actual_types.push(infer_expr(pool, types, symbols, root, env, arg_id, diagnostics, ok));
        arg_index += 1;
    }

    SyntaxNode* selected = (SyntaxNode*)0;
    u32 selected_symbol_id = 0;
    i64 selected_score = 0;
    bool saw_arity = false;
    RootIndex* index = root_index(root);
    i64 entry = index.find(name);
    while (entry >= 0) {
        SyntaxNode* item = index.item(entry);
        entry = index.after(entry);
        if (item.kind != NodeKind.Function || typecheck_is_generic_function(item)) {
            continue;
        }
        Vec<Binding> params = Vec<Binding>.new();
        collect_parameter_bindings(binding_function_parameters(item), &params);
        if (binding_parameters_accept_arity(&params, actual_types.len())) {
            saw_arity = true;
            bool matches = true;
            i64 score = 0;
            i64 p = 0;
            bool variadic = params.len() > 0
                && binding_is_variadic_parameter(params.get_ptr(params.len() - 1));
            i64 fixed_count = params.len() - (variadic ? 1 : 0);
            while (p < actual_types.len()) {
                i64 parameter_index = p < fixed_count ? p : params.len() - 1;
                Binding* parameter = params.get_ptr(parameter_index);
                u32 expected = variadic && p >= fixed_count
                    ? typecheck_parameter_base_type_id(types, parameter)
                    : typecheck_parameter_type_id(types, parameter);
                u32 actual = actual_types.get(p);
                u32 arg_id = pool.args.get((i64)call.inner1 + p);
                bool literal = expr_is_literal(pool, arg_id);
                bool direct = typecheck_call_argument_matches(types, expected, actual, literal);
                bool tuple = !direct && typecheck_tuple_literal_fits(pool, root, types, expected, arg_id);
                bool converts = !direct && !tuple
                    && typecheck_implicit_cast(root, types, actual, expected);
                if (!direct && !tuple && !converts
                    && !typecheck_implicit_borrow(types, expected, actual, literal)) {
                    matches = false;
                    break;
                }
                // Per argument: a matching type or tuple fill costs 2, a scalar
                // or `cast` conversion (`1` to `bool`) 3, an implicit borrow 4.
                if (converts) {
                    score += 3;
                } else if (!direct && !tuple) {
                    score += 4;
                } else if (expected != actual) {
                    score += 2;
                }
                p += 1;
            }
            if (matches) {
                u32 candidate_symbol_id = typecheck_overload_symbol_id(types, &symbols.names, name, item);
                if (selected == (SyntaxNode*)0 || score < selected_score) {
                    selected = item;
                    selected_symbol_id = candidate_symbol_id;
                    selected_score = score;
                    *ambiguous = false;
                } else if (score == selected_score && candidate_symbol_id != selected_symbol_id) {
                    *ambiguous = true;
                }
            }
        }
        params.drop();
    }
    actual_types.drop();

    if (!saw_arity) {
        return find_function_by_name_and_arity(root, name, (i64)call.aux);
    }
    if (selected == (SyntaxNode*)0) {
        *no_match = true;
        return (SyntaxNode*)0;
    }
    if (*ambiguous) { return (SyntaxNode*)0; }
    *resolved_symbol_id = selected_symbol_id;
    return selected;
}

/// Appends every leaf token under `node`.
void typecheck_expr_collect_tokens(SyntaxNode* node, Vec<SyntaxNode*>* tokens) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (node.kind == NodeKind.Token) {
        tokens.push(node);
        return;
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        typecheck_expr_collect_tokens(child, tokens);
        child = child.next_sibling;
    }
}

/// Returns true when struct `type_name` has field `field_name`; otherwise
/// collects its field names into `candidates`.
bool typecheck_expr_struct_has_field(SyntaxNode* root, str type_name, str field_name,
                                     Vec<str>* candidates) {
    SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, type_name);
    if (item == (SyntaxNode*)0) {
        return true;
    }
    SyntaxNode* body = item.first_child;
    while (body != (SyntaxNode*)0 && body.kind != NodeKind.Block) {
        body = body.next_sibling;
    }
    if (body == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> tokens = Vec<SyntaxNode*>.new();
    typecheck_expr_collect_tokens(body, &tokens);
    bool found = false;
    i64 start = 0;
    while (start < tokens.len()) {
        i64 end = start;
        while (end < tokens.len() && tokens.get(end).token_kind != TokenKind.Semicolon) {
            end += 1;
        }
        i64 name_index = end - 1;
        while (name_index >= start && tokens.get(name_index).token_kind != TokenKind.Identifier) {
            name_index -= 1;
        }
        if (name_index >= start) {
            str candidate = tokens.get(name_index).text;
            candidates.push(candidate);
            if (candidate == field_name) {
                found = true;
            }
        }
        start = end + 1;
    }
    tokens.drop();
    return found;
}

/// Substitutes a generic composite's type arguments into a member type.
u32 resolve_generic_member_type(TypeTable* types, SyntaxNode* root, u32 composite_type_id, u32 member_type_id) {
    u32 actual_composite_id = composite_type_id;
    TypeEntry* comp = types.get(actual_composite_id);
    while (comp.kind == TypeKind.Pointer || comp.kind == TypeKind.Reference) {
        actual_composite_id = comp.inner;
        comp = types.get(actual_composite_id);
    }
    if (comp.kind != TypeKind.Named || comp.count == 0) {
        return types.resolve_subst(member_type_id);
    }
    str base = types.names.get(comp.name_id);
    Vec<u32> param_ids = Vec<u32>.new();
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Struct || item.kind == NodeKind.Enum) {
            SyntaxNode* name_node = item_identifier(item);
            if (name_node != (SyntaxNode*)0 && strcmp(name_node.text, base) == 0) {
                SyntaxNode* cursor = name_node.next_sibling;
                while (cursor != (SyntaxNode*)0 && cursor.kind != NodeKind.Block) {
                    if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Less) {
                        SyntaxNode* p = cursor.next_sibling;
                        while (p != (SyntaxNode*)0 && !(p.kind == NodeKind.Token && p.token_kind == TokenKind.Greater)) {
                            if (p.kind == NodeKind.Token && p.token_kind == TokenKind.Identifier) {
                                param_ids.push(types.names.intern(p.text));
                            }
                            p = p.next_sibling;
                        }
                        break;
                    }
                    cursor = cursor.next_sibling;
                }
                break;
            }
        }
        item = item.next_sibling;
    }
    if (param_ids.len() != comp.count) {
        param_ids.drop();
        return types.resolve_subst(member_type_id);
    }
    i64 i = 0;
    while (i < param_ids.len()) {
        types.push_subst(param_ids.get(i), types.type_args.get(comp.inner + (u32)i));
        i += 1;
    }
    u32 resolved = types.resolve_subst(member_type_id);
    types.pop_subst(param_ids.len());
    param_ids.drop();
    return resolved;
}

/// Returns the type of `field_name` on `composite_type_id` (generic
/// arguments applied), or `TYPE_UNKNOWN`.
u32 typecheck_struct_field_type(TypeTable* types, SyntaxNode* root,
                                u32 composite_type_id, str field_name) {
    u32 owner_type = types.resolve_subst(composite_type_id);
    TypeEntry* owner_entry = types.get(owner_type);
    while (owner_entry.kind == TypeKind.Pointer || owner_entry.kind == TypeKind.Reference) {
        owner_type = owner_entry.inner;
        owner_entry = types.get(owner_type);
    }
    if (owner_entry.kind != TypeKind.Named) { return TYPE_UNKNOWN; }
    u32 owner_name_id = owner_entry.name_id;
    u32 owner_args_start = owner_entry.inner;
    i64 owner_arg_count = owner_entry.count;
    str owner_name = types.names.get(owner_name_id);
    SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, owner_name);
    if (item == (SyntaxNode*)0) {
        i64 definition_index = 0;
        while (definition_index < types.struct_properties.len()) {
            TypeStructProperties* definition = types.struct_properties.get_ptr(definition_index);
            if (definition.name_id == owner_name_id && definition.field_name_count > 0) {
                u32 field_type_start = definition.field_start;
                u32 field_name_start = definition.field_name_start;
                u32 field_name_count = definition.field_name_count;
                u32 type_param_start = definition.type_param_start;
                u32 type_param_count = definition.type_param_count;
                if ((i64)field_name_count != (i64)definition.field_count) { return TYPE_UNKNOWN; }
                u32 field_name_id = types.names.intern(field_name);
                i64 field_index = 0;
                while (field_index < (i64)field_name_count) {
                    if (types.struct_field_names.get(field_name_start + (u32)field_index)
                        == field_name_id) {
                        u32 member_type = types.struct_fields.get(field_type_start + (u32)field_index);
                        if (type_param_count != (u32)owner_arg_count) { return TYPE_UNKNOWN; }
                        i64 param_index = 0;
                        while (param_index < (i64)type_param_count) {
                            types.push_subst(types.struct_type_params.get(type_param_start + (u32)param_index),
                                             types.type_args.get(owner_args_start + (u32)param_index));
                            param_index += 1;
                        }
                        u32 resolved_member = types.resolve_subst(member_type);
                        types.pop_subst(type_param_count);
                        return resolved_member;
                    }
                    field_index += 1;
                }
            }
            definition_index += 1;
        }
        return TYPE_UNKNOWN;
    }
    Vec<u32> parameters = Vec<u32>.new();
    if (!mono_push_owner_type_arguments(root, types, owner_type, &parameters)) {
        return TYPE_UNKNOWN;
    }
    u32 member_type = struct_field_type_id(types, item, field_name);
    u32 resolved_member = types.resolve_subst(member_type);
    types.pop_subst(parameters.len());
    return resolved_member;
}

/// Returns true when the type has a user `Drop` impl.
bool typecheck_type_has_drop_impl(SyntaxNode* root, TypeTable* types, u32 type_id) {
    u32 resolved = types.resolve_subst(type_id);
    TypeEntry* entry = types.get(resolved);
    while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
        resolved = entry.inner;
        entry = types.get(resolved);
    }
    if (entry.kind != TypeKind.Named) { return false; }
    str owner_name = types.names.get(entry.name_id);
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            bool saw_drop = false;
            bool saw_for_after_drop = false;
            SyntaxNode* child = item.first_child;
            while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
                if (child.kind == NodeKind.Token && strcmp(child.text, "Drop") == 0) {
                    saw_drop = true;
                } else if (saw_drop && child.kind == NodeKind.Token
                           && (child.token_kind == TokenKind.For || strcmp(child.text, "for") == 0)) {
                    saw_for_after_drop = true;
                    break;
                }
                child = child.next_sibling;
            }
            if (saw_for_after_drop) {
                SyntaxNode* target = impl_target_identifier(item);
                if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0) {
                    return true;
                }
            }
        }
        item = item.next_sibling;
    }
    i64 definition_index = 0;
    while (definition_index < types.struct_properties.len()) {
        TypeStructProperties* definition = types.struct_properties.get_ptr(definition_index);
        if (definition.name_id == entry.name_id && definition.needs_drop) {
            return true;
        }
        definition_index += 1;
    }
    return false;
}

/// Internal: `typecheck_type_is_copy` with a depth limit.
bool typecheck_type_is_copy_inner(SyntaxNode* root, TypeTable* types, u32 type_id, u32 depth) {
    if (depth >= MAX_TYPE_CHECK_DEPTH) { return false; }
    u32 resolved = types.resolve_subst(type_id);
    if (resolved == TYPE_UNKNOWN || resolved == 0) { return false; }
    TypeEntry* entry = types.get(resolved);
    TypeKind kind = entry.kind;
    u32 inner = entry.inner;
    u32 name_id = entry.name_id;
    i64 count = entry.count;
    if (kind == TypeKind.Pointer || kind == TypeKind.Reference
        || kind == TypeKind.Function || kind == TypeKind.Slice || kind == TypeKind.Str
        || (resolved >= TYPE_BOOL && resolved <= TYPE_C80) || resolved == TYPE_CHAR) {
        return true;
    }
    if (kind == TypeKind.Array) {
        return typecheck_type_is_copy_inner(root, types, inner, depth + 1);
    }
    if (kind == TypeKind.Tuple) {
        i64 i = 0;
        while (i < count) {
            if (!typecheck_type_is_copy_inner(root, types,
                    types.type_args.get(inner + (u32)i), depth + 1)) { return false; }
            i += 1;
        }
        return true;
    }
    if (kind == TypeKind.TypeParam || kind == TypeKind.Unknown || kind == TypeKind.Void) {
        return false;
    }
    if (kind != TypeKind.Named) { return false; }
    str type_name = types.names.get(name_id);
    if (typecheck_type_has_drop_impl(root, types, resolved)
        || type_name_needs_drop(type_name) || type_name_is_move_only(type_name)) {
        return false;
    }
    SyntaxNode* enum_item = find_enum_item(root, type_name);
    if (enum_item != (SyntaxNode*)0) {
        Vec<u32> parameters = Vec<u32>.new();
        if (!mono_push_owner_type_arguments(root, types, resolved, &parameters)) {
            return false;
        }
        Vec<SyntaxNode*> variants = Vec<SyntaxNode*>.new();
        Vec<i64> tags = Vec<i64>.new();
        Vec<i64> arities = Vec<i64>.new();
        enum_each_variant(enum_item, &variants, &tags, &arities);
        i64 vi = 0;
        while (vi < variants.len()) {
            Vec<u32> payload_types = Vec<u32>.new();
            i64 pi = 0;
            while (pi < arities.get(vi)) {
                String payload_text = String.new();
                if (!enum_payload_type_text(root, types.names.get(name_id),
                                            variants.get(vi).text, pi, &payload_text)) {
                    types.pop_subst(parameters.len());
                    payload_text.drop();
                    payload_types.drop();
                    variants.drop();
                    tags.drop();
                    arities.drop();
                    return false;
                }
                u32 payload_type = type_id_from_text(types, payload_text.to_str());
                payload_text.drop();
                payload_types.push(payload_type);
                pi += 1;
            }
            pi = 0;
            while (pi < payload_types.len()) {
                if (!typecheck_type_is_copy_inner(root, types, payload_types.get(pi), depth + 1)) {
                    types.pop_subst(parameters.len());
                    payload_types.drop();
                    variants.drop();
                    tags.drop();
                    arities.drop();
                    return false;
                }
                pi += 1;
            }
            payload_types.drop();
            vi += 1;
        }
        variants.drop();
        tags.drop();
        arities.drop();
        types.pop_subst(parameters.len());
        return true;
    }
    if (find_item_by_name(root, NodeKind.Struct, type_name) != (SyntaxNode*)0) {
        SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, type_name);
        SyntaxNode* body = item.first_child;
        while (body != (SyntaxNode*)0 && body.kind != NodeKind.Block) {
            body = body.next_sibling;
        }
        if (body == (SyntaxNode*)0) { return false; }
        Vec<SyntaxNode*> tokens = Vec<SyntaxNode*>.new();
        typecheck_expr_collect_tokens(body, &tokens);
        i64 start = 0;
        while (start < tokens.len()) {
            i64 end = start;
            while (end < tokens.len() && tokens.get(end).token_kind != TokenKind.Semicolon) {
                end += 1;
            }
            i64 name_index = end - 1;
            while (name_index >= start && tokens.get(name_index).token_kind != TokenKind.Identifier) {
                name_index -= 1;
            }
            if (name_index >= start) {
                u32 field_type = typecheck_struct_field_type(types, root, resolved,
                                                            tokens.get(name_index).text);
                bool field_copy = typecheck_type_is_copy_inner(root, types, field_type, depth + 1);
                if (!field_copy) {
                    tokens.drop();
                    return false;
                }
            }
            start = end + 1;
        }
        tokens.drop();
        return true;
    }
    i64 imported_index = 0;
    while (imported_index < types.struct_properties.len()) {
        TypeStructProperties* definition = types.struct_properties.get_ptr(imported_index);
        if (definition.name_id == name_id) {
            u32 field_start = definition.field_start;
            u32 field_count = definition.field_count;
            u32 type_param_start = definition.type_param_start;
            u32 type_param_count = definition.type_param_count;
            TypeEntry* instance_entry = types.get(resolved);
            i64 arg_count = instance_entry.count;
            u32 args_start = instance_entry.inner;
            if (type_param_count != (u32)arg_count) { return false; }
            i64 param_index = 0;
            while (param_index < (i64)type_param_count) {
                types.push_subst(types.struct_type_params.get(type_param_start + (u32)param_index),
                                 types.type_args.get(args_start + (u32)param_index));
                param_index += 1;
            }
            u32 field_index = 0;
            while (field_index < field_count) {
                u32 field_type = types.resolve_subst(types.struct_fields.get(field_start + field_index));
                if (!typecheck_type_is_copy_inner(root, types, field_type, depth + 1)) {
                    types.pop_subst(type_param_count);
                    return false;
                }
                field_index += 1;
            }
            types.pop_subst(type_param_count);
            return true;
        }
        imported_index += 1;
    }
    i64 i = 0;
    while (i < count) {
        if (!typecheck_type_is_copy_inner(root, types,
                types.type_args.get(inner + (u32)i), depth + 1)) {
            return false;
        }
        i += 1;
    }
    return types.is_copy(resolved);
}

/// Returns true when values of `type_id` copy implicitly (no Drop, no
/// owned fields).
bool typecheck_type_is_copy(SyntaxNode* root, TypeTable* types, u32 type_id) {
    return typecheck_type_is_copy_inner(root, types, type_id, 0);
}

/// Collects a place's field path into `fields`; returns its root local
/// expression id.
u32 typecheck_collect_place(AstPool* pool, u32 expr_id, Vec<u32>* fields) {
    if (expr_id == 0) { return 0; }
    AstExpr* expr = pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Var) { return expr.aux; }
    if (expr.kind == ExprKind.Move) {
        return typecheck_collect_place(pool, expr.inner0, fields);
    }
    if (expr.kind != ExprKind.Field || expr.inner0 == 0) { return 0; }
    u32 root_name = typecheck_collect_place(pool, expr.inner0, fields);
    if (root_name != 0) { fields.push(expr.aux); }
    return root_name;
}

/// Returns the type of place expression `place_id`.
u32 typecheck_place_type(AstPool* pool, TypeTable* types, SymbolTable* symbols,
                         SyntaxNode* root, TypeEnv* env, u32 place_id) {
    Vec<u32> fields = Vec<u32>.new();
    u32 root_name = typecheck_collect_place(pool, place_id, &fields);
    if (root_name == 0) {
        fields.drop();
        return TYPE_UNKNOWN;
    }
    AstExpr* root_expr = pool.get_expr(place_id);
    while (root_expr.kind == ExprKind.Field || root_expr.kind == ExprKind.Move) {
        root_expr = pool.get_expr(root_expr.inner0);
    }
    if (root_expr.kind != ExprKind.Var) {
        fields.drop();
        return TYPE_UNKNOWN;
    }
    u32 place_type = env.lookup(root_expr.aux);
    if (place_type == TYPE_UNKNOWN) {
        place_type = symbols.get_type(symbols.names.get(root_expr.aux));
    }
    i64 i = 0;
    while (place_type != TYPE_UNKNOWN && i < fields.len()) {
        place_type = typecheck_struct_field_type(types, root, place_type,
                                                 symbols.names.get(fields.get(i)));
        i += 1;
    }
    fields.drop();
    return place_type;
}

/// Reports moving a `lock` block's value, or an owned field or element of
/// it, out of the block. The value is `(*__lock_N__name)`, a place inside
/// the Mutex (see sync_sugar.ag), and the Mutex would still own and drop
/// it. A tuple, a brace initializer, or a match arm consumes each value it
/// is built from, and a conditional either of its results. Returns true when
/// it reported.
bool typecheck_reject_locked_move(AstPool* pool, TypeTable* types, SymbolTable* symbols,
                                  SyntaxNode* root, u32 place_id,
                                  DiagnosticBag* diagnostics, bool* ok) {
    AstExpr* place = pool.get_expr(place_id);
    if (place.kind == ExprKind.ArrayLit || place.kind == ExprKind.Match) {
        // Each arm's own locked payloads were checked with the arm, so its
        // bindings only shadow outer locked names here.
        bool reported = false;
        i64 i = 0;
        while (i < (i64)place.aux) {
            i64 locked_mark = pool.locked_bindings.len();
            u32 part = 0;
            if (place.kind == ExprKind.ArrayLit) {
                part = pool.args.get((i64)place.inner1 + 1 + i);
            } else {
                MatchArm* arm = pool.get_arm(place.inner1 + (u32)i);
                typecheck_push_arm_bindings(pool, arm, false);
                part = arm.value_id;
            }
            // A `move` part is rejected where the move is checked.
            if (part != 0 && pool.get_expr(part).kind != ExprKind.Move
                && typecheck_reject_locked_move(pool, types, symbols, root, part,
                                                diagnostics, ok)) {
                reported = true;
            }
            while (pool.locked_bindings.len() > locked_mark) { pool.locked_bindings.pop(); }
            i += 1;
        }
        return reported;
    }
    if (place.kind == ExprKind.Ternary) {
        bool then_reported = place.inner1 != 0
            && typecheck_reject_locked_move(pool, types, symbols, root, place.inner1, diagnostics, ok);
        bool else_reported = place.aux != 0
            && typecheck_reject_locked_move(pool, types, symbols, root, place.aux, diagnostics, ok);
        return then_reported || else_reported;
    }
    AstExpr* base = place;
    String path = String.new();
    while ((base.kind == ExprKind.Field || base.kind == ExprKind.Index) && base.inner0 != 0) {
        String step = String.from_str(base.kind == ExprKind.Field ? "." : "[...]");
        if (base.kind == ExprKind.Field) { step.push_str(symbols.names.get(base.aux)); }
        step.push_str(path.to_str());
        path = move step;
        base = pool.get_expr(base.inner0);
    }
    String name = String.new();
    if (base.kind == ExprKind.Var && typecheck_is_locked_binding(pool, base.aux)) {
        name.push_str(symbols.names.get(base.aux));
    } else {
        if (base.kind != ExprKind.Unary || base.aux != (u32)TokenKind.Star || base.inner0 == 0) { return false; }
        AstExpr* pointer = pool.get_expr(base.inner0);
        if (pointer.kind != ExprKind.Var) { return false; }
        String local = String.from_str(symbols.names.get(pointer.aux));
        i64 start = sugar_locked_name_start(local.to_str());
        if (start < 0) { return false; }
        name = local.substr(start, local.len() - start);
    }
    if (place.inferred_type == TYPE_UNKNOWN || typecheck_type_is_copy(root, types, place.inferred_type)) {
        return false;
    }
    name.push_str(path.to_str());
    diagnostics.error(place.span, move_out_of_lock(name.to_str()));
    *ok = false;
    return true;
}

/// True when name `name_id` is a payload binding of a match arm on a lock
/// block's value and no later local shadows it.
bool typecheck_is_locked_binding(AstPool* pool, u32 name_id) {
    i64 i = pool.locked_bindings.len() - 1;
    while (i >= 0) {
        LockedName* entry = pool.locked_bindings.get_ptr(i);
        if (entry.name_id == name_id) { return entry.locked; }
        i -= 1;
    }
    return false;
}

/// True when `id` reads a lock block's value or a field of it: sync_sugar
/// lowers the value to `(*__lock_N__name)`.
bool typecheck_reads_locked_value(AstPool* pool, SymbolTable* symbols, u32 id) {
    AstExpr* base = pool.get_expr(id);
    while ((base.kind == ExprKind.Field || base.kind == ExprKind.Index) && base.inner0 != 0) {
        base = pool.get_expr(base.inner0);
    }
    if (base.kind == ExprKind.Var) { return typecheck_is_locked_binding(pool, base.aux); }
    if (base.kind != ExprKind.Unary || base.aux != (u32)TokenKind.Star || base.inner0 == 0) { return false; }
    AstExpr* pointer = pool.get_expr(base.inner0);
    return pointer.kind == ExprKind.Var && sugar_locked_name_start(symbols.names.get(pointer.aux)) >= 0;
}

/// Pushes the names `arm` binds onto `pool.locked_bindings`: locked when
/// they are payloads of a locked scrutinee, and otherwise shadows of any
/// outer locked name. The caller truncates them when the arm ends.
void typecheck_push_arm_bindings(AstPool* pool, MatchArm* arm, bool locked) {
    i64 bound = 0;
    while (bound < (i64)arm.bindings_count) {
        LockedName entry;
        entry.name_id = pool.arm_bindings.get((i64)arm.bindings_start + bound);
        entry.locked = locked && arm.pattern == MatchPatternKind.Variant;
        pool.locked_bindings.push(entry);
        bound += 1;
    }
}

/// The payload binding that match arm `arm` moves out of its scrutinee: a
/// `move` binding, or an owning binding the arm yields. 0 when none.
u32 typecheck_arm_moved_binding(AstPool* pool, TypeTable* types, SyntaxNode* root, MatchArm* arm) {
    if (arm.pattern != MatchPatternKind.Variant || arm.bindings_count == 0) { return 0; }
    if (arm.value_id != 0) {
        AstExpr* value = pool.get_expr(arm.value_id);
        if (value.kind == ExprKind.Move && value.inner0 != 0) { value = pool.get_expr(value.inner0); }
        i64 i = 0;
        while (value.kind == ExprKind.Var && i < (i64)arm.bindings_count) {
            if (pool.arm_bindings.get((i64)arm.bindings_start + i) == value.aux
                && value.inferred_type != TYPE_UNKNOWN
                && !typecheck_type_is_copy(root, types, value.inferred_type)) {
                return value.aux;
            }
            i += 1;
        }
    }
    return arm.moves_payload ? pool.arm_bindings.get((i64)arm.bindings_start) : 0;
}

/// Whether an argument of `actual` type passed for a parameter of `expected`
/// type is coerced to a view of it, which leaves the argument with its owner:
/// a `Vec` or array passed as a `Slice`.
bool typecheck_coerces_to_view(TypeTable* types, u32 expected, u32 actual) {
    if (expected == TYPE_UNKNOWN || actual == TYPE_UNKNOWN) { return false; }
    TypeEntry* view = types.get(types.resolve_subst(expected));
    TypeEntry* source = types.get(types.resolve_subst(actual));
    if (view.kind != TypeKind.Named || strcmp(types.names.get(view.name_id), "Slice") != 0) {
        return false;
    }
    return source.kind == TypeKind.Array
        || (source.kind == TypeKind.Named && strcmp(types.names.get(source.name_id), "Slice") != 0);
}

/// Records that `place_id` is passed by value, for the move-flow pass, and
/// reports moving a field out of a value whose type implements Drop, or a
/// value out of a lock block. Returns true when it reported.
bool typecheck_reject_partial_drop_move(AstPool* pool, TypeTable* types, SymbolTable* symbols,
                                        SyntaxNode* root, TypeEnv* env, u32 place_id,
                                        DiagnosticBag* diagnostics, bool* ok) {
    pool.consumed.set((i64)place_id);
    if (typecheck_reject_locked_move(pool, types, symbols, root, place_id, diagnostics, ok)) {
        return true;
    }
    Vec<u32> fields = Vec<u32>.new();
    u32 root_name = typecheck_collect_place(pool, place_id, &fields);
    if (root_name == 0 || fields.len() == 0) {
        fields.drop();
        return false;
    }
    AstExpr* root_expr = pool.get_expr(place_id);
    while (root_expr.kind == ExprKind.Field || root_expr.kind == ExprKind.Move) {
        root_expr = pool.get_expr(root_expr.inner0);
    }
    if (root_expr.kind != ExprKind.Var) {
        fields.drop();
        return false;
    }
    u32 owner_type = env.lookup(root_expr.aux);
    if (owner_type == TYPE_UNKNOWN) {
        owner_type = symbols.get_type(symbols.names.get(root_expr.aux));
    }
    if (owner_type == TYPE_UNKNOWN) {
        fields.drop();
        return false;
    }
    owner_type = types.resolve_subst(owner_type);
    TypeEntry* root_owner_entry = types.get(owner_type);
    if (root_owner_entry.kind == TypeKind.Pointer || root_owner_entry.kind == TypeKind.Reference) {
        fields.drop();
        return false;
    }
    String place_text = String.from_str(symbols.names.get(root_expr.aux));
    String owner_text = String.from_str(symbols.names.get(root_expr.aux));
    i64 path_index = 0;
    while (path_index < fields.len()) {
        place_text.push('.');
        place_text.push_str(symbols.names.get(fields.get(path_index)));
        path_index += 1;
    }
    u32 probe_type = owner_type;
    i64 i = 0;
    while (i < fields.len()) {
        TypeEntry* probe_entry = types.get(types.resolve_subst(probe_type));
        if (probe_entry.kind == TypeKind.Pointer || probe_entry.kind == TypeKind.Reference) {
            place_text.drop();
            owner_text.drop();
            fields.drop();
            return false;
        }
        u32 field_type = typecheck_struct_field_type(types, root, probe_type,
                                                    symbols.names.get(fields.get(i)));
        if (field_type == TYPE_UNKNOWN) {
            place_text.drop();
            owner_text.drop();
            fields.drop();
            return false;
        }
        probe_type = field_type;
        i += 1;
    }
    if (probe_type == TYPE_UNKNOWN || typecheck_type_is_copy(root, types, probe_type)) {
        place_text.drop();
        owner_text.drop();
        fields.drop();
        return false;
    }
    i = 0;
    while (i < fields.len()) {
        if (typecheck_type_has_drop_impl(root, types, owner_type)) {
            String message = cannot_move_field_out_of_drop_type(place_text.to_str(), owner_text.to_str());
            diagnostics.error(pool.get_expr(place_id).span, move message);
            *ok = false;
            place_text.drop();
            owner_text.drop();
            fields.drop();
            return true;
        }
        u32 field_id = fields.get(i);
        owner_type = typecheck_struct_field_type(types, root, owner_type,
                                                 symbols.names.get(field_id));
        if (owner_type == TYPE_UNKNOWN) { break; }
        if (i + 1 < fields.len()) {
            owner_text.push('.');
            owner_text.push_str(symbols.names.get(field_id));
        }
        i += 1;
    }
    place_text.drop();
    owner_text.drop();
    fields.drop();
    return false;
}

/// True when `owner.method(...)` constructs a variant of enum `owner`,
/// which takes each payload by value.
bool typecheck_is_variant_constructor(SyntaxNode* root, str owner, str method_name) {
    SyntaxNode* enum_item = find_enum_item(root, owner);
    if (enum_item == (SyntaxNode*)0) { return false; }
    Vec<SyntaxNode*> variants = Vec<SyntaxNode*>.new();
    Vec<i64> tags = Vec<i64>.new();
    Vec<i64> arities = Vec<i64>.new();
    enum_each_variant(enum_item, &variants, &tags, &arities);
    bool constructor = false;
    i64 i = 0;
    while (i < variants.len() && !constructor) {
        constructor = strcmp(variants.get(i).text, method_name) == 0;
        i += 1;
    }
    variants.drop();
    tags.drop();
    arities.drop();
    return constructor;
}

/// Returns true when the method parameter takes its argument by value.
bool typecheck_method_parameter_is_value(SyntaxNode* root, TypeTable* types,
                                         u32 receiver_type, str method_name,
                                         i64 param_count, i64 parameter_index,
                                         u32 arg_type) {
    u32 resolved = types.resolve_subst(receiver_type);
    TypeEntry* receiver_entry = types.get(resolved);
    while (receiver_entry.kind == TypeKind.Pointer || receiver_entry.kind == TypeKind.Reference) {
        resolved = receiver_entry.inner;
        receiver_entry = types.get(resolved);
    }
    if (receiver_entry.kind != TypeKind.Named) { return false; }
    str owner_name = types.names.get(receiver_entry.name_id);
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                SyntaxNode* member = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.first_child;
                while (member != (SyntaxNode*)0) {
                    if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Semicolon) {
                        member = member.next_sibling;
                        continue;
                    }
                    SyntaxNode* name = (SyntaxNode*)0;
                    SyntaxNode* params_node = (SyntaxNode*)0;
                    SyntaxNode* body = (SyntaxNode*)0;
                    SyntaxNode* scan = member;
                    while (scan != (SyntaxNode*)0) {
                        if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon) {
                            break;
                        }
                        if (scan.kind == NodeKind.Block) {
                            body = scan;
                            break;
                        }
                        if (scan.kind == NodeKind.Parenthesized) {
                            params_node = scan;
                            if (scan.next_sibling != (SyntaxNode*)0
                                && scan.next_sibling.kind == NodeKind.Block) {
                                body = scan.next_sibling;
                                break;
                            }
                        }
                        if (scan.kind == NodeKind.Token
                            && scan.token_kind == TokenKind.Identifier) {
                            name = scan;
                        }
                        scan = scan.next_sibling;
                    }
                    name = item_method_name(member, params_node);
                    if (body != (SyntaxNode*)0 && name != (SyntaxNode*)0
                        && params_node != (SyntaxNode*)0
                        && strcmp(name.text, method_name) == 0) {
                        Vec<Binding> params = Vec<Binding>.new();
                        collect_parameter_bindings(params_node, &params);
                        if (param_count == 0 || params.len() == param_count) {
                            bool value_parameter = false;
                            if (parameter_index >= 0 && parameter_index < params.len()) {
                                Binding* parameter = params.get_ptr(parameter_index);
                                value_parameter = parameter.declared_type.kind != ProjectionTypeKind.Pointer
                                    && parameter.declared_type.kind != ProjectionTypeKind.Reference;
                            }
                            params.drop();
                            return value_parameter;
                        }
                        params.drop();
                    }
                    member = body != (SyntaxNode*)0 ? body.next_sibling
                        : (scan != (SyntaxNode*)0 && scan.kind == NodeKind.Token
                           && scan.token_kind == TokenKind.Semicolon ? scan.next_sibling : scan);
                }
            }
        }
        item = item.next_sibling;
    }
    return types.method_param_is_value(owner_name, method_name, param_count, parameter_index, arg_type);
}

/// Returns true when the method takes `self` by value.
bool typecheck_method_has_value_receiver(SyntaxNode* root, TypeTable* types,
                                         u32 receiver_type, str method_name,
                                         i64 param_count) {
    return typecheck_method_parameter_is_value(root, types, receiver_type,
                                               method_name, param_count, 0,
                                               receiver_type);
}

/// Returns true when an argument fits a method parameter for overload
/// scoring.
bool typecheck_method_argument_score(AstPool* pool, TypeTable* types,
                                     SyntaxNode* root, u32 receiver_type,
                                     u32 arg_id, u32 expected_type,
                                     i64* score) {
    u32 expected = types.resolve_subst(resolve_generic_member_type(
        types, root, receiver_type, expected_type));
    TypeEntry* expected_entry = types.get(expected);
    AstExpr* argument = pool.get_expr(arg_id);
    if (argument.kind == ExprKind.ArrayLit && expected_entry.kind == TypeKind.Tuple) {
        if (expected_entry.count != (i64)argument.aux) { return false; }
        i64 i = 0;
        while (i < expected_entry.count) {
            u32 element_id = pool.args.get((i64)argument.inner1 + 1 + i);
            u32 element_type = types.type_args.get(expected_entry.inner + (u32)i);
            if (!typecheck_method_argument_score(pool, types, root, receiver_type,
                                                element_id, element_type, score)) {
                return false;
            }
            i += 1;
        }
        return true;
    }

    u32 actual = types.resolve_subst(argument.inferred_type);
    if (actual == TYPE_UNKNOWN || expected == TYPE_UNKNOWN) { return true; }
    if (expected == actual) {
        *score = *score + 2;
        return true;
    }
    if (types_match(types, expected, actual)) {
        *score = *score + 1;
        return true;
    }
    if (expected_entry.kind == TypeKind.Reference && !expected_entry.is_mut
        && types_match(types, expected_entry.inner, actual)) {
        *score = *score + 1;
        return true;
    }
    if (typecheck_slice_argument_coercion(types, expected, actual)) {
        *score = *score + 1;
        return true;
    }
    if (types_match_value(types, expected, actual, expr_is_literal(pool, arg_id))
        || typecheck_implicit_cast(root, types, actual, expected)) {
        *score = *score + 1;
        return true;
    }
    return false;
}

/// Returns a method declaration's return type id.
u32 typecheck_method_decl_return_type(TypeTable* types, SyntaxNode* ret_start,
                                      SyntaxNode* method_name_node) {
    String return_text = String.new();
    SyntaxNode* scan = ret_start;
    while (scan != (SyntaxNode*)0 && scan != method_name_node) {
        if (scan.kind == NodeKind.Token && scan.text == "#") {
            scan = scan.next_sibling;
            if (scan != (SyntaxNode*)0 && scan.kind == NodeKind.Bracket) {
                scan = scan.next_sibling;
            }
            continue;
        }
        if (scan.kind == NodeKind.Token && (scan.text == "private" || scan.text == "static")) {
            scan = scan.next_sibling;
            continue;
        }
        break;
    }
    while (scan != (SyntaxNode*)0 && scan != method_name_node) {
        append_node_tokens(scan, &return_text);
        scan = scan.next_sibling;
    }
    u32 return_type = types.parse_type_name(return_text.to_str());
    return_text.drop();
    return return_type;
}

/// Returns true when an impl declares several methods named `method_name`.
bool typecheck_method_has_overloads(SyntaxNode* method_name_node,
                                    str method_name) {
    i64 method_count = 0;
    SyntaxNode* block = method_name_node == (SyntaxNode*)0
        ? (SyntaxNode*)0 : method_name_node.parent;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.parent;
    }
    SyntaxNode* implementation = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.parent;
    SyntaxNode* owner = implementation == (SyntaxNode*)0 ? (SyntaxNode*)0
        : impl_target_identifier(implementation);
    SyntaxNode* root = implementation == (SyntaxNode*)0 ? (SyntaxNode*)0 : implementation.parent;
    SyntaxNode* item = root == (SyntaxNode*)0 ? (SyntaxNode*)0 : root.first_child;
    while (item != (SyntaxNode*)0 && method_count < 2) {
        SyntaxNode* target = item.kind == NodeKind.Impl ? impl_target_identifier(item) : (SyntaxNode*)0;
        if (owner == (SyntaxNode*)0 || target == (SyntaxNode*)0
            || strcmp(owner.text, target.text) != 0) {
            item = item.next_sibling;
            continue;
        }
        block = item.first_child;
        while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
            block = block.next_sibling;
        }
        SyntaxNode* member = block == (SyntaxNode*)0
            ? (SyntaxNode*)0 : block.first_child;
        while (member != (SyntaxNode*)0 && method_count < 2) {
            if (member.kind == NodeKind.Token
                && member.token_kind == TokenKind.Semicolon) {
                member = member.next_sibling;
                continue;
            }
            SyntaxNode* name = (SyntaxNode*)0;
            SyntaxNode* params_node = (SyntaxNode*)0;
            SyntaxNode* body = (SyntaxNode*)0;
            SyntaxNode* scan = member;
            while (scan != (SyntaxNode*)0) {
                if (scan.kind == NodeKind.Token
                    && scan.token_kind == TokenKind.Semicolon) { break; }
                if (scan.kind == NodeKind.Block) { body = scan; break; }
                if (scan.kind == NodeKind.Parenthesized) {
                    params_node = scan;
                    if (scan.next_sibling != (SyntaxNode*)0
                        && scan.next_sibling.kind == NodeKind.Block) {
                        body = scan.next_sibling;
                        break;
                    }
                }
                if (scan.kind == NodeKind.Token
                    && scan.token_kind == TokenKind.Identifier) {
                    name = scan;
                }
                scan = scan.next_sibling;
            }
            name = item_method_name(member, params_node);
            if (body != (SyntaxNode*)0 && params_node != (SyntaxNode*)0
                && name != (SyntaxNode*)0
                && strcmp(name.text, method_name) == 0) {
                method_count += 1;
            }
            member = body != (SyntaxNode*)0 ? body.next_sibling
                : (scan != (SyntaxNode*)0 && scan.kind == NodeKind.Token
                   && scan.token_kind == TokenKind.Semicolon
                   ? scan.next_sibling : scan);
        }
        item = item.next_sibling;
    }
    return method_count > 1;
}

/// Returns the symbol of `owner_name.method_name`, mangled when overloaded.
String typecheck_method_symbol(TypeTable* types, str owner_name,
                               str method_name,
                               SyntaxNode* ret_start,
                               SyntaxNode* method_name_node,
                               SyntaxNode* params_node) {
    String symbol = String.from_str(owner_name);
    symbol.push_str("__");
    symbol.push_str(method_name);
    if (!typecheck_method_has_overloads(method_name_node, method_name)) {
        return move symbol;
    }

    types.push_subst(types.names.intern("Self"), types.parse_type_name(owner_name));
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(params_node, &params);
    String key = String.from_str(owner_name);
    key.push_str("__");
    key.push_str(method_name);
    key.push('(');
    i64 i = 0;
    while (i < params.len()) {
        if (i > 0) { key.push(','); }
        u32 param_type = types.resolve_subst(
            typecheck_parameter_type_id(types, params.get_ptr(i)));
        String canonical = typecheck_canonical_type(types, param_type, 0);
        key.push_str(canonical.to_str());
        canonical.drop();
        i += 1;
    }
    key.push_str(")->");
    u32 return_type = typecheck_method_decl_return_type(types, ret_start,
                                                        method_name_node);
    String canonical_return = typecheck_canonical_type(types, return_type, 0);
    key.push_str(canonical_return.to_str());
    canonical_return.drop();
    u64 hash = typecheck_fnv1a64(key.to_str());
    key.drop();
    params.drop();
    types.pop_subst(1);

    symbol.push_str("__");
    i64 shift = 60;
    while (shift >= 0) {
        u8 digit = (u8)((hash >> (u64)shift) & (u64)15);
        u8 rendered = (u8)0;
        if (digit < 10) { rendered = (u8)'0' + digit; }
        else { rendered = (u8)'a' + digit - (u8)10; }
        symbol.push(rendered);
        shift -= 4;
    }
    return move symbol;
}

/// Returns the parameter list of the `owner_name.method_name` overload whose
/// parameters best fit the call's arguments, the one codegen dispatches to,
/// with its return-type start and name in `out_ret_start` and `out_name`.
/// Null when no local declaration accepts the call.
SyntaxNode* typecheck_select_method(AstPool* pool, SyntaxNode* root, TypeTable* types,
                                    u32 resolved_receiver, str owner_name,
                                    str method_name, u32 args_start, bool static_method,
                                    SyntaxNode** out_ret_start, SyntaxNode** out_name) {
    u32 arg_count = pool.args.get((i64)args_start);
    i64 parameter_offset = static_method ? 0 : 1;
    i64 best_score = -1;
    SyntaxNode* best_ret_start = (SyntaxNode*)0;
    SyntaxNode* best_name = (SyntaxNode*)0;
    SyntaxNode* best_params = (SyntaxNode*)0;
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                // In `impl Record*`, a `Self` parameter is a `Record*`.
                bool pointer_impl = impl_target_pointer_depth(item) > 0;
                if (pointer_impl) {
                    types.push_subst(types.names.intern("Self"),
                                     typecheck_impl_self_type(types, item));
                }
                SyntaxNode* member = block == (SyntaxNode*)0
                    ? (SyntaxNode*)0 : block.first_child;
                while (member != (SyntaxNode*)0) {
                    if (member.kind == NodeKind.Token
                        && member.token_kind == TokenKind.Semicolon) {
                        member = member.next_sibling;
                        continue;
                    }
                    SyntaxNode* name = (SyntaxNode*)0;
                    SyntaxNode* params_node = (SyntaxNode*)0;
                    SyntaxNode* body = (SyntaxNode*)0;
                    SyntaxNode* scan = member;
                    while (scan != (SyntaxNode*)0) {
                        if (scan.kind == NodeKind.Token
                            && scan.token_kind == TokenKind.Semicolon) { break; }
                        if (scan.kind == NodeKind.Block) { body = scan; break; }
                        if (scan.kind == NodeKind.Parenthesized) {
                            params_node = scan;
                            if (scan.next_sibling != (SyntaxNode*)0
                                && scan.next_sibling.kind == NodeKind.Block) {
                                body = scan.next_sibling;
                                break;
                            }
                        }
                        if (scan.kind == NodeKind.Token
                            && scan.token_kind == TokenKind.Identifier) {
                            name = scan;
                        }
                        scan = scan.next_sibling;
                    }
                    if (body != (SyntaxNode*)0 && params_node != (SyntaxNode*)0
                        && name != (SyntaxNode*)0
                        && strcmp(name.text, method_name) == 0) {
                        Vec<Binding> params = Vec<Binding>.new();
                        collect_parameter_bindings(params_node, &params);
                        if (binding_parameters_accept_arity(
                                &params, (i64)arg_count + parameter_offset)) {
                            bool variadic = params.len() > 0
                                && binding_is_variadic_parameter(
                                    params.get_ptr(params.len() - 1));
                            i64 fixed_count = params.len() - (variadic ? 1 : 0);
                            bool matches = true;
                            i64 score = 0;
                            i64 arg_index = 0;
                            while (matches && arg_index < (i64)arg_count) {
                                u32 arg_id = pool.args.get((i64)args_start + 1 + arg_index);
                                i64 parameter_index = parameter_offset + arg_index;
                                Binding* parameter = params.get_ptr(
                                    parameter_index < fixed_count
                                        ? parameter_index : (i64)(params.len() - 1));
                                u32 expected = variadic && parameter_index >= fixed_count
                                    ? typecheck_parameter_base_type_id(types, parameter)
                                    : typecheck_parameter_type_id(types, parameter);
                                matches = typecheck_method_argument_score(
                                    pool, types, root, resolved_receiver,
                                    arg_id, expected, &score);
                                arg_index += 1;
                            }
                            if (matches && score > best_score) {
                                best_score = score;
                                best_ret_start = member;
                                best_name = name;
                                best_params = params_node;
                            }
                        }
                        params.drop();
                    }
                    member = body != (SyntaxNode*)0 ? body.next_sibling
                        : (scan != (SyntaxNode*)0 && scan.kind == NodeKind.Token
                           && scan.token_kind == TokenKind.Semicolon
                           ? scan.next_sibling : scan);
                }
                if (pointer_impl) { types.pop_subst(1); }
            }
        }
        item = item.next_sibling;
    }
    *out_ret_start = best_ret_start;
    *out_name = best_name;
    return best_params;
}

/// Counts the declarations of `method_name` directly in the block of `item`
/// (an impl or trait). `*generic` counts those with their own type parameters.
void typecheck_count_block_methods(SyntaxNode* item, str method_name, i64* count,
                                   i64* generic) {
    SyntaxNode* block = item == (SyntaxNode*)0 ? (SyntaxNode*)0 : item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    // Bodies are nested blocks, so a direct `name(` or `name<` is a
    // method declaration.
    SyntaxNode* member = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.first_child;
    while (member != (SyntaxNode*)0) {
        SyntaxNode* next = member.next_sibling;
        if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Identifier
            && strcmp(member.text, method_name) == 0 && next != (SyntaxNode*)0) {
            if (next.kind == NodeKind.Parenthesized) {
                *count = *count + 1;
            } else if (next.kind == NodeKind.Token && next.token_kind == TokenKind.Less) {
                *count = *count + 1;
                *generic = *generic + 1;
            }
        }
        member = next;
    }
}

/// Returns the trait an impl implements (`Show` in `impl Show for A`), or
/// null for an inherent impl.
SyntaxNode* typecheck_impl_trait(SyntaxNode* impl_item) {
    SyntaxNode* trait_name = (SyntaxNode*)0;
    i64 angle_depth = 0;
    SyntaxNode* child = impl_item.first_child;
    while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
        if (child.kind == NodeKind.Token) {
            if (child.token_kind == TokenKind.Less) {
                angle_depth += 1;
            } else if (child.token_kind == TokenKind.Greater && angle_depth > 0) {
                angle_depth -= 1;
            } else if (child.token_kind == TokenKind.For || strcmp(child.text, "for") == 0) {
                return trait_name;
            } else if (angle_depth == 0 && trait_name == (SyntaxNode*)0
                       && node_is_identifier(child)) {
                trait_name = child;
            }
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

/// Where `method_name` is declared for a receiver type: `own` impls
/// (`generic` counts those with their own type parameters) and `blanket`
/// impls (`impl<T> Show for T`). Trait defaults are already copied into
/// each impl by `materialize_trait_defaults`.
struct MethodDeclarations {
    i64 own;
    i64 generic;
    i64 blanket;
}

/// Whether `impl_item` targets its own type parameter (`impl<T> Show for
/// T`) and so applies to every type. `impl Show for i32` does not.
bool typecheck_impl_is_blanket(TypeTable* types, SyntaxNode* impl_item, SyntaxNode* target) {
    Vec<u32> params = Vec<u32>.new();
    mono_impl_type_parameters(impl_item, types, &params);
    bool blanket = mono_contains_type_param(&params, types.names.intern(target.text));
    params.drop();
    return blanket;
}

/// Counts the declarations of `method_name` that `owner_name` can reach.
MethodDeclarations typecheck_count_methods(TypeTable* types, SyntaxNode* root, str owner_name,
                                           str method_name) {
    MethodDeclarations found = { .own = 0, .generic = 0, .blanket = 0 };
    i64 ignored_generic = 0;
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        SyntaxNode* target = item.kind == NodeKind.Impl
            ? impl_target_identifier(item) : (SyntaxNode*)0;
        if (target != (SyntaxNode*)0) {
            bool own = strcmp(target.text, owner_name) == 0;
            bool blanket = !own && typecheck_impl_is_blanket(types, item, target);
            if (own) {
                typecheck_count_block_methods(item, method_name, &found.own, &found.generic);
            } else if (blanket) {
                typecheck_count_block_methods(item, method_name, &found.blanket,
                                              &ignored_generic);
            }
        }
        item = item.next_sibling;
    }
    return found;
}

/// Returns the type a method call dispatches on: `receiver_type` behind
/// any pointers and references.
u32 typecheck_method_owner_type(TypeTable* types, u32 receiver_type) {
    u32 owner_type = types.resolve_subst(receiver_type);
    TypeEntry* owner = types.get(owner_type);
    while (owner.kind == TypeKind.Pointer || owner.kind == TypeKind.Reference) {
        owner_type = types.resolve_subst(owner.inner);
        owner = types.get(owner_type);
    }
    return owner_type;
}

/// Stores the declarations of `method_name` on `owner_type` in `found`.
/// Returns false when the call is not judged: the owner is not a primitive
/// or declared struct or enum, or reaches the method another way (`drop`,
/// primitive `compare`, a blanket impl, or a `str` call that codegen sends
/// to `Slice<u8>`).
bool typecheck_judged_methods(TypeTable* types, SyntaxNode* root, u32 owner_type,
                              str method_name, MethodDeclarations* found) {
    if (strcmp(method_name, "drop") == 0) { return false; }
    TypeEntry* owner = types.get(owner_type);
    bool primitive = owner_type != TYPE_VOID && type_is_primitive(owner_type);
    if (primitive && strcmp(method_name, "compare") == 0) { return false; }
    if (!primitive && (owner.kind != TypeKind.Named
        || typecheck_type_is_unresolved(types, owner_type, 0))) {
        return false;
    }
    str owner_name = primitive ? types.type_name(owner_type) : types.names.get(owner.name_id);
    if (!primitive && find_item_by_name(root, NodeKind.Struct, owner_name) == (SyntaxNode*)0
        && find_enum_item(root, owner_name) == (SyntaxNode*)0) {
        return false;
    }
    *found = typecheck_count_methods(types, root, owner_name, method_name);
    return found.own > 0 || (found.blanket == 0 && !(owner_type == TYPE_STR
        && typecheck_count_methods(types, root, "Slice", method_name).own > 0));
}

/// Reports a call to a method that a declared struct or enum receiver
/// cannot have: no impl declares the name, only a trait default does, or
/// the owner declares it but no overload accepts the arguments.
/// Unresolved receivers and argument types are not judged.
void typecheck_method_call_target(AstPool* pool, TypeTable* types, SyntaxNode* root,
                                  u32 receiver_type, str method_name, u32 args_start,
                                  bool static_method, Span span,
                                  DiagnosticBag* diagnostics, bool* ok) {
    u32 owner_type = typecheck_method_owner_type(types, receiver_type);
    MethodDeclarations found = { .own = 0, .generic = 0, .blanket = 0 };
    if (!typecheck_judged_methods(types, root, owner_type, method_name, &found)) { return; }
    if (found.own == 0) {
        diagnostics.error(span, unknown_method(method_name, types.type_name(owner_type)));
        *ok = false;
        return;
    }
    if (args_start >= (u32)pool.args.len()) { return; }
    str owner_name = type_is_primitive(owner_type) ? types.type_name(owner_type)
        : types.names.get(types.get(owner_type).name_id);
    SyntaxNode* ret_start = (SyntaxNode*)0;
    SyntaxNode* name = (SyntaxNode*)0;
    // An instance call may also pass its receiver explicitly: `r.get(&r)`.
    types.push_subst(types.names.intern("Self"), owner_type);
    bool selected = typecheck_select_method(pool, root, types, owner_type, owner_name,
            method_name, args_start, static_method, &ret_start, &name) != (SyntaxNode*)0
        || (!static_method
            && typecheck_select_method(pool, root, types, owner_type, owner_name, method_name,
                                       args_start, true, &ret_start, &name)
                != (SyntaxNode*)0);
    types.pop_subst(1);
    // A method of a bounded implementation, such as `get` in
    // `impl<T: Copy> Vec<T>`, exists only where the bounds hold.
    SyntaxNode* declaring = name == (SyntaxNode*)0 || name.parent == (SyntaxNode*)0
        ? (SyntaxNode*)0 : name.parent.parent;
    if (selected && declaring != (SyntaxNode*)0 && declaring.kind == NodeKind.Impl) {
        declaring = typecheck_receiver_impl(root, types, receiver_type, owner_name,
                                            method_name, declaring);
        String failure = String.new();
        mono_owner_bound_failure(root, types, declaring, owner_type, &failure);
        bool bounds_hold = failure.len() == 0;
        if (!bounds_hold) {
            diagnostics.error(span, method_bound_not_met(method_name,
                types.type_name(owner_type), failure.to_str()));
            *ok = false;
        }
        failure.drop();
        if (!bounds_hold) { return; }
    }
    // Overload selection does not infer a method's own type parameters. A
    // generic declaration whose arity fits is matched by monomorphization,
    // which reports its own failure where the call's type is inferred.
    if (!selected && found.generic > 0) {
        MonoMethodTemplate template;
        Vec<u32> param_ids = Vec<u32>.new();
        Vec<u32> arg_ids = Vec<u32>.new();
        String failure = String.new();
        selected = mono_resolve_generic_method(pool, root, types, receiver_type, method_name,
                args_start, static_method, &template, &param_ids, &arg_ids, &failure)
            || !typecheck_method_arguments_known(pool, args_start);
        failure.drop();
        arg_ids.drop();
        param_ids.drop();
    }
    if (!selected) {
        diagnostics.error(span, method_overload_mismatch(method_name,
                                                         types.type_name(owner_type)));
        *ok = false;
    }
}

/// The implementation that declares `method_name` for a receiver as
/// indirect as `receiver_type`: `(&v).into_iter()` uses `impl ... for
/// Vec<T>*`, not the by-value impl. Falls back to `selected`.
SyntaxNode* typecheck_receiver_impl(SyntaxNode* root, TypeTable* types, u32 receiver_type,
                                    str owner_name, str method_name, SyntaxNode* selected) {
    u32 depth = 0;
    TypeEntry* entry = types.get(types.resolve_subst(receiver_type));
    while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
        depth += 1;
        entry = types.get(types.resolve_subst(entry.inner));
    }
    if (impl_target_pointer_depth(selected) == depth) { return selected; }
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl && impl_target_pointer_depth(item) == depth) {
            SyntaxNode* target = impl_target_identifier(item);
            i64 count = 0;
            i64 generic = 0;
            if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0) {
                typecheck_count_block_methods(item, method_name, &count, &generic);
            }
            if (count > 0) { return item; }
        }
        item = item.next_sibling;
    }
    return selected;
}

/// Returns the type parameter `type_args` binds for a callee parameter
/// declared as `T`, `&T` or `T*`, or unknown. A literal argument does not
/// bind `T` during inference, so its own default type stands in here.
u32 typecheck_parameter_bound_type(AstPool* pool, TypeTable* types, CalleeTypeArgs* type_args,
                                   Binding* param, AstExpr* call, Vec<u32>* arg_types,
                                   i64 index) {
    if (binding_is_variadic_parameter(param) || index >= arg_types.len()) { return TYPE_UNKNOWN; }
    u32 declared = typecheck_parameter_type_id(types, param);
    TypeEntry* entry = types.get(declared);
    bool direct = true;
    while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
        direct = false;
        entry = types.get(entry.inner);
    }
    if (entry.kind != TypeKind.TypeParam && (entry.kind != TypeKind.Named || entry.count != 0)) {
        return TYPE_UNKNOWN;
    }
    i64 k = 0;
    while (k < type_args.params.len() && type_args.params.get(k) != entry.name_id) { k += 1; }
    if (k == type_args.params.len()) { return TYPE_UNKNOWN; }
    u32 bound = type_args.bound.get(k);
    u32 argument = arg_types.get(index);
    if (bound == TYPE_UNKNOWN && direct && type_is_primitive(argument)
        && expr_is_literal(pool, pool.args.get((i64)call.inner1 + index))) {
        return argument;
    }
    return bound;
}

/// Reports a generic call whose bound type lacks a method that the callee
/// body calls on a parameter of that type: `value.get()` with `T value`.
/// A parameter passed whole (`inner(value)` or `inner(&value)`) to another
/// generic function carries its type into that body. A call to a method
/// with its own type parameters is judged where the method is called.
void typecheck_generic_call_requirements(AstPool* pool, TypeTable* types, SyntaxNode* root,
                                         SyntaxNode* callee_fn, Vec<Binding>* params,
                                         CalleeTypeArgs* type_args, AstExpr* call,
                                         Vec<u32>* arg_types, DiagnosticBag* diagnostics,
                                         bool* ok) {
    Vec<u32> owners = Vec<u32>.new();
    i64 p = 0;
    while (p < params.len()) {
        owners.push(typecheck_method_owner_type(types, typecheck_parameter_bound_type(
            pool, types, type_args, params.get_ptr(p), call, arg_types, p)));
        p += 1;
    }
    Vec<str> reported = Vec<str>.new();
    typecheck_body_requirements(types, root, callee_fn, params, &owners, call.span, 0,
                                &reported, diagnostics, ok);
    reported.drop();
    owners.drop();
}

/// Checks the methods `function`'s body calls on each parameter whose
/// `owners` entry is a concrete type, reporting each missing method once
/// at the outer call's `span`.
void typecheck_body_requirements(TypeTable* types, SyntaxNode* root, SyntaxNode* function,
                                 Vec<Binding>* params, Vec<u32>* owners, Span span, i64 depth,
                                 Vec<str>* reported, DiagnosticBag* diagnostics, bool* ok) {
    SyntaxNode* body = function_body(function);
    // Recursive generic functions pass the same types around forever.
    if (body == (SyntaxNode*)0 || depth > 8) { return; }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    cfg_collect_leaves(body, &leaves);
    Vec<Binding> bindings = Vec<Binding>.new();
    collect_function_bindings(function, &bindings);
    i64 p = 0;
    while (p < params.len()) {
        str name = params.get_ptr(p).name;
        u32 owner_type = owners.get(p);
        i64 i = 0;
        while (owner_type != TYPE_UNKNOWN && i < leaves.len()) {
            SyntaxNode* receiver = leaves.get(i);
            bool parameter = strcmp(receiver.text, name) == 0
                && (i == 0 || !cfg_node_text(leaves.get(i - 1), "."));
            // A local of the same name shadows the parameter.
            if (parameter) {
                Binding* visible = visible_binding(&bindings, name, receiver);
                parameter = visible != (Binding*)0 && visible.kind == BindingKind.Parameter;
            }
            SyntaxNode* method = i + 2 < leaves.len() ? leaves.get(i + 2) : (SyntaxNode*)0;
            // Argument lists are `Parenthesized` nodes, not leaves. A `lock`
            // block's synthesized `.lock()` has an empty span; the lock
            // check reports a place that is not shared.
            bool method_call = parameter && method != (SyntaxNode*)0
                && cfg_node_text(leaves.get(i + 1), ".") && node_is_identifier(method)
                && method.span.end > method.span.start
                && method.next_sibling != (SyntaxNode*)0
                && method.next_sibling.kind == NodeKind.Parenthesized;
            i64 seen = 0;
            while (method_call && seen < reported.len()
                   && strcmp(reported.get(seen), method.text) != 0) {
                seen += 1;
            }
            MethodDeclarations found = { .own = 0, .generic = 0, .blanket = 0 };
            if (method_call && seen == reported.len()
                && typecheck_judged_methods(types, root, owner_type, method.text, &found)
                && found.own == 0) {
                diagnostics.error(span, generic_call_missing_method(
                    method.text, types.type_name(owner_type)));
                *ok = false;
                reported.push(method.text);
            }
            if (parameter && !method_call) {
                typecheck_forward_requirements(types, root, receiver, owner_type, span, depth,
                                               reported, diagnostics, ok);
            }
            i += 1;
        }
        p += 1;
    }
    bindings.drop();
    leaves.drop();
}

/// When parameter token `use` is a whole argument of a call to a generic
/// function (`inner(value)` or `inner(&value)`), checks that function's
/// body with `owner_type` bound to the matching parameter.
void typecheck_forward_requirements(TypeTable* types, SyntaxNode* root, SyntaxNode* use,
                                    u32 owner_type, Span span, i64 depth, Vec<str>* reported,
                                    DiagnosticBag* diagnostics, bool* ok) {
    SyntaxNode* group = use.parent;
    if (group == (SyntaxNode*)0 || group.kind != NodeKind.Parenthesized) { return; }
    // A method call (`.name(...)`) or a macro (`@name(...)`) is not a call
    // to the free function `name`.
    SyntaxNode* callee_name = binding_previous_sibling(group);
    SyntaxNode* before_callee = callee_name == (SyntaxNode*)0 ? (SyntaxNode*)0
        : binding_previous_sibling(callee_name);
    if (callee_name == (SyntaxNode*)0 || !node_is_identifier(callee_name)
        || cfg_node_text(before_callee, ".") || cfg_node_text(before_callee, "@")) {
        return;
    }
    SyntaxNode* before = binding_previous_sibling(use);
    if (cfg_node_text(before, "&")) { before = binding_previous_sibling(before); }
    if ((before != (SyntaxNode*)0 && !cfg_node_text(before, ","))
        || (use.next_sibling != (SyntaxNode*)0 && !cfg_node_text(use.next_sibling, ","))) {
        return;
    }
    i64 index = 0;
    SyntaxNode* child = group.first_child;
    while (child != use) {
        if (cfg_node_text(child, ",")) { index += 1; }
        child = child.next_sibling;
    }
    // Overloads would need argument types to pick the body.
    RootIndex* items = root_index(root);
    SyntaxNode* callee = (SyntaxNode*)0;
    i64 entry = items.find(callee_name.text);
    while (entry >= 0) {
        SyntaxNode* item = items.item(entry);
        entry = items.after(entry);
        if (item.kind == NodeKind.Function) {
            if (callee != (SyntaxNode*)0) { return; }
            callee = item;
        }
    }
    SyntaxNode* id = callee == (SyntaxNode*)0 ? (SyntaxNode*)0 : function_identifier(callee);
    if (id == (SyntaxNode*)0 || !typecheck_is_generic_function(callee)) { return; }
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(binding_function_parameters(callee), &params);
    Vec<u32> type_params = Vec<u32>.new();
    mono_collect_generic_parameters(id.next_sibling, types, &type_params);
    Vec<u32> owners = Vec<u32>.new();
    i64 p = 0;
    while (p < params.len()) {
        TypeEntry* entry_type = types.get(typecheck_parameter_type_id(types, params.get_ptr(p)));
        while (entry_type.kind == TypeKind.Pointer || entry_type.kind == TypeKind.Reference) {
            entry_type = types.get(entry_type.inner);
        }
        bool type_param = entry_type.kind == TypeKind.TypeParam
            || (entry_type.kind == TypeKind.Named && entry_type.count == 0);
        owners.push(p == index && !binding_is_variadic_parameter(params.get_ptr(p)) && type_param
            && mono_contains_type_param(&type_params, entry_type.name_id)
            ? owner_type : TYPE_UNKNOWN);
        p += 1;
    }
    typecheck_body_requirements(types, root, callee, &params, &owners, span, depth + 1,
                                reported, diagnostics, ok);
    owners.drop();
    type_params.drop();
    params.drop();
}

/// Returns the symbol of the method a call resolves to.
String typecheck_method_symbol_for_call(AstPool* pool, SyntaxNode* root,
                                        TypeTable* types, u32 receiver_type,
                                        str method_name, u32 args_start,
                                        bool static_method) {
    u32 resolved_receiver = types.resolve_subst(receiver_type);
    TypeEntry* receiver = types.get(resolved_receiver);
    while (receiver.kind == TypeKind.Pointer || receiver.kind == TypeKind.Reference) {
        resolved_receiver = receiver.inner;
        receiver = types.get(resolved_receiver);
    }
    if (receiver.kind != TypeKind.Named) {
        String fallback = String.from_str(types.type_name(resolved_receiver));
        fallback.push_str("__");
        fallback.push_str(method_name);
        return move fallback;
    }
    str owner_name = types.names.get(receiver.name_id);
    SyntaxNode* best_ret_start = (SyntaxNode*)0;
    SyntaxNode* best_name = (SyntaxNode*)0;
    SyntaxNode* best_params = typecheck_select_method(pool, root, types, resolved_receiver,
        owner_name, method_name, args_start, static_method, &best_ret_start, &best_name);
    if (best_params == (SyntaxNode*)0) {
        String fallback = String.from_str(owner_name);
        fallback.push_str("__");
        fallback.push_str(method_name);
        return move fallback;
    }
    return typecheck_method_symbol(types, owner_name, method_name,
                                   best_ret_start, best_name, best_params);
}

/// How a call passes one argument: by value, through a shared borrow, or
/// through a raw pointer or `&mut` borrow that may initialize its target.
enum ParameterMode { Value; Shared; Mutable; }

/// The mode in which the overload a call selects takes parameter
/// `parameter_index` (0 is `self` for an instance call). A method with no
/// local declaration that fits keeps the arity-based by-value answer.
ParameterMode typecheck_selected_parameter_mode(AstPool* pool, SyntaxNode* root, TypeTable* types,
                                                u32 receiver_type, str method_name,
                                                i64 param_count, u32 args_start,
                                                bool static_method, i64 parameter_index,
                                                u32 arg_type) {
    u32 resolved_receiver = types.resolve_subst(receiver_type);
    TypeEntry* receiver = types.get(resolved_receiver);
    while (receiver.kind == TypeKind.Pointer || receiver.kind == TypeKind.Reference) {
        resolved_receiver = receiver.inner;
        receiver = types.get(resolved_receiver);
    }
    SyntaxNode* params_node = (SyntaxNode*)0;
    if (receiver.kind == TypeKind.Named && args_start < (u32)pool.args.len()) {
        SyntaxNode* ret_start = (SyntaxNode*)0;
        SyntaxNode* name = (SyntaxNode*)0;
        params_node = typecheck_select_method(pool, root, types, resolved_receiver,
            types.names.get(receiver.name_id), method_name, args_start, static_method,
            &ret_start, &name);
    }
    if (params_node == (SyntaxNode*)0) {
        if (typecheck_method_parameter_is_value(root, types, receiver_type, method_name,
                                                param_count, parameter_index, arg_type)) {
            return ParameterMode.Value;
        }
        // A method known only from an imported artifact keeps its recorded mode.
        return receiver.kind == TypeKind.Named
            && types.method_param_is_mutable(types.names.get(receiver.name_id), method_name,
                                             param_count, parameter_index, arg_type)
            ? ParameterMode.Mutable : ParameterMode.Shared;
    }
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(params_node, &params);
    i64 index = parameter_index;
    // Trailing arguments fill a typed rest parameter; a bare `...` has none.
    if (index >= params.len() && params.len() > 0
        && binding_is_variadic_parameter(params.get_ptr(params.len() - 1))) {
        index = params.len() - 1;
    }
    ParameterMode mode = ParameterMode.Shared;
    if (index >= 0 && index < params.len()) {
        TypeProjection* declared = &params.get_ptr(index).declared_type;
        if (declared.kind == ProjectionTypeKind.Pointer
            || (declared.kind == ProjectionTypeKind.Reference && declared.is_mutable)) {
            mode = ParameterMode.Mutable;
        } else if (declared.kind != ProjectionTypeKind.Reference) {
            mode = ParameterMode.Value;
        }
    }
    params.drop();
    return mode;
}

/// Returns the return type of the method a call resolves to.
u32 typecheck_method_return_type_for_call(AstPool* pool, SyntaxNode* root,
                                          TypeTable* types, u32 receiver_type,
                                          str method_name, i64 param_count,
                                          u32 args_start, bool static_method) {
    u32 generic_result = typecheck_generic_method_type(pool, root, types,
        receiver_type, method_name, args_start, static_method, -1);
    if (generic_result != TYPE_UNKNOWN) { return generic_result; }
    u32 resolved_receiver = types.resolve_subst(receiver_type);
    TypeEntry* receiver = types.get(resolved_receiver);
    u32 receiver_depth = 0;
    while (receiver.kind == TypeKind.Pointer || receiver.kind == TypeKind.Reference) {
        resolved_receiver = receiver.inner;
        receiver_depth += 1;
        receiver = types.get(resolved_receiver);
    }
    if (receiver.kind != TypeKind.Named) { return TYPE_UNKNOWN; }
    str owner_name = types.names.get(receiver.name_id);
    u32 best_return_type = TYPE_UNKNOWN;
    i64 best_score = -1;
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0
                && impl_target_pointer_depth(item) == receiver_depth) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                SyntaxNode* member = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.first_child;
                while (member != (SyntaxNode*)0) {
                    if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Semicolon) {
                        member = member.next_sibling;
                        continue;
                    }
                    SyntaxNode* name = (SyntaxNode*)0;
                    SyntaxNode* params_node = (SyntaxNode*)0;
                    SyntaxNode* body = (SyntaxNode*)0;
                    SyntaxNode* scan = member;
                    while (scan != (SyntaxNode*)0) {
                        if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon) {
                            break;
                        }
                        if (scan.kind == NodeKind.Block) {
                            body = scan;
                            break;
                        }
                        if (scan.kind == NodeKind.Parenthesized) {
                            params_node = scan;
                            if (scan.next_sibling != (SyntaxNode*)0
                                && scan.next_sibling.kind == NodeKind.Block) {
                                body = scan.next_sibling;
                                break;
                            }
                        }
                        if (scan.kind == NodeKind.Token
                            && scan.token_kind == TokenKind.Identifier) {
                            name = scan;
                        }
                        scan = scan.next_sibling;
                    }
                    if (body != (SyntaxNode*)0 && name != (SyntaxNode*)0
                        && params_node != (SyntaxNode*)0
                        && strcmp(name.text, method_name) == 0) {
                        Vec<Binding> params = Vec<Binding>.new();
                        collect_parameter_bindings(params_node, &params);
                        bool matches_arity = binding_parameters_accept_arity(
                            &params, param_count);
                        bool matches_arguments = true;
                        i64 score = 0;
                        if (matches_arity && pool != (AstPool*)0) {
                            u32 arg_count = pool.args.get((i64)args_start);
                            i64 parameter_offset = static_method ? 0 : 1;
                            if (!binding_parameters_accept_arity(
                                    &params, (i64)arg_count + parameter_offset)) {
                                matches_arguments = false;
                            }
                            bool variadic = params.len() > 0
                                && binding_is_variadic_parameter(
                                    params.get_ptr(params.len() - 1));
                            i64 fixed_count = params.len() - (variadic ? 1 : 0);
                            i64 ai = 0;
                            while (matches_arguments && ai < (i64)arg_count) {
                                u32 arg_id = pool.args.get((i64)args_start + 1 + ai);
                                i64 parameter_index = parameter_offset + ai;
                                Binding* parameter = params.get_ptr(
                                    parameter_index < fixed_count
                                        ? parameter_index : (i64)(params.len() - 1));
                                u32 expected = variadic && parameter_index >= fixed_count
                                    ? typecheck_parameter_base_type_id(types, parameter)
                                    : typecheck_parameter_type_id(types, parameter);
                                expected = types.resolve_subst(expected);
                                if (!typecheck_method_argument_score(
                                        pool, types, root, resolved_receiver, arg_id,
                                        expected, &score)) {
                                    matches_arguments = false;
                                }
                                ai += 1;
                            }
                        }
                        if (matches_arity && matches_arguments) {
                            String return_text = String.new();
                            SyntaxNode* signature = member;
                            while (signature != name) {
                                if (signature.kind == NodeKind.Token
                                    && strcmp(signature.text, "pub") != 0
                                    && strcmp(signature.text, "static") != 0
                                    && strcmp(signature.text, "extern") != 0
                                    && strcmp(signature.text, "#") != 0) {
                                    return_text.push_str(signature.text);
                                }
                                signature = signature.next_sibling;
                            }
                            u32 return_type = strcmp(return_text.to_str(), "Self") == 0
                                ? types.resolve_subst(receiver_type)
                                : type_id_from_text(types, return_text.to_str());
                            return_text.drop();
                            u32 resolved_return = resolve_generic_member_type(
                                types, root, resolved_receiver, return_type);
                            if (score > best_score) {
                                best_score = score;
                                best_return_type = resolved_return;
                            }
                        }
                        params.drop();
                    }
                    member = body != (SyntaxNode*)0 ? body.next_sibling
                        : (scan != (SyntaxNode*)0 && scan.kind == NodeKind.Token
                           && scan.token_kind == TokenKind.Semicolon ? scan.next_sibling : scan);
                }
            }
        }
        item = item.next_sibling;
    }
    if (best_return_type == TYPE_UNKNOWN && receiver_depth > 0) {
        return typecheck_method_return_type_for_call(pool, root, types, resolved_receiver,
            method_name, param_count, args_start, static_method);
    }
    return best_return_type;
}

/// Returns the return type of `method_name` on `receiver_type`.
u32 typecheck_method_return_type(SyntaxNode* root, TypeTable* types,
                                 u32 receiver_type, str method_name,
                                 i64 param_count) {
    return typecheck_method_return_type_for_call((AstPool*)0, root, types,
        receiver_type, method_name, param_count, 0, false);
}

/// Returns the expected type of argument `index` of a method call.
u32 typecheck_method_parameter_type_for_call(AstPool* pool, SyntaxNode* root,
                                             TypeTable* types, u32 receiver_type,
                                             str method_name, i64 param_count,
                                             u32 args_start, bool static_method,
                                             i64 parameter_index,
                                             bool* out_variadic) {
    if (out_variadic != (bool*)0) { *out_variadic = false; }
    u32 generic_result = typecheck_generic_method_type(pool, root, types,
        receiver_type, method_name, args_start, static_method, parameter_index);
    if (generic_result != TYPE_UNKNOWN) { return generic_result; }
    u32 resolved_receiver = types.resolve_subst(receiver_type);
    TypeEntry* receiver = types.get(resolved_receiver);
    while (receiver.kind == TypeKind.Pointer || receiver.kind == TypeKind.Reference) {
        resolved_receiver = receiver.inner;
        receiver = types.get(resolved_receiver);
    }
    if (receiver.kind != TypeKind.Named) { return TYPE_UNKNOWN; }
    str owner_name = types.names.get(receiver.name_id);
    u32 best_parameter_type = TYPE_UNKNOWN;
    u32 fallback_parameter_type = TYPE_UNKNOWN;
    bool best_variadic = false;
    bool fallback_variadic = false;
    i64 best_score = -1;
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, owner_name) == 0) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                SyntaxNode* member = block == (SyntaxNode*)0 ? (SyntaxNode*)0 : block.first_child;
                while (member != (SyntaxNode*)0) {
                    if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Semicolon) {
                        member = member.next_sibling;
                        continue;
                    }
                    SyntaxNode* name = (SyntaxNode*)0;
                    SyntaxNode* params_node = (SyntaxNode*)0;
                    SyntaxNode* body = (SyntaxNode*)0;
                    SyntaxNode* scan = member;
                    while (scan != (SyntaxNode*)0) {
                        if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon) {
                            break;
                        }
                        if (scan.kind == NodeKind.Block) {
                            body = scan;
                            break;
                        }
                        if (scan.kind == NodeKind.Parenthesized) {
                            params_node = scan;
                            if (scan.next_sibling != (SyntaxNode*)0
                                && scan.next_sibling.kind == NodeKind.Block) {
                                body = scan.next_sibling;
                                break;
                            }
                        }
                        if (scan.kind == NodeKind.Token
                            && scan.token_kind == TokenKind.Identifier) {
                            name = scan;
                        }
                        scan = scan.next_sibling;
                    }
                    if (body != (SyntaxNode*)0 && name != (SyntaxNode*)0
                        && params_node != (SyntaxNode*)0
                        && strcmp(name.text, method_name) == 0) {
                        Vec<Binding> params = Vec<Binding>.new();
                        collect_parameter_bindings(params_node, &params);
                        bool variadic = params.len() > 0
                            && binding_is_variadic_parameter(
                                params.get_ptr(params.len() - 1));
                        i64 fixed_count = params.len() - (variadic ? 1 : 0);
                        bool accepts_arity = binding_parameters_accept_arity(
                            &params, param_count);
                        i64 resolved_parameter_index = parameter_index;
                        bool variadic_argument = variadic
                            && resolved_parameter_index >= fixed_count;
                        if (variadic_argument) {
                            resolved_parameter_index = params.len() - 1;
                        }
                        if (accepts_arity && resolved_parameter_index >= 0
                            && resolved_parameter_index < params.len()) {
                            Binding* parameter = params.get_ptr(resolved_parameter_index);
                            u32 raw_parameter_type = variadic_argument
                                ? typecheck_parameter_base_type_id(types, parameter)
                                : typecheck_parameter_type_id(types, parameter);
                            u32 parameter_type = resolve_generic_member_type(
                                types, root, resolved_receiver,
                                raw_parameter_type);
                            if (fallback_parameter_type == TYPE_UNKNOWN) {
                                fallback_parameter_type = parameter_type;
                                fallback_variadic = variadic;
                            }
                            bool matches_arguments = true;
                            i64 score = 0;
                            if (pool != (AstPool*)0) {
                                u32 arg_count = pool.args.get((i64)args_start);
                                i64 parameter_offset = static_method ? 0 : 1;
                                if (!binding_parameters_accept_arity(
                                        &params,
                                        (i64)arg_count + parameter_offset)) {
                                    matches_arguments = false;
                                }
                                i64 ai = 0;
                                while (matches_arguments && ai < (i64)arg_count) {
                                    u32 arg_id = pool.args.get((i64)args_start + 1 + ai);
                                    i64 arg_parameter_index = parameter_offset + ai;
                                    Binding* arg_parameter = params.get_ptr(
                                        arg_parameter_index < fixed_count
                                            ? arg_parameter_index : (i64)(params.len() - 1));
                                    u32 expected = variadic
                                        && arg_parameter_index >= fixed_count
                                        ? typecheck_parameter_base_type_id(types, arg_parameter)
                                        : typecheck_parameter_type_id(types, arg_parameter);
                                    if (!typecheck_method_argument_score(
                                            pool, types, root, resolved_receiver,
                                            arg_id, expected, &score)) {
                                        matches_arguments = false;
                                    }
                                    ai += 1;
                                }
                            }
                            if (matches_arguments && score > best_score) {
                                best_score = score;
                                best_parameter_type = parameter_type;
                                best_variadic = variadic;
                            }
                            params.drop();
                        } else {
                            params.drop();
                        }
                    }
                    member = body != (SyntaxNode*)0 ? body.next_sibling
                        : (scan != (SyntaxNode*)0 && scan.kind == NodeKind.Token
                           && scan.token_kind == TokenKind.Semicolon ? scan.next_sibling : scan);
                }
            }
        }
        item = item.next_sibling;
    }
    if (out_variadic != (bool*)0) {
        *out_variadic = best_parameter_type != TYPE_UNKNOWN
            ? best_variadic : fallback_variadic;
    }
    return best_parameter_type != TYPE_UNKNOWN
        ? best_parameter_type : fallback_parameter_type;
}

/// Returns the return type of a generic method call after inference.
u32 typecheck_generic_method_type(AstPool* pool, SyntaxNode* root, TypeTable* types,
                                  u32 receiver_type, str method_name, u32 args_start,
                                  bool static_method, i64 parameter_index) {
    if (pool == (AstPool*)0) { return TYPE_UNKNOWN; }
    MonoMethodTemplate template;
    Vec<u32> param_ids = Vec<u32>.new();
    Vec<u32> arg_ids = Vec<u32>.new();
    String failure = String.new();
    u32 result = TYPE_UNKNOWN;
    if (mono_resolve_generic_method(pool, root, types, receiver_type, method_name,
            args_start, static_method, &template, &param_ids, &arg_ids, &failure)
        && failure.len() == 0) {
        mono_push_method_bindings(types, &param_ids, &arg_ids);
        u32 self_id = types.names.intern("Self");
        u32 self_type = receiver_type;
        TypeEntry* receiver = types.get(self_type);
        while (receiver.kind == TypeKind.Pointer || receiver.kind == TypeKind.Reference) {
            self_type = receiver.inner;
            receiver = types.get(self_type);
        }
        u32 depth = 0;
        while (depth < template.receiver_depth) {
            self_type = types.get_pointer(self_type, true);
            depth += 1;
        }
        types.push_subst(self_id, self_type);
        if (parameter_index < 0) {
            result = typecheck_method_decl_return_type(types, template.ret_start, template.name_node);
        } else {
            Vec<Binding> params = Vec<Binding>.new();
            collect_parameter_bindings(template.params_node, &params);
            if (parameter_index < params.len()) {
                result = typecheck_parameter_type_id(types, params.get_ptr(parameter_index));
            }
            params.drop();
        }
        result = types.resolve_subst(result);
        types.pop_subst(receiver_binding_count(&param_ids, param_ids.len()) + 1);
    }
    failure.drop();
    param_ids.drop();
    arg_ids.drop();
    return result;
}

/// Returns the element slice type produced by slicing `target_type`.
u32 typecheck_slice_result_type(TypeTable* types, SyntaxNode* root, u32 target_type) {
    TypeEntry* target = types.get(types.resolve_subst(target_type));
    while (target.kind == TypeKind.Pointer || target.kind == TypeKind.Reference) {
        target_type = target.inner;
        target = types.get(types.resolve_subst(target_type));
    }
    if (target.kind == TypeKind.Array) {
        Vec<u32> args = Vec<u32>.new();
        args.push(types.resolve_subst(target.inner));
        u32 result = types.get_named_args("Slice", &args);
        args.drop();
        return result;
    }
    if (target.kind == TypeKind.Str) {
        Vec<u32> args = Vec<u32>.new();
        args.push(TYPE_U8);
        u32 result = types.get_named_args("Slice", &args);
        args.drop();
        return result;
    }
    return typecheck_method_return_type(root, types, target_type, "__slice_get", 3);
}

/// Infers and records the type of expression `expr_id`, reporting type
/// errors. Caches the result in the expression.
/// True when `type_id` is a Mutex<T>, directly or behind a reference: the
/// type a `shared T` is spelled as.
bool typecheck_is_mutex(TypeTable* types, u32 type_id) {
    if (type_id == TYPE_UNKNOWN) { return false; }
    TypeEntry* entry = types.get(types.resolve_subst(type_id));
    if (entry.kind == TypeKind.Reference) {
        entry = types.get(types.resolve_subst(entry.inner));
    }
    return entry.kind == TypeKind.Named && strcmp(types.names.get(entry.name_id), "Mutex") == 0;
}

/// The name for expression `expr_id` in a diagnostic: its variable name, or
/// "this value" for anything else.
str typecheck_operand_name(AstPool* pool, SymbolTable* symbols, u32 expr_id) {
    AstExpr* operand = pool.get_expr(expr_id);
    if (operand.kind == ExprKind.Var) { return symbols.names.get(operand.aux); }
    return "this value";
}

/// Reports a `lock` block whose place is not shared. sync_sugar lowers the
/// block to `{ let __lock_N_guard = place.lock(); ... }`; the statements are
/// `[start, start + count)`. Returns true when it reported one.
bool typecheck_lock_on_unshared(AstPool* pool, TypeTable* types, SymbolTable* symbols,
                                SyntaxNode* root, TypeEnv* env, u32 start, u32 count,
                                DiagnosticBag* diagnostics, bool* ok) {
    if (count < 2) { return false; }
    AstStmt* guard = pool.get_stmt(pool.block_stmts.get((i64)start));
    if (guard.kind != StmtKind.Let || guard.inner1 == 0
        || !typecheck_str_starts_with(symbols.names.get(guard.aux), "__lock_")) {
        return false;
    }
    AstExpr* call = pool.get_expr(guard.inner1);
    if (call.kind != ExprKind.MethodCall || strcmp(symbols.names.get(call.aux), "lock") != 0) {
        return false;
    }
    u32 place_type = infer_expr(pool, types, symbols, root, env, call.inner0, diagnostics, ok);
    if (place_type == TYPE_UNKNOWN) {
        place_type = typecheck_place_type(pool, types, symbols, root, env, call.inner0);
    }
    if (place_type == TYPE_UNKNOWN) { return false; }
    // `.lock()` reaches a Mutex through a reference or a pointer.
    TypeEntry* entry = types.get(types.resolve_subst(place_type));
    if (entry.kind == TypeKind.Reference || entry.kind == TypeKind.Pointer) { place_type = entry.inner; }
    if (typecheck_is_mutex(types, place_type)) { return false; }
    // A generic body's `T` is judged per instantiation by the ownership probes.
    if (typecheck_is_opaque_name(types, place_type)
        && find_enum_item(root, types.type_name(place_type)) == (SyntaxNode*)0) {
        return false;
    }
    Vec<u32> fields = Vec<u32>.new();
    u32 root_name = typecheck_collect_place(pool, call.inner0, &fields);
    String place = String.from_str(root_name == 0 ? "this value" : "`");
    if (root_name != 0) {
        place.push_str(symbols.names.get(root_name));
        i64 i = 0;
        while (i < fields.len()) {
            place.push('.');
            place.push_str(symbols.names.get(fields.get(i)));
            i += 1;
        }
        place.push('`');
    }
    diagnostics.error(pool.get_expr(call.inner0).span,
                      lock_needs_shared(place.to_str(), types.type_name(place_type)));
    *ok = false;
    return true;
}

u32 infer_expr(AstPool* pool, TypeTable* types, SymbolTable* symbols, SyntaxNode* root,
               TypeEnv* env, u32 expr_id, DiagnosticBag* diagnostics, bool* ok) {
    if (expr_id == 0) { return TYPE_UNKNOWN; }
    AstExpr* expr = pool.get_expr(expr_id);
    if (expr.inferred_type != TYPE_UNKNOWN) {
        return expr.inferred_type;
    }
    if (env.expression_depth >= MAX_TYPE_CHECK_DEPTH) {
        String message = String.from_str("type-check expression nesting exceeds maximum depth (256)");
        diagnostics.error(expr.span, move message);
        *ok = false;
        return TYPE_UNKNOWN;
    }
    env.expression_depth += 1;

    u32 inferred = TYPE_UNKNOWN;
    if (expr.kind == ExprKind.Literal) {
        inferred = expr.aux;
    } else if (expr.kind == ExprKind.Var) {
        inferred = env.lookup(expr.aux);
        if (inferred == TYPE_UNKNOWN) {
            str var_name = symbols.names.get(expr.aux);
            if (callback_abi_function_value_unsupported(root, types, var_name)
                || callback_abi_imported_function_value_unsupported(root, types, symbols, var_name)) {
                diagnostics.error(expr.span, c_function_value_unsupported());
                *ok = false;
            }
            inferred = symbols.get_type(var_name);
        }
        if (inferred == TYPE_UNKNOWN) {
            str var_name = symbols.names.get(expr.aux);
            if (strlen(var_name) > 0 && var_name[0] >= (u8)65 && var_name[0] <= (u8)90) {
                SyntaxNode* enum_item = (SyntaxNode*)0;
                if (find_variant_enum(root, var_name, &enum_item)) {
                    SyntaxNode* enum_id = item_identifier(enum_item);
                    if (enum_id != (SyntaxNode*)0) {
                        i64 tag = 0;
                        i64 arity = 0;
                        if (enum_variant_info(root, enum_id.text, var_name, &tag, &arity) && arity == 0) {
                            inferred = types.get_named(enum_id.text);
                        }
                    }
                }
            }
        }
    } else if (expr.kind == ExprKind.Move) {
        if (expr.inner0 != 0) {
            inferred = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
            typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                               expr.inner0, diagnostics, ok);
        } else {
            inferred = env.lookup(expr.aux);
        }
    } else if (expr.kind == ExprKind.Launch) {
        u32 enclosing_launch = env.launched_call;
        env.launched_call = expr.inner0;
        u32 result_type = infer_expr(pool, types, symbols, root, env,
                                     expr.inner0, diagnostics, ok);
        env.launched_call = enclosing_launch;
        if (result_type != TYPE_UNKNOWN) {
            Vec<u32> task_args = Vec<u32>.new();
            task_args.push(result_type);
            inferred = types.get_named_args("Task", &task_args);
            task_args.drop();
        }
    } else if (expr.kind == ExprKind.Wait) {
        u32 task_type = infer_expr(pool, types, symbols, root, env,
                                   expr.inner0, diagnostics, ok);
        TypeEntry* task_entry = types.get(task_type);
        if (task_entry.kind == TypeKind.Named
            && strcmp(types.names.get(task_entry.name_id), "Task") == 0
            && task_entry.count == 1) {
            inferred = types.type_args.get(task_entry.inner);
        } else if (task_type != TYPE_UNKNOWN) {
            diagnostics.error(expr.span, String.from_str("wait operand must have type Task<T>"));
            *ok = false;
        }
    } else if (expr.kind == ExprKind.SizeOf) {
        inferred = TYPE_I64;
    } else if (expr.kind == ExprKind.AlignOf) {
        inferred = TYPE_U64;
    } else if (expr.kind == ExprKind.Cast) {
        infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        inferred = expr.aux;
    } else if (expr.kind == ExprKind.Format) {
        i64 arg_index = 0;
        while (arg_index < (i64)expr.aux) {
            u32 arg_id = pool.args.get((i64)expr.inner1 + arg_index);
            infer_expr(pool, types, symbols, root, env, arg_id, diagnostics, ok);
            arg_index += 1;
        }
        inferred = types.get_named("String");
    } else if (expr.kind == ExprKind.Fprint) {
        u32 writer_type = infer_expr(pool, types, symbols, root, env,
                                     expr.inner0, diagnostics, ok);
        infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
        if (writer_type != TYPE_UNKNOWN) {
            TypeEntry* writer_entry = types.get(writer_type);
            // `@println` writes through the `STDOUT` global itself.
            bool writer_place = pool.get_expr(expr.inner0).kind == ExprKind.Var
                && strcmp(types.type_name(writer_type), "BufWriter") == 0;
            if (!writer_place && (writer_entry.kind != TypeKind.Pointer
                || strcmp(types.type_name(writer_entry.inner), "BufWriter") != 0)) {
                diagnostics.error(expr.span,
                    String.from_str("@fprint expects a BufWriter* as its first argument"));
                *ok = false;
            }
        }
        inferred = TYPE_VOID;
    } else if (expr.kind == ExprKind.Assert) {
        if (expr.aux != 0) {
            u32 condition_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
            if (condition_type != TYPE_BOOL && condition_type != TYPE_UNKNOWN) {
                diagnostics.error(expr.span, String.from_str("@assert condition must be bool"));
                *ok = false;
            }
            u32 message_type = infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
            if (message_type != TYPE_STR && message_type != TYPE_UNKNOWN
                && message_type != types.get_named("String")) {
                diagnostics.error(expr.span, String.from_str("@assert message must be str"));
                *ok = false;
            }
        }
        inferred = TYPE_VOID;
    } else if (expr.kind == ExprKind.Hash) {
        infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        inferred = TYPE_I64;
    } else if (expr.kind == ExprKind.DropInPlace) {
        infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
        inferred = TYPE_I64;
    } else if (expr.kind == ExprKind.StructLit) {
        i64 field_index = 0;
        while (field_index < (i64)expr.aux) {
            u32 val_id = pool.args.get((i64)expr.inner1 + field_index * 2 + 1);
            infer_expr(pool, types, symbols, root, env, val_id, diagnostics, ok);
            if (pool.get_expr(val_id).kind != ExprKind.Move) {
                typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                   val_id, diagnostics, ok);
            }
            field_index += 1;
        }
        inferred = types.get_named(symbols.names.get(expr.inner0));
    } else if (expr.kind == ExprKind.Asm) {
        AstAsm* asm_info = pool.asms.get_ptr((i64)expr.aux);
        i64 i = 0;
        while (i < (i64)asm_info.args_count) {
            u32 arg_id = pool.args.get((i64)asm_info.args_start + i);
            infer_expr(pool, types, symbols, root, env, arg_id, diagnostics, ok);
            i += 1;
        }
        inferred = TYPE_I64;
    } else if (expr.kind == ExprKind.MemoryBuiltin) {
        u32 args_start = expr.inner0;
        inferred = infer_expr(pool, types, symbols, root, env,
                              pool.args.get((i64)args_start), diagnostics, ok);
        i64 arg_index = 1;
        while (arg_index < 3) {
            infer_expr(pool, types, symbols, root, env,
                       pool.args.get((i64)args_start + arg_index), diagnostics, ok);
            arg_index += 1;
        }
    } else if (expr.kind == ExprKind.Unary) {
        u32 op = expr.aux;
        u32 op_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        if (op == (u32)TokenKind.Not) {
            inferred = TYPE_BOOL;
        } else if (op == (u32)TokenKind.BitwiseAnd) {
            inferred = types.get_reference(op_type, false);
        } else if (op == (u32)TokenKind.Star) {
            TypeEntry* entry = types.get(op_type);
            if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                inferred = entry.inner;
            } else {
                inferred = op_type;
            }
        } else {
            inferred = op_type;
        }
    } else if (expr.kind == ExprKind.Binary) {
        u32 op = expr.aux;
        u32 lhs = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        u32 rhs = infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
        if (typecheck_is_mutex(types, lhs) || typecheck_is_mutex(types, rhs)) {
            // A `shared T` is a Mutex<T>: its value is reached only by locking it.
            u32 operand = typecheck_is_mutex(types, lhs) ? expr.inner0 : expr.inner1;
            diagnostics.error(expr.span, shared_value_outside_lock(
                typecheck_operand_name(pool, symbols, operand)));
            *ok = false;
        } else if (op == (u32)TokenKind.Equal || op == (u32)TokenKind.NotEqual
            || op == (u32)TokenKind.Less || op == (u32)TokenKind.LessEqual
            || op == (u32)TokenKind.Greater || op == (u32)TokenKind.GreaterEqual
            || op == (u32)TokenKind.And || op == (u32)TokenKind.Or) {
            inferred = TYPE_BOOL;
        } else {
            inferred = common_numeric_type(lhs, rhs);
        }
    } else if (expr.kind == ExprKind.Block) {
        u32 block_start = expr.inner0;
        u32 block_count = expr.inner1;
        u32 result_expr = expr.aux;
        TypeEnv block_env = env.child();
        // Its locals shadow a locked name only inside it, as in a statement block.
        i64 locked_mark = pool.locked_bindings.len();
        i64 stmt_index = 0;
        while (stmt_index < (i64)block_count) {
            u32 stmt_id = pool.block_stmts.get((i64)block_start + stmt_index);
            typecheck_statement(pool, types, symbols, root, &block_env,
                                block_env.expected_return, stmt_id, diagnostics, ok);
            stmt_index += 1;
        }
        inferred = infer_expr(pool, types, symbols, root, &block_env,
                              result_expr, diagnostics, ok);
        typecheck_reject_partial_drop_move(pool, types, symbols, root, &block_env,
                                           result_expr, diagnostics, ok);
        while (pool.locked_bindings.len() > locked_mark) { pool.locked_bindings.pop(); }
        block_env.locals.drop();
    } else if (expr.kind == ExprKind.Ternary) {
        u32 cond_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        u32 then_type = infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
        u32 else_type = infer_expr(pool, types, symbols, root, env, expr.aux, diagnostics, ok);
        if (cond_type != TYPE_UNKNOWN && cond_type != TYPE_BOOL) {
            String message = String.from_str("type mismatch: ternary condition must be bool, found ");
            message.push_str(types.type_name(cond_type));
            diagnostics.error(pool.get_expr(expr.inner0).span, move message);
            *ok = false;
        }
        // A literal condition folds to the taken branch, mirroring stage0.
        AstExpr* cond = pool.get_expr(expr.inner0);
        if (cond.kind == ExprKind.Literal && cond.inferred_type == TYPE_BOOL) {
            str text = symbols.names.get(cond.inner0);
            if (strcmp(text, "true") == 0) {
                inferred = then_type;
            } else if (strcmp(text, "false") == 0) {
                inferred = else_type;
            }
        }
        if (inferred == TYPE_UNKNOWN) {
            if (then_type != TYPE_UNKNOWN && else_type != TYPE_UNKNOWN
                && !types_match_value(types, then_type, else_type, expr_is_literal(pool, expr.aux))) {
                String message = String.from_str("type mismatch in ternary branches: ");
                message.push_str(types.type_name(then_type));
                message.push_str(" vs ");
                message.push_str(types.type_name(else_type));
                diagnostics.error(expr.span, move message);
                *ok = false;
            }
            inferred = (then_type == TYPE_UNKNOWN) ? else_type : then_type;
        }
    } else if (expr.kind == ExprKind.UnwrapOr) {
        // A missing operand means the CST had a dangling `?` (stage0
        // rejects this at parse time as "expected expression"). Fail the
        // expression here so `check` can report it; the backend also
        // refuses to emit operand-less nodes.
        if (expr.inner0 == 0 || expr.inner1 == 0) {
            String message = String.from_str("expected expression");
            diagnostics.error(expr.span, move message);
            *ok = false;
        } else {
            u32 unwrap_value_ty = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
            u32 unwrap_target_ty = TYPE_UNKNOWN;
            bool unwrap_has_target = false;
            if (unwrap_value_ty != TYPE_UNKNOWN) {
                TypeEntry* unwrap_entry = types.get(unwrap_value_ty);
                if (unwrap_entry.kind == TypeKind.Pointer) {
                    unwrap_target_ty = unwrap_value_ty;
                    unwrap_has_target = true;
                } else if (unwrap_entry.kind == TypeKind.Named && unwrap_entry.count > 0) {
                    str unwrap_base = types.names.get(unwrap_entry.name_id);
                    if (strcmp(unwrap_base, "Optional") == 0 || strcmp(unwrap_base, "Result") == 0
                        || strcmp(unwrap_base, "SysResult") == 0) {
                        unwrap_target_ty = types.resolve_subst(types.type_args.get(unwrap_entry.inner));
                        unwrap_has_target = true;
                    }
                }
            }
            u32 unwrap_fallback_ty = infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
            if (unwrap_has_target) {
                if (unwrap_fallback_ty != TYPE_UNKNOWN
                    && !types_match_value(types, unwrap_target_ty, unwrap_fallback_ty, expr_is_literal(pool, expr.inner1))) {
                    String message = String.from_str("unwrap-or fallback type mismatch: expected ");
                    message.push_str(types.type_name(unwrap_target_ty));
                    message.push_str(", found ");
                    message.push_str(types.type_name(unwrap_fallback_ty));
                    diagnostics.error(pool.get_expr(expr.inner1).span, move message);
                    *ok = false;
                }
                inferred = unwrap_target_ty;
            } else if (unwrap_value_ty != TYPE_UNKNOWN) {
                String message = String.from_str("unwrap-or operator '?' requires Optional, Result, or pointer on left-hand side, found ");
                message.push_str(types.type_name(unwrap_value_ty));
                diagnostics.error(pool.get_expr(expr.inner0).span, move message);
                *ok = false;
            }
        }
    } else if (expr.kind == ExprKind.Match) {
        u32 scrut_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        // The shared value keeps owning a locked scrutinee's payload.
        bool locked = typecheck_reads_locked_value(pool, symbols, expr.inner0);
        str scrut_enum = "";
        if (scrut_type != TYPE_UNKNOWN) {
            TypeEntry* scrut_entry = types.get(scrut_type);
            if (scrut_entry.kind == TypeKind.Named) {
                scrut_enum = types.names.get(scrut_entry.name_id);
            }
        }
        u32 result_type = TYPE_UNKNOWN;
        bool has_wildcard = false;
        Vec<i64> covered = Vec<i64>.new();
        i64 arm_index = 0;
        while (arm_index < (i64)expr.aux) {
            MatchArm* arm = pool.get_arm(expr.inner1 + (u32)arm_index);
            TypeEnv arm_env = env.child();
            str arm_enum = scrut_enum;
            if (arm.pattern == MatchPatternKind.Variant) {
                str variant = symbols.names.get(arm.variant_name_id);
                if (strlen(arm_enum) == 0) {
                    SyntaxNode* found_item = (SyntaxNode*)0;
                    if (!find_variant_enum(root, variant, &found_item)) {
                        String message = String.from_str("unknown variant '");
                        message.push_str(variant);
                        message.push_str("'");
                        diagnostics.error(arm.span, move message);
                        *ok = false;
                    } else {
                        SyntaxNode* enum_id = item_identifier(found_item);
                        if (enum_id != (SyntaxNode*)0) {
                            arm_enum = enum_id.text;
                        }
                    }
                }
                if (strlen(arm_enum) > 0) {
                    i64 tag = 0;
                    i64 arity = 0;
                    if (!enum_variant_info(root, arm_enum, variant, &tag, &arity)) {
                        String message = String.from_str("unknown variant '");
                        message.push_str(variant);
                        message.push_str("'");
                        diagnostics.error(arm.span, move message);
                        *ok = false;
                    } else {
                        if (arity != (i64)arm.bindings_count) {
                            String message = String.from_str("pattern binding count mismatch for '");
                            message.push_str(variant);
                            message.push_str("'");
                            diagnostics.error(arm.span, move message);
                            *ok = false;
                        }
                        i64 binding_index = 0;
                        while (binding_index < (i64)arm.bindings_count) {
                            u32 binding_name = pool.arm_bindings.get((i64)arm.bindings_start + binding_index);
                            String payload_text = String.new();
                            u32 payload_type = TYPE_UNKNOWN;
                            if (enum_payload_type_text(root, arm_enum, variant, binding_index, &payload_text)) {
                                payload_type = type_id_from_text(types, payload_text.to_str());
                                if (scrut_type != TYPE_UNKNOWN) {
                                    payload_type = resolve_generic_member_type(types, root, scrut_type, payload_type);
                                }
                            }
                            payload_text.drop();
                            arm_env.insert(binding_name, payload_type);
                            i64 slot = (i64)arm.bindings_start + binding_index;
                            while (pool.arm_binding_types.len() <= slot) {
                                pool.arm_binding_types.push(TYPE_UNKNOWN);
                            }
                            pool.arm_binding_types.set(slot, payload_type);
                            binding_index += 1;
                        }
                        bool seen_tag = false;
                        i64 covered_index = 0;
                        while (covered_index < covered.len()) {
                            if (covered.get(covered_index) == tag) {
                                seen_tag = true;
                            }
                            covered_index += 1;
                        }
                        if (!seen_tag) {
                            covered.push(tag);
                        }
                    }
                }
            } else if (arm.pattern == MatchPatternKind.Binding) {
                u32 binding_name = pool.arm_bindings.get((i64)arm.bindings_start);
                arm_env.insert(binding_name, scrut_type);
                has_wildcard = true;
            } else if (arm.pattern == MatchPatternKind.Wildcard) {
                has_wildcard = true;
            } else if (arm.pattern == MatchPatternKind.Literal) {
                if (strlen(scrut_enum) > 0) {
                    String message = String.from_str("type mismatch: literal pattern on enum scrutinee");
                    diagnostics.error(arm.span, move message);
                    *ok = false;
                }
            }
            i64 locked_mark = pool.locked_bindings.len();
            typecheck_push_arm_bindings(pool, arm, locked);
            if (arm.guard_id != 0) {
                u32 guard_type = infer_expr(pool, types, symbols, root, &arm_env, arm.guard_id, diagnostics, ok);
                if (guard_type != TYPE_UNKNOWN && guard_type != TYPE_BOOL) {
                    String message = String.from_str("type mismatch: match guard must be bool, found ");
                    message.push_str(types.type_name(guard_type));
                    diagnostics.error(pool.get_expr(arm.guard_id).span, move message);
                    *ok = false;
                }
            }
            u32 arm_type = TYPE_VOID;
            if (arm.body_stmt_id != 0) {
                typecheck_statement(pool, types, symbols, root, &arm_env,
                                    arm_env.expected_return, arm.body_stmt_id,
                                    diagnostics, ok);
            } else {
                arm_type = infer_expr(pool, types, symbols, root, &arm_env,
                                      arm.value_id, diagnostics, ok);
                // The arm's result is consumed even when the match is a
                // statement, so an aggregate cannot hold its locked payloads.
                // A bare payload is reported below.
                if (pool.get_expr(arm.value_id).kind == ExprKind.ArrayLit) {
                    typecheck_reject_locked_move(pool, types, symbols, root, arm.value_id,
                                                 diagnostics, ok);
                }
            }
            while (pool.locked_bindings.len() > locked_mark) { pool.locked_bindings.pop(); }
            u32 moved = locked ? typecheck_arm_moved_binding(pool, types, root, arm) : 0;
            if (moved != 0) {
                diagnostics.error(arm.span, move_out_of_lock(symbols.names.get(moved)));
                *ok = false;
            }
            if (result_type == TYPE_UNKNOWN) {
                result_type = arm_type;
            } else if (arm_type != TYPE_UNKNOWN && !types_match_value(types, result_type, arm_type,
                         arm.body_stmt_id == 0 && expr_is_literal(pool, arm.value_id))) {
                String message = String.from_str("type mismatch in match arms: ");
                message.push_str(types.type_name(result_type));
                message.push_str(" vs ");
                message.push_str(types.type_name(arm_type));
                Span arm_span = arm.body_stmt_id != 0 ? arm.span : pool.get_expr(arm.value_id).span;
                diagnostics.error(arm_span, move message);
                *ok = false;
            }
            arm_env.locals.drop();
            arm_index += 1;
        }
        if (!has_wildcard && strlen(scrut_enum) > 0) {
            i64 total = enum_variant_count(root, scrut_enum);
            if (total >= 0 && covered.len() < total) {
                String message = String.from_str("non-exhaustive match on '");
                message.push_str(scrut_enum);
                message.push_str("'");
                diagnostics.error(expr.span, move message);
                *ok = false;
            }
        }
        covered.drop();
        inferred = result_type;
    } else if (expr.kind == ExprKind.Call) {
        AstExpr* callee = pool.get_expr(expr.inner0);
        bool direct_c_call = callee.kind == ExprKind.Var
            && env.lookup(callee.aux) == TYPE_UNKNOWN
            && item_is_c_extern_function(root, symbols.names.get(callee.aux));
        if (callee.kind == ExprKind.Var && env.lookup(callee.aux) == TYPE_UNKNOWN) {
            i64 symbol_index = symbols.find(symbols.names.get(callee.aux));
            if (symbol_index >= 0 && symbols.get(symbol_index).c_abi) { direct_c_call = true; }
        }
        u32 callable_type = direct_c_call ? symbols.get_type(symbols.names.get(callee.aux))
            : infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        TypeEntry* callable_entry = types.get(callable_type);
        while (callable_entry.kind == TypeKind.Pointer || callable_entry.kind == TypeKind.Reference) {
            callable_type = callable_entry.inner;
            callable_entry = types.get(callable_type);
        }
        TypeKind callable_kind = callable_entry.kind;
        u32 callable_inner = callable_entry.inner;
        i64 callable_count = callable_entry.count;
        bool named_function = callee.kind == ExprKind.Var
            && find_function_by_name(root, symbols.names.get(callee.aux)) != (SyntaxNode*)0;
        if (callable_kind == TypeKind.Function && !named_function) {
            u32 arg_count = expr.aux;
            i64 i = 0;
            while (i < (i64)arg_count && i < callable_count) {
                u32 parameter_type = types.type_args.get(callable_inner + 1 + (u32)i);
                TypeEntry* parameter_entry = types.get(parameter_type);
                TypeKind parameter_kind = parameter_entry.kind;
                u32 arg_id = pool.args.get((i64)expr.inner1 + i);
                u32 actual_type = infer_expr(pool, types, symbols, root, env, arg_id, diagnostics, ok);
                typecheck_char_pointer_argument(types, parameter_type, actual_type,
                    pool.get_expr(arg_id).span, diagnostics, ok);
                if (parameter_kind == TypeKind.Pointer) { pool.mutable_borrows.set((i64)arg_id); }
                if (parameter_kind != TypeKind.Pointer
                    && parameter_kind != TypeKind.Reference
                    && pool.get_expr(arg_id).kind != ExprKind.Move) {
                    typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                       arg_id, diagnostics, ok);
                }
                i += 1;
            }
            inferred = types.type_args.get(callable_inner);
        }
        if (callee.kind == ExprKind.Var) {
            str callee_name = symbols.names.get(callee.aux);
            if (typecheck_str_starts_with(callee_name, "__atomic_")) {
                inferred = TYPE_UNKNOWN;
                return inferred;
            }
            if (strcmp(callee_name, "alloc") == 0 || strcmp(callee_name, "realloc") == 0) {
                if (expr.generic_args_count > 0) {
                    u32 elem_type = pool.generic_type_args.get((i64)expr.generic_args_start);
                    inferred = types.get_pointer(elem_type, false);
                    expr.inferred_type = inferred;
                    return inferred;
                }
                inferred = types.get_pointer(TYPE_VOID, false);
                expr.inferred_type = inferred;
                return inferred;
            }
            if (strcmp(callee_name, "Ok") == 0 || strcmp(callee_name, "Err") == 0) {
                inferred = types.get_named("Result");
                expr.inferred_type = inferred;
                return inferred;
            }
            bool overloaded = false;
            bool ambiguous = false;
            bool no_match = false;
            u32 resolved_symbol_id = 0;
            SyntaxNode* callee_fn = typecheck_resolve_free_function(
                pool, types, symbols, root, env, callee_name, expr, diagnostics, ok,
                &overloaded, &ambiguous, &no_match, &resolved_symbol_id);
            if (ambiguous || no_match) {
                String message = ambiguous
                    ? String.from_str("call to overloaded function '")
                    : String.from_str("no overload of '");
                message.push_str(callee_name);
                message.push_str(ambiguous ? "' is ambiguous" : "' matches these arguments");
                diagnostics.error(expr.span, move message);
                *ok = false;
            } else if (callee_fn != (SyntaxNode*)0) {
                if (overloaded) { expr.resolved_callee_id = resolved_symbol_id + 1; }
                // The borrow and Send passes judge the call by this overload.
                // Initializer re-checks with partial locals can choose another,
                // so only a choice made from known argument types counts.
                if (overloaded && typecheck_arguments_known(pool, expr)) {
                    symbols.select_callee(callee.span, callee_fn);
                }
                bool generic_callee = typecheck_is_generic_function(callee_fn);
                u32 ret_type = function_return_type_id(types, callee_fn);
                inferred = ret_type;

                // Check argument count & types
                Vec<Binding> params = Vec<Binding>.new();
                collect_parameter_bindings(binding_function_parameters(callee_fn), &params);
                u32 args_count = expr.aux;
                // Arguments are inferred before the callee's type parameters
                // are bound, so a caller's own `T` is never shadowed.
                Vec<u32> arg_types = Vec<u32>.new();
                i64 arg_index = 0;
                while (arg_index < (i64)args_count) {
                    arg_types.push(infer_expr(pool, types, symbols, root, env,
                        pool.args.get((i64)expr.inner1 + arg_index), diagnostics, ok));
                    arg_index += 1;
                }
                CalleeTypeArgs type_args = typecheck_callee_type_args(
                    pool, types, callee_fn, expr, &params, &arg_types);
                if (generic_callee) { inferred = type_args.resolve(types, ret_type); }
                // A mismatched count would otherwise fall back to inference
                // and ignore the written type arguments.
                if (expr.generic_args_count > 0
                    && (i64)expr.generic_args_count != type_args.params.len()) {
                    diagnostics.error(expr.span, type_argument_count_mismatch(callee_name,
                        type_args.params.len(), (i64)expr.generic_args_count));
                    *ok = false;
                }
                bool variadic = params.len() > 0
                    && binding_is_variadic_parameter(params.get_ptr(params.len() - 1));
                i64 fixed_count = params.len() - (variadic ? 1 : 0);
                bool valid_arity = binding_parameters_accept_arity(&params, (i64)args_count);
                if (!valid_arity) {
                    String message = variadic
                        ? String.from_str("argument count mismatch: expected at least ")
                        : String.from_str("argument count mismatch: expected ");
                    i64 expected_count = variadic ? fixed_count : params.len();
                    message.push_display(&expected_count);
                    message.push_str(", found ");
                    i64 actual_count = (i64)args_count;
                    message.push_display(&actual_count);
                    diagnostics.error(expr.span, move message);
                    *ok = false;
                } else {
                    i64 i = 0;
                    while (i < (i64)args_count) {
                        i64 parameter_index = i < fixed_count ? i : params.len() - 1;
                        Binding* param = params.get_ptr(parameter_index);
                        u32 expected_arg_type = type_args.resolve(types,
                            variadic && i >= fixed_count
                                ? typecheck_parameter_base_type_id(types, param)
                                : typecheck_parameter_type_id(types, param));
                        u32 arg_expr_id = pool.args.get((i64)expr.inner1 + i);
                        u32 actual_arg_type = arg_types.get(i);
                        typecheck_char_pointer_argument(types, expected_arg_type, actual_arg_type,
                            pool.get_expr(arg_expr_id).span, diagnostics, ok);
                        TypeEntry* expected_entry = types.get(expected_arg_type);
                        TypeEntry* actual_entry = types.get(types.resolve_subst(actual_arg_type));
                        if (expected_entry.kind == TypeKind.Pointer) {
                            pool.mutable_borrows.set((i64)arg_expr_id);
                        }
                        if (expected_entry.kind != TypeKind.Pointer
                            && expected_entry.kind != TypeKind.Reference
                            && pool.get_expr(arg_expr_id).kind != ExprKind.Move
                            && !typecheck_coerces_to_view(types, expected_arg_type, actual_arg_type)) {
                            typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                               arg_expr_id, diagnostics, ok);
                        }
                        // The launch pass reports a bare local or parameter for a
                        // reference parameter of a launched call with the
                        // scoped-launch rules; any other argument is checked here.
                        AstExpr* argument = pool.get_expr(arg_expr_id);
                        bool launch_borrow = env.launched_call == expr_id
                            && expected_entry.kind == TypeKind.Reference
                            && actual_entry.kind != TypeKind.Pointer
                            && actual_entry.kind != TypeKind.Reference
                            && argument.kind == ExprKind.Var
                            && env.lookup(argument.aux) != TYPE_UNKNOWN;
                        if (launch_borrow) {
                            i += 1;
                            continue;
                        }
                        if (!generic_callee
                            && typecheck_reference_argument_mismatch(
                                types, expected_arg_type, actual_arg_type)
                            && !typecheck_implicit_cast(root, types, actual_arg_type, expected_arg_type)) {
                            diagnostics.error(pool.get_expr(arg_expr_id).span,
                                reference_argument_mismatch(types.type_name(expected_arg_type),
                                    types.type_name(actual_arg_type)));
                            *ok = false;
                        } else if (!typecheck_call_argument_matches(
                                types, expected_arg_type, actual_arg_type,
                                expr_is_literal(pool, arg_expr_id))
                            && !typecheck_implicit_borrow(types, expected_arg_type, actual_arg_type,
                                expr_is_literal(pool, arg_expr_id))
                            && !typecheck_tuple_literal_fits(pool, root, types, expected_arg_type, arg_expr_id)
                            && !typecheck_implicit_cast(root, types, actual_arg_type, expected_arg_type)) {
                            diagnostics.error(pool.get_expr(arg_expr_id).span,
                                argument_type_mismatch(i + 1, types.type_name(expected_arg_type),
                                    types.type_name(actual_arg_type)));
                            *ok = false;
                        }
                        i += 1;
                    }
                }
                if (valid_arity && generic_callee) {
                    typecheck_generic_call_requirements(pool, types, root, callee_fn, &params,
                        &type_args, expr, &arg_types, diagnostics, ok);
                }
                params.drop();
                if (valid_arity && !variadic && generic_callee) {
                    typecheck_generic_call_drop_ownership(
                        pool, types, symbols, root, env, callee_fn,
                        expr_id, diagnostics, ok);
                }
            } else if (overloaded) {
                inferred = TYPE_UNKNOWN;
            } else if (strlen(callee_name) > 0 && callee_name[0] >= (u8)65 && callee_name[0] <= (u8)90) {
                SyntaxNode* enum_item = (SyntaxNode*)0;
                if (!find_variant_enum(root, callee_name, &enum_item)
                    && symbols.find(callee_name) < 0) {
                    Vec<str> type_names = Vec<str>.new();
                    i64 symbol_index = 0;
                    while (symbol_index < symbols.symbols.len()) {
                        Symbol* symbol = symbols.symbols.get_ptr(symbol_index);
                        if (symbol.kind == SymbolKind.Struct || symbol.kind == SymbolKind.Enum
                            || symbol.kind == SymbolKind.TypeAlias || symbol.kind == SymbolKind.Trait) {
                            type_names.push(symbols.names.get(symbol.name_id));
                        }
                        symbol_index += 1;
                    }
                    str suggestion = fuzzy_suggest(callee_name, &type_names, 2);
                    String message = unknown_type_with_suggestion(callee_name, suggestion);
                    diagnostics.error(expr.span, move message);
                    *ok = false;
                    type_names.drop();
                } else {
                    SyntaxNode* enum_id = item_identifier(enum_item);
                    if (enum_id != (SyntaxNode*)0) {
                        i64 tag = 0;
                        i64 arity = 0;
                        if (enum_variant_info(root, enum_id.text, callee_name, &tag, &arity)) {
                            bool flattened = false;
                            if (arity == 1 && (i64)expr.aux > 1) {
                                if (strcmp(callee_name, "Err") == 0) {
                                    flattened = true;
                                } else {
                                    String payload_text = String.new();
                                    if (enum_payload_type_text(root, enum_id.text, callee_name, 0, &payload_text)) {
                                        if (find_item_by_name(root, NodeKind.Struct, payload_text.to_str()) != (SyntaxNode*)0) {
                                            flattened = true;
                                        }
                                    }
                                    payload_text.drop();
                                }
                            }
                            if (arity != (i64)expr.aux && !flattened) {
                                String message = String.from_str("argument count mismatch: expected ");
                                message.push_display(&arity);
                                message.push_str(", found ");
                                i64 actual_count = (i64)expr.aux;
                                message.push_display(&actual_count);
                                diagnostics.error(expr.span, move message);
                                *ok = false;
                            }
                            inferred = types.get_named(enum_id.text);
                        }
                    }
                }
            } else if (find_function_by_name(root, callee_name) == (SyntaxNode*)0
                       && env.lookup(callee.aux) == TYPE_UNKNOWN
                       && symbols.find(callee_name) < 0) {
                Vec<str> function_names = Vec<str>.new();
                SyntaxNode* item = root.first_child;
                while (item != (SyntaxNode*)0) {
                    if (item.kind == NodeKind.Function) {
                        SyntaxNode* function_name = function_identifier(item);
                        if (function_name != (SyntaxNode*)0) {
                            function_names.push(function_name.text);
                        }
                    }
                    item = item.next_sibling;
                }
                str suggestion = fuzzy_suggest(callee_name, &function_names, 2);
                String message = unknown_function_with_suggestion(callee_name, suggestion);
                diagnostics.error(expr.span, move message);
                *ok = false;
                function_names.drop();
            }
        }
    } else if (expr.kind == ExprKind.Field) {
        AstExpr* rx = pool.get_expr(expr.inner0);
        str rx_var_name = (str)0;
        if (rx.kind == ExprKind.Var) {
            rx_var_name = symbols.names.get(rx.aux);
        }
        if (rx_var_name != (str)0 && find_enum_item(root, rx_var_name) != (SyntaxNode*)0) {
            str field_name = symbols.names.get(expr.aux);
            i64 tag = 0;
            i64 arity = 0;
            if (enum_variant_info(root, rx_var_name, field_name, &tag, &arity)) {
                inferred = types.get_named(rx_var_name);
            } else {
                String message = String.from_str("unknown enum variant '");
                message.push_str(field_name);
                message.push_str("' on enum '");
                message.push_str(rx_var_name);
                message.push_str("'");
                diagnostics.error(expr.span, move message);
                *ok = false;
            }
        } else {
            u32 receiver_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
            TypeEntry* receiver_entry = types.get(receiver_type);
            if (receiver_entry.kind == TypeKind.Pointer || receiver_entry.kind == TypeKind.Reference) {
                receiver_type = receiver_entry.inner;
                receiver_entry = types.get(receiver_type);
            }
            if (receiver_entry.kind == TypeKind.Named) {
                str receiver_name = types.names.get(receiver_entry.name_id);
                str field_name = symbols.names.get(expr.aux);
                if (find_enum_item(root, receiver_name) != (SyntaxNode*)0) {
                    i64 tag = 0;
                    i64 arity = 0;
                    if (enum_variant_info(root, receiver_name, field_name, &tag, &arity)) {
                        inferred = receiver_type;
                    }
                } else {
                    Vec<str> fields = Vec<str>.new();
                    if (!typecheck_expr_struct_has_field(root, receiver_name, field_name, &fields)) {
                        str suggestion = fuzzy_suggest(field_name, &fields, 2);
                        String message = unknown_field_with_suggestion(
                            field_name,
                            types.type_name(receiver_type),
                            suggestion
                        );
                        diagnostics.error(expr.span, move message);
                        *ok = false;
                    } else {
                        inferred = typecheck_struct_field_type(types, root, receiver_type, field_name);
                    }
                    fields.drop();
                }
            }
        }
    } else if (expr.kind == ExprKind.MethodCall) {
        AstExpr* receiver = pool.get_expr(expr.inner0);
        u32 receiver_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        if (receiver_type == TYPE_UNKNOWN) {
            receiver_type = typecheck_place_type(pool, types, symbols, root, env, expr.inner0);
        }
        str method_name = symbols.names.get(expr.aux);
        u32 arg_count = expr.inner1 < (u32)pool.args.len() ? pool.args.get((i64)expr.inner1) : 0;
        // `Task<T>` is builtin; `started()` is its only method.
        TypeEntry* receiver_entry = types.get(types.resolve_subst(receiver_type));
        if (receiver_entry.kind == TypeKind.Named && receiver_entry.count == 1
            && strcmp(types.names.get(receiver_entry.name_id), "Task") == 0) {
            u32 task_method_type = TYPE_BOOL;
            if (strcmp(method_name, "started") != 0 || arg_count != 0) {
                diagnostics.error(expr.span, unknown_task_method(method_name));
                *ok = false;
                task_method_type = TYPE_UNKNOWN;
            }
            expr.inferred_type = task_method_type;
            env.expression_depth -= 1;
            return task_method_type;
        }
        bool static_method = false;
        bool variant_constructor = false;
        if (receiver.kind == ExprKind.Var) {
            str receiver_name = symbols.names.get(receiver.aux);
            String base = String.new();
            i64 base_index = 0;
            while (receiver_name[base_index] != (u8)0 && receiver_name[base_index] != (u8)60) {
                base.push(receiver_name[base_index]);
                base_index += 1;
            }
            static_method = impl_has_static_method(root, base.to_str(), method_name);
            variant_constructor = env.lookup(receiver.aux) == TYPE_UNKNOWN
                && typecheck_is_variant_constructor(root, base.to_str(), method_name);
            if (static_method) {
                u32 static_receiver_type = type_id_from_text(types, receiver_name);
                if (static_receiver_type != TYPE_UNKNOWN) {
                    receiver_type = static_receiver_type;
                    receiver.inferred_type = static_receiver_type;
                }
            }
            base.drop();
        }
        i64 total_param_count = (i64)arg_count + (static_method ? 0 : 1);
        bool has_arguments = expr.inner1 < (u32)pool.args.len();
        i64 infer_index = 0;
        while (has_arguments && infer_index < (i64)arg_count) {
            u32 arg_id = pool.args.get((i64)expr.inner1 + 1 + infer_index);
            infer_expr(pool, types, symbols, root, env, arg_id, diagnostics, ok);
            infer_index += 1;
        }
        if (!variant_constructor) {
            typecheck_method_call_target(pool, types, root, receiver_type, method_name,
                expr.inner1, static_method, expr.span, diagnostics, ok);
        }
        // The argument types select the overload, and with it whether the
        // call takes `self` by value.
        if (!static_method) {
            ParameterMode receiver_mode = strcmp(method_name, "drop") == 0 ? ParameterMode.Value
                : typecheck_selected_parameter_mode(pool, root, types, receiver_type,
                    method_name, total_param_count, expr.inner1, false, 0, receiver_type);
            if (receiver_mode == ParameterMode.Value && receiver.kind != ExprKind.Move) {
                typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                   expr.inner0, diagnostics, ok);
            } else if (receiver_mode == ParameterMode.Mutable) {
                pool.mutable_borrows.set((i64)expr.inner0);
            }
        }
        if (has_arguments) {
            i64 arg_index = 0;
            while (arg_index < (i64)arg_count) {
                u32 arg_id = pool.args.get((i64)expr.inner1 + 1 + arg_index);
                i64 parameter_index = arg_index + (static_method ? 0 : 1);
                u32 expected_arg_type = typecheck_method_parameter_type_for_call(
                    pool, root, types, receiver_type, method_name, total_param_count,
                    expr.inner1, static_method, parameter_index, (bool*)0);
                u32 arg_type = pool.get_expr(arg_id).inferred_type;
                typecheck_char_pointer_argument(types, expected_arg_type, arg_type,
                    pool.get_expr(arg_id).span, diagnostics, ok);
                AstExpr* argument = pool.get_expr(arg_id);
                TypeEntry* expected_entry = types.get(types.resolve_subst(expected_arg_type));
                if (argument.kind == ExprKind.ArrayLit
                    && expected_entry.kind == TypeKind.Tuple
                    && expected_entry.count == (i64)argument.aux) {
                    bool elements_match = true;
                    i64 element_index = 0;
                    while (element_index < expected_entry.count) {
                        u32 element_id = pool.args.get((i64)argument.inner1 + 1 + element_index);
                        AstExpr* element = pool.get_expr(element_id);
                        u32 element_expected = types.resolve_subst(
                            types.type_args.get(expected_entry.inner + (u32)element_index));
                        if (element_expected != TYPE_UNKNOWN
                            && element.inferred_type != TYPE_UNKNOWN
                            && !typecheck_element_fits(pool, root, types, element_expected,
                                                       element_id)) {
                            diagnostics.error(element.span, type_mismatch(
                                types.type_name(element_expected),
                                types.type_name(element.inferred_type)));
                            *ok = false;
                            elements_match = false;
                        }
                        element_index += 1;
                    }
                    if (elements_match) {
                        argument.inferred_type = types.resolve_subst(expected_arg_type);
                        arg_type = argument.inferred_type;
                    }
                }
                ParameterMode arg_mode = variant_constructor ? ParameterMode.Value
                    : typecheck_selected_parameter_mode(pool, root, types, receiver_type,
                          method_name, total_param_count, expr.inner1, static_method,
                          parameter_index, arg_type);
                AstExpr* payload = pool.get_expr(arg_id);
                u32 payload_type = types.resolve_subst(payload.inferred_type);
                // A named owner placed in a variant must say `move`; temporaries need not.
                if (variant_constructor
                    && (payload.kind == ExprKind.Var || payload.kind == ExprKind.Field)
                    && types.get(payload_type).kind == TypeKind.Named
                    && !typecheck_type_is_copy(root, types, payload_type)) {
                    diagnostics.error(payload.span,
                        payload_must_be_moved(types.type_name(payload_type)));
                    *ok = false;
                }
                if (arg_mode == ParameterMode.Value && pool.get_expr(arg_id).kind != ExprKind.Move
                    && !typecheck_coerces_to_view(types, expected_arg_type, arg_type)) {
                    typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                       arg_id, diagnostics, ok);
                } else if (arg_mode == ParameterMode.Mutable) {
                    pool.mutable_borrows.set((i64)arg_id);
                }
                arg_index += 1;
            }
        }
        MonoMethodTemplate generic_template;
        Vec<u32> generic_params = Vec<u32>.new();
        Vec<u32> generic_args = Vec<u32>.new();
        String generic_failure = String.new();
        bool generic_args_known = true;
        i64 known_index = 0;
        while (known_index < (i64)arg_count) {
            u32 known_id = pool.args.get((i64)expr.inner1 + 1 + known_index);
            u32 known_type = pool.get_expr(known_id).inferred_type;
            TypeEntry* known = types.get(types.resolve_subst(known_type));
            while (known.kind == TypeKind.Pointer || known.kind == TypeKind.Reference) {
                known_type = known.inner;
                known = types.get(types.resolve_subst(known_type));
            }
            if (known.kind == TypeKind.Unknown) { generic_args_known = false; }
            known_index += 1;
        }
        if (generic_args_known
            && mono_resolve_generic_method(pool, root, types, receiver_type, method_name,
                expr.inner1, static_method, &generic_template, &generic_params,
                &generic_args, &generic_failure) && generic_failure.len() > 0) {
            diagnostics.error(expr.span, generic_failure.clone());
            *ok = false;
        }
        generic_failure.drop();
        generic_params.drop();
        generic_args.drop();
        inferred = typecheck_method_return_type_for_call(pool, root, types,
            receiver_type, method_name, total_param_count, expr.inner1,
            static_method);
        if (receiver.kind != ExprKind.Var) {
            // Infer non-Var receivers (e.g. synthetic Format nodes from
            // @println desugar) so the backend can resolve the method's
            // struct. Result intentionally unused here.
            infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        }
        if (receiver.kind == ExprKind.Var) {
            str receiver_name = symbols.names.get(receiver.aux);
            str method_name = symbols.names.get(expr.aux);
            String base = String.new();
            i64 bi = 0;
            while (receiver_name[bi] != (u8)0 && receiver_name[bi] != (u8)60) {
                base.push(receiver_name[bi]);
                bi += 1;
            }
            SyntaxNode* enum_item = find_enum_item(root, base.to_str());
            if (enum_item != (SyntaxNode*)0) {
                if (!static_method) {
                    Vec<SyntaxNode*> variant_names = Vec<SyntaxNode*>.new();
                    Vec<i64> variant_tags = Vec<i64>.new();
                    Vec<i64> variant_arities = Vec<i64>.new();
                    enum_each_variant(enum_item, &variant_names, &variant_tags, &variant_arities);
                    i64 vi = 0;
                    while (vi < variant_names.len()) {
                        if (method_matches_variant(method_name, variant_names.get(vi).text)) {
                            u32 args_count = pool.args.get((i64)expr.inner1);
                            if (variant_arities.get(vi) != (i64)args_count) {
                                bool flattened = false;
                                if (variant_arities.get(vi) == 1 && (i64)args_count > 1) {
                                    if (strcmp(variant_names.get(vi).text, "Err") == 0) {
                                            flattened = true;
                                    } else {
                                        String ptext = String.new();
                                        if (enum_payload_type_text(root, base.to_str(),
                                                                   variant_names.get(vi).text,
                                                                   0, &ptext)) {
                                            if (find_item_by_name(root, NodeKind.Struct,
                                                                  ptext.to_str()) != (SyntaxNode*)0) {
                                                flattened = true;
                                            }
                                        }
                                        ptext.drop();
                                    }
                                }
                                if (!flattened) {
                                    String message = String.from_str("argument count mismatch: expected ");
                                    i64 expected_count = variant_arities.get(vi);
                                    message.push_display(&expected_count);
                                    message.push_str(", found ");
                                    i64 actual_count = (i64)args_count;
                                    message.push_display(&actual_count);
                                    diagnostics.error(expr.span, move message);
                                    *ok = false;
                                }
                            }
                            inferred = types.get_named(receiver_name);
                            break;
                        }
                        vi += 1;
                    }
                    variant_names.drop();
                    variant_tags.drop();
                    variant_arities.drop();
                }
            }
            base.drop();
        }
    } else if (expr.kind == ExprKind.ArrayLit) {
        u32 elem_count = expr.aux;
        Vec<u32> element_types = Vec<u32>.new();
        bool tuple_literal = false;
        i64 i = 0;
        while (i < (i64)elem_count) {
            u32 elem_id = pool.args.get((i64)expr.inner1 + 1 + i);
            u32 element_type = infer_expr(pool, types, symbols, root, env, elem_id, diagnostics, ok);
            element_types.push(element_type);
            if (i > 0 && element_type != element_types.get(0)) {
                tuple_literal = true;
            }
            i += 1;
        }
        if (tuple_literal) {
            inferred = types.get_tuple(&element_types);
        } else {
            u32 elem_type = TYPE_UNKNOWN;
            if (element_types.len() > 0) {
                elem_type = element_types.get(0);
            }
            inferred = types.get_array(elem_type, (i64)elem_count);
        }
        element_types.drop();
    } else if (expr.kind == ExprKind.Index) {
        u32 target_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
        if (target_type != TYPE_UNKNOWN) {
            TypeEntry* entry = types.get(target_type);
            if (entry.kind == TypeKind.Reference
                && types.get(types.resolve_subst(entry.inner)).kind == TypeKind.Str) {
                inferred = TYPE_U8;
            } else if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                inferred = types.resolve_subst(entry.inner);
            } else if (entry.kind == TypeKind.Array) {
                if (entry.count == 0) {
                    diagnostics.error(expr.span, zero_size_array_index());
                    *ok = false;
                } else {
                    inferred = types.resolve_subst(entry.inner);
                }
            } else if (entry.kind == TypeKind.Tuple) {
                AstExpr* index_expr = pool.get_expr(expr.inner1);
                if (index_expr.kind == ExprKind.Literal) {
                    i64 index = typecheck_literal_index(symbols.names.get(index_expr.inner0));
                    if (index >= 0 && index < entry.count) {
                        inferred = types.resolve_subst(types.type_args.get(entry.inner + (u32)index));
                    }
                }
            } else if (entry.kind == TypeKind.Str) {
                inferred = TYPE_U8;
            } else if (entry.kind == TypeKind.Named && entry.count > 0) {
                str base = types.names.get(entry.name_id);
                if (strcmp(base, "Vec") == 0 || strcmp(base, "Slice") == 0) {
                    inferred = types.resolve_subst(types.type_args.get(entry.inner));
                }
            } else if (entry.kind == TypeKind.Named) {
                inferred = typecheck_method_return_type(root, types, target_type,
                                                        "__index_get", 2);
            }
        }
    } else if (expr.kind == ExprKind.Slice) {
        u32 target_type = infer_expr(pool, types, symbols, root, env, expr.inner0, diagnostics, ok);
        if (expr.inner1 != 0) {
            infer_expr(pool, types, symbols, root, env, expr.inner1, diagnostics, ok);
        }
        if (expr.aux != 0) {
            infer_expr(pool, types, symbols, root, env, expr.aux, diagnostics, ok);
        }
        inferred = typecheck_slice_result_type(types, root, target_type);
    }

    expr.inferred_type = inferred;
    env.expression_depth -= 1;
    return inferred;
}

/// Reports `return`, `break`, and `continue` inside a `defer` body.
void typecheck_reject_defer_control(AstPool* pool, u32 node_id, bool is_stmt,
                                    DiagnosticBag* diagnostics, bool* ok) {
    if (node_id == 0) { return; }
    if (is_stmt) {
        AstStmt* stmt = pool.get_stmt(node_id);
        if (stmt.kind == StmtKind.Return) {
            diagnostics.error(stmt.span, String.from_str(return_not_allowed_in_defer()));
            *ok = false;
            typecheck_reject_defer_control(pool, stmt.inner0, false, diagnostics, ok);
        } else if (stmt.kind == StmtKind.Break) {
            diagnostics.error(stmt.span, String.from_str(break_not_allowed_in_defer()));
            *ok = false;
        } else if (stmt.kind == StmtKind.Continue) {
            diagnostics.error(stmt.span, String.from_str(continue_not_allowed_in_defer()));
            *ok = false;
        } else if (stmt.kind == StmtKind.Let || stmt.kind == StmtKind.Expr) {
            typecheck_reject_defer_control(pool,
                stmt.kind == StmtKind.Let ? stmt.inner1 : stmt.inner0,
                false, diagnostics, ok);
        } else if (stmt.kind == StmtKind.Assign) {
            typecheck_reject_defer_control(pool, stmt.inner0, false, diagnostics, ok);
            typecheck_reject_defer_control(pool, stmt.inner1, false, diagnostics, ok);
        } else if (stmt.kind == StmtKind.If || stmt.kind == StmtKind.While) {
            typecheck_reject_defer_control(pool, stmt.inner0, false, diagnostics, ok);
            typecheck_reject_defer_control(pool, stmt.inner1, true, diagnostics, ok);
            typecheck_reject_defer_control(pool, stmt.aux, true, diagnostics, ok);
        } else if (stmt.kind == StmtKind.Block) {
            i64 i = 0;
            while (i < (i64)stmt.aux) {
                typecheck_reject_defer_control(pool,
                    pool.block_stmts.get((i64)stmt.inner0 + i),
                    true, diagnostics, ok);
                i += 1;
            }
        }
    } else {
        AstExpr* expr = pool.get_expr(node_id);
        if (expr.kind == ExprKind.Block) {
            i64 i = 0;
            while (i < (i64)expr.inner1) {
                typecheck_reject_defer_control(pool,
                    pool.block_stmts.get((i64)expr.inner0 + i), true, diagnostics, ok);
                i += 1;
            }
            typecheck_reject_defer_control(pool, expr.aux, false, diagnostics, ok);
        } else if (expr.kind == ExprKind.Match) {
            typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
            i64 i = 0;
            while (i < (i64)expr.aux) {
                MatchArm* arm = pool.get_arm(expr.inner1 + (u32)i);
                typecheck_reject_defer_control(pool, arm.guard_id, false, diagnostics, ok);
                typecheck_reject_defer_control(pool, arm.value_id, false, diagnostics, ok);
                typecheck_reject_defer_control(pool, arm.body_stmt_id, true, diagnostics, ok);
                i += 1;
            }
        } else if (expr.kind == ExprKind.Binary || expr.kind == ExprKind.Index
            || expr.kind == ExprKind.UnwrapOr || expr.kind == ExprKind.DropInPlace
            || expr.kind == ExprKind.Assert || expr.kind == ExprKind.Fprint) {
            typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
            typecheck_reject_defer_control(pool, expr.inner1, false, diagnostics, ok);
        } else if (expr.kind == ExprKind.Ternary || expr.kind == ExprKind.Slice) {
            typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
            typecheck_reject_defer_control(pool, expr.inner1, false, diagnostics, ok);
            typecheck_reject_defer_control(pool, expr.aux, false, diagnostics, ok);
        } else if (expr.kind == ExprKind.Unary || expr.kind == ExprKind.Field
            || expr.kind == ExprKind.Cast || expr.kind == ExprKind.Move
            || expr.kind == ExprKind.Hash || expr.kind == ExprKind.Launch
            || expr.kind == ExprKind.Wait || expr.kind == ExprKind.SizeOf
            || expr.kind == ExprKind.AlignOf) {
            typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
        } else if (expr.kind == ExprKind.Call) {
            typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
            i64 i = 0;
            while (i < (i64)expr.aux) {
                typecheck_reject_defer_control(pool,
                    pool.args.get((i64)expr.inner1 + i), false, diagnostics, ok);
                i += 1;
            }
        } else if (expr.kind == ExprKind.MethodCall) {
            typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
            if ((i64)expr.inner1 < pool.args.len()) {
                i64 count = pool.args.get((i64)expr.inner1);
                i64 i = 0;
                while (i < count) {
                    typecheck_reject_defer_control(pool,
                        pool.args.get((i64)expr.inner1 + 1 + i),
                        false, diagnostics, ok);
                    i += 1;
                }
            }
        } else if (expr.kind == ExprKind.ArrayLit || expr.kind == ExprKind.Format) {
            if (expr.kind == ExprKind.Format) {
                typecheck_reject_defer_control(pool, expr.inner0, false, diagnostics, ok);
            }
            i64 i = 0;
            while (i < (i64)expr.aux) {
                typecheck_reject_defer_control(pool,
                    pool.args.get((i64)expr.inner1 + i), false, diagnostics, ok);
                i += 1;
            }
        } else if (expr.kind == ExprKind.StructLit) {
            i64 i = 0;
            while (i < (i64)expr.aux) {
                typecheck_reject_defer_control(pool,
                    pool.args.get((i64)expr.inner1 + i * 2 + 1), false, diagnostics, ok);
                i += 1;
            }
        } else if (expr.kind == ExprKind.MemoryBuiltin) {
            i64 i = 0;
            while (i < 3 && (i64)expr.inner0 + i < pool.args.len()) {
                typecheck_reject_defer_control(pool,
                    pool.args.get((i64)expr.inner0 + i), false, diagnostics, ok);
                i += 1;
            }
        } else if (expr.kind == ExprKind.Asm && (i64)expr.aux < pool.asms.len()) {
            AstAsm* asm_item = pool.asms.get_ptr((i64)expr.aux);
            i64 i = 0;
            while (i < (i64)asm_item.args_count) {
                typecheck_reject_defer_control(pool,
                    pool.args.get((i64)asm_item.args_start + i), false, diagnostics, ok);
                i += 1;
            }
        }
    }
}

// Resolve local initializers with the same expression checker as function bodies.
// The environment is supplied by the caller's scope model.
/// Returns the type of a declaration initializer.
u32 typecheck_initializer_type(SymbolTable* symbols, TypeTable* types, SyntaxNode* root,
                              SyntaxNode* name, TypeEnv* env) {
    SyntaxNode* assign = name.next_sibling;
    if (assign == (SyntaxNode*)0 || assign.token_kind != TokenKind.Assign) { return TYPE_UNKNOWN; }
    SyntaxNode* end = assign.next_sibling;
    while (end != (SyntaxNode*)0 && end.token_kind != TokenKind.Semicolon) { end = end.next_sibling; }
    AstPool pool = AstPool.new(); ExprLowerer lowerer = ExprLowerer.new(&pool, types, &symbols.names);
    lowerer.unit_root = root; u32 expression = lowerer.lower_sequence(assign.next_sibling, end);
    DiagnosticBag diagnostics = DiagnosticBag.new(); bool ok = true;
    if (lowerer.unsupported) { return TYPE_UNKNOWN; }
    return infer_expr(&pool, types, symbols, root, env, expression, &diagnostics, &ok);
}

// Entries follow binding order; visibility excludes shadowed and sibling locals.
/// Resolves the declared types of `bindings`.
void typecheck_binding_types(SymbolTable* symbols, TypeTable* types, SyntaxNode* root,
                             Vec<Binding>* bindings, Vec<u32>* resolved) {
    i64 i = 0;
    while (i < bindings.len()) {
        Binding* binding = bindings.get_ptr(i);
        u32 type_id = typecheck_parameter_type_id(types, binding);
        SyntaxNode* assign = binding.name_node.next_sibling;
        if (type_id == TYPE_UNKNOWN && binding.kind == BindingKind.Let
            && assign != (SyntaxNode*)0 && assign.token_kind == TokenKind.Assign) {
            TypeEnv env = TypeEnv.new();
            i64 previous = 0;
            while (previous < i) {
                Binding* candidate = bindings.get_ptr(previous);
                if (visible_binding(bindings, candidate.name, assign.next_sibling) == candidate) {
                    env.insert(symbols.names.intern(candidate.name), resolved.get(previous));
                }
                previous += 1;
            }
            type_id = typecheck_initializer_type(symbols, types, root, binding.name_node, &env);
        }
        resolved.push(type_id);
        i += 1;
    }
}

/// Returns the resolved type of the binding named `name_id`.
u32 typecheck_resolved_binding_type(Vec<Binding>* bindings, Vec<u32>* resolved,
                                    Binding* binding) {
    i64 i = 0;
    while (i < bindings.len()) {
        if (bindings.get_ptr(i) == binding) { return resolved.get(i); }
        i += 1;
    }
    return TYPE_UNKNOWN;
}

/// Type-checks one statement and its children.
void typecheck_statement(AstPool* pool, TypeTable* types, SymbolTable* symbols,
                         SyntaxNode* root, TypeEnv* env, u32 expected_return,
                         u32 stmt_id, DiagnosticBag* diagnostics, bool* ok) {
    AstStmt* stmt = pool.get_stmt(stmt_id);
    if (stmt.kind == StmtKind.Let) {
        u32 declared_type = stmt.inner0;
        u32 init_id = stmt.inner1;
        u32 var_name = stmt.aux;
        if (init_id != 0) {
            u32 actual_type = infer_expr(pool, types, symbols, root, env, init_id, diagnostics, ok);
            if (pool.get_expr(init_id).kind != ExprKind.Move) {
                typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                   init_id, diagnostics, ok);
            }
            bool array_initializer = false;
            if (declared_type != TYPE_UNKNOWN) {
                TypeEntry* expected = types.get(declared_type);
                AstExpr* initializer = pool.get_expr(init_id);
                if (declared_type == TYPE_STR && initializer.kind == ExprKind.Slice
                    && initializer.aux == 0
                    && infer_expr(pool, types, symbols, root, env, initializer.inner0,
                                  diagnostics, ok) == TYPE_STR) {
                    // A suffix of a NUL-terminated str remains NUL-terminated.
                    initializer.inferred_type = TYPE_STR;
                    actual_type = TYPE_STR;
                }
                if (expected.kind == TypeKind.Array && initializer.kind == ExprKind.ArrayLit) {
                    array_initializer = true;
                    if ((i64)initializer.aux > expected.count) {
                        diagnostics.error(stmt.span, type_mismatch(
                            types.type_name(declared_type), types.type_name(actual_type)));
                        *ok = false;
                    } else {
                        bool elements_match = true;
                        i64 i = 0;
                        while (i < (i64)initializer.aux) {
                            u32 element_id = pool.args.get((i64)initializer.inner1 + 1 + i);
                            AstExpr* element = pool.get_expr(element_id);
                            if (!typecheck_element_fits(pool, root, types, expected.inner,
                                                        element_id)) {
                                diagnostics.error(element.span, type_mismatch(
                                    types.type_name(expected.inner), types.type_name(element.inferred_type)));
                                elements_match = false;
                                *ok = false;
                            }
                            i += 1;
                        }
                        if (elements_match) {
                            initializer.inferred_type = declared_type;
                            actual_type = declared_type;
                        }
                    }
                }
            }
            if (!array_initializer && declared_type != TYPE_UNKNOWN && actual_type != TYPE_UNKNOWN
                && !types_match_value(types, declared_type, actual_type, expr_is_literal(pool, init_id))
                && !typecheck_tuple_literal_fits(pool, root, types, declared_type, init_id)
                && !typecheck_implicit_cast(root, types, actual_type, declared_type)) {
                String message = String.from_str("type mismatch: expected ");
                message.push_str(types.type_name(declared_type));
                message.push_str(", found ");
                message.push_str(types.type_name(actual_type));
                diagnostics.error(stmt.span, move message);
                *ok = false;
            }
            if (declared_type == TYPE_UNKNOWN) {
                env.insert(var_name, actual_type);
            } else {
                env.insert(var_name, declared_type);
            }
        } else {
            env.insert(var_name, declared_type);
        }
        // A local named like a locked payload owns its own value.
        if (typecheck_is_locked_binding(pool, var_name)) {
            LockedName shadow;
            shadow.name_id = var_name;
            shadow.locked = false;
            pool.locked_bindings.push(shadow);
        }
    } else if (stmt.kind == StmtKind.Assign) {
        u32 target_type = infer_expr(pool, types, symbols, root, env, stmt.inner0, diagnostics, ok);
        u32 val_type = infer_expr(pool, types, symbols, root, env, stmt.inner1, diagnostics, ok);
        AstExpr* value_expr = pool.get_expr(stmt.inner1);
        // A nested literal in a generic field is named after the field's type
        // parameter (`U` in `Box<U>`), not a declared type: it takes the target's.
        bool untyped_literal = value_expr.kind == ExprKind.StructLit
            && (value_expr.inner0 == 0
                || (find_item_by_name(root, NodeKind.Struct, symbols.names.get(value_expr.inner0))
                        == (SyntaxNode*)0
                    && find_enum_item(root, symbols.names.get(value_expr.inner0))
                        == (SyntaxNode*)0));
        if (untyped_literal) {
            u32 resolved_target = types.resolve_subst(target_type);
            TypeEntry* target_entry = types.get(resolved_target);
            if (target_entry.kind == TypeKind.Named) {
                value_expr.inferred_type = resolved_target;
                val_type = resolved_target;
            }
        }
        if (pool.get_expr(stmt.inner1).kind != ExprKind.Move) {
            typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                               stmt.inner1, diagnostics, ok);
        }
        if (typecheck_is_mutex(types, target_type) && val_type != TYPE_UNKNOWN
            && !typecheck_is_mutex(types, val_type)) {
            diagnostics.error(stmt.span, shared_value_outside_lock(
                typecheck_operand_name(pool, symbols, stmt.inner0)));
            *ok = false;
        } else if (target_type != TYPE_UNKNOWN && val_type != TYPE_UNKNOWN
            && !types_match_value(types, target_type, val_type, expr_is_literal(pool, stmt.inner1))
            && !typecheck_tuple_literal_fits(pool, root, types, target_type, stmt.inner1)
            && !typecheck_implicit_cast(root, types, val_type, target_type)) {
            String message = String.from_str("type mismatch: expected ");
            message.push_str(types.type_name(target_type));
            message.push_str(", found ");
            message.push_str(types.type_name(val_type));
            diagnostics.error(stmt.span, move message);
            *ok = false;
        }
    } else if (stmt.kind == StmtKind.Return) {
        u32 expr_id = stmt.inner0;
        if (expr_id != 0) {
            u32 actual_type = infer_expr(pool, types, symbols, root, env, expr_id, diagnostics, ok);
            TypeEntry* return_entry = types.get(expected_return);
            if (return_entry.kind != TypeKind.Pointer && return_entry.kind != TypeKind.Reference
                && pool.get_expr(expr_id).kind != ExprKind.Move) {
                typecheck_reject_partial_drop_move(pool, types, symbols, root, env,
                                                   expr_id, diagnostics, ok);
            }
            if (expected_return != TYPE_UNKNOWN && actual_type != TYPE_UNKNOWN
                && !types_match_value(types, expected_return, actual_type, expr_is_literal(pool, expr_id))
                && !typecheck_tuple_literal_fits(pool, root, types, expected_return, expr_id)
                && !typecheck_implicit_cast(root, types, actual_type, expected_return)) {
                String message = String.from_str("type mismatch: expected ");
                message.push_str(types.type_name(expected_return));
                message.push_str(", found ");
                message.push_str(types.type_name(actual_type));
                diagnostics.error(pool.get_expr(expr_id).span, move message);
                *ok = false;
            }
        } else if (expected_return != TYPE_VOID && expected_return != TYPE_UNKNOWN) {
            // An unparsed return type reads as void, so only a resolved
            // non-void type rejects a bare `return;`.
            diagnostics.error(stmt.span, return_type_mismatch(types.type_name(expected_return), "void"));
            *ok = false;
        }
    } else if (stmt.kind == StmtKind.Expr) {
        infer_expr(pool, types, symbols, root, env, stmt.inner0, diagnostics, ok);
    } else if (stmt.kind == StmtKind.If) {
        infer_expr(pool, types, symbols, root, env, stmt.inner0, diagnostics, ok);
        if (stmt.inner1 != 0) {
            typecheck_statement(pool, types, symbols, root, env, expected_return, stmt.inner1, diagnostics, ok);
        }
        if (stmt.aux != 0) {
            typecheck_statement(pool, types, symbols, root, env, expected_return, stmt.aux, diagnostics, ok);
        }
    } else if (stmt.kind == StmtKind.While) {
        infer_expr(pool, types, symbols, root, env, stmt.inner0, diagnostics, ok);
        if (stmt.inner1 != 0) {
            typecheck_statement(pool, types, symbols, root, env, expected_return, stmt.inner1, diagnostics, ok);
        }
        if (stmt.aux != 0) {
            typecheck_statement(pool, types, symbols, root, env, expected_return, stmt.aux, diagnostics, ok);
        }
    } else if (stmt.kind == StmtKind.Defer) {
        typecheck_reject_defer_control(pool, stmt.inner0, true, diagnostics, ok);
        typecheck_statement(pool, types, symbols, root, env, expected_return,
                            stmt.inner0, diagnostics, ok);
    } else if (stmt.kind == StmtKind.Block) {
        u32 start = stmt.inner0;
        u32 count = stmt.aux;
        // Its lowered body would only repeat the error.
        if (typecheck_lock_on_unshared(pool, types, symbols, root, env, start, count, diagnostics, ok)) {
            return;
        }
        // A local declared in the block shadows an outer name, locked or not,
        // only inside it.
        TypeEnv block_env = env.child();
        i64 locked_mark = pool.locked_bindings.len();
        i64 i = 0;
        while (i < (i64)count) {
            u32 s_id = pool.block_stmts.get((i64)start + i);
            typecheck_statement(pool, types, symbols, root, &block_env, expected_return, s_id, diagnostics, ok);
            i += 1;
        }
        while (pool.locked_bindings.len() > locked_mark) { pool.locked_bindings.pop(); }
        block_env.locals.drop();
    }
}

/// Returns true for a "cannot move ... because it implements Drop" message.
bool typecheck_is_drop_ancestor_error(str message) {
    str prefix = "cannot move '";
    str suffix = "' because it implements Drop";
    i64 message_len = strlen(message);
    i64 prefix_len = strlen(prefix);
    i64 suffix_len = strlen(suffix);
    if (message_len < prefix_len + suffix_len
        || !typecheck_str_starts_with(message, prefix)) {
        return false;
    }
    i64 i = 0;
    while (i < suffix_len) {
        if (message[message_len - suffix_len + i] != suffix[i]) { return false; }
        i += 1;
    }
    return true;
}

/// Returns true when `message` contains `marker`.
bool typecheck_str_contains(str message, str marker) {
    i64 marker_len = strlen(marker);
    i64 start = 0;
    while (start + marker_len <= strlen(message)) {
        i64 i = 0;
        while (i < marker_len && message[start + i] == marker[i]) { i += 1; }
        if (i == marker_len) { return true; }
        start += 1;
    }
    return false;
}

/// Returns true for a shared_value_outside_lock or lock_needs_shared
/// message: a generic body that uses its `T` directly is wrong once `T` is
/// a `shared` Mutex, and one that locks its `T` is wrong unless it is.
bool typecheck_is_shared_value_error(str message) {
    return (message[0] == '`' && typecheck_str_contains(message, "` is shared between threads: "))
        || typecheck_str_contains(message, ", not shared: declare it `shared ");
}

/// Rechecks drop-ownership errors in generic call instantiations.
void typecheck_generic_call_drop_ownership(
    AstPool* caller_pool, TypeTable* types, SymbolTable* symbols, SyntaxNode* root,
    TypeEnv* caller_env, SyntaxNode* function, u32 call_id,
    DiagnosticBag* diagnostics, bool* ok) {
    if (caller_env.expression_depth >= MAX_TYPE_CHECK_DEPTH) { return; }
    SyntaxNode* body = find_function_body(function);
    if (body == (SyntaxNode*)0) { return; }

    AstExpr* call_ptr = caller_pool.get_expr(call_id);
    AstExpr call = *call_ptr;
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(binding_function_parameters(function), &params);
    if (params.len() != (i64)call.aux) {
        params.drop();
        return;
    }

    TypeEnv callee_env = TypeEnv.new();
    callee_env.expression_depth = caller_env.expression_depth;
    u32 expected_return = function_return_type_id(types, function);
    callee_env.expected_return = expected_return;
    bool concrete_args = true;
    i64 i = 0;
    while (i < params.len()) {
        Binding* param = params.get_ptr(i);
        u32 arg_id = caller_pool.args.get((i64)call.inner1 + i);
        u32 arg_type = caller_pool.get_expr(arg_id).inferred_type;
        if (arg_type == TYPE_UNKNOWN) {
            arg_type = infer_expr(caller_pool, types, symbols, root, caller_env,
                                  arg_id, diagnostics, ok);
        }
        if (arg_type == TYPE_UNKNOWN) {
            arg_type = typecheck_place_type(caller_pool, types, symbols, root,
                                            caller_env, arg_id);
        }
        arg_type = types.resolve_subst(arg_type);
        TypeEntry* arg_entry = types.get(arg_type);
        if (arg_type == TYPE_UNKNOWN || arg_entry.kind == TypeKind.TypeParam
            || arg_entry.kind == TypeKind.Unknown) {
            concrete_args = false;
            break;
        }
        bool actual_is_view = arg_entry.kind == TypeKind.Pointer
            || arg_entry.kind == TypeKind.Reference;
        u32 declared_type = typecheck_parameter_type_id(types, param);
        TypeEntry* declared_entry = types.get(types.resolve_subst(declared_type));
        bool parameter_is_pointer = param.declared_type.kind == ProjectionTypeKind.Pointer
            || declared_entry.kind == TypeKind.Pointer;
        bool parameter_is_reference = param.declared_type.kind == ProjectionTypeKind.Reference
            || declared_entry.kind == TypeKind.Reference;
        if (!actual_is_view && parameter_is_pointer) {
            arg_type = types.get_pointer(arg_type, param.declared_type.is_mutable);
        } else if (!actual_is_view && parameter_is_reference) {
            arg_type = types.get_reference(arg_type, param.declared_type.is_mutable);
        }
        callee_env.insert(symbols.names.intern(param.name), arg_type);
        i += 1;
    }
    params.drop();
    if (!concrete_args) { return; }

    AstPool probe_pool = AstPool.new();
    ExprLowerer lowerer = ExprLowerer.new(&probe_pool, types, &symbols.names);
    lowerer.unit_root = root;
    Vec<u32> stmt_ids = Vec<u32>.new();
    lowerer.lower_block(body, &stmt_ids);
    if (lowerer.unsupported) {
        if (lowerer.error.len() > 0) {
            diagnostics.error(lowerer.error_span, move lowerer.error);
            *ok = false;
        }
        stmt_ids.drop();
        return;
    }

    DiagnosticBag probe_diagnostics = DiagnosticBag.new();
    bool probe_ok = true;
    i = 0;
    while (i < stmt_ids.len()) {
        typecheck_statement(&probe_pool, types, symbols, root, &callee_env,
                            expected_return, stmt_ids.get(i), &probe_diagnostics,
                            &probe_ok);
        i += 1;
    }
    stmt_ids.drop();

    i = 0;
    while (i < probe_diagnostics.len()) {
        Diagnostic* diagnostic = probe_diagnostics.get(i);
        if (diagnostic.severity == Severity.Error
            && (typecheck_is_drop_ancestor_error(diagnostic.message.to_str())
                || typecheck_is_shared_value_error(diagnostic.message.to_str())
                || typecheck_str_contains(diagnostic.message.to_str(), "' out of its lock block: ")
                || typecheck_str_starts_with(diagnostic.message.to_str(), "pointer argument type mismatch:"))) {
            diagnostics.error(diagnostic.span, diagnostic.message.clone());
            *ok = false;
        }
        i += 1;
    }
}

/// Type-checks every statement of a function body. Sets `*unsupported_out`
/// (when non-null) if the body cannot be lowered.
void typecheck_function_statements_scoped(AstPool* pool, TypeTable* types, SymbolTable* symbols,
                                          SyntaxNode* root, SyntaxNode* function, CfgSet* cfg,
                                          DiagnosticBag* diagnostics, bool* ok, bool* unsupported_out) {
    SyntaxNode* body = find_function_body(function);
    if (body == (SyntaxNode*)0) { return; }
    typecheck_body(pool, types, symbols, root, binding_function_parameters(function), body,
                   function_return_type_id(types, function), TYPE_UNKNOWN, cfg, diagnostics, ok,
                   unsupported_out);
}

/// Type-checks the statements of `body` with `parameters` in scope. A
/// receiver written without a type (`*self`, `&self`, `self`) has
/// `self_type`. Sets `*unsupported_out` (when non-null) if the body cannot
/// be lowered. In-body `@cfg` conditions use `cfg`, the build's active
/// configuration.
void typecheck_body(AstPool* pool, TypeTable* types, SymbolTable* symbols, SyntaxNode* root,
                    SyntaxNode* parameters, SyntaxNode* body, u32 expected_return,
                    u32 self_type, CfgSet* cfg, DiagnosticBag* diagnostics, bool* ok,
                    bool* unsupported_out) {
    TypeEnv env = TypeEnv.new();
    env.expected_return = expected_return;
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(parameters, &params);
    i64 p = 0;
    while (p < params.len()) {
        Binding* param = params.get_ptr(p);
        u32 type_id = typecheck_parameter_type_id(types, param);
        String declared = binding_parameter_type_text(param);
        if (self_type != TYPE_UNKNOWN && strcmp(param.name, "self") == 0
            && declared.len() == 0) {
            type_id = param.declared_type.kind == ProjectionTypeKind.Pointer
                ? types.get_pointer(self_type, true)
                : param.declared_type.kind == ProjectionTypeKind.Reference
                    ? types.get_reference(self_type, param.declared_type.is_mutable)
                    : self_type;
        }
        declared.drop();
        env.insert(symbols.names.intern(param.name), types.resolve_subst(type_id));
        p += 1;
    }
    params.drop();

    ExprLowerer lowerer = ExprLowerer.new(pool, types, &symbols.names);
    lowerer.unit_root = root;
    lowerer.cfg = cfg;
    Vec<u32> stmt_ids = Vec<u32>.new();
    lowerer.lower_block(body, &stmt_ids);
    if (lowerer.unsupported) {
        if (unsupported_out != (bool*)0) {
            *unsupported_out = true;
        }
        if (lowerer.error.len() > 0) {
            diagnostics.error(lowerer.error_span, move lowerer.error);
            *ok = false;
        }
        stmt_ids.drop();
        return;
    }
    // Parameters are the outermost locals; capture them before statements add more.
    Vec<LocalVar> parameter_locals = Vec<LocalVar>.new();
    i64 local_index = 0;
    while (local_index < env.locals.len()) {
        parameter_locals.push(env.locals.get(local_index));
        local_index += 1;
    }
    bool body_ok = true;
    i64 s = 0;
    while (s < stmt_ids.len()) {
        typecheck_statement(pool, types, symbols, root, &env, expected_return, stmt_ids.get(s),
                            diagnostics, &body_ok);
        s += 1;
    }
    // Move flow needs settled types; a body with type errors would only echo them.
    if (!body_ok) {
        *ok = false;
    } else if (!move_flow_check(pool, types, symbols, root, &parameter_locals, &stmt_ids,
                                diagnostics)) {
        *ok = false;
    }
    parameter_locals.drop();
    stmt_ids.drop();
}

/// True when `node` is a `<` token.
bool typecheck_is_less(SyntaxNode* node) {
    return node != (SyntaxNode*)0 && node.kind == NodeKind.Token
        && node.token_kind == TokenKind.Less;
}

/// The type `Self` names in impl `item`: the target with its type arguments
/// (`HashMap<K, V>`, `Result<i64, Error>`) and pointer layers (`impl Record*`).
/// An impl's own type parameters stay opaque.
u32 typecheck_impl_self_type(TypeTable* types, SyntaxNode* item) {
    SyntaxNode* target = impl_target_identifier(item);
    if (target == (SyntaxNode*)0) { return TYPE_UNKNOWN; }
    String target_text = String.from_str(target.text);
    SyntaxNode* arg = target.next_sibling;
    i64 depth = 0;
    while (typecheck_is_less(arg) || (depth > 0 && arg != (SyntaxNode*)0)) {
        if (arg.token_kind == TokenKind.Less) { depth += 1; }
        else if (arg.token_kind == TokenKind.Greater) { depth -= 1; }
        else if (arg.token_kind == TokenKind.RightShift) { depth -= 2; }
        append_node_tokens(arg, &target_text);
        if (arg.token_kind == TokenKind.Comma) { target_text.push((u8)' '); }
        arg = arg.next_sibling;
    }
    u32 self_type = types.parse_type_name(target_text.to_str());
    target_text.drop();
    u32 layer = 0;
    while (layer < impl_target_pointer_depth(item)) {
        self_type = types.get_pointer(self_type, true);
        layer += 1;
    }
    return self_type;
}

/// Type-checks the cfg-active method and `cast` block bodies of an impl,
/// with `Self` bound to the target and its type arguments.
void typecheck_impl_methods(AstPool* pool, SymbolTable* symbols, SyntaxNode* root,
                            SyntaxNode* item, CfgSet* cfg, DiagnosticBag* diagnostics,
                            bool* ok) {
    SyntaxNode* target = impl_target_identifier(item);
    if (target == (SyntaxNode*)0) {
        return;
    }
    SyntaxNode* block = item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) { return; }
    TypeTable* types = &symbols.types;
    u32 self_type = typecheck_impl_self_type(types, item);
    // Receivers wrap the pointee themselves.
    u32 owner = self_type;
    while (types.get(owner).kind == TypeKind.Pointer) { owner = types.get(owner).inner; }
    types.push_subst(types.names.intern("Self"), self_type);
    SyntaxNode* start = block.first_child;
    SyntaxNode* cursor = start;
    while (cursor != (SyntaxNode*)0) {
        SyntaxNode* next = cursor.next_sibling;
        bool member_end = cursor.kind == NodeKind.Token
            && cursor.token_kind == TokenKind.Semicolon;
        if (cursor.kind == NodeKind.Parenthesized && next != (SyntaxNode*)0
            && next.kind == NodeKind.Block) {
            bool is_cast = start.kind == NodeKind.Token
                && (start.token_kind == TokenKind.Cast || strcmp(start.text, "cast") == 0);
            // `cast T(Owner self) { ... }` checks like a method returning `T`.
            SyntaxNode* name = is_cast ? start : item_method_name(start, cursor);
            bool active = name != (SyntaxNode*)0;
            String return_text = String.new();
            SyntaxNode* scan = is_cast ? start.next_sibling : start;
            SyntaxNode* return_end = is_cast ? cursor : name;
            while (active && scan != return_end) {
                bool attribute = scan.kind == NodeKind.Token && strcmp(scan.text, "#") == 0;
                if (attribute && scan.next_sibling != name
                    && scan.next_sibling.kind == NodeKind.Bracket) {
                    scan = scan.next_sibling;
                    SyntaxNode* key = scan.first_child;
                    if (key != (SyntaxNode*)0 && key.kind == NodeKind.Token
                        && strcmp(key.text, "cfg") == 0 && key.next_sibling != (SyntaxNode*)0
                        && key.next_sibling.kind == NodeKind.Parenthesized) {
                        bool malformed = false;
                        cfg_eval_args(key.next_sibling, cfg, &active, &malformed);
                    }
                } else if (!attribute && !(scan.kind == NodeKind.Token
                    && (scan.token_kind == TokenKind.Private || strcmp(scan.text, "pub") == 0
                        || strcmp(scan.text, "static") == 0))) {
                    append_node_tokens(scan, &return_text);
                }
                scan = scan.next_sibling;
            }
            if (active) {
                u32 expected_return = types.resolve_subst(
                    type_id_from_text(types, return_text.to_str()));
                if (expected_return == TYPE_UNKNOWN || expected_return == 0) {
                    expected_return = TYPE_VOID;
                }
                bool function_ok = true;
                bool unsupported = false;
                typecheck_body(pool, types, symbols, root, cursor, next, expected_return,
                               owner, cfg, diagnostics, &function_ok, &unsupported);
                if (unsupported && function_ok) {
                    diagnostics.error(name.span, unchecked_function_body(name.text));
                    function_ok = false;
                }
                if (!function_ok) { *ok = false; }
            }
            member_end = true;
            next = next.next_sibling;
        }
        if (member_end) { start = next; }
        cursor = next;
    }
    types.pop_subst(1);
}

/// True when lowered expression `id` is a literal form the native backend
/// emits as a global's constant: a literal, `-` literal, a cast of either,
/// `@line()`/`@file()`, or an array or struct literal of those.
bool typecheck_constant_initializer(AstPool* pool, u32 id) {
    AstExpr* expr = pool.get_expr(id);
    if (expr.kind == ExprKind.Literal || expr.kind == ExprKind.SourceLocation) { return true; }
    if (expr.kind == ExprKind.Unary) {
        return expr.aux == (u32)TokenKind.Minus
            && pool.get_expr(expr.inner0).kind == ExprKind.Literal;
    }
    if (expr.kind == ExprKind.Cast) {
        ExprKind inner = pool.get_expr(expr.inner0).kind;
        return (inner == ExprKind.Literal || inner == ExprKind.Unary)
            && typecheck_constant_initializer(pool, expr.inner0);
    }
    if (expr.kind != ExprKind.ArrayLit && expr.kind != ExprKind.StructLit) { return false; }
    // Array elements follow a count; struct fields are (name, value) pairs.
    i64 i = 0;
    while (i < (i64)expr.aux) {
        i64 offset = expr.kind == ExprKind.ArrayLit ? 1 + i : i * 2 + 1;
        if (!typecheck_constant_initializer(pool, pool.args.get((i64)expr.inner1 + offset))) {
            return false;
        }
        i += 1;
    }
    return true;
}

/// Lowers global `item` like a local declaration and records its declared
/// type on the symbol so bodies and other globals can read it. With
/// `report`, checks every lowered statement and requires a constant
/// initializer: a struct literal lowers to the `Let` and one assignment per
/// field.
void typecheck_global(AstPool* pool, SymbolTable* symbols, SyntaxNode* root, SyntaxNode* item,
                      bool report, DiagnosticBag* diagnostics, bool* ok) {
    SyntaxNode* start = item.first_child;
    while (start != (SyntaxNode*)0 && start.kind == NodeKind.Token
        && (start.token_kind == TokenKind.Private || strcmp(start.text, "#") == 0)) {
        start = strcmp(start.text, "#") == 0 && start.next_sibling != (SyntaxNode*)0
            ? start.next_sibling.next_sibling : start.next_sibling;
    }
    SyntaxNode* name = item_identifier(item);
    str name_text = name == (SyntaxNode*)0 ? "" : name.text;
    ExprLowerer lowerer = ExprLowerer.new(pool, &symbols.types, &symbols.names);
    lowerer.unit_root = root;
    Vec<u32> stmt_ids = Vec<u32>.new();
    lowerer.lower_block_range(start, (SyntaxNode*)0, &stmt_ids);
    bool shaped = !lowerer.unsupported && stmt_ids.len() > 0
        && pool.get_stmt(stmt_ids.get(0)).kind == StmtKind.Let;
    if (!shaped) {
        if (report) {
            if (lowerer.error.len() > 0) {
                diagnostics.error(lowerer.error_span, move lowerer.error);
            } else {
                diagnostics.error(name == (SyntaxNode*)0 ? item.span : name.span,
                                  unchecked_global_initializer(name_text));
            }
            *ok = false;
        }
        stmt_ids.drop();
        return;
    }
    AstStmt* declaration = pool.get_stmt(stmt_ids.get(0));
    if (name != (SyntaxNode*)0 && declaration.inner0 != TYPE_UNKNOWN) {
        symbols.set_type(name.text, declaration.inner0);
    }
    if (report) {
        TypeEnv env = TypeEnv.new();
        i64 i = 0;
        while (i < stmt_ids.len()) {
            AstStmt* stmt = pool.get_stmt(stmt_ids.get(i));
            u32 value = stmt.kind == StmtKind.Let || stmt.kind == StmtKind.Assign
                ? stmt.inner1 : (u32)0;
            if (value != 0 && !typecheck_constant_initializer(pool, value)) {
                diagnostics.error(pool.get_expr(value).span,
                                  String.from_str(global_initializer_not_constant()));
                *ok = false;
            }
            typecheck_statement(pool, &symbols.types, symbols, root, &env, TYPE_VOID,
                                stmt_ids.get(i), diagnostics, ok);
            i += 1;
        }
    }
    stmt_ids.drop();
}

/// Type-checks cfg-active functions and impl methods, only those from file
/// `file_id_filter` when it is nonzero. Type parameters stay opaque.
bool typecheck_expressions_scoped(AstPool* pool, SymbolTable* symbols, SyntaxTree* tree,
                                  CfgSet* cfg, DiagnosticBag* diagnostics, u32 file_id_filter) {
    bool ok = true;
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    cfg_collect_items(tree.root, cfg, diagnostics, &items);
    // Globals are typed first: any initializer or body may read one, so
    // every declared type is recorded before any initializer is checked.
    i64 pass = 0;
    i64 index = 0;
    while (pass < 2) {
        index = 0;
        while (index < items.len()) {
            SyntaxNode* item = items.get(index);
            if (item.kind == NodeKind.Global) {
                typecheck_global(pool, symbols, tree.root, item, pass == 1
                    && (file_id_filter == 0 || item.span.file == (i64)file_id_filter),
                    diagnostics, &ok);
            }
            index += 1;
        }
        pass += 1;
    }
    index = 0;
    while (index < items.len()) {
        SyntaxNode* item = items.get(index);
        if (file_id_filter == 0 || item.span.file == (i64)file_id_filter) {
            if (symbol_item_is_function(item)) {
                bool function_ok = true;
                bool unsupported = false;
                typecheck_function_statements_scoped(pool, &symbols.types, symbols, tree.root,
                                                     item, cfg, diagnostics, &function_ok,
                                                     &unsupported);
                // A body the checker cannot lower is a limitation, not an
                // accepted body. A macro error already explains it.
                if (unsupported && function_ok) {
                    SyntaxNode* name = function_identifier(item);
                    diagnostics.error(name == (SyntaxNode*)0 ? item.span : name.span,
                        unchecked_function_body(name == (SyntaxNode*)0 ? "" : name.text));
                    function_ok = false;
                }
                if (!function_ok) { ok = false; }
            } else if (item.kind == NodeKind.Impl) {
                typecheck_impl_methods(pool, symbols, tree.root, item, cfg, diagnostics, &ok);
            }
        }
        index += 1;
    }
    items.drop();
    return ok;
}

/// Type-checks the whole program, checking imported extern items for C ABI
/// issues. Temporarily appends the imported items to `tree`'s root so
/// lookups see them, restoring the list before returning.
bool typecheck_expressions(AstPool* pool, SymbolTable* symbols, SyntaxTree* tree,
                           CfgSet* cfg, DiagnosticBag* diagnostics, SyntaxNode* imported_root) {
    SyntaxNode* local_last = tree.root.last_child;
    if (local_last != (SyntaxNode*)0 && imported_root.first_child != (SyntaxNode*)0) {
        drop_root_index(tree.root);
        local_last.next_sibling = imported_root.first_child;
        tree.root.last_child = imported_root.last_child;
    }
    bool ok = true;
    Vec<SyntaxNode*> imported_items = Vec<SyntaxNode*>.new();
    cfg_collect_items(imported_root, cfg, diagnostics, &imported_items);
    i64 imported_index = 0;
    while (imported_index < imported_items.len()) {
        SyntaxNode* item = imported_items.get(imported_index);
        if (item.kind == NodeKind.Extern) {
            callback_abi_check_extern_item(tree.root, &symbols.types, item, diagnostics, &ok);
        }
        imported_index += 1;
    }
    imported_items.drop();
    if (!typecheck_expressions_scoped(pool, symbols, tree, cfg, diagnostics, 0)) { ok = false; }
    drop_root_index(tree.root);
    if (local_last != (SyntaxNode*)0) { local_last.next_sibling = (SyntaxNode*)0; }
    tree.root.last_child = local_last;
    return ok;
}
