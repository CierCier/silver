// Borrow/escape projection over the CST. Places are tracked through field,
// index, and dereference projections; holder liveness is approximated by the
// last syntactic use until a typed CFG borrow pass is available.
import std.mem.vec;
import std.mem.memory;
import std.intern;
import frontend.ast;
import frontend.diagnostics;
import frontend.cfg;
import frontend.place;
import frontend.messages;
import frontend.symbols;
import frontend.expressions;
import frontend.bindings;
import frontend.items;
import frontend.typecheck_expr;
import frontend.types;
bool borrow_text_equals(str left, str right) {
    return strcmp(left, right) == 0;
}

enum LoanKind {
    Shared;
    Mutable;
}

struct Loan {
    u32 name_id;
    Place place;
    u32 holder_id;
    LoanKind kind;
    bool persistent;
    i64 release_index;
    Span span;
    bool active;
}

struct BorrowAnalyzer {
    Interner names;
    Vec<Loan> loans;
    Vec<Projection> projections;
    DiagnosticBag* diagnostics;
    bool failed;
}

impl BorrowAnalyzer {
    BorrowAnalyzer new(DiagnosticBag* diagnostics) {
        BorrowAnalyzer analyzer;
        analyzer.names = Interner.new();
        analyzer.loans = Vec<Loan>.new();
        analyzer.projections = Vec<Projection>.new();
        analyzer.diagnostics = diagnostics;
        analyzer.failed = false;
        return analyzer;
    }

    i64 find_conflict(BorrowAnalyzer* self, Place* target, LoanKind incoming_kind) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && places_overlap(&loan.place, target, &self.projections)) {
                bool old_mutable = loan.kind == LoanKind.Mutable;
                bool new_mutable = incoming_kind == LoanKind.Mutable;
                if (old_mutable || new_mutable) {
                    return i;
                }
            }
            i += 1;
        }
        return -1;
    }

    void conflict(BorrowAnalyzer* self, str name, Span span, Span previous_span, bool incoming_mutable) {
        String message = incoming_mutable
            ? cannot_borrow_as_mutable_while_shared(name)
            : cannot_borrow_as_shared_while_mutable(name);
        String note = String.from_str(incoming_mutable ? note_previous_borrow_here("shared") : note_previous_borrow_here("mutable"));
        self.diagnostics.error_with_note(span, move message, previous_span, move note);
        self.failed = true;
    }

    void add(BorrowAnalyzer* self, Place place, str name, Span span, LoanKind kind, bool persistent, u32 holder_id, i64 release_index) {
        i64 existing = self.find_conflict(&place, kind);
        if (existing >= 0) {
            Loan* loan = self.loans.get_ptr(existing);
            bool old_mutable = loan.kind == LoanKind.Mutable;
            bool new_mutable = kind == LoanKind.Mutable;
            if (old_mutable && new_mutable) {
                String message = cannot_borrow_as_mutable_more_than_once(name);
                String note = note_previous_borrow_here("mutable");
                self.diagnostics.error_with_note(span, move message, loan.span, move note);
                self.failed = true;
            } else if (old_mutable != new_mutable) {
                self.conflict(name, span, loan.span, new_mutable);
            }
        }
        Loan loan;
        loan.name_id = self.names.intern(name);
        loan.place = move place;
        loan.holder_id = holder_id;
        loan.kind = kind;
        loan.persistent = persistent;
        loan.release_index = release_index;
        loan.span = span;
        loan.active = true;
        self.loans.push(move loan);
    }

    void assign_place(BorrowAnalyzer* self, Place* target, str name, Span span) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && places_overlap(&loan.place, target, &self.projections)) {
                String message = cannot_assign_borrowed(name);
                String note = note_previous_borrow_here(loan.kind == LoanKind.Mutable ? "mutable" : "shared");
                self.diagnostics.error_with_note(span, move message, loan.span, move note);
                self.failed = true;
                return;
            }
            i += 1;
        }
    }

    void assign(BorrowAnalyzer* self, str name, Span span) {
        Place p = Place.new(self.names.intern(name));
        self.assign_place(&p, name, span);
    }

    void release_due(BorrowAnalyzer* self, i64 index) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && loan.persistent && loan.release_index <= index) {
                loan.active = false;
            }
            i += 1;
        }
    }


    void end_statement(BorrowAnalyzer* self) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && !loan.persistent) {
                loan.active = false;
            }
            i += 1;
        }
    }
}

void collect_borrow_leaves(SyntaxNode* node, Vec<SyntaxNode*>* leaves) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (node.kind == NodeKind.Token) {
        leaves.push(node);
        return;
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        collect_borrow_leaves(child, leaves);
        child = child.next_sibling;
    }
}

SyntaxNode* borrow_function_body(SyntaxNode* function) {
    SyntaxNode* child = function.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Block) {
            return child;
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

SyntaxNode* borrow_function_parameters(SyntaxNode* function) {
    SyntaxNode* child = function.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Parenthesized) {
            return child;
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

bool is_reference_parameter(SyntaxNode* function, str name) {
    SyntaxNode* parameters = borrow_function_parameters(function);
    if (parameters == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(parameters, &leaves);
    i64 i = 0;
    while (i < leaves.len()) {
        if (leaves.get(i).token_kind == TokenKind.BitwiseAnd) {
            i64 j = i + 1;
            if (j < leaves.len() && borrow_text_equals(leaves.get(j).text, "mut")) {
                j += 1;
            }
            while (j < leaves.len() && borrow_text_equals(leaves.get(j).text, ",") == false) {
                if (leaves.get(j).token_kind == TokenKind.Identifier && borrow_text_equals(leaves.get(j).text, name)) {
                    return true;
                }
                j += 1;
            }
        }
        i += 1;
    }
    return false;
}

bool borrow_is_global(SyntaxTree* tree, SymbolTable* symbols, str name) {
    i64 symbol_index = symbols.find(name);
    if (symbol_index >= 0 && symbols.get(symbol_index).kind == SymbolKind.Global) {
        return true;
    }
    SyntaxNode* item = tree.root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Global) {
            Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
            collect_borrow_leaves(item, &leaves);
            i64 i = 0;
            str declared_name = "";
            while (i < leaves.len()) {
                if (leaves.get(i).token_kind == TokenKind.Assign) {
                    break;
                }
                if (leaves.get(i).token_kind == TokenKind.Identifier) {
                    declared_name = leaves.get(i).text;
                }
                i += 1;
            }
            leaves.drop();
            if (strlen(declared_name) > 0 && borrow_text_equals(declared_name, name)) {
                return true;
            }
        }
        item = item.next_sibling;
    }
    return false;
}

bool borrow_type_contains_reference(TypeTable* types, SyntaxNode* root, u32 type_id, u32 depth) {
    if (depth >= MAX_TYPE_CHECK_DEPTH) { return true; }
    TypeEntry entry = *types.get(types.resolve_subst(type_id));
    if (entry.kind == TypeKind.Reference) { return true; }
    if (entry.kind == TypeKind.Array) {
        return borrow_type_contains_reference(types, root, entry.inner, depth + 1);
    }
    if (entry.kind == TypeKind.Tuple) {
        i64 i = 0;
        while (i < entry.count) {
            if (borrow_type_contains_reference(types, root,
                types.type_args.get(entry.inner + (u32)i), depth + 1)) { return true; }
            i += 1;
        }
        return false;
    }
    if (entry.kind != TypeKind.Named) { return false; }
    SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, types.names.get(entry.name_id));
    if (item != (SyntaxNode*)0) {
        SyntaxNode* body = item.first_child;
        while (body != (SyntaxNode*)0 && body.kind != NodeKind.Block) { body = body.next_sibling; }
        SyntaxNode* cursor = body != (SyntaxNode*)0 ? body.first_child : (SyntaxNode*)0;
        while (cursor != (SyntaxNode*)0) {
            SyntaxNode* name = (SyntaxNode*)0;
            while (cursor != (SyntaxNode*)0 && cursor.token_kind != TokenKind.Semicolon) {
                if (node_is_identifier(cursor)) { name = cursor; }
                cursor = cursor.next_sibling;
            }
            if (name != (SyntaxNode*)0) {
                u32 member = struct_field_type_id(types, item, name.text);
                member = resolve_generic_member_type(types, root, type_id, member);
                if (borrow_type_contains_reference(types, root, member, depth + 1)) { return true; }
            }
            if (cursor != (SyntaxNode*)0) { cursor = cursor.next_sibling; }
        }
        return false;
    }
    i64 i = 0;
    while (i < types.struct_properties.len()) {
        TypeStructProperties definition = types.struct_properties.get(i);
        if (definition.name_id == entry.name_id) {
            u32 field = 0;
            while (field < definition.field_count) {
                u32 member = types.struct_fields.get(definition.field_start + field);
                if (borrow_type_contains_reference(types, root, member, depth + 1)) { return true; }
                field += 1;
            }
            return false;
        }
        i += 1;
    }
    return false;
}

bool borrow_function_returns_indirect(SyntaxNode* function, SymbolTable* symbols) {
    SyntaxNode* name = function_identifier(function);
    if (name == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(function, &leaves);
    i64 name_index = 0;
    while (name_index < leaves.len() && leaves.get(name_index) != name) {
        name_index += 1;
    }
    TypeProjection return_type = projection_parse_type(&leaves, 0, name_index);
    leaves.drop();
    return return_type.kind == ProjectionTypeKind.Pointer
        || return_type.kind == ProjectionTypeKind.Reference
        || borrow_type_contains_reference(&symbols.types, function.parent,
            function_return_type_id(&symbols.types, function), 0);
}

bool borrow_in_return_expression(SyntaxNode* node) {
    SyntaxNode* child = node;
    SyntaxNode* parent = child.parent;
    while (parent != (SyntaxNode*)0 && parent.kind != NodeKind.Function) {
        bool returned = false;
        SyntaxNode* cursor = parent.first_child;
        while (cursor != (SyntaxNode*)0 && cursor != child) {
            if (cursor.token_kind == TokenKind.Return) { returned = true; }
            else if (cursor.token_kind == TokenKind.Semicolon || cursor.kind == NodeKind.Block) {
                returned = false;
            }
            cursor = cursor.next_sibling;
        }
        if (returned) { return true; }
        child = parent;
        parent = parent.parent;
    }
    return false;
}

void report_escape(BorrowAnalyzer* analyzer, SyntaxTree* tree, SymbolTable* symbols,
                   SyntaxNode* function, str name, Span span) {
    if (is_reference_parameter(function, name) || borrow_is_global(tree, symbols, name)) {
        return;
    }
    String message = String.from_str(ref_does_not_outlive_func());
    analyzer.diagnostics.error(span, move message);
    analyzer.failed = true;
}


SyntaxNode* borrow_enclosing_bracket(SyntaxNode* node) {
    SyntaxNode* parent = node.parent;
    while (parent != (SyntaxNode*)0) {
        if (parent.kind == NodeKind.Bracket) {
            return parent;
        }
        parent = parent.parent;
    }
    return (SyntaxNode*)0;
}

bool borrow_node_within(SyntaxNode* node, SyntaxNode* ancestor) {
    SyntaxNode* parent = node;
    while (parent != (SyntaxNode*)0) {
        if (parent == ancestor) {
            return true;
        }
        parent = parent.parent;
    }
    return false;
}

str borrow_aggregate_holder(Vec<Binding>* bindings, Vec<u32>* types,
                            TypeTable* table, SyntaxNode* root, SyntaxNode* node) {
    i64 i = 0;
    while (i < bindings.len()) {
        Binding* binding = bindings.get_ptr(i);
        SyntaxNode* assign = binding.name_node.next_sibling;
        if (assign != (SyntaxNode*)0 && assign.token_kind == TokenKind.Assign) {
            SyntaxNode* value = assign.next_sibling;
            if (value != (SyntaxNode*)0
                && (value.kind == NodeKind.Bracket || value.kind == NodeKind.Block)
                && borrow_node_within(node, value)
                && borrow_type_contains_reference(table, root, types.get(i), 0)) {
                SyntaxNode* parent = node.parent;
                while (parent != value && parent != (SyntaxNode*)0) {
                    SyntaxNode* before = binding_previous_sibling(parent);
                    if (parent.kind == NodeKind.Parenthesized && node_is_identifier(before)) { return ""; }
                    parent = parent.parent;
                }
                return binding.name;
            }
        }
        i += 1;
    }
    return "";
}

str persistent_holder(Vec<SyntaxNode*>* leaves, i64 borrow_index) {
    i64 i = borrow_index - 2;
    while (i >= 0) {
        SyntaxNode* bracket = borrow_enclosing_bracket(leaves.get(i));
        if (bracket != (SyntaxNode*)0) {
            while (i >= 0 && borrow_node_within(leaves.get(i), bracket)) {
                i -= 1;
            }
            continue;
        }
        TokenKind kind = leaves.get(i).token_kind;
        if (kind == TokenKind.Dot) {
            i -= 2;
            continue;
        }
        if (kind == TokenKind.Identifier) {
            // Skip a field name (`.field`) and a value-side type name (`= Type`)
            // so the loan is held by the binding that owns the aggregate.
            bool after_field = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Dot;
            bool after_assign = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Assign;
            if (after_field || after_assign) {
                i -= 2;
                continue;
            }
            return leaves.get(i).text;
        }
        break;
    }
    return "";
}

i64 last_use(Vec<SyntaxNode*>* leaves, i64 start, str holder) {
    i64 last = -1;
    i64 i = start;
    while (i < leaves.len()) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Identifier && borrow_text_equals(node.text, holder)) {
            last = i;
        }
        i += 1;
    }
    return last;
}


void collect_borrow_release_points(SyntaxNode* node, Vec<SyntaxNode*>* leaves, Vec<i64>* points) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (node.kind == NodeKind.Parenthesized) {
        i64 last = -1;
        i64 i = 0;
        while (i < leaves.len()) {
            SyntaxNode* leaf = leaves.get(i);
            if (leaf.span.start >= node.span.start && leaf.span.end <= node.span.end && i > last) {
                last = i;
            }
            i += 1;
        }
        if (last >= 0) {
            points.push(last);
        }
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        collect_borrow_release_points(child, leaves, points);
        child = child.next_sibling;
    }
}

void append_projection(BorrowAnalyzer* analyzer, ProjectionKind kind, str field, u16* count) {
    Projection projection;
    projection.kind = kind;
    projection.field_name_id = kind == ProjectionKind.Field ? analyzer.names.intern(field) : (u32)0;
    analyzer.projections.push(move projection);
    *count = *count + 1;
}

Place borrow_place(BorrowAnalyzer* analyzer, Vec<SyntaxNode*>* leaves, i64 root_index, i64 end_index) {
    SyntaxNode* root = leaves.get(root_index);
    u32 local_id = analyzer.names.intern(root.text);
    u32 projections_start = (u32)analyzer.projections.len();
    u16 projections_count = 0;
    i64 prefix = root_index - 1;
    while (prefix >= 0 && borrow_text_equals(leaves.get(prefix).text, "*")) {
        append_projection(analyzer, ProjectionKind.Deref, "", &projections_count);
        prefix -= 1;
    }
    i64 i = root_index + 1;
    while (i < leaves.len() && i < end_index) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Dot && i + 1 < leaves.len()
            && leaves.get(i + 1).token_kind == TokenKind.Identifier) {
            append_projection(analyzer, ProjectionKind.Field, leaves.get(i + 1).text, &projections_count);
            i += 2;
            continue;
        }
        if (node.token_kind == TokenKind.LeftBracket) {
            append_projection(analyzer, ProjectionKind.Index, "", &projections_count);
            i += 1;
            i64 depth = 1;
            while (i < leaves.len() && depth > 0) {
                if (leaves.get(i).token_kind == TokenKind.LeftBracket) {
                    depth += 1;
                } else if (leaves.get(i).token_kind == TokenKind.RightBracket) {
                    depth -= 1;
                }
                i += 1;
            }
            continue;
        }
        break;
    }
    return Place.with_projections(local_id, projections_start, projections_count);
}

bool borrow_receiver_contains_call(Vec<SyntaxNode*>* leaves, i64 root_index, i64 method_index) {
    i64 i = root_index + 1;
    while (i + 1 < method_index) {
        SyntaxNode* candidate = leaves.get(i);
        if (candidate.kind == NodeKind.Token && candidate.token_kind == TokenKind.Identifier
            && leaves.get(i - 1).token_kind == TokenKind.Dot
            && candidate.next_sibling != (SyntaxNode*)0
            && candidate.next_sibling.kind == NodeKind.Parenthesized) {
            return true;
        }
        i += 1;
    }
    return false;
}

bool borrow_method_args_call_same_receiver(Vec<SyntaxNode*>* leaves,
                                          i64 receiver_root, i64 method_index) {
    SyntaxNode* args = leaves.get(method_index).next_sibling;
    if (args == (SyntaxNode*)0 || args.kind != NodeKind.Parenthesized) {
        return false;
    }
    i64 args_end = -1;
    i64 i = method_index + 1;
    while (i < leaves.len()) {
        SyntaxNode* candidate = leaves.get(i);
        if (candidate.span.start >= args.span.start && candidate.span.end <= args.span.end) {
            args_end = i;
        }
        i += 1;
    }
    i = method_index + 1;
    while (i <= args_end) {
        SyntaxNode* candidate = leaves.get(i);
        if (candidate.token_kind == TokenKind.Identifier && i >= 2
            && leaves.get(i - 1).token_kind == TokenKind.Dot
            && candidate.next_sibling != (SyntaxNode*)0
            && candidate.next_sibling.kind == NodeKind.Parenthesized) {
            i64 nested_root = i - 2;
            while (nested_root >= 2
                && leaves.get(nested_root - 1).token_kind == TokenKind.Dot
                && leaves.get(nested_root - 2).token_kind == TokenKind.Identifier) {
                nested_root -= 2;
            }
            if (borrow_text_equals(leaves.get(nested_root).text,
                                   leaves.get(receiver_root).text)) {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

struct MethodReceiver {
    str receiver_type;
    str method;
    i64 mode;
}

struct MethodReceiverTable {
    Vec<MethodReceiver> entries;
}

impl MethodReceiverTable {
    MethodReceiverTable new() {
        MethodReceiverTable table;
        table.entries = Vec<MethodReceiver>.new();
        return table;
    }

    void register(MethodReceiverTable* self, str receiver_type, str method, i64 mode) {
        if (mode < 1) {
            return;
        }
        i64 i = 0;
        while (i < self.entries.len()) {
            MethodReceiver* entry = self.entries.get_ptr(i);
            if (borrow_text_equals(entry.receiver_type, receiver_type)
                && borrow_text_equals(entry.method, method)) {
                if (mode > entry.mode) {
                    entry.mode = mode;
                }
                return;
            }
            i += 1;
        }
        MethodReceiver entry;
        entry.receiver_type = receiver_type;
        entry.method = method;
        entry.mode = mode;
        self.entries.push(entry);
    }

    i64 get_for_type(MethodReceiverTable* self, str receiver_type, str method) {
        i64 i = 0;
        while (i < self.entries.len()) {
            MethodReceiver* entry = self.entries.get_ptr(i);
            if (borrow_text_equals(entry.receiver_type, receiver_type)
                && borrow_text_equals(entry.method, method)) {
                return entry.mode;
            }
            i += 1;
        }
        return -1;
    }

    i64 get(MethodReceiverTable* self, str method) {
        i64 mode = -1;
        i64 i = 0;
        while (i < self.entries.len()) {
            MethodReceiver* entry = self.entries.get_ptr(i);
            if (borrow_text_equals(entry.method, method) && entry.mode > mode) {
                mode = entry.mode;
            }
            i += 1;
        }
        return mode;
    }
}

void collect_impl_methods_into_table(MethodReceiverTable* table, SyntaxNode* impl_item) {
    if (impl_item == (SyntaxNode*)0 || impl_item.kind != NodeKind.Impl) {
        return;
    }
    SyntaxNode* block = impl_item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return;
    }
    SyntaxNode* target = impl_target_identifier(impl_item);
    str receiver_type = target == (SyntaxNode*)0 ? "" : target.text;

    SyntaxNode* member = block.first_child;
    while (member != (SyntaxNode*)0) {
        if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Semicolon) {
            member = member.next_sibling;
            continue;
        }
        SyntaxNode* name = (SyntaxNode*)0;
        SyntaxNode* params = (SyntaxNode*)0;
        SyntaxNode* scan = member;
        while (scan != (SyntaxNode*)0
            && scan.kind != NodeKind.Block
            && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
            if (scan.kind == NodeKind.Parenthesized) {
                params = scan;
                break;
            }
            if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                name = scan;
            }
            scan = scan.next_sibling;
        }

        if (name != (SyntaxNode*)0 && params != (SyntaxNode*)0) {
            Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
            collect_borrow_leaves(params, &leaves);
            bool has_reference = false;
            bool mutable = false;
            i64 pi = 0;
            while (pi < leaves.len() && leaves.get(pi).token_kind != TokenKind.Comma) {
                if (leaves.get(pi).token_kind == TokenKind.BitwiseAnd) {
                    has_reference = true;
                } else if (leaves.get(pi).token_kind == TokenKind.Mut) {
                    mutable = true;
                } else if (borrow_text_equals(leaves.get(pi).text, "self")) {
                    i64 mode = has_reference ? (mutable ? 2 : 1) : -1;
                    if (mode >= 1) {
                        table.register(receiver_type, name.text, mode);
                    }
                    break;
                }
                pi += 1;
            }
            leaves.drop();
        }

        while (scan != (SyntaxNode*)0
            && scan.kind != NodeKind.Block
            && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
            scan = scan.next_sibling;
        }
        member = scan == (SyntaxNode*)0 ? (SyntaxNode*)0 : scan.next_sibling;
    }
}

str borrow_alias_target(SyntaxTree* tree, SymbolTable* symbols, str name, u32 depth) {
    if (depth >= 32) {
        return "";
    }
    i64 index = symbols.find(name);
    if (index < 0) {
        return name;
    }
    Symbol* symbol = symbols.get(index);
    if (symbol.kind != SymbolKind.TypeAlias || symbol.declaration == (SyntaxNode*)0) {
        return name;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(symbol.declaration, &leaves);
    i64 start = 0;
    while (start < leaves.len() && leaves.get(start).token_kind != TokenKind.Assign) {
        start += 1;
    }
    if (start < leaves.len()) {
        start += 1;
    }
    i64 end = start;
    while (end < leaves.len() && leaves.get(end).token_kind != TokenKind.Semicolon) {
        end += 1;
    }
    TypeProjection target = projection_parse_type(&leaves, start, end);
    str resolved = strlen(target.name) == 0 || borrow_text_equals(target.name, name)
        ? ""
        : borrow_alias_target(tree, symbols, target.name, depth + 1);
    target.argument0.drop();
    target.argument1.drop();
    leaves.drop();
    return resolved;
}

bool borrow_is_transparent_scope_node(SyntaxNode* node) {
    return node.kind != NodeKind.Block && node.kind != NodeKind.If
        && node.kind != NodeKind.While && node.kind != NodeKind.Match
        && node.kind != NodeKind.For && node.kind != NodeKind.Attribute;
}

void borrow_scan_type_brackets(SyntaxNode* node, SyntaxNode* stop, bool* found, bool* done,
                                i64* angle, i64* separators) {
    SyntaxNode* cursor = node.first_child;
    while (cursor != (SyntaxNode*)0 && !*done) {
        if (cursor == stop) {
            *done = true;
            return;
        }
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
            *found = false;
            *angle = 0;
            *separators = 0;
        } else if (cursor.kind == NodeKind.Bracket) {
            *found = true;
        } else if (cursor.kind == NodeKind.Token
            && (cursor.token_kind == TokenKind.LeftBracket
                || cursor.token_kind == TokenKind.RightBracket)) {
            *found = true;
        } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Comma
            && *angle == 1) {
            *separators = *separators + 1;
        } else {
            if (cursor.kind == NodeKind.Token) {
                i64 b = 0;
                while (cursor.text[b] != (u8)0) {
                    if (cursor.text[b] == (u8)60) {
                        *angle = *angle + 1;
                    } else if (cursor.text[b] == (u8)62 && *angle > 0) {
                        *angle = *angle - 1;
                    }
                    b += 1;
                }
            }
            if (borrow_is_transparent_scope_node(cursor)
                && cursor.first_child != (SyntaxNode*)0) {
                borrow_scan_type_brackets(cursor, stop, found, done, angle, separators);
            }
        }
        cursor = cursor.next_sibling;
    }
}

// Declaration projections drop structure the text round-trip cannot
// preserve: `[T]` renders name-only, `[A, B]` splits into two generic
// arguments, and arguments past the second are discarded. Re-parsing that
// text can intern a different type than the declaration, so callers fall
// back to name-based method lookup for those declarations. Fail closed: an
// unrecognized shape also falls back, matching previous behavior.
bool borrow_type_span_has_brackets(SyntaxNode* name_node, bool is_array) {
    if (is_array) {
        return true;
    }
    if (name_node == (SyntaxNode*)0) {
        return true;
    }
    SyntaxNode* node = name_node;
    while (node.parent != (SyntaxNode*)0
        && node.parent.kind != NodeKind.Block
        && node.parent.kind != NodeKind.Function
        && node.parent.kind != NodeKind.Program) {
        node = node.parent;
    }
    if (node.parent == (SyntaxNode*)0) {
        return true;
    }
    SyntaxNode* scan_root = node == name_node ? node.parent : node;
    bool found = false;
    bool done = false;
    i64 angle = 0;
    i64 separators = 0;
    borrow_scan_type_brackets(scan_root, name_node, &found, &done, &angle, &separators);
    return found || separators >= 2;
}

u32 borrow_binding_type(SymbolTable* symbols, Binding* binding) {
    if (binding == (Binding*)0 || binding.declared_type.kind == ProjectionTypeKind.Unknown) {
        return TYPE_UNKNOWN;
    }
    if (borrow_type_span_has_brackets(binding.name_node,
        binding.declared_type.kind == ProjectionTypeKind.Array)) {
        return TYPE_UNKNOWN;
    }
    String type_text = binding_declared_type_text(&binding.declared_type);
    if (binding.declared_type.kind == ProjectionTypeKind.Pointer) {
        type_text.push((u8)'*');
    } else if (binding.declared_type.kind == ProjectionTypeKind.Reference) {
        String reference = String.from_str(binding.declared_type.is_mutable ? "&mut " : "&");
        reference.push_str(type_text.to_str());
        type_text.drop();
        type_text = move reference;
    }
    u32 type_id = symbols.types.parse_type_name(type_text.to_str());
    type_text.drop();
    return type_id;
}

u32 borrow_global_type(SymbolTable* symbols, str name) {
    i64 index = symbols.find(name);
    if (index < 0) {
        return TYPE_UNKNOWN;
    }
    Symbol* symbol = symbols.get(index);
    if (symbol.kind != SymbolKind.Global || symbol.declaration == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(symbol.declaration, &leaves);
    i64 name_index = -1;
    i64 i = 0;
    while (i < leaves.len() && leaves.get(i).token_kind != TokenKind.Assign
        && leaves.get(i).token_kind != TokenKind.Semicolon) {
        if (leaves.get(i).token_kind == TokenKind.Identifier) {
            name_index = i;
        }
        i += 1;
    }
    TypeProjection declared = projection_parse_type(&leaves, 0, name_index);
    if (name_index >= 0
        && borrow_type_span_has_brackets(leaves.get(name_index),
            declared.kind == ProjectionTypeKind.Array)) {
        declared.argument0.drop();
        declared.argument1.drop();
        leaves.drop();
        return TYPE_UNKNOWN;
    }
    String type_text = binding_declared_type_text(&declared);
    if (declared.kind == ProjectionTypeKind.Pointer) {
        type_text.push((u8)'*');
    } else if (declared.kind == ProjectionTypeKind.Reference) {
        String reference = String.from_str(declared.is_mutable ? "&mut " : "&");
        reference.push_str(type_text.to_str());
        type_text.drop();
        type_text = move reference;
    }
    u32 type_id = symbols.types.parse_type_name(type_text.to_str());
    type_text.drop();
    declared.argument0.drop();
    declared.argument1.drop();
    leaves.drop();
    return type_id;
}

str borrow_type_name(TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(types.resolve_subst(type_id));
    while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
        type_id = entry.inner;
        entry = types.get(types.resolve_subst(type_id));
    }
    if (entry.kind != TypeKind.Named) {
        return "";
    }
    return types.names.get(entry.name_id);
}

u32 borrow_inferred_let_type(SymbolTable* symbols, Vec<Binding>* bindings,
                             Binding* binding, u32 depth) {
    if (binding == (Binding*)0 || binding.kind != BindingKind.Let || depth >= 32) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* declaration = binding.name_node;
    if (declaration == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* cursor = declaration.next_sibling;
    while (cursor != (SyntaxNode*)0 && !(cursor.kind == NodeKind.Token
        && cursor.token_kind == TokenKind.Assign)) {
        cursor = cursor.next_sibling;
    }
    if (cursor == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    cursor = cursor.next_sibling;
    if (cursor == (SyntaxNode*)0 || cursor.kind != NodeKind.Token
        || cursor.token_kind != TokenKind.Identifier) {
        return TYPE_UNKNOWN;
    }
    if (cursor.text[0] >= (u8)'A' && cursor.text[0] <= (u8)'Z') {
        String type_text = String.new();
        i64 angle_depth = 0;
        while (cursor != (SyntaxNode*)0) {
            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Less) {
                angle_depth += 1;
            } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Greater
                       && angle_depth > 0) {
                angle_depth -= 1;
            } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Dot
                       && angle_depth == 0) {
                break;
            } else if (cursor.kind == NodeKind.Parenthesized || cursor.kind == NodeKind.Block
                       || (cursor.kind == NodeKind.Token
                           && cursor.token_kind == TokenKind.Semicolon)) {
                break;
            }
            type_text.push_str(cursor.text);
            cursor = cursor.next_sibling;
        }
        u32 type_id = symbols.types.parse_type_name(type_text.to_str());
        type_text.drop();
        return type_id;
    }
    SyntaxNode* after_value = cursor.next_sibling;
    if (after_value != (SyntaxNode*)0 && after_value.kind == NodeKind.Token
        && after_value.token_kind == TokenKind.Semicolon) {
        Binding* source = visible_binding(bindings, cursor.text, cursor);
        if (source != (Binding*)0 && source != binding) {
            u32 source_type = borrow_binding_type(symbols, source);
            if (source_type == TYPE_UNKNOWN) {
                source_type = borrow_inferred_let_type(symbols, bindings, source, depth + 1);
            }
            return source_type;
        }
        return TYPE_UNKNOWN;
    }
    if (after_value == (SyntaxNode*)0 || after_value.kind != NodeKind.Parenthesized) {
        return TYPE_UNKNOWN;
    }
    i64 index = symbols.find(cursor.text);
    if (index < 0 || symbols.get(index).kind != SymbolKind.Function
        || symbols.get(index).declaration == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    i64 overloads = 0;
    i64 symbol_index = 0;
    while (symbol_index < symbols.symbols.len()) {
        Symbol* symbol = symbols.symbols.get_ptr(symbol_index);
        if (symbol.kind == SymbolKind.Function
            && borrow_text_equals(symbols.names.get(symbol.name_id), cursor.text)) {
            overloads += 1;
        }
        symbol_index += 1;
    }
    if (overloads != 1) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* function = symbols.get(index).declaration;
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(function, &leaves);
    SyntaxNode* name = function_identifier(function);
    i64 name_index = 0;
    while (name_index < leaves.len() && leaves.get(name_index) != name) {
        name_index += 1;
    }
    String type_text = String.new();
    i64 i = 0;
    while (i < name_index) {
        type_text.push_str(leaves.get(i).text);
        i += 1;
    }
    u32 type_id = symbols.types.parse_type_name(type_text.to_str());
    type_text.drop();
    leaves.drop();
    return type_id;
}

str borrow_local_receiver_type(SyntaxTree* tree, SymbolTable* symbols,
                               Vec<Binding>* bindings, Binding* visible, str receiver,
                               Vec<SyntaxNode*>* leaves,
                               i64 receiver_root, i64 method_index) {
    u32 receiver_type_id = visible == (Binding*)0
        ? borrow_global_type(symbols, receiver)
        : borrow_binding_type(symbols, visible);
    if (receiver_type_id == TYPE_UNKNOWN && visible != (Binding*)0) {
        receiver_type_id = borrow_inferred_let_type(symbols, bindings, visible, 0);
    }
    str receiver_type = borrow_type_name(&symbols.types, receiver_type_id);
    if (strlen(receiver_type) == 0 && visible != (Binding*)0) {
        receiver_type = visible.declared_type.name;
    }
    str alias_target = borrow_alias_target(tree, symbols, receiver_type, 0);
    if (strlen(alias_target) > 0) {
        receiver_type = alias_target;
        receiver_type_id = symbols.types.parse_type_name(receiver_type);
    }
    i64 part = receiver_root + 1;
    while (part < method_index - 1) {
        if (leaves.get(part).token_kind != TokenKind.Dot
            || leaves.get(part + 1).token_kind != TokenKind.Identifier) {
            receiver_type_id = TYPE_UNKNOWN;
            break;
        }
        receiver_type_id = typecheck_struct_field_type(
            &symbols.types, tree.root, receiver_type_id, leaves.get(part + 1).text);
        if (receiver_type_id == TYPE_UNKNOWN) {
            break;
        }
        part += 2;
    }
    if (receiver_type_id != TYPE_UNKNOWN) {
        receiver_type = borrow_type_name(&symbols.types, receiver_type_id);
    } else {
        receiver_type = "";
    }
    return receiver_type;
}

i64 borrow_method_receiver_kind(SyntaxTree* tree, str method) {
    if (tree == (SyntaxTree*)0 || tree.root == (SyntaxNode*)0) {
        return -1;
    }
    MethodReceiverTable table = MethodReceiverTable.new();
    SyntaxNode* item = tree.root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            collect_impl_methods_into_table(&table, item);
        }
        item = item.next_sibling;
    }
    return table.get(method);
}

void scan_borrows(BorrowAnalyzer* analyzer, SyntaxTree* tree, SymbolTable* symbols,
                  SyntaxNode* function, CfgSet* cfg, MethodReceiverTable* receiver_table) {
    SyntaxNode* body = borrow_function_body(function);
    if (body == (SyntaxNode*)0) {
        return;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    cfg_collect_live_leaves(body, cfg, &leaves);
    Vec<Binding> bindings = Vec<Binding>.new();
    collect_function_bindings(function, &bindings);
    Vec<u32> binding_types = Vec<u32>.new();
    typecheck_binding_types(symbols, tree.root, &bindings, &binding_types);
    Vec<i64> release_points = Vec<i64>.new();
    collect_borrow_release_points(body, &leaves, &release_points);
    i64 i = 0;
    while (i < leaves.len()) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Assign && i > 0 && i + 1 < leaves.len()
            && leaves.get(i - 1).token_kind == TokenKind.Identifier
            && !(i >= 2 && leaves.get(i - 2).token_kind == TokenKind.Dot)) {
            i64 source_index = i + 1;
            if (leaves.get(source_index).token_kind == TokenKind.Move) { source_index += 1; }
            if (source_index < leaves.len()) {
                SyntaxNode* source = leaves.get(source_index);
                SyntaxNode* after = source.next_sibling;
                if (source.token_kind == TokenKind.Identifier && after != (SyntaxNode*)0
                    && after.token_kind == TokenKind.Semicolon) {
                    str destination = leaves.get(i - 1).text;
                    u32 source_id = analyzer.names.intern(source.text);
                    u32 destination_id = analyzer.names.intern(destination);
                    i64 release = last_use(&leaves, source_index + 1, destination);
                    i64 count = analyzer.loans.len();
                    i64 loan_index = 0;
                    while (loan_index < count) {
                        Loan inherited = analyzer.loans.get(loan_index);
                        if (inherited.active && inherited.persistent && inherited.holder_id == source_id
                            && source_id != destination_id) {
                            inherited.holder_id = destination_id;
                            inherited.release_index = release >= 0 ? release : source_index;
                            analyzer.loans.push(inherited);
                        }
                        loan_index += 1;
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Identifier && i + 1 < leaves.len()) {
            bool is_field = i > 0 && borrow_text_equals(leaves.get(i - 1).text, ".");
            if (!is_field) {
                str next = leaves.get(i + 1).text;
                if (borrow_text_equals(next, "=") || borrow_text_equals(next, "+=") || borrow_text_equals(next, "-=") || borrow_text_equals(next, "*=") || borrow_text_equals(next, "/=") || borrow_text_equals(next, "%=")) {
                    analyzer.assign(node.text, node.span);
                } else {
                    bool address = i > 0 && leaves.get(i - 1).token_kind == TokenKind.BitwiseAnd;
                    address = address || (i >= 2 && leaves.get(i - 1).token_kind == TokenKind.Mut
                        && leaves.get(i - 2).token_kind == TokenKind.BitwiseAnd);
                    if (!address) {
                        Place place = borrow_place(analyzer, &leaves, i, leaves.len());
                        bool consuming = false;
                        if (i > 0 && leaves.get(i - 1).token_kind == TokenKind.Move) {
                            Binding* binding = visible_binding(&bindings, node.text, node);
                            u32 type_id = borrow_binding_type(symbols, binding);
                            if (type_id == TYPE_UNKNOWN) {
                                type_id = typecheck_resolved_binding_type(&bindings, &binding_types, binding);
                            }
                            consuming = type_id == TYPE_UNKNOWN
                                || !typecheck_type_is_copy(tree.root, &symbols.types, type_id);
                        }
                        i64 conflict = analyzer.find_conflict(&place,
                            consuming ? LoanKind.Mutable : LoanKind.Shared);
                        if (conflict >= 0) {
                            Loan* loan = analyzer.loans.get_ptr(conflict);
                            if (consuming) {
                                analyzer.diagnostics.error_with_note(node.span, cannot_move_borrowed(node.text),
                                    loan.span, note_previous_borrow_here(
                                        loan.kind == LoanKind.Mutable ? "mutable" : "shared"));
                                analyzer.failed = true;
                            } else {
                                analyzer.conflict(node.text, node.span, loan.span, false);
                            }
                        }
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Identifier && i >= 2
            && leaves.get(i - 1).token_kind == TokenKind.Dot
            && leaves.get(i - 2).token_kind == TokenKind.Identifier
            && node.next_sibling != (SyntaxNode*)0
            && node.next_sibling.kind == NodeKind.Parenthesized) {
            i64 receiver_root = i - 2;
            while (receiver_root >= 2 && leaves.get(receiver_root - 1).token_kind == TokenKind.Dot
                && leaves.get(receiver_root - 2).token_kind == TokenKind.Identifier) {
                receiver_root -= 2;
            }
            Binding* receiver_binding = visible_binding(
                &bindings, leaves.get(receiver_root).text, leaves.get(receiver_root));
            str receiver_type = borrow_local_receiver_type(
                tree, symbols, &bindings, receiver_binding,
                leaves.get(receiver_root).text, &leaves, receiver_root, i);
            i64 receiver_mode = strlen(receiver_type) > 0
                ? receiver_table.get_for_type(receiver_type, node.text)
                : receiver_table.get(node.text);
            bool shared_call_argument = receiver_mode == 2
                && borrow_method_args_call_same_receiver(&leaves, receiver_root, i);
            if (receiver_mode >= 1
                && !borrow_receiver_contains_call(&leaves, receiver_root, i)
                && !shared_call_argument) {
                Place receiver = borrow_place(analyzer, &leaves, receiver_root, i - 1);
                LoanKind receiver_kind = receiver_mode == 2 ? LoanKind.Mutable : LoanKind.Shared;
                analyzer.add(move receiver, leaves.get(receiver_root).text, leaves.get(receiver_root).span,
                    receiver_kind, false, (u32)0, i);
            }
        }
        if (node.token_kind == TokenKind.Return) {
            i64 j = i + 1;
            if (j < leaves.len() && leaves.get(j).token_kind == TokenKind.Move) { j += 1; }
            if (borrow_function_returns_indirect(function, symbols)
                && j < leaves.len() && leaves.get(j).token_kind == TokenKind.BitwiseAnd) {
                j += 1;
                if (j < leaves.len() && borrow_text_equals(leaves.get(j).text, "mut")) {
                    j += 1;
                }
                if (j < leaves.len() && leaves.get(j).token_kind == TokenKind.Identifier) {
                    report_escape(analyzer, tree, symbols, function, leaves.get(j).text, leaves.get(j).span);
                }
            } else if (borrow_function_returns_indirect(function, symbols)
                && j < leaves.len() && leaves.get(j).token_kind == TokenKind.Identifier) {
                u32 holder_id = analyzer.names.intern(leaves.get(j).text);
                i64 loan_index = 0;
                while (loan_index < analyzer.loans.len()) {
                    Loan* loan = analyzer.loans.get_ptr(loan_index);
                    if (loan.active && loan.persistent && loan.holder_id == holder_id) {
                        str source = analyzer.names.get(loan.place.local_id);
                        report_escape(analyzer, tree, symbols, function, source, leaves.get(j).span);
                    }
                    loan_index += 1;
                }
            }
        }
        if (node.token_kind == TokenKind.BitwiseAnd) {
            bool expression_position = i > 0;
            if (i > 0) {
                str previous = leaves.get(i - 1).text;
                expression_position = borrow_text_equals(previous, "=") || borrow_text_equals(previous, "(") || borrow_text_equals(previous, ",") || borrow_text_equals(previous, "return") || leaves.get(i - 1).token_kind == TokenKind.Identifier;
            }
            if (expression_position) {
                i64 j = i + 1;
                bool mutable = false;
                if (j < leaves.len() && borrow_text_equals(leaves.get(j).text, "mut")) {
                    mutable = true;
                    j += 1;
                }
                if (j < leaves.len() && leaves.get(j).token_kind == TokenKind.Identifier) {
                    str name = leaves.get(j).text;
                    if (borrow_in_return_expression(node)
                        && borrow_function_returns_indirect(function, symbols)) {
                        report_escape(analyzer, tree, symbols, function, name, leaves.get(j).span);
                    }
                    Place place = borrow_place(analyzer, &leaves, j, leaves.len());
                    bool persistent = i > 0 && borrow_text_equals(leaves.get(i - 1).text, "=");
                    str aggregate_holder = borrow_aggregate_holder(&bindings,
                        &binding_types, &symbols.types, tree.root, node);
                    persistent = persistent || strlen(aggregate_holder) > 0;
                    LoanKind kind = LoanKind.Shared;
                    if (mutable) {
                        kind = LoanKind.Mutable;
                    }
                    u32 holder_id = (u32)0;
                    i64 release_index = leaves.len();
                    if (persistent) {
                        str holder = strlen(aggregate_holder) > 0
                            ? aggregate_holder : persistent_holder(&leaves, i);
                        if (strlen(holder) > 0) {
                            holder_id = analyzer.names.intern(holder);
                            i64 use_index = last_use(&leaves, i + 1, holder);
                            release_index = use_index >= 0 ? use_index : leaves.len();
                        }
                        else {
                            release_index = i;
                        }
                    }
                    if (persistent && i >= 2 && borrow_text_equals(leaves.get(i - 1).text, "=")
                        && borrow_is_global(tree, symbols, leaves.get(i - 2).text)) {
                        report_escape(analyzer, tree, symbols, function, name, leaves.get(j).span);
                    }
                    analyzer.add(move place, name, leaves.get(j).span, kind, persistent, holder_id, release_index);
                }
            }
        }
        if (node.token_kind == TokenKind.Semicolon) {
            analyzer.end_statement();
        }
        i64 point = 0;
        while (point < release_points.len()) {
            if (release_points.get(point) == i) {
                analyzer.end_statement();
            }
            point += 1;
        }
        analyzer.release_due(i);
        i += 1;
    }
    bindings.drop();
    release_points.drop();
    leaves.drop();
}

bool check_borrows(SyntaxTree* tree, SymbolTable* symbols, DiagnosticBag* diagnostics, CfgSet* cfg) {
    bool ok = true;
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    cfg_collect_items(tree.root, cfg, diagnostics, &items);

    MethodReceiverTable receiver_table = MethodReceiverTable.new();
    i64 idx = 0;
    while (idx < items.len()) {
        SyntaxNode* item = items.get(idx);
        if (item.kind == NodeKind.Impl) {
            collect_impl_methods_into_table(&receiver_table, item);
        }
        idx += 1;
    }

    i64 i = 0;
    while (i < items.len()) {
        if (items.get(i).kind == NodeKind.Function) {
            BorrowAnalyzer analyzer = BorrowAnalyzer.new(diagnostics);
            scan_borrows(&analyzer, tree, symbols, items.get(i), cfg, &receiver_table);
            if (analyzer.failed) {
                ok = false;
            }
        }
        i += 1;
    }
    items.drop();
    return ok;
}
