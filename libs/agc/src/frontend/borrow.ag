// Borrow/escape projection over the CST. Places are tracked through field,
// index, and dereference projections; holder liveness is approximated by the
// last syntactic use until a typed CFG borrow pass is available.
import std.mem.vec;
import std.mem.memory;
import std.intern;
import frontend.ast;
import frontend.diagnostics;
import frontend.cfg;
import frontend.place;
import frontend.messages;
import frontend.scoped_launch;
import frontend.sync_sugar;
import frontend.symbols;
import frontend.expressions;
import frontend.bindings;
import frontend.items;
import frontend.typecheck_expr;
import frontend.types;
/// Returns true when the strings are equal.
bool borrow_text_equals(str left, str right) {
    return strcmp(left, right) == 0;
}

/// Returns true when a `return` belongs to a nested function or lambda
/// rather than `function`'s own body.
bool borrow_return_is_nested(SyntaxNode* return_node, SyntaxNode* function,
                             SyntaxNode* body) {
    SyntaxNode* cursor = return_node;
    while (cursor != (SyntaxNode*)0 && cursor != function) {
        if (cursor.kind == NodeKind.Function && cursor != function) { return true; }
        if (cursor.kind == NodeKind.Block && cursor != body) {
            SyntaxNode* arrow = binding_previous_sibling(cursor);
            SyntaxNode* head = arrow != (SyntaxNode*)0
                ? binding_previous_sibling(arrow) : (SyntaxNode*)0;
            if (arrow != (SyntaxNode*)0 && arrow.token_kind == TokenKind.FatArrow
                && head != (SyntaxNode*)0 && head.kind == NodeKind.Parenthesized) {
                return true;
            }
        }
        cursor = cursor.parent;
    }
    return false;
}

/// The note at a loan's origin: the lock block that holds it, or the borrow.
String borrow_loan_note(Loan* loan) {
    if (loan.lock_guard) { return note_locked_here(); }
    return note_previous_borrow_here(loan.kind == LoanKind.Mutable ? "mutable" : "shared");
}

/// Whether a loan is a shared (`&`) or mutable (`&mut`) borrow.
enum LoanKind {
    Shared;
    Mutable;
}

/// One active borrow of a place. A persistent loan lives until its holder's
/// last use (`release_index`); others end with the statement. A task loan is
/// held by a scoped launch until its task is joined. A lock-guard loan is a
/// task loan held by a `lock` block's guard on the place it locks, until the
/// block ends: the guard points into that place.
struct Loan {
    u32 name_id;
    Place place;
    u32 holder_id;
    i64 holder_binding_start;
    LoanKind kind;
    bool persistent;
    i64 release_index;
    Span span;
    SyntaxNode* owner_scope;
    bool active;
    bool task;
    bool lock_guard;
}

/// A function whose return value may borrow parameter `parameter_index`.
struct BorrowReturnOrigin {
    SyntaxNode* function;
    i64 parameter_index;
}

/// What is known about a function's returned references: whether some
/// origin is unknown inside it or it is an opaque external function.
struct BorrowReturnStatus {
    SyntaxNode* function;
    bool unknown_internal;
    bool opaque_external;
}

/// Borrow-check state: active loans, projection storage, and where
/// conflicts are reported. `failed` is set by any report.
struct BorrowAnalyzer {
    Interner names;
    Vec<Loan> loans;
    Vec<Projection> projections;
    DiagnosticBag* diagnostics;
    bool failed;
}

impl BorrowAnalyzer {
    /// Creates an analyzer; name id 0 is reserved for "no holder".
    BorrowAnalyzer new(DiagnosticBag* diagnostics) {
        BorrowAnalyzer analyzer;
        analyzer.names = Interner.new();
        // Loan holder id zero is reserved for an absent holder.
        analyzer.names.intern("");
        analyzer.loans = Vec<Loan>.new();
        analyzer.projections = Vec<Projection>.new();
        analyzer.diagnostics = diagnostics;
        analyzer.failed = false;
        return analyzer;
    }

    /// Returns the index of an active loan that conflicts with a new
    /// `incoming_kind` borrow of `target` (any overlap with a mutable side), or -1.
    i64 find_conflict(BorrowAnalyzer* self, Place* target, LoanKind incoming_kind) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && places_overlap(&loan.place, target, &self.projections)) {
                bool old_mutable = loan.kind == LoanKind.Mutable;
                bool new_mutable = incoming_kind == LoanKind.Mutable;
                if (old_mutable || new_mutable) {
                    return i;
                }
            }
            i += 1;
        }
        return -1;
    }

    /// Appends the two ways to share a place between threads, for the user
    /// to choose from, when `loan` belongs to a launched task.
    void add_thread_help(BorrowAnalyzer* self, String* message, Loan* loan) {
        if (!loan.task || loan.lock_guard) { return; }
        String help = thread_share_help(self.names.get(loan.name_id));
        message.push_str(help.to_str());
        help.drop();
    }

    /// Reports a shared/mutable borrow conflict with a note at the earlier loan.
    void conflict(BorrowAnalyzer* self, str name, Span span, Loan* previous, bool incoming_mutable) {
        String message = incoming_mutable
            ? cannot_borrow_as_mutable_while_shared(name)
            : cannot_borrow_as_shared_while_mutable(name);
        self.add_thread_help(&message, previous);
        String note = String.from_str(incoming_mutable ? note_previous_borrow_here("shared") : note_previous_borrow_here("mutable"));
        self.diagnostics.error_with_note(span, move message, previous.span, move note);
        self.failed = true;
    }

    /// Records a loan of `place`, reporting a conflict with an existing one.
    void add(BorrowAnalyzer* self, Place place, str name, Span span, LoanKind kind, bool persistent, u32 holder_id, i64 release_index) {
        i64 existing = self.find_conflict(&place, kind);
        if (existing >= 0) {
            Loan* loan = self.loans.get_ptr(existing);
            bool old_mutable = loan.kind == LoanKind.Mutable;
            bool new_mutable = kind == LoanKind.Mutable;
            if (old_mutable && new_mutable) {
                String message = cannot_borrow_as_mutable_more_than_once(name);
                self.add_thread_help(&message, loan);
                String note = note_previous_borrow_here("mutable");
                self.diagnostics.error_with_note(span, move message, loan.span, move note);
                self.failed = true;
            } else if (old_mutable != new_mutable) {
                self.conflict(name, span, loan, new_mutable);
            }
        }
        Loan loan;
        loan.name_id = self.names.intern(name);
        loan.place = move place;
        loan.holder_id = holder_id;
        loan.holder_binding_start = 0;
        loan.kind = kind;
        loan.persistent = persistent;
        loan.release_index = release_index;
        loan.span = span;
        loan.owner_scope = (SyntaxNode*)0;
        loan.active = true;
        loan.task = false;
        loan.lock_guard = false;
        self.loans.push(move loan);
    }

    /// Returns the index of an active task loan that overlaps `target`, or -1.
    i64 find_task_loan(BorrowAnalyzer* self, Place* target) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && loan.task
                && places_overlap(&loan.place, target, &self.projections)) {
                return i;
            }
            i += 1;
        }
        return -1;
    }

    /// Reports assigning to a place while it is borrowed.
    void assign_place(BorrowAnalyzer* self, Place* target, str name, Span span) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && places_overlap(&loan.place, target, &self.projections)) {
                String message = cannot_assign_borrowed(name);
                self.add_thread_help(&message, loan);
                self.diagnostics.error_with_note(span, move message, loan.span, borrow_loan_note(loan));
                self.failed = true;
                return;
            }
            i += 1;
        }
    }

    /// Reports assigning to local `name` while it is borrowed.
    void assign(BorrowAnalyzer* self, str name, Span span) {
        Place p = Place.new(self.names.intern(name));
        self.assign_place(&p, name, span);
    }

    /// Ends persistent loans whose holder's last use is at or before `index`.
    void release_due(BorrowAnalyzer* self, i64 index) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && loan.persistent && loan.release_index <= index) {
                loan.active = false;
            }
            i += 1;
        }
    }


    /// Ends every non-persistent loan at a statement boundary.
    void end_statement(BorrowAnalyzer* self) {
        i64 i = 0;
        while (i < self.loans.len()) {
            Loan* loan = self.loans.get_ptr(i);
            if (loan.active && !loan.persistent) {
                loan.active = false;
            }
            i += 1;
        }
    }
}

/// Appends every leaf token under `node`.
void collect_borrow_leaves(SyntaxNode* node, Vec<SyntaxNode*>* leaves) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (node.kind == NodeKind.Token) {
        leaves.push(node);
        return;
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        collect_borrow_leaves(child, leaves);
        child = child.next_sibling;
    }
}

/// Returns a function item's body block, or null.
SyntaxNode* borrow_function_body(SyntaxNode* function) {
    SyntaxNode* child = function.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Block) {
            return child;
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

/// Returns a function item's parameter list, or null.
SyntaxNode* borrow_function_parameters(SyntaxNode* function) {
    SyntaxNode* child = function.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Parenthesized) {
            return child;
        }
        child = child.next_sibling;
    }
    return (SyntaxNode*)0;
}

/// Returns true when parameter `name` of `function` is `&T` or `&mut T`.
bool is_reference_parameter(SyntaxNode* function, str name) {
    SyntaxNode* parameters = borrow_function_parameters(function);
    if (parameters == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(parameters, &leaves);
    i64 i = 0;
    while (i < leaves.len()) {
        if (leaves.get(i).token_kind == TokenKind.BitwiseAnd) {
            i64 j = i + 1;
            if (j < leaves.len() && borrow_text_equals(leaves.get(j).text, "mut")) {
                j += 1;
            }
            while (j < leaves.len() && borrow_text_equals(leaves.get(j).text, ",") == false) {
                if (leaves.get(j).token_kind == TokenKind.Identifier && borrow_text_equals(leaves.get(j).text, name)) {
                    return true;
                }
                j += 1;
            }
        }
        i += 1;
    }
    return false;
}

/// Returns true when `name` is a global variable.
bool borrow_is_global(SyntaxTree* tree, SymbolTable* symbols, str name) {
    i64 symbol_index = symbols.find(name);
    if (symbol_index >= 0 && symbols.get(symbol_index).kind == SymbolKind.Global) {
        return true;
    }
    SyntaxNode* item = tree.root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Global) {
            Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
            collect_borrow_leaves(item, &leaves);
            i64 i = 0;
            str declared_name = "";
            while (i < leaves.len()) {
                if (leaves.get(i).token_kind == TokenKind.Assign) {
                    break;
                }
                if (leaves.get(i).token_kind == TokenKind.Identifier) {
                    declared_name = leaves.get(i).text;
                }
                i += 1;
            }
            leaves.drop();
            if (strlen(declared_name) > 0 && borrow_text_equals(declared_name, name)) {
                return true;
            }
        }
        item = item.next_sibling;
    }
    return false;
}

/// Returns true when a type contains a reference, directly or through
/// fields. Too-deep types count as containing one.
bool borrow_type_contains_reference(TypeTable* types, SyntaxNode* root, u32 type_id, u32 depth) {
    if (depth >= MAX_TYPE_CHECK_DEPTH) { return true; }
    TypeEntry entry = *types.get(types.resolve_subst(type_id));
    if (entry.kind == TypeKind.Reference) { return true; }
    if (entry.kind == TypeKind.Array) {
        return borrow_type_contains_reference(types, root, entry.inner, depth + 1);
    }
    if (entry.kind == TypeKind.Tuple) {
        i64 i = 0;
        while (i < entry.count) {
            if (borrow_type_contains_reference(types, root,
                types.type_args.get(entry.inner + (u32)i), depth + 1)) { return true; }
            i += 1;
        }
        return false;
    }
    if (entry.kind != TypeKind.Named) { return false; }
    str type_name = types.names.get(entry.name_id);
    SyntaxNode* enum_item = find_enum_item(root, type_name);
    if (enum_item != (SyntaxNode*)0) {
        Vec<SyntaxNode*> variants = Vec<SyntaxNode*>.new();
        Vec<i64> tags = Vec<i64>.new();
        Vec<i64> arities = Vec<i64>.new();
        enum_each_variant(enum_item, &variants, &tags, &arities);
        bool found = false;
        i64 vi = 0;
        while (!found && vi < variants.len()) {
            i64 pi = 0;
            while (!found && pi < arities.get(vi)) {
                String payload_text = String.new();
                if (enum_payload_type_text(root, type_name, variants.get(vi).text, pi, &payload_text)) {
                    u32 payload = type_id_from_text(types, payload_text.to_str());
                    payload = resolve_generic_member_type(types, root, type_id, payload);
                    found = borrow_type_contains_reference(types, root, payload, depth + 1);
                }
                payload_text.drop();
                pi += 1;
            }
            vi += 1;
        }
        variants.drop();
        tags.drop();
        arities.drop();
        return found;
    }
    SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, type_name);
    if (item != (SyntaxNode*)0) {
        SyntaxNode* body = item.first_child;
        while (body != (SyntaxNode*)0 && body.kind != NodeKind.Block) { body = body.next_sibling; }
        SyntaxNode* cursor = body != (SyntaxNode*)0 ? body.first_child : (SyntaxNode*)0;
        while (cursor != (SyntaxNode*)0) {
            SyntaxNode* name = (SyntaxNode*)0;
            while (cursor != (SyntaxNode*)0 && cursor.token_kind != TokenKind.Semicolon) {
                if (node_is_identifier(cursor)) { name = cursor; }
                cursor = cursor.next_sibling;
            }
            if (name != (SyntaxNode*)0) {
                u32 member = struct_field_type_id(types, item, name.text);
                member = resolve_generic_member_type(types, root, type_id, member);
                if (borrow_type_contains_reference(types, root, member, depth + 1)) { return true; }
            }
            if (cursor != (SyntaxNode*)0) { cursor = cursor.next_sibling; }
        }
        return false;
    }
    i64 i = 0;
    while (i < types.struct_properties.len()) {
        TypeStructProperties definition = types.struct_properties.get(i);
        if (definition.name_id == entry.name_id) {
            u32 field = 0;
            while (field < definition.field_count) {
                u32 member = types.struct_fields.get(definition.field_start + field);
                if (borrow_type_contains_reference(types, root, member, depth + 1)) { return true; }
                field += 1;
            }
            return false;
        }
        i += 1;
    }
    return false;
}

/// Returns true when the function returns a reference, pointer, or a type
/// containing a reference.
bool borrow_function_returns_indirect(SyntaxNode* function, SymbolTable* symbols) {
    SyntaxNode* name = function_identifier(function);
    if (name == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(function, &leaves);
    i64 name_index = 0;
    while (name_index < leaves.len() && leaves.get(name_index) != name) {
        name_index += 1;
    }
    TypeProjection return_type = projection_parse_type(&leaves, 0, name_index);
    leaves.drop();
    return return_type.kind == ProjectionTypeKind.Pointer
        || return_type.kind == ProjectionTypeKind.Reference
        || borrow_type_contains_reference(&symbols.types, function.parent,
            function_return_type_id(&symbols.types, function), 0);
}

/// Returns true when `node` is inside a `return` expression.
bool borrow_in_return_expression(SyntaxNode* node) {
    SyntaxNode* child = node;
    SyntaxNode* parent = child.parent;
    while (parent != (SyntaxNode*)0 && parent.kind != NodeKind.Function) {
        bool returned = false;
        SyntaxNode* cursor = parent.first_child;
        while (cursor != (SyntaxNode*)0 && cursor != child) {
            if (cursor.token_kind == TokenKind.Return) { returned = true; }
            else if (cursor.token_kind == TokenKind.Semicolon || cursor.kind == NodeKind.Block) {
                returned = false;
            }
            cursor = cursor.next_sibling;
        }
        if (returned) { return true; }
        child = parent;
        parent = parent.parent;
    }
    return false;
}

/// Reports returning a reference to local `name` that does not outlive
/// `function`.
void report_escape(BorrowAnalyzer* analyzer, SyntaxTree* tree, SymbolTable* symbols,
                   SyntaxNode* function, str name, Span span) {
    if (is_reference_parameter(function, name)
        || borrow_is_global(tree, symbols, name)) {
        return;
    }
    String message = String.from_str(ref_does_not_outlive_func());
    analyzer.diagnostics.error(span, move message);
    analyzer.failed = true;
}


/// Returns the nearest enclosing bracket group, or null.
SyntaxNode* borrow_enclosing_bracket(SyntaxNode* node) {
    SyntaxNode* parent = node.parent;
    while (parent != (SyntaxNode*)0) {
        if (parent.kind == NodeKind.Bracket) {
            return parent;
        }
        parent = parent.parent;
    }
    return (SyntaxNode*)0;
}

/// Returns true when `node` is `ancestor` or inside it.
bool borrow_node_within(SyntaxNode* node, SyntaxNode* ancestor) {
    SyntaxNode* parent = node;
    while (parent != (SyntaxNode*)0) {
        if (parent == ancestor) {
            return true;
        }
        parent = parent.parent;
    }
    return false;
}

/// Type of the slot in aggregate initializer `value` whose expression contains
/// `node`, or TYPE_UNKNOWN when the slot cannot be resolved.
u32 borrow_aggregate_slot_type(TypeTable* table, SyntaxNode* root, u32 aggregate_type,
                               SyntaxNode* value, SyntaxNode* node) {
    SyntaxNode* top = node;
    while (top != (SyntaxNode*)0 && top.parent != value) { top = top.parent; }
    if (top == (SyntaxNode*)0) { return TYPE_UNKNOWN; }
    i64 index = 0;
    SyntaxNode* start = value.first_child;
    SyntaxNode* cursor = value.first_child;
    while (cursor != (SyntaxNode*)0 && cursor != top) {
        if (cursor.token_kind == TokenKind.Comma) {
            index += 1;
            start = cursor.next_sibling;
        }
        cursor = cursor.next_sibling;
    }
    TypeEntry entry = *table.get(table.resolve_subst(aggregate_type));
    SyntaxNode* field = start != (SyntaxNode*)0 ? start.next_sibling : (SyntaxNode*)0;
    if (start != (SyntaxNode*)0 && start.kind == NodeKind.Token && borrow_text_equals(start.text, ".")
        && node_is_identifier(field)) {
        if (entry.kind != TypeKind.Named) { return TYPE_UNKNOWN; }
        SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, table.names.get(entry.name_id));
        u32 member = struct_field_type_id(table, item, field.text);
        if (member == TYPE_UNKNOWN) { return TYPE_UNKNOWN; }
        return resolve_generic_member_type(table, root, aggregate_type, member);
    }
    if (entry.kind == TypeKind.Array) { return entry.inner; }
    if (entry.kind == TypeKind.Tuple && index < entry.count) {
        return table.type_args.get(entry.inner + (u32)index);
    }
    return TYPE_UNKNOWN;
}

/// Returns the local that holds an aggregate initializer containing `node`,
/// when its slot type keeps a reference; otherwise "".
str borrow_aggregate_holder(Vec<Binding>* bindings, Vec<u32>* types,
                            TypeTable* table, SyntaxNode* root, SyntaxNode* node) {
    i64 i = 0;
    while (i < bindings.len()) {
        Binding* binding = bindings.get_ptr(i);
        SyntaxNode* assign = binding.name_node.next_sibling;
        if (assign != (SyntaxNode*)0 && assign.token_kind == TokenKind.Assign) {
            SyntaxNode* value = assign.next_sibling;
            if (value != (SyntaxNode*)0
                && (value.kind == NodeKind.Bracket || value.kind == NodeKind.Block)
                && borrow_node_within(node, value)
                && borrow_type_contains_reference(table, root, types.get(i), 0)) {
                // Uses in non-reference slots (e.g. `*view` stored as an integer)
                // do not keep their loans alive through the aggregate.
                u32 slot = borrow_aggregate_slot_type(table, root, types.get(i), value, node);
                if (slot != TYPE_UNKNOWN && !borrow_type_contains_reference(table, root, slot, 0)) {
                    return "";
                }
                SyntaxNode* parent = node.parent;
                while (parent != value && parent != (SyntaxNode*)0) {
                    SyntaxNode* before = binding_previous_sibling(parent);
                    if (parent.kind == NodeKind.Parenthesized && node_is_identifier(before)) { return ""; }
                    parent = parent.parent;
                }
                return binding.name;
            }
        }
        i += 1;
    }
    return "";
}

/// Returns the local a borrow at `borrow_index` is stored into (`x = &y`),
/// or "" when the borrow is temporary.
str persistent_holder(Vec<SyntaxNode*>* leaves, i64 borrow_index) {
    i64 i = borrow_index - 2;
    while (i >= 0) {
        SyntaxNode* bracket = borrow_enclosing_bracket(leaves.get(i));
        if (bracket != (SyntaxNode*)0) {
            while (i >= 0 && borrow_node_within(leaves.get(i), bracket)) {
                i -= 1;
            }
            continue;
        }
        TokenKind kind = leaves.get(i).token_kind;
        if (kind == TokenKind.Dot) {
            i -= 2;
            continue;
        }
        if (kind == TokenKind.Identifier) {
            // Skip a field name (`.field`) and a value-side type name (`= Type`)
            // so the loan is held by the binding that owns the aggregate.
            bool after_field = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Dot;
            bool after_assign = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Assign;
            if (after_field || after_assign) {
                i -= 2;
                continue;
            }
            return leaves.get(i).text;
        }
        break;
    }
    return "";
}

/// Returns the type of the slot an assignment stores into.
u32 borrow_assignment_slot_type(
    Vec<Binding>* bindings, Vec<u32>* binding_types, TypeTable* types,
    SyntaxNode* root, Vec<SyntaxNode*>* leaves, i64 borrow_index,
    Binding* destination) {
    if (destination == (Binding*)0 || borrow_index < 2
        || leaves.get(borrow_index - 1).token_kind != TokenKind.Assign) {
        return TYPE_UNKNOWN;
    }
    i64 destination_index = 0;
    while (destination_index < bindings.len()
        && bindings.get_ptr(destination_index).name_node != destination.name_node) {
        destination_index += 1;
    }
    u32 type_id = destination_index < binding_types.len()
        ? binding_types.get(destination_index) : TYPE_UNKNOWN;
    if (type_id == TYPE_UNKNOWN && destination.kind == BindingKind.Array) {
        String element_type = binding_declared_type_text(&destination.declared_type);
        type_id = types.parse_type_name(element_type.to_str());
        element_type.drop();
    }
    i64 root_index = borrow_index - 2;
    while (root_index >= 0) {
        SyntaxNode* candidate = leaves.get(root_index);
        Binding* root_binding = candidate.token_kind == TokenKind.Identifier
            ? visible_binding(bindings, candidate.text, candidate)
            : (Binding*)0;
        if (root_binding == (Binding*)0
            && candidate.token_kind == TokenKind.Identifier) {
            root_binding = borrow_unique_prior_binding(bindings,
                candidate.text, candidate);
        }
        if (candidate.token_kind == TokenKind.Identifier
            && borrow_text_equals(candidate.text, destination.name)
            && !(root_index > 0
                && leaves.get(root_index - 1).token_kind == TokenKind.Dot)
            && root_binding == destination) {
            break;
        }
        root_index -= 1;
    }
    if (root_index < 0) { return TYPE_UNKNOWN; }
    TypeEntry root_entry = *types.get(types.resolve_subst(type_id));
    bool array_element_type = destination.kind == BindingKind.Array
        && root_entry.kind != TypeKind.Array && root_entry.kind != TypeKind.Slice;
    i64 i = root_index + 1;
    while (i < borrow_index - 1 && type_id != TYPE_UNKNOWN) {
        SyntaxNode* bracket = borrow_enclosing_bracket(leaves.get(i));
        if (bracket != (SyntaxNode*)0) {
            if (array_element_type) {
                array_element_type = false;
            } else {
                TypeEntry entry = *types.get(types.resolve_subst(type_id));
                if (entry.kind != TypeKind.Array && entry.kind != TypeKind.Slice
                    && entry.kind != TypeKind.Pointer && entry.kind != TypeKind.Reference) {
                    return TYPE_UNKNOWN;
                }
                type_id = entry.inner;
            }
            while (i < borrow_index - 1
                && borrow_node_within(leaves.get(i), bracket)) { i += 1; }
        } else if (leaves.get(i).token_kind == TokenKind.Dot
            && i + 1 < borrow_index - 1
            && leaves.get(i + 1).token_kind == TokenKind.Identifier) {
            type_id = typecheck_struct_field_type(
                types, root, type_id, leaves.get(i + 1).text);
            i += 2;
        } else {
            return TYPE_UNKNOWN;
        }
    }
    return type_id;
}

/// Returns the only binding named `name` declared before `use`, or null.
Binding* borrow_unique_prior_binding(Vec<Binding>* bindings, str name,
    SyntaxNode* use) {
    Binding* selected = (Binding*)0;
    i64 i = 0;
    while (i < bindings.len()) {
        Binding* candidate = bindings.get_ptr(i);
        if (borrow_text_equals(candidate.name, name)
            && candidate.name_node != (SyntaxNode*)0
            && candidate.name_node.span.file == use.span.file
            && candidate.name_node.span.start <= use.span.start) {
            if (selected != (Binding*)0) { return (Binding*)0; }
            selected = candidate;
        }
        i += 1;
    }
    return selected;
}

/// A call result carries the origins of the borrowed parameters returned by
/// its callee. Keep alternatives: a function may return any reference input.
bool borrow_body_returns_parameter(SyntaxNode* parameters_node, SyntaxNode* body,
                                   i64 parameter_index, str* parameter_name) {
    Vec<Binding> parameters = Vec<Binding>.new();
    collect_parameter_bindings(parameters_node, &parameters);
    if (parameter_index < 0 || parameter_index >= parameters.len()) {
        parameters.drop();
        return false;
    }
    Binding* parameter = parameters.get_ptr(parameter_index);
    *parameter_name = parameter.name;
    Vec<Binding> bindings = Vec<Binding>.new();
    collect_parameter_bindings(parameters_node, &bindings);
    collect_block_bindings(body, &bindings);
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(body, &leaves);
    bool returned = false;
    i64 i = 0;
    while (!returned && i < leaves.len()) {
        if (leaves.get(i).token_kind == TokenKind.Return) {
            if (borrow_return_is_nested(leaves.get(i), body.parent, body)) {
                i += 1;
                continue;
            }
            i += 1;
            if (i < leaves.len() && leaves.get(i).token_kind == TokenKind.Move) { i += 1; }
            if (i < leaves.len() && leaves.get(i).token_kind == TokenKind.BitwiseAnd) {
                i += 1;
                if (i < leaves.len() && leaves.get(i).token_kind == TokenKind.Mut) { i += 1; }
            }
            if (i < leaves.len() && node_is_identifier(leaves.get(i))) {
                Binding* actual = visible_binding(&bindings, leaves.get(i).text, leaves.get(i));
                if (actual != (Binding*)0 && actual.name_node == parameter.name_node) {
                    returned = true;
                } else if (actual == (Binding*)0
                    && borrow_text_equals(leaves.get(i).text, parameter.name)) {
                    // Impl methods are still represented as sibling CST fragments,
                    // so their receiver parameter has no Function scope node.
                    returned = true;
                }
            }
        }
        i += 1;
    }
    leaves.drop();
    bindings.drop();
    parameters.drop();
    return returned;
}

/// Returns true when `function` may return its parameter `parameter_index`.
bool borrow_function_returns_parameter(SyntaxNode* function, i64 parameter_index,
                                       str* parameter_name) {
    return borrow_body_returns_parameter(borrow_function_parameters(function),
        borrow_function_body(function), parameter_index, parameter_name);
}

/// Returns the call whose argument list contains `argument` and sets
/// `*argument_index`, or null.
SyntaxNode* borrow_call_for_argument(SyntaxNode* argument, i64* argument_index) {
    SyntaxNode* child = argument;
    SyntaxNode* parent = child.parent;
    while (parent != (SyntaxNode*)0) {
        if (parent.kind == NodeKind.Parenthesized) {
            SyntaxNode* callee = binding_previous_sibling(parent);
            if (node_is_identifier(callee)) {
                SyntaxNode* top = child;
                while (top != (SyntaxNode*)0 && top.parent != parent) { top = top.parent; }
                if (top == (SyntaxNode*)0) { return (SyntaxNode*)0; }
                i64 index = 0;
                SyntaxNode* part = parent.first_child;
                while (part != (SyntaxNode*)0 && part != top) {
                    if (part.token_kind == TokenKind.Comma) { index += 1; }
                    part = part.next_sibling;
                }
                SyntaxNode* before_callee = binding_previous_sibling(callee);
                if (before_callee != (SyntaxNode*)0
                    && before_callee.token_kind == TokenKind.Dot) {
                    index += 1;
                }
                *argument_index = index;
                return callee;
            }
        }
        child = parent;
        parent = parent.parent;
    }
    return (SyntaxNode*)0;
}

/// Returns true when `origins` records `function` returning parameter
/// `parameter_index`.
bool borrow_has_return_origin(Vec<BorrowReturnOrigin>* origins,
                              SyntaxNode* function, i64 parameter_index) {
    i64 i = 0;
    while (i < origins.len()) {
        BorrowReturnOrigin* origin = origins.get_ptr(i);
        if (origin.function == function && origin.parameter_index == parameter_index) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// Returns the return status recorded for `function`, or null.
BorrowReturnStatus* borrow_return_status(Vec<BorrowReturnStatus>* statuses,
                                         SyntaxNode* function) {
    i64 i = 0;
    while (i < statuses.len()) {
        BorrowReturnStatus* status = statuses.get_ptr(i);
        if (status.function == function) { return status; }
        i += 1;
    }
    return (BorrowReturnStatus*)0;
}

/// Returns argument `argument_index` of call `call`, or null.
SyntaxNode* borrow_call_argument(SyntaxNode* call, i64 argument_index) {
    if (call == (SyntaxNode*)0 || call.next_sibling == (SyntaxNode*)0
        || call.next_sibling.kind != NodeKind.Parenthesized) { return (SyntaxNode*)0; }
    i64 index = 0;
    SyntaxNode* part = call.next_sibling.first_child;
    while (part != (SyntaxNode*)0) {
        if (index == argument_index && part.token_kind != TokenKind.Comma) { return part; }
        if (part.token_kind == TokenKind.Comma) { index += 1; }
        part = part.next_sibling;
    }
    return (SyntaxNode*)0;
}

/// Returns true when call argument `argument_index` is the local
/// `binding` (or an alias of it).
bool borrow_call_argument_matches(Vec<Binding>* caller_bindings,
                                  SyntaxNode* call, i64 argument_index,
                                  Binding* parameter) {
    SyntaxNode* argument = borrow_call_argument(call, argument_index);
    if (argument == (SyntaxNode*)0 || parameter == (Binding*)0) { return false; }
    bool expects_reference = parameter.declared_type.kind == ProjectionTypeKind.Reference;
    bool explicit_borrow = argument.token_kind == TokenKind.BitwiseAnd;
    bool mutable_borrow = explicit_borrow && argument.next_sibling != (SyntaxNode*)0
        && argument.next_sibling.token_kind == TokenKind.Mut;
    SyntaxNode* value = argument;
    while (value != (SyntaxNode*)0 && value.kind == NodeKind.Token
        && (value.token_kind == TokenKind.BitwiseAnd
            || value.token_kind == TokenKind.Mut
            || value.token_kind == TokenKind.Move)) {
        value = value.next_sibling;
    }
    if (value == (SyntaxNode*)0 || !node_is_identifier(value)) { return true; }
    Binding* actual = visible_binding(caller_bindings, value.text, value);
    if (actual == (Binding*)0) { return true; }
    TypeProjection* actual_type = &actual.declared_type;
    if (actual_type.kind == ProjectionTypeKind.Unknown) { return true; }
    if (actual_type.kind == ProjectionTypeKind.Reference) {
        if (expects_reference && parameter.declared_type.is_mutable
            && !actual_type.is_mutable) { return false; }
        return borrow_text_equals(actual_type.name, parameter.declared_type.name);
    }
    if (expects_reference) {
        return explicit_borrow
            && borrow_text_equals(actual_type.name, parameter.declared_type.name)
            && (!parameter.declared_type.is_mutable || mutable_borrow);
    }
    return !explicit_borrow
        && borrow_text_equals(actual_type.name, parameter.declared_type.name);
}

/// Records that `function` may return parameter `parameter_index`.
void borrow_add_return_origin(Vec<BorrowReturnOrigin>* origins,
                              SyntaxNode* function, i64 parameter_index) {
    if (borrow_has_return_origin(origins, function, parameter_index)) { return; }
    BorrowReturnOrigin origin;
    origin.function = function;
    origin.parameter_index = parameter_index;
    origins.push(origin);
}

/// Returns the call directly returned by a `return`, or null.
SyntaxNode* borrow_return_call(SyntaxNode* return_node) {
    SyntaxNode* expression = return_node.next_sibling;
    while (expression != (SyntaxNode*)0
        && expression.kind == NodeKind.Token
        && (expression.token_kind == TokenKind.BitwiseAnd
            || expression.token_kind == TokenKind.Star
            || expression.token_kind == TokenKind.Move
            || expression.token_kind == TokenKind.Mut)) {
        expression = expression.next_sibling;
    }
    if (expression != (SyntaxNode*)0 && node_is_identifier(expression)
        && expression.next_sibling != (SyntaxNode*)0
        && expression.next_sibling.kind == NodeKind.Parenthesized) {
        return expression;
    }
    return (SyntaxNode*)0;
}

/// Returns true when a `return` returns one of `bindings` directly.
bool borrow_return_directly_returns_binding(Vec<Binding>* bindings,
                                            SyntaxNode* return_node,
                                            Binding* expected) {
    if (expected == (Binding*)0) { return false; }
    SyntaxNode* expression = return_node.next_sibling;
    while (expression != (SyntaxNode*)0
        && expression.kind == NodeKind.Token
        && (expression.token_kind == TokenKind.BitwiseAnd
            || expression.token_kind == TokenKind.Star
            || expression.token_kind == TokenKind.Move
            || expression.token_kind == TokenKind.Mut)) {
        expression = expression.next_sibling;
    }
    if (expression == (SyntaxNode*)0 || !node_is_identifier(expression)) { return false; }
    Binding* actual = visible_binding(bindings, expression.text, expression);
    return actual != (Binding*)0 && actual.name_node == expected.name_node;
}

/// Returns the argument count of a call.
i64 borrow_call_arity(SyntaxNode* call) {
    if (call == (SyntaxNode*)0 || call.next_sibling == (SyntaxNode*)0
        || call.next_sibling.kind != NodeKind.Parenthesized) { return -1; }
    SyntaxNode* arguments = call.next_sibling;
    if (arguments.first_child == (SyntaxNode*)0) { return 0; }
    i64 count = 1;
    i64 depth = 0;
    SyntaxNode* child = arguments.first_child;
    while (child != (SyntaxNode*)0) {
        if (child.kind == NodeKind.Token
            && (child.token_kind == TokenKind.LeftParen
                || child.token_kind == TokenKind.LeftBracket
                || child.token_kind == TokenKind.LeftBrace)) { depth += 1; }
        else if (child.kind == NodeKind.Token
            && (child.token_kind == TokenKind.RightParen
                || child.token_kind == TokenKind.RightBracket
                || child.token_kind == TokenKind.RightBrace)) { depth -= 1; }
        else if (depth == 0 && child.token_kind == TokenKind.Comma) { count += 1; }
        child = child.next_sibling;
    }
    return count;
}

/// Returns true when `call`'s callee may return argument `argument_index`.
bool borrow_call_returns_argument(Vec<BorrowReturnOrigin>* origins,
                                  SyntaxNode* call, i64 argument_index,
                                  i64 argument_count, SyntaxNode* root,
                                  Vec<BorrowReturnStatus>* statuses,
                                  Vec<Binding>* caller_bindings) {
    if (call == (SyntaxNode*)0) { return false; }
    SyntaxNode* function = root.first_child;
    while (function != (SyntaxNode*)0) {
        if (function.kind == NodeKind.Function) {
            SyntaxNode* name = function_identifier(function);
            if (name != (SyntaxNode*)0 && borrow_text_equals(name.text, call.text)) {
                Vec<Binding> parameters = Vec<Binding>.new();
                collect_parameter_bindings(borrow_function_parameters(function), &parameters);
                bool matches = parameters.len() == argument_count
                    && argument_index >= 0 && argument_index < parameters.len()
                    && parameters.get_ptr(argument_index).declared_type.kind
                        == ProjectionTypeKind.Reference
                    && borrow_call_argument_matches(caller_bindings, call,
                        argument_index, parameters.get_ptr(argument_index))
                    && (borrow_has_return_origin(origins, function, argument_index)
                        || (borrow_return_status(statuses, function) != (BorrowReturnStatus*)0
                            && borrow_return_status(statuses, function).unknown_internal));
                parameters.drop();
                if (matches) { return true; }
            }
        }
        function = function.next_sibling;
    }
    return item_is_c_extern_function(root, call.text);
}

/// Follows a call that forwards a borrowed argument through another call,
/// returning the inner call and its argument index.
SyntaxNode* borrow_lift_forwarded_call(Vec<BorrowReturnOrigin>* origins,
                                      SyntaxNode* call, i64* argument_index,
                                      SyntaxNode* root,
                                      Vec<BorrowReturnStatus>* statuses,
                                      Vec<Binding>* caller_bindings) {
    SyntaxNode* current = call;
    while (current != (SyntaxNode*)0 && current.parent != (SyntaxNode*)0
        && current.parent.kind == NodeKind.Parenthesized) {
        SyntaxNode* argument_group = current.parent;
        SyntaxNode* outer = binding_previous_sibling(argument_group);
        if (!node_is_identifier(outer) || outer.next_sibling != argument_group) { break; }
        SyntaxNode* top = current;
        while (top != (SyntaxNode*)0 && top.parent != argument_group) { top = top.parent; }
        if (top == (SyntaxNode*)0) { break; }
        i64 index = 0;
        SyntaxNode* part = argument_group.first_child;
        while (part != (SyntaxNode*)0 && part != top) {
            if (part.token_kind == TokenKind.Comma) { index += 1; }
            part = part.next_sibling;
        }
        i64 count = borrow_call_arity(outer);
        if (!borrow_call_returns_argument(origins, outer, index, count, root,
            statuses, caller_bindings)) { return (SyntaxNode*)0; }
        current = outer;
        *argument_index = index;
    }
    return current;
}

/// Returns true when argument `argument_index` of a returned call is a
/// parameter.
bool borrow_return_arg_is_parameter(Vec<Binding>* bindings,
                                    SyntaxNode* arguments, i64 argument_index,
                                    Binding* parameter) {
    if (arguments == (SyntaxNode*)0 || parameter == (Binding*)0) { return false; }
    i64 index = 0;
    SyntaxNode* part = arguments.first_child;
    while (part != (SyntaxNode*)0) {
        if (index == argument_index) {
            SyntaxNode* value = part;
            while (value != (SyntaxNode*)0 && value.kind == NodeKind.Token
                && (value.token_kind == TokenKind.BitwiseAnd
                    || value.token_kind == TokenKind.Mut
                    || value.token_kind == TokenKind.Move)) {
                value = value.next_sibling;
            }
            if (value == (SyntaxNode*)0 || !node_is_identifier(value)) { return false; }
            Binding* actual = visible_binding(bindings, value.text, value);
            return actual != (Binding*)0 && actual.name_node == parameter.name_node;
        }
        if (part.token_kind == TokenKind.Comma) { index += 1; }
        part = part.next_sibling;
    }
    return false;
}

/// Returns true when a local is initialized from a parameter reference.
bool borrow_binding_aliases_parameter(Vec<Binding>* bindings,
                                      Vec<SyntaxNode*>* leaves,
                                      Binding* binding, Binding* parameter,
                                      i64 return_index) {
    Binding* current = binding;
    i64 depth = 0;
    while (current != (Binding*)0 && depth <= bindings.len()) {
        if (current.name_node == parameter.name_node) { return true; }
        i64 declaration = 0;
        while (declaration < leaves.len()
            && leaves.get(declaration) != current.name_node) { declaration += 1; }
        if (declaration >= leaves.len()) { return false; }
        i64 assign = declaration + 1;
        while (assign < return_index && assign < leaves.len()
            && leaves.get(assign).token_kind != TokenKind.Assign
            && leaves.get(assign).token_kind != TokenKind.Semicolon) {
            assign += 1;
        }
        if (assign >= return_index || assign >= leaves.len()
            || leaves.get(assign).token_kind != TokenKind.Assign) { return false; }
        i64 value = assign + 1;
        while (value < return_index && value < leaves.len()
            && (leaves.get(value).token_kind == TokenKind.BitwiseAnd
                || leaves.get(value).token_kind == TokenKind.Move
                || leaves.get(value).token_kind == TokenKind.Mut)) { value += 1; }
        if (value >= return_index || value >= leaves.len()
            || !node_is_identifier(leaves.get(value))) { return false; }
        Binding* source = visible_binding(bindings, leaves.get(value).text, leaves.get(value));
        if (source == (Binding*)0) { return false; }
        i64 later = value + 1;
        while (later + 1 < return_index && later + 1 < leaves.len()) {
            if (leaves.get(later).token_kind == TokenKind.Identifier
                && borrow_text_equals(leaves.get(later).text, current.name)
                && visible_binding(bindings, current.name, leaves.get(later)) == current
                && leaves.get(later + 1).token_kind == TokenKind.Assign) {
                return false;
            }
            later += 1;
        }
        current = source;
        depth += 1;
    }
    return false;
}

/// Returns true when a `return` expression may yield any of `parameters`.
bool borrow_return_matches_any_parameter(Vec<Binding>* bindings,
                                         Vec<Binding>* parameters,
                                         Vec<SyntaxNode*>* leaves,
                                         SyntaxNode* return_node,
                                         i64 return_index) {
    i64 i = 0;
    while (i < parameters.len()) {
        Binding* parameter = parameters.get_ptr(i);
        if (parameter.declared_type.kind == ProjectionTypeKind.Reference) {
            if (borrow_return_directly_returns_binding(bindings, return_node, parameter)) {
                return true;
            }
            SyntaxNode* value = return_node.next_sibling;
            while (value != (SyntaxNode*)0 && value.kind == NodeKind.Token
                && (value.token_kind == TokenKind.BitwiseAnd
                    || value.token_kind == TokenKind.Star
                    || value.token_kind == TokenKind.Move
                    || value.token_kind == TokenKind.Mut)) { value = value.next_sibling; }
            if (value != (SyntaxNode*)0 && node_is_identifier(value)) {
                Binding* returned = visible_binding(bindings, value.text, value);
                if (borrow_binding_aliases_parameter(bindings, leaves,
                    returned, parameter, return_index)) { return true; }
            }
        }
        i += 1;
    }
    return false;
}

/// Records, for every function, whether its returned references have known
/// origins.
void borrow_collect_return_statuses(SyntaxNode* root, SyntaxTree* tree,
                                    SymbolTable* symbols,
                                    Vec<BorrowReturnStatus>* statuses) {
    SyntaxNode* function = root.first_child;
    while (function != (SyntaxNode*)0) {
        if (function.kind == NodeKind.Function) {
            BorrowReturnStatus status;
            status.function = function;
            status.unknown_internal = false;
            status.opaque_external = false;
            statuses.push(status);
        }
        function = function.next_sibling;
    }
    bool changed = true;
    while (changed) {
        changed = false;
        i64 state_index = 0;
        while (state_index < statuses.len()) {
            BorrowReturnStatus* state = statuses.get_ptr(state_index);
            SyntaxNode* owner = state.function;
            SyntaxNode* body = borrow_function_body(owner);
            Vec<Binding> bindings = Vec<Binding>.new();
            collect_function_bindings(owner, &bindings);
            Vec<Binding> parameters = Vec<Binding>.new();
            collect_parameter_bindings(borrow_function_parameters(owner), &parameters);
            Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
            collect_borrow_leaves(body, &leaves);
            i64 leaf_index = 0;
            while (leaf_index < leaves.len()) {
                SyntaxNode* node = leaves.get(leaf_index);
                if (node.token_kind == TokenKind.Return
                    && !borrow_return_is_nested(node, owner, body)
                    && !borrow_return_matches_any_parameter(&bindings, &parameters,
                        &leaves, node, leaf_index)) {
                    bool unknown_internal = false;
                    bool opaque_external = false;
                    SyntaxNode* call = borrow_return_call(node);
                    if (call != (SyntaxNode*)0) {
                        i64 arity = borrow_call_arity(call);
                        i64 candidate_count = 0;
                        SyntaxNode* candidate = root.first_child;
                        while (candidate != (SyntaxNode*)0) {
                            if (candidate.kind == NodeKind.Function) {
                                SyntaxNode* name = function_identifier(candidate);
                                Vec<Binding> candidate_parameters = Vec<Binding>.new();
                                collect_parameter_bindings(
                                    borrow_function_parameters(candidate),
                                    &candidate_parameters);
                                bool applicable = name != (SyntaxNode*)0
                                    && borrow_text_equals(name.text, call.text)
                                    && candidate_parameters.len() == arity;
                                i64 argument = 0;
                                while (applicable && argument < arity) {
                                    if (!borrow_call_argument_matches(&bindings,
                                        call, argument,
                                        candidate_parameters.get_ptr(argument))) {
                                        applicable = false;
                                    }
                                    argument += 1;
                                }
                                if (applicable) {
                                    candidate_count += 1;
                                    BorrowReturnStatus* candidate_status =
                                        borrow_return_status(statuses, candidate);
                                    if (candidate_status != (BorrowReturnStatus*)0
                                        && candidate_status.unknown_internal) {
                                        unknown_internal = true;
                                    }
                                    if (candidate_status != (BorrowReturnStatus*)0
                                        && candidate_status.opaque_external) {
                                        opaque_external = true;
                                    }
                                }
                                candidate_parameters.drop();
                            }
                            candidate = candidate.next_sibling;
                        }
                        if (candidate_count == 0) {
                            if (item_is_c_extern_function(root, call.text)) {
                                opaque_external = true;
                            } else {
                                unknown_internal = true;
                            }
                        }
                    } else {
                        SyntaxNode* value = node.next_sibling;
                        while (value != (SyntaxNode*)0 && value.kind == NodeKind.Token
                            && (value.token_kind == TokenKind.BitwiseAnd
                                || value.token_kind == TokenKind.Mut)) {
                            value = value.next_sibling;
                        }
                        if (value == (SyntaxNode*)0 || !node_is_identifier(value)
                            || !borrow_is_global(tree, symbols, value.text)) {
                            unknown_internal = true;
                        }
                    }
                    if (unknown_internal && !state.unknown_internal) {
                        state.unknown_internal = true;
                        changed = true;
                    }
                    if (opaque_external && !state.opaque_external) {
                        state.opaque_external = true;
                        changed = true;
                    }
                }
                leaf_index += 1;
            }
            leaves.drop();
            parameters.drop();
            bindings.drop();
            state_index += 1;
        }
    }
}

/// Records which parameters each function may return, iterating to a fixed
/// point across calls.
void borrow_collect_return_origins(SyntaxNode* root,
                                   Vec<BorrowReturnOrigin>* origins,
                                   Vec<BorrowReturnStatus>* statuses) {
    bool changed = true;
    while (changed) {
        changed = false;
        SyntaxNode* function = root.first_child;
        while (function != (SyntaxNode*)0) {
            if (function.kind == NodeKind.Function) {
                Vec<Binding> bindings = Vec<Binding>.new();
                collect_function_bindings(function, &bindings);
                Vec<Binding> parameters = Vec<Binding>.new();
                collect_parameter_bindings(borrow_function_parameters(function), &parameters);
                Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
                collect_borrow_leaves(borrow_function_body(function), &leaves);
                i64 parameter_index = 0;
                while (parameter_index < parameters.len()) {
                    Binding* parameter = parameters.get_ptr(parameter_index);
                    if (parameter.declared_type.kind == ProjectionTypeKind.Reference
                        && !borrow_has_return_origin(origins, function, parameter_index)) {
                        bool returned = false;
                        i64 leaf_index = 0;
                        while (!returned && leaf_index < leaves.len()) {
                            SyntaxNode* node = leaves.get(leaf_index);
                            if (node.token_kind == TokenKind.Return
                                && !borrow_return_is_nested(node, function,
                                    borrow_function_body(function))) {
                                if (borrow_return_directly_returns_binding(&bindings,
                                    node, parameter)) {
                                    returned = true;
                                } else {
                                    SyntaxNode* value = node.next_sibling;
                                    while (value != (SyntaxNode*)0
                                        && value.kind == NodeKind.Token
                                        && (value.token_kind == TokenKind.BitwiseAnd
                                            || value.token_kind == TokenKind.Star
                                            || value.token_kind == TokenKind.Move
                                            || value.token_kind == TokenKind.Mut)) {
                                        value = value.next_sibling;
                                    }
                                    if (value != (SyntaxNode*)0 && node_is_identifier(value)) {
                                        Binding* returned_binding = visible_binding(
                                            &bindings, value.text, value);
                                        if (borrow_binding_aliases_parameter(&bindings,
                                            &leaves, returned_binding, parameter, leaf_index)) {
                                            returned = true;
                                        }
                                    }
                                }
                                if (!returned) {
                                    SyntaxNode* call = borrow_return_call(node);
                                    i64 argument_count = borrow_call_arity(call);
                                    i64 argument_index = 0;
                                    SyntaxNode* arguments = call != (SyntaxNode*)0
                                        ? call.next_sibling : (SyntaxNode*)0;
                                    while (!returned && argument_index < argument_count) {
                                        if (borrow_return_arg_is_parameter(&bindings,
                                            arguments, argument_index, parameter)
                                            && borrow_call_returns_argument(origins, call,
                                                argument_index, argument_count, root,
                                                statuses,
                                                &bindings)) {
                                            returned = true;
                                        }
                                        argument_index += 1;
                                    }
                                }
                            }
                            leaf_index += 1;
                        }
                        if (returned) {
                            borrow_add_return_origin(origins, function, parameter_index);
                            changed = true;
                        }
                    }
                    parameter_index += 1;
                }
                leaves.drop();
                parameters.drop();
                bindings.drop();
            }
            function = function.next_sibling;
        }
    }
}

/// Returns true when `method` on `receiver_type` returns a borrow of its
/// receiver.
bool borrow_method_returns_receiver(SyntaxNode* root, str receiver_type,
                                    SyntaxNode* method,
                                    Vec<Binding>* caller_bindings,
                                    TypeTable* types) {
    SyntaxNode* item = root.first_child;
    i64 best_score = -1;
    bool returns_receiver = false;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0
                && borrow_text_equals(target.text, receiver_type)) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                SyntaxNode* member = block != (SyntaxNode*)0
                    ? block.first_child : (SyntaxNode*)0;
                while (member != (SyntaxNode*)0) {
                    if (member.kind == NodeKind.Token
                        && member.token_kind == TokenKind.Semicolon) {
                        member = member.next_sibling;
                        continue;
                    }
                    SyntaxNode* params = (SyntaxNode*)0;
                    SyntaxNode* body = (SyntaxNode*)0;
                    SyntaxNode* scan = member;
                    while (scan != (SyntaxNode*)0
                        && !(scan.kind == NodeKind.Token
                            && scan.token_kind == TokenKind.Semicolon)) {
                        if (scan.kind == NodeKind.Parenthesized) { params = scan; }
                        else if (params != (SyntaxNode*)0 && scan.kind == NodeKind.Block) {
                            body = scan;
                            break;
                        }
                        scan = scan.next_sibling;
                    }
                    SyntaxNode* name = item_method_name(member, params);
                    if (name != (SyntaxNode*)0 && params != (SyntaxNode*)0
                        && body != (SyntaxNode*)0
                        && borrow_text_equals(name.text, method.text)) {
                        Vec<Binding> method_parameters = Vec<Binding>.new();
                        collect_parameter_bindings(params, &method_parameters);
                        i64 call_arity = borrow_call_arity(method);
                        bool applicable = method_parameters.len() > 0
                            && method_parameters.get_ptr(0).declared_type.kind
                                == ProjectionTypeKind.Reference;
                        i64 arg = 0;
                        i64 fixed_count = method_parameters.len();
                        bool variadic = method_parameters.len() > 0
                            && binding_is_variadic_parameter(
                                method_parameters.get_ptr(method_parameters.len() - 1));
                        if (variadic) { fixed_count -= 1; }
                        applicable = applicable && (variadic
                            ? call_arity >= fixed_count - 1
                            : method_parameters.len() == call_arity + 1);
                        i64 score = 0;
                        while (applicable && arg < call_arity) {
                            i64 parameter_index = arg + 1;
                            if (variadic && parameter_index >= fixed_count) {
                                parameter_index = method_parameters.len() - 1;
                            }
                            Binding* parameter = method_parameters.get_ptr(parameter_index);
                            SyntaxNode* argument = borrow_call_argument(method, arg);
                            bool explicit_borrow = argument != (SyntaxNode*)0
                                && argument.token_kind == TokenKind.BitwiseAnd;
                            bool mutable_borrow = explicit_borrow
                                && argument.next_sibling != (SyntaxNode*)0
                                && argument.next_sibling.token_kind == TokenKind.Mut;
                            SyntaxNode* value = argument;
                            while (value != (SyntaxNode*)0 && value.kind == NodeKind.Token
                                && (value.token_kind == TokenKind.BitwiseAnd
                                    || value.token_kind == TokenKind.Mut
                                    || value.token_kind == TokenKind.Move)) {
                                value = value.next_sibling;
                            }
                            u32 expected = types.parse_type_name(parameter.declared_type.name);
                            u32 actual = TYPE_UNKNOWN;
                            Binding* actual_binding = value != (SyntaxNode*)0
                                && node_is_identifier(value)
                                ? visible_binding(caller_bindings, value.text, value)
                                : (Binding*)0;
                            if (actual_binding != (Binding*)0) {
                                actual = types.parse_type_name(actual_binding.declared_type.name);
                                if (actual_binding.declared_type.kind == ProjectionTypeKind.Reference) {
                                    TypeEntry* actual_entry = types.get(actual);
                                    actual = actual_entry.kind == TypeKind.Reference
                                        ? actual_entry.inner : actual;
                                }
                            }
                            bool expects_reference = parameter.declared_type.kind
                                == ProjectionTypeKind.Reference;
                            if (actual_binding != (Binding*)0
                                && ((!expects_reference && explicit_borrow)
                                    || (expects_reference && actual_binding.declared_type.kind
                                        != ProjectionTypeKind.Reference && !explicit_borrow)
                                    || (expects_reference && parameter.declared_type.is_mutable
                                        && (!mutable_borrow
                                            || (actual_binding.declared_type.kind
                                                == ProjectionTypeKind.Reference
                                                && !actual_binding.declared_type.is_mutable))))) {
                                applicable = false;
                            } else if (expected != TYPE_UNKNOWN && actual != TYPE_UNKNOWN
                                && !types_match(types, expected, actual)) {
                                applicable = false;
                            } else if (expected != TYPE_UNKNOWN && expected == actual) {
                                score += 2;
                            } else if (expected != TYPE_UNKNOWN && actual != TYPE_UNKNOWN) {
                                score += 1;
                            }
                            arg += 1;
                        }
                        if (applicable) {
                            str receiver_name = "";
                            bool returns = borrow_body_returns_parameter(
                                params, body, 0, &receiver_name);
                            u32 receiver_type_id = types.parse_type_name(receiver_type);
                            u32 result_type = typecheck_method_decl_return_type(
                                types, member, name);
                            result_type = resolve_generic_member_type(
                                types, root, receiver_type_id, result_type);
                            bool carries_receiver_borrow = result_type == TYPE_UNKNOWN;
                            if (result_type != TYPE_UNKNOWN) {
                                TypeEntry result = *types.get(types.resolve_subst(result_type));
                                carries_receiver_borrow = result.kind == TypeKind.Reference
                                    || borrow_type_contains_reference(
                                        types, root, result_type, 0);
                            }
                            returns = returns && carries_receiver_borrow;
                            if (score > best_score) {
                                best_score = score;
                                returns_receiver = returns;
                            } else if (score == best_score && returns) {
                                returns_receiver = true;
                            }
                        }
                        method_parameters.drop();
                    }
                    member = body != (SyntaxNode*)0 ? body.next_sibling
                        : scan != (SyntaxNode*)0 ? scan.next_sibling : (SyntaxNode*)0;
                }
            }
        }
        item = item.next_sibling;
    }
    return best_score >= 0 && returns_receiver;
}

/// Returns the local that holds a call's borrowed result, or "".
str borrow_call_result_holder(Vec<Binding>* bindings, Vec<u32>* binding_types,
                              Vec<SyntaxNode*>* leaves,
                              SyntaxNode* call, SyntaxNode* argument,
                              TypeTable* table, SyntaxNode* root) {
    // Aggregate initializers own the stored reference for their full lifetime.
    str aggregate = borrow_aggregate_holder(bindings, binding_types, table, root, argument);
    if (strlen(aggregate) > 0) { return aggregate; }
    i64 call_index = 0;
    while (call_index < leaves.len() && leaves.get(call_index) != call) { call_index += 1; }
    if (call_index == leaves.len()) { return ""; }
    i64 i = call_index - 1;
    while (i >= 0 && leaves.get(i).token_kind != TokenKind.Assign
        && leaves.get(i).token_kind != TokenKind.Semicolon
        && leaves.get(i).token_kind != TokenKind.LeftBrace) {
        i -= 1;
    }
    if (i <= 0 || leaves.get(i).token_kind != TokenKind.Assign
        || leaves.get(i - 1).token_kind != TokenKind.Identifier) {
        return "";
    }
    str holder = leaves.get(i - 1).text;
    if (i >= 3 && leaves.get(i - 2).token_kind == TokenKind.Dot
        && leaves.get(i - 3).token_kind == TokenKind.Identifier) {
        holder = leaves.get(i - 3).text;
    }
    Binding* destination = visible_binding(bindings, holder, call);
    u32 slot_type = borrow_assignment_slot_type(bindings, binding_types,
        table, root, leaves, i + 1, destination);
    // Scalar and raw-pointer results cannot retain a semantic reference loan.
    if (slot_type != TYPE_UNKNOWN
        && !borrow_type_contains_reference(table, root, slot_type, 0)) { return ""; }
    return holder;
}

/// Returns the last leaf index from `start` that mentions `holder`, or -1.
i64 last_use(Vec<SyntaxNode*>* leaves, i64 start, str holder) {
    i64 last = -1;
    i64 i = start;
    while (i < leaves.len()) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Identifier && borrow_text_equals(node.text, holder)) {
            last = i;
        }
        i += 1;
    }
    return last;
}

/// Returns the last leaf index from `start` that uses binding `holder`.
i64 last_binding_use(Vec<Binding>* bindings, Vec<SyntaxNode*>* leaves,
                     i64 start, Binding* holder) {
    if (holder == (Binding*)0) { return -1; }
    i64 last = -1;
    i64 i = start;
    while (i < leaves.len()) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Identifier
            && borrow_text_equals(node.text, holder.name)
            && visible_binding(bindings, holder.name, node) == holder) {
            last = i;
        }
        i += 1;
    }
    return last;
}

/// Returns true when `node` uses the loan's holder binding.
bool borrow_is_holder_use(Vec<Binding>* bindings, Loan* loan, SyntaxNode* node) {
    if (loan.holder_binding_start <= 0 || node.token_kind != TokenKind.Identifier) {
        return false;
    }
    Binding* visible = visible_binding(bindings, node.text, node);
    return visible != (Binding*)0
        && visible.span.start == loan.holder_binding_start;
}


/// Collects the leaf indexes where statements end (loan release points).
void collect_borrow_release_points(SyntaxNode* node, Vec<SyntaxNode*>* leaves, Vec<i64>* points) {
    if (node == (SyntaxNode*)0) {
        return;
    }
    if (node.kind == NodeKind.Parenthesized) {
        i64 last = -1;
        i64 i = 0;
        while (i < leaves.len()) {
            SyntaxNode* leaf = leaves.get(i);
            if (leaf.span.start >= node.span.start && leaf.span.end <= node.span.end && i > last) {
                last = i;
            }
            i += 1;
        }
        if (last >= 0) {
            points.push(last);
        }
    }
    SyntaxNode* child = node.first_child;
    while (child != (SyntaxNode*)0) {
        collect_borrow_release_points(child, leaves, points);
        child = child.next_sibling;
    }
}

/// Returns true when the scope `scope` ends after leaf `index`.
bool borrow_scope_ends_after(Vec<SyntaxNode*>* leaves, i64 index,
                             SyntaxNode* scope) {
    if (index < 0 || index >= leaves.len() || !borrow_node_within(leaves.get(index), scope)) {
        return false;
    }
    return index + 1 >= leaves.len() || !borrow_node_within(leaves.get(index + 1), scope);
}

/// Appends one projection for `borrow_place`.
void append_projection(BorrowAnalyzer* analyzer, ProjectionKind kind, str field, u16* count) {
    Projection projection;
    projection.kind = kind;
    projection.field_name_id = kind == ProjectionKind.Field ? analyzer.names.intern(field) : (u32)0;
    analyzer.projections.push(move projection);
    *count = *count + 1;
}

/// Builds the place spelled by leaves `[root_index, end_index]`.
Place borrow_place(BorrowAnalyzer* analyzer, Vec<SyntaxNode*>* leaves, i64 root_index, i64 end_index) {
    SyntaxNode* root = leaves.get(root_index);
    u32 local_id = analyzer.names.intern(root.text);
    u32 projections_start = (u32)analyzer.projections.len();
    u16 projections_count = 0;
    i64 prefix = root_index - 1;
    while (prefix >= 0 && borrow_text_equals(leaves.get(prefix).text, "*")) {
        append_projection(analyzer, ProjectionKind.Deref, "", &projections_count);
        prefix -= 1;
    }
    i64 i = root_index + 1;
    while (i < leaves.len() && i < end_index) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Dot && i + 1 < leaves.len()
            && leaves.get(i + 1).token_kind == TokenKind.Identifier) {
            append_projection(analyzer, ProjectionKind.Field, leaves.get(i + 1).text, &projections_count);
            i += 2;
            continue;
        }
        if (node.token_kind == TokenKind.LeftBracket) {
            append_projection(analyzer, ProjectionKind.Index, "", &projections_count);
            i += 1;
            i64 depth = 1;
            while (i < leaves.len() && depth > 0) {
                if (leaves.get(i).token_kind == TokenKind.LeftBracket) {
                    depth += 1;
                } else if (leaves.get(i).token_kind == TokenKind.RightBracket) {
                    depth -= 1;
                }
                i += 1;
            }
            continue;
        }
        break;
    }
    return Place.with_projections(local_id, projections_start, projections_count);
}

/// Returns true when a method receiver expression contains a call.
bool borrow_receiver_contains_call(Vec<SyntaxNode*>* leaves, i64 root_index, i64 method_index) {
    i64 i = root_index + 1;
    while (i + 1 < method_index) {
        SyntaxNode* candidate = leaves.get(i);
        if (candidate.kind == NodeKind.Token && candidate.token_kind == TokenKind.Identifier
            && leaves.get(i - 1).token_kind == TokenKind.Dot
            && candidate.next_sibling != (SyntaxNode*)0
            && candidate.next_sibling.kind == NodeKind.Parenthesized) {
            return true;
        }
        i += 1;
    }
    return false;
}

/// Returns true when a method call's arguments also call methods on the same
/// receiver (which would conflict with a mutable receiver borrow).
bool borrow_method_args_call_same_receiver(Vec<SyntaxNode*>* leaves,
                                          i64 receiver_root, i64 method_index) {
    SyntaxNode* args = leaves.get(method_index).next_sibling;
    if (args == (SyntaxNode*)0 || args.kind != NodeKind.Parenthesized) {
        return false;
    }
    i64 args_end = -1;
    i64 i = method_index + 1;
    while (i < leaves.len()) {
        SyntaxNode* candidate = leaves.get(i);
        if (candidate.span.start >= args.span.start && candidate.span.end <= args.span.end) {
            args_end = i;
        }
        i += 1;
    }
    i = method_index + 1;
    while (i <= args_end) {
        SyntaxNode* candidate = leaves.get(i);
        if (candidate.token_kind == TokenKind.Identifier && i >= 2
            && leaves.get(i - 1).token_kind == TokenKind.Dot
            && candidate.next_sibling != (SyntaxNode*)0
            && candidate.next_sibling.kind == NodeKind.Parenthesized) {
            i64 nested_root = i - 2;
            while (nested_root >= 2
                && leaves.get(nested_root - 1).token_kind == TokenKind.Dot
                && leaves.get(nested_root - 2).token_kind == TokenKind.Identifier) {
                nested_root -= 2;
            }
            if (borrow_text_equals(leaves.get(nested_root).text,
                                   leaves.get(receiver_root).text)) {
                return true;
            }
        }
        i += 1;
    }
    return false;
}

/// How one method takes its receiver: 1 shared, 2 mutable.
struct MethodReceiver {
    str receiver_type;
    str method;
    i64 mode;
}

/// Receiver modes of every method that takes a reference receiver.
struct MethodReceiverTable {
    Vec<MethodReceiver> entries;
}

impl MethodReceiverTable {
    /// Creates an empty table.
    MethodReceiverTable new() {
        MethodReceiverTable table;
        table.entries = Vec<MethodReceiver>.new();
        return table;
    }

    /// Records a method's receiver mode, keeping the strongest seen. Modes
    /// below 1 (by value) are ignored.
    void register(MethodReceiverTable* self, str receiver_type, str method, i64 mode) {
        if (mode < 1) {
            return;
        }
        i64 i = 0;
        while (i < self.entries.len()) {
            MethodReceiver* entry = self.entries.get_ptr(i);
            if (borrow_text_equals(entry.receiver_type, receiver_type)
                && borrow_text_equals(entry.method, method)) {
                if (mode > entry.mode) {
                    entry.mode = mode;
                }
                return;
            }
            i += 1;
        }
        MethodReceiver entry;
        entry.receiver_type = receiver_type;
        entry.method = method;
        entry.mode = mode;
        self.entries.push(entry);
    }

    /// Returns the receiver mode of `method` on `receiver_type`, or -1.
    i64 get_for_type(MethodReceiverTable* self, str receiver_type, str method) {
        i64 i = 0;
        while (i < self.entries.len()) {
            MethodReceiver* entry = self.entries.get_ptr(i);
            if (borrow_text_equals(entry.receiver_type, receiver_type)
                && borrow_text_equals(entry.method, method)) {
                return entry.mode;
            }
            i += 1;
        }
        return -1;
    }

    /// Returns the strongest receiver mode any type gives `method`, or -1.
    i64 get(MethodReceiverTable* self, str method) {
        i64 mode = -1;
        i64 i = 0;
        while (i < self.entries.len()) {
            MethodReceiver* entry = self.entries.get_ptr(i);
            if (borrow_text_equals(entry.method, method) && entry.mode > mode) {
                mode = entry.mode;
            }
            i += 1;
        }
        return mode;
    }
}

/// Records the receiver modes of every method in an impl block.
void collect_impl_methods_into_table(MethodReceiverTable* table, SyntaxNode* impl_item) {
    if (impl_item == (SyntaxNode*)0 || impl_item.kind != NodeKind.Impl) {
        return;
    }
    SyntaxNode* block = impl_item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return;
    }
    SyntaxNode* target = impl_target_identifier(impl_item);
    str receiver_type = target == (SyntaxNode*)0 ? "" : target.text;

    SyntaxNode* member = block.first_child;
    while (member != (SyntaxNode*)0) {
        if (member.kind == NodeKind.Token && member.token_kind == TokenKind.Semicolon) {
            member = member.next_sibling;
            continue;
        }
        SyntaxNode* name = (SyntaxNode*)0;
        SyntaxNode* params = (SyntaxNode*)0;
        SyntaxNode* scan = member;
        while (scan != (SyntaxNode*)0
            && scan.kind != NodeKind.Block
            && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
            if (scan.kind == NodeKind.Parenthesized) {
                params = scan;
                break;
            }
            if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                name = scan;
            }
            scan = scan.next_sibling;
        }

        if (name != (SyntaxNode*)0 && params != (SyntaxNode*)0) {
            Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
            collect_borrow_leaves(params, &leaves);
            bool has_reference = false;
            bool mutable = false;
            i64 pi = 0;
            while (pi < leaves.len() && leaves.get(pi).token_kind != TokenKind.Comma) {
                if (leaves.get(pi).token_kind == TokenKind.BitwiseAnd) {
                    has_reference = true;
                } else if (leaves.get(pi).token_kind == TokenKind.Mut) {
                    mutable = true;
                } else if (borrow_text_equals(leaves.get(pi).text, "self")) {
                    i64 mode = has_reference ? (mutable ? 2 : 1) : -1;
                    if (mode >= 1) {
                        table.register(receiver_type, name.text, mode);
                    }
                    break;
                }
                pi += 1;
            }
            leaves.drop();
        }

        while (scan != (SyntaxNode*)0
            && scan.kind != NodeKind.Block
            && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
            scan = scan.next_sibling;
        }
        member = scan == (SyntaxNode*)0 ? (SyntaxNode*)0 : scan.next_sibling;
    }
}

/// Follows type aliases from `name` to the final type name (depth 32;
/// "" when too deep).
str borrow_alias_target(SyntaxTree* tree, SymbolTable* symbols, str name, u32 depth) {
    if (depth >= 32) {
        return "";
    }
    i64 index = symbols.find(name);
    if (index < 0) {
        return name;
    }
    Symbol* symbol = symbols.get(index);
    if (symbol.kind != SymbolKind.TypeAlias || symbol.declaration == (SyntaxNode*)0) {
        return name;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(symbol.declaration, &leaves);
    i64 start = 0;
    while (start < leaves.len() && leaves.get(start).token_kind != TokenKind.Assign) {
        start += 1;
    }
    if (start < leaves.len()) {
        start += 1;
    }
    i64 end = start;
    while (end < leaves.len() && leaves.get(end).token_kind != TokenKind.Semicolon) {
        end += 1;
    }
    TypeProjection target = projection_parse_type(&leaves, start, end);
    str resolved = strlen(target.name) == 0 || borrow_text_equals(target.name, name)
        ? ""
        : borrow_alias_target(tree, symbols, target.name, depth + 1);
    target.arguments.drop();
    leaves.drop();
    return resolved;
}

/// Returns true for nodes that do not start a new borrow scope.
bool borrow_is_transparent_scope_node(SyntaxNode* node) {
    return node.kind != NodeKind.Block && node.kind != NodeKind.If
        && node.kind != NodeKind.While && node.kind != NodeKind.Match
        && node.kind != NodeKind.For && node.kind != NodeKind.Attribute;
}

/// Internal: scans a declaration's type tokens for `[...]` groups.
void borrow_scan_type_brackets(SyntaxNode* node, SyntaxNode* stop, bool* found, bool* done,
                                i64* angle, i64* separators) {
    SyntaxNode* cursor = node.first_child;
    while (cursor != (SyntaxNode*)0 && !*done) {
        if (cursor == stop) {
            *done = true;
            return;
        }
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
            *found = false;
            *angle = 0;
            *separators = 0;
        } else if (cursor.kind == NodeKind.Bracket) {
            *found = true;
        } else if (cursor.kind == NodeKind.Token
            && (cursor.token_kind == TokenKind.LeftBracket
                || cursor.token_kind == TokenKind.RightBracket)) {
            *found = true;
        } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Comma
            && *angle == 1) {
            *separators = *separators + 1;
        } else {
            if (cursor.kind == NodeKind.Token) {
                i64 b = 0;
                while (cursor.text[b] != (u8)0) {
                    if (cursor.text[b] == (u8)60) {
                        *angle = *angle + 1;
                    } else if (cursor.text[b] == (u8)62 && *angle > 0) {
                        *angle = *angle - 1;
                    }
                    b += 1;
                }
            }
            if (borrow_is_transparent_scope_node(cursor)
                && cursor.first_child != (SyntaxNode*)0) {
                borrow_scan_type_brackets(cursor, stop, found, done, angle, separators);
            }
        }
        cursor = cursor.next_sibling;
    }
}

// Declaration projections drop structure the text round-trip cannot
// preserve: `[T]` renders name-only, `[A, B]` splits into two generic
// arguments, and arguments past the second are discarded. Re-parsing that
// text can intern a different type than the declaration, so callers fall
// back to name-based method lookup for those declarations. Fail closed: an
// unrecognized shape also falls back, matching previous behavior.
/// Returns true when a declaration's type spelling contains brackets.
bool borrow_type_span_has_brackets(SyntaxNode* name_node, bool is_array) {
    if (is_array) {
        return true;
    }
    if (name_node == (SyntaxNode*)0) {
        return true;
    }
    SyntaxNode* node = name_node;
    while (node.parent != (SyntaxNode*)0
        && node.parent.kind != NodeKind.Block
        && node.parent.kind != NodeKind.Function
        && node.parent.kind != NodeKind.Program) {
        node = node.parent;
    }
    if (node.parent == (SyntaxNode*)0) {
        return true;
    }
    SyntaxNode* scan_root = node == name_node ? node.parent : node;
    bool found = false;
    bool done = false;
    i64 angle = 0;
    i64 separators = 0;
    borrow_scan_type_brackets(scan_root, name_node, &found, &done, &angle, &separators);
    return found || separators >= 2;
}

/// Returns the type id of a binding's declared type.
u32 borrow_binding_type(SymbolTable* symbols, Binding* binding) {
    if (binding == (Binding*)0 || binding.declared_type.kind == ProjectionTypeKind.Unknown) {
        return TYPE_UNKNOWN;
    }
    if (borrow_type_span_has_brackets(binding.name_node,
        binding.declared_type.kind == ProjectionTypeKind.Array)) {
        return TYPE_UNKNOWN;
    }
    String type_text = binding_declared_type_text(&binding.declared_type);
    if (binding.declared_type.kind == ProjectionTypeKind.Pointer) {
        type_text.push((u8)'*');
    } else if (binding.declared_type.kind == ProjectionTypeKind.Reference) {
        String reference = String.from_str(binding.declared_type.is_mutable ? "&mut " : "&");
        reference.push_str(type_text.to_str());
        type_text.drop();
        type_text = move reference;
    }
    u32 type_id = symbols.types.parse_type_name(type_text.to_str());
    type_text.drop();
    return type_id;
}

/// Returns the type id of global `name`.
u32 borrow_global_type(SymbolTable* symbols, str name) {
    i64 index = symbols.find(name);
    if (index < 0) {
        return TYPE_UNKNOWN;
    }
    Symbol* symbol = symbols.get(index);
    if (symbol.kind != SymbolKind.Global || symbol.declaration == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(symbol.declaration, &leaves);
    i64 name_index = -1;
    i64 i = 0;
    while (i < leaves.len() && leaves.get(i).token_kind != TokenKind.Assign
        && leaves.get(i).token_kind != TokenKind.Semicolon) {
        if (leaves.get(i).token_kind == TokenKind.Identifier) {
            name_index = i;
        }
        i += 1;
    }
    TypeProjection declared = projection_parse_type(&leaves, 0, name_index);
    if (name_index >= 0
        && borrow_type_span_has_brackets(leaves.get(name_index),
            declared.kind == ProjectionTypeKind.Array)) {
        declared.arguments.drop();
        leaves.drop();
        return TYPE_UNKNOWN;
    }
    String type_text = binding_declared_type_text(&declared);
    if (declared.kind == ProjectionTypeKind.Pointer) {
        type_text.push((u8)'*');
    } else if (declared.kind == ProjectionTypeKind.Reference) {
        String reference = String.from_str(declared.is_mutable ? "&mut " : "&");
        reference.push_str(type_text.to_str());
        type_text.drop();
        type_text = move reference;
    }
    u32 type_id = symbols.types.parse_type_name(type_text.to_str());
    type_text.drop();
    declared.arguments.drop();
    leaves.drop();
    return type_id;
}

/// Returns the display name of `type_id`.
str borrow_type_name(TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(types.resolve_subst(type_id));
    while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
        type_id = entry.inner;
        entry = types.get(types.resolve_subst(type_id));
    }
    if (entry.kind != TypeKind.Named) {
        return "";
    }
    return types.names.get(entry.name_id);
}

/// Returns the inferred type of a `let` binding from its initializer.
u32 borrow_inferred_let_type(SymbolTable* symbols, Vec<Binding>* bindings,
                             Binding* binding, u32 depth) {
    if (binding == (Binding*)0 || binding.kind != BindingKind.Let || depth >= 32) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* declaration = binding.name_node;
    if (declaration == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* cursor = declaration.next_sibling;
    while (cursor != (SyntaxNode*)0 && !(cursor.kind == NodeKind.Token
        && cursor.token_kind == TokenKind.Assign)) {
        cursor = cursor.next_sibling;
    }
    if (cursor == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    cursor = cursor.next_sibling;
    if (cursor == (SyntaxNode*)0 || cursor.kind != NodeKind.Token
        || cursor.token_kind != TokenKind.Identifier) {
        return TYPE_UNKNOWN;
    }
    if (cursor.text[0] >= (u8)'A' && cursor.text[0] <= (u8)'Z') {
        String type_text = String.new();
        i64 angle_depth = 0;
        while (cursor != (SyntaxNode*)0) {
            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Less) {
                angle_depth += 1;
            } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Greater
                       && angle_depth > 0) {
                angle_depth -= 1;
            } else if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Dot
                       && angle_depth == 0) {
                break;
            } else if (cursor.kind == NodeKind.Parenthesized || cursor.kind == NodeKind.Block
                       || (cursor.kind == NodeKind.Token
                           && cursor.token_kind == TokenKind.Semicolon)) {
                break;
            }
            type_text.push_str(cursor.text);
            cursor = cursor.next_sibling;
        }
        u32 type_id = symbols.types.parse_type_name(type_text.to_str());
        type_text.drop();
        return type_id;
    }
    SyntaxNode* after_value = cursor.next_sibling;
    if (after_value != (SyntaxNode*)0 && after_value.kind == NodeKind.Token
        && after_value.token_kind == TokenKind.Semicolon) {
        Binding* source = visible_binding(bindings, cursor.text, cursor);
        if (source != (Binding*)0 && source != binding) {
            u32 source_type = borrow_binding_type(symbols, source);
            if (source_type == TYPE_UNKNOWN) {
                source_type = borrow_inferred_let_type(symbols, bindings, source, depth + 1);
            }
            return source_type;
        }
        return TYPE_UNKNOWN;
    }
    if (after_value == (SyntaxNode*)0 || after_value.kind != NodeKind.Parenthesized) {
        return TYPE_UNKNOWN;
    }
    i64 index = symbols.find(cursor.text);
    if (index < 0 || symbols.get(index).kind != SymbolKind.Function
        || symbols.get(index).declaration == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    i64 overloads = 0;
    i64 symbol_index = 0;
    while (symbol_index < symbols.symbols.len()) {
        Symbol* symbol = symbols.symbols.get_ptr(symbol_index);
        if (symbol.kind == SymbolKind.Function
            && borrow_text_equals(symbols.names.get(symbol.name_id), cursor.text)) {
            overloads += 1;
        }
        symbol_index += 1;
    }
    if (overloads != 1) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* function = symbols.get(index).declaration;
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    collect_borrow_leaves(function, &leaves);
    SyntaxNode* name = function_identifier(function);
    i64 name_index = 0;
    while (name_index < leaves.len() && leaves.get(name_index) != name) {
        name_index += 1;
    }
    String type_text = String.new();
    i64 i = 0;
    while (i < name_index) {
        type_text.push_str(leaves.get(i).text);
        i += 1;
    }
    u32 type_id = symbols.types.parse_type_name(type_text.to_str());
    type_text.drop();
    leaves.drop();
    return type_id;
}

/// Returns the receiver type name of a method call on a local.
str borrow_local_receiver_type(SyntaxTree* tree, SymbolTable* symbols,
                               Vec<Binding>* bindings, Binding* visible, str receiver,
                               Vec<SyntaxNode*>* leaves,
                               i64 receiver_root, i64 method_index) {
    u32 receiver_type_id = visible == (Binding*)0
        ? borrow_global_type(symbols, receiver)
        : borrow_binding_type(symbols, visible);
    if (receiver_type_id == TYPE_UNKNOWN && visible != (Binding*)0) {
        receiver_type_id = borrow_inferred_let_type(symbols, bindings, visible, 0);
    }
    str receiver_type = borrow_type_name(&symbols.types, receiver_type_id);
    if (strlen(receiver_type) == 0 && visible != (Binding*)0) {
        receiver_type = visible.declared_type.name;
    }
    str alias_target = borrow_alias_target(tree, symbols, receiver_type, 0);
    if (strlen(alias_target) > 0) {
        receiver_type = alias_target;
        receiver_type_id = symbols.types.parse_type_name(receiver_type);
    }
    i64 part = receiver_root + 1;
    while (part < method_index - 1) {
        if (leaves.get(part).token_kind != TokenKind.Dot
            || leaves.get(part + 1).token_kind != TokenKind.Identifier) {
            receiver_type_id = TYPE_UNKNOWN;
            break;
        }
        receiver_type_id = typecheck_struct_field_type(
            &symbols.types, tree.root, receiver_type_id, leaves.get(part + 1).text);
        if (receiver_type_id == TYPE_UNKNOWN) {
            break;
        }
        part += 2;
    }
    if (receiver_type_id != TYPE_UNKNOWN) {
        receiver_type = borrow_type_name(&symbols.types, receiver_type_id);
    } else {
        receiver_type = "";
    }
    return receiver_type;
}

/// Returns the strongest receiver mode `method` has in any impl, or -1.
i64 borrow_method_receiver_kind(SyntaxTree* tree, str method) {
    if (tree == (SyntaxTree*)0 || tree.root == (SyntaxNode*)0) {
        return -1;
    }
    MethodReceiverTable table = MethodReceiverTable.new();
    SyntaxNode* item = tree.root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            collect_impl_methods_into_table(&table, item);
        }
        item = item.next_sibling;
    }
    return table.get(method);
}

/// Returns the leaf index where the loans of scoped launch `site` end: its
/// straight-line `wait`, else the last leaf of the holder's block.
i64 borrow_task_release_index(Vec<SyntaxNode*>* leaves, ScopedLaunchSite* site) {
    SyntaxNode* scope = site.holder.parent;
    i64 release = -1;
    i64 i = 0;
    while (i < leaves.len()) {
        SyntaxNode* leaf = leaves.get(i);
        if (leaf == site.join) { return i; }
        if (borrow_node_within(leaf, scope)) { release = i; }
        i += 1;
    }
    return release;
}

/// Marks the newest loan as held by the task of `site` until it is joined.
void borrow_mark_task_loan(BorrowAnalyzer* analyzer, Vec<Binding>* bindings,
                           ScopedLaunchSite* site) {
    Loan* loan = analyzer.loans.get_ptr(analyzer.loans.len() - 1);
    loan.task = true;
    Binding* holder = scoped_binding_at(bindings, site.holder);
    if (holder != (Binding*)0) { loan.holder_binding_start = holder.span.start; }
}

/// Marks the newest loan as a task loan held by collection `holder`.
void borrow_mark_collection_loan(BorrowAnalyzer* analyzer, Binding* holder) {
    Loan* loan = analyzer.loans.get_ptr(analyzer.loans.len() - 1);
    loan.task = true;
    if (holder != (Binding*)0) { loan.holder_binding_start = holder.span.start; }
}

/// Adds the loans of local collection `site.collection` for the places the
/// launch at `site_index` borrows. They run from the collection's
/// declaration to the end of its block: a push in a loop runs again after
/// code that precedes it, and the collection's drop is the join.
void borrow_add_collection_loans(BorrowAnalyzer* analyzer, Vec<SyntaxNode*>* leaves,
                                 Vec<Binding>* bindings, ScopedLaunches* launches,
                                 i64 site_index) {
    ScopedLaunchSite* site = launches.sites.get_ptr(site_index);
    SyntaxNode* scope = site.collection.parent;
    i64 release = -1;
    i64 i = 0;
    while (i < leaves.len()) {
        if (borrow_node_within(leaves.get(i), scope)) { release = i; }
        i += 1;
    }
    u32 holder_id = analyzer.names.intern(site.collection.text);
    Binding* holder = scoped_binding_at(bindings, site.collection);
    i = 0;
    while (i < launches.borrows.len()) {
        ScopedLaunchBorrow* borrow = launches.borrows.get_ptr(i);
        i += 1;
        if (borrow.site != site_index || borrow.root == (SyntaxNode*)0) { continue; }
        // The scoped-launch pass rejects `&mut` and places declared after
        // the collection; a loan for them would only add a confusing error.
        Binding* root = scoped_visible_binding(bindings, borrow.root);
        if (borrow.mutable || (root != (Binding*)0 && root.kind != BindingKind.Parameter
                               && root.name_node.span.start > site.collection.span.start)) {
            continue;
        }
        u32 root_id = analyzer.names.intern(borrow.root.text);
        if (!borrow.address) {
            // A forwarded reference keeps what it borrows borrowed too.
            i64 count = analyzer.loans.len();
            i64 loan_index = 0;
            while (loan_index < count) {
                Loan inherited = analyzer.loans.get(loan_index);
                if (inherited.active && inherited.persistent && inherited.holder_id == root_id) {
                    inherited.holder_id = holder_id;
                    inherited.release_index = release;
                    analyzer.loans.push(inherited);
                    borrow_mark_collection_loan(analyzer, holder);
                }
                loan_index += 1;
            }
        }
        analyzer.add(Place.new(root_id), borrow.root.text, borrow.first.span,
            LoanKind.Shared, true, holder_id, release);
        borrow_mark_collection_loan(analyzer, holder);
    }
}

/// Returns true when the tokens `first`..`last` are one whole argument of a call.
bool borrow_is_whole_call_argument(SyntaxNode* first, SyntaxNode* last) {
    SyntaxNode* group = first.parent;
    if (group == (SyntaxNode*)0 || group.kind != NodeKind.Parenthesized) { return false; }
    SyntaxNode* before = binding_previous_sibling(first);
    if (before != (SyntaxNode*)0 && before.token_kind == TokenKind.Move) {
        before = binding_previous_sibling(before);
    }
    if (before != (SyntaxNode*)0 && before.token_kind != TokenKind.Comma) { return false; }
    if (last.next_sibling != (SyntaxNode*)0
        && last.next_sibling.token_kind != TokenKind.Comma) { return false; }
    SyntaxNode* callee = binding_previous_sibling(group);
    if (callee == (SyntaxNode*)0 || callee.kind != NodeKind.Token) { return false; }
    // Macro arguments are formatted through borrows, never moved.
    SyntaxNode* sigil = binding_previous_sibling(callee);
    if (sigil != (SyntaxNode*)0 && sigil.token_kind == TokenKind.At) { return false; }
    return callee.token_kind == TokenKind.Identifier || callee.token_kind == TokenKind.Greater;
}

/// Returns true when `name` is called as a method: `(` follows it.
bool borrow_is_method_name(SyntaxNode* name) {
    return name.next_sibling != (SyntaxNode*)0 && name.next_sibling.kind == NodeKind.Parenthesized;
}

/// Returns one past the last leaf of the field path `a.b.c` that starts at
/// leaf `i`, stopping before a method name.
i64 borrow_field_path_end(Vec<SyntaxNode*>* leaves, i64 i) {
    i64 end = i + 1;
    while (end + 1 < leaves.len() && leaves.get(end).token_kind == TokenKind.Dot
        && leaves.get(end + 1).token_kind == TokenKind.Identifier
        && !borrow_is_method_name(leaves.get(end + 1))) {
        end += 2;
    }
    return end;
}

/// Adds the loan a `lock` block's guard holds on the place it locks, when
/// leaf `i` declares the guard: sync_sugar lowers `lock state.get() as n`
/// to `let __lock_N_guard = state.get().lock();`. The loan runs to the
/// end of the generated block, so the body cannot move, drop, or overwrite
/// `state` while the guard points into it. Returns true when it added one.
bool borrow_add_lock_guard_loan(BorrowAnalyzer* analyzer, Vec<SyntaxNode*>* leaves, i64 i) {
    SyntaxNode* guard = leaves.get(i);
    if (i == 0 || i + 2 >= leaves.len() || leaves.get(i - 1).token_kind != TokenKind.Let
        || leaves.get(i + 1).token_kind != TokenKind.Assign
        || !sugar_is_lock_guard(guard.text)) {
        return false;
    }
    SyntaxNode* first = leaves.get(i + 2);
    // `lock create()` locks a temporary that no local owns.
    if (first.token_kind != TokenKind.Identifier || borrow_is_method_name(first)) { return false; }
    i64 end = borrow_field_path_end(leaves, i + 2);
    SyntaxNode* block = guard.parent;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) { block = block.parent; }
    if (block == (SyntaxNode*)0) { return false; }
    i64 release = i;
    i64 k = i;
    while (k < leaves.len() && borrow_node_within(leaves.get(k), block)) {
        release = k;
        k += 1;
    }
    analyzer.add(borrow_place(analyzer, leaves, i + 2, end), first.text, first.span,
        LoanKind.Shared, true, analyzer.names.intern(guard.text), release);
    Loan* loan = analyzer.loans.get_ptr(analyzer.loans.len() - 1);
    loan.task = true;
    loan.lock_guard = true;
    return true;
}

/// Returns true when the leaf at `index` is `=` or a compound assignment.
bool borrow_is_assignment_operator(Vec<SyntaxNode*>* leaves, i64 index) {
    if (index >= leaves.len()) { return false; }
    str text = leaves.get(index).text;
    return borrow_text_equals(text, "=") || borrow_text_equals(text, "+=")
        || borrow_text_equals(text, "-=") || borrow_text_equals(text, "*=")
        || borrow_text_equals(text, "/=") || borrow_text_equals(text, "%=");
}

/// Reports a use that would move, drop, or overwrite a place while a launched
/// task still borrows it or part of it: the place, or a field path into it,
/// as a by-value call argument, a returned value, the receiver of `.drop()`,
/// or the target of a field assignment.
void borrow_check_task_loan_use(BorrowAnalyzer* analyzer, SyntaxTree* tree,
                                SymbolTable* symbols, Vec<SyntaxNode*>* leaves,
                                Vec<Binding>* bindings, Vec<u32>* binding_types, i64 i) {
    SyntaxNode* node = leaves.get(i);
    i64 end = borrow_field_path_end(leaves, i);
    Place place = borrow_place(analyzer, leaves, i, end);
    i64 loaned = analyzer.find_task_loan(&place);
    if (loaned < 0) { return; }
    Span borrowed_at = analyzer.loans.get_ptr(loaned).span;
    bool locked = analyzer.loans.get_ptr(loaned).lock_guard;
    String path = String.new();
    i64 k = i;
    while (k < end) {
        path.push_str(leaves.get(k).text);
        k += 1;
    }
    // Assigning the whole local is checked where the scan sees `name =`.
    if (end > i + 1 && borrow_is_assignment_operator(leaves, end)) {
        analyzer.assign_place(&place, path.to_str(), node.span);
        return;
    }
    if (end + 1 < leaves.len() && leaves.get(end).token_kind == TokenKind.Dot
        && borrow_text_equals(leaves.get(end + 1).text, "drop")
        && borrow_is_method_name(leaves.get(end + 1))) {
        analyzer.diagnostics.error_with_note(node.span,
            locked ? cannot_drop_locked_owner(path.to_str()) : cannot_drop_task_borrowed(path.to_str()),
            borrowed_at, locked ? note_locked_here() : note_task_borrow_here());
        analyzer.failed = true;
        return;
    }
    SyntaxNode* last = leaves.get(end - 1);
    bool returned = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Return
        && last.next_sibling != (SyntaxNode*)0
        && last.next_sibling.token_kind == TokenKind.Semicolon;
    if (!returned && !borrow_is_whole_call_argument(node, last)) { return; }
    Binding* binding = visible_binding(bindings, node.text, node);
    u32 type_id = borrow_binding_type(symbols, binding);
    if (type_id == TYPE_UNKNOWN) {
        type_id = typecheck_resolved_binding_type(bindings, binding_types, binding);
    }
    k = i + 2;
    while (k < end && type_id != TYPE_UNKNOWN) {
        type_id = typecheck_struct_field_type(&symbols.types, tree.root, type_id, leaves.get(k).text);
        k += 2;
    }
    if (type_id != TYPE_UNKNOWN && typecheck_type_is_copy(tree.root, &symbols.types, type_id)) {
        return;
    }
    analyzer.diagnostics.error_with_note(node.span, cannot_move_borrowed(path.to_str()),
        borrowed_at, locked ? note_locked_here() : note_task_borrow_here());
    analyzer.failed = true;
}

/// Scans one function's leaves in order, recording loans, releasing them,
/// and reporting conflicts and escapes.
void scan_borrows(BorrowAnalyzer* analyzer, SyntaxTree* tree, SymbolTable* symbols,
                  SyntaxNode* function, CfgSet* cfg, MethodReceiverTable* receiver_table,
                  Vec<BorrowReturnOrigin>* return_origins,
                  Vec<BorrowReturnStatus>* return_statuses) {
    SyntaxNode* body = borrow_function_body(function);
    if (body == (SyntaxNode*)0) {
        return;
    }
    Vec<SyntaxNode*> leaves = Vec<SyntaxNode*>.new();
    cfg_collect_live_leaves(body, cfg, &leaves);
    Vec<Binding> bindings = Vec<Binding>.new();
    collect_function_bindings(function, &bindings);
    Vec<u32> binding_types = Vec<u32>.new();
    typecheck_binding_types(symbols, &symbols.types, tree.root, &bindings, &binding_types);
    Vec<i64> release_points = Vec<i64>.new();
    collect_borrow_release_points(body, &leaves, &release_points);
    ScopedLaunches launches = ScopedLaunches.new();
    collect_scoped_launches(tree.root, symbols, &leaves, &bindings, &launches);
    bool lock_guards = false;
    i64 i = 0;
    while (i < leaves.len()) {
        SyntaxNode* node = leaves.get(i);
        if (node.token_kind == TokenKind.Identifier && borrow_add_lock_guard_loan(analyzer, &leaves, i)) {
            lock_guards = true;
        }
        i64 collection_site = 0;
        while (collection_site < launches.sites.len()) {
            if (launches.sites.get_ptr(collection_site).collection == node) {
                borrow_add_collection_loans(analyzer, &leaves, &bindings, &launches,
                    collection_site);
            }
            collection_site += 1;
        }
        // A reference variable passed to a scoped launch stays borrowed by
        // the task, as does everything that variable itself borrows.
        ScopedLaunchBorrow* task_reference = node.token_kind == TokenKind.Identifier
            ? launches.borrow_at(node) : (ScopedLaunchBorrow*)0;
        if (task_reference != (ScopedLaunchBorrow*)0) {
            ScopedLaunchSite* site = launches.sites.get_ptr(task_reference.site);
            Binding* reference = scoped_visible_binding(&bindings, node);
            if (site.holder != (SyntaxNode*)0 && reference != (Binding*)0
                && reference.declared_type.kind == ProjectionTypeKind.Reference) {
                u32 task_holder = analyzer.names.intern(site.holder.text);
                i64 task_release = borrow_task_release_index(&leaves, site);
                u32 reference_id = analyzer.names.intern(node.text);
                i64 count = analyzer.loans.len();
                i64 loan_index = 0;
                while (loan_index < count) {
                    Loan inherited = analyzer.loans.get(loan_index);
                    if (inherited.active && inherited.persistent
                        && inherited.holder_id == reference_id) {
                        inherited.holder_id = task_holder;
                        inherited.release_index = task_release;
                        analyzer.loans.push(inherited);
                        borrow_mark_task_loan(analyzer, &bindings, site);
                    }
                    loan_index += 1;
                }
                analyzer.add(Place.new(reference_id), node.text, node.span,
                    reference.declared_type.is_mutable ? LoanKind.Mutable : LoanKind.Shared,
                    true, task_holder, task_release);
                borrow_mark_task_loan(analyzer, &bindings, site);
            }
        } else if ((launches.sites.len() > 0 || lock_guards) && node.token_kind == TokenKind.Identifier
            && !(i > 0 && leaves.get(i - 1).token_kind == TokenKind.Dot)) {
            borrow_check_task_loan_use(analyzer, tree, symbols, &leaves, &bindings,
                &binding_types, i);
        }
        if (node.token_kind == TokenKind.Assign && i > 0 && i + 1 < leaves.len()
            && leaves.get(i - 1).token_kind == TokenKind.Identifier
            && !(i >= 2 && leaves.get(i - 2).token_kind == TokenKind.Dot)) {
            i64 source_index = i + 1;
            if (leaves.get(source_index).token_kind == TokenKind.Move) { source_index += 1; }
            if (source_index < leaves.len()) {
                SyntaxNode* source = leaves.get(source_index);
                SyntaxNode* after = source.next_sibling;
                if (source.token_kind == TokenKind.Identifier && after != (SyntaxNode*)0
                    && after.token_kind == TokenKind.Semicolon) {
                    str destination = leaves.get(i - 1).text;
                    u32 source_id = analyzer.names.intern(source.text);
                    u32 destination_id = analyzer.names.intern(destination);
                    i64 release = last_use(&leaves, source_index + 1, destination);
                    i64 count = analyzer.loans.len();
                    i64 loan_index = 0;
                    while (loan_index < count) {
                        Loan inherited = analyzer.loans.get(loan_index);
                        if (inherited.active && inherited.persistent && inherited.holder_id == source_id
                            && source_id != destination_id) {
                            inherited.holder_id = destination_id;
                            inherited.release_index = release >= 0 ? release : source_index;
                            analyzer.loans.push(inherited);
                        }
                        loan_index += 1;
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Identifier && i + 1 < leaves.len()
            && task_reference == (ScopedLaunchBorrow*)0) {
            bool is_field = i > 0 && borrow_text_equals(leaves.get(i - 1).text, ".");
            if (!is_field) {
                str aggregate = borrow_aggregate_holder(&bindings, &binding_types,
                    &symbols.types, tree.root, node);
                if (strlen(aggregate) > 0) {
                    u32 source_id = analyzer.names.intern(node.text);
                    u32 holder_id = analyzer.names.intern(aggregate);
                    i64 release = last_use(&leaves, i + 1, aggregate);
                    i64 count = analyzer.loans.len();
                    i64 loan_index = 0;
                    while (loan_index < count) {
                        Loan inherited = analyzer.loans.get(loan_index);
                        if (inherited.active && inherited.persistent
                            && inherited.holder_id == source_id && source_id != holder_id) {
                            inherited.holder_id = holder_id;
                            inherited.release_index = release >= 0 ? release : i;
                            analyzer.loans.push(inherited);
                        }
                        loan_index += 1;
                    }
                }
                str next = leaves.get(i + 1).text;
                if (borrow_text_equals(next, "=") || borrow_text_equals(next, "+=") || borrow_text_equals(next, "-=") || borrow_text_equals(next, "*=") || borrow_text_equals(next, "/=") || borrow_text_equals(next, "%=")) {
                    analyzer.assign(node.text, node.span);
                } else {
                    bool address = i > 0 && leaves.get(i - 1).token_kind == TokenKind.BitwiseAnd;
                    address = address || (i >= 2 && leaves.get(i - 1).token_kind == TokenKind.Mut
                        && leaves.get(i - 2).token_kind == TokenKind.BitwiseAnd);
                    if (!address) {
                        Place place = borrow_place(analyzer, &leaves, i, leaves.len());
                        bool consuming = false;
                        bool explicit_move = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Move;
                        bool assignment_source = i > 0 && leaves.get(i - 1).token_kind == TokenKind.Assign
                            && node.next_sibling != (SyntaxNode*)0
                            && node.next_sibling.token_kind == TokenKind.Semicolon;
                        if (explicit_move || assignment_source) {
                            Binding* binding = visible_binding(&bindings, node.text, node);
                            u32 type_id = borrow_binding_type(symbols, binding);
                            if (type_id == TYPE_UNKNOWN) {
                                type_id = typecheck_resolved_binding_type(&bindings, &binding_types, binding);
                            }
                            consuming = type_id == TYPE_UNKNOWN
                                || !typecheck_type_is_copy(tree.root, &symbols.types, type_id);
                        }
                        i64 conflict = analyzer.find_conflict(&place,
                            consuming ? LoanKind.Mutable : LoanKind.Shared);
                        if (conflict >= 0) {
                            Loan* loan = analyzer.loans.get_ptr(conflict);
                            if (consuming) {
                                analyzer.diagnostics.error_with_note(node.span, cannot_move_borrowed(node.text),
                                    loan.span, borrow_loan_note(loan));
                                analyzer.failed = true;
                            } else {
                                analyzer.conflict(node.text, node.span, loan, false);
                            }
                        }
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Identifier && i >= 2
            && leaves.get(i - 1).token_kind == TokenKind.Dot
            && leaves.get(i - 2).token_kind == TokenKind.Identifier
            && node.next_sibling != (SyntaxNode*)0
            && node.next_sibling.kind == NodeKind.Parenthesized) {
            i64 receiver_root = i - 2;
            while (receiver_root >= 2 && leaves.get(receiver_root - 1).token_kind == TokenKind.Dot
                && leaves.get(receiver_root - 2).token_kind == TokenKind.Identifier) {
                receiver_root -= 2;
            }
            Binding* receiver_binding = visible_binding(
                &bindings, leaves.get(receiver_root).text, leaves.get(receiver_root));
            str receiver_type = borrow_local_receiver_type(
                tree, symbols, &bindings, receiver_binding,
                leaves.get(receiver_root).text, &leaves, receiver_root, i);
            i64 receiver_mode = strlen(receiver_type) > 0
                ? receiver_table.get_for_type(receiver_type, node.text)
                : receiver_table.get(node.text);
            bool shared_call_argument = receiver_mode == 2
                && borrow_method_args_call_same_receiver(&leaves, receiver_root, i);
            if (receiver_mode >= 1
                && !borrow_receiver_contains_call(&leaves, receiver_root, i)
                && !shared_call_argument) {
                Place receiver = borrow_place(analyzer, &leaves, receiver_root, i - 1);
                LoanKind receiver_kind = receiver_mode == 2 ? LoanKind.Mutable : LoanKind.Shared;
                analyzer.add(move receiver, leaves.get(receiver_root).text, leaves.get(receiver_root).span,
                    receiver_kind, false, (u32)0, i);
                if (borrow_method_returns_receiver(tree.root, receiver_type, node,
                    &bindings, &symbols.types)) {
                    str result_holder = borrow_call_result_holder(&bindings,
                        &binding_types, &leaves, node, leaves.get(receiver_root),
                        &symbols.types, tree.root);
                    if (strlen(result_holder) > 0) {
                        Place forwarded = borrow_place(analyzer, &leaves, receiver_root, i - 1);
                        u32 forwarded_holder = analyzer.names.intern(result_holder);
                        Binding* result_binding = visible_binding(&bindings,
                            result_holder, node);
                        i64 forwarded_release = result_binding != (Binding*)0
                            ? last_binding_use(&bindings, &leaves, i + 1, result_binding)
                            : last_use(&leaves, i + 1, result_holder);
                        analyzer.add(move forwarded, leaves.get(receiver_root).text,
                            leaves.get(receiver_root).span, receiver_kind, true,
                            forwarded_holder, forwarded_release >= 0 ? forwarded_release : i);
                        i64 added = analyzer.loans.len() - 1;
                        if (result_binding != (Binding*)0) {
                            analyzer.loans.get_ptr(added).holder_binding_start = result_binding.span.start;
                        }
                        Binding* owner = visible_binding(&bindings,
                            leaves.get(receiver_root).text, leaves.get(receiver_root));
                        if (owner != (Binding*)0 && owner.kind != BindingKind.Parameter) {
                            analyzer.loans.get_ptr(added).owner_scope = binding_visibility_scope(owner);
                        }
                        if (borrow_is_global(tree, symbols, result_holder)) {
                            report_escape(analyzer, tree, symbols, function,
                                leaves.get(receiver_root).text, leaves.get(receiver_root).span);
                        }
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Return) {
            i64 j = i + 1;
            if (j < leaves.len() && leaves.get(j).token_kind == TokenKind.Move) { j += 1; }
            if (borrow_function_returns_indirect(function, symbols)
                && j < leaves.len() && leaves.get(j).token_kind == TokenKind.BitwiseAnd) {
                j += 1;
                if (j < leaves.len() && borrow_text_equals(leaves.get(j).text, "mut")) {
                    j += 1;
                }
                if (j < leaves.len() && leaves.get(j).token_kind == TokenKind.Identifier) {
                    report_escape(analyzer, tree, symbols, function, leaves.get(j).text, leaves.get(j).span);
                }
            } else if (borrow_function_returns_indirect(function, symbols)
                && j < leaves.len() && leaves.get(j).token_kind == TokenKind.Identifier) {
                u32 holder_id = analyzer.names.intern(leaves.get(j).text);
                i64 loan_index = 0;
                while (loan_index < analyzer.loans.len()) {
                    Loan* loan = analyzer.loans.get_ptr(loan_index);
                    if (loan.active && loan.persistent && loan.holder_id == holder_id) {
                        str source = analyzer.names.get(loan.place.local_id);
                        report_escape(analyzer, tree, symbols, function, source, leaves.get(j).span);
                    }
                    loan_index += 1;
                }
            }
        }
        if (node.token_kind == TokenKind.BitwiseAnd) {
            bool expression_position = i > 0;
            if (i > 0) {
                str previous = leaves.get(i - 1).text;
                expression_position = borrow_text_equals(previous, "=") || borrow_text_equals(previous, "(") || borrow_text_equals(previous, ",") || borrow_text_equals(previous, "return") || leaves.get(i - 1).token_kind == TokenKind.Identifier;
            }
            if (expression_position) {
                i64 j = i + 1;
                bool mutable = false;
                if (j < leaves.len() && borrow_text_equals(leaves.get(j).text, "mut")) {
                    mutable = true;
                    j += 1;
                }
                if (j < leaves.len() && leaves.get(j).token_kind == TokenKind.Identifier) {
                    str name = leaves.get(j).text;
                    if (borrow_in_return_expression(node)
                        && borrow_function_returns_indirect(function, symbols)) {
                        i64 return_argument_index = 0;
                        SyntaxNode* return_call = borrow_call_for_argument(
                            leaves.get(j), &return_argument_index);
                        bool returned = return_call == (SyntaxNode*)0;
                        if (return_call != (SyntaxNode*)0) {
                            return_call = borrow_lift_forwarded_call(return_origins,
                                return_call, &return_argument_index, tree.root,
                                return_statuses, &bindings);
                            returned = return_call != (SyntaxNode*)0
                                && borrow_call_returns_argument(return_origins,
                                return_call, return_argument_index,
                                borrow_call_arity(return_call), tree.root,
                                return_statuses, &bindings);
                        }
                        if (returned) {
                            report_escape(analyzer, tree, symbols, function,
                                name, leaves.get(j).span);
                        }
                    }
                    Place place = borrow_place(analyzer, &leaves, j, leaves.len());
                    bool persistent = i > 0 && borrow_text_equals(leaves.get(i - 1).text, "=");
                    str aggregate_holder = borrow_aggregate_holder(&bindings,
                        &binding_types, &symbols.types, tree.root, node);
                    persistent = persistent || strlen(aggregate_holder) > 0;
                    Binding* source_binding = visible_binding(&bindings, name, leaves.get(j));
                    if (source_binding == (Binding*)0) {
                        source_binding = borrow_unique_prior_binding(&bindings,
                            name, leaves.get(j));
                    }
                    u32 source_type = typecheck_resolved_binding_type(
                        &bindings, &binding_types, source_binding);
                    bool unchecked_pointer_access = source_type != TYPE_UNKNOWN
                        && symbols.types.get(
                            symbols.types.resolve_subst(source_type)).kind == TypeKind.Pointer
                        && place.projections_count > 0;
                    if (unchecked_pointer_access) { persistent = false; }
                    // A scoped launch argument stays borrowed until its task
                    // is joined; a launch waited in place ends with the statement.
                    ScopedLaunchBorrow* task_borrow = launches.borrow_at(node);
                    ScopedLaunchSite* task_site = task_borrow != (ScopedLaunchBorrow*)0
                        ? launches.sites.get_ptr(task_borrow.site) : (ScopedLaunchSite*)0;
                    if (task_site != (ScopedLaunchSite*)0 && task_site.holder == (SyntaxNode*)0) {
                        task_site = (ScopedLaunchSite*)0;
                    }
                    if (task_site != (ScopedLaunchSite*)0) { persistent = !unchecked_pointer_access; }
                    LoanKind kind = LoanKind.Shared;
                    if (mutable) {
                        kind = LoanKind.Mutable;
                    }
                    u32 holder_id = (u32)0;
                    i64 release_index = leaves.len();
                    if (persistent && task_site == (ScopedLaunchSite*)0) {
                        str holder = strlen(aggregate_holder) > 0
                            ? aggregate_holder : persistent_holder(&leaves, i);
                        Binding* destination = visible_binding(&bindings, holder, node);
                        u32 slot_type = borrow_assignment_slot_type(
                            &bindings, &binding_types, &symbols.types,
                            tree.root, &leaves, i, destination);
                        bool pointer_slot = slot_type != TYPE_UNKNOWN
                            && symbols.types.get(
                                symbols.types.resolve_subst(slot_type)).kind
                                    == TypeKind.Pointer;
                        if (pointer_slot) {
                            persistent = false;
                            unchecked_pointer_access = true;
                        }
                    }
                    if (persistent && task_site != (ScopedLaunchSite*)0) {
                        holder_id = analyzer.names.intern(task_site.holder.text);
                        release_index = borrow_task_release_index(&leaves, task_site);
                    } else if (persistent) {
                        str holder = strlen(aggregate_holder) > 0
                            ? aggregate_holder : persistent_holder(&leaves, i);
                        if (strlen(holder) > 0) {
                            holder_id = analyzer.names.intern(holder);
                            i64 use_index = last_use(&leaves, i + 1, holder);
                            release_index = use_index >= 0 ? use_index : leaves.len();
                        }
                        else {
                            release_index = i;
                        }
                    }
                    if (persistent && i >= 2 && borrow_text_equals(leaves.get(i - 1).text, "=")
                        && borrow_is_global(tree, symbols, leaves.get(i - 2).text)) {
                        report_escape(analyzer, tree, symbols, function, name, leaves.get(j).span);
                    }
                    if (!unchecked_pointer_access) {
                        analyzer.add(move place, name, leaves.get(j).span,
                            kind, persistent, holder_id, release_index);
                    }
                    if (persistent && task_site != (ScopedLaunchSite*)0) {
                        borrow_mark_task_loan(analyzer, &bindings, task_site);
                    } else if (persistent && holder_id > 0) {
                        i64 added = analyzer.loans.len() - 1;
                        Binding* holder = visible_binding(&bindings,
                            analyzer.names.get(holder_id), node);
                        if (holder != (Binding*)0) {
                            analyzer.loans.get_ptr(added).holder_binding_start = holder.span.start;
                        }
                        Binding* owner = source_binding;
                        if (owner != (Binding*)0 && owner.kind != BindingKind.Parameter) {
                            analyzer.loans.get_ptr(added).owner_scope = binding_visibility_scope(owner);
                        }
                    }

                    // Passing a borrow to a function that returns that input
                    // transfers the loan to the call result's binding.
                    i64 argument_index = 0;
                    SyntaxNode* call = borrow_call_for_argument(leaves.get(j), &argument_index);
                    call = borrow_lift_forwarded_call(return_origins,
                        call, &argument_index, tree.root, return_statuses, &bindings);
                    if (call != (SyntaxNode*)0
                        && borrow_call_returns_argument(return_origins, call,
                            argument_index, borrow_call_arity(call), tree.root,
                            return_statuses,
                            &bindings)) {
                        str result_holder = borrow_call_result_holder(&bindings,
                            &binding_types, &leaves, call, node, &symbols.types, tree.root);
                        if (strlen(result_holder) > 0
                            && !borrow_in_return_expression(node)) {
                            Place forwarded = borrow_place(analyzer, &leaves, j, leaves.len());
                            u32 forwarded_holder = analyzer.names.intern(result_holder);
                            Binding* result_binding = visible_binding(&bindings,
                                result_holder, call);
                            i64 forwarded_release = result_binding != (Binding*)0
                                ? last_binding_use(&bindings, &leaves, i + 1, result_binding)
                                : last_use(&leaves, i + 1, result_holder);
                            analyzer.add(move forwarded, name, leaves.get(j).span, kind, true,
                                forwarded_holder, forwarded_release >= 0 ? forwarded_release : i);
                            Binding* owner = visible_binding(&bindings, name, leaves.get(j));
                            i64 added = analyzer.loans.len() - 1;
                            if (result_binding != (Binding*)0) {
                                analyzer.loans.get_ptr(added).holder_binding_start = result_binding.span.start;
                            }
                            if (owner != (Binding*)0 && owner.kind != BindingKind.Parameter) {
                                analyzer.loans.get_ptr(added).owner_scope = binding_visibility_scope(owner);
                            }
                            if (borrow_is_global(tree, symbols, result_holder)) {
                                report_escape(analyzer, tree, symbols, function, name,
                                    leaves.get(j).span);
                            }
                        }
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Identifier) {
            i64 argument_index = 0;
            SyntaxNode* call = borrow_call_for_argument(node, &argument_index);
            call = borrow_lift_forwarded_call(return_origins,
                call, &argument_index, tree.root, return_statuses, &bindings);
            i64 argument_count = borrow_call_arity(call);
            if (call != (SyntaxNode*)0 && borrow_call_returns_argument(
                return_origins, call, argument_index, argument_count,
                tree.root, return_statuses, &bindings)) {
                Binding* source_binding = visible_binding(&bindings, node.text, node);
                if (source_binding != (Binding*)0) {
                    str result_holder = borrow_call_result_holder(&bindings,
                        &binding_types, &leaves, call, node, &symbols.types, tree.root);
                    if (strlen(result_holder) > 0) {
                        Binding* result_binding = visible_binding(&bindings,
                            result_holder, call);
                        i64 result_release = result_binding != (Binding*)0
                            ? last_binding_use(&bindings, &leaves, i + 1, result_binding)
                            : last_use(&leaves, i + 1, result_holder);
                        i64 source_count = analyzer.loans.len(); i64 source_index = 0;
                        while (source_index < source_count) {
                            Loan* source = analyzer.loans.get_ptr(source_index);
                            if (source.active && source.persistent
                                && borrow_is_holder_use(&bindings, source, node)) {
                                Place forwarded = source.place;
                                str origin_name = analyzer.names.get(source.place.local_id);
                                Span origin_span = source.span;
                                LoanKind origin_kind = source.kind;
                                SyntaxNode* owner_scope = source.owner_scope;
                                analyzer.add(move forwarded, origin_name, origin_span,
                                    origin_kind, true,
                                    analyzer.names.intern(result_holder),
                                    result_release >= 0 ? result_release : i);
                                i64 added = analyzer.loans.len() - 1;
                                if (result_binding != (Binding*)0) {
                                    analyzer.loans.get_ptr(added).holder_binding_start = result_binding.span.start;
                                }
                                analyzer.loans.get_ptr(added).owner_scope = owner_scope;
                                if (borrow_is_global(tree, symbols, result_holder)) {
                                    report_escape(analyzer, tree, symbols, function,
                                        origin_name, node.span);
                                }
                            }
                            source_index += 1;
                        }
                    }
                }
            }
        }
        if (node.token_kind == TokenKind.Semicolon) {
            analyzer.end_statement();
        }
        i64 loan_index = 0;
        while (loan_index < analyzer.loans.len()) {
            Loan* loan = analyzer.loans.get_ptr(loan_index);
            if (loan.active && loan.persistent && loan.owner_scope != (SyntaxNode*)0
                && borrow_scope_ends_after(&leaves, i, loan.owner_scope)
                && loan.release_index > i) {
                i64 use_index = i + 1;
                while (use_index <= loan.release_index && use_index < leaves.len()
                    && (loan.holder_binding_start > 0
                        ? !borrow_is_holder_use(&bindings, loan, leaves.get(use_index))
                        : (leaves.get(use_index).token_kind != TokenKind.Identifier
                            || !borrow_text_equals(leaves.get(use_index).text,
                                analyzer.names.get(loan.holder_id))))) {
                    use_index += 1;
                }
                if (use_index <= loan.release_index && use_index < leaves.len()) {
                    String message = String.from_str(ref_does_not_outlive_func());
                    analyzer.diagnostics.error(leaves.get(use_index).span, move message);
                    analyzer.failed = true;
                }
                loan.active = false;
            }
            loan_index += 1;
        }
        i64 point = 0;
        while (point < release_points.len()) {
            if (release_points.get(point) == i) {
                analyzer.end_statement();
            }
            point += 1;
        }
        analyzer.release_due(i);
        i += 1;
    }
    launches.sites.drop();
    launches.borrows.drop();
    bindings.drop();
    release_points.drop();
    leaves.drop();
}

/// Runs the borrow and escape checks on every cfg-active function. Returns
/// false when any error was reported.
bool check_borrows(SyntaxTree* tree, SymbolTable* symbols, DiagnosticBag* diagnostics, CfgSet* cfg) {
    bool ok = true;
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    cfg_collect_items(tree.root, cfg, diagnostics, &items);

    Vec<BorrowReturnStatus> return_statuses = Vec<BorrowReturnStatus>.new();
    borrow_collect_return_statuses(tree.root, tree, symbols, &return_statuses);
    Vec<BorrowReturnOrigin> return_origins = Vec<BorrowReturnOrigin>.new();
    borrow_collect_return_origins(tree.root, &return_origins, &return_statuses);

    MethodReceiverTable receiver_table = MethodReceiverTable.new();
    i64 idx = 0;
    while (idx < items.len()) {
        SyntaxNode* item = items.get(idx);
        if (item.kind == NodeKind.Impl) {
            collect_impl_methods_into_table(&receiver_table, item);
        }
        idx += 1;
    }

    i64 i = 0;
    while (i < items.len()) {
        if (items.get(i).kind == NodeKind.Function) {
            BorrowAnalyzer analyzer = BorrowAnalyzer.new(diagnostics);
            scan_borrows(&analyzer, tree, symbols, items.get(i), cfg,
                &receiver_table, &return_origins, &return_statuses);
            if (analyzer.failed) {
                ok = false;
            }
        }
        i += 1;
    }
    items.drop();
    return_origins.drop();
    return_statuses.drop();
    if (!check_scoped_launches(tree, symbols, diagnostics, cfg)) {
        ok = false;
    }
    return ok;
}
