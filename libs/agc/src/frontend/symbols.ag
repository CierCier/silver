// Deterministic top-level symbol collection for the stage1 frontend.
import std.mem.vec;
import std.mem.memory;
import std.string;
import std.intern;
import std.optional;
import std.map;
import frontend.ast;
import frontend.diagnostics;
import frontend.cfg;
import frontend.types;
import frontend.place;

/// The kind of a top-level symbol.
enum SymbolKind {
    Function;
    Struct;
    Enum;
    Trait;
    Global;
    TypeAlias;
}

/// One top-level symbol: interned name, kind, declaration span and node,
/// resolved type id (0 until typed), and C ABI flags.
struct Symbol {
    u32 name_id;
    SymbolKind kind;
    Span span;
    SyntaxNode* declaration;
    u32 type_id;
    bool c_abi;
    bool c_variadic;
}

/// The overload type checking chose for the launched call whose callee name
/// starts at `start` in `file`, so later passes judge it by its real callee.
struct SelectedCallee {
    i64 file;
    i64 start;
    SyntaxNode* function;
}

/// The top-level names of a program: an interner, the symbols in
/// declaration order, the type table, and a name-id index. Owns all of it;
/// `declaration` pointers borrow the syntax tree.
struct SymbolTable {
    Interner names;
    Vec<Symbol> symbols;
    TypeTable types;
    Vec<i64> index_by_name_id;
    Vec<InitOwnerPlan> init_owner_plans;
    Vec<SelectedCallee> selected_callees;
}

impl SymbolTable {
    /// Creates an empty table.
    SymbolTable new() {
        SymbolTable table;
        table.names = Interner.new();
        table.symbols = Vec<Symbol>.new();
        table.types = TypeTable.new();
        table.index_by_name_id = Vec<i64>.new();
        table.init_owner_plans = Vec<InitOwnerPlan>.new();
        table.selected_callees = Vec<SelectedCallee>.new();
        return move table;
    }

    /// Returns a deep copy (syntax-node pointers are shared, not copied).
    SymbolTable clone(&self) {
        SymbolTable copy;
        copy.names = self.names.clone();
        copy.symbols = Vec<Symbol>.with_capacity(self.symbols.len());
        i64 i = 0;
        while (i < self.symbols.len()) {
            copy.symbols.push(self.symbols.get(i));
            i += 1;
        }
        copy.types = self.types.clone();
        copy.index_by_name_id = Vec<i64>.with_capacity(self.index_by_name_id.len());
        i = 0;
        while (i < self.index_by_name_id.len()) {
            copy.index_by_name_id.push(self.index_by_name_id.get(i));
            i += 1;
        }
        copy.init_owner_plans = Vec<InitOwnerPlan>.with_capacity(self.init_owner_plans.len());
        i = 0;
        while (i < self.init_owner_plans.len()) {
            copy.init_owner_plans.push(self.init_owner_plans.get_ptr(i).clone());
            i += 1;
        }
        copy.selected_callees = Vec<SelectedCallee>.with_capacity(self.selected_callees.len());
        i = 0;
        while (i < self.selected_callees.len()) {
            copy.selected_callees.push(self.selected_callees.get(i));
            i += 1;
        }
        return move copy;
    }

    /// Records `function` as the overload chosen for the callee name at `span`.
    void select_callee(SymbolTable* self, Span span, SyntaxNode* function) {
        if (self.selected_callee(span) != (SyntaxNode*)0) { return; }
        SelectedCallee selected;
        selected.file = span.file;
        selected.start = span.start;
        selected.function = function;
        self.selected_callees.push(selected);
    }

    /// Returns the overload chosen for the callee name at `span`, or null
    /// when type checking chose none (no overloads, or not checked).
    SyntaxNode* selected_callee(SymbolTable* self, Span span) {
        i64 i = 0;
        while (i < self.selected_callees.len()) {
            SelectedCallee* selected = self.selected_callees.get_ptr(i);
            if (selected.file == span.file && selected.start == span.start) {
                return selected.function;
            }
            i += 1;
        }
        return (SyntaxNode*)0;
    }

    /// Returns the number of symbols.
    i64 len(&self) {
        return self.symbols.len();
    }

    /// Returns symbol `index`. Invalidated when the table grows.
    Symbol* get(SymbolTable* self, i64 index) {
        return self.symbols.get_ptr(index);
    }

    /// Internal: records `symbol_idx` as the symbol for `name_id`.
    void set_symbol_index(SymbolTable* self, u32 name_id, i64 symbol_idx) {
        while (self.index_by_name_id.len() <= (i64)name_id) {
            self.index_by_name_id.push(-1);
        }
        self.index_by_name_id.set((i64)name_id, symbol_idx);
    }

    /// Returns the symbol index for `name_id`, or -1.
    i64 find_by_name_id(SymbolTable* self, u32 name_id) {
        if ((i64)name_id >= self.index_by_name_id.len()) {
            return -1;
        }
        return self.index_by_name_id.get((i64)name_id);
    }

    /// Returns the symbol index for `name`, or -1.
    i64 find(SymbolTable* self, str name) {
        Optional<u32> found = map_get_opt_str_u32(&self.names.ids, name);
        if (!found.is_some()) {
            return -1;
        }
        return self.find_by_name_id(found.unwrap());
    }

    /// Declares an untyped symbol; see `declare_typed`.
    bool declare(SymbolTable* self, u32 name_id, SymbolKind kind, Span span, SyntaxNode* declaration) {
        return self.declare_typed(name_id, kind, span, declaration, 0);
    }

    /// Declares a symbol. When the name exists, returns true without adding it
    /// if either side is a function or global (overloads and cfg variants are
    /// checked later), and false for any other duplicate.
    bool declare_typed(SymbolTable* self, u32 name_id, SymbolKind kind, Span span, SyntaxNode* declaration, u32 type_id) {
        i64 existing = self.find_by_name_id(name_id);
        if (existing >= 0) {
            Symbol* previous = self.symbols.get_ptr(existing);
            // Stage0 permits free-function overloads and cfg-dependent
            // globals. Signature-sensitive duplicate checks belong in the
            // typed symbol-table pass; the CST pass must not reject them.
            if (previous.kind == SymbolKind.Function
                || kind == SymbolKind.Function
                || previous.kind == SymbolKind.Global
                || kind == SymbolKind.Global) {
                return true;
            }
            return false;
        }
        i64 symbol_idx = self.symbols.len();
        Symbol symbol;
        symbol.name_id = name_id;
        symbol.kind = kind;
        symbol.span = span;
        symbol.declaration = declaration;
        symbol.type_id = type_id;
        symbol.c_abi = false;
        symbol.c_variadic = false;
        self.symbols.push(move symbol);
        self.set_symbol_index(name_id, symbol_idx);
        return true;
    }

    /// Returns the type id of symbol `name`, or `TYPE_UNKNOWN`.
    u32 get_type(SymbolTable* self, str name) {
        i64 idx = self.find(name);
        if (idx < 0) {
            return TYPE_UNKNOWN;
        }
        return self.symbols.get_ptr(idx).type_id;
    }

    /// Sets the type id of symbol `name` when it exists.
    void set_type(SymbolTable* self, str name, u32 type_id) {
        i64 idx = self.find(name);
        if (idx >= 0) {
            self.symbols.get_ptr(idx).type_id = type_id;
        }
    }

    /// Adds `name` as a global symbol unless the name is already declared.
    void add_visible(SymbolTable* self, str name, Span span, SyntaxNode* declaration) {
        u32 name_id = self.names.intern(name);
        if (self.find_by_name_id(name_id) >= 0) {
            return;
        }
        i64 symbol_idx = self.symbols.len();
        Symbol symbol;
        symbol.name_id = name_id;
        symbol.kind = SymbolKind.Global;
        symbol.span = span;
        symbol.declaration = declaration;
        symbol.type_id = 0;
        symbol.c_abi = false;
        symbol.c_variadic = false;
        self.symbols.push(move symbol);
        self.set_symbol_index(name_id, symbol_idx);
    }
}

/// Returns true for an identifier token, including builtin type names such
/// as `Vec` that lex as their own token kinds.
bool node_is_identifier(SyntaxNode* node) {
    return node != (SyntaxNode*)0
        && node.kind == NodeKind.Token
        && (node.token_kind == TokenKind.Identifier
            || node.token_kind == TokenKind.VecType
            || node.token_kind == TokenKind.OptionalType);
}

/// Returns true for a primitive type keyword token.
bool is_primitive_type_token(TokenKind kind) {
    return match kind {
        TokenKind.I8 : true,
        TokenKind.I16 : true,
        TokenKind.I32 : true,
        TokenKind.I64 : true,
        TokenKind.I128 : true,
        TokenKind.U8 : true,
        TokenKind.U16 : true,
        TokenKind.U32 : true,
        TokenKind.U64 : true,
        TokenKind.U128 : true,
        TokenKind.F32 : true,
        TokenKind.F64 : true,
        TokenKind.F80 : true,
        TokenKind.C32 : true,
        TokenKind.C64 : true,
        TokenKind.C80 : true,
        TokenKind.Bool : true,
        TokenKind.Str : true,
        TokenKind.Char : true,
        TokenKind.Void : true,
        TokenKind.VecType : true,
        TokenKind.OptionalType : true,
        _ : false,
    };
}

/// Returns the name token of a function item, or null.
SyntaxNode* function_identifier(SyntaxNode* item) {
    SyntaxNode* child = item.first_child;
    SyntaxNode* candidate = (SyntaxNode*)0;
    SyntaxNode* function_name = (SyntaxNode*)0;
    i64 angle_depth = 0;
    while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
        if (child.kind == NodeKind.Token
            && (child.token_kind == TokenKind.Semicolon || child.token_kind == TokenKind.LeftBrace
                || strcmp(child.text, "where") == 0)) {
            break;
        }
        if (child.kind == NodeKind.Token && child.text == "<") {
            angle_depth += 1;
        } else if (child.kind == NodeKind.Token && child.text == ">" && angle_depth > 0) {
            angle_depth -= 1;
        } else if (angle_depth == 0 && node_is_identifier(child)) {
            candidate = child;
        } else if (angle_depth == 0 && child.kind == NodeKind.Parenthesized
            && candidate != (SyntaxNode*)0) {
            // A function-valued return type may have an earlier parameter group.
            function_name = candidate;
        }
        child = child.next_sibling;
    }
    return function_name;
}

/// Returns the name token of any named item, or null.
SyntaxNode* item_identifier(SyntaxNode* item) {
    if (item == (SyntaxNode*)0) {
        return (SyntaxNode*)0;
    }
    if (item.kind == NodeKind.Struct || item.kind == NodeKind.Enum || item.kind == NodeKind.Trait || item.kind == NodeKind.TypeAlias) {
        SyntaxNode* child = item.first_child;
        bool saw_type_keyword = false;
        while (child != (SyntaxNode*)0) {
            if (child.kind == NodeKind.Token && !saw_type_keyword) {
                if (child.token_kind == TokenKind.Struct || child.token_kind == TokenKind.Enum || child.token_kind == TokenKind.Trait || child.token_kind == TokenKind.Type || strcmp(child.text, "struct") == 0 || strcmp(child.text, "enum") == 0 || strcmp(child.text, "trait") == 0 || strcmp(child.text, "type") == 0) {
                    saw_type_keyword = true;
                }
            } else if (saw_type_keyword && node_is_identifier(child)) {
                return child;
            }
            child = child.next_sibling;
        }
        return (SyntaxNode*)0;
    }
    if (item.kind == NodeKind.Function) {
        return function_identifier(item);
    }
    if (item.kind == NodeKind.Global) {
        SyntaxNode* child = item.first_child;
        SyntaxNode* last_identifier = (SyntaxNode*)0;
        while (child != (SyntaxNode*)0) {
            if (child.kind == NodeKind.Token && child.text == "=") {
                break;
            }
            if (node_is_identifier(child)) {
                last_identifier = child;
            }
            child = child.next_sibling;
        }
        return last_identifier;
    }
    return (SyntaxNode*)0;
}

/// Returns true for a function item.
bool symbol_item_is_function(SyntaxNode* item) {
    return item != (SyntaxNode*)0 && item.kind == NodeKind.Function;
}

/// Returns true for a struct item.
bool symbol_item_is_struct(SyntaxNode* item) {
    return item != (SyntaxNode*)0 && item.kind == NodeKind.Struct;
}

/// Returns the symbol kind for an item node.
SymbolKind symbol_kind_for_item(SyntaxNode* item) {
    return match item.kind {
        NodeKind.Function : SymbolKind.Function,
        NodeKind.Struct : SymbolKind.Struct,
        NodeKind.Enum : SymbolKind.Enum,
        NodeKind.Trait : SymbolKind.Trait,
        NodeKind.Global : SymbolKind.Global,
        NodeKind.TypeAlias : SymbolKind.TypeAlias,
        _ : SymbolKind.Global,
    };
}

/// Declares one item's name, reporting a duplicate-symbol error for a
/// same-file conflict. Imported names may be shadowed by local ones.
bool record_item(SymbolTable* table, DiagnosticBag* diagnostics, SyntaxNode* item) {
    if (item.kind == NodeKind.Import || item.kind == NodeKind.CfgBlock || item.kind == NodeKind.Extern || item.kind == NodeKind.Macro) {
        return true;
    }
    SyntaxNode* name = item_identifier(item);
    if (name == (SyntaxNode*)0) {
        return true;
    }
    u32 name_id = table.names.intern(name.text);
    SymbolKind kind = symbol_kind_for_item(item);
    u32 type_id = 0;
    if (kind == SymbolKind.Struct || kind == SymbolKind.Enum || kind == SymbolKind.Trait || kind == SymbolKind.TypeAlias) {
        type_id = table.types.get_named(name.text);
    }
    i64 previous_index = table.find(name.text);
    if (previous_index >= 0) {
        Symbol* previous = table.get(previous_index);
        // Native stage1 merges imported units after the entry source. Keep
        // entry-module declarations visible when an imported module exports
        // the same short name; same-file duplicates remain errors.
        if (previous.span.file == 1 && name.span.file != 1) { return true; }
    }
    if (!table.declare_typed(name_id, kind, name.span, item, type_id)) {
        String message = String.from_str("duplicate symbol '");
        message.push_str(name.text);
        message.push_str("'");
        diagnostics.error(name.span, move message);
        return false;
    }
    return true;
}

/// Collects the cfg-visible top-level symbols of `tree` into `table`.
/// Returns false when any duplicate was reported.
bool collect_symbols(SymbolTable* table, DiagnosticBag* diagnostics, SyntaxTree* tree, CfgSet* cfg) {
    bool ok = true;
    Vec<SyntaxNode*> items = Vec<SyntaxNode*>.new();
    Vec<CfgVisibleName> extern_names = Vec<CfgVisibleName>.new();
    cfg_collect_items(tree.root, cfg, diagnostics, &items);
    i64 i = 0;
    while (i < items.len()) {
        SyntaxNode* item = items.get(i);
        if (!record_item(table, diagnostics, item)) {
            ok = false;
        }
        cfg_collect_extern_from_item(item, &extern_names);
        i += 1;
    }
    items.drop();
    i64 extern_index = 0;
    while (extern_index < extern_names.len()) {
        CfgVisibleName* visible = extern_names.get_ptr(extern_index);
        table.add_visible(visible.name, visible.span, (SyntaxNode*)0);
        extern_index += 1;
    }
    extern_names.drop();
    Vec<CfgImportBinding> bindings = Vec<CfgImportBinding>.new();
    cfg_collect_import_bindings(tree.root, cfg, &bindings);
    i64 binding_index = 0;
    while (binding_index < bindings.len()) {
        CfgImportBinding* binding = bindings.get_ptr(binding_index);
        table.add_visible(binding.alias, binding.span, (SyntaxNode*)0);
        binding_index += 1;
    }
    bindings.drop();
    return ok;
}
