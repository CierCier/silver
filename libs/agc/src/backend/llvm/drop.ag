// libs/agc/src/backend/llvm/drop.ag — RAII drop elaboration for the native backend.
//
// Runtime state bytes are authoritative. Legacy flag handles below alias the
// same node bytes, so moves and cleanup never maintain a second liveness truth.
import vendor.llvm.llvm;
import std.string;
import std.mem.vec;
import frontend.ast;
import frontend.ast_expr;
import frontend.items;
import frontend.place;
import frontend.init_plan;
import frontend.symbols;
import frontend.types;
import frontend.typecheck_expr;
import frontend.messages;
import backend.llvm.context;
import backend.llvm.types;
import backend.llvm.mono;
import backend.llvm.expr;
import backend.llvm.stmt;

// Shared runtime encoding with the stage0 owner-state lowering.
const u64 LLVM_INIT_UNINIT = 0;
const u64 LLVM_INIT_PARTIAL = 1;
const u64 LLVM_INIT_FULL = 2;

bool llvm_type_needs_drop(LlvmContext* ctx, u32 type_id) {
    if (type_id == TYPE_UNKNOWN || type_id == 0) { return false; }
    TypeProperties props = type_properties_at(ctx.types, type_id, 0);
    return props.needs_drop;
}


void llvm_store_drop_flag(LlvmContext* ctx, LLVMOpaqueValue* flag, bool value) {
    if (flag == (LLVMOpaqueValue*)0) { return; }
    LLVMOpaqueType* state_ty = LLVMInt8TypeInContext(ctx.ctx);
    LLVMBuildStore(ctx.builder, LLVMConstInt(state_ty,
        value ? LLVM_INIT_FULL : LLVM_INIT_UNINIT, 0), flag);
}

void llvm_store_init_node(LlvmContext* ctx, LlvmLocal* local, u32 node_index,
                          InitState state) {
    LLVMOpaqueValue* state_ptr = llvm_init_tree_state_ptr(ctx, local, node_index);
    if (state_ptr == (LLVMOpaqueValue*)0) { return; }
    u64 value = state == InitState.Init ? LLVM_INIT_FULL
        : (state == InitState.Partial ? LLVM_INIT_PARTIAL : LLVM_INIT_UNINIT);
    LLVMBuildStore(ctx.builder,
        LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx), value, 0), state_ptr);
}

void llvm_store_init_node_value(LlvmContext* ctx, LlvmLocal* local,
                                u32 node_index, LLVMOpaqueValue* value) {
    LLVMOpaqueValue* state_ptr = llvm_init_tree_state_ptr(ctx, local, node_index);
    if (state_ptr != (LLVMOpaqueValue*)0 && value != (LLVMOpaqueValue*)0) {
        LLVMBuildStore(ctx.builder, value, state_ptr);
    }
}

LLVMOpaqueValue* llvm_load_init_node(LlvmContext* ctx, LlvmLocal* local,
                                     u32 node_index) {
    LLVMOpaqueValue* state_ptr = llvm_init_tree_state_ptr(ctx, local, node_index);
    if (state_ptr == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
    return LLVMBuildLoad2(ctx.builder, LLVMInt8TypeInContext(ctx.ctx), state_ptr,
                          "init_node_state");
}

LLVMOpaqueValue* llvm_state_is_init(LlvmContext* ctx, LLVMOpaqueValue* state_ptr,
                                    str name) {
    LLVMOpaqueType* state_ty = LLVMInt8TypeInContext(ctx.ctx);
    LLVMOpaqueValue* state = LLVMBuildLoad2(ctx.builder, state_ty, state_ptr, name);
    return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, state,
        LLVMConstInt(state_ty, LLVM_INIT_FULL, 0), "init_state_is_init");
}

// Quiet probe: can a `drop` call be emitted for this type? Unlike
// llvm_drop_fn_for_type this never queues monomorphization and never
// records unresolved symbols, so scope-exit planning can ask freely.
bool llvm_can_resolve_drop_fn(LlvmContext* ctx, u32 type_id) {
    u32 resolved = ctx.types.resolve_subst(type_id);
    if (resolved == TYPE_UNKNOWN || resolved == 0) { return false; }
    TypeEntry* entry = ctx.types.get(resolved);
    if (entry.kind != TypeKind.Named) { return false; }
    str base = ctx.types.names.get(entry.name_id);
    if (entry.count > 0) {
        Vec<u32> arg_ids = Vec<u32>.new();
        i64 i = 0;
        while (i < entry.count) {
            u32 arg_id = ctx.types.type_args.get(entry.inner + (u32)i);
            if (!mono_type_is_concrete(ctx.ctx, ctx.types, arg_id, 0)) {
                arg_ids.drop();
                return false;
            }
            arg_ids.push(arg_id);
            i += 1;
        }
        MonoMethodTemplate template;
        Vec<u32> param_ids = Vec<u32>.new();
        bool ok = mono_find_method_template(ctx.root, ctx.types, base, "drop",
                                             0, &arg_ids, &template, &param_ids, -1, false,
                                             (AstPool*)0, 0, (SyntaxNode*)0);
        bool usable = ok && (param_ids.len() == arg_ids.len() || param_ids.len() == 0);
        param_ids.drop();
        arg_ids.drop();
        return usable;
    }
    String mangled = String.from_str(base);
    mangled.push_str("__drop");
    LLVMOpaqueValue* fn_val = LLVMGetNamedFunction(ctx.module, mangled.to_str());
    mangled.drop();
    return fn_val != (LLVMOpaqueValue*)0;
}

// Resolve the `drop` function for a type: generic instantiations go through
// monomorphization (trait `impl Drop` methods are found by base name like
// any other method); concrete types use the `Base__drop` symbol. Only call
// this after llvm_can_resolve_drop_fn said yes, so failure here is a loud
// internal error rather than a silent leak.
LLVMOpaqueValue* llvm_drop_fn_for_type(LlvmContext* ctx, u32 type_id) {
    u32 resolved = ctx.types.resolve_subst(type_id);
    if (resolved == TYPE_UNKNOWN || resolved == 0) { return (LLVMOpaqueValue*)0; }
    TypeEntry* entry = ctx.types.get(resolved);
    if (entry.kind != TypeKind.Named) { return (LLVMOpaqueValue*)0; }
    str base = ctx.types.names.get(entry.name_id);
    if (entry.count > 0) {
        return mono_ensure_specialized(ctx, resolved, "drop");
    }
    String mangled = String.from_str(base);
    mangled.push_str("__drop");
    LLVMOpaqueValue* fn_val = LLVMGetNamedFunction(ctx.module, mangled.to_str());
    mangled.drop();
    return fn_val;
}

// Should a local of this type be drop-tracked? Either its own `drop` is
// resolvable (covers user types like `Owned`, which the name-based
// needs_drop predicate cannot see) or some part of it needs dropping.
// Tracking a value that later proves unlowerable only leaks, as before.
bool llvm_type_needs_tracking_inner(LlvmContext* ctx, u32 type_id, Vec<u32>* active) {
    u32 resolved = ctx.types.resolve_subst(type_id);
    if (resolved == TYPE_UNKNOWN || resolved == 0) { return false; }
    TypeEntry* entry = ctx.types.get(resolved);
    TypeKind kind = entry.kind;
    u32 name_id = entry.name_id;
    if (kind == TypeKind.Pointer || kind == TypeKind.Reference) { return false; }
    if (llvm_can_resolve_drop_fn(ctx, resolved)) { return true; }
    if (kind == TypeKind.Array) {
        return llvm_type_needs_tracking_inner(ctx, entry.inner, active);
    }
    if (kind == TypeKind.Tuple) {
        i64 i = 0;
        while (i < entry.count) {
            if (llvm_type_needs_tracking_inner(ctx,
                    ctx.types.type_args.get(entry.inner + (u32)i), active)) {
                return true;
            }
            i += 1;
        }
        return false;
    }
    if (kind == TypeKind.Named && active.len() > 0) {
        str nested_name = ctx.types.names.get(name_id);
        if (find_enum_item(ctx.root, nested_name) != (SyntaxNode*)0) { return false; }
    }
    if (llvm_type_needs_drop(ctx, resolved)) { return true; }
    if (kind != TypeKind.Named) { return false; }

    str type_name = ctx.types.names.get(name_id);
    if (find_enum_item(ctx.root, type_name) != (SyntaxNode*)0) { return false; }
    i64 ai = 0;
    while (ai < active.len()) {
        if (active.get(ai) == resolved) { return false; }
        ai += 1;
    }
    LlvmStructDef* def = ctx.find_struct_by_str(type_name);
    if (def == (LlvmStructDef*)0) { return false; }
    active.push(resolved);
    i64 i = 0;
    while (i < def.fields.len()) {
        LlvmFieldInfo* field = def.fields.get_ptr(i);
        u32 field_ty = mono_resolve_struct_field_type(ctx, resolved, field.type_id);
        if (field_ty != TYPE_UNKNOWN && field_ty != 0
            && llvm_type_needs_tracking_inner(ctx, field_ty, active)) {
            active.pop();
            return true;
        }
        i += 1;
    }
    active.pop();
    return false;
}

bool llvm_type_needs_tracking(LlvmContext* ctx, u32 type_id) {
    Vec<u32> active = Vec<u32>.new();
    bool needed = llvm_type_needs_tracking_inner(ctx, type_id, &active);
    active.drop();
    return needed;
}

void llvm_emit_guarded_drop_call(LlvmContext* ctx, LLVMOpaqueValue* flag,
                                 LLVMOpaqueValue* fn_val, LLVMOpaqueValue* ptr) {
    if (fn_val == (LLVMOpaqueValue*)0 || ptr == (LLVMOpaqueValue*)0) { return; }
    LLVMOpaqueBasicBlock* run_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_run");
    LLVMOpaqueBasicBlock* after_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_after");
    if (flag != (LLVMOpaqueValue*)0) {
        LLVMOpaqueValue* live = llvm_state_is_init(ctx, flag, "drop_state");
        LLVMBuildCondBr(ctx.builder, live, run_bb, after_bb);
    } else {
        LLVMBuildBr(ctx.builder, run_bb);
    }
    LLVMPositionBuilderAtEnd(ctx.builder, run_bb);
    LLVMOpaqueType* fn_ty = LLVMGlobalGetValueType(fn_val);
    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.new();
    args.push(ptr);
    LLVMBuildCall2(ctx.builder, fn_ty, fn_val, args.data, 1, "");
    args.drop();
    LLVMBuildBr(ctx.builder, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, after_bb);
}

// Compute the address and resolved type of a direct field of a local.

bool llvm_drop_path_matches(LlvmLocal* local, LlvmFieldFlag* entry,
                            Vec<Projection>* path) {
    if (path.len() == 0 || entry.projections_count == 0) { return false; }
    if (path.len() > (i64)entry.projections_count) { return false; }
    i64 i = 0;
    while (i < path.len()) {
        Projection* stored = local.drop_projections.get_ptr((i64)entry.projections_start + i);
        Projection* requested = path.get_ptr(i);
        if (stored.kind != requested.kind
            || ((stored.kind == ProjectionKind.Field || stored.kind == ProjectionKind.Index)
                && stored.field_name_id != requested.field_name_id)) { return false; }
        i += 1;
    }
    return true;
}

LLVMOpaqueValue* llvm_init_node_place(LlvmContext* ctx, LlvmLocal* local,
                                       u32 node_index) {
    if (node_index == 0) { return local.ptr; }
    InitNodePlan node = local.init_nodes.get(node_index);
    InitNodePlan parent = local.init_nodes.get(node.parent_index);
    LLVMOpaqueValue* base = llvm_init_node_place(ctx, local, node.parent_index);
    mono_ensure_child_layouts(ctx, parent.type_id, &ctx.generic_layout_ids);
    LLVMOpaqueType* aggregate = llvm_lower_type(ctx.ctx, ctx.types, parent.type_id);
    TypeEntry entry = *ctx.types.get(parent.type_id);
    if (entry.kind == TypeKind.Array) {
        LLVMOpaqueType* index_type = LLVMInt32TypeInContext(ctx.ctx);
        Vec<LLVMOpaqueValue*> indices = Vec<LLVMOpaqueValue*>.new();
        indices.push(LLVMConstInt(index_type, 0, 0));
        indices.push(LLVMConstInt(index_type, node.field_index, 0));
        LLVMOpaqueValue* result = LLVMBuildGEP2(ctx.builder, aggregate, base,
            indices.data, 2, "init_array_place");
        indices.drop();
        return result;
    }
    return LLVMBuildStructGEP2(ctx.builder, aggregate, base, node.field_index,
                               "init_field_place");
}
void llvm_emit_enum_payload_drop(LlvmContext* ctx, LLVMOpaqueValue* ptr, u32 type_id,
                                 str enum_name) {
    LLVMOpaqueType* enum_ty = llvm_lower_type(ctx.ctx, ctx.types, type_id);
    LLVMOpaqueValue* tag_ptr = LLVMBuildStructGEP2(ctx.builder, enum_ty, ptr, 0, "drop_tag");
    LLVMOpaqueValue* tag_val = LLVMBuildLoad2(ctx.builder, LLVMInt16TypeInContext(ctx.ctx),
                                               tag_ptr, "drop_tag_ld");
    Vec<SyntaxNode*> variant_names = Vec<SyntaxNode*>.new();
    Vec<i64> variant_tags = Vec<i64>.new();
    Vec<i64> variant_arities = Vec<i64>.new();
    SyntaxNode* enum_item = find_enum_item(ctx.root, enum_name);
    if (enum_item == (SyntaxNode*)0) {
        variant_names.drop();
        variant_tags.drop();
        variant_arities.drop();
        return;
    }
    enum_each_variant(enum_item, &variant_names, &variant_tags, &variant_arities);
    LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_enum_merge");
    i64 vi = 0;
    while (vi < variant_names.len()) {
        str variant = variant_names.get(vi).text;
        i64 tag = variant_tags.get(vi);
        Vec<u32> payload_types = Vec<u32>.new();
        mono_enum_payload_types(ctx, type_id, variant, &payload_types);
        i64 di = 0;
        while (di < payload_types.len()) {
            u32 payload_ty = payload_types.get(di);
            if (llvm_type_needs_tracking(ctx, payload_ty)) {
                LLVMOpaqueValue* expected = LLVMConstInt(LLVMInt16TypeInContext(ctx.ctx), (u64)tag, 0);
                LLVMOpaqueValue* same = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ,
                                                      tag_val, expected, "drop_tag_eq");
                LLVMOpaqueBasicBlock* arm_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_enum_arm");
                LLVMOpaqueBasicBlock* next_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_enum_next");
                LLVMBuildCondBr(ctx.builder, same, arm_bb, next_bb);
                LLVMPositionBuilderAtEnd(ctx.builder, arm_bb);
                u64 base_offset = llvm_target_struct_field_offset(ctx, enum_ty, 1);
                u64 field_offset = base_offset + llvm_target_payload_field_offset(ctx, &payload_types, di);
                LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
                LLVMOpaqueValue* slot_bytes = LLVMBuildBitCast(ctx.builder, ptr, ptr_ty, "drop_enum_bytes");
                LLVMOpaqueValue* field_index = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), field_offset, 0);
                LLVMOpaqueValue* field_byte_ptr = LLVMBuildGEP2(ctx.builder, LLVMInt8TypeInContext(ctx.ctx),
                                                                slot_bytes, &field_index, 1, "drop_enum_field");
                LLVMOpaqueValue* field_ptr = LLVMBuildBitCast(ctx.builder, field_byte_ptr, ptr_ty, "drop_enum_ptr");
                llvm_emit_value_drop_at_ptr(ctx, field_ptr, payload_ty);
                LLVMBuildBr(ctx.builder, next_bb);
                LLVMPositionBuilderAtEnd(ctx.builder, next_bb);
            }
            di += 1;
        }
        payload_types.drop();
        vi += 1;
    }
    variant_names.drop();
    variant_tags.drop();
    variant_arities.drop();
    LLVMBuildBr(ctx.builder, merge_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
}

void llvm_emit_value_drop_at_ptr(LlvmContext* ctx, LLVMOpaqueValue* ptr, u32 type_id) {
    u32 resolved = ctx.types.resolve_subst(type_id);
    if (resolved == TYPE_UNKNOWN || resolved == 0) { return; }
    TypeEntry* entry = ctx.types.get(resolved);
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) { return; }
    if (entry.kind == TypeKind.Array) {
        if (entry.count > 0 && llvm_type_needs_tracking(ctx, entry.inner)) {
            LLVMOpaqueValue* count = LLVMConstInt(
                LLVMInt64TypeInContext(ctx.ctx), (u64)entry.count, 0);
            llvm_emit_drop_in_place(ctx, entry.inner, ptr, count);
        }
        return;
    }
    if (entry.kind == TypeKind.Tuple) {
        LLVMOpaqueType* tuple_ty = llvm_lower_type(ctx.ctx, ctx.types, resolved);
        i64 i = 0;
        while (i < entry.count) {
            u32 element_ty = ctx.types.resolve_subst(ctx.types.type_args.get(entry.inner + (u32)i));
            if (element_ty != TYPE_UNKNOWN && element_ty != 0
                && llvm_type_needs_tracking(ctx, element_ty)) {
                LLVMOpaqueValue* element_ptr = LLVMBuildStructGEP2(ctx.builder, tuple_ty, ptr,
                                                                   (u32)i, "drop_tuple_field");
                llvm_emit_value_drop_at_ptr(ctx, element_ptr, element_ty);
            }
            i += 1;
        }
        return;
    }
    if (entry.kind != TypeKind.Named) { return; }

    str name = ctx.types.names.get(entry.name_id);
    SyntaxNode* enum_item = find_enum_item(ctx.root, name);
    bool own_drop = llvm_can_resolve_drop_fn(ctx, resolved);
    if (own_drop) {
        LLVMOpaqueValue* fn = llvm_drop_fn_for_type(ctx, resolved);
        if (fn != (LLVMOpaqueValue*)0) {
            Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.new();
            args.push(ptr);
            LLVMBuildCall2(ctx.builder, LLVMGlobalGetValueType(fn), fn, args.data, 1, "");
            args.drop();
        }
    }
    if (enum_item != (SyntaxNode*)0) {
        if (!own_drop && llvm_enum_needs_payload_drop(ctx, resolved, name)) {
            llvm_emit_enum_payload_drop(ctx, ptr, resolved, name);
        }
        return;
    }

    LlvmStructDef* def = ctx.find_struct_by_str(name);
    if (def == (LlvmStructDef*)0) { return; }
    mono_ensure_type_layout(ctx, resolved, &ctx.generic_layout_ids);
    LLVMOpaqueType* struct_ty = llvm_lower_type(ctx.ctx, ctx.types, resolved);
    i64 i = 0;
    while (i < def.fields.len()) {
        LlvmFieldInfo* field = def.fields.get_ptr(i);
        u32 field_ty = mono_resolve_struct_field_type(ctx, resolved, field.type_id);
        if (field_ty != TYPE_UNKNOWN && field_ty != 0
            && llvm_type_needs_tracking(ctx, field_ty)) {
            LLVMOpaqueValue* field_ptr = LLVMBuildStructGEP2(ctx.builder, struct_ty, ptr,
                                                              (u32)i, "drop_field");
            llvm_emit_value_drop_at_ptr(ctx, field_ptr, field_ty);
        }
        i += 1;
    }
}

LLVMOpaqueValue* llvm_emit_drop_in_place(LlvmContext* ctx, u32 elem_type,
                                          LLVMOpaqueValue* ptr, LLVMOpaqueValue* count) {
    if (!llvm_type_needs_tracking(ctx, elem_type)) {
        return LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 0, 0);
    }
    if (ctx.current_fn == (LLVMOpaqueValue*)0 || ptr == (LLVMOpaqueValue*)0
        || count == (LLVMOpaqueValue*)0 || LLVMGetTypeKind(LLVMTypeOf(ptr)) != (u32)12
        || LLVMGetTypeKind(LLVMTypeOf(count)) != (u32)8) {
        ctx.note_unresolved("drop-in-place", "arguments");
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueType* i64_ty = LLVMInt64TypeInContext(ctx.ctx);
    if (LLVMTypeOf(count) != i64_ty) {
        count = LLVMBuildIntCast(ctx.builder, count, i64_ty, "drop_count_cast");
    }
    LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
    LLVMOpaqueValue* non_null = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE,
                                               ptr, LLVMConstNull(ptr_ty), "drop_non_null");
    LLVMOpaqueValue* has_items = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSGT,
                                               count, LLVMConstInt(i64_ty, 0, 0), "drop_has_items");
    LLVMOpaqueValue* should_drop = LLVMBuildAnd(ctx.builder, non_null, has_items, "drop_enter");
    LLVMOpaqueBasicBlock* preheader = LLVMGetInsertBlock(ctx.builder);
    LLVMOpaqueBasicBlock* loop_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn,
                                                                   "drop_in_place_loop");
    LLVMOpaqueBasicBlock* done_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn,
                                                                   "drop_in_place_done");
    LLVMBuildCondBr(ctx.builder, should_drop, loop_bb, done_bb);

    LLVMPositionBuilderAtEnd(ctx.builder, loop_bb);
    LLVMOpaqueValue* index = LLVMBuildPhi(ctx.builder, i64_ty, "drop_index");
    LLVMOpaqueValue* zero = LLVMConstInt(i64_ty, 0, 0);
    LLVMOpaqueType* elem_ty = llvm_lower_type(ctx.ctx, ctx.types, elem_type);
    LLVMOpaqueValue* elem_ptr = LLVMBuildGEP2(ctx.builder, elem_ty, ptr, &index, 1,
                                              "drop_elem_ptr");
    llvm_emit_value_drop_at_ptr(ctx, elem_ptr, elem_type);
    LLVMOpaqueBasicBlock* latch = LLVMGetInsertBlock(ctx.builder);
    LLVMOpaqueValue* next = LLVMBuildAdd(ctx.builder, index, LLVMConstInt(i64_ty, 1, 0),
                                         "drop_index_next");
    LLVMOpaqueValue* more = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT,
                                           next, count, "drop_more");
    LLVMBuildCondBr(ctx.builder, more, loop_bb, done_bb);

    Vec<LLVMOpaqueValue*> incoming_values = Vec<LLVMOpaqueValue*>.new();
    incoming_values.push(zero);
    incoming_values.push(next);
    Vec<LLVMOpaqueBasicBlock*> incoming_blocks = Vec<LLVMOpaqueBasicBlock*>.new();
    incoming_blocks.push(preheader);
    incoming_blocks.push(latch);
    LLVMAddIncoming(index, incoming_values.data, incoming_blocks.data, (u32)2);
    incoming_blocks.drop();
    incoming_values.drop();
    LLVMPositionBuilderAtEnd(ctx.builder, done_bb);
    return LLVMConstInt(i64_ty, 0, 0);
}

// Does any enum payload contain a value that needs drop tracking?
bool llvm_enum_needs_payload_drop(LlvmContext* ctx, u32 type_id, str enum_name) {
    Vec<SyntaxNode*> variant_names = Vec<SyntaxNode*>.new();
    Vec<i64> variant_tags = Vec<i64>.new();
    Vec<i64> variant_arities = Vec<i64>.new();
    SyntaxNode* enum_item = find_enum_item(ctx.root, enum_name);
    if (enum_item == (SyntaxNode*)0) {
        variant_names.drop();
        variant_tags.drop();
        variant_arities.drop();
        return false;
    }
    enum_each_variant(enum_item, &variant_names, &variant_tags, &variant_arities);
    bool needed = false;
    i64 vi = 0;
    while (vi < variant_names.len() && !needed) {
        Vec<u32> payload_types = Vec<u32>.new();
        mono_enum_payload_types(ctx, type_id, variant_names.get(vi).text, &payload_types);
        i64 pi = 0;
        while (pi < payload_types.len() && !needed) {
            u32 payload_ty = payload_types.get(pi);
            if (payload_ty != TYPE_UNKNOWN && payload_ty != 0
                && llvm_type_needs_tracking(ctx, payload_ty)) {
                needed = true;
            }
            pi += 1;
        }
        payload_types.drop();
        vi += 1;
    }
    variant_names.drop();
    variant_tags.drop();
    variant_arities.drop();
    return needed;
}



LLVMOpaqueValue* llvm_init_tree_node_at(LlvmContext* ctx, LlvmLocal* local,
                                        LLVMOpaqueValue* index) {
    LLVMOpaqueType* array_type = LLVMArrayType(local.init_node_type,
                                               (u32)local.init_nodes.len());
    LLVMOpaqueType* i32_type = LLVMInt32TypeInContext(ctx.ctx);
    Vec<LLVMOpaqueValue*> indices = Vec<LLVMOpaqueValue*>.new();
    indices.push(LLVMConstInt(i32_type, 0, 0));
    indices.push(index);
    LLVMOpaqueValue* node = LLVMBuildGEP2(ctx.builder, array_type,
        local.init_tree_storage, indices.data, 2, "init_tree_node");
    indices.drop();
    return node;
}

LLVMOpaqueValue* llvm_init_tree_node_ptr(LlvmContext* ctx, LlvmLocal* local,
                                         u32 node_index) {
    if (local.init_tree_storage == (LLVMOpaqueValue*)0
        || local.init_node_type == (LLVMOpaqueType*)0
        || node_index >= (u32)local.init_nodes.len()) { return (LLVMOpaqueValue*)0; }
    return llvm_init_tree_node_at(ctx, local,
        LLVMConstInt(LLVMInt32TypeInContext(ctx.ctx), node_index, 0));
}

LLVMOpaqueValue* llvm_init_tree_state_ptr(LlvmContext* ctx, LlvmLocal* local,
                                          u32 node_index) {
    LLVMOpaqueValue* node = llvm_init_tree_node_ptr(ctx, local, node_index);
    if (node == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
    return LLVMBuildStructGEP2(ctx.builder, local.init_node_type, node, 3,
                               "init_tree_state");
}

// A concrete type has one immutable parent/child layout per LLVM module.
LLVMOpaqueValue* llvm_init_tree_layout(LlvmContext* ctx, LlvmLocal* local,
                                       LLVMOpaqueType* record_type) {
    String name = String.from_str("__silver_init_layout.");
    append_u32(&name, local.init_nodes.get_ptr(0).type_id);
    LLVMOpaqueValue* layout = LLVMGetNamedGlobal(ctx.module, name.to_str());
    if (layout != (LLVMOpaqueValue*)0) { return layout; }
    LLVMOpaqueType* i32_type = LLVMInt32TypeInContext(ctx.ctx);
    Vec<LLVMOpaqueValue*> records = Vec<LLVMOpaqueValue*>.new();
    Vec<LLVMOpaqueValue*> values = Vec<LLVMOpaqueValue*>.new();
    i64 i = 0;
    while (i < local.init_nodes.len()) {
        InitNodePlan node = local.init_nodes.get(i);
        values.len = 0;
        values.push(LLVMConstInt(i32_type, node.parent_index, 0));
        values.push(LLVMConstInt(i32_type, node.first_child_index, 0));
        values.push(LLVMConstInt(i32_type, node.child_count, 0));
        records.push(LLVMConstStructInContext(ctx.ctx, values.data, 3, 0));
        i += 1;
    }
    LLVMOpaqueValue* initializer = LLVMConstArray2(record_type, records.data,
                                                    (u64)records.len());
    layout = LLVMAddGlobal(ctx.module, LLVMTypeOf(initializer), name.to_str());
    LLVMSetInitializer(layout, initializer);
    LLVMSetGlobalConstant(layout, 1);
    LLVMSetLinkage(layout, LLVMLinkage.LLVMPrivateLinkage);
    return layout;
}

// Bulk transitions stay loops so large inline arrays do not produce thousands
// of stores in one basic block for LLVM's store combiner to compare.
void llvm_store_init_tree(LlvmContext* ctx, LlvmLocal* local, LLVMOpaqueValue* state) {
    if (local.init_nodes.len() == 0) { return; }
    if (local.init_nodes.len() == 1) {
        LLVMBuildStore(ctx.builder, state, local.drop_flag);
        return;
    }
    LLVMOpaqueType* i32_type = LLVMInt32TypeInContext(ctx.ctx);
    LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(ctx.builder);
    LLVMOpaqueBasicBlock* loop = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn,
                                                                "init_state_loop");
    LLVMOpaqueBasicBlock* after = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn,
                                                                 "init_state_ready");
    LLVMBuildBr(ctx.builder, loop);
    LLVMPositionBuilderAtEnd(ctx.builder, loop);
    LLVMOpaqueValue* index = LLVMBuildPhi(ctx.builder, i32_type, "init_state_index");
    LLVMOpaqueValue* node = llvm_init_tree_node_at(ctx, local, index);
    LLVMOpaqueValue* flag = LLVMBuildStructGEP2(ctx.builder, local.init_node_type,
                                                 node, 3, "init_state_ptr");
    LLVMBuildStore(ctx.builder, state, flag);
    LLVMOpaqueValue* next = LLVMBuildAdd(ctx.builder, index,
        LLVMConstInt(i32_type, 1, 0), "init_state_next");
    LLVMOpaqueValue* more = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntULT, next,
        LLVMConstInt(i32_type, (u64)local.init_nodes.len(), 0), "init_state_more");
    LLVMBuildCondBr(ctx.builder, more, loop, after);
    Vec<LLVMOpaqueValue*> incoming = Vec<LLVMOpaqueValue*>.new();
    incoming.push(LLVMConstInt(i32_type, 0, 0));
    incoming.push(next);
    Vec<LLVMOpaqueBasicBlock*> blocks = Vec<LLVMOpaqueBasicBlock*>.new();
    blocks.push(before);
    blocks.push(loop);
    LLVMAddIncoming(index, incoming.data, blocks.data, 2);
    LLVMPositionBuilderAtEnd(ctx.builder, after);
}

void llvm_init_tree_build(LlvmContext* ctx, LlvmLocal* local, InitOwnerPlan* plan,
                          bool initialized) {
    i64 i = 0;
    while (i < plan.nodes.len()) { local.init_nodes.push(plan.nodes.get(i)); i += 1; }
    i = 0;
    while (i < plan.projections.len()) {
        Projection projection = plan.projections.get(i);
        local.init_projections.push(projection);
        local.drop_projections.push(projection);
        i += 1;
    }

    LLVMOpaqueType* ptr_type = LLVMPointerTypeInContext(ctx.ctx, 0);
    LLVMOpaqueType* i32_type = LLVMInt32TypeInContext(ctx.ctx);
    LLVMOpaqueType* i8_type = LLVMInt8TypeInContext(ctx.ctx);
    Vec<LLVMOpaqueType*> fields = Vec<LLVMOpaqueType*>.new();
    fields.push(ptr_type);
    fields.push(ptr_type);
    fields.push(i32_type);
    fields.push(i8_type);
    local.init_node_type = LLVMStructTypeInContext(ctx.ctx, fields.data,
        (u32)fields.len(), 0);
    fields.len = 0;
    fields.push(i32_type);
    fields.push(i32_type);
    fields.push(i32_type);
    LLVMOpaqueType* record_type = LLVMStructTypeInContext(ctx.ctx, fields.data, 3, 0);
    fields.drop();

    LLVMOpaqueType* tree_type = LLVMArrayType(local.init_node_type,
                                               (u32)local.init_nodes.len());
    local.init_tree_storage = llvm_entry_alloca(ctx, tree_type, "init_tree");
    LLVMOpaqueValue* layout = llvm_init_tree_layout(ctx, local, record_type);
    LLVMOpaqueType* layout_type = LLVMGlobalGetValueType(layout);
    LLVMOpaqueBasicBlock* before = LLVMGetInsertBlock(ctx.builder);
    LLVMOpaqueBasicBlock* loop = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn,
                                                                "init_tree_loop");
    LLVMOpaqueBasicBlock* after = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn,
                                                                 "init_tree_ready");
    LLVMBuildBr(ctx.builder, loop);
    LLVMPositionBuilderAtEnd(ctx.builder, loop);
    LLVMOpaqueValue* index = LLVMBuildPhi(ctx.builder, i32_type, "init_tree_index");
    Vec<LLVMOpaqueValue*> indices = Vec<LLVMOpaqueValue*>.new();
    indices.push(LLVMConstInt(i32_type, 0, 0));
    indices.push(index);
    LLVMOpaqueValue* record_ptr = LLVMBuildGEP2(ctx.builder, layout_type, layout,
        indices.data, 2, "init_layout_ptr");
    LLVMOpaqueValue* record = LLVMBuildLoad2(ctx.builder, record_type, record_ptr,
                                              "init_layout_record");
    LLVMOpaqueValue* parent_index = LLVMBuildExtractValue(ctx.builder, record, 0,
                                                            "init_parent_index");
    LLVMOpaqueValue* first_child = LLVMBuildExtractValue(ctx.builder, record, 1,
                                                           "init_first_child");
    LLVMOpaqueValue* child_count = LLVMBuildExtractValue(ctx.builder, record, 2,
                                                           "init_child_count");
    LLVMOpaqueValue* root = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ,
        index, LLVMConstInt(i32_type, 0, 0), "init_is_root");
    LLVMOpaqueValue* leaf = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ,
        child_count, LLVMConstInt(i32_type, 0, 0), "init_is_leaf");
    LLVMOpaqueValue* parent_ptr = LLVMBuildSelect(ctx.builder, root,
        LLVMConstNull(ptr_type), llvm_init_tree_node_at(ctx, local, parent_index),
        "init_parent_ptr");
    LLVMOpaqueValue* child_ptr = LLVMBuildSelect(ctx.builder, leaf,
        LLVMConstNull(ptr_type), llvm_init_tree_node_at(ctx, local, first_child),
        "init_child_ptr");
    LLVMOpaqueValue* node = llvm_init_tree_node_at(ctx, local, index);
    LLVMBuildStore(ctx.builder, parent_ptr,
        LLVMBuildStructGEP2(ctx.builder, local.init_node_type, node, 0, "init_parent"));
    LLVMBuildStore(ctx.builder, child_ptr,
        LLVMBuildStructGEP2(ctx.builder, local.init_node_type, node, 1, "init_children"));
    LLVMBuildStore(ctx.builder, child_count,
        LLVMBuildStructGEP2(ctx.builder, local.init_node_type, node, 2, "init_count"));
    LLVMBuildStore(ctx.builder,
        LLVMConstInt(i8_type, initialized ? LLVM_INIT_FULL : LLVM_INIT_UNINIT, 0),
        LLVMBuildStructGEP2(ctx.builder, local.init_node_type, node, 3, "init_state"));
    LLVMOpaqueValue* next = LLVMBuildAdd(ctx.builder, index,
        LLVMConstInt(i32_type, 1, 0), "init_tree_next");
    LLVMOpaqueValue* more = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntULT, next,
        LLVMConstInt(i32_type, (u64)local.init_nodes.len(), 0), "init_tree_more");
    LLVMBuildCondBr(ctx.builder, more, loop, after);
    Vec<LLVMOpaqueValue*> incoming = Vec<LLVMOpaqueValue*>.new();
    incoming.push(LLVMConstInt(i32_type, 0, 0));
    incoming.push(next);
    Vec<LLVMOpaqueBasicBlock*> blocks = Vec<LLVMOpaqueBasicBlock*>.new();
    blocks.push(before);
    blocks.push(loop);
    LLVMAddIncoming(index, incoming.data, blocks.data, 2);
    LLVMPositionBuilderAtEnd(ctx.builder, after);

    u32 node_index = 0;
    while (node_index < (u32)local.init_nodes.len()) {
        InitNodePlan* plan = local.init_nodes.get_ptr(node_index);
        LLVMOpaqueValue* state_field = llvm_init_tree_state_ptr(ctx, local, node_index);
        if (node_index > 0) {
            LlvmFieldFlag flag;
            flag.projections_start = plan.projections_start;
            flag.projections_count = plan.projections_count;
            flag.node_index = node_index;
            flag.flag = state_field;
            local.field_flags.push(move flag);
        } else {
            local.drop_flag = state_field;
        }
        node_index += 1;
    }
}

// Every inline child has a state node, including Copy and scalar fields. The
// tree is fixed-size for the local and its layout is computed by LLVM.
void llvm_register_local_drops(LlvmContext* ctx, u32 name_id, LLVMOpaqueValue* ptr,
                               u32 type_id, bool initialized, Span declaration) {
    u32 resolved = ctx.types.resolve_subst(type_id);
    if (resolved == TYPE_UNKNOWN || resolved == 0) { return; }
    // Copy-only locals have no cleanup. Required Copy children of an owned
    // parent are still included by that parent's complete initialization plan.
    if (typecheck_type_is_copy(ctx.root, ctx.types, resolved)
        && !llvm_can_resolve_drop_fn(ctx, resolved)) { return; }
    TypeEntry* resolved_entry = ctx.types.get(resolved);
    str type_name = ctx.types.type_name(resolved);
    bool named_here = strlen(type_name) > 0 && strcmp(type_name, "unknown") != 0;
    bool is_tuple = resolved_entry.kind == TypeKind.Tuple;
    bool is_enum = named_here && find_enum_item(ctx.root, type_name) != (SyntaxNode*)0;
    bool can_register_paths = is_tuple || resolved_entry.kind == TypeKind.Array
        || (resolved_entry.kind == TypeKind.Named && !is_enum);
    bool enum_payloads = is_enum
        && llvm_enum_needs_payload_drop(ctx, resolved, type_name);
    // Enum payload drops are decided by the payloads, which the
    // name-based needs_drop predicate cannot see; check them directly.
    if (!llvm_type_needs_tracking(ctx, resolved)
        && !enum_payloads && !can_register_paths) {
        return;
    }
    LlvmLocal* local = ctx.find_local(name_id);
    if (local == (LlvmLocal*)0 || local.ptr != ptr) { return; }
    i64 plan_index = init_plan_resolve(ctx.init_owner_plans, ctx.types, ctx.names,
        ctx.root, name_id, resolved, declaration, ctx.current_function_span);
    if (plan_index < 0) {
        ctx.ownership_diagnostics.error(declaration,
            init_plan_unrepresentable(ctx.types.type_name(resolved)));
        return;
    }
    llvm_init_tree_build(ctx, local, ctx.init_owner_plans.get_ptr(plan_index), initialized);
}



void llvm_set_local_drop_live(LlvmContext* ctx, u32 name_id, bool live) {
    LlvmLocal* local = ctx.find_local(name_id);
    if (local == (LlvmLocal*)0) { return; }
    llvm_store_init_tree(ctx, local, LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx),
        live ? LLVM_INIT_FULL : LLVM_INIT_UNINIT, 0));
}

i64 llvm_init_path_node(LlvmContext* ctx, LlvmLocal* local,
                        Vec<Projection>* path) {
    if (local == (LlvmLocal*)0 || local.init_nodes.len() == 0) { return -1; }
    InitPathResult result = init_plan_project(&local.init_nodes,
        &local.init_projections, path, ctx.types);
    if (result.kind == InitPathKind.Indirect) { return -1; }
    if (result.kind == InitPathKind.Invalid) {
        ctx.ownership_diagnostics.error(ctx.current_function_span, init_plan_unknown_place());
        return -1;
    }
    return (i64)result.node_index;
}

void llvm_set_path_drop_live(LlvmContext* ctx, LlvmLocal* local,
                             Vec<Projection>* path, bool live) {
    i64 target_index = llvm_init_path_node(ctx, local, path);
    if (target_index < 0) { return; }

    u32 node_index = 1;
    while (node_index < (u32)local.init_nodes.len()) {
        InitNodePlan* node = local.init_nodes.get_ptr(node_index);
        if (node.projections_count >= path.len()) {
            bool inside = true;
            u32 p = 0;
            while (p < (u32)path.len()) {
                Projection* stored = local.init_projections.get_ptr(
                    (i64)node.projections_start + p);
                Projection* requested = path.get_ptr(p);
                if (stored.kind != requested.kind
                    || stored.field_name_id != requested.field_name_id) {
                    inside = false;
                    break;
                }
                p += 1;
            }
            if (inside) {
                llvm_store_init_node(ctx, local, node_index,
                    live ? InitState.Init : InitState.Uninit);
            }
        }
        node_index += 1;
    }

    InitNodePlan* target = local.init_nodes.get_ptr(target_index);
    i64 parent_index = target.parent_index;
    while (parent_index >= 0 && parent_index < local.init_nodes.len()) {
        InitNodePlan* parent = local.init_nodes.get_ptr(parent_index);
        if (parent.child_count == 0) { break; }
        LLVMOpaqueType* bool_ty = LLVMInt1TypeInContext(ctx.ctx);
        LLVMOpaqueValue* all_init = LLVMConstInt(bool_ty, 1, 0);
        LLVMOpaqueValue* all_uninit = LLVMConstInt(bool_ty, 1, 0);
        u32 child_offset = 0;
        while (child_offset < parent.child_count) {
            u32 child_index = parent.first_child_index + child_offset;
            LLVMOpaqueValue* state = llvm_load_init_node(ctx, local, child_index);
            LLVMOpaqueType* state_ty = LLVMInt8TypeInContext(ctx.ctx);
            LLVMOpaqueValue* is_init = LLVMBuildICmp(ctx.builder,
                LLVMIntPredicate.LLVMIntEQ, state, LLVMConstInt(state_ty, LLVM_INIT_FULL, 0),
                "init_child_is_init");
            LLVMOpaqueValue* is_uninit = LLVMBuildICmp(ctx.builder,
                LLVMIntPredicate.LLVMIntEQ, state, LLVMConstInt(state_ty, 0, 0),
                "init_child_is_uninit");
            all_init = LLVMBuildAnd(ctx.builder, all_init, is_init, "init_all_children");
            all_uninit = LLVMBuildAnd(ctx.builder, all_uninit, is_uninit,
                                      "init_no_children_live");
            child_offset += 1;
        }
        LLVMOpaqueType* state_ty = LLVMInt8TypeInContext(ctx.ctx);
        LLVMOpaqueValue* partial_or_uninit = LLVMBuildSelect(ctx.builder, all_uninit,
            LLVMConstInt(state_ty, LLVM_INIT_UNINIT, 0), LLVMConstInt(state_ty, LLVM_INIT_PARTIAL, 0),
            "init_parent_partial_or_uninit");
        LLVMOpaqueValue* parent_state = LLVMBuildSelect(ctx.builder, all_init,
            LLVMConstInt(state_ty, LLVM_INIT_FULL, 0), partial_or_uninit, "init_parent_state");
        llvm_store_init_node_value(ctx, local, (u32)parent_index, parent_state);
        if (parent_index == 0) { break; }
        parent_index = parent.parent_index;
    }
}

void llvm_set_field_drop_live(LlvmContext* ctx, u32 name_id,
                              Vec<Projection>* path) {
    LlvmLocal* local = ctx.find_local(name_id);
    if (local == (LlvmLocal*)0) { return; }
    llvm_set_path_drop_live(ctx, local, path, true);
}

// Clear every drop flag of a local: the value was moved out and must not be
// dropped at scope exit. Clearing an unflagged local is a no-op.
void llvm_clear_local_drops(LlvmContext* ctx, u32 name_id) {
    llvm_set_local_drop_live(ctx, name_id, false);
}

// After a call completes, clear the drops of any argument that was
// transferred by value: the callee now owns it (its parameter flags drop
// it). Transfer is proven by the callee's LLVM parameter kind — opaque
// pointers borrow, everything else moves — mirroring the receiver
// normalization in method calls. Unknown or variadic-tail positions are
// left alone (status-quo leak, never a double drop).
void llvm_clear_transferred_arg(LlvmContext* ctx, LLVMOpaqueType* fn_type,
                               i64 param_index, u32 arg_expr_id) {
    if (fn_type == (LLVMOpaqueType*)0 || arg_expr_id == 0 || param_index < 0) { return; }
    u32 param_count = LLVMCountParamTypes(fn_type);
    if (param_index >= (i64)param_count) { return; }
    Vec<LLVMOpaqueType*> param_tys = Vec<LLVMOpaqueType*>.new();
    u32 pi = 0;
    while (pi < param_count) {
        param_tys.push((LLVMOpaqueType*)0);
        pi += 1;
    }
    LLVMGetParamTypes(fn_type, param_tys.data);
    LLVMOpaqueType* param_ty = param_tys.get(param_index);
    param_tys.drop();
    if (LLVMGetTypeKind(param_ty) == (u32)12) { return; }
    u32 arg_ty = llvm_expr_type(ctx, arg_expr_id);
    if (!llvm_type_needs_tracking(ctx, arg_ty)) { return; }
    llvm_clear_place_drops(ctx, arg_expr_id);
}

// Root Var name of a place expression, following field/index chains and
// explicit moves. Returns 0 when the operand has no local root.
u32 llvm_place_root_name(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return 0; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    while (expr.kind == ExprKind.Field || expr.kind == ExprKind.Index) {
        if (expr.inner0 == 0) { return 0; }
        expr = ctx.pool.get_expr(expr.inner0);
    }
    if (expr.kind == ExprKind.Var) { return expr.aux; }
    if (expr.kind == ExprKind.Move) { return llvm_place_root_name(ctx, expr.inner0); }
    return 0;
}

// Record that an arm binding was extracted from a scrutinee expression:
// moving the binding out releases the scrutinee side as well.
void llvm_push_scrutinee_move(LlvmContext* ctx, u32 binding_name, u32 scrutinee_expr) {
    ScrutineeMove entry;
    entry.binding_name = binding_name;
    entry.scrutinee_expr = scrutinee_expr;
    entry.local_index = ctx.locals.len() - 1;
    entry.scrutinee_local_index = -1;
    bool source_recorded = false;
    i64 move_index = ctx.scrutinee_moves.len() - 1;
    while (move_index >= 0) {
        ScrutineeMove* previous = ctx.scrutinee_moves.get_ptr(move_index);
        if (previous.scrutinee_expr == scrutinee_expr) {
            entry.scrutinee_local_index = previous.scrutinee_local_index;
            source_recorded = true;
            break;
        }
        move_index -= 1;
    }
    if (!source_recorded) {
        u32 root_name = llvm_place_root_name(ctx, scrutinee_expr);
        i64 source_index = entry.local_index - 1;
        while (root_name != 0 && source_index >= 0) {
            LlvmLocal* source = ctx.locals.get_ptr(source_index);
            if (source.name_id == root_name) {
                entry.scrutinee_local_index = source_index;
                break;
            }
            source_index -= 1;
        }
    }
    entry.moved = false;
    entry.clearing = false;
    ctx.scrutinee_moves.push(move entry);
}

void llvm_set_scrutinee_binding_live(LlvmContext* ctx, i64 local_index, bool live) {
    if (local_index < 0 || local_index >= ctx.locals.len()) { return; }
    LlvmLocal* local = ctx.locals.get_ptr(local_index);
    llvm_store_init_tree(ctx, local, LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx),
        live ? LLVM_INIT_FULL : LLVM_INIT_UNINIT, 0));
}

// Payload bindings own their copies only after the source has been consumed.
void llvm_init_scrutinee_binding_drops(LlvmContext* ctx) {
    i64 move_index = ctx.scrutinee_moves.len() - 1;
    if (move_index < 0) { return; }
    ScrutineeMove* entry = ctx.scrutinee_moves.get_ptr(move_index);
    i64 source_index = entry.scrutinee_local_index;
    if (source_index < 0 || source_index >= ctx.locals.len()) { return; }
    LlvmLocal* source = ctx.locals.get_ptr(source_index);
    if (source.drop_flag == (LLVMOpaqueValue*)0) { return; }
    LLVMOpaqueType* i1_ty = LLVMInt1TypeInContext(ctx.ctx);
    LLVMOpaqueValue* source_live = llvm_state_is_init(ctx, source.drop_flag,
        "match_source_live_state");
    LLVMOpaqueValue* binding_live = LLVMBuildXor(ctx.builder, source_live,
        LLVMConstInt(i1_ty, 1, 0), "match_binding_live");
    LLVMOpaqueType* state_ty = LLVMInt8TypeInContext(ctx.ctx);
    LLVMOpaqueValue* binding_state = LLVMBuildSelect(ctx.builder, binding_live,
        LLVMConstInt(state_ty, LLVM_INIT_FULL, 0), LLVMConstInt(state_ty, LLVM_INIT_UNINIT, 0),
        "match_binding_state");
    LlvmLocal* binding = ctx.locals.get_ptr(entry.local_index);
    llvm_store_init_tree(ctx, binding, binding_state);
}

// When a binding is moved from a still-owned source, the arm bindings become
// the owners of its remaining payloads. A consumed source stays consumed.
void llvm_promote_scrutinee_bindings(LlvmContext* ctx, i64 move_index) {
    if (move_index < 0 || move_index >= ctx.scrutinee_moves.len()) { return; }
    ScrutineeMove* entry = ctx.scrutinee_moves.get_ptr(move_index);
    i64 source_index = entry.scrutinee_local_index;
    if (source_index < 0 || source_index >= ctx.locals.len()) { return; }
    LlvmLocal* source = ctx.locals.get_ptr(source_index);
    if (source.drop_flag == (LLVMOpaqueValue*)0) { return; }
    LLVMOpaqueValue* source_live = llvm_state_is_init(ctx, source.drop_flag,
        "match_source_live_state");
    LLVMOpaqueBasicBlock* promote_bb = LLVMAppendBasicBlockInContext(ctx.ctx,
        ctx.current_fn, "match_promote_bindings");
    LLVMOpaqueBasicBlock* after_bb = LLVMAppendBasicBlockInContext(ctx.ctx,
        ctx.current_fn, "match_bindings_promoted");
    LLVMBuildCondBr(ctx.builder, source_live, promote_bb, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, promote_bb);
    i64 i = 0;
    while (i < ctx.scrutinee_moves.len()) {
        ScrutineeMove* sibling = ctx.scrutinee_moves.get_ptr(i);
        if (sibling.scrutinee_expr == entry.scrutinee_expr
            && sibling.scrutinee_local_index == source_index) {
            llvm_set_scrutinee_binding_live(ctx, sibling.local_index, true);
        }
        i += 1;
    }
    LLVMBuildBr(ctx.builder, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, after_bb);
}

void llvm_pop_scrutinee_moves(LlvmContext* ctx, i64 count) {
    while (count > 0 && ctx.scrutinee_moves.len() > 0) {
        ctx.scrutinee_moves.pop();
        count -= 1;
    }
}

// After moving a place out, release any match scrutinee it was bound from.
// Newest entries win so nested matches resolve to the innermost scrutinee.
// Stale entries only survive on paths where compilation already failed
// closed, so they can never affect an emitted binary.
void llvm_clear_scrutinee_source(LlvmContext* ctx, u32 moved_expr_id) {
    u32 root_name = llvm_place_root_name(ctx, moved_expr_id);
    if (root_name == 0) { return; }
    i64 i = ctx.scrutinee_moves.len() - 1;
    while (i >= 0) {
        ScrutineeMove* entry = ctx.scrutinee_moves.get_ptr(i);
        if (entry.binding_name == root_name) {
            // `moved` is sticky across paths, but every path needs its own
            // flag store; `clearing` only stops recursion when the binding
            // shadows its own scrutinee.
            if (entry.clearing) { return; }
            entry.moved = true;
            entry.clearing = true;
            llvm_promote_scrutinee_bindings(ctx, i);
            llvm_clear_place_drops_at_local(ctx, entry.scrutinee_expr,
                                            entry.scrutinee_local_index);
            ctx.scrutinee_moves.get_ptr(i).clearing = false;
            return;
        }
        i -= 1;
    }
}

// A moved payload clears the whole enum's drop flag, which would also leak
// the payloads the arm did not move. At the end of the arm, release those
// bindings when the move actually cleared the scrutinee local's flag.
void llvm_drop_unmoved_payloads_at(LlvmContext* ctx, u32 scrutinee_expr,
                                   i64 base, i64 count) {
    if (count < 2 || scrutinee_expr == 0) { return; }
    if (base < 0 || base + count > ctx.scrutinee_moves.len()) { return; }
    i64 source_index = ctx.scrutinee_moves.get_ptr(base).scrutinee_local_index;
    bool temporary_scrutinee = source_index < 0
        && llvm_place_root_name(ctx, scrutinee_expr) == 0;
    if (!temporary_scrutinee && (source_index < 0 || source_index >= ctx.locals.len())) { return; }
    LlvmLocal* source = temporary_scrutinee
        ? (LlvmLocal*)0 : ctx.locals.get_ptr(source_index);
    if (!temporary_scrutinee
        && (source == (LlvmLocal*)0 || source.drop_flag == (LLVMOpaqueValue*)0)) { return; }
    LLVMOpaqueType* i1_ty = LLVMInt1TypeInContext(ctx.ctx);
    LLVMOpaqueValue* any_moved = LLVMConstInt(i1_ty, 0, 0);
    i64 i = 0;
    while (i < count) {
        ScrutineeMove* entry = ctx.scrutinee_moves.get_ptr(base + i);
        if (entry.local_index >= 0 && entry.local_index < ctx.locals.len()) {
            LlvmLocal* binding = ctx.locals.get_ptr(entry.local_index);
            if (binding.drop_flag != (LLVMOpaqueValue*)0) {
                LLVMOpaqueValue* live = llvm_state_is_init(ctx, binding.drop_flag,
                    "payload_live_state");
                LLVMOpaqueValue* moved = LLVMBuildXor(ctx.builder, live,
                    LLVMConstInt(i1_ty, 1, 0), "payload_moved");
                any_moved = LLVMBuildOr(ctx.builder, any_moved, moved,
                    "any_payload_moved");
            }
            i64 field_index = 0;
            while (field_index < binding.field_flags.len()) {
                LLVMOpaqueValue* live = llvm_state_is_init(ctx,
                    binding.field_flags.get_ptr(field_index).flag,
                    "payload_field_live_state");
                LLVMOpaqueValue* moved = LLVMBuildXor(ctx.builder, live,
                    LLVMConstInt(i1_ty, 1, 0), "payload_field_moved");
                any_moved = LLVMBuildOr(ctx.builder, any_moved, moved,
                    "any_payload_moved");
                field_index += 1;
            }
        }
        i += 1;
    }
    LLVMOpaqueBasicBlock* drop_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "payload_release");
    LLVMOpaqueBasicBlock* after_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "payload_after");
    LLVMBuildCondBr(ctx.builder, any_moved, drop_bb, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, drop_bb);
    i = 0;
    while (i < count) {
        ScrutineeMove* entry = ctx.scrutinee_moves.get_ptr(base + i);
        if (entry.local_index >= 0
            && entry.local_index < ctx.locals.len()) {
            LlvmLocal* binding = ctx.locals.get_ptr(entry.local_index);
            if (llvm_type_needs_tracking(ctx, binding.type_id)) {
                llvm_emit_init_node_cleanup(ctx, binding, 0);
            }
        }
        i += 1;
    }
    LLVMBuildBr(ctx.builder, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, after_bb);
}

void llvm_drop_unmoved_payloads(LlvmContext* ctx, u32 scrutinee_expr, i64 count) {
    llvm_drop_unmoved_payloads_at(ctx, scrutinee_expr,
                                  ctx.scrutinee_moves.len() - count, count);
}

// Return bypasses match-arm fallthrough, so release active match bindings
// before the normal scope cleanup drops the now-partially-moved scrutinee.
void llvm_drop_active_unmoved_payloads_above(LlvmContext* ctx, i64 local_mark) {
    i64 end = ctx.scrutinee_moves.len();
    while (end > 0) {
        i64 start = end - 1;
        u32 scrutinee_expr = ctx.scrutinee_moves.get_ptr(start).scrutinee_expr;
        while (start > 0
               && ctx.scrutinee_moves.get_ptr(start - 1).scrutinee_expr == scrutinee_expr) {
            start -= 1;
        }
        bool exits_scope = false;
        i64 i = start;
        while (i < end) {
            if (ctx.scrutinee_moves.get_ptr(i).local_index >= local_mark) {
                exits_scope = true;
                break;
            }
            i += 1;
        }
        if (exits_scope) {
            llvm_drop_unmoved_payloads_at(ctx, scrutinee_expr, start, end - start);
        }
        end = start;
    }
}

void llvm_drop_active_unmoved_payloads(LlvmContext* ctx) {
    llvm_drop_active_unmoved_payloads_above(ctx, 0);
}

// Direct Copy+Drop places can retain ownership in local bindings; aggregate
// construction still transfers their nested drop flags to the new value.
void llvm_clear_copy_source(LlvmContext* ctx, u32 src_id,
                            bool preserve_direct_copy_drop) {
    if (src_id == 0) { return; }
    u32 src_ty = llvm_expr_type(ctx, src_id);
    if (!llvm_type_needs_tracking(ctx, src_ty)) { return; }
    AstExpr* source = ctx.pool.get_expr(src_id);
    bool source_is_place = source.kind == ExprKind.Var || source.kind == ExprKind.Field
        || source.kind == ExprKind.Index;
    bool source_is_match_binding = false;
    if (source_is_place) {
        u32 root_name = llvm_place_root_name(ctx, src_id);
        i64 i = ctx.scrutinee_moves.len() - 1;
        while (i >= 0) {
            if (ctx.scrutinee_moves.get_ptr(i).binding_name == root_name) {
                source_is_match_binding = true;
                break;
            }
            i -= 1;
        }
    }
    if (preserve_direct_copy_drop && source_is_place
        && !source_is_match_binding
        && ctx.types.is_copy(ctx.types.resolve_subst(src_ty))
        && llvm_can_resolve_drop_fn(ctx, src_ty)) { return; }
    llvm_clear_place_drops(ctx, src_id);
}

// After building an aggregate value, release any droppable place operand
// it was copied from: the aggregate temp owns those bits now (when it is
// stored into a flagged local). Skips non-places and untracked types.
void llvm_clear_aggregate_sources(LlvmContext* ctx, u32 args_start, u32 args_count) {
    i64 i = 0;
    while (i < (i64)args_count) {
        llvm_clear_copy_source(ctx, ctx.pool.args.get((i64)args_start + i), false);
        i += 1;
    }
}

u32 llvm_collect_drop_field_path(LlvmContext* ctx, u32 expr_id,
                                 Vec<Projection>* path) {
    if (expr_id == 0) { return 0; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Var) { return expr.aux; }
    if (expr.kind == ExprKind.Move) {
        return llvm_collect_drop_field_path(ctx, expr.inner0, path);
    }
    if ((expr.kind != ExprKind.Field && expr.kind != ExprKind.Index) || expr.inner0 == 0) {
        return 0;
    }
    i64 old_len = path.len();
    u32 root_name = llvm_collect_drop_field_path(ctx, expr.inner0, path);
    if (root_name == 0) { return 0; }
    Projection projection;
    if (expr.kind == ExprKind.Field) {
        projection.kind = ProjectionKind.Field;
        projection.field_name_id = expr.aux;
    } else {
        u32 target_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr.inner0));
        TypeEntry* target = ctx.types.get(target_type);
        while (target.kind == TypeKind.Pointer || target.kind == TypeKind.Reference) {
            target_type = target.inner;
            target = ctx.types.get(target_type);
        }
        AstExpr* index_expr = ctx.pool.get_expr(expr.inner1);
        if ((target.kind != TypeKind.Tuple && target.kind != TypeKind.Array)
            || index_expr.kind != ExprKind.Literal) {
            while (path.len() > old_len) { path.pop(); }
            return 0;
        }
        i64 index = parse_int_literal(ctx.names.get(index_expr.inner0));
        if (index < 0 || index >= target.count) {
            while (path.len() > old_len) { path.pop(); }
            return 0;
        }
        projection.kind = ProjectionKind.Index;
        projection.field_name_id = (u32)index;
    }
    path.push(move projection);
    return root_name;
}

bool llvm_validate_drop_field_transfer(LlvmContext* ctx, LlvmLocal* local,
                                      Vec<Projection>* path, u32 expr_id) {
    u32 value_type = llvm_expr_type(ctx, expr_id);
    if (value_type == TYPE_UNKNOWN
        || typecheck_type_is_copy(ctx.root, ctx.types, value_type)) { return true; }
    i64 target = llvm_init_path_node(ctx, local, path);
    if (target < 0) { return true; }
    u32 ancestor = local.init_nodes.get_ptr(target).parent_index;
    while (true) {
        u32 ancestor_type = local.init_nodes.get_ptr(ancestor).type_id;
        if (typecheck_type_has_drop_impl(ctx.root, ctx.types, ancestor_type)) {
            String message = cannot_move_field_out_of_drop_type(
                ctx.names.get(local.name_id), ctx.types.type_name(ancestor_type));
            ctx.ownership_diagnostics.error(ctx.pool.get_expr(expr_id).span, move message);
            return false;
        }
        if (ancestor == 0) { break; }
        ancestor = local.init_nodes.get_ptr(ancestor).parent_index;
    }
    return true;
}

// Statically indexed inline places select exact state nodes. Heap elements
// retain their container's initialized-length contract.
void llvm_clear_place_drops_at_local(LlvmContext* ctx, u32 expr_id,
                                     i64 local_index) {
    if (expr_id == 0) { return; }
    // Any ownership transfer of a match payload binding (explicit move or
    // implicit by-value use) releases the scrutinee side exactly once.
    llvm_clear_scrutinee_source(ctx, expr_id);
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    while (expr.kind == ExprKind.Move && expr.inner0 != 0) {
        expr = ctx.pool.get_expr(expr.inner0);
    }
    Vec<Projection> path = Vec<Projection>.new();
    u32 root_name = llvm_collect_drop_field_path(ctx, expr_id, &path);
    if (root_name != 0 && path.len() > 0) {
        LlvmLocal* local = local_index >= 0 && local_index < ctx.locals.len()
            ? ctx.locals.get_ptr(local_index) : ctx.find_local(root_name);
        if (local != (LlvmLocal*)0) {
            if (!llvm_validate_drop_field_transfer(ctx, local, &path, expr_id)) {
                path.drop();
                return;
            }
            u32 root_ty = ctx.types.resolve_subst(local.type_id);
            if (root_ty != TYPE_UNKNOWN && root_ty != 0) {
                TypeEntry* root_entry = ctx.types.get(root_ty);
                if (root_entry.kind != TypeKind.Pointer
                    && root_entry.kind != TypeKind.Reference) {
                    llvm_set_path_drop_live(ctx, local, &path, false);
                }
            }
        }
        path.drop();
        return;
    }
    path.drop();
    while (expr.kind == ExprKind.Field || expr.kind == ExprKind.Index) {
        if (expr.inner0 == 0) { return; }
        expr = ctx.pool.get_expr(expr.inner0);
    }
    if (expr.kind == ExprKind.Var) {
        LlvmLocal* local = local_index >= 0 && local_index < ctx.locals.len()
            ? ctx.locals.get_ptr(local_index) : ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0) {
            llvm_store_init_tree(ctx, local,
                LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx), LLVM_INIT_UNINIT, 0));
        }
    } else if (expr.kind == ExprKind.Move) {
        llvm_clear_place_drops_at_local(ctx, expr.inner0, local_index);
    }
}

// Captured places borrow storage, but ownership still belongs to the source.
u32 llvm_assignment_source(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return 0; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Var) {
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0 && local.assignment_source != 0) {
            return local.assignment_source;
        }
    }
    return expr_id;
}

void llvm_clear_place_drops(LlvmContext* ctx, u32 expr_id) {
    expr_id = llvm_assignment_source(ctx, expr_id);
    if (expr_id == 0) { return; }
    AstExpr value = *ctx.pool.get_expr(expr_id);
    if (value.kind == ExprKind.ArrayLit || value.kind == ExprKind.StructLit) {
        i64 count = value.aux;
        i64 i = 0;
        while (i < count) {
            i64 offset = value.kind == ExprKind.ArrayLit ? 1 + i : i * 2 + 1;
            u32 member = ctx.pool.args.get((i64)value.inner1 + offset);
            if (llvm_type_needs_tracking(ctx, llvm_expr_type(ctx, member))) {
                llvm_clear_place_drops(ctx, member);
            }
            i += 1;
        }
        return;
    }
    llvm_clear_place_drops_at_local(ctx, expr_id, -1);
}

// A custom enum destructor manages its payload; otherwise the tag selects
// implicit payload cleanup. The whole flag skips moved-out values.
void llvm_emit_local_whole_drop(LlvmContext* ctx, LlvmLocal* local) {
    if (local.drop_flag == (LLVMOpaqueValue*)0) { return; }
    u32 local_ty = ctx.types.resolve_subst(local.type_id);
    LLVMOpaqueValue* own_fn = (LLVMOpaqueValue*)0;
    if (llvm_can_resolve_drop_fn(ctx, local.type_id)) {
        own_fn = llvm_drop_fn_for_type(ctx, local.type_id);
    }
    bool is_enum = false;
    str enum_name = "";
    if (local_ty != TYPE_UNKNOWN && local_ty != 0) {
        TypeEntry* local_entry = ctx.types.get(local_ty);
        if (local_entry.kind == TypeKind.Named) {
            enum_name = ctx.types.names.get(local_entry.name_id);
            is_enum = find_enum_item(ctx.root, enum_name) != (SyntaxNode*)0;
        }
    }
    bool payloads = is_enum && own_fn == (LLVMOpaqueValue*)0
        && llvm_enum_needs_payload_drop(ctx, local_ty, enum_name);
    if (own_fn == (LLVMOpaqueValue*)0 && !payloads) { return; }
    if (own_fn != (LLVMOpaqueValue*)0) {
        llvm_emit_guarded_drop_call(ctx, local.drop_flag, own_fn, local.ptr);
    }
    if (payloads) {
        llvm_emit_guarded_enum_payload_drop(ctx, local.drop_flag, local.ptr,
                                            local_ty, enum_name);
    }
}

// Emit one field-path entry's destructor or recursively owned enum payload.
void llvm_emit_local_field_drop(LlvmContext* ctx, LlvmLocal* local, LlvmFieldFlag* entry) {
    LLVMOpaqueValue* field_ptr = llvm_init_node_place(ctx, local, entry.node_index);
    u32 field_ty = local.init_nodes.get_ptr(entry.node_index).type_id;
    if (llvm_can_resolve_drop_fn(ctx, field_ty)) {
        LLVMOpaqueValue* field_fn = llvm_drop_fn_for_type(ctx, field_ty);
        if (field_fn != (LLVMOpaqueValue*)0) {
            llvm_emit_guarded_drop_call(ctx, entry.flag, field_fn, field_ptr);
        }
        return;
    }
    u32 resolved_field_ty = ctx.types.resolve_subst(field_ty);
    TypeEntry* field_entry = ctx.types.get(resolved_field_ty);
    if (field_entry.kind == TypeKind.Named) {
        str enum_name = ctx.types.names.get(field_entry.name_id);
        if (find_enum_item(ctx.root, enum_name) != (SyntaxNode*)0
            && llvm_enum_needs_payload_drop(ctx, resolved_field_ty, enum_name)) {
            llvm_emit_guarded_enum_payload_drop(ctx, entry.flag, field_ptr,
                                                resolved_field_ty, enum_name);
        }
    }
}

// BFS storage is traversed in declaration-order DFS for destructor cascade.
// A Partial parent skips its own Drop; each child's authoritative state decides
// its cleanup. Uninit skips the entire subtree.
void llvm_emit_init_node_cleanup(LlvmContext* ctx, LlvmLocal* local, u32 node_index) {
    if (local.init_nodes.len() == 0) { return; }
    InitNodePlan node = local.init_nodes.get(node_index);
    // Copy subtrees have no cleanup. Their state still participates in parent
    // initialization and is reset by assignment or declaration, not by Drop.
    if (typecheck_type_is_copy(ctx.root, ctx.types, node.type_id)
        && !llvm_can_resolve_drop_fn(ctx, node.type_id)) { return; }
    TypeEntry entry = *ctx.types.get(node.type_id);
    if (node.child_count == 0 && entry.kind != TypeKind.Named) {
        llvm_store_init_node(ctx, local, node_index, InitState.Uninit);
        return;
    }
    LLVMOpaqueValue* state = llvm_load_init_node(ctx, local, node_index);
    LLVMOpaqueType* state_ty = LLVMInt8TypeInContext(ctx.ctx);
    LLVMOpaqueValue* live = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE,
        state, LLVMConstInt(state_ty, 0, 0), "init_node_has_value");
    LLVMOpaqueBasicBlock* run = LLVMAppendBasicBlockInContext(ctx.ctx,
        ctx.current_fn, "init_cleanup");
    LLVMOpaqueBasicBlock* after = LLVMAppendBasicBlockInContext(ctx.ctx,
        ctx.current_fn, "init_cleanup_after");
    LLVMBuildCondBr(ctx.builder, live, run, after);
    LLVMPositionBuilderAtEnd(ctx.builder, run);
    if (node_index == 0) {
        llvm_emit_local_whole_drop(ctx, local);
    } else {
        llvm_emit_local_field_drop(ctx, local, local.field_flags.get_ptr(node_index - 1));
    }
    u32 child = 0;
    while (child < node.child_count) {
        llvm_emit_init_node_cleanup(ctx, local, node.first_child_index + child);
        child += 1;
    }
    llvm_store_init_node(ctx, local, node_index, InitState.Uninit);
    LLVMBuildBr(ctx.builder, after);
    LLVMPositionBuilderAtEnd(ctx.builder, after);
}

// Capture the current locals depth as a drop mark, right after pushing a
// scope: llvm_emit_drops_above with this mark later drops exactly the
// locals declared inside the scope.
i64 llvm_current_drop_mark(LlvmContext* ctx) {
    return (i64)ctx.locals.len();
}

// Emit scope-exit drops for locals at stack positions [mark, len), newest
// first. A struct's own destructor runs before its live fields, which drop
// in declaration order.
void llvm_emit_drops_above(LlvmContext* ctx, i64 mark) {
    if (ctx.current_fn == (LLVMOpaqueValue*)0) { return; }
    i64 i = (i64)ctx.locals.len() - 1;
    while (i >= mark) {
        LlvmLocal* local = ctx.locals.get_ptr(i);
        llvm_emit_init_node_cleanup(ctx, local, 0);
        i -= 1;
    }
}

// Overwrite predrop releases the target subtree in parent-first preorder.
void llvm_emit_assign_predrop(LlvmContext* ctx, u32 target_id, u32 rhs_id) {
    target_id = llvm_assignment_source(ctx, target_id);
    if (target_id == 0 || rhs_id == 0 || ctx.current_fn == (LLVMOpaqueValue*)0) { return; }
    AstExpr* target = ctx.pool.get_expr(target_id);
    AstExpr* rhs = ctx.pool.get_expr(rhs_id);
    if (target.kind == ExprKind.Var && rhs.kind == ExprKind.Var && target.aux == rhs.aux) {
        return;
    }
    if (target.kind == ExprKind.Var) {
        LlvmLocal* local = ctx.find_local(target.aux);
        if (local == (LlvmLocal*)0) { return; }
        llvm_emit_init_node_cleanup(ctx, local, 0);
        return;
    }
    Vec<Projection> path = Vec<Projection>.new();
    u32 root_name = llvm_collect_drop_field_path(ctx, target_id, &path);
    if (root_name != 0 && path.len() > 0) {
        LlvmLocal* local = ctx.find_local(root_name);
        if (local != (LlvmLocal*)0) {
            i64 fi = 0;
            while (fi < local.field_flags.len()) {
                LlvmFieldFlag* entry = local.field_flags.get_ptr(fi);
                if ((i64)entry.projections_count == path.len()
                    && llvm_drop_path_matches(local, entry, &path)) {
                    llvm_emit_init_node_cleanup(ctx, local, entry.node_index);
                    break;
                }
                fi += 1;
            }
        }
    }
    path.drop();
}

// Initialize the assigned subtree, then summarize every required sibling.
void llvm_mark_assign_live(LlvmContext* ctx, u32 target_id) {
    if (target_id == 0) { return; }
    AstExpr* target = ctx.pool.get_expr(target_id);
    if (target.kind == ExprKind.Var) {
        llvm_set_local_drop_live(ctx, target.aux, true);
        return;
    }
    Vec<Projection> path = Vec<Projection>.new();
    u32 root_name = llvm_collect_drop_field_path(ctx, target_id, &path);
    if (root_name != 0 && path.len() > 0) {
        llvm_set_field_drop_live(ctx, root_name, &path);
    }
    path.drop();
}

// Tag-dispatched payload drops guarded by an existing whole-local flag.
void llvm_emit_guarded_enum_payload_drop(LlvmContext* ctx, LLVMOpaqueValue* flag,
                                         LLVMOpaqueValue* ptr, u32 type_id, str enum_name) {
    LLVMOpaqueBasicBlock* run_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_enum_run");
    LLVMOpaqueBasicBlock* after_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "drop_enum_after");
    LLVMOpaqueValue* live = llvm_state_is_init(ctx, flag, "drop_enum_state");
    LLVMBuildCondBr(ctx.builder, live, run_bb, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, run_bb);
    llvm_emit_enum_payload_drop(ctx, ptr, type_id, enum_name);
    LLVMBuildBr(ctx.builder, after_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, after_bb);
}
