import std.string;
// libs/agc/src/backend/llvm/types.ag — Lowering canonical Silver TypeId to LLVM types.
import vendor.llvm.llvm;
import frontend.ast;
import frontend.items;
import frontend.lexer;
import frontend.symbols;
import frontend.types;
import backend.llvm.context;

u64 llvm_struct_field_type(SyntaxNode* root, str struct_name, i64 field_index, TypeTable* types) {
    SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, struct_name);
    if (item == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    SyntaxNode* block = item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return TYPE_UNKNOWN;
    }
    i64 index = 0;
    SyntaxNode* cursor = block.first_child;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
            cursor = cursor.next_sibling;
            continue;
        }
        SyntaxNode* start = cursor;
        SyntaxNode* last_ident = (SyntaxNode*)0;
        while (cursor != (SyntaxNode*)0
            && !(cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon)) {
            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier) {
                last_ident = cursor;
            }
            cursor = cursor.next_sibling;
        }
        if (last_ident != (SyntaxNode*)0) {
            if (index == field_index) {
                String text = String.new();
                SyntaxNode* part = start;
                while (part != (SyntaxNode*)0 && part != last_ident) {
                    append_node_tokens(part, &text);
                    part = part.next_sibling;
                }
                u32 field_type = type_id_from_text(types, text.to_str());
                text.drop();
                return field_type;
            }
            index += 1;
        }
        if (cursor != (SyntaxNode*)0) {
            cursor = cursor.next_sibling;
        }
    }
    return TYPE_UNKNOWN;
}

i64 llvm_struct_field_count(SyntaxNode* root, str struct_name) {
    SyntaxNode* item = find_item_by_name(root, NodeKind.Struct, struct_name);
    if (item == (SyntaxNode*)0) {
        return -1;
    }
    SyntaxNode* block = item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return 0;
    }
    i64 count = 0;
    SyntaxNode* cursor = block.first_child;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
            cursor = cursor.next_sibling;
            continue;
        }
        SyntaxNode* last_ident = (SyntaxNode*)0;
        while (cursor != (SyntaxNode*)0
            && !(cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon)) {
            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier) {
                last_ident = cursor;
            }
            cursor = cursor.next_sibling;
        }
        if (last_ident != (SyntaxNode*)0) {
            count += 1;
        }
        if (cursor != (SyntaxNode*)0) {
            cursor = cursor.next_sibling;
        }
    }
    return count;
}

void llvm_enum_payload_types(TypeTable* types, SyntaxNode* root, str enum_name,
                             str variant_name, Vec<u32>* out) {
    SyntaxNode* item = find_enum_item(root, enum_name);
    if (item == (SyntaxNode*)0) {
        return;
    }
    SyntaxNode* block = item.first_child;
    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
        block = block.next_sibling;
    }
    if (block == (SyntaxNode*)0) {
        return;
    }
    SyntaxNode* cursor = block.first_child;
    while (cursor != (SyntaxNode*)0) {
        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier
            && strcmp(cursor.text, variant_name) == 0) {
            SyntaxNode* payload = cursor.next_sibling;
            if (payload == (SyntaxNode*)0 || payload.kind != NodeKind.Parenthesized) {
                return;
            }
            SyntaxNode* part = payload.first_child;
            while (part != (SyntaxNode*)0) {
                SyntaxNode* part_end = part;
                while (part_end != (SyntaxNode*)0
                    && !(part_end.kind == NodeKind.Token && part_end.token_kind == TokenKind.Comma)) {
                    part_end = part_end.next_sibling;
                }
                String text = String.new();
                SyntaxNode* tok = part;
                while (tok != (SyntaxNode*)0 && tok != part_end) {
                    append_node_tokens(tok, &text);
                    tok = tok.next_sibling;
                }
                if (text.len > 0) {
                    out.push(type_id_from_text(types, text.to_str()));
                }
                text.drop();
                part = (part_end == (SyntaxNode*)0) ? part_end : part_end.next_sibling;
            }
            return;
        }
        cursor = cursor.next_sibling;
    }
}

bool llvm_layout_type_resolved(LlvmContext* ctx, u32 type_id, i64 depth) {
    if (depth > 32 || type_id == TYPE_UNKNOWN) {
        return false;
    }
    type_id = ctx.types.resolve_subst(type_id);
    TypeEntry* entry = ctx.types.get(type_id);
    if (entry.kind == TypeKind.Unknown || entry.kind == TypeKind.TypeParam || entry.kind == TypeKind.Void) {
        return false;
    }
    if (entry.kind == TypeKind.Array) {
        return llvm_layout_type_resolved(ctx, entry.inner, depth + 1);
    }
    if (entry.kind == TypeKind.Named) {
        str name = ctx.types.names.get(entry.name_id);
        if (find_item_by_name(ctx.root, NodeKind.Struct, name) == (SyntaxNode*)0
            && find_item_by_name(ctx.root, NodeKind.Enum, name) == (SyntaxNode*)0) {
            return false;
        }
        i64 i = 0;
        while (i < entry.count) {
            if (!llvm_layout_type_resolved(ctx, ctx.types.type_args.get(entry.inner + (u32)i), depth + 1)) {
                return false;
            }
            i += 1;
        }
    }
    return true;
}

u64 llvm_target_type_size(LlvmContext* ctx, u32 type_id) {
    if (ctx.target_data == (LLVMTargetDataRef*)0) {
        ctx.note_unresolved("target-layout", ctx.types.type_name(type_id));
        return 0;
    }
    type_id = ctx.types.resolve_subst(type_id);
    if (!llvm_layout_type_resolved(ctx, type_id, 0)) {
        ctx.note_unresolved("unresolved-layout", ctx.types.type_name(type_id));
        return 0;
    }
    LLVMOpaqueType* llvm_type = llvm_lower_type(ctx.ctx, ctx.types, type_id);
    if (LLVMTypeIsSized(llvm_type) == 0) {
        ctx.note_unresolved("unsized-layout", ctx.types.type_name(type_id));
        return 0;
    }
    return LLVMABISizeOfType(ctx.target_data, llvm_type);
}

u64 llvm_target_struct_field_offset(LlvmContext* ctx, LLVMOpaqueType* llvm_type, u32 index) {
    if (ctx.target_data == (LLVMTargetDataRef*)0 || LLVMTypeIsSized(llvm_type) == 0) {
        i8* type_text = LLVMPrintTypeToString(llvm_type);
        ctx.note_unresolved("unsized-layout", type_text);
        LLVMDisposeMessage(type_text);
        return 0;
    }
    return LLVMOffsetOfElement(ctx.target_data, llvm_type, index);
}

u64 llvm_target_payload_field_offset(LlvmContext* ctx, Vec<u32>* payloads, i64 field_index) {
    if (field_index < 0 || field_index >= payloads.len()) {
        ctx.note_unresolved("enum-payload-index", "out of range");
        return 0;
    }
    Vec<LLVMOpaqueType*> field_types = Vec<LLVMOpaqueType*>.new();
    i64 i = 0;
    while (i < payloads.len()) {
        u32 type_id = ctx.types.resolve_subst(payloads.get(i));
        if (!llvm_layout_type_resolved(ctx, type_id, 0)) {
            ctx.note_unresolved("enum-payload-type", "unknown or void");
            field_types.drop();
            return 0;
        }
        field_types.push(llvm_lower_type(ctx.ctx, ctx.types, type_id));
        i += 1;
    }
    LLVMOpaqueType* payload_type = LLVMStructTypeInContext(ctx.ctx, field_types.data, (u32)field_types.len(), 0);
    u64 offset = 0;
    if (LLVMTypeIsSized(payload_type) != 0 && ctx.target_data != (LLVMTargetDataRef*)0) {
        offset = LLVMOffsetOfElement(ctx.target_data, payload_type, (u32)field_index);
    } else {
        ctx.note_unresolved("unsized-enum-payload", "field offset");
    }
    field_types.drop();
    return offset;
}

u64 llvm_target_payload_size(LlvmContext* ctx, Vec<u32>* payloads) {
    Vec<LLVMOpaqueType*> field_types = Vec<LLVMOpaqueType*>.new();
    i64 i = 0;
    while (i < payloads.len()) {
        u32 type_id = ctx.types.resolve_subst(payloads.get(i));
        if (!llvm_layout_type_resolved(ctx, type_id, 0)) {
            ctx.note_unresolved("enum-payload-type", "unknown or void");
            field_types.drop();
            return 0;
        }
        field_types.push(llvm_lower_type(ctx.ctx, ctx.types, type_id));
        i += 1;
    }
    LLVMOpaqueType* payload_type = LLVMStructTypeInContext(ctx.ctx, field_types.data, (u32)field_types.len(), 0);
    u64 size = 0;
    if (LLVMTypeIsSized(payload_type) != 0 && ctx.target_data != (LLVMTargetDataRef*)0) {
        size = LLVMABISizeOfType(ctx.target_data, payload_type);
    } else {
        ctx.note_unresolved("unsized-enum-payload", "payload size");
    }
    field_types.drop();
    return size;
}

// Resolve a type name through the active generic substitution stack (backend
// mini-monomorphizer). Returns TYPE_UNKNOWN when nothing applies.
u32 llvm_subst_type_name(LlvmContext* ctx, str name) {
    return ctx.subst_type(name);
}

// Resolve a Named type that names a generic parameter (e.g. "T" inside a
// monomorphized body) to its concrete substituted TypeId. Returns the input
// id when no binding applies.
u32 llvm_resolve_named(LlvmContext* lctx, TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(type_id);
    if (entry.kind != TypeKind.Named) {
        return type_id;
    }
    str name = types.names.get(entry.name_id);
    u32 concrete = lctx.subst_type(name);
    if (concrete != TYPE_UNKNOWN) {
        return concrete;
    }
    return type_id;
}

str llvm_concrete_type_name(TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(type_id);
    if (entry.kind != TypeKind.Named || entry.count == 0) {
        return types.type_name(type_id);
    }
    String name = String.from_str(types.names.get(entry.name_id));
    name.push((u8)'$');
    i64 i = 0;
    while (i < entry.count) {
        if (i > 0) { name.push((u8)'_'); }
        u32 arg = types.type_args.get(entry.inner + i);
        String digits = String.new();
        u32 value = arg;
        if (value == 0) { digits.push((u8)'0'); }
        while (value > 0) {
            digits.push((u8)('0' + (value % 10)));
            value = value / 10;
        }
        i64 left = 0;
        i64 right = digits.len() - 1;
        while (left < right) {
            u8 temp = digits.data[left];
            digits.data[left] = digits.data[right];
            digits.data[right] = temp;
            left += 1;
            right -= 1;
        }
        name.push_str(digits.to_str());
        digits.drop();
        i += 1;
    }
    u32 name_id = types.names.intern(name.to_str());
    name.drop();
    return types.names.get(name_id);
}

LLVMOpaqueType* llvm_lower_type(LLVMOpaqueContext* ctx, TypeTable* types, u32 type_id) {
    TypeEntry* entry = types.get(type_id);
    if (entry.kind == TypeKind.Array) {
        LLVMOpaqueType* elem = llvm_lower_type(ctx, types, entry.inner);
        return LLVMArrayType(elem, (u32)entry.count);
    }
    if (entry.kind == TypeKind.Named) {
        str base_name = types.names.get(entry.name_id);
        // Generic enums need distinct layouts for different payload sizes.
        str name = entry.count > 0 ? llvm_concrete_type_name(types, type_id)
                                   : base_name;
        LLVMOpaqueType* named_ty = LLVMGetTypeByName2(ctx, name);
        if (named_ty != (LLVMOpaqueType*)0) {
            return named_ty;
        }
        if (entry.count > 0) {
            return LLVMStructCreateNamed(ctx, name);
        }
        return LLVMInt32TypeInContext(ctx);
    }
    return match entry.kind {
        TypeKind.Void : LLVMVoidTypeInContext(ctx),
        TypeKind.Bool : LLVMInt1TypeInContext(ctx),
        TypeKind.I8 : LLVMInt8TypeInContext(ctx),
        TypeKind.U8 : LLVMInt8TypeInContext(ctx),
        TypeKind.Char : LLVMInt8TypeInContext(ctx),
        TypeKind.I16 : LLVMInt16TypeInContext(ctx),
        TypeKind.U16 : LLVMInt16TypeInContext(ctx),
        TypeKind.I32 : LLVMInt32TypeInContext(ctx),
        TypeKind.U32 : LLVMInt32TypeInContext(ctx),
        TypeKind.I64 : LLVMInt64TypeInContext(ctx),
        TypeKind.U64 : LLVMInt64TypeInContext(ctx),
        TypeKind.I128 : LLVMInt128TypeInContext(ctx),
        TypeKind.U128 : LLVMInt128TypeInContext(ctx),
        TypeKind.F32 : LLVMFloatTypeInContext(ctx),
        TypeKind.F64 : LLVMDoubleTypeInContext(ctx),
        TypeKind.Str : LLVMPointerTypeInContext(ctx, (u32)0),
        TypeKind.Pointer : LLVMPointerTypeInContext(ctx, (u32)0),
        TypeKind.Reference : LLVMPointerTypeInContext(ctx, (u32)0),
        TypeKind.Function : LLVMPointerTypeInContext(ctx, (u32)0),
        _ : LLVMInt64TypeInContext(ctx),
    };
}
