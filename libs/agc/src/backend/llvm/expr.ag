// libs/agc/src/backend/llvm/expr.ag — LLVM expression lowering.
import vendor.llvm.llvm;
import std.fmt;
import std.intern;
import std.mem.vec;
import std.string;
import frontend.ast;
import frontend.ast_expr;
import frontend.items;
import frontend.lexer;
import frontend.symbols;
import frontend.typecheck_expr;
import frontend.types;
import backend.llvm.context;
import backend.llvm.drop;
import backend.llvm.mono;
import backend.llvm.stmt;
import backend.llvm.types;

i64 parse_int_literal(str text) {
    if (text == (str)0) { return 0; }
    i64 len = strlen(text);
    if (len == 0) { return 0; }
    i64 i = 0;
    bool neg = false;
    if (text[0] == '-') {
        neg = true;
        i += 1;
    } else if (text[0] == '+') {
        i += 1;
    }

    if (i + 2 <= len && text[i] == '0' && (text[i + 1] == 'x' || text[i + 1] == 'X')) {
        i += 2;
        i64 hex_val = 0;
        while (i < len) {
            u8 c = (u8)text[i];
            if (c >= (u8)'0' && c <= (u8)'9') {
                hex_val = (hex_val << 4) | (i64)(c - (u8)'0');
            } else if (c >= (u8)'a' && c <= (u8)'f') {
                hex_val = (hex_val << 4) | (i64)(c - (u8)'a' + 10);
            } else if (c >= (u8)'A' && c <= (u8)'F') {
                hex_val = (hex_val << 4) | (i64)(c - (u8)'A' + 10);
            } else if (c == (u8)'_') {
                // skip
            } else {
                break;
            }
            i += 1;
        }
        return neg ? -hex_val : hex_val;
    }

    i64 val = 0;
    while (i < len) {
        u8 c = (u8)text[i];
        if (c >= (u8)'0' && c <= (u8)'9') {
            val = val * 10 + (i64)(c - (u8)'0');
        } else if (c == (u8)'_') {
            // skip
        } else {
            break;
        }
        i += 1;
    }
    return neg ? -val : val;
}

LLVMOpaqueValue* llvm_const_int_literal(LLVMOpaqueType* ty, str text, bool negate) {
    if (text == (str)0) { return (LLVMOpaqueValue*)0; }
    i64 len = strlen(text);
    if (len == 0) { return (LLVMOpaqueValue*)0; }
    i64 i = 0;
    bool negative = false;
    if (text[i] == (u8)'-') {
        negative = true;
        i += 1;
    } else if (text[i] == (u8)'+') {
        i += 1;
    }
    i64 radix = 10;
    if (i + 2 <= len && text[i] == (u8)'0') {
        if (text[i + 1] == (u8)'x' || text[i + 1] == (u8)'X') {
            i += 2;
            radix = 16;
        } else if (text[i + 1] == (u8)'b' || text[i + 1] == (u8)'B') {
            i += 2;
            radix = 2;
        } else if (text[i + 1] == (u8)'o' || text[i + 1] == (u8)'O') {
            i += 2;
            radix = 8;
        }
    }
    if (negate) { negative = !negative; }
    String digits = String.new();
    if (negative) { digits.push((u8)'-'); }
    while (i < len) {
        if (text[i] != (u8)'_') { digits.push((u8)text[i]); }
        i += 1;
    }
    LLVMOpaqueValue* value = LLVMConstIntOfString(ty, digits.to_str(), (u8)radix);
    digits.drop();
    return value;
}

LLVMOpaqueValue* llvm_const_real_literal(LLVMOpaqueType* ty, str text) {
    if (text == (str)0) { return (LLVMOpaqueValue*)0; }
    String digits = String.new();
    i64 i = 0;
    i64 len = strlen(text);
    while (i < len) {
        if (text[i] != (u8)'_') { digits.push((u8)text[i]); }
        i += 1;
    }
    LLVMOpaqueValue* value = LLVMConstRealOfString(ty, digits.to_str());
    digits.drop();
    return value;
}

bool enum_has_payload(SyntaxNode* enum_item) {
    if (enum_item == (SyntaxNode*)0) {
        return false;
    }
    Vec<SyntaxNode*> vnames = Vec<SyntaxNode*>.new();
    Vec<i64> vtags = Vec<i64>.new();
    Vec<i64> varities = Vec<i64>.new();
    enum_each_variant(enum_item, &vnames, &vtags, &varities);
    bool has_payload = false;
    i64 vi = 0;
    while (vi < varities.len()) {
        if (varities.get(vi) > 0) {
            has_payload = true;
            break;
        }
        vi += 1;
    }
    vnames.drop();
    vtags.drop();
    varities.drop();
    return has_payload;
}

u32 parse_char_literal(str text) {
    if (text == (str)0) {
        return 0;
    }
    i64 len = strlen(text);
    i64 i = 0;
    if (len >= 2 && text[0] == (u8)39) {
        i = 1;
        len -= 1;
    }
    if (i >= len) {
        return 0;
    }
    u32 value = 0;
    if (text[i] == (u8)92 && i + 1 < len) {
        u8 next = (u8)text[i + 1];
        if (next == (u8)110) { value = 10; }
        else if (next == (u8)114) { value = 13; }
        else if (next == (u8)116) { value = 9; }
        else if (next == (u8)48) { value = 0; }
        else if (next == (u8)92) { value = 92; }
        else if (next == (u8)39) { value = 39; }
        else { value = (u32)next; }
        return value;
    }
    u8 first = (u8)text[i];
    if (first < (u8)128) {
        return (u32)first;
    }
    if ((first & (u8)224) == (u8)192 && i + 1 < len) {
        return ((u32)(first & (u8)31) << 6) | ((u32)text[i + 1] & (u8)63);
    }
    if ((first & (u8)240) == (u8)224 && i + 2 < len) {
        return ((u32)(first & (u8)15) << 12) | (((u32)text[i + 1] & (u8)63) << 6)
            | ((u32)text[i + 2] & (u8)63);
    }
    if ((first & (u8)248) == (u8)240 && i + 3 < len) {
        return ((u32)(first & (u8)7) << 18) | (((u32)text[i + 1] & (u8)63) << 12)
            | (((u32)text[i + 2] & (u8)63) << 6) | ((u32)text[i + 3] & (u8)63);
    }
    return (u32)first;
}

LLVMOpaqueValue* llvm_emit_asm(LlvmContext* ctx, u32 expr_id) {
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    AstAsm* asm_info = ctx.pool.asms.get_ptr((i64)expr.aux);
    str code = ctx.names.get(asm_info.code_id);
    str constraints = ctx.names.get(asm_info.constraints_id);
    u32 args_start = asm_info.args_start;
    u32 args_count = asm_info.args_count;

    LLVMOpaqueType* i64_ty = LLVMInt64TypeInContext(ctx.ctx);
    Vec<LLVMOpaqueType*> param_types = Vec<LLVMOpaqueType*>.new();
    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.new();

    i64 i = 0;
    while (i < (i64)args_count) {
        param_types.push(i64_ty);
        u32 arg_id = ctx.pool.args.get((i64)args_start + i);
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, arg_id);
        if (val == (LLVMOpaqueValue*)0) {
            val = LLVMConstInt(i64_ty, 0, 0);
        } else {
            u32 from_type = ctx.pool.get_expr(arg_id).inferred_type;
            TypeEntry* from_entry = ctx.types.get(from_type);
            if (from_entry.kind == TypeKind.Pointer || from_entry.kind == TypeKind.Reference || from_entry.kind == TypeKind.Str || LLVMGetTypeKind(LLVMTypeOf(val)) == (u32)12) {
                val = LLVMBuildPtrToInt(ctx.builder, val, i64_ty, "asm_p2i");
            } else if (LLVMGetTypeKind(LLVMTypeOf(val)) == (u32)8) {
                val = LLVMBuildIntCast(ctx.builder, val, i64_ty, "asm_cast");
            }
        }
        args.push(val);
        i += 1;
    }

    LLVMOpaqueType* fn_type = LLVMFunctionType(i64_ty, param_types.data, args_count, 0);
    param_types.drop();

    // Constraints arrive complete from lowering (lower_asm builds the fixed
    // x86_64 register model: =rax output, rax/rdi/rsi/rdx/r10/r8/r9 inputs,
    // rcx/r11 plus caller clobbers). Pass through verbatim: prepending
    // another copy duplicates outputs and crashes LLVM's constraint parser.
    if (args_count > 7) {
        ctx.note_unresolved("asm-args", code);
        args.drop();
        return (LLVMOpaqueValue*)0;
    }

    u64 code_len = (u64)strlen(code);
    u64 constraints_len = (u64)strlen(constraints);

    LLVMOpaqueValue* asm_val = LLVMGetInlineAsm(
        fn_type,
        (i8*)code,
        code_len,
        (i8*)constraints,
        constraints_len,
        1,
        0,
        0,
        0
    );

    LLVMOpaqueValue* res = LLVMBuildCall2(ctx.builder, fn_type, asm_val, args.data, args_count, "asm_res");
    args.drop();
    return res;
}

LLVMOpaqueValue* llvm_emit_enum_build(LlvmContext* ctx, str enum_name, str variant_name,
                                      u32 args_start, u32 args_count) {
    String base = String.new();
    i64 i = 0;
    while (enum_name[i] != (u8)0 && enum_name[i] != (u8)60) {
        base.push(enum_name[i]);
        i += 1;
    }
    // Returns and initializers supply the concrete enum payload layout.
    u32 instance_id = 0;
    if (enum_name[i] == (u8)60) {
        instance_id = ctx.types.resolve_subst(type_id_from_text(ctx.types, enum_name));
        if (!mono_type_is_concrete(ctx.ctx, ctx.types, instance_id, 0)) {
            instance_id = 0;
        }
    }
    u32 exp = ctx.expected_type_id;
    if (instance_id == 0 && exp != 0 && exp != TYPE_UNKNOWN) {
        TypeEntry* exp_entry = ctx.types.get(ctx.types.resolve_subst(exp));
        if (exp_entry.kind == TypeKind.Named && exp_entry.count > 0
            && strcmp(ctx.types.names.get(exp_entry.name_id), base.to_str()) == 0) {
            instance_id = ctx.types.resolve_subst(exp);
        }
    }
    String instance_name = String.new();
    str llvm_name = base.to_str();
    if (instance_id != 0) {
        mono_ensure_type_layout(ctx, instance_id, &ctx.generic_layout_ids);
        instance_name.push_str(llvm_concrete_type_name(ctx.types, instance_id));
        llvm_name = instance_name.to_str();
    }
    LLVMOpaqueType* enum_ty = LLVMGetTypeByName2(ctx.ctx, llvm_name);
    if (enum_ty == (LLVMOpaqueType*)0) {
        base.drop();
        instance_name.drop();
        return (LLVMOpaqueValue*)0;
    }
    i64 tag = 0;
    i64 arity = 0;
    if (!enum_variant_info(ctx.root, base.to_str(), variant_name, &tag, &arity)
        || (arity != (i64)args_count && !(arity == 1 && args_count > 1))) {
        base.drop();
        instance_name.drop();
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueType* byte_ty = LLVMInt8TypeInContext(ctx.ctx);
    LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
    LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, enum_ty, "enum_tmp");
    LLVMBuildStore(ctx.builder, LLVMConstNull(enum_ty), slot);
    LLVMOpaqueValue* bytes = LLVMBuildBitCast(ctx.builder, slot, ptr_ty, "enum_bytes");
    LLVMOpaqueValue* tag_ptr = LLVMBuildStructGEP2(ctx.builder, enum_ty, slot, 0, "enum_tag");
    LLVMBuildStore(ctx.builder, LLVMConstInt(LLVMInt16TypeInContext(ctx.ctx), (u64)tag, 0), tag_ptr);
    Vec<u32> raw_payloads = Vec<u32>.new();
    llvm_enum_payload_types(ctx.types, ctx.root, base.to_str(), variant_name, &raw_payloads);
    Vec<u32> payload_types = Vec<u32>.new();
    i64 resolved_index = 0;
    while (resolved_index < raw_payloads.len()) {
        u32 raw = raw_payloads.get(resolved_index);
        u32 resolved = (instance_id != 0)
            ? mono_resolve_struct_field_type(ctx, instance_id, raw)
            : ctx.types.resolve_subst(raw);
        payload_types.push(resolved);
        if (resolved != TYPE_UNKNOWN && resolved != 0) {
            mono_ensure_child_layouts(ctx, resolved, &ctx.generic_layout_ids);
        }
        resolved_index += 1;
    }
    raw_payloads.drop();
    i64 arg_index = 0;
    u64 payload_base_offset = 0;
    bool flattened_struct_payload = arity == 1 && args_count > 1;
    if (args_count > 0) {
        payload_base_offset = llvm_target_struct_field_offset(ctx, enum_ty, 1);
    }
    while (arg_index < (i64)args_count) {
        u32 arg_id = ctx.pool.args.get((i64)args_start + arg_index);
        u32 field_type = TYPE_UNKNOWN;
        if (flattened_struct_payload && payload_types.len() == 1) {
            u32 payload_type_id = payload_types.get(0);
            TypeEntry* payload_entry = ctx.types.get(payload_type_id);
            if (payload_entry.kind != TypeKind.Named) {
                ctx.note_unresolved("enum-payload-layout", variant_name);
                payload_types.drop();
                base.drop();
                instance_name.drop();
                return (LLVMOpaqueValue*)0;
            }
            str payload_name = ctx.types.names.get(payload_entry.name_id);
            i64 payload_field_count = llvm_struct_field_count(ctx.root, payload_name);
            if (arg_index >= payload_field_count) {
                ctx.note_unresolved("enum-payload-layout", variant_name);
                payload_types.drop();
                base.drop();
                instance_name.drop();
                return (LLVMOpaqueValue*)0;
            }
            field_type = (u32)llvm_struct_field_type(ctx.root, payload_name, arg_index, ctx.types);
            field_type = mono_resolve_struct_field_type(ctx, payload_type_id, field_type);
        } else if (arg_index < payload_types.len()) {
            field_type = payload_types.get(arg_index);
        }
        LLVMOpaqueType* field_ty = (LLVMOpaqueType*)0;
        if (field_type != TYPE_UNKNOWN) {
            field_ty = llvm_lower_type(ctx.ctx, ctx.types, field_type);
        }
        AstExpr* arg_expr = ctx.pool.get_expr(arg_id);
        LLVMOpaqueValue* arg_val = (LLVMOpaqueValue*)0;
        if (field_ty != (LLVMOpaqueType*)0 && arg_expr.kind == ExprKind.Literal && arg_expr.inferred_type != field_type) {
            str arg_text = ctx.names.get(arg_expr.inner0);
            if (type_is_integer(field_type) && type_is_integer(arg_expr.inferred_type)) {
                arg_val = llvm_const_int_literal(field_ty, arg_text, false);
            } else if (type_is_float(field_type) && type_is_float(arg_expr.inferred_type)) {
                arg_val = llvm_const_real_literal(field_ty, arg_text);
            } else if (arg_expr.inferred_type == TYPE_CHAR) {
                arg_val = LLVMConstInt(field_ty, (u64)parse_char_literal(arg_text), 0);
            }
        }
        if (arg_val == (LLVMOpaqueValue*)0) {
            u32 saved_expected = ctx.expected_type_id;
            ctx.expected_type_id = field_type;
            arg_val = llvm_emit_expr(ctx, arg_id);
            ctx.expected_type_id = saved_expected;
        }
        if (arg_val == (LLVMOpaqueValue*)0) {
            payload_types.drop();
            base.drop();
            instance_name.drop();
            return (LLVMOpaqueValue*)0;
        }
        arg_val = llvm_compat_value(ctx, arg_val, arg_expr.inferred_type, field_type);
        if ((!flattened_struct_payload && (arity != (i64)args_count || arg_index >= payload_types.len()))
            || field_ty == (LLVMOpaqueType*)0) {
            ctx.note_unresolved("enum-payload-layout", variant_name);
            payload_types.drop();
            base.drop();
            instance_name.drop();
            return (LLVMOpaqueValue*)0;
        }
        u64 payload_field_offset = 0;
        if (flattened_struct_payload) {
            LLVMOpaqueType* payload_struct_ty = llvm_lower_type(ctx.ctx, ctx.types, payload_types.get(0));
            payload_field_offset = llvm_target_struct_field_offset(ctx, payload_struct_ty, (u32)arg_index);
        } else {
            payload_field_offset = llvm_target_payload_field_offset(ctx, &payload_types, arg_index);
        }
        u64 field_offset = payload_base_offset + payload_field_offset;
        LLVMOpaqueValue* field_index = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), field_offset, 0);
        LLVMOpaqueValue* field_byte_ptr = LLVMBuildGEP2(ctx.builder, byte_ty, bytes, &field_index, 1, "enum_field_byte");
        LLVMOpaqueValue* field_ptr = LLVMBuildBitCast(ctx.builder, field_byte_ptr, ptr_ty, "enum_field");
        LLVMOpaqueValue* store = LLVMBuildStore(ctx.builder, arg_val, field_ptr);
        LLVMSetAlignment(store, 1);
        arg_index += 1;
    }
    payload_types.drop();
    base.drop();
    instance_name.drop();
    // Payloads copied out of tracked locals transfer ownership to the
    // aggregate temp (which a flagged destination then owns exactly once).
    i64 cleared_index = 0;
    while (cleared_index < (i64)args_count) {
        llvm_clear_copy_source(ctx, ctx.pool.args.get((i64)args_start + cleared_index), false);
        cleared_index += 1;
    }
    // Materialize the value so construction composes with loads and returns.
    return LLVMBuildLoad2(ctx.builder, enum_ty, slot, "enum_val");
}

u32 find_function_return_type_by_name(SyntaxNode* root, TypeTable* types, str fn_name) {
    if (root == (SyntaxNode*)0 || strlen(fn_name) == 0) { return TYPE_UNKNOWN; }
    if (str_starts_with(fn_name, "__atomic_")) {
        if (str_contains(fn_name, "cmpxchg")) { return TYPE_BOOL; }
        if (str_contains(fn_name, "store") || strcmp(fn_name, "__atomic_fence") == 0) { return TYPE_VOID; }
        if (str_contains(fn_name, "_i8")) { return TYPE_I8; }
        if (str_contains(fn_name, "_i32")) { return TYPE_I32; }
        if (str_contains(fn_name, "_i64")) { return TYPE_I64; }
    }
    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Function) {
            SyntaxNode* id_node = function_identifier(item);
            if (id_node != (SyntaxNode*)0 && strcmp(id_node.text, fn_name) == 0) {
                return function_return_type_id(types, item);
            }
        }
        item = item.next_sibling;
    }
    return TYPE_UNKNOWN;
}

u32 find_method_return_type(SyntaxNode* root, TypeTable* types, str struct_name, str method_name) {
    if (root == (SyntaxNode*)0 || strlen(struct_name) == 0 || strlen(method_name) == 0) {
        return TYPE_UNKNOWN;
    }
    String base_name = String.new();
    String type_arg0 = String.new();
    String type_arg1 = String.new();
    i64 i = 0;
    i64 slen = strlen(struct_name);
    while (i < slen && struct_name[i] != (u8)60) {
        base_name.push(struct_name[i]);
        i += 1;
    }
    if (i < slen && struct_name[i] == (u8)60) {
        i += 1;
        while (i < slen && struct_name[i] != (u8)62 && struct_name[i] != (u8)44) {
            if (struct_name[i] != (u8)32 && struct_name[i] != (u8)9) {
                type_arg0.push(struct_name[i]);
            }
            i += 1;
        }
        if (i < slen && struct_name[i] == (u8)44) {
            i += 1;
            while (i < slen && struct_name[i] != (u8)62) {
                if (struct_name[i] != (u8)32 && struct_name[i] != (u8)9) {
                    type_arg1.push(struct_name[i]);
                }
                i += 1;
            }
        }
    }

    SyntaxNode* item = root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* target = impl_target_identifier(item);
            if (target != (SyntaxNode*)0 && strcmp(target.text, base_name.to_str()) == 0) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                if (block != (SyntaxNode*)0) {
                    SyntaxNode* cursor = block.first_child;
                    while (cursor != (SyntaxNode*)0) {
                        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                            cursor = cursor.next_sibling;
                            continue;
                        }
                        bool is_cast = cursor.kind == NodeKind.Token && (cursor.token_kind == TokenKind.Cast || strcmp(cursor.text, "cast") == 0);
                        SyntaxNode* ret_start = cursor;
                        SyntaxNode* m_name = (SyntaxNode*)0;
                        SyntaxNode* params_node = (SyntaxNode*)0;
                        SyntaxNode* scan = cursor;
                        while (scan != (SyntaxNode*)0 && scan.kind != NodeKind.Block
                            && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
                            if (scan.kind == NodeKind.Parenthesized) {
                                params_node = scan;
                                break;
                            }
                            if (!is_cast && scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                                m_name = scan;
                            }
                            scan = scan.next_sibling;
                        }
                        if (is_cast && params_node != (SyntaxNode*)0) {
                            String ret_text = String.new();
                            SyntaxNode* rscan = cursor.next_sibling;
                            while (rscan != (SyntaxNode*)0 && rscan != params_node) {
                                append_node_tokens(rscan, &ret_text);
                                rscan = rscan.next_sibling;
                            }
                            String cname = String.from_str("cast_");
                            cname.push_str(ret_text.to_str());
                            bool match_cast = strcmp(cname.to_str(), method_name) == 0;
                            cname.drop();
                            if (match_cast) {
                                u32 ret_type_id = type_id_from_text(types, ret_text.to_str());
                                ret_text.drop();
                                base_name.drop();
                                type_arg0.drop();
                                type_arg1.drop();
                                return ret_type_id;
                            }
                            ret_text.drop();
                        }
                        if (m_name != (SyntaxNode*)0 && strcmp(m_name.text, method_name) == 0) {
                            SyntaxNode* rscan = ret_start;
                            while (rscan != (SyntaxNode*)0 && rscan != m_name) {
                                if (rscan.kind == NodeKind.Token && rscan.text == "#") {
                                    rscan = rscan.next_sibling;
                                    if (rscan != (SyntaxNode*)0 && rscan.kind == NodeKind.Bracket) {
                                        rscan = rscan.next_sibling;
                                    }
                                    continue;
                                }
                                if (rscan.kind == NodeKind.Token && (rscan.text == "pub" || rscan.text == "static")) {
                                    rscan = rscan.next_sibling;
                                    continue;
                                }
                                break;
                            }
                            String ret_text = String.new();
                            while (rscan != (SyntaxNode*)0 && rscan != m_name) {
                                if (rscan.kind == NodeKind.Token) {
                                    if (strcmp(rscan.text, "T") == 0 && type_arg0.len() > 0) {
                                        ret_text.push_str(type_arg0.to_str());
                                    } else if (strcmp(rscan.text, "E") == 0 && type_arg1.len() > 0) {
                                        ret_text.push_str(type_arg1.to_str());
                                    } else {
                                        ret_text.push_str(rscan.text);
                                    }
                                }
                                rscan = rscan.next_sibling;
                            }
                            u32 ret_type_id = type_id_from_text(types, ret_text.to_str());
                            ret_text.drop();
                            base_name.drop();
                            type_arg0.drop();
                            type_arg1.drop();
                            return ret_type_id;
                        }
                        while (cursor != (SyntaxNode*)0 && cursor.kind != NodeKind.Block && !(cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon)) {
                            cursor = cursor.next_sibling;
                        }
                        if (cursor != (SyntaxNode*)0) {
                            cursor = cursor.next_sibling;
                        }
                    }
                }
            }
        }
        item = item.next_sibling;
    }
    base_name.drop();
    type_arg0.drop();
    type_arg1.drop();
    return TYPE_UNKNOWN;
}

bool llvm_type_has_unresolved(LlvmContext* ctx, u32 type_id, i64 depth) {
    if (type_id == TYPE_UNKNOWN || depth > 64) { return true; }
    type_id = ctx.types.resolve_subst(type_id);
    if (type_id <= TYPE_PRIMITIVE_MAX) { return false; }
    TypeEntry* entry = ctx.types.get(type_id);
    if (entry.kind == TypeKind.TypeParam) { return true; }
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference || entry.kind == TypeKind.Array) {
        return llvm_type_has_unresolved(ctx, entry.inner, depth + 1);
    }
    if (entry.kind == TypeKind.Tuple) {
        i64 i = 0;
        while (i < entry.count) {
            if (llvm_type_has_unresolved(ctx, ctx.types.type_args.get(entry.inner + (u32)i), depth + 1)) {
                return true;
            }
            i += 1;
        }
    }
    if (entry.kind == TypeKind.Named) {
        i64 i = 0;
        while (i < entry.count) {
            if (llvm_type_has_unresolved(ctx, ctx.types.type_args.get(entry.inner + i), depth + 1)) {
                return true;
            }
            i += 1;
        }
    }
    return false;
}

str llvm_binary_operator_method(u32 op) {
    if (op == (u32)TokenKind.Plus) { return "__add"; }
    if (op == (u32)TokenKind.Minus) { return "__sub"; }
    if (op == (u32)TokenKind.Star) { return "__mul"; }
    if (op == (u32)TokenKind.Slash) { return "__div"; }
    if (op == (u32)TokenKind.Percent) { return "__mod"; }
    if (op == (u32)TokenKind.Equal) { return "__eq"; }
    if (op == (u32)TokenKind.NotEqual) { return "__ne"; }
    if (op == (u32)TokenKind.Less) { return "__lt"; }
    if (op == (u32)TokenKind.Greater) { return "__gt"; }
    if (op == (u32)TokenKind.LessEqual) { return "__le"; }
    if (op == (u32)TokenKind.GreaterEqual) { return "__ge"; }
    if (op == (u32)TokenKind.BitwiseAnd) { return "__bitand"; }
    if (op == (u32)TokenKind.BitwiseOr) { return "__bitor"; }
    if (op == (u32)TokenKind.BitwiseXor) { return "__bitxor"; }
    if (op == (u32)TokenKind.LeftShift) { return "__shl"; }
    if (op == (u32)TokenKind.RightShift) { return "__shr"; }
    return "";
}

u32 llvm_expr_type(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return TYPE_UNKNOWN; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Var) {
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0 && local.type_id != TYPE_UNKNOWN) {
            return ctx.types.resolve_subst(local.type_id);
        }
        LlvmSymbolInfo info = ctx.lookup_symbol(ctx.names.get(expr.aux));
        if (info.type_id != TYPE_UNKNOWN) {
            return ctx.types.resolve_subst(info.type_id);
        }
        u32 function_type = mono_function_value_type(ctx, ctx.names.get(expr.aux));
        if (function_type != TYPE_UNKNOWN) {
            return ctx.types.resolve_subst(function_type);
        }
    }
    if (expr.kind == ExprKind.Field && strcmp(ctx.names.get(expr.aux), "len") == 0) {
        u32 target_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr.inner0));
        TypeEntry* target = ctx.types.get(target_type);
        while (target.kind == TypeKind.Pointer || target.kind == TypeKind.Reference) {
            target_type = ctx.types.resolve_subst(target.inner);
            target = ctx.types.get(target_type);
        }
        if (target_type == TYPE_STR) { return TYPE_I64; }
    }
    if (expr.inferred_type != TYPE_UNKNOWN && expr.inferred_type != 0) {
        u32 inferred = ctx.types.resolve_subst(expr.inferred_type);
        bool unresolved_shape = llvm_type_has_unresolved(ctx, inferred, 0);
        if (!unresolved_shape) { return inferred; }
    }
    if (expr.kind == ExprKind.Field) {
        AstExpr* rx = ctx.pool.get_expr(expr.inner0);
        if (rx.kind == ExprKind.Var) {
            str rx_name = ctx.names.get(rx.aux);
            if (find_enum_item(ctx.root, rx_name) != (SyntaxNode*)0) {
                u32 named_ty = ctx.types.get_named(rx_name);
                if (named_ty != TYPE_UNKNOWN && named_ty != 0) {
                    return named_ty;
                }
            }
        }
        u32 target_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* tentry = ctx.types.get(target_type);
        while (tentry.kind == TypeKind.Pointer || tentry.kind == TypeKind.Reference) {
            target_type = tentry.inner;
            tentry = ctx.types.get(target_type);
        }
        str t_name = ctx.types.type_name(target_type);
        LlvmStructDef* def = ctx.find_struct_by_str(t_name);
        if (def != (LlvmStructDef*)0) {
            u32 field_type = ctx.find_field_type(def, expr.aux);
            if (field_type != TYPE_UNKNOWN) {
                return mono_resolve_struct_field_type(ctx, target_type, field_type);
            }
        }
    }
    if (expr.kind == ExprKind.MethodCall) {
        u32 rx_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* entry = ctx.types.get(rx_type);
        while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
            rx_type = entry.inner;
            entry = ctx.types.get(rx_type);
        }
        str struct_name = ctx.types.type_name(rx_type);
        if (rx_type == TYPE_STR) {
            u32 slice_type = typecheck_slice_result_type(ctx.types, ctx.root, TYPE_STR);
            struct_name = ctx.types.type_name(slice_type);
        }
        if (rx_type == TYPE_UNKNOWN || strlen(struct_name) == 0 || strcmp(struct_name, "unknown") == 0) {
            AstExpr* rx_expr = ctx.pool.get_expr(expr.inner0);
            if (rx_expr.kind == ExprKind.Var) {
                struct_name = ctx.names.get(rx_expr.aux);
            }
        }
        str method_name = ctx.names.get(expr.aux);
        u32 ret_ty = find_method_return_type(ctx.root, ctx.types, struct_name, method_name);
        if (ret_ty != TYPE_UNKNOWN && ret_ty != 0) {
            return ctx.types.resolve_subst(ret_ty);
        }
    }
    if (expr.kind == ExprKind.Call) {
        AstExpr* callee = ctx.pool.get_expr(expr.inner0);
        u32 callee_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* signature = ctx.types.get(callee_type);
        if (signature.kind == TypeKind.Function) {
            return ctx.types.resolve_subst(ctx.types.type_args.get(signature.inner));
        }
        if (callee.kind == ExprKind.Var) {
            str fn_name = ctx.names.get(callee.aux);
            u32 ret_ty = find_function_return_type_by_name(ctx.root, ctx.types, fn_name);
            if (ret_ty != TYPE_UNKNOWN && ret_ty != 0) {
                return ctx.types.resolve_subst(ret_ty);
            }
        }
    }
    if (expr.kind == ExprKind.Unary) {
        if (expr.aux == (u32)TokenKind.Star) {
            u32 inner = llvm_expr_type(ctx, expr.inner0);
            TypeEntry* entry = ctx.types.get(inner);
            if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                return ctx.types.resolve_subst(entry.inner);
            }
        }
        if (expr.aux == (u32)TokenKind.BitwiseAnd) {
            u32 inner = llvm_lvalue_type(ctx, expr.inner0);
            if (inner == TYPE_UNKNOWN) {
                inner = llvm_expr_type(ctx, expr.inner0);
            }
            if (inner != TYPE_UNKNOWN) {
                return ctx.types.get_pointer(inner, true);
            }
        }
        if (expr.aux == (u32)TokenKind.Not) {
            return TYPE_BOOL;
        }
        if (expr.aux == (u32)TokenKind.Minus || expr.aux == (u32)TokenKind.BitwiseNot
            || expr.aux == (u32)TokenKind.Increment || expr.aux == (u32)TokenKind.Decrement) {
            return llvm_expr_type(ctx, expr.inner0);
        }
    }
    if (expr.kind == ExprKind.Binary) {
        u32 op = expr.aux;
        if (op == (u32)TokenKind.Equal || op == (u32)TokenKind.NotEqual
            || op == (u32)TokenKind.Less || op == (u32)TokenKind.LessEqual
            || op == (u32)TokenKind.Greater || op == (u32)TokenKind.GreaterEqual
            || op == (u32)TokenKind.And || op == (u32)TokenKind.Or) {
            return TYPE_BOOL;
        }
        return llvm_expr_type(ctx, expr.inner0);
    }
    if (expr.kind == ExprKind.Index) {
        return llvm_index_elem_type(ctx, expr.inner0, expr.inner1);
    }
    if (expr.kind == ExprKind.Slice) {
        return typecheck_slice_result_type(ctx.types, ctx.root,
                                            llvm_expr_type(ctx, expr.inner0));
    }
    if (expr.kind == ExprKind.Cast) {
        return ctx.types.resolve_subst(expr.aux);
    }
    if (expr.kind == ExprKind.Assert) {
        return TYPE_VOID;
    }
    if (expr.kind == ExprKind.Format) {
        return ctx.types.get_named("String");
    }
    if (expr.kind == ExprKind.Fprint) {
        return TYPE_VOID;
    }
    if (expr.kind == ExprKind.MemoryBuiltin) {
        return llvm_expr_type(ctx, ctx.pool.args.get((i64)expr.inner0));
    }
    if (expr.kind == ExprKind.SizeOf) {
        return TYPE_I64;
    }
    if (expr.kind == ExprKind.AlignOf) {
        return TYPE_U64;
    }
    if (expr.kind == ExprKind.Hash) {
        return TYPE_I64;
    }
    if (expr.kind == ExprKind.DropInPlace) {
        return TYPE_I64;
    }
    if (expr.kind == ExprKind.StructLit) {
        str struct_name = ctx.names.get(expr.inner0);
        u32 named_id = ctx.types.get_named(struct_name);
        if (named_id != TYPE_UNKNOWN && named_id != 0) {
            return ctx.types.resolve_subst(named_id);
        }
        return TYPE_UNKNOWN;
    }
    if (expr.kind == ExprKind.UnwrapOr) {
        u32 val_ty = llvm_expr_type(ctx, expr.inner0);
        if (val_ty != TYPE_UNKNOWN) {
            TypeEntry* val_entry = ctx.types.get(val_ty);
            if (val_entry.kind == TypeKind.Pointer) {
                return ctx.types.resolve_subst(val_ty);
            }
            if (val_entry.kind == TypeKind.Named && val_entry.count > 0) {
                str base = ctx.types.names.get(val_entry.name_id);
                if (strcmp(base, "Optional") == 0 || strcmp(base, "Result") == 0
                    || strcmp(base, "SysResult") == 0) {
                    return ctx.types.resolve_subst(ctx.types.type_args.get(val_entry.inner));
                }
            }
        }
        return llvm_expr_type(ctx, expr.inner1);
    }
    if (expr.kind == ExprKind.Move) {
        if (expr.inner0 != 0) {
            return llvm_expr_type(ctx, expr.inner0);
        }
        LlvmLocal* loc = ctx.find_local(expr.aux);
        if (loc != (LlvmLocal*)0) { return ctx.types.resolve_subst(loc.type_id); }
        return TYPE_UNKNOWN;
    }
    return TYPE_UNKNOWN;
}

LLVMOpaqueValue* llvm_emit_lvalue(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return (LLVMOpaqueValue*)0; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Var) {
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0) {
            return local.ptr;
        }
        str name = ctx.names.get(expr.aux);
        LLVMOpaqueValue* global = LLVMGetNamedGlobal(ctx.module, name);
        if (global != (LLVMOpaqueValue*)0) { return global; }
        return LLVMGetNamedFunction(ctx.module, name);
    }
    if (expr.kind == ExprKind.Move) {
        if (expr.inner0 != 0) {
            return llvm_emit_lvalue(ctx, expr.inner0);
        }
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0) {
            return local.ptr;
        }
        return (LLVMOpaqueValue*)0;
    }
    if (expr.kind == ExprKind.Unary && expr.aux == (u32)TokenKind.Star) {
        return llvm_emit_expr(ctx, expr.inner0);
    }
    if (expr.kind == ExprKind.Field) {
        u32 target_type = llvm_expr_type(ctx, expr.inner0);
        bool is_ptr = false;
        TypeEntry* entry = ctx.types.get(target_type);
        while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
            target_type = entry.inner;
            is_ptr = true;
            entry = ctx.types.get(target_type);
        }
        str struct_name = ctx.types.type_name(target_type);
        LlvmStructDef* def = ctx.find_struct_by_str(struct_name);
        if (def == (LlvmStructDef*)0) {
            return (LLVMOpaqueValue*)0;
        }
        if (def != (LlvmStructDef*)0) {
            i32 field_idx = ctx.find_field_index(def, expr.aux);
            if (field_idx >= 0) {
                LLVMOpaqueValue* target_ptr = is_ptr ? llvm_emit_expr(ctx, expr.inner0) : llvm_emit_lvalue(ctx, expr.inner0);
                if (target_ptr == (LLVMOpaqueValue*)0 && !is_ptr) {
                    // Field base is an rvalue with no address (e.g. a call
                    // result struct): materialize it in a temporary so the
                    // field GEP has a home. Mirrors the rvalue-receiver fix.
                    LLVMOpaqueValue* base_val = llvm_emit_expr(ctx, expr.inner0);
                    if (base_val != (LLVMOpaqueValue*)0
                        && LLVMGetTypeKind(LLVMTypeOf(base_val)) != (u32)12) {
                        mono_ensure_type_layout(ctx, target_type, &ctx.generic_layout_ids);
                        LLVMOpaqueType* base_ty = llvm_lower_type(ctx.ctx, ctx.types, target_type);
                        if (LLVMTypeOf(base_val) == base_ty) {
                            LLVMOpaqueValue* tmp = LLVMBuildAlloca(ctx.builder, base_ty, "field_base_tmp");
                            LLVMBuildStore(ctx.builder, base_val, tmp);
                            target_ptr = tmp;
                        }
                    }
                }
                if (target_ptr != (LLVMOpaqueValue*)0) {
                    if (LLVMGetTypeKind(LLVMTypeOf(target_ptr)) != (u32)12) {
                        target_ptr = LLVMBuildIntToPtr(ctx.builder, target_ptr, LLVMPointerTypeInContext(ctx.ctx, (u32)0), "gep_ptr_cast");
                    }
                    mono_ensure_type_layout(ctx, target_type, &ctx.generic_layout_ids);
                    LLVMOpaqueType* struct_ty = llvm_lower_type(ctx.ctx, ctx.types, target_type);
                    return LLVMBuildStructGEP2(ctx.builder, struct_ty, target_ptr, (u32)field_idx, "field_gep");
                }
            }
        }
        return (LLVMOpaqueValue*)0;
    }
    if (expr.kind == ExprKind.Index) {
        u32 target_type = llvm_expr_type(ctx, expr.inner0);
        target_type = ctx.types.resolve_subst(target_type);
        TypeEntry* target_entry = ctx.types.get(target_type);
        if (target_entry.kind == TypeKind.Tuple) {
            AstExpr* index_expr = ctx.pool.get_expr(expr.inner1);
            if (index_expr.kind != ExprKind.Literal) { return (LLVMOpaqueValue*)0; }
            i64 index = parse_int_literal(ctx.names.get(index_expr.inner0));
            if (index < 0 || index >= target_entry.count) { return (LLVMOpaqueValue*)0; }
            LLVMOpaqueValue* tuple_ptr = llvm_emit_lvalue(ctx, expr.inner0);
            if (tuple_ptr == (LLVMOpaqueValue*)0) {
                LLVMOpaqueValue* tuple = llvm_emit_expr(ctx, expr.inner0);
                if (tuple == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
                LLVMOpaqueType* tuple_ty = llvm_lower_type(ctx.ctx, ctx.types, target_type);
                tuple_ptr = LLVMBuildAlloca(ctx.builder, tuple_ty, "tuple_tmp");
                LLVMBuildStore(ctx.builder, tuple, tuple_ptr);
            }
            LLVMOpaqueType* tuple_ty = llvm_lower_type(ctx.ctx, ctx.types, target_type);
            return LLVMBuildStructGEP2(ctx.builder, tuple_ty, tuple_ptr, (u32)index, "tuple_field");
        }
        if (target_entry.kind == TypeKind.Named) {
            return (LLVMOpaqueValue*)0;
        }
        // Str is a pointer at runtime (u8*); indexing must GEP the loaded
        // pointer, not the local slot. Previously fell into lvalue and read
        // stack bytes (s[0] on a str local returned garbage).
        bool is_pointer = target_entry.kind == TypeKind.Pointer || target_entry.kind == TypeKind.Reference
            || target_entry.kind == TypeKind.Str;
        bool is_array = target_entry.kind == TypeKind.Array;
        LLVMOpaqueValue* target_ptr = is_pointer
            ? llvm_emit_expr(ctx, expr.inner0)
            : llvm_emit_lvalue(ctx, expr.inner0);
        LLVMOpaqueValue* index_val = llvm_emit_expr(ctx, expr.inner1);
        if (target_ptr != (LLVMOpaqueValue*)0 && index_val != (LLVMOpaqueValue*)0) {
            if (LLVMGetTypeKind(LLVMTypeOf(target_ptr)) != (u32)12) {
                target_ptr = LLVMBuildIntToPtr(ctx.builder, target_ptr, LLVMPointerTypeInContext(ctx.ctx, (u32)0), "idx_ptr");
            }
            if (is_array) {
                target_ptr = LLVMBuildBitCast(ctx.builder, target_ptr, LLVMPointerTypeInContext(ctx.ctx, (u32)0), "arr_decay");
            }
            u32 elem_type = llvm_index_elem_type(ctx, expr.inner0, expr.inner1);
            LLVMOpaqueType* elem_ty = (elem_type != 0 && elem_type != TYPE_UNKNOWN && elem_type != TYPE_VOID)
                ? llvm_lower_type(ctx.ctx, ctx.types, elem_type)
                : LLVMInt8TypeInContext(ctx.ctx);
            LLVMOpaqueValue* idx_val = index_val;
            return LLVMBuildGEP2(ctx.builder, elem_ty, target_ptr, &idx_val, 1, "gep");
        }
        return (LLVMOpaqueValue*)0;
    }
    return (LLVMOpaqueValue*)0;
}

bool llvm_expr_may_be_unaligned(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return false; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Field) {
        u32 target_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr.inner0));
        TypeEntry* target = ctx.types.get(target_type);
        while (target.kind == TypeKind.Pointer || target.kind == TypeKind.Reference) {
            target_type = ctx.types.resolve_subst(target.inner);
            target = ctx.types.get(target_type);
        }
        LlvmStructDef* def = ctx.find_struct_by_str(ctx.types.type_name(target_type));
        return (def != (LlvmStructDef*)0 && def.packed)
            || llvm_expr_may_be_unaligned(ctx, expr.inner0);
    }
    if (expr.kind == ExprKind.Index) {
        return llvm_expr_may_be_unaligned(ctx, expr.inner0);
    }
    return false;
}

u32 llvm_index_elem_type(LlvmContext* ctx, u32 target_expr_id, u32 index_expr_id) {
    u32 target_type = llvm_expr_type(ctx, target_expr_id);
    TypeEntry* entry = ctx.types.get(target_type);
    if (entry.kind == TypeKind.Reference && entry.inner == TYPE_STR) {
        return TYPE_U8;
    }
    if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
        return ctx.types.resolve_subst(entry.inner);
    }
    if (entry.kind == TypeKind.Array) { return ctx.types.resolve_subst(entry.inner); }
    if (entry.kind == TypeKind.Str) { return TYPE_U8; }
    if (entry.kind == TypeKind.Tuple) {
        AstExpr* index_expr = ctx.pool.get_expr(index_expr_id);
        if (index_expr.kind == ExprKind.Literal) {
            i64 index = parse_int_literal(ctx.names.get(index_expr.inner0));
            if (index >= 0 && index < entry.count) {
                return ctx.types.resolve_subst(ctx.types.type_args.get(entry.inner + (u32)index));
            }
        }
    }
    if (entry.kind == TypeKind.Named && entry.count > 0) {
        str base = ctx.types.names.get(entry.name_id);
        if (strcmp(base, "Vec") == 0 || strcmp(base, "Slice") == 0) {
            return ctx.types.resolve_subst(ctx.types.type_args.get(entry.inner));
        }
    }
    return TYPE_UNKNOWN;
}

u32 llvm_lvalue_type(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return TYPE_UNKNOWN; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Var) {
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0) {
            return ctx.types.resolve_subst(local.type_id);
        }
        str name = ctx.names.get(expr.aux);
        LlvmSymbolInfo sym = ctx.lookup_symbol(name);
        if (sym.is_global && sym.type_id != TYPE_UNKNOWN) {
            return ctx.types.resolve_subst(sym.type_id);
        }
        return TYPE_UNKNOWN;
    }
    if (expr.kind == ExprKind.Field) {
        u32 target_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* entry = ctx.types.get(target_type);
        while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
            target_type = entry.inner;
            entry = ctx.types.get(target_type);
        }
        LlvmStructDef* def = ctx.find_struct_by_str(ctx.types.type_name(target_type));
        if (def != (LlvmStructDef*)0) {
            i32 field_idx = ctx.find_field_index(def, expr.aux);
            if (field_idx >= 0) {
                return mono_resolve_struct_field_type(ctx, target_type, def.fields.get_ptr(field_idx).type_id);
            }
        }
        return TYPE_UNKNOWN;
    }
    if (expr.kind == ExprKind.Index) {
        return llvm_index_elem_type(ctx, expr.inner0, expr.inner1);
    }
    if (expr.kind == ExprKind.Unary && expr.aux == (u32)TokenKind.Star) {
        u32 target_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* entry = ctx.types.get(target_type);
        if (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
            return ctx.types.resolve_subst(entry.inner);
        }
    }
    return TYPE_UNKNOWN;
}

bool llvm_type_is_signed(TypeTable* types, u32 id) {
    TypeEntry* entry = types.get(id);
    return entry.kind == TypeKind.I8 || entry.kind == TypeKind.I16
        || entry.kind == TypeKind.I32 || entry.kind == TypeKind.I64
        || entry.kind == TypeKind.I128;
}

bool llvm_type_is_unsigned(TypeTable* types, u32 id) {
    TypeEntry* entry = types.get(id);
    return entry.kind == TypeKind.U8 || entry.kind == TypeKind.U16
        || entry.kind == TypeKind.U32 || entry.kind == TypeKind.U64
        || entry.kind == TypeKind.U128
        || entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference;
}

LLVMOpaqueValue* llvm_try_apply_user_cast(LlvmContext* ctx, LLVMOpaqueValue* val, u32 from_type, u32 to_type) {
    if (val == (LLVMOpaqueValue*)0 || from_type == TYPE_UNKNOWN || to_type == TYPE_UNKNOWN || from_type == to_type) {
        return (LLVMOpaqueValue*)0;
    }
    u32 value_type = from_type;
    TypeEntry* value_entry = ctx.types.get(value_type);
    while (value_entry.kind == TypeKind.Pointer || value_entry.kind == TypeKind.Reference) {
        value_type = ctx.types.resolve_subst(value_entry.inner);
        value_entry = ctx.types.get(value_type);
    }
    if (value_entry.kind != TypeKind.Named) {
        return (LLVMOpaqueValue*)0;
    }
    str from_name = ctx.types.names.get(value_entry.name_id);
    u32 cast_target_type = to_type;
    TypeEntry* target_entry = ctx.types.get(cast_target_type);
    if (target_entry.kind == TypeKind.Reference && target_entry.inner == TYPE_STR) {
        cast_target_type = TYPE_STR;
    }
    str to_name = ctx.types.type_name(cast_target_type);
    String cast_name = String.from_str(from_name);
    cast_name.push_str("__cast_");
    cast_name.push_str(to_name);
    LLVMOpaqueValue* cast_fn = LLVMGetNamedFunction(ctx.module, cast_name.to_str());
    cast_name.drop();
    if (cast_fn == (LLVMOpaqueValue*)0) {
        return (LLVMOpaqueValue*)0;
    }
    mono_ensure_type_layout(ctx, value_type, &ctx.generic_layout_ids);
    TypeEntry* from_entry = ctx.types.get(from_type);
    while (from_entry.kind == TypeKind.Pointer || from_entry.kind == TypeKind.Reference) {
        from_type = ctx.types.resolve_subst(from_entry.inner);
        val = LLVMBuildLoad2(ctx.builder,
            llvm_lower_type(ctx.ctx, ctx.types, from_type), val, "cast.arg.deref");
        from_entry = ctx.types.get(from_type);
    }
    LLVMOpaqueType* cast_fn_ty = LLVMGlobalGetValueType(cast_fn);
    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.new();
    args.push(val);
    LLVMOpaqueValue* result = LLVMBuildCall2(ctx.builder, cast_fn_ty, cast_fn, args.data, 1, "cast.arg");
    args.drop();
    return result;
}

// Convert val to the lowered target type so stores never silently truncate
// (opaque pointers hide width mismatches from the LLVM verifier). Unknown
// or unhandled combinations pass through unchanged (status quo).
LLVMOpaqueValue* llvm_compat_value(LlvmContext* ctx, LLVMOpaqueValue* val,
                                   u32 source_type_id, u32 target_type_id) {
    if (val == (LLVMOpaqueValue*)0 || target_type_id == TYPE_UNKNOWN) {
        return val;
    }
    LLVMOpaqueType* target_ty = llvm_lower_type(ctx.ctx, ctx.types, target_type_id);
    LLVMOpaqueType* val_ty = LLVMTypeOf(val);
    if (val_ty == target_ty) {
        return val;
    }
    u32 vk = LLVMGetTypeKind(val_ty);
    u32 tk = LLVMGetTypeKind(target_ty);
    if (vk == (u32)8 && tk == (u32)8) {
        u32 vw = LLVMGetIntTypeWidth(val_ty);
        u32 tw = LLVMGetIntTypeWidth(target_ty);
        if (vw == tw) {
            return val;
        }
        if (vw < tw) {
            if (llvm_type_is_signed(ctx.types, target_type_id)) {
                return LLVMBuildSExt(ctx.builder, val, target_ty, "compat_sext");
            }
            return LLVMBuildZExt(ctx.builder, val, target_ty, "compat_zext");
        }
        return LLVMBuildTrunc(ctx.builder, val, target_ty, "compat_trunc");
    }
    if ((vk == (u32)2 || vk == (u32)3) && (tk == (u32)2 || tk == (u32)3)) {
        if (tk == (u32)3) {
            return LLVMBuildFPExt(ctx.builder, val, target_ty, "compat_fpext");
        }
        return LLVMBuildFPTrunc(ctx.builder, val, target_ty, "compat_fptrunc");
    }
    if (vk == (u32)8 && (tk == (u32)2 || tk == (u32)3)) {
        if (llvm_type_is_unsigned(ctx.types, source_type_id)) {
            return LLVMBuildUIToFP(ctx.builder, val, target_ty, "compat_uitofp");
        }
        return LLVMBuildSIToFP(ctx.builder, val, target_ty, "compat_sitofp");
    }
    if ((vk == (u32)2 || vk == (u32)3) && tk == (u32)8) {
        if (!llvm_type_is_signed(ctx.types, target_type_id)) {
            return LLVMBuildFPToUI(ctx.builder, val, target_ty, "compat_fptoui");
        }
        return LLVMBuildFPToSI(ctx.builder, val, target_ty, "compat_fptosi");
    }
    if (vk == (u32)8 && tk == (u32)12) {
        return LLVMBuildIntToPtr(ctx.builder, val, target_ty, "compat_to_ptr");
    }
    if (vk == (u32)12 && tk == (u32)8) {
        return LLVMBuildPtrToInt(ctx.builder, val, target_ty, "compat_to_int");
    }
    return val;
}

void llvm_prepare_call_args(LlvmContext* ctx, LLVMOpaqueType* fn_type,
                            Vec<LLVMOpaqueValue*>* call_args, Vec<u32>* source_types,
                            Vec<u32>* target_types, str callee) {
    if (fn_type == (LLVMOpaqueType*)0) { return; }
    u32 expected_params_count = LLVMCountParamTypes(fn_type);
    if (expected_params_count == 0) {
        if (LLVMIsFunctionVarArg(fn_type) == 0 && call_args.len() > 0) {
            call_args.len = 0;
        }
        return;
    }
    Vec<LLVMOpaqueType*> expected_tys = Vec<LLVMOpaqueType*>.new();
    u32 i = 0;
    while (i < expected_params_count) {
        expected_tys.push((LLVMOpaqueType*)0);
        i += 1;
    }
    LLVMGetParamTypes(fn_type, expected_tys.data);

    i64 pi = 0;
    while (pi < (i64)expected_params_count) {
        LLVMOpaqueType* exp_ty = expected_tys.get(pi);
        u32 exp_kind = LLVMGetTypeKind(exp_ty);
        if (pi < call_args.len()) {
            LLVMOpaqueValue* arg_v = call_args.get(pi);
            LLVMOpaqueType* act_ty = LLVMTypeOf(arg_v);
            u32 act_kind = LLVMGetTypeKind(act_ty);
            if (exp_kind == (u32)12 && act_kind == (u32)8) {
                call_args.set(pi, LLVMBuildIntToPtr(ctx.builder, arg_v, exp_ty, "arg_to_ptr"));
            } else if (exp_kind == (u32)8 && act_kind == (u32)12) {
                call_args.set(pi, LLVMBuildPtrToInt(ctx.builder, arg_v, exp_ty, "arg_to_int"));
            } else if (exp_kind == (u32)8 && act_kind == (u32)8 && exp_ty != act_ty) {
                call_args.set(pi, LLVMBuildIntCast(ctx.builder, arg_v, exp_ty, "arg_int_cast"));
            } else if ((exp_kind == (u32)2 || exp_kind == (u32)3) && act_kind == (u32)8) {
                u32 source_type = TYPE_UNKNOWN;
                if (pi < source_types.len()) { source_type = source_types.get(pi); }
                if (llvm_type_is_unsigned(ctx.types, source_type)) {
                    call_args.set(pi, LLVMBuildUIToFP(ctx.builder, arg_v, exp_ty, "arg_uitofp"));
                } else {
                    call_args.set(pi, LLVMBuildSIToFP(ctx.builder, arg_v, exp_ty, "arg_sitofp"));
                }
            } else if (exp_kind == (u32)8 && (act_kind == (u32)2 || act_kind == (u32)3)) {
                u32 target_type = TYPE_UNKNOWN;
                if (pi < target_types.len()) { target_type = target_types.get(pi); }
                if (llvm_type_is_unsigned(ctx.types, target_type)) {
                    call_args.set(pi, LLVMBuildFPToUI(ctx.builder, arg_v, exp_ty, "arg_fptoui"));
                } else {
                    call_args.set(pi, LLVMBuildFPToSI(ctx.builder, arg_v, exp_ty, "arg_fptosi"));
                }
            } else if ((exp_kind == (u32)2 || exp_kind == (u32)3) && (act_kind == (u32)2 || act_kind == (u32)3)) {
                if (exp_kind == (u32)3) {
                    call_args.set(pi, LLVMBuildFPExt(ctx.builder, arg_v, exp_ty, "arg_fpext"));
                } else {
                    call_args.set(pi, LLVMBuildFPTrunc(ctx.builder, arg_v, exp_ty, "arg_fptrunc"));
                }
            } else if (exp_kind == (u32)10 && act_kind == (u32)10
                && exp_ty != act_ty && pi < source_types.len() && pi < target_types.len()) {
                u32 source_id = ctx.types.resolve_subst(source_types.get(pi));
                u32 target_id = ctx.types.resolve_subst(target_types.get(pi));
                TypeEntry* source_entry = ctx.types.get(source_id);
                TypeEntry* target_entry = ctx.types.get(target_id);
                if (source_entry.kind == TypeKind.Named && target_entry.kind == TypeKind.Named) {
                    SyntaxNode* source_enum = find_enum_item(
                        ctx.root, ctx.types.names.get(source_entry.name_id));
                    SyntaxNode* target_enum = find_enum_item(
                        ctx.root, ctx.types.names.get(target_entry.name_id));
                    if (source_enum != (SyntaxNode*)0 && target_enum != (SyntaxNode*)0
                        && !enum_has_payload(source_enum) && !enum_has_payload(target_enum)) {
                        LLVMOpaqueValue* tag = LLVMBuildExtractValue(
                            ctx.builder, arg_v, 0, "enum_arg_tag");
                        LLVMOpaqueValue* converted = LLVMBuildInsertValue(
                            ctx.builder, LLVMConstNull(exp_ty), tag, 0, "enum_arg_cast");
                        call_args.set(pi, converted);
                    }
                }
            } else if (exp_kind != act_kind) {
                // P0-002: a kind mismatch here is usually a backend
                // UNKNOWN-type fallback artifact (opaque-ptr globals,
                // unregistered structs in unexecuted std code — e.g.
                // bt_qsort_lines, Result__get_error in the smoke closure),
                // NOT a genuine program error. Recording it breaks the
                // smoke gate, so keep the silent substitution until real
                // monomorphization lands (FE-001). Genuine by-value-T ABI
                // mismatches remain silent-but-latent; see todo P0-002.
                call_args.set(pi, LLVMConstNull(exp_ty));
            }
        } else {
            ctx.note_unresolved("missing-arg", callee);
            call_args.push(LLVMConstNull(exp_ty));
        }
        pi += 1;
    }
    if (LLVMIsFunctionVarArg(fn_type) == 0 && call_args.len() > (i64)expected_params_count) {
        call_args.len = (i64)expected_params_count;
    }
    expected_tys.drop();
}

void llvm_pack_variadic_call_args(LlvmContext* ctx, i64 fixed_count,
                                  u32 element_type_id,
                                  Vec<LLVMOpaqueValue*>* call_args,
                                  Vec<u32>* source_types,
                                  Vec<u32>* target_types, str callee) {
    if (fixed_count < 0 || call_args.len() < fixed_count
        || element_type_id == TYPE_UNKNOWN) {
        ctx.note_unresolved("variadic-argument", callee);
        return;
    }

    element_type_id = ctx.types.resolve_subst(element_type_id);
    Vec<u32> slice_args = Vec<u32>.new();
    slice_args.push(element_type_id);
    u32 slice_type_id = ctx.types.get_named_args("Slice", &slice_args);
    slice_args.drop();
    mono_ensure_type_layout(ctx, slice_type_id, &ctx.generic_layout_ids);

    LLVMOpaqueType* element_type = llvm_lower_type(ctx.ctx, ctx.types, element_type_id);
    LLVMOpaqueType* slice_type = llvm_lower_type(ctx.ctx, ctx.types, slice_type_id);
    i64 value_count = call_args.len() - fixed_count;
    LLVMOpaqueValue* data = LLVMConstNull(LLVMPointerTypeInContext(ctx.ctx, 0));
    if (value_count > 0) {
        LLVMOpaqueType* array_type = LLVMArrayType(element_type, (u32)value_count);
        LLVMOpaqueValue* array = LLVMBuildAlloca(ctx.builder, array_type, "variadic.items");
        LLVMOpaqueType* void_type = LLVMVoidTypeInContext(ctx.ctx);
        Vec<LLVMOpaqueType*> scalar_params = Vec<LLVMOpaqueType*>.new();
        scalar_params.push(element_type);
        LLVMOpaqueType* scalar_fn = LLVMFunctionType(
            void_type, scalar_params.data, 1, 0);
        scalar_params.drop();
        Vec<LLVMOpaqueValue*> converted = Vec<LLVMOpaqueValue*>.new();
        Vec<u32> scalar_sources = Vec<u32>.new();
        Vec<u32> scalar_targets = Vec<u32>.new();
        Vec<LLVMOpaqueValue*> indices = Vec<LLVMOpaqueValue*>.with_capacity(2);
        LLVMOpaqueType* index_type = LLVMInt32TypeInContext(ctx.ctx);
        LLVMOpaqueValue* zero = LLVMConstInt(index_type, 0, 0);
        i64 i = 0;
        while (i < value_count) {
            i64 source_index = fixed_count + i;
            converted.push(call_args.get(source_index));
            scalar_sources.push(source_index < source_types.len()
                ? source_types.get(source_index) : TYPE_UNKNOWN);
            scalar_targets.push(element_type_id);
            llvm_prepare_call_args(ctx, scalar_fn, &converted, &scalar_sources,
                                   &scalar_targets, callee);
            indices.push(zero);
            indices.push(LLVMConstInt(index_type, (u64)i, 0));
            LLVMOpaqueValue* element_ptr = LLVMBuildGEP2(
                ctx.builder, array_type, array, indices.data, 2, "variadic.item");
            LLVMBuildStore(ctx.builder, converted.get(0), element_ptr);
            if (i == 0) { data = element_ptr; }
            indices.len = 0;
            converted.len = 0;
            scalar_sources.len = 0;
            scalar_targets.len = 0;
            i += 1;
        }
        indices.drop();
        scalar_targets.drop();
        scalar_sources.drop();
        converted.drop();
    }

    LLVMOpaqueValue* slice = LLVMConstNull(slice_type);
    slice = LLVMBuildInsertValue(ctx.builder, slice, data, 0, "variadic.data");
    LLVMOpaqueValue* length = LLVMConstInt(
        LLVMInt64TypeInContext(ctx.ctx), (u64)value_count, 0);
    slice = LLVMBuildInsertValue(ctx.builder, slice, length, 1, "variadic.len");

    call_args.len = fixed_count;
    call_args.push(slice);
    source_types.len = fixed_count;
    source_types.push(slice_type_id);
    target_types.len = fixed_count;
    target_types.push(slice_type_id);
}

i32 llvm_atomic_ordering_from_arg(LlvmContext* ctx, u32 arg_id) {
    if (arg_id == 0) { return 7; }
    AstExpr* arg = ctx.pool.get_expr(arg_id);
    i64 val = 4;
    if (arg.kind == ExprKind.Literal) {
        str text = ctx.names.get(arg.inner0);
        val = parse_int_literal(text);
    } else if (arg.kind == ExprKind.Var) {
        str name = ctx.names.get(arg.aux);
        if (strcmp(name, "ATOMIC_RELAXED") == 0) { val = 0; }
        else if (strcmp(name, "ATOMIC_ACQUIRE") == 0) { val = 1; }
        else if (strcmp(name, "ATOMIC_RELEASE") == 0) { val = 2; }
        else if (strcmp(name, "ATOMIC_ACQ_REL") == 0) { val = 3; }
        else if (strcmp(name, "ATOMIC_SEQ_CST") == 0) { val = 4; }
    }
    if (val == 0) { return 2; }
    if (val == 1) { return 4; }
    if (val == 2) { return 5; }
    if (val == 3) { return 6; }
    return 7;
}

LLVMOpaqueValue* llvm_emit_atomic_call(LlvmContext* ctx, u32 expr_id, str name) {
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    u32 args_start = expr.inner1;
    LLVMOpaqueType* elem_ty = LLVMInt64TypeInContext(ctx.ctx);
    u32 align = 8;
    if (str_contains(name, "_i8")) {
        elem_ty = LLVMInt8TypeInContext(ctx.ctx);
        align = 1;
    } else if (str_contains(name, "_i32")) {
        elem_ty = LLVMInt32TypeInContext(ctx.ctx);
        align = 4;
    }

    if (str_starts_with(name, "__atomic_load")) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        u32 arg1 = ctx.pool.args.get((i64)args_start + 1);
        LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, arg0);
        if (ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        i32 order = llvm_atomic_ordering_from_arg(ctx, arg1);
        LLVMOpaqueValue* val = LLVMBuildLoad2(ctx.builder, elem_ty, ptr, "atomic.load");
        LLVMSetOrdering(val, order);
        LLVMSetAlignment(val, align);
        return val;
    }

    if (str_starts_with(name, "__atomic_store")) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        u32 arg1 = ctx.pool.args.get((i64)args_start + 1);
        u32 arg2 = ctx.pool.args.get((i64)args_start + 2);
        LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, arg0);
        if (ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, arg1);
        if (val == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        if (LLVMTypeOf(val) != elem_ty) {
            val = LLVMBuildIntCast(ctx.builder, val, elem_ty, "atomic.cast");
        }
        i32 order = llvm_atomic_ordering_from_arg(ctx, arg2);
        LLVMOpaqueValue* inst = LLVMBuildStore(ctx.builder, val, ptr);
        LLVMSetOrdering(inst, order);
        LLVMSetAlignment(inst, align);
        return (LLVMOpaqueValue*)0;
    }

    if (str_starts_with(name, "__atomic_exchange")) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        u32 arg1 = ctx.pool.args.get((i64)args_start + 1);
        u32 arg2 = ctx.pool.args.get((i64)args_start + 2);
        LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, arg0);
        if (ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, arg1);
        if (val == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        if (LLVMTypeOf(val) != elem_ty) {
            val = LLVMBuildIntCast(ctx.builder, val, elem_ty, "atomic.cast");
        }
        i32 order = llvm_atomic_ordering_from_arg(ctx, arg2);
        LLVMOpaqueValue* inst = LLVMBuildAtomicRMW(ctx.builder, 0, ptr, val, order, 0);
        LLVMSetAlignment(inst, align);
        return inst;
    }

    if (str_starts_with(name, "__atomic_fetch_add")) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        u32 arg1 = ctx.pool.args.get((i64)args_start + 1);
        u32 arg2 = ctx.pool.args.get((i64)args_start + 2);
        LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, arg0);
        if (ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, arg1);
        if (val == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        if (LLVMTypeOf(val) != elem_ty) {
            val = LLVMBuildIntCast(ctx.builder, val, elem_ty, "atomic.cast");
        }
        i32 order = llvm_atomic_ordering_from_arg(ctx, arg2);
        LLVMOpaqueValue* inst = LLVMBuildAtomicRMW(ctx.builder, 1, ptr, val, order, 0);
        LLVMSetAlignment(inst, align);
        return inst;
    }

    if (str_starts_with(name, "__atomic_fetch_sub")) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        u32 arg1 = ctx.pool.args.get((i64)args_start + 1);
        u32 arg2 = ctx.pool.args.get((i64)args_start + 2);
        LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, arg0);
        if (ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, arg1);
        if (val == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        if (LLVMTypeOf(val) != elem_ty) {
            val = LLVMBuildIntCast(ctx.builder, val, elem_ty, "atomic.cast");
        }
        i32 order = llvm_atomic_ordering_from_arg(ctx, arg2);
        LLVMOpaqueValue* inst = LLVMBuildAtomicRMW(ctx.builder, 2, ptr, val, order, 0);
        LLVMSetAlignment(inst, align);
        return inst;
    }

    if (str_starts_with(name, "__atomic_cmpxchg")) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        u32 arg1 = ctx.pool.args.get((i64)args_start + 1);
        u32 arg2 = ctx.pool.args.get((i64)args_start + 2);
        u32 arg3 = ctx.pool.args.get((i64)args_start + 3);
        u32 arg4 = ctx.pool.args.get((i64)args_start + 4);
        LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, arg0);
        if (ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* exp = llvm_emit_expr(ctx, arg1);
        if (exp == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* des = llvm_emit_expr(ctx, arg2);
        if (des == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("atomic-arg", name);
            return (LLVMOpaqueValue*)0;
        }
        if (LLVMTypeOf(exp) != elem_ty) {
            exp = LLVMBuildIntCast(ctx.builder, exp, elem_ty, "atomic.cast");
        }
        if (LLVMTypeOf(des) != elem_ty) {
            des = LLVMBuildIntCast(ctx.builder, des, elem_ty, "atomic.cast");
        }
        i32 succ_order = llvm_atomic_ordering_from_arg(ctx, arg3);
        i32 fail_order = llvm_atomic_ordering_from_arg(ctx, arg4);
        LLVMOpaqueValue* pair = LLVMBuildAtomicCmpXchg(ctx.builder, ptr, exp, des, succ_order, fail_order, 0);
        LLVMSetAlignment(pair, align);
        return LLVMBuildExtractValue(ctx.builder, pair, 1, "cmpxchg.ok");
    }

    if (strcmp(name, "__atomic_fence") == 0) {
        u32 arg0 = ctx.pool.args.get((i64)args_start);
        i32 order = llvm_atomic_ordering_from_arg(ctx, arg0);
        LLVMBuildFence(ctx.builder, order, 0, "");
        return (LLVMOpaqueValue*)0;
    }

    return (LLVMOpaqueValue*)0;
}

LLVMOpaqueValue* llvm_emit_format_call(LlvmContext* ctx, str fn_name,
                                       LLVMOpaqueValue** args, u32 arg_count) {
    LLVMOpaqueValue* fn = LLVMGetNamedFunction(ctx.module, fn_name);
    if (fn == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("format-runtime", fn_name);
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueType* fn_ty = LLVMGlobalGetValueType(fn);
    str call_name = "format_call";
    if (LLVMGetTypeKind(LLVMGetReturnType(fn_ty)) == (u32)0) {
        call_name = "";
    }
    return LLVMBuildCall2(ctx.builder, fn_ty, fn, args, arg_count, call_name);
}

LLVMOpaqueValue* llvm_emit_format_call2(LlvmContext* ctx, str fn_name,
                                        LLVMOpaqueValue* arg0, LLVMOpaqueValue* arg1) {
    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.with_capacity(2);
    args.push(arg0);
    args.push(arg1);
    LLVMOpaqueValue* result = llvm_emit_format_call(ctx, fn_name, args.get_ptr(0), 2);
    args.drop();
    return result;
}

LLVMOpaqueValue* llvm_emit_format_call3(LlvmContext* ctx, str fn_name,
                                        LLVMOpaqueValue* arg0, LLVMOpaqueValue* arg1,
                                        LLVMOpaqueValue* arg2) {
    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.with_capacity(3);
    args.push(arg0);
    args.push(arg1);
    args.push(arg2);
    LLVMOpaqueValue* result = llvm_emit_format_call(ctx, fn_name, args.get_ptr(0), 3);
    args.drop();
    return result;
}

bool llvm_emit_format_write_bytes(LlvmContext* ctx, LLVMOpaqueValue* string_slot,
                                  LLVMOpaqueValue* writer, LLVMOpaqueValue* data,
                                  LLVMOpaqueValue* len) {
    if (writer != (LLVMOpaqueValue*)0) {
        return llvm_emit_format_call3(ctx, "BufWriter__write", writer, data, len)
            != (LLVMOpaqueValue*)0;
    }
    return llvm_emit_format_call3(ctx, "String__push_bytes", string_slot, data, len)
        != (LLVMOpaqueValue*)0;
}

bool llvm_emit_format_write_str(LlvmContext* ctx, LLVMOpaqueValue* string_slot,
                                LLVMOpaqueValue* writer, LLVMOpaqueValue* text) {
    if (writer != (LLVMOpaqueValue*)0) {
        return llvm_emit_format_call2(ctx, "BufWriter__write_str", writer, text)
            != (LLVMOpaqueValue*)0;
    }
    return llvm_emit_format_call2(ctx, "String__push_str", string_slot, text)
        != (LLVMOpaqueValue*)0;
}

bool llvm_has_display_impl(SyntaxNode* root, str owner) {
    SyntaxNode* item = root == (SyntaxNode*)0 ? (SyntaxNode*)0 : root.first_child;
    while (item != (SyntaxNode*)0) {
        if (item.kind == NodeKind.Impl) {
            SyntaxNode* previous = (SyntaxNode*)0;
            SyntaxNode* child = item.first_child;
            bool display_impl = false;
            while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
                if (child.kind == NodeKind.Token
                    && (child.token_kind == TokenKind.For || strcmp(child.text, "for") == 0)
                    && previous != (SyntaxNode*)0 && strcmp(previous.text, "Display") == 0) {
                    display_impl = true;
                    break;
                }
                if (child.kind == NodeKind.Token) { previous = child; }
                child = child.next_sibling;
            }
            if (display_impl) {
                SyntaxNode* target = impl_target_identifier(item);
                if (target != (SyntaxNode*)0 && strcmp(target.text, owner) == 0) {
                    return true;
                }
            }
        }
        item = item.next_sibling;
    }
    return false;
}

bool llvm_emit_display_format_arg(LlvmContext* ctx, u32 arg_id, u32 arg_type,
                                  LLVMOpaqueValue* string_slot,
                                  LLVMOpaqueValue* output_writer,
                                  LLVMOpaqueValue* provided_value_ptr) {
    TypeEntry* owner_entry = ctx.types.get(arg_type);
    if (owner_entry.kind != TypeKind.Named) { return false; }
    str full_name = ctx.types.type_name(arg_type);
    String owner = String.new();
    i64 i = 0;
    while (full_name[i] != (u8)0 && full_name[i] != (u8)'<') {
        owner.push(full_name[i]);
        i += 1;
    }
    if (!llvm_has_display_impl(ctx.root, owner.to_str())) {
        owner.drop();
        return false;
    }

    LLVMOpaqueValue* fmt_fn = (LLVMOpaqueValue*)0;
    if (owner_entry.count > 0) {
        fmt_fn = mono_ensure_specialized(ctx, arg_type, "fmt");
    } else {
        String method = String.new();
        method.push_str(owner.to_str());
        method.push_str("__fmt");
        fmt_fn = LLVMGetNamedFunction(ctx.module, method.to_str());
        method.drop();
    }
    owner.drop();
    if (fmt_fn == (LLVMOpaqueValue*)0) { return false; }

    LLVMOpaqueType* writer_ty = LLVMGetTypeByName2(ctx.ctx, "BufWriter");
    if (writer_ty == (LLVMOpaqueType*)0) { return false; }
    LLVMOpaqueValue* writer = output_writer;
    if (writer == (LLVMOpaqueValue*)0) {
        writer = LLVMBuildAlloca(ctx.builder, writer_ty, "format.display.writer");
        LLVMBuildStore(ctx.builder, LLVMConstNull(writer_ty), writer);
        LLVMOpaqueValue* writer_fd = LLVMBuildStructGEP2(ctx.builder, writer_ty, writer, 3,
                                                         "format.display.fd");
        LLVMBuildStore(ctx.builder,
            LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), (u64)-1, 0), writer_fd);
        LLVMOpaqueValue* writer_mode = LLVMBuildStructGEP2(ctx.builder, writer_ty, writer, 6,
                                                           "format.display.mode");
        LLVMBuildStore(ctx.builder,
            LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx), 3, 0), writer_mode);
    }

    LLVMOpaqueValue* value_ptr = provided_value_ptr;
    if (value_ptr == (LLVMOpaqueValue*)0) {
        value_ptr = llvm_emit_lvalue(ctx, arg_id);
    }
    if (value_ptr == (LLVMOpaqueValue*)0) {
        LLVMOpaqueValue* value = llvm_emit_expr(ctx, arg_id);
        if (value == (LLVMOpaqueValue*)0) { return false; }
        LLVMOpaqueType* value_ty = llvm_lower_type(ctx.ctx, ctx.types, arg_type);
        value_ptr = LLVMBuildAlloca(ctx.builder, value_ty, "format.display.value");
        LLVMBuildStore(ctx.builder, value, value_ptr);
    }

    LLVMOpaqueType* fmt_ty = LLVMGlobalGetValueType(fmt_fn);
    Vec<LLVMOpaqueValue*> fmt_args = Vec<LLVMOpaqueValue*>.with_capacity(2);
    Vec<u32> fmt_arg_types = Vec<u32>.with_capacity(2);
    Vec<u32> fmt_target_types = Vec<u32>.with_capacity(2);
    fmt_args.push(value_ptr);
    fmt_args.push(writer);
    fmt_arg_types.push(arg_type);
    fmt_arg_types.push(TYPE_UNKNOWN);
    fmt_target_types.push(TYPE_UNKNOWN);
    fmt_target_types.push(TYPE_UNKNOWN);
    llvm_prepare_call_args(ctx, fmt_ty, &fmt_args, &fmt_arg_types, &fmt_target_types,
                           "Display::fmt");
    LLVMBuildCall2(ctx.builder, fmt_ty, fmt_fn, fmt_args.get_ptr(0), 2, "");
    fmt_args.drop();
    fmt_arg_types.drop();
    fmt_target_types.drop();

    if (output_writer != (LLVMOpaqueValue*)0) {
        return true;
    }

    LLVMOpaqueValue* data_field = LLVMBuildStructGEP2(ctx.builder, writer_ty, writer, 0,
                                                      "format.display.data");
    LLVMOpaqueValue* data_int = LLVMBuildLoad2(ctx.builder,
        LLVMInt64TypeInContext(ctx.ctx), data_field, "format.display.data.int");
    LLVMOpaqueValue* data = LLVMBuildIntToPtr(ctx.builder, data_int,
        LLVMPointerTypeInContext(ctx.ctx, 0), "format.display.data.ptr");
    LLVMOpaqueValue* len_field = LLVMBuildStructGEP2(ctx.builder, writer_ty, writer, 1,
                                                     "format.display.len");
    LLVMOpaqueValue* len = LLVMBuildLoad2(ctx.builder,
        LLVMInt64TypeInContext(ctx.ctx), len_field, "format.display.len.value");
    if (!llvm_emit_format_write_bytes(ctx, string_slot, output_writer, data, len)) {
        return false;
    }

    LLVMOpaqueValue* drop_fn = LLVMGetNamedFunction(ctx.module, "BufWriter__drop");
    if (drop_fn == (LLVMOpaqueValue*)0) { return false; }
    LLVMOpaqueType* drop_ty = LLVMGlobalGetValueType(drop_fn);
    Vec<LLVMOpaqueValue*> drop_args = Vec<LLVMOpaqueValue*>.with_capacity(1);
    Vec<u32> drop_arg_types = Vec<u32>.with_capacity(1);
    Vec<u32> drop_target_types = Vec<u32>.with_capacity(1);
    drop_args.push(writer);
    drop_arg_types.push(TYPE_UNKNOWN);
    drop_target_types.push(TYPE_UNKNOWN);
    llvm_prepare_call_args(ctx, drop_ty, &drop_args, &drop_arg_types, &drop_target_types,
                           "BufWriter::drop");
    LLVMBuildCall2(ctx.builder, drop_ty, drop_fn, drop_args.get_ptr(0), 1, "");
    drop_args.drop();
    drop_arg_types.drop();
    drop_target_types.drop();
    return true;
}

bool llvm_emit_unit_enum_format_arg(LlvmContext* ctx, u32 arg_id, u32 arg_type,
                                    LLVMOpaqueValue* string_slot,
                                    LLVMOpaqueValue* output_writer,
                                    LLVMOpaqueValue* provided_value) {
    TypeEntry* entry = ctx.types.get(arg_type);
    if (entry.kind != TypeKind.Named || entry.count != 0) { return false; }
    str enum_name = ctx.types.names.get(entry.name_id);
    SyntaxNode* enum_item = find_enum_item(ctx.root, enum_name);
    if (enum_item == (SyntaxNode*)0) { return false; }

    Vec<SyntaxNode*> names = Vec<SyntaxNode*>.new();
    Vec<i64> tags = Vec<i64>.new();
    Vec<i64> arities = Vec<i64>.new();
    enum_each_variant(enum_item, &names, &tags, &arities);
    if (names.len() == 0) {
        names.drop();
        tags.drop();
        arities.drop();
        return false;
    }
    i64 variant_index = 0;
    while (variant_index < arities.len()) {
        if (arities.get(variant_index) != 0) {
            names.drop();
            tags.drop();
            arities.drop();
            return false;
        }
        variant_index += 1;
    }

    LLVMOpaqueValue* value = provided_value;
    if (value == (LLVMOpaqueValue*)0) {
        value = llvm_emit_expr(ctx, arg_id);
    }
    if (value == (LLVMOpaqueValue*)0 || ctx.current_fn == (LLVMOpaqueValue*)0) {
        names.drop();
        tags.drop();
        arities.drop();
        return false;
    }
    LLVMOpaqueValue* discriminant = LLVMBuildExtractValue(ctx.builder, value, 0,
                                                           "format.enum.discriminant");
    LLVMOpaqueBasicBlock* end_bb = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "format.enum.end");
    LLVMOpaqueBasicBlock* unknown_bb = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "format.enum.unknown");
    Vec<LLVMOpaqueBasicBlock*> case_bbs = Vec<LLVMOpaqueBasicBlock*>.with_capacity(names.len());
    Vec<LLVMOpaqueBasicBlock*> next_bbs = Vec<LLVMOpaqueBasicBlock*>.with_capacity(names.len());
    variant_index = 0;
    while (variant_index < names.len()) {
        case_bbs.push(LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "format.enum.case"));
        if (variant_index + 1 == names.len()) {
            next_bbs.push(unknown_bb);
        } else {
            next_bbs.push(LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "format.enum.test"));
        }
        variant_index += 1;
    }

    variant_index = 0;
    while (variant_index < names.len()) {
        LLVMOpaqueValue* tag = LLVMConstInt(LLVMTypeOf(discriminant),
            (u64)tags.get(variant_index), 1);
        LLVMOpaqueValue* is_variant = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ,
            discriminant, tag, "format.enum.is_variant");
        LLVMBuildCondBr(ctx.builder, is_variant, case_bbs.get(variant_index),
                        next_bbs.get(variant_index));
        LLVMPositionBuilderAtEnd(ctx.builder, case_bbs.get(variant_index));
        LLVMOpaqueValue* text = LLVMBuildGlobalStringPtr(ctx.builder,
            names.get(variant_index).text, "format.enum.text");
        if (!llvm_emit_format_write_str(ctx, string_slot, output_writer, text)) {
            case_bbs.drop();
            next_bbs.drop();
            names.drop();
            tags.drop();
            arities.drop();
            return false;
        }
        LLVMBuildBr(ctx.builder, end_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, next_bbs.get(variant_index));
        variant_index += 1;
    }
    LLVMOpaqueValue* unknown = LLVMBuildGlobalStringPtr(ctx.builder, "<unknown>",
                                                        "format.enum.unknown.text");
    if (!llvm_emit_format_write_str(ctx, string_slot, output_writer, unknown)) {
        case_bbs.drop();
        next_bbs.drop();
        names.drop();
        tags.drop();
        arities.drop();
        return false;
    }
    LLVMBuildBr(ctx.builder, end_bb);
    LLVMPositionBuilderAtEnd(ctx.builder, end_bb);
    case_bbs.drop();
    next_bbs.drop();
    names.drop();
    tags.drop();
    arities.drop();
    return true;
}

bool llvm_emit_format_debug_value(LlvmContext* ctx, u32 value_type,
                                  LLVMOpaqueValue* value_ptr,
                                  LLVMOpaqueValue* string_slot,
                                  LLVMOpaqueValue* output_writer,
                                  u32 depth) {
    value_type = ctx.types.resolve_subst(value_type);
    TypeEntry* entry = ctx.types.get(value_type);
    if (entry.kind == TypeKind.TypeParam) {
        u32 substituted = ctx.subst_type(ctx.types.names.get(entry.name_id));
        if (substituted != TYPE_UNKNOWN) {
            value_type = ctx.types.resolve_subst(substituted);
            entry = ctx.types.get(value_type);
        }
    }

    if (value_type == TYPE_STR) {
        LLVMOpaqueValue* text = LLVMBuildLoad2(ctx.builder,
            LLVMPointerTypeInContext(ctx.ctx, 0), value_ptr, "format.debug.string");
        return llvm_emit_format_write_str(ctx, string_slot,
            output_writer, text);
    }
    if (value_type == TYPE_BOOL) {
        LLVMOpaqueValue* value = LLVMBuildLoad2(ctx.builder,
            LLVMInt1TypeInContext(ctx.ctx), value_ptr, "format.debug.bool");
        LLVMOpaqueValue* is_true = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE,
            value, LLVMConstInt(LLVMInt1TypeInContext(ctx.ctx), 0, 0), "format.debug.bool.test");
        if (ctx.current_fn == (LLVMOpaqueValue*)0) { return false; }
        LLVMOpaqueBasicBlock* true_bb = LLVMAppendBasicBlockInContext(ctx.ctx,
            ctx.current_fn, "format.debug.bool.true");
        LLVMOpaqueBasicBlock* false_bb = LLVMAppendBasicBlockInContext(ctx.ctx,
            ctx.current_fn, "format.debug.bool.false");
        LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx,
            ctx.current_fn, "format.debug.bool.end");
        LLVMBuildCondBr(ctx.builder, is_true, true_bb, false_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, true_bb);
        if (!llvm_emit_format_write_str(ctx, string_slot, output_writer,
            LLVMBuildGlobalStringPtr(ctx.builder, "true", "format.debug.true"))) {
            return false;
        }
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, false_bb);
        if (!llvm_emit_format_write_str(ctx, string_slot, output_writer,
            LLVMBuildGlobalStringPtr(ctx.builder, "false", "format.debug.false"))) {
            return false;
        }
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
        return true;
    }
    if (type_is_integer(value_type) || value_type == TYPE_F32 || value_type == TYPE_F64) {
        LLVMOpaqueValue* value = LLVMBuildLoad2(ctx.builder,
            llvm_lower_type(ctx.ctx, ctx.types, value_type), value_ptr, "format.debug.number");
        LLVMOpaqueType* buffer_ty = LLVMArrayType(LLVMInt8TypeInContext(ctx.ctx), 40);
        LLVMOpaqueValue* buffer_slot = LLVMBuildAlloca(ctx.builder, buffer_ty,
            "format.debug.number.buffer");
        LLVMOpaqueValue* buffer = LLVMBuildBitCast(ctx.builder, buffer_slot,
            LLVMPointerTypeInContext(ctx.ctx, 0), "format.debug.number.ptr");
        str formatter = "itoa";
        LLVMOpaqueType* param_ty = LLVMInt64TypeInContext(ctx.ctx);
        if (value_type == TYPE_I128 || value_type == TYPE_U128) {
            formatter = value_type == TYPE_I128 ? "itoa128" : "utoa128";
            param_ty = LLVMIntTypeInContext(ctx.ctx, 128);
        } else if (value_type == TYPE_F32 || value_type == TYPE_F64) {
            formatter = "ftoa";
            param_ty = LLVMDoubleTypeInContext(ctx.ctx);
        } else if (type_is_unsigned_integer(value_type)) {
            formatter = "utoa";
        }
        LLVMOpaqueValue* format_fn = LLVMGetNamedFunction(ctx.module, formatter);
        if (format_fn == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("format-runtime", formatter);
            return false;
        }
        if (LLVMTypeOf(value) != param_ty) {
            if (value_type == TYPE_F32) {
                value = LLVMBuildFPExt(ctx.builder, value, param_ty, "format.debug.float");
            } else if (type_is_signed_integer(value_type)) {
                value = LLVMBuildSExt(ctx.builder, value, param_ty, "format.debug.integer");
            } else {
                value = LLVMBuildZExt(ctx.builder, value, param_ty, "format.debug.integer");
            }
        }
        Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.with_capacity(2);
        args.push(value);
        args.push(buffer);
        LLVMOpaqueValue* length = LLVMBuildCall2(ctx.builder,
            LLVMGlobalGetValueType(format_fn), format_fn, args.get_ptr(0), 2,
            "format.debug.length");
        args.drop();
        return llvm_emit_format_write_bytes(ctx, string_slot, output_writer, buffer, length);
    }
    if (value_type == TYPE_CHAR) {
        LLVMOpaqueValue* value = LLVMBuildLoad2(ctx.builder,
            LLVMInt32TypeInContext(ctx.ctx), value_ptr, "format.debug.char");
        LLVMOpaqueType* byte_ty = LLVMInt8TypeInContext(ctx.ctx);
        LLVMOpaqueValue* byte = LLVMBuildAlloca(ctx.builder, byte_ty, "format.debug.char.byte");
        LLVMBuildStore(ctx.builder, LLVMBuildIntCast(ctx.builder, value, byte_ty,
            "format.debug.char.cast"), byte);
        LLVMOpaqueValue* bytes = LLVMBuildBitCast(ctx.builder, byte,
            LLVMPointerTypeInContext(ctx.ctx, 0), "format.debug.char.ptr");
        return llvm_emit_format_write_bytes(ctx, string_slot, output_writer, bytes,
            LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 1, 0));
    }
    if (entry.kind == TypeKind.Named) {
        str name = ctx.types.names.get(entry.name_id);
        if (strcmp(name, "String") == 0) {
            LLVMOpaqueType* string_ty = LLVMGetTypeByName2(ctx.ctx, "String");
            if (string_ty == (LLVMOpaqueType*)0) { return false; }
            LLVMOpaqueValue* data_ptr = LLVMBuildStructGEP2(ctx.builder, string_ty,
                value_ptr, 0, "format.debug.string.data.ptr");
            LLVMOpaqueValue* data = LLVMBuildLoad2(ctx.builder,
                LLVMPointerTypeInContext(ctx.ctx, 0), data_ptr,
                "format.debug.string.data");
            return llvm_emit_format_write_str(ctx, string_slot,
                output_writer, data);
        }
        if (llvm_emit_display_format_arg(ctx, 0, value_type, string_slot,
            output_writer, value_ptr)) {
            return true;
        }
        LLVMOpaqueValue* value = LLVMBuildLoad2(ctx.builder,
            llvm_lower_type(ctx.ctx, ctx.types, value_type), value_ptr,
            "format.debug.named.value");
        if (llvm_emit_unit_enum_format_arg(ctx, 0, value_type, string_slot,
            output_writer, value)) {
            return true;
        }
        LlvmStructDef* def = ctx.find_struct_by_str(name);
        if (def == (LlvmStructDef*)0) { return false; }
        if (depth >= 8) {
            return llvm_emit_format_write_str(ctx, string_slot,
                output_writer, LLVMBuildGlobalStringPtr(ctx.builder, "...",
                    "format.debug.depth"));
        }
        if (!llvm_emit_format_write_str(ctx, string_slot,
            output_writer, LLVMBuildGlobalStringPtr(ctx.builder, name,
                "format.debug.type"))) {
            return false;
        }
        if (def.fields.len() == 0) {
            return llvm_emit_format_write_str(ctx, string_slot,
                output_writer, LLVMBuildGlobalStringPtr(ctx.builder, " {}",
                    "format.debug.empty"));
        }
        if (!llvm_emit_format_write_str(ctx, string_slot,
            output_writer, LLVMBuildGlobalStringPtr(ctx.builder, " { ",
                "format.debug.open"))) {
            return false;
        }
        i64 i = 0;
        while (i < def.fields.len()) {
            LlvmFieldInfo* field = def.fields.get_ptr(i);
            if (i > 0 && !llvm_emit_format_write_str(ctx,
                string_slot, output_writer, LLVMBuildGlobalStringPtr(ctx.builder,
                    ", ", "format.debug.comma"))) {
                return false;
            }
            str field_name = ctx.names.get(field.name_id);
            String label = String.new();
            label.push_str(field_name);
            label.push_str(": ");
            bool wrote_label = llvm_emit_format_write_str(ctx,
                string_slot, output_writer, LLVMBuildGlobalStringPtr(ctx.builder,
                    label.to_str(), "format.debug.field"));
            label.drop();
            if (!wrote_label) { return false; }

            LLVMOpaqueValue* field_ptr = LLVMBuildStructGEP2(ctx.builder,
                def.llvm_type, value_ptr, field.index, "format.debug.field.ptr");
            u32 field_type = ctx.types.resolve_subst(field.type_id);
            TypeEntry* field_entry = ctx.types.get(field_type);
            if (field_entry.kind == TypeKind.TypeParam) {
                u32 substituted = ctx.subst_type(ctx.types.names.get(field_entry.name_id));
                if (substituted != TYPE_UNKNOWN) {
                    field_type = ctx.types.resolve_subst(substituted);
                }
            }
            if (!llvm_emit_format_debug_value(ctx, field_type, field_ptr,
                string_slot, output_writer, depth + 1)) {
                return false;
            }
            i += 1;
        }
        return llvm_emit_format_write_str(ctx, string_slot,
            output_writer, LLVMBuildGlobalStringPtr(ctx.builder, " }",
                "format.debug.close"));
    }
    return false;
}

bool llvm_emit_format_debug_arg(LlvmContext* ctx, u32 arg_id, u32 arg_type,
                                LLVMOpaqueValue* string_slot,
                                LLVMOpaqueValue* output_writer) {
    LLVMOpaqueValue* value_ptr = llvm_emit_lvalue(ctx, arg_id);
    if (value_ptr == (LLVMOpaqueValue*)0) {
        LLVMOpaqueValue* value = llvm_emit_expr(ctx, arg_id);
        if (value == (LLVMOpaqueValue*)0) { return false; }
        value_ptr = LLVMBuildAlloca(ctx.builder,
            llvm_lower_type(ctx.ctx, ctx.types, arg_type), "format.debug.value");
        LLVMBuildStore(ctx.builder, value, value_ptr);
    }
    return llvm_emit_format_debug_value(ctx, arg_type, value_ptr, string_slot,
        output_writer, 0);
}

LLVMOpaqueValue* llvm_emit_format_to(LlvmContext* ctx, AstExpr* expr,
                                     LLVMOpaqueValue* output_writer) {
    str source = ctx.names.get(expr.inner0);
    String format = unescape_string_literal(source);
    u32 args_count = expr.aux;
    i64 placeholders = 0;
    i64 scan = 0;
    while (scan < format.len) {
        if (format.data[scan] == (u8)'{') {
            if (scan + 1 < format.len && format.data[scan + 1] == (u8)'{') {
                scan += 2;
                continue;
            }
            if (scan + 1 < format.len && format.data[scan + 1] == (u8)'}') {
                placeholders += 1;
                scan += 2;
                continue;
            }
            format.drop();
            ctx.note_unresolved("format-spec", source);
            return (LLVMOpaqueValue*)0;
        }
        if (format.data[scan] == (u8)'}') {
            if (scan + 1 < format.len && format.data[scan + 1] == (u8)'}') {
                scan += 2;
                continue;
            }
            format.drop();
            ctx.note_unresolved("format-spec", source);
            return (LLVMOpaqueValue*)0;
        }
        scan += 1;
    }
    if (placeholders != (i64)args_count) {
        format.drop();
        ctx.note_unresolved("format-arity", source);
        return (LLVMOpaqueValue*)0;
    }

    LLVMOpaqueValue* string_slot = (LLVMOpaqueValue*)0;
    LLVMOpaqueType* string_ty = (LLVMOpaqueType*)0;
    if (output_writer == (LLVMOpaqueValue*)0) {
        LLVMOpaqueValue* result = llvm_emit_format_call(ctx, "String__new",
                                                        (LLVMOpaqueValue**)0, 0);
        if (result == (LLVMOpaqueValue*)0) {
            format.drop();
            return (LLVMOpaqueValue*)0;
        }
        string_ty = LLVMGetTypeByName2(ctx.ctx, "String");
        if (string_ty == (LLVMOpaqueType*)0) {
            format.drop();
            ctx.note_unresolved("format-string-type", "String");
            return (LLVMOpaqueValue*)0;
        }
        string_slot = LLVMBuildAlloca(ctx.builder, string_ty, "format.string");
        LLVMBuildStore(ctx.builder, result, string_slot);
    }

    i64 pos = 0;
    u32 arg_index = 0;
    while (pos < format.len) {
        if (format.data[pos] == (u8)'{' && pos + 1 < format.len
            && format.data[pos + 1] == (u8)'{') {
            LLVMOpaqueValue* one_char = LLVMBuildAlloca(ctx.builder, LLVMInt8TypeInContext(ctx.ctx), "format.brace");
            LLVMBuildStore(ctx.builder, LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx), (u64)'{', 0), one_char);
            LLVMOpaqueValue* brace = LLVMBuildBitCast(ctx.builder, one_char, LLVMPointerTypeInContext(ctx.ctx, 0), "format.brace.ptr");
            LLVMOpaqueValue* len = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 1, 0);
            if (!llvm_emit_format_write_bytes(ctx, string_slot, output_writer, brace, len)) {
                format.drop();
                return (LLVMOpaqueValue*)0;
            }
            pos += 2;
            continue;
        }
        if (format.data[pos] == (u8)'}' && pos + 1 < format.len
            && format.data[pos + 1] == (u8)'}') {
            LLVMOpaqueValue* byte = LLVMBuildAlloca(ctx.builder, LLVMInt8TypeInContext(ctx.ctx), "format.brace");
            LLVMBuildStore(ctx.builder, LLVMConstInt(LLVMInt8TypeInContext(ctx.ctx), (u64)'}', 0), byte);
            LLVMOpaqueValue* brace = LLVMBuildBitCast(ctx.builder, byte, LLVMPointerTypeInContext(ctx.ctx, 0), "format.brace.ptr");
            LLVMOpaqueValue* len = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 1, 0);
            if (!llvm_emit_format_write_bytes(ctx, string_slot, output_writer, brace, len)) {
                format.drop();
                return (LLVMOpaqueValue*)0;
            }
            pos += 2;
            continue;
        }
        if (format.data[pos] == (u8)'{' && pos + 1 < format.len
            && format.data[pos + 1] == (u8)'}') {
            u32 arg_id = ctx.pool.args.get((i64)expr.inner1 + (i64)arg_index);
            u32 arg_type = llvm_expr_type(ctx, arg_id);
            LLVMOpaqueValue* arg_val = (LLVMOpaqueValue*)0;
            bool needs_value = arg_type == TYPE_STR || arg_type == TYPE_BOOL
                || type_is_integer(arg_type) || arg_type == TYPE_F32
                || arg_type == TYPE_F64 || arg_type == TYPE_CHAR
                || strcmp(ctx.types.type_name(arg_type), "String") == 0;
            if (needs_value) {
                arg_val = llvm_emit_expr(ctx, arg_id);
                if (arg_val == (LLVMOpaqueValue*)0) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
            }
            if (arg_type == TYPE_STR) {
                if (!llvm_emit_format_write_str(ctx, string_slot, output_writer, arg_val)) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
            } else if (arg_type == TYPE_BOOL) {
                LLVMOpaqueValue* is_true = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE,
                    arg_val, LLVMConstInt(LLVMInt1TypeInContext(ctx.ctx), 0, 0), "format.bool.test");
                if (ctx.current_fn == (LLVMOpaqueValue*)0) {
                    format.drop();
                    ctx.note_unresolved("format-bool", "no-function");
                    return (LLVMOpaqueValue*)0;
                }
                LLVMOpaqueBasicBlock* true_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "format.bool.true");
                LLVMOpaqueBasicBlock* false_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "format.bool.false");
                LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "format.bool.end");
                LLVMBuildCondBr(ctx.builder, is_true, true_bb, false_bb);
                LLVMPositionBuilderAtEnd(ctx.builder, true_bb);
                if (!llvm_emit_format_write_str(ctx, string_slot, output_writer,
                    LLVMBuildGlobalStringPtr(ctx.builder, "true", "format.bool.true.text"))) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
                LLVMBuildBr(ctx.builder, merge_bb);
                LLVMPositionBuilderAtEnd(ctx.builder, false_bb);
                if (!llvm_emit_format_write_str(ctx, string_slot, output_writer,
                    LLVMBuildGlobalStringPtr(ctx.builder, "false", "format.bool.false.text"))) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
                LLVMBuildBr(ctx.builder, merge_bb);
                LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
            } else if (type_is_integer(arg_type)
                || arg_type == TYPE_F32 || arg_type == TYPE_F64) {
                LLVMOpaqueType* buffer_ty = LLVMArrayType(LLVMInt8TypeInContext(ctx.ctx), 40);
                LLVMOpaqueValue* buffer_slot = LLVMBuildAlloca(ctx.builder, buffer_ty, "format.number");
                LLVMOpaqueValue* buffer = LLVMBuildBitCast(ctx.builder, buffer_slot,
                    LLVMPointerTypeInContext(ctx.ctx, 0), "format.number.ptr");
                str formatter = "itoa";
                LLVMOpaqueType* param_ty = LLVMInt64TypeInContext(ctx.ctx);
                if (arg_type == TYPE_I128 || arg_type == TYPE_U128) {
                    formatter = arg_type == TYPE_I128 ? "itoa128" : "utoa128";
                    param_ty = LLVMIntTypeInContext(ctx.ctx, 128);
                } else if (arg_type == TYPE_F32 || arg_type == TYPE_F64) {
                    formatter = "ftoa";
                    param_ty = LLVMDoubleTypeInContext(ctx.ctx);
                } else if (type_is_unsigned_integer(arg_type)) {
                    formatter = "utoa";
                }
                LLVMOpaqueValue* format_fn = LLVMGetNamedFunction(ctx.module, formatter);
                if (format_fn == (LLVMOpaqueValue*)0) {
                    format.drop();
                    ctx.note_unresolved("format-runtime", formatter);
                    return (LLVMOpaqueValue*)0;
                }
                if (LLVMTypeOf(arg_val) != param_ty) {
                    if (arg_type == TYPE_F32) {
                        arg_val = LLVMBuildFPExt(ctx.builder, arg_val, param_ty, "format.float");
                    } else if (type_is_signed_integer(arg_type)) {
                        arg_val = LLVMBuildSExt(ctx.builder, arg_val, param_ty, "format.integer");
                    } else {
                        arg_val = LLVMBuildZExt(ctx.builder, arg_val, param_ty, "format.integer");
                    }
                }
                Vec<LLVMOpaqueValue*> fmt_args = Vec<LLVMOpaqueValue*>.with_capacity(2);
                fmt_args.push(arg_val);
                fmt_args.push(buffer);
                LLVMOpaqueValue* length = LLVMBuildCall2(ctx.builder,
                    LLVMGlobalGetValueType(format_fn), format_fn, fmt_args.get_ptr(0), 2, "format.length");
                fmt_args.drop();
                if (!llvm_emit_format_write_bytes(ctx, string_slot, output_writer, buffer, length)) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
            } else if (arg_type == TYPE_CHAR) {
                LLVMOpaqueType* byte_ty = LLVMInt8TypeInContext(ctx.ctx);
                LLVMOpaqueValue* byte = LLVMBuildAlloca(ctx.builder, byte_ty, "format.char");
                LLVMOpaqueValue* value = LLVMBuildIntCast(ctx.builder, arg_val, byte_ty, "format.char.byte");
                LLVMBuildStore(ctx.builder, value, byte);
                LLVMOpaqueValue* char_ptr = LLVMBuildBitCast(ctx.builder, byte,
                    LLVMPointerTypeInContext(ctx.ctx, 0), "format.char.ptr");
                LLVMOpaqueValue* len = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 1, 0);
                if (!llvm_emit_format_write_bytes(ctx, string_slot, output_writer, char_ptr, len)) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
            } else if (strcmp(ctx.types.type_name(arg_type), "String") == 0) {
                LLVMOpaqueType* string_ty2 = LLVMGetTypeByName2(ctx.ctx, "String");
                LLVMOpaqueValue* tmp = LLVMBuildAlloca(ctx.builder, string_ty2, "format.str.tmp");
                LLVMBuildStore(ctx.builder, arg_val, tmp);
                LLVMOpaqueValue* data_ptr = LLVMBuildStructGEP2(ctx.builder, string_ty2, tmp, 0, "format.str.data");
                LLVMOpaqueValue* data = LLVMBuildLoad2(ctx.builder, LLVMPointerTypeInContext(ctx.ctx, 0), data_ptr, "format.str.load");
                if (!llvm_emit_format_write_str(ctx, string_slot, output_writer, data)) {
                    format.drop();
                    return (LLVMOpaqueValue*)0;
                }
            } else if (llvm_emit_display_format_arg(ctx, arg_id, arg_type, string_slot,
                                                    output_writer, (LLVMOpaqueValue*)0)) {
                // Display implementations write into a memory-backed BufWriter;
                // append its bytes to the returned String before dropping it.
            } else if (llvm_emit_unit_enum_format_arg(ctx, arg_id, arg_type, string_slot,
                                                     output_writer, (LLVMOpaqueValue*)0)) {
                // Match the stage0 unit-enum fallback: render its variant name.
            } else if (llvm_emit_format_debug_arg(ctx, arg_id, arg_type, string_slot,
                                                  output_writer)) {
                // Types without Display use the recursive struct debug fallback.
            } else {
                format.drop();
                ctx.note_unresolved("format-arg", ctx.types.type_name(arg_type));
                return (LLVMOpaqueValue*)0;
            }
            arg_index += 1;
            pos += 2;
            continue;
        }
        String literal = String.new();
        while (pos < format.len && format.data[pos] != (u8)'{'
            && format.data[pos] != (u8)'}') {
            literal.push(format.data[pos]);
            pos += 1;
        }
        LLVMOpaqueValue* text = LLVMBuildGlobalStringPtr(ctx.builder, literal.to_str(), "format.text");
        literal.drop();
        if (!llvm_emit_format_write_str(ctx, string_slot, output_writer, text)) {
            format.drop();
            return (LLVMOpaqueValue*)0;
        }
    }
    format.drop();
    if (output_writer != (LLVMOpaqueValue*)0) {
        return LLVMConstInt(LLVMInt1TypeInContext(ctx.ctx), 1, 0);
    }
    return LLVMBuildLoad2(ctx.builder, string_ty, string_slot, "format.result");
}

LLVMOpaqueValue* llvm_emit_format(LlvmContext* ctx, AstExpr* expr) {
    return llvm_emit_format_to(ctx, expr, (LLVMOpaqueValue*)0);
}

LLVMOpaqueValue* llvm_emit_fprint(LlvmContext* ctx, AstExpr* expr) {
    AstExpr* writer_expr = ctx.pool.get_expr(expr.inner0);
    LLVMOpaqueValue* writer = (LLVMOpaqueValue*)0;
    if (writer_expr.kind == ExprKind.Var) {
        u32 writer_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* writer_entry = ctx.types.get(writer_type);
        LlvmSymbolInfo writer_symbol = ctx.lookup_symbol(ctx.names.get(writer_expr.aux));
        if (writer_symbol.is_global
            && writer_entry.kind != TypeKind.Pointer
            && writer_entry.kind != TypeKind.Reference) {
            // Print macros name the global writer value; its methods need its address.
            writer = llvm_emit_lvalue(ctx, expr.inner0);
        }
    }
    if (writer == (LLVMOpaqueValue*)0) {
        writer = llvm_emit_expr(ctx, expr.inner0);
    }
    if (writer == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("fprint-writer", "expression");
        return (LLVMOpaqueValue*)0;
    }
    AstExpr* format_expr = ctx.pool.get_expr(expr.inner1);
    if (format_expr.kind != ExprKind.Format) {
        ctx.note_unresolved("fprint-format", "expected format expression");
        return (LLVMOpaqueValue*)0;
    }
    return llvm_emit_format_to(ctx, format_expr, writer);
}

    // True when a match arm body ends in a call that never returns, so an
    // unterminated body still diverges (Optional::unwrap's none arm ends in
    // __optional_abort). Anything else unterminated fails closed.
    bool match_body_diverges(LlvmContext* ctx, AstStmt* body_stmt) {
        if (body_stmt.kind != StmtKind.Block || body_stmt.aux == 0) {
            return false;
        }
        u32 last_id = ctx.pool.block_stmts.get((i64)body_stmt.inner0 + (i64)body_stmt.aux - 1);
        AstStmt* last = ctx.pool.get_stmt(last_id);
        if (last.kind != StmtKind.Expr) {
            return false;
        }
        AstExpr* last_expr = ctx.pool.get_expr(last.inner0);
        if (last_expr.kind != ExprKind.Call) {
            return false;
        }
        AstExpr* callee = ctx.pool.get_expr(last_expr.inner0);
        if (callee.kind != ExprKind.Var) {
            return false;
        }
        str name = ctx.names.get(callee.aux);
        return strcmp(name, "abort") == 0 || strcmp(name, "__optional_abort") == 0
            || strcmp(name, "__result_abort") == 0;
    }

LLVMOpaqueValue* llvm_emit_hash(LlvmContext* ctx, AstExpr* expr) {    // Mirrors stage0 hash_codegen: str -> hash_str(s); String ->
    // hash_bytes(data, len); anything else -> hash_bytes(&val, abi_size).
    // hash_str/hash_bytes come from std.hash; missing import fails closed.
    u32 arg_id = expr.inner0;
    u32 arg_type = ctx.types.resolve_subst(llvm_expr_type(ctx, arg_id));
    LLVMOpaqueValue* arg_val = llvm_emit_expr(ctx, arg_id);
    if (arg_val == (LLVMOpaqueValue*)0) {
        return (LLVMOpaqueValue*)0;
    }
    if (arg_type == TYPE_UNKNOWN || arg_type == 0) {
        ctx.note_unresolved("hash-arg", ctx.types.type_name(arg_type));
        return (LLVMOpaqueValue*)0;
    }
    if (arg_type == TYPE_STR) {
        LLVMOpaqueValue* fn = LLVMGetNamedFunction(ctx.module, "hash_str");
        if (fn == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("hash-runtime", "hash_str");
            return (LLVMOpaqueValue*)0;
        }
        Vec<LLVMOpaqueValue*> call_args = Vec<LLVMOpaqueValue*>.with_capacity(1);
        call_args.push(arg_val);
        LLVMOpaqueValue* res = LLVMBuildCall2(ctx.builder, LLVMGlobalGetValueType(fn), fn,
                                              call_args.get_ptr(0), 1, "hash_str_call");
        call_args.drop();
        return res;
    }
    if (strcmp(ctx.types.type_name(arg_type), "String") == 0) {
        LLVMOpaqueType* string_ty = LLVMGetTypeByName2(ctx.ctx, "String");
        if (string_ty == (LLVMOpaqueType*)0) {
            ctx.note_unresolved("hash-string-type", "String");
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* tmp = LLVMBuildAlloca(ctx.builder, string_ty, "hash.str.tmp");
        LLVMBuildStore(ctx.builder, arg_val, tmp);
        LLVMOpaqueValue* data_ptr = LLVMBuildStructGEP2(ctx.builder, string_ty, tmp, 0, "hash.str.data");
        LLVMOpaqueValue* data = LLVMBuildLoad2(ctx.builder, LLVMPointerTypeInContext(ctx.ctx, 0), data_ptr, "hash.str.load");
        LLVMOpaqueValue* len_ptr = LLVMBuildStructGEP2(ctx.builder, string_ty, tmp, 1, "hash.str.len");
        LLVMOpaqueValue* len = LLVMBuildLoad2(ctx.builder, LLVMInt64TypeInContext(ctx.ctx), len_ptr, "hash.str.len.load");
        LLVMOpaqueValue* fn = LLVMGetNamedFunction(ctx.module, "hash_bytes");
        if (fn == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("hash-runtime", "hash_bytes");
            return (LLVMOpaqueValue*)0;
        }
        Vec<LLVMOpaqueValue*> call_args = Vec<LLVMOpaqueValue*>.with_capacity(2);
        call_args.push(data);
        call_args.push(len);
        LLVMOpaqueValue* res = LLVMBuildCall2(ctx.builder, LLVMGlobalGetValueType(fn), fn,
                                              call_args.get_ptr(0), 2, "hash_bytes_call");
        call_args.drop();
        return res;
    }
    LLVMOpaqueValue* fn = LLVMGetNamedFunction(ctx.module, "hash_bytes");
    if (fn == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("hash-runtime", "hash_bytes");
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueType* arg_ty = LLVMTypeOf(arg_val);
    u64 size = llvm_target_type_size(ctx, arg_type);
    LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, arg_ty, "hash.val");
    LLVMBuildStore(ctx.builder, arg_val, slot);
    LLVMOpaqueValue* ptr = LLVMBuildBitCast(ctx.builder, slot, LLVMPointerTypeInContext(ctx.ctx, 0), "hash.ptr");
    LLVMOpaqueValue* len = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), size, 0);
    Vec<LLVMOpaqueValue*> call_args = Vec<LLVMOpaqueValue*>.with_capacity(2);
    call_args.push(ptr);
    call_args.push(len);
    LLVMOpaqueValue* res = LLVMBuildCall2(ctx.builder, LLVMGlobalGetValueType(fn), fn,
                                          call_args.get_ptr(0), 2, "hash_bytes_call");
    call_args.drop();
    return res;
}

LLVMOpaqueValue* llvm_emit_struct_lit(LlvmContext* ctx, AstExpr* expr) {
    // Runtime struct literal: alloca + zero-init (missing fields stay zero,
    // mirroring global initializers) + per-field stores, then load.
    u32 named_id = TYPE_UNKNOWN;
    str struct_name = "";
    if (expr.inner0 == 0) {
        named_id = ctx.types.resolve_subst(ctx.expected_type_id);
        TypeEntry* expected = ctx.types.get(named_id);
        if (expected.kind == TypeKind.Named) {
            struct_name = ctx.types.names.get(expected.name_id);
        }
    } else {
        struct_name = ctx.names.get(expr.inner0);
        named_id = ctx.types.get_named(struct_name);
    }
    LlvmStructDef* def = ctx.find_struct_by_str(struct_name);
    if (def == (LlvmStructDef*)0 || named_id == TYPE_UNKNOWN) {
        ctx.note_unresolved("struct-lit", struct_name);
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, def.llvm_type, "struct.lit");
    LLVMBuildStore(ctx.builder, LLVMConstNull(def.llvm_type), slot);
    i64 fi = 0;
    while (fi < (i64)expr.aux) {
        u32 field_name_id = ctx.pool.args.get((i64)expr.inner1 + fi * 2);
        u32 val_id = ctx.pool.args.get((i64)expr.inner1 + fi * 2 + 1);
        i32 field_idx = ctx.find_field_index(def, field_name_id);
        if (field_idx < 0) {
            ctx.note_unresolved("struct-lit-field", ctx.names.get(field_name_id));
            return (LLVMOpaqueValue*)0;
        }
        u32 raw_field_type = ctx.find_field_type(def, field_name_id);
        u32 field_type = mono_resolve_struct_field_type(ctx, named_id, raw_field_type);
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, val_id);
        if (val == (LLVMOpaqueValue*)0) {
            return (LLVMOpaqueValue*)0;
        }
        val = llvm_compat_value(ctx, val, llvm_expr_type(ctx, val_id), field_type);
        LLVMOpaqueValue* field_ptr = LLVMBuildStructGEP2(ctx.builder, def.llvm_type, slot, (u32)field_idx, "struct.lit.field");
        LLVMOpaqueValue* store = LLVMBuildStore(ctx.builder, val, field_ptr);
        if (def.packed) { LLVMSetAlignment(store, 1); }
        fi += 1;
    }
    // Field values copied out of tracked locals transfer ownership to the
    // aggregate temp (which a flagged destination then owns exactly once).
    i64 cleared_index = 0;
    while (cleared_index < (i64)expr.aux) {
        u32 cleared_val_id = ctx.pool.args.get((i64)expr.inner1 + cleared_index * 2 + 1);
        llvm_clear_copy_source(ctx, cleared_val_id, false);
        cleared_index += 1;
    }
    return LLVMBuildLoad2(ctx.builder, def.llvm_type, slot, "struct.lit.val");
}

LLVMOpaqueValue* llvm_slice_bound_i64(LlvmContext* ctx, u32 expr_id,
                                      LLVMOpaqueValue* value, str name) {
    u32 source_type = llvm_expr_type(ctx, expr_id);
    if (LLVMGetTypeKind(LLVMTypeOf(value)) != (u32)8) {
        ctx.note_unresolved("slice-bound", name);
        return (LLVMOpaqueValue*)0;
    }
    u32 width = LLVMGetIntTypeWidth(LLVMTypeOf(value));
    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx.ctx);
    if (width < 64) {
        LLVMOpaqueValue* extended = (LLVMOpaqueValue*)0;
        if (llvm_type_is_signed(ctx.types, source_type)) {
            extended = LLVMBuildSExt(ctx.builder, value, i64_type, name);
        } else {
            extended = LLVMBuildZExt(ctx.builder, value, i64_type, name);
        }
        return extended;
    }

    bool is_signed = llvm_type_is_signed(ctx.types, source_type);
    if (width == 64) {
        if (is_signed) { return value; }
        LLVMOpaqueValue* max_i64 = LLVMConstInt(i64_type,
            (u64)0x7FFFFFFFFFFFFFFF, 0);
        LLVMOpaqueValue* above = LLVMBuildICmp(ctx.builder,
            LLVMIntPredicate.LLVMIntUGT, value, max_i64, "slice.bound.above_i64");
        return LLVMBuildSelect(ctx.builder, above, max_i64, value,
                               "slice.bound.clamp_high");
    }
    LLVMOpaqueType* source_llvm_type = LLVMTypeOf(value);
    LLVMOpaqueValue* max_i64 = LLVMConstInt(source_llvm_type,
        (u64)0x7FFFFFFFFFFFFFFF, 0);
    LLVMOpaqueValue* above = LLVMBuildICmp(ctx.builder,
        is_signed ? LLVMIntPredicate.LLVMIntSGT : LLVMIntPredicate.LLVMIntUGT,
        value, max_i64, "slice.bound.above_i64");
    value = LLVMBuildSelect(ctx.builder, above, max_i64, value, "slice.bound.clamp_high");
    if (is_signed) {
        LLVMOpaqueValue* min_i64 = LLVMConstInt(source_llvm_type,
            (u64)0x8000000000000000, 1);
        LLVMOpaqueValue* below = LLVMBuildICmp(ctx.builder,
            LLVMIntPredicate.LLVMIntSLT, value, min_i64, "slice.bound.below_i64");
        value = LLVMBuildSelect(ctx.builder, below, min_i64, value,
                                "slice.bound.clamp_low");
    }
    return LLVMBuildTrunc(ctx.builder, value, i64_type, name);
}

LLVMOpaqueValue* llvm_emit_strlen(LlvmContext* ctx, LLVMOpaqueValue* text) {
    if (text == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
    LLVMOpaqueValue* strlen_fn = LLVMGetNamedFunction(ctx.module, "strlen");
    if (strlen_fn == (LLVMOpaqueValue*)0) {
        LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx.ctx);
        LLVMOpaqueType* ptr_type = LLVMPointerTypeInContext(ctx.ctx, 0);
        Vec<LLVMOpaqueType*> params = Vec<LLVMOpaqueType*>.new();
        params.push(ptr_type);
        LLVMOpaqueType* fn_type = LLVMFunctionType(i64_type, params.data, 1, 0);
        params.drop();
        strlen_fn = LLVMAddFunction(ctx.module, "strlen", fn_type);
    }
    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.new();
    args.push(text);
    LLVMOpaqueValue* length = LLVMBuildCall2(ctx.builder,
        LLVMGlobalGetValueType(strlen_fn), strlen_fn, args.data, 1, "str.len");
    args.drop();
    return length;
}

LLVMOpaqueValue* llvm_emit_str_as_slice_value(LlvmContext* ctx, u32 expr_id) {
    LLVMOpaqueValue* text = llvm_emit_expr(ctx, expr_id);
    if (text == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
    u32 slice_type = typecheck_slice_result_type(ctx.types, ctx.root, TYPE_STR);
    mono_ensure_type_layout(ctx, slice_type, &ctx.generic_layout_ids);
    LLVMOpaqueType* slice_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, slice_type);
    LLVMOpaqueValue* length = llvm_emit_strlen(ctx, text);
    if (length == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
    LLVMOpaqueValue* slice = LLVMConstNull(slice_llvm_type);
    slice = LLVMBuildInsertValue(ctx.builder, slice, text, 0, "str.slice.data");
    return LLVMBuildInsertValue(ctx.builder, slice, length, 1, "str.slice.len");
}

LLVMOpaqueValue* llvm_emit_str_as_slice_ptr(LlvmContext* ctx, u32 expr_id) {
    LLVMOpaqueValue* slice = llvm_emit_str_as_slice_value(ctx, expr_id);
    if (slice == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
    LLVMOpaqueType* slice_type = LLVMTypeOf(slice);
    LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, slice_type, "str.slice.receiver");
    LLVMBuildStore(ctx.builder, slice, slot);
    return slot;
}

LLVMOpaqueValue* llvm_emit_slice_argument(LlvmContext* ctx, u32 expr_id,
                                          u32 slice_type_id,
                                          LLVMOpaqueValue** temporary_ptr,
                                          u32* temporary_type) {
    if (temporary_ptr != (LLVMOpaqueValue**)0) {
        *temporary_ptr = (LLVMOpaqueValue*)0;
    }
    if (temporary_type != (u32*)0) { *temporary_type = TYPE_UNKNOWN; }
    u32 actual_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr_id));
    if (!typecheck_slice_argument_coercion(ctx.types, slice_type_id, actual_type)) {
        return (LLVMOpaqueValue*)0;
    }
    slice_type_id = ctx.types.resolve_subst(slice_type_id);
    TypeEntry* source_entry = ctx.types.get(actual_type);
    bool source_is_indirect = source_entry.kind == TypeKind.Pointer
        || source_entry.kind == TypeKind.Reference;
    while (source_entry.kind == TypeKind.Pointer
        || source_entry.kind == TypeKind.Reference) {
        actual_type = ctx.types.resolve_subst(source_entry.inner);
        source_entry = ctx.types.get(actual_type);
    }

    mono_ensure_child_layouts(ctx, slice_type_id, &ctx.generic_layout_ids);
    LLVMOpaqueType* slice_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, slice_type_id);
    LlvmStructDef* slice_def = ctx.find_struct_by_str("Slice");
    if (slice_def == (LlvmStructDef*)0) {
        ctx.note_unresolved("slice-layout", "Slice");
        return (LLVMOpaqueValue*)0;
    }
    u32 data_name = ctx.names.intern("data");
    u32 len_name = ctx.names.intern("len");
    i32 data_index = ctx.find_field_index(slice_def, data_name);
    i32 len_index = ctx.find_field_index(slice_def, len_name);
    if (data_index < 0 || len_index < 0) {
        ctx.note_unresolved("slice-layout", "Slice.data/len");
        return (LLVMOpaqueValue*)0;
    }

    LLVMOpaqueValue* data = (LLVMOpaqueValue*)0;
    LLVMOpaqueValue* length = (LLVMOpaqueValue*)0;
    if (actual_type == TYPE_STR) {
        LLVMOpaqueValue* text = llvm_emit_expr(ctx, expr_id);
        if (text == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
        if (source_is_indirect) {
            text = LLVMBuildLoad2(ctx.builder,
                llvm_lower_type(ctx.ctx, ctx.types, TYPE_STR), text, "slice.str.value");
        }
        data = text;
        length = llvm_emit_strlen(ctx, text);
    } else if (source_entry.kind == TypeKind.Array) {
        AstExpr* argument = ctx.pool.get_expr(expr_id);
        u32 source_expr_id = argument.kind == ExprKind.Unary
                && argument.aux == (u32)TokenKind.BitwiseAnd
            ? argument.inner0 : expr_id;
        LLVMOpaqueValue* source_ptr = (LLVMOpaqueValue*)0;
        if (source_is_indirect && source_expr_id == expr_id) {
            source_ptr = llvm_emit_expr(ctx, expr_id);
        } else {
            source_ptr = llvm_emit_lvalue(ctx, source_expr_id);
        }
        if (source_ptr == (LLVMOpaqueValue*)0) {
            LLVMOpaqueValue* source_value = llvm_emit_expr(ctx, source_expr_id);
            if (source_value == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            LLVMOpaqueType* source_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, actual_type);
            source_ptr = LLVMBuildAlloca(ctx.builder, source_llvm_type, "slice.array.tmp");
            LLVMBuildStore(ctx.builder, source_value, source_ptr);
            if (temporary_ptr != (LLVMOpaqueValue**)0) { *temporary_ptr = source_ptr; }
            if (temporary_type != (u32*)0) { *temporary_type = actual_type; }
        }
        data = source_ptr;
        length = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx),
                              (u64)source_entry.count, 0);
    } else if (source_entry.kind == TypeKind.Named
        && strcmp(ctx.types.names.get(source_entry.name_id), "Slice") == 0) {
        LLVMOpaqueValue* value = llvm_emit_expr(ctx, expr_id);
        if (value == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
        if (source_is_indirect) {
            return LLVMBuildLoad2(ctx.builder,
                llvm_lower_type(ctx.ctx, ctx.types, actual_type), value, "slice.value");
        }
        return value;
    } else if (source_entry.kind == TypeKind.Named
        && strcmp(ctx.types.names.get(source_entry.name_id), "Vec") == 0) {
        mono_ensure_child_layouts(ctx, actual_type, &ctx.generic_layout_ids);
        LlvmStructDef* vec_def = ctx.find_struct_by_str("Vec");
        if (vec_def == (LlvmStructDef*)0) {
            ctx.note_unresolved("slice-source-layout", "Vec");
            return (LLVMOpaqueValue*)0;
        }
        u32 vec_data_name = ctx.names.intern("data");
        u32 vec_len_name = ctx.names.intern("len");
        i32 vec_data_index = ctx.find_field_index(vec_def, vec_data_name);
        i32 vec_len_index = ctx.find_field_index(vec_def, vec_len_name);
        u32 vec_data_type = ctx.find_field_type(vec_def, vec_data_name);
        u32 vec_len_type = ctx.find_field_type(vec_def, vec_len_name);
        if (vec_data_index < 0 || vec_len_index < 0
            || vec_data_type == TYPE_UNKNOWN || vec_len_type == TYPE_UNKNOWN) {
            ctx.note_unresolved("slice-source-layout", "Vec.data/len");
            return (LLVMOpaqueValue*)0;
        }
        vec_data_type = mono_resolve_struct_field_type(ctx, actual_type, vec_data_type);
        vec_len_type = mono_resolve_struct_field_type(ctx, actual_type, vec_len_type);
        AstExpr* argument = ctx.pool.get_expr(expr_id);
        u32 source_expr_id = argument.kind == ExprKind.Unary
                && argument.aux == (u32)TokenKind.BitwiseAnd
            ? argument.inner0 : expr_id;
        LLVMOpaqueValue* source_ptr = (LLVMOpaqueValue*)0;
        if (source_is_indirect && source_expr_id == expr_id) {
            source_ptr = llvm_emit_expr(ctx, expr_id);
        } else {
            source_ptr = llvm_emit_lvalue(ctx, source_expr_id);
        }
        if (source_ptr == (LLVMOpaqueValue*)0) {
            LLVMOpaqueValue* source_value = llvm_emit_expr(ctx, source_expr_id);
            if (source_value == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            LLVMOpaqueType* source_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, actual_type);
            source_ptr = LLVMBuildAlloca(ctx.builder, source_llvm_type, "slice.vec.tmp");
            LLVMBuildStore(ctx.builder, source_value, source_ptr);
            if (temporary_ptr != (LLVMOpaqueValue**)0) { *temporary_ptr = source_ptr; }
            if (temporary_type != (u32*)0) { *temporary_type = actual_type; }
        }
        LLVMOpaqueType* vec_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, actual_type);
        LLVMOpaqueValue* data_ptr = LLVMBuildStructGEP2(ctx.builder, vec_llvm_type,
            source_ptr, (u32)vec_data_index, "slice.vec.data.ptr");
        LLVMOpaqueValue* len_ptr = LLVMBuildStructGEP2(ctx.builder, vec_llvm_type,
            source_ptr, (u32)vec_len_index, "slice.vec.len.ptr");
        data = LLVMBuildLoad2(ctx.builder,
            llvm_lower_type(ctx.ctx, ctx.types, vec_data_type), data_ptr, "slice.vec.data");
        length = LLVMBuildLoad2(ctx.builder,
            llvm_lower_type(ctx.ctx, ctx.types, vec_len_type), len_ptr, "slice.vec.len");
    }
    if (data == (LLVMOpaqueValue*)0 || length == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("slice-source", ctx.types.type_name(actual_type));
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueValue* result = LLVMConstNull(slice_llvm_type);
    result = LLVMBuildInsertValue(ctx.builder, result, data, (u32)data_index,
                                  "slice.arg.data");
    return LLVMBuildInsertValue(ctx.builder, result, length, (u32)len_index,
                                "slice.arg.len");
}

LLVMOpaqueValue* llvm_emit_slice(LlvmContext* ctx, u32 expr_id) {
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    u32 target_id = expr.inner0;
    u32 start_id = expr.inner1;
    u32 end_id = expr.aux;
    Span span = expr.span;
    u32 target_type = ctx.types.resolve_subst(llvm_expr_type(ctx, target_id));
    TypeEntry* target = ctx.types.get(target_type);
    while (target.kind == TypeKind.Pointer || target.kind == TypeKind.Reference) {
        target_type = ctx.types.resolve_subst(target.inner);
        target = ctx.types.get(target_type);
    }

    if (target.kind != TypeKind.Array && target.kind != TypeKind.Str) {
        if (start_id == 0) {
            start_id = ctx.pool.add_literal_val(TYPE_I64, ctx.names.intern("0"), span);
        }
        if (end_id == 0) {
            end_id = ctx.pool.add_literal_val(TYPE_I64,
                ctx.names.intern("9223372036854775807"), span);
        }
        u32 args_start = (u32)ctx.pool.args.len();
        ctx.pool.args.push(2);
        ctx.pool.args.push(start_id);
        ctx.pool.args.push(end_id);
        AstExpr method;
        method.kind = ExprKind.MethodCall;
        method.inner0 = target_id;
        method.inner1 = args_start;
        method.aux = ctx.names.intern("__slice_get");
        method.span = span;
        method.inferred_type = expr.inferred_type;
        method.generic_args_start = 0;
        method.generic_args_count = 0;
        method.resolved_callee_id = 0;
        ctx.pool.exprs.push(move method);
        return llvm_emit_expr(ctx, (u32)(ctx.pool.exprs.len() - 1));
    }

    u32 element_type = TYPE_U8;
    if (target.kind == TypeKind.Array) {
        element_type = target.inner;
    }
    u32 slice_type = typecheck_slice_result_type(ctx.types, ctx.root, target_type);
    mono_ensure_type_layout(ctx, slice_type, &ctx.generic_layout_ids);
    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx.ctx);
    LLVMOpaqueValue* base_ptr = (LLVMOpaqueValue*)0;
    LLVMOpaqueValue* length = (LLVMOpaqueValue*)0;
    LLVMOpaqueType* element_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, element_type);

    if (target.kind == TypeKind.Array) {
        base_ptr = llvm_emit_lvalue(ctx, target_id);
        if (base_ptr == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("slice-source", "temporary array");
            return (LLVMOpaqueValue*)0;
        }
        length = LLVMConstInt(i64_type, (u64)target.count, 0);
    } else {
        base_ptr = llvm_emit_expr(ctx, target_id);
        if (base_ptr != (LLVMOpaqueValue*)0) {
            length = llvm_emit_strlen(ctx, base_ptr);
        }
    }
    if (base_ptr == (LLVMOpaqueValue*)0 || length == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("slice-source", "expression");
        return (LLVMOpaqueValue*)0;
    }

    LLVMOpaqueValue* start = (LLVMOpaqueValue*)0;
    if (start_id == 0) {
        start = LLVMConstInt(i64_type, 0, 0);
    } else {
        LLVMOpaqueValue* start_value = llvm_emit_expr(ctx, start_id);
        if (start_value != (LLVMOpaqueValue*)0) {
            start = llvm_slice_bound_i64(ctx, start_id, start_value,
                                         "slice.start.i64");
        }
    }
    LLVMOpaqueValue* end = (LLVMOpaqueValue*)0;
    if (end_id == 0) {
        end = length;
    } else {
        LLVMOpaqueValue* end_value = llvm_emit_expr(ctx, end_id);
        if (end_value != (LLVMOpaqueValue*)0) {
            end = llvm_slice_bound_i64(ctx, end_id, end_value,
                                       "slice.end.i64");
        }
    }
    if (start == (LLVMOpaqueValue*)0 || end == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("slice-bound", "expression");
        return (LLVMOpaqueValue*)0;
    }

    LLVMOpaqueValue* zero = LLVMConstInt(i64_type, 0, 0);
    LLVMOpaqueValue* start_negative = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT,
        start, zero, "slice.start.negative");
    LLVMOpaqueValue* start_from_end = LLVMBuildAdd(ctx.builder, start, length, "slice.start.from_end");
    start = LLVMBuildSelect(ctx.builder, start_negative, start_from_end, start, "slice.start.normalized");
    LLVMOpaqueValue* start_below_zero = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT,
        start, zero, "slice.start.below_zero");
    start = LLVMBuildSelect(ctx.builder, start_below_zero, zero, start, "slice.start.clamped_low");
    LLVMOpaqueValue* start_past_end = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSGT,
        start, length, "slice.start.past_end");
    start = LLVMBuildSelect(ctx.builder, start_past_end, length, start, "slice.start.clamped_high");

    LLVMOpaqueValue* end_negative = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT,
        end, zero, "slice.end.negative");
    LLVMOpaqueValue* end_from_end = LLVMBuildAdd(ctx.builder, end, length, "slice.end.from_end");
    end = LLVMBuildSelect(ctx.builder, end_negative, end_from_end, end, "slice.end.normalized");
    LLVMOpaqueValue* end_below_zero = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT,
        end, zero, "slice.end.below_zero");
    end = LLVMBuildSelect(ctx.builder, end_below_zero, zero, end, "slice.end.clamped_low");
    LLVMOpaqueValue* end_past_end = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSGT,
        end, length, "slice.end.past_end");
    end = LLVMBuildSelect(ctx.builder, end_past_end, length, end, "slice.end.clamped_high");
    LLVMOpaqueValue* end_before_start = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT,
        end, start, "slice.end.before_start");
    end = LLVMBuildSelect(ctx.builder, end_before_start, start, end, "slice.end.normalized");

    LLVMOpaqueValue* data_ptr = base_ptr;
    if (target.kind == TypeKind.Array) {
        Vec<LLVMOpaqueValue*> indices = Vec<LLVMOpaqueValue*>.new();
        indices.push(LLVMConstInt(LLVMInt32TypeInContext(ctx.ctx), 0, 0));
        indices.push(start);
        data_ptr = LLVMBuildGEP2(ctx.builder, llvm_lower_type(ctx.ctx, ctx.types, target_type),
            base_ptr, indices.data, 2, "slice.array.data");
        indices.drop();
    } else {
        data_ptr = LLVMBuildGEP2(ctx.builder, element_llvm_type, base_ptr, &start, 1, "slice.str.data");
    }

    if (expr.inferred_type == TYPE_STR) {
        return data_ptr;
    }
    LLVMOpaqueType* slice_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, slice_type);
    LLVMOpaqueValue* slice_slot = LLVMBuildAlloca(ctx.builder, slice_llvm_type, "slice.result");
    LLVMBuildStore(ctx.builder, LLVMConstNull(slice_llvm_type), slice_slot);
    LLVMOpaqueValue* data_field = LLVMBuildStructGEP2(ctx.builder, slice_llvm_type, slice_slot, 0, "slice.data.field");
    LLVMOpaqueValue* len_field = LLVMBuildStructGEP2(ctx.builder, slice_llvm_type, slice_slot, 1, "slice.len.field");
    LLVMBuildStore(ctx.builder, data_ptr, data_field);
    LLVMBuildStore(ctx.builder, LLVMBuildSub(ctx.builder, end, start, "slice.result.len"), len_field);
    return LLVMBuildLoad2(ctx.builder, slice_llvm_type, slice_slot, "slice.result.value");
}

LLVMOpaqueValue* llvm_emit_primitive_compare(LlvmContext* ctx, u32 receiver_expr_id,
                                              u32 other_expr_id, u32 type_id,
                                              bool receiver_is_pointer) {
    type_id = ctx.types.resolve_subst(type_id);
    LLVMOpaqueType* value_type = llvm_lower_type(ctx.ctx, ctx.types, type_id);
    LLVMOpaqueValue* left = llvm_emit_expr(ctx, receiver_expr_id);
    if (left == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("compare-receiver", "value");
        return (LLVMOpaqueValue*)0;
    }
    if (receiver_is_pointer) {
        left = LLVMBuildLoad2(ctx.builder, value_type, left, "compare_self");
    }

    u32 other_type = ctx.types.resolve_subst(llvm_expr_type(ctx, other_expr_id));
    TypeEntry* other_entry = ctx.types.get(other_type);
    bool other_is_pointer = false;
    while (other_entry.kind == TypeKind.Pointer || other_entry.kind == TypeKind.Reference) {
        other_type = other_entry.inner;
        other_is_pointer = true;
        other_entry = ctx.types.get(other_type);
    }
    LLVMOpaqueValue* right = llvm_emit_expr(ctx, other_expr_id);
    if (right == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("compare-argument", "value");
        return (LLVMOpaqueValue*)0;
    }
    if (other_is_pointer) {
        right = LLVMBuildLoad2(ctx.builder, value_type, right, "compare_other");
    }

    if (type_id == TYPE_STR) {
        LLVMOpaqueValue* result = llvm_emit_format_call2(ctx, "strcmp", left, right);
        if (result == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("method", "str__compare");
        }
        return result;
    }

    LLVMOpaqueValue* less = (LLVMOpaqueValue*)0;
    LLVMOpaqueValue* greater = (LLVMOpaqueValue*)0;
    if (type_is_float(type_id)) {
        less = LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOLT, left, right, "compare_less");
        greater = LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOGT, left, right, "compare_greater");
    } else {
        bool unsigned_order = type_id == TYPE_BOOL || type_id == TYPE_CHAR
            || type_is_unsigned_integer(type_id);
        LLVMIntPredicate less_predicate = unsigned_order
            ? LLVMIntPredicate.LLVMIntULT : LLVMIntPredicate.LLVMIntSLT;
        LLVMIntPredicate greater_predicate = unsigned_order
            ? LLVMIntPredicate.LLVMIntUGT : LLVMIntPredicate.LLVMIntSGT;
        less = LLVMBuildICmp(ctx.builder, less_predicate, left, right, "compare_less");
        greater = LLVMBuildICmp(ctx.builder, greater_predicate, left, right, "compare_greater");
    }

    LLVMOpaqueType* result_type = LLVMInt32TypeInContext(ctx.ctx);
    LLVMOpaqueValue* negative_one = LLVMConstInt(result_type, (u64)-1, 1);
    LLVMOpaqueValue* one = LLVMConstInt(result_type, 1, 0);
    LLVMOpaqueValue* zero = LLVMConstInt(result_type, 0, 0);
    LLVMOpaqueValue* nonnegative = LLVMBuildSelect(ctx.builder, greater, one, zero, "compare_nonnegative");
    return LLVMBuildSelect(ctx.builder, less, negative_one, nonnegative, "compare_result");
}

str llvm_expr_kind_name(ExprKind kind) {
    if (kind == ExprKind.Literal) { return "literal"; }
    if (kind == ExprKind.Var) { return "variable"; }
    if (kind == ExprKind.Unary) { return "unary"; }
    if (kind == ExprKind.Binary) { return "binary"; }
    if (kind == ExprKind.Call) { return "call"; }
    if (kind == ExprKind.Launch) { return "launch"; }
    if (kind == ExprKind.Wait) { return "wait"; }
    if (kind == ExprKind.MethodCall) { return "method call"; }
    if (kind == ExprKind.Field) { return "field"; }
    if (kind == ExprKind.Index) { return "index"; }
    if (kind == ExprKind.Slice) { return "slice"; }
    if (kind == ExprKind.Cast) { return "cast"; }
    if (kind == ExprKind.Move) { return "move"; }
    if (kind == ExprKind.Ternary) { return "ternary"; }
    if (kind == ExprKind.Block) { return "block"; }
    if (kind == ExprKind.UnwrapOr) { return "unwrap-or"; }
    if (kind == ExprKind.Match) { return "match"; }
    if (kind == ExprKind.Asm) { return "asm"; }
    if (kind == ExprKind.SizeOf) { return "sizeof"; }
    if (kind == ExprKind.AlignOf) { return "alignof"; }
    if (kind == ExprKind.ArrayLit) { return "array literal"; }
    if (kind == ExprKind.Format) { return "format"; }
    if (kind == ExprKind.Fprint) { return "fprint"; }
    if (kind == ExprKind.MemoryBuiltin) { return "memory builtin"; }
    if (kind == ExprKind.Hash) { return "hash"; }
    if (kind == ExprKind.DropInPlace) { return "drop-in-place"; }
    if (kind == ExprKind.Assert) { return "assert"; }
    if (kind == ExprKind.StructLit) { return "struct literal"; }
    return "unknown";
}

LLVMOpaqueValue* llvm_launch_callee(LlvmContext* ctx, AstExpr* call, AstExpr* callee) {
    if (callee.kind != ExprKind.Var) {
        ctx.note_unresolved("launch-callee", "must be a named function");
        return (LLVMOpaqueValue*)0;
    }
    str name = ctx.names.get(callee.aux);
    LLVMOpaqueValue* fn = (LLVMOpaqueValue*)0;
    if (call.generic_args_count > 0) {
        Vec<u32> generic_ids = Vec<u32>.new();
        i64 i = 0;
        while (i < (i64)call.generic_args_count) {
            generic_ids.push(ctx.types.resolve_subst(
                ctx.pool.generic_type_args.get((i64)call.generic_args_start + i)));
            i += 1;
        }
        fn = mono_ensure_free_function(ctx, name, &generic_ids, call.aux);
        generic_ids.drop();
    } else {
        Vec<u32> actual_types = Vec<u32>.new();
        Vec<bool> numeric_literals = Vec<bool>.new();
        Vec<u32> inferred_ids = Vec<u32>.new();
        i64 i = 0;
        while (i < (i64)call.aux) {
            u32 arg_id = ctx.pool.args.get((i64)call.inner1 + i);
            u32 arg_type = llvm_expr_type(ctx, arg_id);
            actual_types.push(arg_type);
            numeric_literals.push(ctx.pool.get_expr(arg_id).kind == ExprKind.Literal
                && type_is_numeric(arg_type));
            i += 1;
        }
        if (mono_infer_free_function_args(ctx, name, call.aux,
                &actual_types, &numeric_literals, &inferred_ids)) {
            fn = mono_ensure_free_function(ctx, name, &inferred_ids, call.aux);
        }
        inferred_ids.drop();
        numeric_literals.drop();
        actual_types.drop();
    }
    if (fn == (LLVMOpaqueValue*)0 && call.resolved_callee_id != 0) {
        fn = LLVMGetNamedFunction(ctx.module,
            ctx.names.get(call.resolved_callee_id - 1));
    }
    if (fn == (LLVMOpaqueValue*)0) {
        String link_name = item_extern_link_name(ctx.root, name);
        if (link_name.len() > 0) {
            fn = LLVMGetNamedFunction(ctx.module, link_name.to_str());
        }
        link_name.drop();
    }
    if (fn == (LLVMOpaqueValue*)0) {
        SyntaxNode* declaration = find_function_by_name_and_arity(ctx.root, name, (i64)call.aux);
        if (declaration != (SyntaxNode*)0
            && typecheck_has_free_overloads(ctx.types, ctx.root, name)) {
            String symbol = typecheck_overloaded_free_symbol(ctx.types, name, declaration);
            fn = LLVMGetNamedFunction(ctx.module, symbol.to_str());
            symbol.drop();
        } else {
            fn = LLVMGetNamedFunction(ctx.module, name);
        }
    }
    if (fn == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("launch-function", name);
    }
    return fn;
}

LLVMOpaqueValue* llvm_emit_launch(LlvmContext* ctx, u32 expr_id) {
    AstExpr* launch_expr = ctx.pool.get_expr(expr_id);
    AstExpr* call = ctx.pool.get_expr(launch_expr.inner0);
    if (call.kind != ExprKind.Call) {
        ctx.note_unresolved("launch-operand", "expected a function call");
        return (LLVMOpaqueValue*)0;
    }
    AstExpr* callee_expr = ctx.pool.get_expr(call.inner0);
    LLVMOpaqueValue* callee = llvm_launch_callee(ctx, call, callee_expr);
    if (callee == (LLVMOpaqueValue*)0) {
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueType* fn_type = LLVMGlobalGetValueType(callee);
    u32 param_count = LLVMCountParamTypes(fn_type);
    if (param_count != call.aux) {
        ctx.note_unresolved("launch-arity", ctx.names.get(callee_expr.aux));
        return (LLVMOpaqueValue*)0;
    }
    Vec<LLVMOpaqueType*> param_types = Vec<LLVMOpaqueType*>.new();
    u32 param_index = 0;
    while (param_index < param_count) {
        param_types.push(LLVMTypeOf(LLVMGetParam(callee, param_index)));
        param_index += 1;
    }

    u32 task_type = ctx.types.resolve_subst(launch_expr.inferred_type);
    TypeEntry* task_entry = ctx.types.get(task_type);
    if (task_entry.kind != TypeKind.Named
        || strcmp(ctx.types.names.get(task_entry.name_id), "Task") != 0
        || task_entry.count != 1) {
        ctx.note_unresolved("launch-result", "expected Task<T>");
        param_types.drop();
        return (LLVMOpaqueValue*)0;
    }
    u32 result_type = ctx.types.resolve_subst(ctx.types.type_args.get(task_entry.inner));
    bool has_result = result_type != TYPE_VOID;
    u32 arg_base = has_result ? 1 : 0;
    Vec<LLVMOpaqueType*> pack_fields = Vec<LLVMOpaqueType*>.new();
    if (has_result) {
        pack_fields.push(llvm_lower_type(ctx.ctx, ctx.types, result_type));
    }
    i64 i = 0;
    while (i < (i64)param_count) {
        pack_fields.push(param_types.get(i));
        i += 1;
    }
    LLVMOpaqueType* pack_type = LLVMStructTypeInContext(
        ctx.ctx, pack_fields.data, (u32)pack_fields.len(), 0);
    pack_fields.drop();

    LLVMOpaqueValue* alloc_fn = LLVMGetNamedFunction(ctx.module, "mem_alloc_raw_impl");
    LLVMOpaqueValue* launch_fn = LLVMGetNamedFunction(ctx.module, "__silver_launch");
    if (alloc_fn == (LLVMOpaqueValue*)0 || launch_fn == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("launch-runtime",
            alloc_fn == (LLVMOpaqueValue*)0 ? "mem_alloc_raw_impl" : "__silver_launch");
        param_types.drop();
        return (LLVMOpaqueValue*)0;
    }
    u64 pack_size = LLVMABISizeOfType(ctx.target_data, pack_type);
    Vec<LLVMOpaqueValue*> alloc_args = Vec<LLVMOpaqueValue*>.new();
    alloc_args.push(LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), pack_size, 0));
    alloc_args.push(LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 16, 0));
    LLVMOpaqueValue* raw_pack = LLVMBuildCall2(ctx.builder,
        LLVMGlobalGetValueType(alloc_fn), alloc_fn, alloc_args.data,
        (u32)alloc_args.len(), "task.pack.alloc");
    alloc_args.drop();
    LLVMOpaqueType* ptr_type = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
    LLVMOpaqueValue* pack_ptr = LLVMBuildBitCast(ctx.builder, raw_pack, ptr_type, "task.pack");

    Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.new();
    Vec<u32> arg_types = Vec<u32>.new();
    Vec<u32> target_types = Vec<u32>.new();
    i = 0;
    while (i < (i64)call.aux) {
        u32 arg_id = ctx.pool.args.get((i64)call.inner1 + i);
        LLVMOpaqueValue* value = llvm_emit_expr(ctx, arg_id);
        if (value == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("launch-argument", "expression");
            value = LLVMConstNull(param_types.get(i));
        }
        args.push(value);
        arg_types.push(llvm_expr_type(ctx, arg_id));
        target_types.push(TYPE_UNKNOWN);
        i += 1;
    }
    llvm_prepare_call_args(ctx, fn_type, &args, &arg_types, &target_types,
                           ctx.names.get(callee_expr.aux));
    i = 0;
    while (i < (i64)call.aux) {
        LLVMOpaqueValue* slot = LLVMBuildStructGEP2(ctx.builder, pack_type, pack_ptr,
            arg_base + (u32)i, "task.pack.arg");
        LLVMBuildStore(ctx.builder, args.get(i), slot);
        llvm_clear_transferred_arg(ctx, fn_type, i, ctx.pool.args.get((i64)call.inner1 + i));
        i += 1;
    }
    args.drop();
    target_types.drop();

    LLVMOpaqueBasicBlock* parent_block = LLVMGetInsertBlock(ctx.builder);
    String trampoline_name = String.from_str("__silver_launch_tramp_");
    u8 id_buffer[24];
    i64 id_length = itoa(ctx.launch_trampoline_count, &id_buffer[0]);
    trampoline_name.push_bytes(&id_buffer[0], id_length);
    ctx.launch_trampoline_count += 1;
    Vec<LLVMOpaqueType*> trampoline_args = Vec<LLVMOpaqueType*>.new();
    trampoline_args.push(LLVMInt64TypeInContext(ctx.ctx));
    LLVMOpaqueType* trampoline_type = LLVMFunctionType(
        LLVMVoidTypeInContext(ctx.ctx), trampoline_args.data,
        (u32)trampoline_args.len(), 0);
    trampoline_args.drop();
    LLVMOpaqueValue* trampoline = LLVMAddFunction(
        ctx.module, trampoline_name.to_str(), trampoline_type);
    trampoline_name.drop();
    LLVMOpaqueBasicBlock* trampoline_block = LLVMAppendBasicBlockInContext(
        ctx.ctx, trampoline, "entry");
    LLVMPositionBuilderAtEnd(ctx.builder, trampoline_block);
    LLVMOpaqueValue* packed_i64 = LLVMGetParam(trampoline, 0);
    LLVMOpaqueValue* packed = LLVMBuildIntToPtr(ctx.builder, packed_i64, ptr_type,
                                               "task.pack.ptr");
    Vec<LLVMOpaqueValue*> trampoline_values = Vec<LLVMOpaqueValue*>.new();
    i = 0;
    while (i < (i64)param_count) {
        LLVMOpaqueValue* slot = LLVMBuildStructGEP2(ctx.builder, pack_type, packed,
            arg_base + (u32)i, "task.trampoline.arg");
        trampoline_values.push(LLVMBuildLoad2(ctx.builder, param_types.get(i), slot,
                                              "task.trampoline.value"));
        i += 1;
    }
    LLVMOpaqueValue* result = LLVMBuildCall2(ctx.builder, fn_type, callee,
        trampoline_values.data, (u32)trampoline_values.len(),
        has_result ? "task.result" : "");
    if (has_result) {
        LLVMOpaqueValue* result_slot = LLVMBuildStructGEP2(
            ctx.builder, pack_type, packed, 0, "task.result.slot");
        LLVMBuildStore(ctx.builder, result, result_slot);
    }
    LLVMBuildRetVoid(ctx.builder);
    trampoline_values.drop();
    LLVMPositionBuilderAtEnd(ctx.builder, parent_block);

    Vec<LLVMOpaqueValue*> launch_args = Vec<LLVMOpaqueValue*>.new();
    launch_args.push(trampoline);
    launch_args.push(pack_ptr);
    LLVMOpaqueValue* handle = LLVMBuildCall2(ctx.builder,
        LLVMGlobalGetValueType(launch_fn), launch_fn, launch_args.data,
        (u32)launch_args.len(), "task.handle");
    launch_args.drop();

    LLVMOpaqueValue* spawn_failed = LLVMBuildICmp(ctx.builder,
        LLVMIntPredicate.LLVMIntEQ, handle,
        LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 0, 0), "task.spawn.failed");
    LLVMOpaqueBasicBlock* failed_block = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "task.spawn.cleanup");
    LLVMOpaqueBasicBlock* ready_block = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "task.spawn.ready");
    LLVMBuildCondBr(ctx.builder, spawn_failed, failed_block, ready_block);

    LLVMPositionBuilderAtEnd(ctx.builder, failed_block);
    i = 0;
    while (i < (i64)call.aux) {
        u32 arg_type = ctx.types.resolve_subst(arg_types.get(i));
        if (llvm_type_needs_tracking(ctx, arg_type)) {
            LLVMOpaqueValue* slot = LLVMBuildStructGEP2(ctx.builder, pack_type,
                pack_ptr, arg_base + (u32)i, "task.failed.arg");
            llvm_emit_value_drop_at_ptr(ctx, slot, arg_type);
        }
        i += 1;
    }
    LLVMOpaqueValue* free_fn = LLVMGetNamedFunction(ctx.module, "mem_free_raw_impl");
    if (free_fn == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("launch-runtime", "mem_free_raw_impl");
    } else {
        Vec<LLVMOpaqueValue*> free_args = Vec<LLVMOpaqueValue*>.new();
        free_args.push(raw_pack);
        LLVMBuildCall2(ctx.builder, LLVMGlobalGetValueType(free_fn), free_fn,
            free_args.data, (u32)free_args.len(), "");
        free_args.drop();
    }
    LLVMBuildBr(ctx.builder, ready_block);
    LLVMPositionBuilderAtEnd(ctx.builder, ready_block);

    param_types.drop();
    arg_types.drop();
    return handle;
}

LLVMOpaqueValue* llvm_emit_wait(LlvmContext* ctx, u32 expr_id) {
    AstExpr* wait_expr = ctx.pool.get_expr(expr_id);
    u32 task_type = ctx.types.resolve_subst(llvm_expr_type(ctx, wait_expr.inner0));
    TypeEntry* task_entry = ctx.types.get(task_type);
    if (task_entry.kind != TypeKind.Named
        || strcmp(ctx.types.names.get(task_entry.name_id), "Task") != 0
        || task_entry.count != 1) {
        ctx.note_unresolved("wait-type", "expected Task<T>");
        return (LLVMOpaqueValue*)0;
    }
    u32 result_type = ctx.types.resolve_subst(ctx.types.type_args.get(task_entry.inner));
    LLVMOpaqueValue* handle = llvm_emit_expr(ctx, wait_expr.inner0);
    LLVMOpaqueValue* wait_fn = LLVMGetNamedFunction(ctx.module, "__silver_wait_done");
    LLVMOpaqueValue* free_fn = LLVMGetNamedFunction(ctx.module, "mem_free_raw_impl");
    if (handle == (LLVMOpaqueValue*)0 || wait_fn == (LLVMOpaqueValue*)0
        || free_fn == (LLVMOpaqueValue*)0) {
        ctx.note_unresolved("wait-runtime", wait_fn == (LLVMOpaqueValue*)0
            ? "__silver_wait_done" : "mem_free_raw_impl");
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueValue* zero = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 0, 0);
    LLVMOpaqueValue* is_null = LLVMBuildICmp(ctx.builder,
        LLVMIntPredicate.LLVMIntEQ, handle, zero, "task.null");
    LLVMOpaqueBasicBlock* null_block = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "task.wait.null");
    LLVMOpaqueBasicBlock* join_block = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "task.wait.join");
    LLVMOpaqueBasicBlock* after_block = LLVMAppendBasicBlockInContext(
        ctx.ctx, ctx.current_fn, "task.wait.after");
    LLVMBuildCondBr(ctx.builder, is_null, null_block, join_block);

    LLVMPositionBuilderAtEnd(ctx.builder, null_block);
    LLVMOpaqueType* result_llvm_type = result_type == TYPE_VOID
        ? LLVMVoidTypeInContext(ctx.ctx)
        : llvm_lower_type(ctx.ctx, ctx.types, result_type);
    LLVMOpaqueValue* null_result = result_type == TYPE_VOID
        ? (LLVMOpaqueValue*)0 : LLVMConstNull(result_llvm_type);
    LLVMBuildBr(ctx.builder, after_block);

    LLVMPositionBuilderAtEnd(ctx.builder, join_block);
    LLVMOpaqueType* ptr_type = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
    Vec<LLVMOpaqueValue*> wait_args = Vec<LLVMOpaqueValue*>.new();
    wait_args.push(handle);
    LLVMOpaqueValue* pack = LLVMBuildCall2(ctx.builder,
        LLVMGlobalGetValueType(wait_fn), wait_fn, wait_args.data,
        (u32)wait_args.len(), "task.result.pack");
    wait_args.drop();
    LLVMOpaqueValue* joined_result = (LLVMOpaqueValue*)0;
    if (result_type != TYPE_VOID) {
        Vec<LLVMOpaqueType*> result_fields = Vec<LLVMOpaqueType*>.new();
        result_fields.push(result_llvm_type);
        LLVMOpaqueType* result_pack_type = LLVMStructTypeInContext(
            ctx.ctx, result_fields.data, (u32)result_fields.len(), 0);
        result_fields.drop();
        LLVMOpaqueValue* result_pack = LLVMBuildBitCast(ctx.builder, pack, ptr_type,
                                                        "task.result.ptr");
        LLVMOpaqueValue* result_slot = LLVMBuildStructGEP2(ctx.builder,
            result_pack_type, result_pack, 0, "task.result.slot");
        joined_result = LLVMBuildLoad2(ctx.builder, result_llvm_type, result_slot,
                                       "task.result.value");
    }
    Vec<LLVMOpaqueValue*> free_args = Vec<LLVMOpaqueValue*>.new();
    free_args.push(pack);
    LLVMBuildCall2(ctx.builder, LLVMGlobalGetValueType(free_fn), free_fn,
                   free_args.data, (u32)free_args.len(), "");
    free_args.drop();
    LLVMBuildBr(ctx.builder, after_block);
    LLVMPositionBuilderAtEnd(ctx.builder, after_block);
    if (result_type == TYPE_VOID) {
        return (LLVMOpaqueValue*)0;
    }
    LLVMOpaqueValue* phi = LLVMBuildPhi(ctx.builder, result_llvm_type, "task.wait.result");
    Vec<LLVMOpaqueValue*> incoming_values = Vec<LLVMOpaqueValue*>.new();
    incoming_values.push(null_result);
    incoming_values.push(joined_result);
    Vec<LLVMOpaqueBasicBlock*> incoming_blocks = Vec<LLVMOpaqueBasicBlock*>.new();
    incoming_blocks.push(null_block);
    incoming_blocks.push(join_block);
    LLVMAddIncoming(phi, incoming_values.data, incoming_blocks.data,
                    (u32)incoming_values.len());
    incoming_values.drop();
    incoming_blocks.drop();
    return phi;
}

bool llvm_block_result_aliases_local(LlvmContext* ctx, LLVMOpaqueValue* value,
                                     u32 result_type, i64 drop_mark) {
    if (value == (LLVMOpaqueValue*)0) { return false; }
    TypeEntry* entry = ctx.types.get(ctx.types.resolve_subst(result_type));
    if (entry == (TypeEntry*)0
        || (entry.kind != TypeKind.Pointer && entry.kind != TypeKind.Reference
            && entry.kind != TypeKind.Str)) {
        return false;
    }
    i64 i = drop_mark;
    while (i < ctx.locals.len()) {
        LlvmLocal* local = ctx.locals.get_ptr(i);
        if (local.ptr == value) { return true; }
        i += 1;
    }
    return false;
}

LLVMOpaqueValue* llvm_emit_expr(LlvmContext* ctx, u32 expr_id) {
    if (expr_id == 0) { return (LLVMOpaqueValue*)0; }
    AstExpr* expr = ctx.pool.get_expr(expr_id);
    if (expr.kind == ExprKind.Launch) { return llvm_emit_launch(ctx, expr_id); }
    if (expr.kind == ExprKind.Wait) { return llvm_emit_wait(ctx, expr_id); }
    if (expr.kind == ExprKind.Block) {
        u32 block_start = expr.inner0;
        u32 block_count = expr.inner1;
        u32 result_expr = expr.aux;
        u32 result_type = expr.inferred_type;
        ctx.push_scope();
        i64 drop_mark = llvm_current_drop_mark(ctx);
        i64 defer_mark = ctx.deferred_statements.len();
        i64 i = 0;
        while (i < (i64)block_count && !ctx.is_terminated()) {
            u32 stmt_id = ctx.pool.block_stmts.get((i64)block_start + i);
            llvm_emit_stmt(ctx, stmt_id);
            i += 1;
        }
        LLVMOpaqueValue* value = (LLVMOpaqueValue*)0;
        if (!ctx.is_terminated()) {
            value = llvm_emit_expr(ctx, result_expr);
            if (value == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("block-expression", "result");
            }
            bool borrowed_local = llvm_block_result_aliases_local(
                ctx, value, result_type, drop_mark);
            if (borrowed_local) {
                ctx.note_unresolved("block-result-borrow",
                    "result aliases block-local storage");
            } else {
                if (llvm_type_needs_tracking(ctx, result_type)) {
                    llvm_clear_place_drops(ctx, result_expr);
                }
                llvm_emit_defers_above(ctx, defer_mark);
                if (!ctx.is_terminated()) {
                    llvm_emit_drops_above(ctx, drop_mark);
                }
            }
        }
        ctx.pop_scope();
        return value;
    }
    if (expr.kind == ExprKind.Assert) {
        if (expr.aux == 0) {
            return (LLVMOpaqueValue*)0;
        }
        if (expr.span.file <= 0 || expr.span.file > ctx.source_paths.len()) {
            ctx.note_unresolved("assert-source", "file path");
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueValue* condition = llvm_emit_expr(ctx, expr.inner0);
        LLVMOpaqueValue* failure = LLVMGetNamedFunction(ctx.module, "__silver_assert_failed");
        if (condition == (LLVMOpaqueValue*)0 || failure == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("assert-runtime", "__silver_assert_failed");
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueBasicBlock* fail_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "assert.fail");
        LLVMOpaqueBasicBlock* continue_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "assert.continue");
        LLVMBuildCondBr(ctx.builder, condition, continue_bb, fail_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, fail_bb);
        LLVMOpaqueValue* message = llvm_emit_expr(ctx, expr.inner1);
        u32 message_type = llvm_expr_type(ctx, expr.inner1);
        if (message != (LLVMOpaqueValue*)0 && message_type != TYPE_STR
            && strcmp(ctx.types.type_name(message_type), "String") == 0) {
            message = LLVMBuildExtractValue(ctx.builder, message, 0, "assert.message.data");
        }
        if (message == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("assert-message", "expression");
            LLVMBuildUnreachable(ctx.builder);
            LLVMPositionBuilderAtEnd(ctx.builder, continue_bb);
            return (LLVMOpaqueValue*)0;
        }
        String* source_path = ctx.source_paths.get_ptr(expr.span.file - 1);
        LLVMOpaqueValue* file_value = LLVMBuildGlobalStringPtr(ctx.builder, source_path.to_str(), "assert.file");
        LLVMOpaqueValue* line_value = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx),
            (u64)expr.span.start_line, 0);
        Vec<LLVMOpaqueValue*> args = Vec<LLVMOpaqueValue*>.with_capacity(3);
        args.push(file_value);
        args.push(line_value);
        args.push(message);
        LLVMOpaqueType* failure_type = LLVMGlobalGetValueType(failure);
        Vec<u32> source_types = Vec<u32>.new();
        Vec<u32> target_types = Vec<u32>.new();
        llvm_prepare_call_args(ctx, failure_type, &args, &source_types, &target_types,
                              "__silver_assert_failed");
        source_types.drop();
        target_types.drop();
        LLVMBuildCall2(ctx.builder, failure_type, failure, args.data, 3, "");
        args.drop();
        LLVMBuildUnreachable(ctx.builder);
        LLVMPositionBuilderAtEnd(ctx.builder, continue_bb);
        return (LLVMOpaqueValue*)0;
    }
    if (expr.kind == ExprKind.Format) {
        return llvm_emit_format(ctx, expr);
    }
    if (expr.kind == ExprKind.Fprint) {
        return llvm_emit_fprint(ctx, expr);
    }
    if (expr.kind == ExprKind.Hash) {
        return llvm_emit_hash(ctx, expr);
    }
    if (expr.kind == ExprKind.StructLit) {
        return llvm_emit_struct_lit(ctx, expr);
    }
    if (expr.kind == ExprKind.Slice) {
        return llvm_emit_slice(ctx, expr_id);
    }

    if (expr.kind == ExprKind.SourceLocation) {
        if (expr.aux == 1) {
            return LLVMConstInt(llvm_lower_type(ctx.ctx, ctx.types, TYPE_U32),
                (u64)expr.span.start_line, 0);
        }
        if (expr.aux == 2) {
            return LLVMConstInt(llvm_lower_type(ctx.ctx, ctx.types, TYPE_U32),
                (u64)expr.span.start_col, 0);
        }
        if (expr.aux == 3) {
            if (expr.span.file <= 0 || expr.span.file > ctx.source_paths.len()) {
                ctx.note_unresolved("source-location", "file path");
                return (LLVMOpaqueValue*)0;
            }
            String* source_path = ctx.source_paths.get_ptr(expr.span.file - 1);
            return LLVMBuildGlobalStringPtr(ctx.builder, source_path.to_str(),
                "source.file");
        }
    }

    if (expr.kind == ExprKind.Asm) {
        return llvm_emit_asm(ctx, expr_id);
    }

    if (expr.kind == ExprKind.Literal) {
        if (expr.inferred_type == TYPE_BOOL) {
            str text = ctx.names.get(expr.inner0);
            u64 b_val = (strcmp(text, "true") == 0) ? 1 : 0;
            return LLVMConstInt(LLVMInt1TypeInContext(ctx.ctx), b_val, 0);
        }
        if (expr.inferred_type == TYPE_STR) {
            str text = ctx.names.get(expr.inner0);
            String unescaped = unescape_string_literal(text);
            LLVMOpaqueValue* str_ptr = LLVMBuildGlobalStringPtr(ctx.builder, unescaped.to_str(), "str");
            unescaped.drop();
            return str_ptr;
        }
        if (expr.inferred_type == TYPE_F32 || expr.inferred_type == TYPE_F64) {
            str text = ctx.names.get(expr.inner0);
            LLVMOpaqueType* ty = llvm_lower_type(ctx.ctx, ctx.types, expr.inferred_type);
            return llvm_const_real_literal(ty, text);
        }
        str text = ctx.names.get(expr.inner0);
        LLVMOpaqueType* ty = llvm_lower_type(ctx.ctx, ctx.types, expr.inferred_type);
        if (expr.inferred_type == TYPE_CHAR) {
            return LLVMConstInt(ty, (u64)parse_char_literal(text), 0);
        }
        i64 n = parse_int_literal(text);
        if ((expr.inferred_type == TYPE_I32 || expr.inferred_type == TYPE_UNKNOWN || expr.inferred_type == 0)
            && (n > 2147483647 || n < -2147483648)) {
            ty = LLVMInt64TypeInContext(ctx.ctx);
        }
        return llvm_const_int_literal(ty, text, false);
    }

    if (expr.kind == ExprKind.Var) {
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0) {
            LLVMOpaqueType* ty = llvm_lower_type(ctx.ctx, ctx.types, local.type_id);
            if (LLVMGetTypeKind(ty) == (u32)11) {
                return local.ptr;
            }
            return LLVMBuildLoad2(ctx.builder, ty, local.ptr, "load_var");
        }
        str name = ctx.names.get(expr.aux);
        LLVMOpaqueValue* g_val = LLVMGetNamedGlobal(ctx.module, name);
        if (g_val != (LLVMOpaqueValue*)0) {
            LLVMOpaqueType* g_ty = LLVMGlobalGetValueType(g_val);
            if (LLVMGetTypeKind(g_ty) == (u32)11) {
                return g_val;
            }
            return LLVMBuildLoad2(ctx.builder, g_ty, g_val, "load_global");
        }
        if (strlen(name) > 0 && name[0] >= (u8)65 && name[0] <= (u8)90) {
            SyntaxNode* enum_item = (SyntaxNode*)0;
            if (find_variant_enum(ctx.root, name, &enum_item)) {
                SyntaxNode* enum_id = item_identifier(enum_item);
                if (enum_id != (SyntaxNode*)0) {
                    i64 tag = 0;
                    i64 arity = 0;
                    if (enum_variant_info(ctx.root, enum_id.text, name, &tag, &arity) && arity == 0) {
                        // Variant values are {i16 tag, ...} structs in every
                        // position; Binary ==/!= compares extracted tags.
                        LLVMOpaqueValue* built = llvm_emit_enum_build(ctx, enum_id.text, name, 0, 0);
                        if (built == (LLVMOpaqueValue*)0) {
                            ctx.note_unresolved("enum-variant", name);
                        }
                        return built;
                    }
                }
            }
        }
        LLVMOpaqueValue* fn_val = LLVMGetNamedFunction(ctx.module, name);
        if (fn_val != (LLVMOpaqueValue*)0) {
            return fn_val;
        }
        return (LLVMOpaqueValue*)0;
    }

    if (expr.kind == ExprKind.Move) {
        // Moving out transfers ownership: clear the source drops first so
        // scope exit does not free what was moved. Clearing is idempotent
        // and a no-op for unflagged sources. A payload binding moved out of
        // a match arm additionally releases its scrutinee side.
        if (expr.inner0 != 0) {
            llvm_clear_place_drops(ctx, expr.inner0);
            llvm_clear_scrutinee_source(ctx, expr.inner0);
        } else if (expr.aux != 0) {
            llvm_clear_local_drops(ctx, expr.aux);
        }
        if (expr.inner0 != 0) {
            return llvm_emit_expr(ctx, expr.inner0);
        }
        LlvmLocal* local = ctx.find_local(expr.aux);
        if (local != (LlvmLocal*)0) {
            LLVMOpaqueType* ty = llvm_lower_type(ctx.ctx, ctx.types, local.type_id);
            return LLVMBuildLoad2(ctx.builder, ty, local.ptr, "load_move");
        }
        return (LLVMOpaqueValue*)0;
    }

    if (expr.kind == ExprKind.Unary) {
        if (expr.aux == (u32)TokenKind.BitwiseAnd) {
            u32 inner_type = llvm_lvalue_type(ctx, expr.inner0);
            TypeEntry* inner_entry = ctx.types.get(inner_type);
            if (inner_entry.kind == TypeKind.Reference) {
                return llvm_emit_expr(ctx, expr.inner0);
            }
            return llvm_emit_lvalue(ctx, expr.inner0);
        }
        if (expr.aux == (u32)TokenKind.Star) {
            LLVMOpaqueValue* ptr = llvm_emit_expr(ctx, expr.inner0);
            if (ptr == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            u32 elem_type_id = llvm_expr_type(ctx, expr_id);
            if (elem_type_id == TYPE_UNKNOWN || llvm_type_has_unresolved(ctx, elem_type_id, 0)) {
                ctx.note_unresolved("deref-type", "unresolved");
                return (LLVMOpaqueValue*)0;
            }
            LLVMOpaqueType* elem_ty = llvm_lower_type(ctx.ctx, ctx.types, elem_type_id);
            return LLVMBuildLoad2(ctx.builder, elem_ty, ptr, "load_deref");
        }
        if (expr.aux == (u32)TokenKind.Minus) {
            LLVMOpaqueValue* val = llvm_emit_expr(ctx, expr.inner0);
            if (val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            u32 v_kind = LLVMGetTypeKind(LLVMTypeOf(val));
            if (v_kind == (u32)2 || v_kind == (u32)3 || expr.inferred_type == TYPE_F32 || expr.inferred_type == TYPE_F64) {
                return LLVMBuildFNeg(ctx.builder, val, "fneg");
            }
            return LLVMBuildNeg(ctx.builder, val, "neg");
        }
        if (expr.aux == (u32)TokenKind.Increment || expr.aux == (u32)TokenKind.Decrement) {
            LLVMOpaqueValue* ptr = llvm_emit_lvalue(ctx, expr.inner0);
            if (ptr == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("increment-target", "expression");
                return (LLVMOpaqueValue*)0;
            }
            u32 value_type = llvm_lvalue_type(ctx, expr.inner0);
            LLVMOpaqueType* value_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, value_type);
            LLVMOpaqueValue* previous = LLVMBuildLoad2(ctx.builder, value_llvm_type,
                ptr, "postfix.load");
            bool floating = type_is_float(value_type);
            LLVMOpaqueValue* one = floating
                ? LLVMConstRealOfString(value_llvm_type, "1.0")
                : LLVMConstInt(value_llvm_type, 1, 0);
            LLVMOpaqueValue* updated = (LLVMOpaqueValue*)0;
            if (expr.aux == (u32)TokenKind.Increment) {
                updated = floating
                    ? LLVMBuildFAdd(ctx.builder, previous, one, "postfix.increment")
                    : LLVMBuildAdd(ctx.builder, previous, one, "postfix.increment");
            } else {
                updated = floating
                    ? LLVMBuildFSub(ctx.builder, previous, one, "postfix.decrement")
                    : LLVMBuildSub(ctx.builder, previous, one, "postfix.decrement");
            }
            LLVMBuildStore(ctx.builder, updated, ptr);
            return previous;
        }
        if (expr.aux == (u32)TokenKind.Not || expr.aux == (u32)TokenKind.BitwiseNot) {
            LLVMOpaqueValue* val = llvm_emit_expr(ctx, expr.inner0);
            if (val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            return LLVMBuildNot(ctx.builder, val, "not");
        }
    }

    if (expr.kind == ExprKind.Binary) {
        u32 op = expr.aux;
        u32 lhs_id = expr.inner0;
        u32 rhs_id = expr.inner1;
        str method_name = llvm_binary_operator_method(op);
        u32 lhs_type = ctx.types.resolve_subst(llvm_expr_type(ctx, lhs_id));
        TypeEntry* lhs_entry = ctx.types.get(lhs_type);
        bool string_ordering = lhs_entry.kind == TypeKind.Named
            && strcmp(ctx.types.type_name(lhs_type), "String") == 0
            && (op == (u32)TokenKind.Less || op == (u32)TokenKind.Greater
                || op == (u32)TokenKind.LessEqual || op == (u32)TokenKind.GreaterEqual);
        if (string_ordering) {
            AstExpr compare_call;
            compare_call.kind = ExprKind.MethodCall;
            compare_call.inner0 = lhs_id;
            compare_call.inner1 = (u32)ctx.pool.args.len();
            compare_call.aux = ctx.names.intern("compare");
            compare_call.span = expr.span;
            compare_call.inferred_type = TYPE_I32;
            compare_call.generic_args_start = 0;
            compare_call.generic_args_count = 0;
            compare_call.resolved_callee_id = 0;
            AstExpr other_ref;
            other_ref.kind = ExprKind.Unary;
            other_ref.inner0 = rhs_id;
            other_ref.inner1 = 0;
            other_ref.aux = (u32)TokenKind.BitwiseAnd;
            other_ref.span = expr.span;
            other_ref.inferred_type = ctx.types.get_pointer(
                llvm_expr_type(ctx, rhs_id), false);
            other_ref.generic_args_start = 0;
            other_ref.generic_args_count = 0;
            other_ref.resolved_callee_id = 0;
            u32 other_ref_id = (u32)ctx.pool.exprs.len();
            ctx.pool.exprs.push(move other_ref);
            ctx.pool.args.push((u32)1);
            ctx.pool.args.push(other_ref_id);
            ctx.pool.exprs.push(move compare_call);
            LLVMOpaqueValue* ordering = llvm_emit_expr(ctx, (u32)(ctx.pool.exprs.len() - 1));
            if (ordering == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            LLVMIntPredicate predicate = LLVMIntPredicate.LLVMIntSLT;
            if (op == (u32)TokenKind.Greater) { predicate = LLVMIntPredicate.LLVMIntSGT; }
            else if (op == (u32)TokenKind.LessEqual) { predicate = LLVMIntPredicate.LLVMIntSLE; }
            else if (op == (u32)TokenKind.GreaterEqual) { predicate = LLVMIntPredicate.LLVMIntSGE; }
            return LLVMBuildICmp(ctx.builder, predicate, ordering,
                                 LLVMConstInt(LLVMTypeOf(ordering), 0, 0), "string_order");
        }
        u32 rhs_type = ctx.types.resolve_subst(llvm_expr_type(ctx, rhs_id));
        TypeEntry* rhs_entry = ctx.types.get(rhs_type);
        bool is_equality = op == (u32)TokenKind.Equal || op == (u32)TokenKind.NotEqual;
        bool lhs_slice_u8 = lhs_entry.kind == TypeKind.Named
            && strcmp(ctx.types.names.get(lhs_entry.name_id), "Slice") == 0
            && lhs_entry.count == 1
            && ctx.types.resolve_subst(ctx.types.type_args.get(lhs_entry.inner)) == TYPE_U8;
        bool rhs_slice_u8 = rhs_entry.kind == TypeKind.Named
            && strcmp(ctx.types.names.get(rhs_entry.name_id), "Slice") == 0
            && rhs_entry.count == 1
            && ctx.types.resolve_subst(ctx.types.type_args.get(rhs_entry.inner)) == TYPE_U8;
        bool lhs_string = lhs_entry.kind == TypeKind.Named
            && strcmp(ctx.types.names.get(lhs_entry.name_id), "String") == 0;
        bool rhs_string = rhs_entry.kind == TypeKind.Named
            && strcmp(ctx.types.names.get(rhs_entry.name_id), "String") == 0;
        str content_equality_method = "";
        bool content_equality_borrow_arg = false;
        if (is_equality && lhs_slice_u8 && rhs_slice_u8) {
            content_equality_method = "equals_slice";
        } else if (is_equality && lhs_slice_u8 && rhs_string) {
            content_equality_method = "equals_string";
            content_equality_borrow_arg = true;
        } else if (is_equality && lhs_string && rhs_slice_u8) {
            content_equality_method = "equals_slice";
        }
        if (strlen(content_equality_method) > 0) {
            u32 argument_id = rhs_id;
            if (content_equality_borrow_arg) {
                AstExpr other_ref;
                other_ref.kind = ExprKind.Unary;
                other_ref.inner0 = rhs_id;
                other_ref.inner1 = 0;
                other_ref.aux = (u32)TokenKind.BitwiseAnd;
                other_ref.span = expr.span;
                other_ref.inferred_type = ctx.types.get_pointer(rhs_type, false);
                other_ref.generic_args_start = 0;
                other_ref.generic_args_count = 0;
                other_ref.resolved_callee_id = 0;
                ctx.pool.exprs.push(move other_ref);
                argument_id = (u32)(ctx.pool.exprs.len() - 1);
            }
            AstExpr equals_call;
            equals_call.kind = ExprKind.MethodCall;
            equals_call.inner0 = lhs_id;
            equals_call.inner1 = (u32)ctx.pool.args.len();
            equals_call.aux = ctx.names.intern(content_equality_method);
            equals_call.span = expr.span;
            equals_call.inferred_type = TYPE_BOOL;
            equals_call.generic_args_start = 0;
            equals_call.generic_args_count = 0;
            equals_call.resolved_callee_id = 0;
            ctx.pool.args.push((u32)1);
            ctx.pool.args.push(argument_id);
            ctx.pool.exprs.push(move equals_call);
            LLVMOpaqueValue* equal = llvm_emit_expr(ctx, (u32)(ctx.pool.exprs.len() - 1));
            if (equal == (LLVMOpaqueValue*)0 || op == (u32)TokenKind.Equal) { return equal; }
            return LLVMBuildNot(ctx.builder, equal, "slice_ne");
        }
        bool string_concat = op == (u32)TokenKind.Plus
            && lhs_entry.kind == TypeKind.Named
            && strcmp(ctx.types.type_name(lhs_type), "String") == 0
            && strcmp(ctx.types.type_name(rhs_type), "String") == 0;
        if (string_concat) {
            AstExpr concat_call;
            concat_call.kind = ExprKind.MethodCall;
            concat_call.inner0 = lhs_id;
            concat_call.inner1 = (u32)ctx.pool.args.len();
            concat_call.aux = ctx.names.intern("concat");
            concat_call.span = expr.span;
            concat_call.inferred_type = ctx.types.get_named("String");
            concat_call.generic_args_start = 0;
            concat_call.generic_args_count = 0;
            concat_call.resolved_callee_id = 0;
            ctx.pool.args.push((u32)1);
            ctx.pool.args.push(rhs_id);
            ctx.pool.exprs.push(move concat_call);
            return llvm_emit_expr(ctx, (u32)(ctx.pool.exprs.len() - 1));
        }
        if (strlen(method_name) > 0 && lhs_entry.kind == TypeKind.Named
            && ctx.find_struct_by_str(ctx.types.type_name(lhs_type)) != (LlvmStructDef*)0) {
            str lhs_name = ctx.types.type_name(lhs_type);
            bool string_equality = (op == (u32)TokenKind.Equal || op == (u32)TokenKind.NotEqual)
                && strcmp(lhs_name, "String") == 0;
            if (!string_equality) {
                AstExpr method_call;
                method_call.kind = ExprKind.MethodCall;
                method_call.inner0 = lhs_id;
                method_call.inner1 = (u32)ctx.pool.args.len();
                method_call.aux = ctx.names.intern(method_name);
                method_call.span = expr.span;
                method_call.inferred_type = expr.inferred_type;
                method_call.generic_args_start = 0;
                method_call.generic_args_count = 0;
                method_call.resolved_callee_id = 0;
                ctx.pool.args.push((u32)1);
                ctx.pool.args.push(rhs_id);
                ctx.pool.exprs.push(move method_call);
                return llvm_emit_expr(ctx, (u32)(ctx.pool.exprs.len() - 1));
            }
        }
        // Logical && / || short-circuit like stage0 (which has dedicated
        // LogicalAnd/LogicalOr ops). Eager bitwise emission evaluated guard
        // RHS unconditionally, tripping OOB aborts (Vec::get behind &&).
        if (op == (u32)TokenKind.And || op == (u32)TokenKind.Or) {
            LLVMOpaqueValue* lhs = llvm_emit_expr(ctx, expr.inner0);
            if (lhs == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            LLVMOpaqueType* i1_ty = LLVMInt1TypeInContext(ctx.ctx);
            if (LLVMTypeOf(lhs) != i1_ty) {
                lhs = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE, lhs, LLVMConstNull(LLVMTypeOf(lhs)), "logic_lhs_bool");
            }
            if (ctx.current_fn == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("logic", "no-function");
                return (LLVMOpaqueValue*)0;
            }
            LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, i1_ty, "logic_slot");
            LLVMOpaqueBasicBlock* rhs_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "logic_rhs");
            LLVMOpaqueBasicBlock* short_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "logic_short");
            LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "logic_merge");
            if (op == (u32)TokenKind.And) {
                LLVMBuildCondBr(ctx.builder, lhs, rhs_bb, short_bb);
            } else {
                LLVMBuildCondBr(ctx.builder, lhs, short_bb, rhs_bb);
            }
            LLVMPositionBuilderAtEnd(ctx.builder, short_bb);
            LLVMBuildStore(ctx.builder, LLVMConstInt(i1_ty, op == (u32)TokenKind.And ? 0 : 1, 0), slot);
            LLVMBuildBr(ctx.builder, merge_bb);
            LLVMPositionBuilderAtEnd(ctx.builder, rhs_bb);
            LLVMOpaqueValue* rhs = llvm_emit_expr(ctx, expr.inner1);
            if (rhs == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("logic-rhs", "expression");
                return (LLVMOpaqueValue*)0;
            }
            if (LLVMTypeOf(rhs) != i1_ty) {
                rhs = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE, rhs, LLVMConstNull(LLVMTypeOf(rhs)), "logic_rhs_bool");
            }
            LLVMBuildStore(ctx.builder, rhs, slot);
            LLVMBuildBr(ctx.builder, merge_bb);
            LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
            return LLVMBuildLoad2(ctx.builder, i1_ty, slot, "logic_val");
        }
        LLVMOpaqueValue* lhs = llvm_emit_expr(ctx, expr.inner0);
        LLVMOpaqueValue* rhs = llvm_emit_expr(ctx, expr.inner1);
        if (lhs == (LLVMOpaqueValue*)0 || rhs == (LLVMOpaqueValue*)0) {
            return (LLVMOpaqueValue*)0;
        }

        u32 l_kind = LLVMGetTypeKind(LLVMTypeOf(lhs));
        u32 r_kind = LLVMGetTypeKind(LLVMTypeOf(rhs));
        bool is_float = (l_kind == (u32)2 || l_kind == (u32)3 || r_kind == (u32)2 || r_kind == (u32)3
                         || expr.inferred_type == TYPE_F32 || expr.inferred_type == TYPE_F64);

        if (is_float) {
            if (l_kind == (u32)8) {
                u32 lt = llvm_expr_type(ctx, expr.inner0);
                if (!llvm_type_is_signed(ctx.types, lt)) {
                    lhs = LLVMBuildUIToFP(ctx.builder, lhs, LLVMTypeOf(rhs), "uitofp_l");
                } else {
                    lhs = LLVMBuildSIToFP(ctx.builder, lhs, LLVMTypeOf(rhs), "sitofp_l");
                }
            } else if (r_kind == (u32)8) {
                u32 rt = llvm_expr_type(ctx, expr.inner1);
                if (!llvm_type_is_signed(ctx.types, rt)) {
                    rhs = LLVMBuildUIToFP(ctx.builder, rhs, LLVMTypeOf(lhs), "uitofp_r");
                } else {
                    rhs = LLVMBuildSIToFP(ctx.builder, rhs, LLVMTypeOf(lhs), "sitofp_r");
                }
            }
            if (op == (u32)TokenKind.Plus) { return LLVMBuildFAdd(ctx.builder, lhs, rhs, "fadd"); }
            if (op == (u32)TokenKind.Minus) { return LLVMBuildFSub(ctx.builder, lhs, rhs, "fsub"); }
            if (op == (u32)TokenKind.Star) { return LLVMBuildFMul(ctx.builder, lhs, rhs, "fmul"); }
            if (op == (u32)TokenKind.Slash) { return LLVMBuildFDiv(ctx.builder, lhs, rhs, "fdiv"); }
            if (op == (u32)TokenKind.Equal) { return LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOEQ, lhs, rhs, "feq"); }
            if (op == (u32)TokenKind.NotEqual) { return LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealONE, lhs, rhs, "fne"); }
            if (op == (u32)TokenKind.Less) { return LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOLT, lhs, rhs, "flt"); }
            if (op == (u32)TokenKind.LessEqual) { return LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOLE, lhs, rhs, "fle"); }
            if (op == (u32)TokenKind.Greater) { return LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOGT, lhs, rhs, "fgt"); }
            if (op == (u32)TokenKind.GreaterEqual) { return LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOGE, lhs, rhs, "fge"); }
            return (LLVMOpaqueValue*)0;
        }

        AstExpr* lexpr = ctx.pool.get_expr(expr.inner0);
        AstExpr* rexpr = ctx.pool.get_expr(expr.inner1);
        u32 l_id = lexpr.inferred_type;
        u32 r_id = rexpr.inferred_type;
        if (l_id == TYPE_UNKNOWN || l_id == 0) {
            // Index/field operands often infer UNKNOWN (frontend Field
            // inference is validation-only); resolve structurally so
            // String-typed comparisons still route to strcmp below
            // instead of emitting invalid struct icmp.
            l_id = llvm_expr_type(ctx, expr.inner0);
        }
        if (r_id == TYPE_UNKNOWN || r_id == 0) {
            r_id = llvm_expr_type(ctx, expr.inner1);
        }
        str l_name = ctx.types.type_name(l_id);
        str r_name = ctx.types.type_name(r_id);
        bool is_str_cmp = (l_id == TYPE_STR || r_id == TYPE_STR
                           || strcmp(l_name, "String") == 0 || strcmp(r_name, "String") == 0);
        if (is_str_cmp && (op == (u32)TokenKind.Equal || op == (u32)TokenKind.NotEqual)) {
            if (LLVMGetTypeKind(LLVMTypeOf(lhs)) == (u32)10) {
                lhs = LLVMBuildExtractValue(ctx.builder, lhs, 0, "str_data_l");
            }
            if (LLVMGetTypeKind(LLVMTypeOf(rhs)) == (u32)10) {
                rhs = LLVMBuildExtractValue(ctx.builder, rhs, 0, "str_data_r");
            }
            LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
            if (LLVMTypeOf(lhs) != ptr_ty && LLVMGetTypeKind(LLVMTypeOf(lhs)) == (u32)8) {
                lhs = LLVMBuildIntToPtr(ctx.builder, lhs, ptr_ty, "lhs_p_cast");
            }
            if (LLVMTypeOf(rhs) != ptr_ty && LLVMGetTypeKind(LLVMTypeOf(rhs)) == (u32)8) {
                rhs = LLVMBuildIntToPtr(ctx.builder, rhs, ptr_ty, "rhs_p_cast");
            }
            LLVMOpaqueValue* ptr_eq = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, lhs, rhs, "str_ptr_eq");
            LLVMOpaqueValue* lhs_null = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, lhs, LLVMConstNull(LLVMTypeOf(lhs)), "lhs_null");
            LLVMOpaqueValue* rhs_null = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, rhs, LLVMConstNull(LLVMTypeOf(rhs)), "rhs_null");
            LLVMOpaqueValue* any_null = LLVMBuildOr(ctx.builder, lhs_null, rhs_null, "any_null");

            LLVMOpaqueType* i1_ty = LLVMInt1TypeInContext(ctx.ctx);
            LLVMOpaqueValue* res_slot = LLVMBuildAlloca(ctx.builder, i1_ty, "streq_slot");
            LLVMOpaqueBasicBlock* strcmp_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "str_call");
            LLVMOpaqueBasicBlock* null_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "str_null");
            LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "str_merge");

            LLVMBuildCondBr(ctx.builder, any_null, null_bb, strcmp_bb);

            LLVMPositionBuilderAtEnd(ctx.builder, null_bb);
            LLVMBuildStore(ctx.builder, ptr_eq, res_slot);
            LLVMBuildBr(ctx.builder, merge_bb);

            LLVMPositionBuilderAtEnd(ctx.builder, strcmp_bb);
            LLVMOpaqueValue* strcmp_fn = LLVMGetNamedFunction(ctx.module, "strcmp");
            if (strcmp_fn == (LLVMOpaqueValue*)0) {
                LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
                Vec<LLVMOpaqueType*> param_tys = Vec<LLVMOpaqueType*>.new();
                param_tys.push(ptr_ty);
                param_tys.push(ptr_ty);
                LLVMOpaqueType* strcmp_ty = LLVMFunctionType(LLVMInt32TypeInContext(ctx.ctx), param_tys.data, 2, 0);
                param_tys.drop();
                strcmp_fn = LLVMAddFunction(ctx.module, "strcmp", strcmp_ty);
            }
            LLVMOpaqueType* fn_ty = LLVMGlobalGetValueType(strcmp_fn);
            Vec<LLVMOpaqueValue*> cargs = Vec<LLVMOpaqueValue*>.new();
            cargs.push(lhs);
            cargs.push(rhs);
            LLVMOpaqueValue* cmp_res = LLVMBuildCall2(ctx.builder, fn_ty, strcmp_fn, cargs.data, 2, "strcmp");
            cargs.drop();
            LLVMOpaqueValue* zero = LLVMConstInt(LLVMInt32TypeInContext(ctx.ctx), 0, 0);
            LLVMOpaqueValue* strcmp_eq = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, cmp_res, zero, "streq");
            LLVMBuildStore(ctx.builder, strcmp_eq, res_slot);
            LLVMBuildBr(ctx.builder, merge_bb);

            LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
            LLVMOpaqueValue* final_eq = LLVMBuildLoad2(ctx.builder, i1_ty, res_slot, "streq_res");
            if (op == (u32)TokenKind.NotEqual) {
                return LLVMBuildNot(ctx.builder, final_eq, "strne_res");
            }
            return final_eq;
        }

        // Enum ==/!= compares extracted i16 tags. Payload-carrying enums
        // have no structural equality: fail closed like stage0, which
        // rejects struct == outright.
        if (op == (u32)TokenKind.Equal || op == (u32)TokenKind.NotEqual) {
            u32 l_ty_id = llvm_expr_type(ctx, expr.inner0);
            u32 r_ty_id = llvm_expr_type(ctx, expr.inner1);
            SyntaxNode* l_enum = find_enum_item(ctx.root, ctx.types.type_name(l_ty_id));
            SyntaxNode* r_enum = find_enum_item(ctx.root, ctx.types.type_name(r_ty_id));
            if (l_enum != (SyntaxNode*)0 || r_enum != (SyntaxNode*)0) {
                if ((l_enum != (SyntaxNode*)0 && enum_has_payload(l_enum))
                    || (r_enum != (SyntaxNode*)0 && enum_has_payload(r_enum))) {
                    ctx.note_unresolved("enum-eq", "payload");
                    return (LLVMOpaqueValue*)0;
                }
                LLVMOpaqueValue* l_tag = lhs;
                LLVMOpaqueValue* r_tag = rhs;
                if (l_enum != (SyntaxNode*)0) {
                    l_tag = LLVMBuildExtractValue(ctx.builder, lhs, 0, "enum_l_tag");
                }
                if (r_enum != (SyntaxNode*)0) {
                    r_tag = LLVMBuildExtractValue(ctx.builder, rhs, 0, "enum_r_tag");
                }
                LLVMOpaqueType* l_tag_ty = LLVMTypeOf(l_tag);
                LLVMOpaqueType* r_tag_ty = LLVMTypeOf(r_tag);
                if (l_tag_ty != r_tag_ty) {
                    u32 lw = LLVMGetIntTypeWidth(l_tag_ty);
                    u32 rw = LLVMGetIntTypeWidth(r_tag_ty);
                    if (lw < rw) {
                        l_tag = LLVMBuildZExt(ctx.builder, l_tag, r_tag_ty, "enum_l_widen");
                    } else if (rw < lw) {
                        r_tag = LLVMBuildZExt(ctx.builder, r_tag, l_tag_ty, "enum_r_widen");
                    }
                }
                if (op == (u32)TokenKind.Equal) {
                    return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, l_tag, r_tag, "enum_eq");
                }
                return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE, l_tag, r_tag, "enum_ne");
            }
        }

        LLVMOpaqueType* lty = LLVMTypeOf(lhs);
        LLVMOpaqueType* rty = LLVMTypeOf(rhs);
        u32 l_type_id = llvm_expr_type(ctx, expr.inner0);
        u32 r_type_id = llvm_expr_type(ctx, expr.inner1);
        // Pointer arithmetic is GEP, not add: the inttoptr normalization
        // below produced `add ptr, inttoptr 1`, which fails verify.
        // Element type comes from the Silver pointer type (opaque LLVM
        // pointers erased it); unknown pointees fall back to bytes.
        if (op == (u32)TokenKind.Plus || op == (u32)TokenKind.Minus) {
            bool l_ptr = l_kind == (u32)12;
            bool r_ptr = r_kind == (u32)12;
            bool l_int = l_kind == (u32)8;
            bool r_int = r_kind == (u32)8;
            bool ptr_arith = (l_ptr && r_int) || (l_int && r_ptr && op == (u32)TokenKind.Plus);
            if (ptr_arith) {
                u32 ptr_side = l_ptr ? expr.inner0 : expr.inner1;
                LLVMOpaqueValue* base = l_ptr ? lhs : rhs;
                LLVMOpaqueValue* idx = l_ptr ? rhs : lhs;
                u32 elem_id = TYPE_UNKNOWN;
                TypeEntry* ptr_entry = ctx.types.get(ctx.types.resolve_subst(llvm_expr_type(ctx, ptr_side)));
                if (ptr_entry.kind == TypeKind.Pointer || ptr_entry.kind == TypeKind.Reference) {
                    elem_id = ctx.types.resolve_subst(ptr_entry.inner);
                } else if (ptr_entry.kind == TypeKind.Str) {
                    elem_id = TYPE_U8;
                }
                // Unknown pointees fall through to the old path (loud
                // verify failure) rather than silently using byte stride.
                if (elem_id != TYPE_UNKNOWN && elem_id != 0 && elem_id != TYPE_VOID) {
                    if (op == (u32)TokenKind.Minus) {
                        idx = LLVMBuildNeg(ctx.builder, idx, "ptr_idx_neg");
                    }
                    LLVMOpaqueType* elem_ty = llvm_lower_type(ctx.ctx, ctx.types, elem_id);
                    return LLVMBuildGEP2(ctx.builder, elem_ty, base, &idx, 1, "ptr_arith");
                }
            }
        }
        if (lty != rty) {
            if (l_kind == (u32)8 && r_kind == (u32)8) {
                u32 l_width = LLVMGetIntTypeWidth(lty);
                u32 r_width = LLVMGetIntTypeWidth(rty);
                if (l_width < r_width) {
                    if (llvm_type_is_signed(ctx.types, l_type_id)) {
                        lhs = LLVMBuildSExt(ctx.builder, lhs, rty, "cast_l_sext");
                    } else {
                        lhs = LLVMBuildZExt(ctx.builder, lhs, rty, "cast_l_zext");
                    }
                } else if (r_width < l_width) {
                    if (llvm_type_is_signed(ctx.types, r_type_id)) {
                        rhs = LLVMBuildSExt(ctx.builder, rhs, lty, "cast_r_sext");
                    } else {
                        rhs = LLVMBuildZExt(ctx.builder, rhs, lty, "cast_r_zext");
                    }
                }
            } else if (l_kind == (u32)12 && r_kind == (u32)8) {
                rhs = LLVMBuildIntToPtr(ctx.builder, rhs, lty, "cast_r_ptr");
            } else if (r_kind == (u32)12 && l_kind == (u32)8) {
                lhs = LLVMBuildIntToPtr(ctx.builder, lhs, rty, "cast_l_ptr");
            }
        }

        u32 op_ty_id = l_type_id;
        bool is_unsigned = (l_kind == (u32)12 || r_kind == (u32)12 || llvm_type_is_unsigned(ctx.types, op_ty_id));
        if (!is_unsigned) {
            is_unsigned = llvm_type_is_unsigned(ctx.types, r_type_id);
        }

        if (op == (u32)TokenKind.Plus) { return LLVMBuildAdd(ctx.builder, lhs, rhs, "add"); }
        if (op == (u32)TokenKind.Minus) { return LLVMBuildSub(ctx.builder, lhs, rhs, "sub"); }
        if (op == (u32)TokenKind.Star) { return LLVMBuildMul(ctx.builder, lhs, rhs, "mul"); }
        if (op == (u32)TokenKind.Slash) {
            if (is_unsigned) {
                return LLVMBuildUDiv(ctx.builder, lhs, rhs, "udiv");
            }
            return LLVMBuildSDiv(ctx.builder, lhs, rhs, "sdiv");
        }
        if (op == (u32)TokenKind.Percent) {
            if (is_unsigned) {
                return LLVMBuildURem(ctx.builder, lhs, rhs, "urem");
            }
            return LLVMBuildSRem(ctx.builder, lhs, rhs, "srem");
        }
        if (op == (u32)TokenKind.BitwiseAnd) { return LLVMBuildAnd(ctx.builder, lhs, rhs, "and"); }
        if (op == (u32)TokenKind.BitwiseOr) { return LLVMBuildOr(ctx.builder, lhs, rhs, "or"); }
        if (op == (u32)TokenKind.BitwiseXor) { return LLVMBuildXor(ctx.builder, lhs, rhs, "xor"); }
        if (op == (u32)TokenKind.LeftShift) { return LLVMBuildShl(ctx.builder, lhs, rhs, "shl"); }
        if (op == (u32)TokenKind.RightShift) {
            if (is_unsigned) {
                return LLVMBuildLShr(ctx.builder, lhs, rhs, "lshr");
            }
            return LLVMBuildAShr(ctx.builder, lhs, rhs, "ashr");
        }
        if (op == (u32)TokenKind.And) { return LLVMBuildAnd(ctx.builder, lhs, rhs, "and"); }
        if (op == (u32)TokenKind.Or) { return LLVMBuildOr(ctx.builder, lhs, rhs, "or"); }

        if (op == (u32)TokenKind.Equal) { return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, lhs, rhs, "eq"); }
        if (op == (u32)TokenKind.NotEqual) { return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE, lhs, rhs, "ne"); }
        if (op == (u32)TokenKind.Less) {
            if (is_unsigned) {
                return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntULT, lhs, rhs, "ult");
            }
            return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLT, lhs, rhs, "slt");
        }
        if (op == (u32)TokenKind.LessEqual) {
            if (is_unsigned) {
                return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntULE, lhs, rhs, "ule");
            }
            return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSLE, lhs, rhs, "sle");
        }
        if (op == (u32)TokenKind.Greater) {
            if (is_unsigned) {
                return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntUGT, lhs, rhs, "ugt");
            }
            return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSGT, lhs, rhs, "sgt");
        }
        if (op == (u32)TokenKind.GreaterEqual) {
            if (is_unsigned) {
                return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntUGE, lhs, rhs, "uge");
            }
            return LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntSGE, lhs, rhs, "sge");
        }
    }

    if (expr.kind == ExprKind.Ternary) {
        LLVMOpaqueValue* cond_val = llvm_emit_expr(ctx, expr.inner0);
        if (cond_val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
        if (LLVMTypeOf(cond_val) != LLVMInt1TypeInContext(ctx.ctx)) {
            cond_val = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE, cond_val, LLVMConstNull(LLVMTypeOf(cond_val)), "tern_cond_bool");
        }
        u32 result_ty_id = expr.inferred_type;
        if (result_ty_id == TYPE_UNKNOWN) {
            AstExpr* then_expr = ctx.pool.get_expr(expr.inner1);
            result_ty_id = then_expr.inferred_type;
        }
        if (result_ty_id == TYPE_UNKNOWN) {
            // Frontend Field inference validates but does not propagate
            // field types, so struct-typed branches (n.span) infer UNKNOWN.
            // Fall back to backend-level resolution, which reads struct
            // layouts and handles fields correctly.
            result_ty_id = llvm_expr_type(ctx, expr.inner1);
        }
        if (result_ty_id == TYPE_UNKNOWN) {
            result_ty_id = llvm_expr_type(ctx, expr.aux);
        }
        if (result_ty_id == TYPE_UNKNOWN
            && ctx.expected_type_id != 0
            && ctx.expected_type_id != TYPE_UNKNOWN) {
            result_ty_id = ctx.expected_type_id;
        }
        if (result_ty_id == TYPE_UNKNOWN) { return (LLVMOpaqueValue*)0; }
        LLVMOpaqueType* result_ty = llvm_lower_type(ctx.ctx, ctx.types, result_ty_id);
        LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, result_ty, "ternary");
        LLVMOpaqueBasicBlock* then_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "tern_then");
        LLVMOpaqueBasicBlock* else_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "tern_else");
        LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "tern_merge");
        LLVMBuildCondBr(ctx.builder, cond_val, then_bb, else_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, then_bb);
        LLVMOpaqueValue* then_val = llvm_emit_expr(ctx, expr.inner1);
        if (then_val != (LLVMOpaqueValue*)0) {
            // Branches may legally differ in width from the result slot
            // (numeric literals infer narrower than the other branch); with
            // opaque pointers the verifier cannot see the mismatch, so an
            // unconverted wide store would smash neighboring stack slots.
            then_val = llvm_compat_value(ctx, then_val, llvm_expr_type(ctx, expr.inner1),
                                         result_ty_id);
            LLVMBuildStore(ctx.builder, then_val, slot);
        }
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, else_bb);
        LLVMOpaqueValue* else_val = llvm_emit_expr(ctx, expr.aux);
        if (else_val != (LLVMOpaqueValue*)0) {
            else_val = llvm_compat_value(ctx, else_val, llvm_expr_type(ctx, expr.aux),
                                         result_ty_id);
            LLVMBuildStore(ctx.builder, else_val, slot);
        }
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
        return LLVMBuildLoad2(ctx.builder, result_ty, slot, "ternary_val");
    }

    if (expr.kind == ExprKind.UnwrapOr) {
        // `value ? fallback`: evaluate the value once, test presence,
        // and only evaluate the fallback on the absent path. Pointers
        // compare against null; Optional checks the Some tag and Result
        // checks the Ok tag, reusing the match payload layout helpers.
        // Operand-less nodes come from a dangling `?` and have no valid
        // lowering; fail closed so they can never silently miscompile.
        if (expr.inner0 == 0 || expr.inner1 == 0) {
            ctx.note_unresolved("unwrap-or", "missing operand");
            return (LLVMOpaqueValue*)0;
        }
        u32 val_ty_id = llvm_expr_type(ctx, expr.inner0);
        if (val_ty_id == TYPE_UNKNOWN || val_ty_id == 0) {
            AstExpr* val_expr = ctx.pool.get_expr(expr.inner0);
            if (val_expr.inferred_type != TYPE_UNKNOWN && val_expr.inferred_type != 0) {
                val_ty_id = ctx.types.resolve_subst(val_expr.inferred_type);
            }
        }
        if (val_ty_id == TYPE_UNKNOWN || val_ty_id == 0) { return (LLVMOpaqueValue*)0; }
        TypeEntry* val_entry = ctx.types.get(val_ty_id);
        bool is_pointer = val_entry.kind == TypeKind.Pointer;
        str enum_base = "";
        if (!is_pointer) {
            if (val_entry.kind != TypeKind.Named || val_entry.count == 0) {
                ctx.note_unresolved("unwrap-or", "unsupported value type");
                return (LLVMOpaqueValue*)0;
            }
            enum_base = ctx.types.names.get(val_entry.name_id);
            if (strcmp(enum_base, "Optional") != 0 && strcmp(enum_base, "Result") != 0
                && strcmp(enum_base, "SysResult") != 0) {
                ctx.note_unresolved("unwrap-or", "unsupported value type");
                return (LLVMOpaqueValue*)0;
            }
        }
        u32 result_ty_id = expr.inferred_type;
        if (result_ty_id == TYPE_UNKNOWN || result_ty_id == 0) {
            if (is_pointer) {
                result_ty_id = val_ty_id;
            } else if (val_entry.count > 0) {
                result_ty_id = ctx.types.resolve_subst(ctx.types.type_args.get(val_entry.inner));
            }
        }
        if (result_ty_id == TYPE_UNKNOWN || result_ty_id == 0) {
            result_ty_id = llvm_expr_type(ctx, expr.inner1);
        }
        if (result_ty_id == TYPE_UNKNOWN || result_ty_id == 0) { return (LLVMOpaqueValue*)0; }
        LLVMOpaqueType* result_ty = llvm_lower_type(ctx.ctx, ctx.types, result_ty_id);
        LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, result_ty, "unwrap_or");
        LLVMOpaqueBasicBlock* present_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "unwrap_or_some");
        LLVMOpaqueBasicBlock* absent_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "unwrap_or_none");
        LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "unwrap_or_merge");
        if (is_pointer) {
            LLVMOpaqueValue* ptr_val = llvm_emit_expr(ctx, expr.inner0);
            if (ptr_val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
            LLVMOpaqueValue* null_ptr = LLVMConstNull(LLVMTypeOf(ptr_val));
            LLVMOpaqueValue* non_null = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntNE, ptr_val, null_ptr, "unwrap_or_nonnull");
            LLVMBuildCondBr(ctx.builder, non_null, present_bb, absent_bb);
            LLVMPositionBuilderAtEnd(ctx.builder, present_bb);
            LLVMOpaqueValue* present_val = llvm_compat_value(ctx, ptr_val, val_ty_id, result_ty_id);
            LLVMBuildStore(ctx.builder, present_val, slot);
            LLVMBuildBr(ctx.builder, merge_bb);
            LLVMPositionBuilderAtEnd(ctx.builder, absent_bb);
            LLVMOpaqueValue* fallback_val = llvm_emit_expr(ctx, expr.inner1);
            if (fallback_val != (LLVMOpaqueValue*)0) {
                u32 fallback_ty_id = llvm_expr_type(ctx, expr.inner1);
                fallback_val = llvm_compat_value(ctx, fallback_val, fallback_ty_id, result_ty_id);
                LLVMBuildStore(ctx.builder, fallback_val, slot);
            }
            LLVMBuildBr(ctx.builder, merge_bb);
            LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
            return LLVMBuildLoad2(ctx.builder, result_ty, slot, "unwrap_or_val");
        }
        mono_ensure_child_layouts(ctx, val_ty_id, &ctx.generic_layout_ids);
        str variant_name = "Some";
        if (strcmp(enum_base, "Result") == 0 || strcmp(enum_base, "SysResult") == 0) {
            variant_name = "Ok";
        }
        i64 present_tag = 0;
        i64 present_arity = 0;
        if (!enum_variant_info(ctx.root, enum_base, variant_name, &present_tag, &present_arity)) {
            ctx.note_unresolved("unwrap-or", variant_name);
            return (LLVMOpaqueValue*)0;
        }
        Vec<u32> payload_types = Vec<u32>.new();
        llvm_enum_payload_types(ctx.types, ctx.root, enum_base, variant_name, &payload_types);
        i64 payload_index = 0;
        while (payload_index < payload_types.len()) {
            u32 resolved = mono_resolve_struct_field_type(ctx, val_ty_id, payload_types.get(payload_index));
            payload_types.set(payload_index, resolved);
            payload_index += 1;
        }
        if (payload_types.len() == 0) {
            payload_types.drop();
            ctx.note_unresolved("unwrap-or", "missing payload");
            return (LLVMOpaqueValue*)0;
        }
        u32 payload_ty_id = payload_types.get(0);
        LLVMOpaqueType* scrut_ty = llvm_lower_type(ctx.ctx, ctx.types, val_ty_id);
        u64 payload_base_offset = llvm_target_struct_field_offset(ctx, scrut_ty, 1);
        u64 field_offset = payload_base_offset + llvm_target_payload_field_offset(ctx, &payload_types, 0);
        LLVMOpaqueType* payload_ty = llvm_lower_type(ctx.ctx, ctx.types, payload_ty_id);
        payload_types.drop();
        LLVMOpaqueValue* scrut_val = llvm_emit_expr(ctx, expr.inner0);
        if (scrut_val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
        LLVMOpaqueValue* scrut_slot = LLVMBuildAlloca(ctx.builder, scrut_ty, "unwrap_or_scrut");
        LLVMBuildStore(ctx.builder, scrut_val, scrut_slot);
        LLVMOpaqueValue* tag_ptr = LLVMBuildStructGEP2(ctx.builder, scrut_ty, scrut_slot, 0, "unwrap_or_tag");
        LLVMOpaqueValue* tag_val = LLVMBuildLoad2(ctx.builder, LLVMInt16TypeInContext(ctx.ctx), tag_ptr, "unwrap_or_tag_ld");
        LLVMOpaqueValue* expected = LLVMConstInt(LLVMInt16TypeInContext(ctx.ctx), (u64)present_tag, 0);
        LLVMOpaqueValue* is_present = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, tag_val, expected, "unwrap_or_present");
        LLVMBuildCondBr(ctx.builder, is_present, present_bb, absent_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, present_bb);
        LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
        LLVMOpaqueValue* slot_bytes = LLVMBuildBitCast(ctx.builder, scrut_slot, ptr_ty, "unwrap_or_bytes");
        LLVMOpaqueValue* field_index = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), field_offset, 0);
        LLVMOpaqueValue* field_byte_ptr = LLVMBuildGEP2(ctx.builder, LLVMInt8TypeInContext(ctx.ctx),
                                                        slot_bytes, &field_index, 1, "unwrap_or_field_byte");
        LLVMOpaqueValue* field_ptr = LLVMBuildBitCast(ctx.builder, field_byte_ptr, ptr_ty, "unwrap_or_field");
        LLVMOpaqueValue* field_val = LLVMBuildLoad2(ctx.builder, payload_ty, field_ptr, "unwrap_or_field_ld");
        LLVMSetAlignment(field_val, 1);
        field_val = llvm_compat_value(ctx, field_val, payload_ty_id, result_ty_id);
        LLVMBuildStore(ctx.builder, field_val, slot);
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, absent_bb);
        LLVMOpaqueValue* none_fallback = llvm_emit_expr(ctx, expr.inner1);
        if (none_fallback != (LLVMOpaqueValue*)0) {
            u32 none_fallback_ty = llvm_expr_type(ctx, expr.inner1);
            none_fallback = llvm_compat_value(ctx, none_fallback, none_fallback_ty, result_ty_id);
            LLVMBuildStore(ctx.builder, none_fallback, slot);
        }
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
        return LLVMBuildLoad2(ctx.builder, result_ty, slot, "unwrap_or_val");
    }

    if (expr.kind == ExprKind.Match) {
        LLVMOpaqueValue* scrut_val = llvm_emit_expr(ctx, expr.inner0);
        if (scrut_val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
        AstExpr* scrut_expr = ctx.pool.get_expr(expr.inner0);
        u32 scrut_ty_id = scrut_expr.inferred_type;
        if (scrut_ty_id == TYPE_UNKNOWN || scrut_ty_id == 0) {
            // Frontend Field inference validates but does not propagate
            // field types, so field scrutinees (item.kind) infer UNKNOWN.
            // Resolve structurally: locals, fields, and call results all
            // work here. Without this the arm-variant fallback below must
            // guess the enum from a bare variant name, which fails closed
            // on ambiguous names (Function in NodeKind and SymbolKind).
            scrut_ty_id = llvm_expr_type(ctx, expr.inner0);
        }
        str scrut_enum = "";
        if (scrut_ty_id != TYPE_UNKNOWN) {
            TypeEntry* scrut_entry = ctx.types.get(scrut_ty_id);
            if (scrut_entry.kind == TypeKind.Named) {
                scrut_enum = ctx.types.names.get(scrut_entry.name_id);
            }
        }
        u32 result_ty_id = expr.inferred_type;
        if (result_ty_id == TYPE_UNKNOWN) {
            i64 probe = 0;
            while (probe < (i64)expr.aux) {
                MatchArm* probe_arm = ctx.pool.get_arm(expr.inner1 + (u32)probe);
                AstExpr* probe_val = ctx.pool.get_expr(probe_arm.value_id);
                if (probe_val.inferred_type != TYPE_UNKNOWN && probe_val.kind != ExprKind.Literal) {
                    result_ty_id = probe_val.inferred_type;
                    break;
                }
                probe += 1;
            }
            probe = 0;
            while (result_ty_id == TYPE_UNKNOWN && probe < (i64)expr.aux) {
                MatchArm* probe_arm = ctx.pool.get_arm(expr.inner1 + (u32)probe);
                AstExpr* probe_val = ctx.pool.get_expr(probe_arm.value_id);
                if (probe_val.inferred_type != TYPE_UNKNOWN) {
                    result_ty_id = probe_val.inferred_type;
                }
                probe += 1;
            }
        }
        if (result_ty_id == TYPE_UNKNOWN) {
            // A statement-position match with block arms has no result; use
            // an enclosing expected type only when the caller supplies one.
            result_ty_id = ctx.expected_type_id;
            if (result_ty_id == TYPE_UNKNOWN || result_ty_id == 0) {
                result_ty_id = TYPE_VOID;
            }
        }
        if (scrut_ty_id == TYPE_UNKNOWN) {
            i64 enum_probe = 0;
            while (enum_probe < (i64)expr.aux) {
                MatchArm* enum_arm = ctx.pool.get_arm(expr.inner1 + (u32)enum_probe);
                if (enum_arm.pattern == MatchPatternKind.Variant) {
                    str variant = ctx.names.get(enum_arm.variant_name_id);
                    SyntaxNode* found_item = (SyntaxNode*)0;
                    if (find_variant_enum(ctx.root, variant, &found_item)) {
                        SyntaxNode* enum_id = item_identifier(found_item);
                        if (enum_id != (SyntaxNode*)0) {
                            scrut_ty_id = ctx.types.get_named(enum_id.text);
                            scrut_enum = enum_id.text;
                            break;
                        }
                    }
                }
                enum_probe += 1;
            }
        }
        mono_ensure_child_layouts(ctx, scrut_ty_id, &ctx.generic_layout_ids);
        bool void_match = result_ty_id == TYPE_VOID;
        LLVMOpaqueType* result_ty = (LLVMOpaqueType*)0;
        LLVMOpaqueValue* result_slot = (LLVMOpaqueValue*)0;
        if (!void_match) {
            result_ty = llvm_lower_type(ctx.ctx, ctx.types, result_ty_id);
            result_slot = LLVMBuildAlloca(ctx.builder, result_ty, "match_res");
        }
        LLVMOpaqueType* scrut_ty = llvm_lower_type(ctx.ctx, ctx.types, scrut_ty_id);
        LLVMOpaqueValue* scrut_slot = LLVMBuildAlloca(ctx.builder, scrut_ty, "match_scrut");
        LLVMBuildStore(ctx.builder, scrut_val, scrut_slot);
        LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_merge");
        LLVMOpaqueBasicBlock* next_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_next");
        LLVMBuildBr(ctx.builder, next_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, next_bb);
        i64 arm_index = 0;
        while (arm_index < (i64)expr.aux) {
            MatchArm* arm = ctx.pool.get_arm(expr.inner1 + (u32)arm_index);
            LLVMOpaqueBasicBlock* check_bb = next_bb;
            next_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_next");
            LLVMOpaqueBasicBlock* arm_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_arm");
            LLVMPositionBuilderAtEnd(ctx.builder, check_bb);
            bool always_matches = false;
            if (arm.pattern == MatchPatternKind.Wildcard || arm.pattern == MatchPatternKind.Binding) {
                always_matches = true;
            } else if (arm.pattern == MatchPatternKind.Literal) {
                AstExpr* lit = ctx.pool.get_expr(arm.literal_id);
                str lit_text = ctx.names.get(lit.inner0);
                LLVMOpaqueValue* lit_val = (LLVMOpaqueValue*)0;
                if (lit.inferred_type == TYPE_BOOL) {
                    u64 bit = (strcmp(lit_text, "true") == 0) ? (u64)1 : (u64)0;
                    lit_val = LLVMConstInt(LLVMInt1TypeInContext(ctx.ctx), bit, 0);
                } else if (lit.inferred_type == TYPE_CHAR) {
                    lit_val = LLVMConstInt(scrut_ty, (u64)parse_char_literal(lit_text), 0);
                } else if (lit.inferred_type == TYPE_F32 || lit.inferred_type == TYPE_F64) {
                    lit_val = llvm_const_real_literal(scrut_ty, lit_text);
                } else if (lit.inferred_type == TYPE_STR) {
                    lit_val = llvm_emit_expr(ctx, arm.literal_id);
                } else {
                    lit_val = llvm_const_int_literal(scrut_ty, lit_text, false);
                }
                LLVMOpaqueValue* loaded = LLVMBuildLoad2(ctx.builder, scrut_ty, scrut_slot, "match_scrut_ld");
                LLVMOpaqueValue* cmp = (LLVMOpaqueValue*)0;
                if (lit.inferred_type == TYPE_F32 || lit.inferred_type == TYPE_F64) {
                    cmp = LLVMBuildFCmp(ctx.builder, LLVMRealPredicate.LLVMRealOEQ, loaded, lit_val, "match_float");
                } else if (lit.inferred_type == TYPE_STR) {
                    LLVMOpaqueType* bool_ty = LLVMInt1TypeInContext(ctx.ctx);
                    LLVMOpaqueValue* equal_slot = LLVMBuildAlloca(ctx.builder, bool_ty, "match_string_eq");
                    LLVMOpaqueBasicBlock* null_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_string_null");
                    LLVMOpaqueBasicBlock* compare_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_string_compare");
                    LLVMOpaqueBasicBlock* merge_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_string_merge");
                    LLVMOpaqueValue* is_null = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ,
                        loaded, LLVMConstNull(LLVMTypeOf(loaded)), "match_string_is_null");
                    LLVMBuildCondBr(ctx.builder, is_null, null_bb, compare_bb);

                    LLVMPositionBuilderAtEnd(ctx.builder, null_bb);
                    LLVMBuildStore(ctx.builder, LLVMConstInt(bool_ty, 0, 0), equal_slot);
                    LLVMBuildBr(ctx.builder, merge_bb);

                    LLVMPositionBuilderAtEnd(ctx.builder, compare_bb);
                    LLVMOpaqueValue* strcmp_fn = LLVMGetNamedFunction(ctx.module, "strcmp");
                    if (strcmp_fn == (LLVMOpaqueValue*)0) {
                        LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
                        Vec<LLVMOpaqueType*> param_tys = Vec<LLVMOpaqueType*>.new();
                        param_tys.push(ptr_ty);
                        param_tys.push(ptr_ty);
                        LLVMOpaqueType* strcmp_ty = LLVMFunctionType(LLVMInt32TypeInContext(ctx.ctx), param_tys.data, 2, 0);
                        param_tys.drop();
                        strcmp_fn = LLVMAddFunction(ctx.module, "strcmp", strcmp_ty);
                    }
                    LLVMOpaqueType* strcmp_ty = LLVMGlobalGetValueType(strcmp_fn);
                    Vec<LLVMOpaqueValue*> strcmp_args = Vec<LLVMOpaqueValue*>.new();
                    strcmp_args.push(loaded);
                    strcmp_args.push(lit_val);
                    LLVMOpaqueValue* strcmp_result = LLVMBuildCall2(ctx.builder, strcmp_ty, strcmp_fn,
                        strcmp_args.data, 2, "match_string_compare_result");
                    strcmp_args.drop();
                    LLVMOpaqueValue* is_equal = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ,
                        strcmp_result, LLVMConstInt(LLVMInt32TypeInContext(ctx.ctx), 0, 0), "match_string_equal");
                    LLVMBuildStore(ctx.builder, is_equal, equal_slot);
                    LLVMBuildBr(ctx.builder, merge_bb);

                    LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
                    cmp = LLVMBuildLoad2(ctx.builder, bool_ty, equal_slot, "match_string_result");
                } else {
                    cmp = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, loaded, lit_val, "match_lit");
                }
                LLVMBuildCondBr(ctx.builder, cmp, arm_bb, next_bb);
            } else {
                str variant = ctx.names.get(arm.variant_name_id);
                str arm_enum = scrut_enum;
                if (strlen(arm_enum) == 0) {
                    SyntaxNode* found_item = (SyntaxNode*)0;
                    if (find_variant_enum(ctx.root, variant, &found_item)) {
                        SyntaxNode* enum_id = item_identifier(found_item);
                        if (enum_id != (SyntaxNode*)0) {
                            arm_enum = enum_id.text;
                        }
                    }
                }
                if (strlen(arm_enum) == 0) { return (LLVMOpaqueValue*)0; }
                i64 tag = 0;
                i64 arity = 0;
                if (!enum_variant_info(ctx.root, arm_enum, variant, &tag, &arity)) {
                    return (LLVMOpaqueValue*)0;
                }
                String base_name = String.new();
                i64 base_index = 0;
                while (arm_enum[base_index] != (u8)0 && arm_enum[base_index] != (u8)60) {
                    base_name.push(arm_enum[base_index]);
                    base_index += 1;
                }
                LLVMOpaqueType* enum_ty = LLVMGetTypeByName2(ctx.ctx, base_name.to_str());
                TypeEntry* scrut_entry = ctx.types.get(scrut_ty_id);
                if (scrut_entry.kind == TypeKind.Named && scrut_entry.count > 0) {
                    enum_ty = scrut_ty;
                }
                base_name.drop();
                if (enum_ty != (LLVMOpaqueType*)0) {
                    LLVMOpaqueValue* tag_ptr = LLVMBuildStructGEP2(ctx.builder, enum_ty, scrut_slot, 0, "match_tag");
                    LLVMOpaqueValue* tag_val = LLVMBuildLoad2(ctx.builder, LLVMInt16TypeInContext(ctx.ctx), tag_ptr, "match_tag_ld");
                    LLVMOpaqueValue* expected = LLVMConstInt(LLVMInt16TypeInContext(ctx.ctx), (u64)tag, 0);
                    LLVMOpaqueValue* same = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, tag_val, expected, "match_tag_eq");
                    LLVMBuildCondBr(ctx.builder, same, arm_bb, next_bb);
                } else {
                    LLVMOpaqueValue* tag_val = LLVMBuildLoad2(ctx.builder, scrut_ty, scrut_slot, "match_tag_ld");
                    LLVMOpaqueValue* expected = LLVMConstInt(scrut_ty, (u64)tag, 0);
                    LLVMOpaqueValue* same = LLVMBuildICmp(ctx.builder, LLVMIntPredicate.LLVMIntEQ, tag_val, expected, "match_tag_eq");
                    LLVMBuildCondBr(ctx.builder, same, arm_bb, next_bb);
                }
            }
            if (always_matches) {
                LLVMBuildBr(ctx.builder, arm_bb);
            }
            LLVMPositionBuilderAtEnd(ctx.builder, arm_bb);
            ctx.push_scope();
            if (arm.pattern == MatchPatternKind.Binding) {
                u32 binding_name = ctx.pool.arm_bindings.get((i64)arm.bindings_start);
                LLVMOpaqueValue* bind_slot = LLVMBuildAlloca(ctx.builder, scrut_ty, "match_bind");
                LLVMOpaqueValue* scrut_loaded = LLVMBuildLoad2(ctx.builder, scrut_ty, scrut_slot, "match_scrut_ld");
                LLVMBuildStore(ctx.builder, scrut_loaded, bind_slot);
                ctx.add_local(binding_name, bind_slot, scrut_ty_id, true);
                llvm_push_scrutinee_move(ctx, binding_name, expr.inner0);
            } else if (arm.pattern == MatchPatternKind.Variant) {
                str variant = ctx.names.get(arm.variant_name_id);
                str arm_enum = scrut_enum;
                if (strlen(arm_enum) == 0) {
                    SyntaxNode* found_item = (SyntaxNode*)0;
                    if (find_variant_enum(ctx.root, variant, &found_item)) {
                        SyntaxNode* enum_id = item_identifier(found_item);
                        if (enum_id != (SyntaxNode*)0) {
                            arm_enum = enum_id.text;
                        }
                    }
                }
                Vec<u32> payload_types = Vec<u32>.new();
                llvm_enum_payload_types(ctx.types, ctx.root, arm_enum, variant, &payload_types);
                i64 payload_index = 0;
                while (payload_index < payload_types.len()) {
                    u32 resolved = mono_resolve_struct_field_type(ctx, scrut_ty_id, payload_types.get(payload_index));
                    payload_types.set(payload_index, resolved);
                    payload_index += 1;
                }
                u64 payload_base_offset = 0;
                if (payload_types.len() > 0) {
                    payload_base_offset = llvm_target_struct_field_offset(ctx, scrut_ty, 1);
                }
                i64 binding_index = 0;
                while (binding_index < (i64)arm.bindings_count && binding_index < payload_types.len()) {
                    u32 binding_name = ctx.pool.arm_bindings.get((i64)arm.bindings_start + binding_index);
                    u32 field_type = payload_types.get(binding_index);
                    u64 field_offset = payload_base_offset + llvm_target_payload_field_offset(ctx, &payload_types, binding_index);
                    LLVMOpaqueType* field_ty = llvm_lower_type(ctx.ctx, ctx.types, field_type);
                    LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
                    LLVMOpaqueValue* slot_bytes = LLVMBuildBitCast(ctx.builder, scrut_slot, ptr_ty, "match_scrut_bytes");
                    LLVMOpaqueValue* field_index = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), field_offset, 0);
                    LLVMOpaqueValue* field_byte_ptr = LLVMBuildGEP2(ctx.builder, LLVMInt8TypeInContext(ctx.ctx),
                                                                    slot_bytes, &field_index, 1, "match_field_byte");
                    LLVMOpaqueValue* field_ptr = LLVMBuildBitCast(ctx.builder, field_byte_ptr, ptr_ty, "match_field");
                    LLVMOpaqueValue* field_val = LLVMBuildLoad2(ctx.builder, field_ty, field_ptr, "match_field_ld");
                    LLVMSetAlignment(field_val, 1);
                    LLVMOpaqueValue* bind_slot = LLVMBuildAlloca(ctx.builder, field_ty, "match_bind");
                    LLVMBuildStore(ctx.builder, field_val, bind_slot);
                    ctx.add_local(binding_name, bind_slot, field_type, true);
                    llvm_push_scrutinee_move(ctx, binding_name, expr.inner0);
                    binding_index += 1;
                }
                payload_types.drop();
            }
            if (arm.guard_id != 0) {
                LLVMOpaqueValue* guard_val = llvm_emit_expr(ctx, arm.guard_id);
                if (guard_val == (LLVMOpaqueValue*)0) {
                    ctx.pop_scope();
                    return (LLVMOpaqueValue*)0;
                }
                LLVMOpaqueBasicBlock* guard_bb = LLVMAppendBasicBlockInContext(ctx.ctx, ctx.current_fn, "match_guard");
                LLVMBuildCondBr(ctx.builder, guard_val, guard_bb, next_bb);
                LLVMPositionBuilderAtEnd(ctx.builder, guard_bb);
            }
            AstExpr* arm_val_expr = ctx.pool.get_expr(arm.value_id);
            u32 arm_val_ty = arm_val_expr.inferred_type;
            LLVMOpaqueValue* arm_val = (LLVMOpaqueValue*)0;
            if (arm.body_stmt_id != 0) {
                // Block arm body: run its statements inline (diverging arms
                // return from the function here). No value is produced.
                AstStmt* body_stmt = ctx.pool.get_stmt(arm.body_stmt_id);
                if (body_stmt.kind == StmtKind.Block) {
                    u32 start = body_stmt.inner0;
                    u32 count = body_stmt.aux;
                    ctx.push_scope();
                    i64 bi = 0;
                    while (bi < (i64)count) {
                        llvm_emit_stmt(ctx, ctx.pool.block_stmts.get((i64)start + bi));
                        if (ctx.is_terminated()) { break; }
                        bi += 1;
                    }
                    ctx.pop_scope();
                    if (!ctx.is_terminated()) {
                        // Unterminated bodies with no value fail closed,
                        // unless the body ends in a known-diverging call
                        // (abort): then control can never reach merge, so
                        // terminate explicitly instead of recording a note.
                        if (match_body_diverges(ctx, body_stmt)) {
                            LLVMBuildUnreachable(ctx.builder);
                        } else if (void_match) {
                            LLVMBuildBr(ctx.builder, merge_bb);
                        } else {
                            ctx.note_unresolved("match-value", "expression");
                            ctx.pop_scope();
                            return (LLVMOpaqueValue*)0;
                        }
                    }
                } else {
                    ctx.note_unresolved("match-body", "expression");
                    ctx.pop_scope();
                    return (LLVMOpaqueValue*)0;
                }
            } else if (arm_val_ty != result_ty_id && arm_val_expr.kind == ExprKind.Literal) {
                str arm_text = ctx.names.get(arm_val_expr.inner0);
                if (type_is_integer(result_ty_id) && type_is_integer(arm_val_ty)) {
                    arm_val = llvm_const_int_literal(result_ty, arm_text, false);
                } else if (type_is_float(result_ty_id) && type_is_float(arm_val_ty)) {
                    arm_val = llvm_const_real_literal(result_ty, arm_text);
                } else if (arm_val_ty == TYPE_CHAR) {
                    arm_val = LLVMConstInt(result_ty, (u64)parse_char_literal(arm_text), 0);
                }
            }
            if (arm_val == (LLVMOpaqueValue*)0) {
                arm_val = llvm_emit_expr(ctx, arm.value_id);
            }
            if (ctx.is_terminated()) {
                // Diverging arm value (explicit return inside): nothing to
                // store and no edge to merge; the result slot is only read
                // on paths that cannot reach here.
            } else if (arm_val != (LLVMOpaqueValue*)0) {
                if (!void_match) {
                    arm_val = llvm_compat_value(ctx, arm_val, arm_val_ty, result_ty_id);
                    LLVMBuildStore(ctx.builder, arm_val, result_slot);
                }
                LLVMBuildBr(ctx.builder, merge_bb);
            } else if (void_match) {
                LLVMBuildBr(ctx.builder, merge_bb);
            } else {
                ctx.note_unresolved("match-value", "expression");
                ctx.pop_scope();
                return (LLVMOpaqueValue*)0;
            }
            ctx.pop_scope();
            LLVMPositionBuilderAtEnd(ctx.builder, next_bb);
            if (arm.pattern == MatchPatternKind.Variant) {
                llvm_pop_scrutinee_moves(ctx, (i64)arm.bindings_count);
            } else if (arm.pattern == MatchPatternKind.Binding) {
                llvm_pop_scrutinee_moves(ctx, 1);
            }
            arm_index += 1;
        }
        LLVMBuildBr(ctx.builder, merge_bb);
        LLVMPositionBuilderAtEnd(ctx.builder, merge_bb);
        if (void_match) { return (LLVMOpaqueValue*)0; }
        return LLVMBuildLoad2(ctx.builder, result_ty, result_slot, "match_val");
    }

    if (expr.kind == ExprKind.Call) {
        AstExpr* callee = ctx.pool.get_expr(expr.inner0);
        u32 callee_type = llvm_expr_type(ctx, expr.inner0);
        TypeEntry* callee_signature = ctx.types.get(callee_type);
        bool direct_named_call = false;
        if (callee.kind == ExprKind.Var && expr.resolved_callee_id == 0
            && ctx.find_local(callee.aux) == (LlvmLocal*)0) {
            direct_named_call = find_function_by_name_and_arity(
                ctx.root, ctx.names.get(callee.aux), (i64)expr.aux) != (SyntaxNode*)0;
        }
        bool indirect = callee_signature.kind == TypeKind.Function && !direct_named_call;
        u32 signature_start = callee_signature.inner;
        i64 signature_count = callee_signature.count;
        LLVMOpaqueValue* fn_val = (LLVMOpaqueValue*)0;
        if (callee.kind == ExprKind.Var && !indirect) {
            str callee_name = ctx.names.get(callee.aux);
            if (str_starts_with(callee_name, "__atomic_")) {
                return llvm_emit_atomic_call(ctx, expr_id, callee_name);
            }
            if (strlen(callee_name) > 0 && callee_name[0] >= (u8)65 && callee_name[0] <= (u8)90) {
                SyntaxNode* enum_item = (SyntaxNode*)0;
                if (find_variant_enum(ctx.root, callee_name, &enum_item)) {
                    SyntaxNode* enum_id = item_identifier(enum_item);
                    if (enum_id != (SyntaxNode*)0) {
                        return llvm_emit_enum_build(ctx, enum_id.text, callee_name, expr.inner1, expr.aux);
                    }
                }
            }
            // Generic free-function type arguments are stored structurally on
            // the call expression, preserving nested applications.
            String callee_base = String.new();
            i64 cb = 0;
            while (cb < (i64)strlen(callee_name) && callee_name[cb] != (u8)60) {
                callee_base.push(callee_name[cb]);
                cb += 1;
            }
            if (expr.generic_args_count > 0) {
                Vec<u32> generic_ids = Vec<u32>.new();
                i64 gi = 0;
                while (gi < (i64)expr.generic_args_count) {
                    u32 arg_id = ctx.pool.generic_type_args.get((i64)expr.generic_args_start + gi);
                    generic_ids.push(ctx.types.resolve_subst(arg_id));
                    gi += 1;
                }
                fn_val = mono_ensure_free_function(ctx, callee_base.to_str(), &generic_ids, expr.aux);
                generic_ids.drop();
            } else {
                Vec<u32> actual_types = Vec<u32>.new();
                Vec<bool> numeric_literals = Vec<bool>.new();
                Vec<u32> inferred_ids = Vec<u32>.new();
                i64 ai = 0;
                while (ai < (i64)expr.aux) {
                    u32 arg_id = ctx.pool.args.get((i64)expr.inner1 + ai);
                    u32 actual_type = llvm_expr_type(ctx, arg_id);
                    actual_types.push(actual_type);
                    numeric_literals.push(ctx.pool.get_expr(arg_id).kind == ExprKind.Literal
                        && type_is_numeric(actual_type));
                    ai += 1;
                }
                bool inferred = mono_infer_free_function_args(ctx, callee_base.to_str(), expr.aux,
                        &actual_types, &numeric_literals, &inferred_ids);
                if (inferred) {
                    fn_val = mono_ensure_free_function(ctx, callee_base.to_str(), &inferred_ids, expr.aux);
                }
                inferred_ids.drop();
                numeric_literals.drop();
                actual_types.drop();
            }
                if (fn_val == (LLVMOpaqueValue*)0 && expr.resolved_callee_id != 0) {
                    fn_val = LLVMGetNamedFunction(ctx.module, ctx.names.get(expr.resolved_callee_id - 1));
                } else if (fn_val == (LLVMOpaqueValue*)0) {
                    String link_name = item_extern_link_name(ctx.root, callee_name);
                    if (link_name.len() > 0) {
                        fn_val = LLVMGetNamedFunction(ctx.module, link_name.to_str());
                    }
                    link_name.drop();
                    if (fn_val == (LLVMOpaqueValue*)0) {
                        SyntaxNode* declaration = find_function_by_name_and_arity(
                            ctx.root, callee_name, (i64)expr.aux);
                        if (declaration != (SyntaxNode*)0
                            && typecheck_has_free_overloads(ctx.types, ctx.root, callee_name)) {
                            String symbol = typecheck_overloaded_free_symbol(
                                ctx.types, callee_name, declaration);
                            fn_val = LLVMGetNamedFunction(ctx.module, symbol.to_str());
                            symbol.drop();
                        } else {
                            fn_val = LLVMGetNamedFunction(ctx.module, callee_base.to_str());
                        }
                    }
                }
            callee_base.drop();
        }
        if (fn_val == (LLVMOpaqueValue*)0) {
            fn_val = llvm_emit_expr(ctx, expr.inner0);
        }
        if (fn_val == (LLVMOpaqueValue*)0) {
            if (callee.kind == ExprKind.Var) {
                str unresolved_name = expr.resolved_callee_id != 0
                    ? ctx.names.get(expr.resolved_callee_id - 1)
                    : ctx.names.get(callee.aux);
                ctx.note_unresolved("function", unresolved_name);
            }
            return (LLVMOpaqueValue*)0;
        }

        u32 args_count = expr.aux;
        u32 args_start = expr.inner1;
        Vec<LLVMOpaqueValue*> call_args = Vec<LLVMOpaqueValue*>.new();
        Vec<u32> call_arg_types = Vec<u32>.new();
        Vec<u32> call_target_types = Vec<u32>.new();
        Vec<u8> slice_coerced_args = Vec<u8>.new();
        Vec<LLVMOpaqueValue*> slice_temp_ptrs = Vec<LLVMOpaqueValue*>.new();
        Vec<u32> slice_temp_types = Vec<u32>.new();
        i64 i = 0;
        while (i < (i64)args_count) {
            u32 arg_id = ctx.pool.args.get((i64)args_start + i);
            SyntaxNode* callee_fn = (SyntaxNode*)0;
            Vec<Binding> params = Vec<Binding>.new();
            u32 expected_arg_type = TYPE_UNKNOWN;
            if (!indirect && callee.kind == ExprKind.Var) {
                callee_fn = find_function_by_name_and_arity(
                    ctx.root, ctx.names.get(callee.aux), (i64)args_count);
                if (callee_fn != (SyntaxNode*)0) {
                    collect_parameter_bindings(
                        binding_function_parameters(callee_fn), &params);
                    if (i < params.len()) {
                        expected_arg_type = typecheck_parameter_type_id(
                            ctx.types, params.get_ptr(i));
                    }
                }
            }
            u32 actual_arg_type = llvm_expr_type(ctx, arg_id);
            bool slice_coercion = expected_arg_type != TYPE_UNKNOWN
                && expected_arg_type != actual_arg_type
                && typecheck_slice_argument_coercion(
                    ctx.types, expected_arg_type, actual_arg_type);
            LLVMOpaqueValue* slice_temp_ptr = (LLVMOpaqueValue*)0;
            u32 slice_temp_type = TYPE_UNKNOWN;
            LLVMOpaqueValue* a_val = slice_coercion
                ? llvm_emit_slice_argument(ctx, arg_id, expected_arg_type,
                    &slice_temp_ptr, &slice_temp_type)
                : llvm_emit_expr(ctx, arg_id);
            if (slice_temp_ptr != (LLVMOpaqueValue*)0) {
                slice_temp_ptrs.push(slice_temp_ptr);
                slice_temp_types.push(slice_temp_type);
            }
            if (slice_coercion && a_val == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("slice-argument", ctx.types.type_name(actual_arg_type));
                a_val = LLVMConstNull(llvm_lower_type(ctx.ctx, ctx.types, expected_arg_type));
            }
            if (a_val == (LLVMOpaqueValue*)0) {
                AstExpr* arg_expr = ctx.pool.get_expr(arg_id);
                String detail = String.from_str(llvm_expr_kind_name(arg_expr.kind));
                if (arg_expr.kind == ExprKind.Var) {
                    detail.drop();
                    detail = String.from_str(ctx.names.get(arg_expr.aux));
                } else if (arg_expr.kind == ExprKind.Binary) {
                    str operation = llvm_binary_operator_method(arg_expr.aux);
                    if (strlen(operation) > 0) {
                        detail.push_str(" ");
                        detail.push_str(operation);
                    }
                }
                detail.push_str(" at line ");
                u8 line_buffer[24];
                i64 line_length = itoa(arg_expr.span.start_line, &line_buffer[0]);
                detail.push_bytes(&line_buffer[0], line_length);
                ctx.note_unresolved("call-arg", detail.to_str());
                detail.drop();
                u32 a_type = slice_coercion
                    ? expected_arg_type : ctx.pool.get_expr(arg_id).inferred_type;
                if (a_type == TYPE_UNKNOWN) { a_type = TYPE_I64; }
                LLVMOpaqueType* a_llvm_ty = llvm_lower_type(ctx.ctx, ctx.types, a_type);
                a_val = LLVMConstNull(a_llvm_ty);
            }
            if (indirect) {
                if (i < signature_count) {
                    call_target_types.push(ctx.types.type_args.get(signature_start + 1 + (u32)i));
                } else {
                    call_target_types.push(TYPE_UNKNOWN);
                }
            } else if (callee.kind == ExprKind.Var) {
                if (callee_fn != (SyntaxNode*)0) {
                    if (i < params.len()) {
                        if (actual_arg_type == TYPE_UNKNOWN) {
                            actual_arg_type = ctx.pool.get_expr(arg_id).inferred_type;
                        }
                        if (!slice_coercion) {
                        LLVMOpaqueValue* user_cast = llvm_try_apply_user_cast(ctx, a_val, actual_arg_type, expected_arg_type);
                        if (user_cast != (LLVMOpaqueValue*)0) {
                            a_val = user_cast;
                        }
                        }
                        call_target_types.push(expected_arg_type);
                    } else {
                        call_target_types.push(TYPE_UNKNOWN);
                    }
                } else {
                    call_target_types.push(TYPE_UNKNOWN);
                }
            } else {
                call_target_types.push(TYPE_UNKNOWN);
            }
            params.drop();
            call_args.push(a_val);
            call_arg_types.push(slice_coercion
                ? expected_arg_type : llvm_expr_type(ctx, arg_id));
            slice_coerced_args.push((u8)(slice_coercion ? 1 : 0));
            i += 1;
        }

        LLVMOpaqueType* fn_type = (LLVMOpaqueType*)0;
        if (LLVMIsAFunction(fn_val) != (LLVMOpaqueValue*)0) {
            fn_type = LLVMGlobalGetValueType(fn_val);
        } else {
            LLVMOpaqueType* val_ty = LLVMTypeOf(fn_val);
            u32 vk = LLVMGetTypeKind(val_ty);
            if (vk == (u32)8) {
                LLVMOpaqueType* ptr_ty = LLVMPointerTypeInContext(ctx.ctx, (u32)0);
                fn_val = LLVMBuildIntToPtr(ctx.builder, fn_val, ptr_ty, "fn_ptr_cast");
            } else if (vk != (u32)12) {
                call_target_types.drop();
                call_arg_types.drop();
                call_args.drop();
                return (LLVMOpaqueValue*)0;
            }
            u32 result_type = llvm_expr_type(ctx, expr_id);
            LLVMOpaqueType* ret_ty = LLVMInt64TypeInContext(ctx.ctx);
            if (result_type == TYPE_VOID) {
                ret_ty = LLVMVoidTypeInContext(ctx.ctx);
            } else if (result_type != TYPE_UNKNOWN) {
                ret_ty = llvm_lower_type(ctx.ctx, ctx.types, result_type);
            }
            Vec<LLVMOpaqueType*> param_tys = Vec<LLVMOpaqueType*>.new();
            i64 pi = 0;
            i64 parameter_count = indirect ? signature_count : call_args.len();
            while (pi < parameter_count) {
                LLVMOpaqueType* parameter_type = indirect
                    ? llvm_lower_type(ctx.ctx, ctx.types, ctx.types.type_args.get(signature_start + 1 + (u32)pi))
                    : LLVMTypeOf(call_args.get(pi));
                param_tys.push(parameter_type);
                pi += 1;
            }
            fn_type = LLVMFunctionType(ret_ty, param_tys.data, (u32)param_tys.len(), 0);
            param_tys.drop();
        }

        if (!indirect && callee.kind == ExprKind.Var) {
            SyntaxNode* declaration = find_function_by_name_and_arity(
                ctx.root, ctx.names.get(callee.aux), (i64)args_count);
            if (declaration != (SyntaxNode*)0) {
                Vec<Binding> params = Vec<Binding>.new();
                collect_parameter_bindings(
                    binding_function_parameters(declaration), &params);
                if (params.len() > 0
                    && binding_is_variadic_parameter(params.get_ptr(params.len() - 1))) {
                    Binding* variadic = params.get_ptr(params.len() - 1);
                    u32 element_type = typecheck_parameter_base_type_id(
                        ctx.types, variadic);
                    llvm_pack_variadic_call_args(ctx, (i64)(params.len() - 1),
                        element_type, &call_args, &call_arg_types,
                        &call_target_types, ctx.names.get(callee.aux));
                }
                params.drop();
            }
        }

        str call_label = callee.kind == ExprKind.Var ? ctx.names.get(callee.aux) : "";
        llvm_prepare_call_args(ctx, fn_type, &call_args, &call_arg_types, &call_target_types, call_label);
        LLVMOpaqueValue* res = LLVMBuildCall2(ctx.builder, fn_type, fn_val, call_args.data, (u32)call_args.len(), "");
        // By-value arguments transfer ownership to the callee, whose
        // parameter flags drop them; clear the caller side accordingly.
        i64 cleared = 0;
        while (cleared < (i64)args_count) {
            u32 cleared_arg_id = ctx.pool.args.get((i64)args_start + cleared);
            if (slice_coerced_args.get(cleared) == 0) {
                llvm_clear_transferred_arg(ctx, fn_type, cleared, cleared_arg_id);
            }
            cleared += 1;
        }
        i = 0;
        while (i < slice_temp_ptrs.len()) {
            llvm_emit_value_drop_at_ptr(ctx, slice_temp_ptrs.get(i),
                                        slice_temp_types.get(i));
            i += 1;
        }
        slice_temp_types.drop();
        slice_temp_ptrs.drop();
        slice_coerced_args.drop();
        call_target_types.drop();
        call_arg_types.drop();
        call_args.drop();
        return res;
    }

    if (expr.kind == ExprKind.SizeOf || expr.kind == ExprKind.AlignOf) {
        u32 target_type = expr.aux;
        if (expr.inner0 != 0) {
            u32 expr_type = llvm_expr_type(ctx, expr.inner0);
            if (expr_type != TYPE_UNKNOWN && expr_type != 0) {
                target_type = expr_type;
            }
        }
        target_type = ctx.types.resolve_subst(target_type);
        mono_ensure_child_layouts(ctx, target_type, &ctx.generic_layout_ids);
        if (expr.kind == ExprKind.SizeOf) {
            u64 size = llvm_target_type_size(ctx, target_type);
            LLVMOpaqueType* i64_ty = LLVMInt64TypeInContext(ctx.ctx);
            return LLVMConstInt(i64_ty, size, 0);
        }
        u64 align = llvm_target_type_align(ctx, target_type);
        LLVMOpaqueType* u64_ty = LLVMInt64TypeInContext(ctx.ctx);
        return LLVMConstInt(u64_ty, align, 0);
    }

    if (expr.kind == ExprKind.DropInPlace) {
        u32 elem_type = expr.aux;
        if (elem_type == TYPE_UNKNOWN || elem_type == 0) {
            u32 pointer_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr.inner0));
            TypeEntry* pointer_entry = ctx.types.get(pointer_type);
            if (pointer_entry.kind == TypeKind.Pointer || pointer_entry.kind == TypeKind.Reference) {
                elem_type = ctx.types.resolve_subst(pointer_entry.inner);
            }
        } else {
            elem_type = ctx.types.resolve_subst(elem_type);
        }
        if (elem_type == TYPE_UNKNOWN || elem_type == 0) {
            ctx.note_unresolved("drop-in-place-type", "pointer");
            return (LLVMOpaqueValue*)0;
        }
        if (!llvm_type_needs_tracking(ctx, elem_type)) {
            return LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx), 0, 0);
        }
        LLVMOpaqueValue* pointer = llvm_emit_expr(ctx, expr.inner0);
        LLVMOpaqueValue* count = llvm_emit_expr(ctx, expr.inner1);
        return llvm_emit_drop_in_place(ctx, elem_type, pointer, count);
    }

    if (expr.kind == ExprKind.MemoryBuiltin) {
        i64 args_start = (i64)expr.inner0;
        u32 dst_id = ctx.pool.args.get(args_start);
        u32 value_or_src_id = ctx.pool.args.get(args_start + 1);
        u32 size_id = ctx.pool.args.get(args_start + 2);
        LLVMOpaqueValue* dst = llvm_emit_expr(ctx, dst_id);
        LLVMOpaqueValue* value_or_src = llvm_emit_expr(ctx, value_or_src_id);
        LLVMOpaqueValue* size = llvm_emit_expr(ctx, size_id);
        if (dst == (LLVMOpaqueValue*)0 || value_or_src == (LLVMOpaqueValue*)0
            || size == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("memory-builtin-argument", "expression");
            return (LLVMOpaqueValue*)0;
        }
        if (LLVMGetTypeKind(LLVMTypeOf(dst)) != (u32)12
            || (expr.aux != (u32)MemoryBuiltinKind.Memset
                && LLVMGetTypeKind(LLVMTypeOf(value_or_src)) != (u32)12)) {
            ctx.note_unresolved("memory-builtin-pointer", "argument");
            return (LLVMOpaqueValue*)0;
        }

        u32 size_type = llvm_expr_type(ctx, size_id);
        LLVMOpaqueType* size_ty = LLVMInt64TypeInContext(ctx.ctx);
        LLVMOpaqueType* from_ty = LLVMTypeOf(size);
        if (LLVMGetTypeKind(from_ty) == (u32)8) {
            u32 from_width = LLVMGetIntTypeWidth(from_ty);
            if (from_width < 64) {
                if (llvm_type_is_signed(ctx.types, size_type)) {
                    size = LLVMBuildSExt(ctx.builder, size, size_ty, "mem_size_sext");
                } else {
                    size = LLVMBuildZExt(ctx.builder, size, size_ty, "mem_size_zext");
                }
            } else if (from_width > 64) {
                size = LLVMBuildTrunc(ctx.builder, size, size_ty, "mem_size_trunc");
            }
        }

        if (expr.aux == (u32)MemoryBuiltinKind.Memset) {
            value_or_src = llvm_compat_value(ctx, value_or_src,
                llvm_expr_type(ctx, value_or_src_id), TYPE_U8);
            LLVMBuildMemSet(ctx.builder, dst, value_or_src, size, 1);
        } else if (expr.aux == (u32)MemoryBuiltinKind.Memmove) {
            LLVMBuildMemMove(ctx.builder, dst, 1, value_or_src, 1, size);
        } else {
            LLVMBuildMemCpy(ctx.builder, dst, 1, value_or_src, 1, size);
        }
        return dst;
    }

    if (expr.kind == ExprKind.Cast) {
        u32 to_type = expr.aux;
        if (type_is_integer(to_type)) {
            AstExpr* operand = ctx.pool.get_expr(expr.inner0);
            LLVMOpaqueType* to_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, to_type);
            if (operand.kind == ExprKind.Literal && type_is_integer(operand.inferred_type)) {
                return llvm_const_int_literal(to_llvm_type, ctx.names.get(operand.inner0), false);
            }
            if (operand.kind == ExprKind.Unary && operand.aux == (u32)TokenKind.Minus) {
                AstExpr* number = ctx.pool.get_expr(operand.inner0);
                if (number.kind == ExprKind.Literal && type_is_integer(number.inferred_type)) {
                    return llvm_const_int_literal(to_llvm_type, ctx.names.get(number.inner0), true);
                }
            }
        }
        LLVMOpaqueValue* val = llvm_emit_expr(ctx, expr.inner0);
        if (val == (LLVMOpaqueValue*)0) { return (LLVMOpaqueValue*)0; }
        u32 from_type = llvm_expr_type(ctx, expr.inner0);
        LLVMOpaqueValue* user_cast = llvm_try_apply_user_cast(ctx, val, from_type, to_type);
        if (user_cast != (LLVMOpaqueValue*)0) {
            return user_cast;
        }
        LLVMOpaqueType* to_llvm_type = llvm_lower_type(ctx.ctx, ctx.types, to_type);
        LLVMOpaqueType* from_llvm_type = LLVMTypeOf(val);
        if (from_llvm_type == to_llvm_type) {
            return val;
        }
        u32 v_kind = LLVMGetTypeKind(from_llvm_type);
        u32 t_kind = LLVMGetTypeKind(to_llvm_type);
        if (v_kind == (u32)12 && t_kind == (u32)12) {
            return LLVMBuildBitCast(ctx.builder, val, to_llvm_type, "bitcast");
        }
        if (v_kind == (u32)12 && t_kind == (u32)8) {
            return LLVMBuildPtrToInt(ctx.builder, val, to_llvm_type, "ptrtoint");
        }
        if (v_kind == (u32)8 && t_kind == (u32)12) {
            return LLVMBuildIntToPtr(ctx.builder, val, to_llvm_type, "inttoptr");
        }
        if (v_kind == (u32)8 && t_kind == (u32)8) {
            u32 from_type = llvm_expr_type(ctx, expr.inner0);
            u32 from_width = LLVMGetIntTypeWidth(from_llvm_type);
            u32 to_width = LLVMGetIntTypeWidth(to_llvm_type);
            if (from_width == to_width) {
                return val;
            }
            if (from_width > to_width) {
                return LLVMBuildTrunc(ctx.builder, val, to_llvm_type, "intcast_trunc");
            }
            if (llvm_type_is_signed(ctx.types, from_type)) {
                return LLVMBuildSExt(ctx.builder, val, to_llvm_type, "intcast_sext");
            }
            return LLVMBuildZExt(ctx.builder, val, to_llvm_type, "intcast_zext");
        }
        if ((v_kind == (u32)2 || v_kind == (u32)3) && (t_kind == (u32)2 || t_kind == (u32)3)) {
            if (t_kind == (u32)3) {
                return LLVMBuildFPExt(ctx.builder, val, to_llvm_type, "fpext");
            } else {
                return LLVMBuildFPTrunc(ctx.builder, val, to_llvm_type, "fptrunc");
            }
        }
        if (v_kind == (u32)8 && (t_kind == (u32)2 || t_kind == (u32)3)) {
            u32 from_type = llvm_expr_type(ctx, expr.inner0);
            if (!llvm_type_is_signed(ctx.types, from_type)) {
                return LLVMBuildUIToFP(ctx.builder, val, to_llvm_type, "uitofp");
            }
            return LLVMBuildSIToFP(ctx.builder, val, to_llvm_type, "sitofp");
        }
        if ((v_kind == (u32)2 || v_kind == (u32)3) && t_kind == (u32)8) {
            if (!llvm_type_is_signed(ctx.types, to_type)) {
                return LLVMBuildFPToUI(ctx.builder, val, to_llvm_type, "fptoui");
            }
            return LLVMBuildFPToSI(ctx.builder, val, to_llvm_type, "fptosi");
        }
        if (v_kind == (u32)10 && t_kind == (u32)8) {
            LLVMOpaqueValue* tag_val = LLVMBuildExtractValue(ctx.builder, val, 0, "enum_tag");
            return LLVMBuildIntCast(ctx.builder, tag_val, to_llvm_type, "enum_tag_cast");
        }
        return val;
    }

    if (expr.kind == ExprKind.Field) {
        u32 field_target_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr.inner0));
        TypeEntry* field_target = ctx.types.get(field_target_type);
        while (field_target.kind == TypeKind.Pointer || field_target.kind == TypeKind.Reference) {
            field_target_type = ctx.types.resolve_subst(field_target.inner);
            field_target = ctx.types.get(field_target_type);
        }
        if (field_target_type == TYPE_STR
            && strcmp(ctx.names.get(expr.aux), "len") == 0) {
            return llvm_emit_strlen(ctx, llvm_emit_expr(ctx, expr.inner0));
        }
        AstExpr* rx = ctx.pool.get_expr(expr.inner0);
        if (rx.kind == ExprKind.Var) {
            str rx_name = ctx.names.get(rx.aux);
            String base = String.new();
            i64 base_index = 0;
            while (rx_name[base_index] != (u8)0 && rx_name[base_index] != (u8)60) {
                base.push(rx_name[base_index]);
                base_index += 1;
            }
            SyntaxNode* enum_item = find_enum_item(ctx.root, base.to_str());
            if (enum_item != (SyntaxNode*)0) {
                str variant_name = ctx.names.get(expr.aux);
                i64 tag = 0;
                i64 arity = 0;
                if (enum_variant_info(ctx.root, base.to_str(), variant_name, &tag, &arity)) {
                    base.drop();
                    // Variant values are {i16 tag, ...} structs in every
                    // position; Binary ==/!= compares extracted tags.
                    LLVMOpaqueValue* built = llvm_emit_enum_build(ctx, rx_name, variant_name, 0, 0);
                    if (built == (LLVMOpaqueValue*)0) {
                        ctx.note_unresolved("enum-variant", variant_name);
                    }
                    return built;
                }
            }
            base.drop();
        }

        LLVMOpaqueValue* field_ptr = llvm_emit_lvalue(ctx, expr_id);
        if (field_ptr == (LLVMOpaqueValue*)0) {
            return (LLVMOpaqueValue*)0;
        }
        if (field_ptr != (LLVMOpaqueValue*)0) {
            u32 field_type = llvm_expr_type(ctx, expr_id);
            if (field_type == TYPE_UNKNOWN || field_type == 0) {
                u32 target_type = llvm_expr_type(ctx, expr.inner0);
                TypeEntry* entry = ctx.types.get(target_type);
                while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                    target_type = entry.inner;
                    entry = ctx.types.get(target_type);
                }
                str struct_name = ctx.types.type_name(target_type);
                LlvmStructDef* def = ctx.find_struct_by_str(struct_name);
                if (def != (LlvmStructDef*)0) {
                    field_type = ctx.find_field_type(def, expr.aux);
                }
            }
            if (field_type != TYPE_UNKNOWN && field_type != 0) {
                LLVMOpaqueType* field_ty = llvm_lower_type(ctx.ctx, ctx.types, field_type);
                LLVMOpaqueValue* load = LLVMBuildLoad2(ctx.builder, field_ty, field_ptr,
                                                        "load_field");
                if (llvm_expr_may_be_unaligned(ctx, expr_id)) {
                    LLVMSetAlignment(load, 1);
                }
                return load;
            }
        }
        return (LLVMOpaqueValue*)0;
    }

    if (expr.kind == ExprKind.Index) {
        u32 target_type = ctx.types.resolve_subst(llvm_expr_type(ctx, expr.inner0));
        TypeEntry* target_entry = ctx.types.get(target_type);
        if (target_entry.kind == TypeKind.Named) {
            AstExpr method_call;
            method_call.kind = ExprKind.MethodCall;
            method_call.inner0 = expr.inner0;
            method_call.inner1 = (u32)ctx.pool.args.len();
            method_call.aux = ctx.names.intern("__index_get");
            method_call.span = expr.span;
            method_call.inferred_type = expr.inferred_type;
            method_call.generic_args_start = 0;
            method_call.generic_args_count = 0;
            method_call.resolved_callee_id = 0;
            ctx.pool.args.push((u32)1);
            ctx.pool.args.push(expr.inner1);
            ctx.pool.exprs.push(move method_call);
            return llvm_emit_expr(ctx, (u32)(ctx.pool.exprs.len() - 1));
        }
        LLVMOpaqueValue* elem_ptr = llvm_emit_lvalue(ctx, expr_id);
        if (elem_ptr != (LLVMOpaqueValue*)0) {
            if (LLVMGetTypeKind(LLVMTypeOf(elem_ptr)) != (u32)12) {
                elem_ptr = LLVMBuildIntToPtr(ctx.builder, elem_ptr, LLVMPointerTypeInContext(ctx.ctx, (u32)0), "elem_ptr_cast");
            }
            u32 elem_type = llvm_index_elem_type(ctx, expr.inner0, expr.inner1);
            LLVMOpaqueType* elem_ty = (elem_type != 0 && elem_type != TYPE_UNKNOWN && elem_type != TYPE_VOID)
                ? llvm_lower_type(ctx.ctx, ctx.types, elem_type)
                : LLVMInt8TypeInContext(ctx.ctx);
            LLVMOpaqueValue* load = LLVMBuildLoad2(ctx.builder, elem_ty, elem_ptr,
                                                    "load_elem");
            if (llvm_expr_may_be_unaligned(ctx, expr_id)) {
                LLVMSetAlignment(load, 1);
            }
            return load;
        }
        return (LLVMOpaqueValue*)0;
    }

    if (expr.kind == ExprKind.ArrayLit) {
        u32 expected_type = ctx.types.resolve_subst(ctx.expected_type_id);
        TypeEntry* expected_entry = ctx.types.get(expected_type);
        if (expected_entry.kind != TypeKind.Tuple && expected_entry.kind != TypeKind.Array
            && expr.inferred_type != TYPE_UNKNOWN) {
            u32 inferred_type = ctx.types.resolve_subst(expr.inferred_type);
            TypeEntry* inferred_entry = ctx.types.get(inferred_type);
            if (inferred_entry.kind == TypeKind.Tuple) {
                expected_type = inferred_type;
                expected_entry = inferred_entry;
            }
        }
        u32 element_count = expr.aux;
        if (expected_entry.kind == TypeKind.Tuple && expected_entry.count == (i64)element_count) {
            LLVMOpaqueType* tuple_ty = llvm_lower_type(ctx.ctx, ctx.types, expected_type);
            LLVMOpaqueValue* tuple_slot = LLVMBuildAlloca(ctx.builder, tuple_ty, "tuple_lit");
            LLVMBuildStore(ctx.builder, LLVMConstNull(tuple_ty), tuple_slot);
            u32 elems_start = expr.inner1;
            i64 i = 0;
            while (i < (i64)element_count) {
                u32 elem_id = ctx.pool.args.get((i64)elems_start + 1 + i);
                u32 elem_type = ctx.types.type_args.get(expected_entry.inner + (u32)i);
                u32 saved_expected = ctx.expected_type_id;
                ctx.expected_type_id = elem_type;
                LLVMOpaqueValue* elem_val = llvm_emit_expr(ctx, elem_id);
                ctx.expected_type_id = saved_expected;
                if (elem_val == (LLVMOpaqueValue*)0) {
                    ctx.note_unresolved("tuple-element", "literal");
                    return (LLVMOpaqueValue*)0;
                }
                elem_val = llvm_compat_value(ctx, elem_val, llvm_expr_type(ctx, elem_id), elem_type);
                LLVMOpaqueValue* field = LLVMBuildStructGEP2(ctx.builder, tuple_ty, tuple_slot, (u32)i, "tuple_field");
                LLVMBuildStore(ctx.builder, elem_val, field);
                i += 1;
            }
            return LLVMBuildLoad2(ctx.builder, tuple_ty, tuple_slot, "tuple_value");
        }
        u32 arr_type = expected_entry.kind == TypeKind.Array
            ? expected_type : llvm_expr_type(ctx, expr_id);
        TypeEntry* entry = ctx.types.get(arr_type);
        if (entry.kind != TypeKind.Array) { return (LLVMOpaqueValue*)0; }
        u32 elem_type = entry.inner;
        if (elem_type == 0 || elem_type == TYPE_UNKNOWN) {
            ctx.note_unresolved("array-elem", "unknown element type");
            return (LLVMOpaqueValue*)0;
        }
        LLVMOpaqueType* arr_ty = llvm_lower_type(ctx.ctx, ctx.types, arr_type);
        LLVMOpaqueType* elem_ty = llvm_lower_type(ctx.ctx, ctx.types, elem_type);
        LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, arr_ty, "arr_lit");
        LLVMBuildStore(ctx.builder, LLVMConstNull(arr_ty), slot);
        LLVMOpaqueValue* base = LLVMBuildBitCast(ctx.builder, slot, LLVMPointerTypeInContext(ctx.ctx, (u32)0), "arr_lit_ptr");
        u32 scalar_type = arr_type;
        i64 scalar_capacity = 1;
        while (ctx.types.get(scalar_type).kind == TypeKind.Array) {
            TypeEntry* dimension = ctx.types.get(scalar_type);
            scalar_capacity = scalar_capacity * dimension.count;
            scalar_type = dimension.inner;
        }
        LLVMOpaqueType* scalar_ty = llvm_lower_type(ctx.ctx, ctx.types, scalar_type);
        LLVMOpaqueValue* scalar_base = LLVMBuildBitCast(ctx.builder, slot,
            LLVMPointerTypeInContext(ctx.ctx, (u32)0), "arr_lit_scalar_ptr");
        i64 scalar_per_element = scalar_capacity / entry.count;
        u32 elems_start = expr.inner1;
        i64 i = 0;
        i64 flat_index = 0;
        while (i < (i64)element_count) {
            u32 elem_id = ctx.pool.args.get((i64)elems_start + 1 + i);
            AstExpr* element = ctx.pool.get_expr(elem_id);
            TypeEntry* expected_element = ctx.types.get(elem_type);
            if (expected_element.kind == TypeKind.Array
                && element.kind == ExprKind.ArrayLit) {
                i64 nested_index = flat_index / scalar_per_element;
                if (flat_index % scalar_per_element != 0) {
                    nested_index += 1;
                }
                if (nested_index >= entry.count) {
                    ctx.note_unresolved("array-elem", "too many initializers");
                    return (LLVMOpaqueValue*)0;
                }
                u32 saved_expected = ctx.expected_type_id;
                ctx.expected_type_id = elem_type;
                LLVMOpaqueValue* nested_ptr = llvm_emit_expr(ctx, elem_id);
                ctx.expected_type_id = saved_expected;
                if (nested_ptr == (LLVMOpaqueValue*)0) {
                    ctx.note_unresolved("array-elem", "nested literal");
                    return (LLVMOpaqueValue*)0;
                }
                LLVMOpaqueType* nested_ty = llvm_lower_type(ctx.ctx, ctx.types, elem_type);
                LLVMOpaqueValue* nested_val = LLVMBuildLoad2(ctx.builder, nested_ty,
                    nested_ptr, "nested_array_value");
                LLVMOpaqueValue* idx = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx),
                    (u64)nested_index, 0);
                LLVMOpaqueValue* elem_ptr = LLVMBuildGEP2(ctx.builder, elem_ty,
                    base, &idx, 1, "nested_array_gep");
                LLVMBuildStore(ctx.builder, nested_val, elem_ptr);
                flat_index = (nested_index + 1) * scalar_per_element;
            } else {
                if (flat_index >= scalar_capacity) {
                    ctx.note_unresolved("array-elem", "too many initializers");
                    return (LLVMOpaqueValue*)0;
                }
                u32 saved_expected = ctx.expected_type_id;
                ctx.expected_type_id = scalar_type;
                LLVMOpaqueValue* elem_val = llvm_emit_expr(ctx, elem_id);
                ctx.expected_type_id = saved_expected;
                if (elem_val == (LLVMOpaqueValue*)0) {
                    ctx.note_unresolved("array-elem", "literal");
                    return (LLVMOpaqueValue*)0;
                }
                elem_val = llvm_compat_value(ctx, elem_val,
                    llvm_expr_type(ctx, elem_id), scalar_type);
                LLVMOpaqueValue* idx = LLVMConstInt(LLVMInt64TypeInContext(ctx.ctx),
                    (u64)flat_index, 0);
                LLVMOpaqueValue* elem_ptr = LLVMBuildGEP2(ctx.builder, scalar_ty,
                    scalar_base, &idx, 1, "arr_lit_gep");
                LLVMBuildStore(ctx.builder, elem_val, elem_ptr);
                flat_index += 1;
            }
            i += 1;
        }
        return base;
    }

    if (expr.kind == ExprKind.MethodCall) {
        AstExpr* receiver = ctx.pool.get_expr(expr.inner0);
        u32 method_name_id = expr.aux;
        str method_name = ctx.names.get(method_name_id);
        if (receiver.kind == ExprKind.Var) {
            LlvmLocal* existing = ctx.find_local(receiver.aux);
            if (existing == (LlvmLocal*)0) {
                str receiver_name = ctx.names.get(receiver.aux);
                String base = String.new();
                i64 base_index = 0;
                while (receiver_name[base_index] != (u8)0 && receiver_name[base_index] != (u8)60) {
                    base.push(receiver_name[base_index]);
                    base_index += 1;
                }
                SyntaxNode* enum_item = find_enum_item(ctx.root, base.to_str());
                if (enum_item != (SyntaxNode*)0
                    && !impl_has_static_method(ctx.root, base.to_str(), method_name)) {
                    Vec<SyntaxNode*> variant_names = Vec<SyntaxNode*>.new();
                    Vec<i64> variant_tags = Vec<i64>.new();
                    Vec<i64> variant_arities = Vec<i64>.new();
                    enum_each_variant(enum_item, &variant_names, &variant_tags, &variant_arities);
                    u32 args_start = expr.inner1;
                    u32 args_count = ctx.pool.args.get((i64)args_start);
                    LLVMOpaqueValue* built = (LLVMOpaqueValue*)0;
                    i64 variant_index = 0;
                    while (variant_index < variant_names.len()) {
                        if (method_matches_variant(method_name, variant_names.get(variant_index).text)) {
                            built = llvm_emit_enum_build(ctx, receiver_name,
                                                         variant_names.get(variant_index).text,
                                                         args_start + 1, args_count);
                            break;
                        }
                        variant_index += 1;
                    }
                    variant_names.drop();
                    variant_tags.drop();
                    variant_arities.drop();
                    base.drop();
                    if (built != (LLVMOpaqueValue*)0) {
                        return built;
                    }
                }
                base.drop();
            }
        }
        str struct_name = "";
        u32 receiver_type_id = TYPE_UNKNOWN;
        bool is_instance = false;
        bool rx_is_ptr = false;
        if (receiver.kind == ExprKind.Var) {
            LlvmLocal* loc = ctx.find_local(receiver.aux);
            if (loc != (LlvmLocal*)0) {
                is_instance = true;
                u32 rx_type = loc.type_id;
                TypeEntry* entry = ctx.types.get(rx_type);
                while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                    rx_type = entry.inner;
                    rx_is_ptr = true;
                    entry = ctx.types.get(rx_type);
                }
                receiver_type_id = rx_type;
                struct_name = ctx.types.type_name(rx_type);
            } else {
                // Not a local: it may be a global (e.g. STDOUT) or a type name.
                // Resolve the global's declared type so method mangling uses the
                // TYPE name (BufWriter__write_str), never the variable's name.
                str receiver_name = ctx.names.get(receiver.aux);
                LlvmSymbolInfo info = ctx.lookup_symbol(receiver_name);
                if (info.is_global && info.type_id != TYPE_UNKNOWN) {
                    is_instance = true;
                    u32 rx_type = info.type_id;
                    TypeEntry* entry = ctx.types.get(rx_type);
                    while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                        rx_type = entry.inner;
                        rx_is_ptr = true;
                        entry = ctx.types.get(rx_type);
                    }
                    receiver_type_id = rx_type;
                    struct_name = ctx.types.type_name(rx_type);
                } else {
                    struct_name = receiver_name;
                    receiver_type_id = type_id_from_text(ctx.types, receiver_name);
                    if (receiver.inferred_type != TYPE_UNKNOWN && receiver.inferred_type != 0) {
                        receiver_type_id = ctx.types.resolve_subst(receiver.inferred_type);
                    }
                    u32 expected_type_id = ctx.types.resolve_subst(ctx.expected_type_id);
                    TypeEntry* expected_entry = ctx.types.get(expected_type_id);
                    TypeEntry* receiver_entry = ctx.types.get(receiver_type_id);
                    if (expected_entry.kind == TypeKind.Named && expected_entry.count > 0
                        && (receiver_type_id == TYPE_UNKNOWN
                            || (receiver_entry.kind == TypeKind.Named && receiver_entry.count == 0))) {
                        str expected_name = ctx.types.names.get(expected_entry.name_id);
                        i64 base_len = 0;
                        while (receiver_name[base_len] != (u8)0
                            && receiver_name[base_len] != (u8)60) {
                            base_len += 1;
                        }
                        bool same_base = strlen(expected_name) == base_len;
                        i64 base_index = 0;
                        while (same_base && base_index < base_len) {
                            if (receiver_name[base_index] != (u8)expected_name[base_index]) {
                                same_base = false;
                            }
                            base_index += 1;
                        }
                        if (same_base) {
                            receiver_type_id = expected_type_id;
                            struct_name = ctx.types.type_name(expected_type_id);
                        }
                    }
                }
            }
        } else {
            is_instance = true;
            u32 rx_type = llvm_expr_type(ctx, expr.inner0);
            TypeEntry* entry = ctx.types.get(rx_type);
            while (entry.kind == TypeKind.Pointer || entry.kind == TypeKind.Reference) {
                rx_type = entry.inner;
                rx_is_ptr = true;
                entry = ctx.types.get(rx_type);
            }
            receiver_type_id = rx_type;
            struct_name = ctx.types.type_name(rx_type);
        }

        bool primitive_compare_type = type_is_signed_integer(receiver_type_id)
            || type_is_unsigned_integer(receiver_type_id)
            || type_is_float(receiver_type_id)
            || receiver_type_id == TYPE_BOOL || receiver_type_id == TYPE_CHAR
            || receiver_type_id == TYPE_STR;
        if (is_instance && strcmp(method_name, "compare") == 0 && primitive_compare_type) {
            u32 args_start = expr.inner1;
            u32 args_count = ctx.pool.args.get((i64)args_start);
            if (args_count == 1) {
                u32 other_expr_id = ctx.pool.args.get((i64)args_start + 1);
                expr.inferred_type = TYPE_I32;
                return llvm_emit_primitive_compare(ctx, expr.inner0, other_expr_id,
                                                   receiver_type_id, rx_is_ptr);
            }
        }

        bool str_slice_receiver = is_instance && receiver_type_id == TYPE_STR
            && !impl_has_instance_method(ctx.root, "str", method_name);
        if (str_slice_receiver) {
            receiver_type_id = typecheck_slice_result_type(ctx.types, ctx.root, TYPE_STR);
            struct_name = ctx.types.type_name(receiver_type_id);
            rx_is_ptr = true;
        }

        // Specialized instance first: declare (or fetch) `Base__method__Args`
        // for this concrete receiver and queue its body for the drain step.
        LLVMOpaqueValue* fn_val = (LLVMOpaqueValue*)0;
        TypeEntry* receiver_type = ctx.types.get(receiver_type_id);
        if (receiver_type.kind == TypeKind.Named && receiver_type.count > 0) {
            i64 unresolved_before = ctx.unresolved_calls;
            fn_val = mono_ensure_specialized(ctx, receiver_type_id, method_name);
            if (ctx.unresolved_calls > unresolved_before) {
                return (LLVMOpaqueValue*)0;
            }
        }
        String base_name = String.new();
        String mangled = String.new();
        if (fn_val == (LLVMOpaqueValue*)0) {
            // Strip generic arguments from the receiver name so impl<T> methods
            // (declared as Struct__method) are found for Struct<T> receivers.
            i64 bn = 0;
            while (bn < (i64)strlen(struct_name) && struct_name[bn] != (u8)60) {
                base_name.push(struct_name[bn]);
                bn += 1;
            }
            String method_symbol = typecheck_method_symbol_for_call(
                ctx.pool, ctx.root, ctx.types, receiver_type_id, method_name,
                expr.inner1, !is_instance);
            mangled.push_str(method_symbol.to_str());
            method_symbol.drop();
            fn_val = LLVMGetNamedFunction(ctx.module, mangled.to_str());

            if (fn_val == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("method", mangled.to_str());
                mangled.drop();
                base_name.drop();
                return (LLVMOpaqueValue*)0;
            }
        }
        mangled.drop();
        base_name.drop();

        Vec<LLVMOpaqueValue*> call_args = Vec<LLVMOpaqueValue*>.new();
        Vec<u32> call_arg_types = Vec<u32>.new();
        Vec<u32> call_target_types = Vec<u32>.new();
        Vec<LLVMOpaqueValue*> borrowed_temp_ptrs = Vec<LLVMOpaqueValue*>.new();
        Vec<u32> borrowed_temp_types = Vec<u32>.new();
        bool rx_moved = false;
        if (is_instance) {
            u32 rx_type = llvm_expr_type(ctx, expr.inner0);
            if (rx_type == TYPE_UNKNOWN) { rx_type = receiver_type_id; }
            if (str_slice_receiver) { rx_type = receiver_type_id; }
            // A by-value `self` moves the receiver into the callee; record
            // the transfer below so the caller side is not dropped again.
            LLVMOpaqueValue* rx_val = str_slice_receiver
                ? llvm_emit_str_as_slice_ptr(ctx, expr.inner0)
                : (rx_is_ptr ? llvm_emit_expr(ctx, expr.inner0) : llvm_emit_lvalue(ctx, expr.inner0));
            if (rx_val == (LLVMOpaqueValue*)0 && !rx_is_ptr) {
                LLVMOpaqueValue* val = llvm_emit_expr(ctx, expr.inner0);
                if (val != (LLVMOpaqueValue*)0) {
                    LLVMOpaqueType* val_ty = llvm_lower_type(ctx.ctx, ctx.types, rx_type);
                    LLVMOpaqueValue* tmp = LLVMBuildAlloca(ctx.builder, val_ty, "method_rx_tmp");
                    LLVMBuildStore(ctx.builder, val, tmp);
                    rx_val = tmp;
                }
            }
            if (rx_val == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("method-receiver", method_name);
                u32 fallback_rx_type = rx_type;
                if (fallback_rx_type == TYPE_UNKNOWN) { fallback_rx_type = TYPE_I64; }
                if (!rx_is_ptr) { fallback_rx_type = ctx.types.get_pointer(fallback_rx_type, true); }
                LLVMOpaqueType* rx_llvm_ty = llvm_lower_type(ctx.ctx, ctx.types, fallback_rx_type);
                rx_val = LLVMConstNull(rx_llvm_ty);
            }
            // Normalize to what the callee actually takes: by-value self
            // (struct/array/int) needs the loaded value, but locals and
            // rvalue spills hand us the address. Without this the call
            // silently degrades to null in llvm_prepare_call_args
            // (Optional::unwrap received zeroinitializer and took None).
            LLVMOpaqueType* callee_ty = LLVMGlobalGetValueType(fn_val);
            u32 callee_param_count = LLVMCountParamTypes(callee_ty);
            if (callee_param_count > 0 && rx_val != (LLVMOpaqueValue*)0) {
                Vec<LLVMOpaqueType*> callee_params = Vec<LLVMOpaqueType*>.new();
                u32 ppi = 0;
                while (ppi < callee_param_count) {
                    callee_params.push((LLVMOpaqueType*)0);
                    ppi += 1;
                }
                LLVMGetParamTypes(callee_ty, callee_params.get_ptr(0));
                LLVMOpaqueType* self_ty = callee_params.get(0);
                callee_params.drop();
                if (LLVMGetTypeKind(self_ty) != (u32)12
                    && LLVMGetTypeKind(LLVMTypeOf(rx_val)) == (u32)12) {
                    rx_val = LLVMBuildLoad2(ctx.builder, self_ty, rx_val, "method_rx_val");
                    rx_moved = true;
                }
            }
            call_args.push(rx_val);
            call_arg_types.push(rx_type);
            call_target_types.push(TYPE_UNKNOWN);
        }

        u32 args_start = expr.inner1;
        u32 args_count = ctx.pool.args.get((i64)args_start);
        u32 param_count = LLVMCountParamTypes(LLVMGlobalGetValueType(fn_val));
        Vec<LLVMOpaqueType*> param_types = Vec<LLVMOpaqueType*>.new();
        i64 i = 0;
        while (i < (i64)param_count) {
            param_types.push((LLVMOpaqueType*)0);
            i += 1;
        }
        if (param_count > 0) {
            LLVMGetParamTypes(LLVMGlobalGetValueType(fn_val), param_types.data);
        }
        bool variadic_method = false;
        u32 variadic_element_type = TYPE_UNKNOWN;
        if (param_count > 0) {
            variadic_element_type = typecheck_method_parameter_type_for_call(
                ctx.pool, ctx.root, ctx.types, receiver_type_id, method_name,
                (i64)args_count + (is_instance ? 1 : 0), args_start,
                !is_instance, (i64)param_count - 1, &variadic_method);
        }
        bool operator_method = strlen(method_name) >= 2
            && method_name[0] == (u8)'_' && method_name[1] == (u8)'_';
        i = 0;
        while (i < (i64)args_count) {
            u32 arg_id = ctx.pool.args.get((i64)args_start + 1 + i);
            u32 param_index = (is_instance ? (u32)1 : (u32)0) + (u32)i;
            u32 arg_type = ctx.types.resolve_subst(llvm_expr_type(ctx, arg_id));
            AstExpr* argument = ctx.pool.get_expr(arg_id);
            u32 expected_arg_type = typecheck_method_parameter_type_for_call(
                ctx.pool, ctx.root, ctx.types, receiver_type_id, method_name,
                (i64)args_count + (is_instance ? 1 : 0), args_start,
                !is_instance, (i64)param_index, (bool*)0);
            u32 unwrapped_arg_type = arg_type;
            TypeEntry* unwrapped_arg = ctx.types.get(unwrapped_arg_type);
            while (unwrapped_arg.kind == TypeKind.Pointer
                || unwrapped_arg.kind == TypeKind.Reference) {
                unwrapped_arg_type = unwrapped_arg.inner;
                unwrapped_arg = ctx.types.get(unwrapped_arg_type);
            }
            bool str_prefix_as_slice = str_slice_receiver
                && strcmp(method_name, "starts_with_slice") == 0
                && unwrapped_arg_type == TYPE_STR;
            if (str_prefix_as_slice) {
                expected_arg_type = typecheck_slice_result_type(
                    ctx.types, ctx.root, TYPE_STR);
            }
            bool tuple_arg = false;
            if (expected_arg_type != TYPE_UNKNOWN) {
                expected_arg_type = ctx.types.resolve_subst(expected_arg_type);
                TypeEntry* expected_entry = ctx.types.get(expected_arg_type);
                tuple_arg = argument.kind == ExprKind.ArrayLit
                    && expected_entry.kind == TypeKind.Tuple
                    && expected_entry.count == (i64)argument.aux;
                if (tuple_arg) {
                    arg_type = expected_arg_type;
                }
            }
            bool slice_coercion = expected_arg_type != TYPE_UNKNOWN
                && expected_arg_type != arg_type
                && typecheck_slice_argument_coercion(
                    ctx.types, expected_arg_type, arg_type);
            TypeEntry* arg_entry = ctx.types.get(arg_type);
            bool arg_is_indirect = arg_entry.kind == TypeKind.Pointer
                || arg_entry.kind == TypeKind.Reference;
            bool expects_reference = param_index < param_count
                && LLVMGetTypeKind(param_types.get(param_index)) == (u32)12;
            LLVMOpaqueValue* a_val = (LLVMOpaqueValue*)0;
            u32 saved_expected = ctx.expected_type_id;
            if (tuple_arg) {
                ctx.expected_type_id = expected_arg_type;
            }
            bool explicit_borrow = argument.kind == ExprKind.Unary
                && argument.aux == (u32)TokenKind.BitwiseAnd;
            bool borrow_temporary = expects_reference
                && ((operator_method && !arg_is_indirect && arg_type != TYPE_STR)
                    || (arg_is_indirect && explicit_borrow));
            if (str_prefix_as_slice) {
                a_val = llvm_emit_str_as_slice_value(ctx, arg_id);
                arg_type = expected_arg_type;
            } else if (slice_coercion) {
                LLVMOpaqueValue* slice_temp_ptr = (LLVMOpaqueValue*)0;
                u32 slice_temp_type = TYPE_UNKNOWN;
                a_val = llvm_emit_slice_argument(ctx, arg_id, expected_arg_type,
                    &slice_temp_ptr, &slice_temp_type);
                if (slice_temp_ptr != (LLVMOpaqueValue*)0) {
                    borrowed_temp_ptrs.push(slice_temp_ptr);
                    borrowed_temp_types.push(slice_temp_type);
                }
                if (a_val == (LLVMOpaqueValue*)0) {
                    ctx.note_unresolved("slice-argument", method_name);
                    a_val = LLVMConstNull(llvm_lower_type(
                        ctx.ctx, ctx.types, expected_arg_type));
                }
                arg_type = expected_arg_type;
            } else if (borrow_temporary) {
                u32 borrowed_expr_id = explicit_borrow ? argument.inner0 : arg_id;
                a_val = llvm_emit_lvalue(ctx, borrowed_expr_id);
                if (a_val == (LLVMOpaqueValue*)0) {
                    u32 borrowed_type = llvm_expr_type(ctx, borrowed_expr_id);
                    LLVMOpaqueValue* value = llvm_emit_expr(ctx, borrowed_expr_id);
                    if (value != (LLVMOpaqueValue*)0) {
                        LLVMOpaqueType* value_type = llvm_lower_type(
                            ctx.ctx, ctx.types, borrowed_type);
                        a_val = LLVMBuildAlloca(ctx.builder, value_type,
                                                "method_arg_tmp");
                        LLVMBuildStore(ctx.builder, value, a_val);
                        borrowed_temp_ptrs.push(a_val);
                        borrowed_temp_types.push(borrowed_type);
                    }
                }
            } else {
                a_val = llvm_emit_expr(ctx, arg_id);
            }
            ctx.expected_type_id = saved_expected;
            if (a_val == (LLVMOpaqueValue*)0) {
                ctx.note_unresolved("method-arg", method_name);
                u32 a_type = arg_type;
                if (a_type == TYPE_UNKNOWN) { a_type = TYPE_I64; }
                LLVMOpaqueType* a_llvm_ty = llvm_lower_type(ctx.ctx, ctx.types, a_type);
                a_val = LLVMConstNull(a_llvm_ty);
            }
            call_args.push(a_val);
            call_arg_types.push(arg_type);
            call_target_types.push(TYPE_UNKNOWN);
            i += 1;
        }

        if (variadic_method) {
            llvm_pack_variadic_call_args(ctx, (i64)param_count - 1,
                variadic_element_type, &call_args, &call_arg_types,
                &call_target_types, method_name);
        }

        LLVMOpaqueType* fn_type = LLVMGlobalGetValueType(fn_val);
        llvm_prepare_call_args(ctx, fn_type, &call_args, &call_arg_types,
                              &call_target_types, method_name);
        LLVMOpaqueValue* res = LLVMBuildCall2(ctx.builder, fn_type, fn_val, call_args.data, (u32)call_args.len(), "");
        i64 temp_index = 0;
        while (temp_index < borrowed_temp_ptrs.len()) {
            llvm_emit_value_drop_at_ptr(ctx, borrowed_temp_ptrs.get(temp_index),
                                        borrowed_temp_types.get(temp_index));
            temp_index += 1;
        }
        // Ownership transfer: a by-value receiver moves into the callee, as
        // does any by-value argument (proven by the callee parameter kind).
        // Borrowed positions keep the caller side live. An explicit `drop`
        // call always consumes its receiver, mirroring stage0.
        if (is_instance && rx_moved) {
            llvm_clear_place_drops(ctx, expr.inner0);
        }
        if (strcmp(method_name, "drop") == 0 && is_instance) {
            llvm_clear_place_drops(ctx, expr.inner0);
        }
        i64 cleared = 0;
        while (cleared < (i64)args_count) {
            u32 cleared_arg_id = ctx.pool.args.get((i64)args_start + 1 + cleared);
            i64 cleared_param = is_instance ? cleared + 1 : cleared;
            llvm_clear_transferred_arg(ctx, fn_type, cleared_param, cleared_arg_id);
            cleared += 1;
        }
        call_target_types.drop();
        call_arg_types.drop();
        call_args.drop();
        borrowed_temp_types.drop();
        borrowed_temp_ptrs.drop();
        param_types.drop();
        return res;
    }

    return (LLVMOpaqueValue*)0;
}
