// libs/agc/src/backend/llvm/generator.ag — LLVM backend generator orchestrator.
import vendor.llvm.llvm;
import std.fs;
import std.intern;
import std.io;
import std.mem.vec;
import std.string;
import frontend.ast;
import frontend.ast_expr;
import frontend.bindings;
import frontend.items;
import frontend.lower_expr;
import frontend.symbols;
import frontend.typecheck_expr;
import frontend.types;
