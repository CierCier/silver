bool llvm_item_is_generic_impl(SyntaxNode* impl_item) {
    SyntaxNode* child = impl_item.first_child;
    while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
        if (child.kind == NodeKind.Token
            && (child.token_kind == TokenKind.Less || strcmp(child.text, "<") == 0)) {
            return true;
        }
        child = child.next_sibling;
    }
    return false;
}

bool llvm_item_is_generic_enum(SyntaxNode* enum_item) {
    SyntaxNode* child = enum_item.first_child;
    while (child != (SyntaxNode*)0 && child.kind != NodeKind.Block) {
        if (child.kind == NodeKind.Token
            && (child.token_kind == TokenKind.Less || strcmp(child.text, "<") == 0)) {
            return true;
        }
        child = child.next_sibling;
    }
    return false;
}

bool llvm_item_is_generic_fn(SyntaxNode* fn_item) {
    SyntaxNode* id_node = function_identifier(fn_item);
    if (id_node == (SyntaxNode*)0) { return false; }
    SyntaxNode* scan = id_node.next_sibling;
    while (scan != (SyntaxNode*)0 && scan.kind != NodeKind.Parenthesized) {
        if (scan.kind == NodeKind.Token && (scan.token_kind == TokenKind.Less || strcmp(scan.text, "<") == 0)) {
            return true;
        }
        scan = scan.next_sibling;
    }
    return false;
}

String llvm_free_function_symbol(TypeTable* types, SyntaxNode* root, SyntaxNode* function) {
    SyntaxNode* id_node = function_identifier(function);
    if (!typecheck_has_free_overloads(types, root, id_node.text)) {
        return String.from_str(id_node.text);
    }
    return typecheck_overloaded_free_symbol(types, id_node.text, function);
}

Vec<LLVMOpaqueType*> llvm_param_types(LlvmContext* ctx, TypeTable* types, Vec<Binding>* params, str self_type_name) {
    Vec<LLVMOpaqueType*> param_types = Vec<LLVMOpaqueType*>.new();
    i64 p = 0;
    while (p < params.len()) {
        Binding* param = params.get_ptr(p);
        bool exact_function_type = binding_has_function_type(param);
        String dec_str = binding_parameter_type_text(param);
        str type_str = dec_str.to_str();
        if (self_type_name != (str)0 && (strcmp(type_str, "Self") == 0 || (strcmp(param.name, "self") == 0 && strlen(type_str) == 0))) {
            type_str = self_type_name;
        }
        u32 param_type_id = types.parse_type_name(type_str);
        if (binding_is_variadic_parameter(param)
            || param.declared_type.kind == ProjectionTypeKind.Array) {
            param_type_id = types.resolve_subst(typecheck_parameter_type_id(types, param));
        }
        if (param_type_id == TYPE_UNKNOWN) {
            ctx.note_unresolved("parameter-type", param.name);
            param_type_id = TYPE_I64;
        } else if (!binding_is_variadic_parameter(param) && !exact_function_type
            && (param.declared_type.kind == ProjectionTypeKind.Pointer
                || param.declared_type.kind == ProjectionTypeKind.Reference || param_type_id == TYPE_VOID)) {
            param_type_id = types.get_pointer(param_type_id, true);
        }
        param_types.push(llvm_lower_type(ctx.ctx, types, param_type_id));
        dec_str.drop();
        p += 1;
    }
    return move param_types;
}

void llvm_emit_entry_point(LLVMOpaqueContext* ctx, LLVMOpaqueModule* module, LLVMOpaqueBuilder* builder) {
    if (LLVMGetNamedFunction(module, "_start") != (LLVMOpaqueValue*)0) {
        return;
    }
    if (LLVMGetNamedFunction(module, "main") == (LLVMOpaqueValue*)0) {
        return;
    }
    LLVMOpaqueType* void_ty = LLVMVoidTypeInContext(ctx);
    LLVMOpaqueType* fn_ty = LLVMFunctionType(void_ty, (LLVMOpaqueType**)0, 0, 0);
    LLVMOpaqueValue* start_fn = LLVMAddFunction(module, "_start", fn_ty);
    LLVMOpaqueBasicBlock* bb = LLVMAppendBasicBlockInContext(ctx, start_fn, "entry");
    LLVMPositionBuilderAtEnd(builder, bb);

    str asm_text = "
        .section .bss
        .balign 4
        .globl __silver_argc
        __silver_argc: .zero 4
        .balign 8
        .globl __silver_argv
        __silver_argv: .zero 8
        .globl __silver_envp
        __silver_envp: .zero 8
        .text
        .globl _start
        test %rbp, %rbp
        jz 1f
        lea 8(%rbp), %r11
        jmp 2f
        1:
        mov %rsp, %r11
        2:
        xor %ebp, %ebp
        mov (%r11), %rdi
        lea 8(%r11), %rsi
        mov %edi, __silver_argc(%rip)
        mov %rsi, __silver_argv(%rip)
        lea 16(%r11,%rdi,8), %rdx
        mov %rdx, __silver_envp(%rip)
        and $$-16, %rsp
        call main
        mov %rax, %rdi
        mov $$231, %eax
        syscall
    ";
    str constraints = "";
    LLVMOpaqueValue* asm_val = LLVMGetInlineAsm(
        fn_ty,
        (i8*)asm_text,
        (u64)strlen(asm_text),
        (i8*)constraints,
        0,
        1,
        0,
        0,
        0
    );
    LLVMBuildCall2(builder, fn_ty, asm_val, (LLVMOpaqueValue**)0, 0, "");
    LLVMBuildRetVoid(builder);
}

// Define one specialized generic method instance under an already-declared
// symbol, with substitution frames active (pushed by the caller). Structural
// twin of the Pass2 method block below; keep in sync.
bool llvm_define_method_instance(LlvmContext* ctx, TypeTable* types, Interner* names, AstPool* pool, str struct_name, LLVMOpaqueValue* fn_val, SyntaxNode* ret_start, SyntaxNode* method_name_node, SyntaxNode* params_node, SyntaxNode* body_node, Vec<u32>* arg_ids) {
    if (fn_val == (LLVMOpaqueValue*)0 || LLVMCountBasicBlocks(fn_val) > 0) {
        return false;
    }
    u32 self_instance_id = types.get_named_args(struct_name, arg_ids);
    SyntaxNode* rscan = ret_start;
    while (rscan != (SyntaxNode*)0 && rscan != method_name_node) {
        if (rscan.kind == NodeKind.Token && rscan.text == "#") {
            rscan = rscan.next_sibling;
            if (rscan != (SyntaxNode*)0 && rscan.kind == NodeKind.Bracket) {
                rscan = rscan.next_sibling;
            }
            continue;
        }
        if (rscan.kind == NodeKind.Token && (rscan.text == "pub" || rscan.text == "static")) {
            rscan = rscan.next_sibling;
            continue;
        }
        break;
    }
    String ret_str = String.new();
    while (rscan != (SyntaxNode*)0 && rscan != method_name_node) {
        append_node_tokens(rscan, &ret_str);
        rscan = rscan.next_sibling;
    }
    u32 ret_type_id = TYPE_UNKNOWN;
    if (strcmp(ret_str.to_str(), "Self") == 0) {
        ret_type_id = self_instance_id;
    } else {
        ret_type_id = types.resolve_subst(type_id_from_text(types, ret_str.to_str()));
    }
    ret_str.drop();
    mono_ensure_child_layouts(ctx, ret_type_id, &ctx.generic_layout_ids);
    ctx.current_fn = fn_val;
    ctx.current_return_type = ret_type_id;
    LLVMOpaqueBasicBlock* entry_bb = LLVMAppendBasicBlockInContext(ctx.ctx, fn_val, "entry");
    LLVMPositionBuilderAtEnd(ctx.builder, entry_bb);
    ctx.push_scope();
    ctx.push_type_binding("Self", self_instance_id);
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(params_node, &params);
    i64 p = 0;
    while (p < params.len()) {
        Binding* param = params.get_ptr(p);
        u32 param_name_id = names.intern(param.name);
        bool exact_function_type = binding_has_function_type(param);
        String dec_str = binding_parameter_type_text(param);
        str type_str = dec_str.to_str();
        u32 param_type_id = TYPE_UNKNOWN;
        if (strcmp(type_str, "Self") == 0 || (strcmp(param.name, "self") == 0 && strlen(type_str) == 0)) {
            param_type_id = self_instance_id;
        } else {
            param_type_id = ctx.subst_type(type_str);
            if (param_type_id == TYPE_UNKNOWN) {
                param_type_id = types.parse_type_name(type_str);
            }
                        if (binding_is_variadic_parameter(param)) {
                            u32 element_type_id = typecheck_parameter_base_type_id(types, param);
                String element = typecheck_canonical_type(types, element_type_id, 0);
                String slice = String.from_str("Slice<");
                slice.push_str(element.to_str());
                slice.push('>');
                param_type_id = types.resolve_subst(types.parse_type_name(slice.to_str()));
                element.drop();
                slice.drop();
            }
            param_type_id = types.resolve_subst(param_type_id);
        }
        if (!binding_is_variadic_parameter(param) && !exact_function_type
            && (param.declared_type.kind == ProjectionTypeKind.Pointer
                || param.declared_type.kind == ProjectionTypeKind.Reference || param_type_id == TYPE_VOID)) {
            param_type_id = types.get_pointer(param_type_id, true);
        }
        mono_ensure_child_layouts(ctx, param_type_id, &ctx.generic_layout_ids);
        LLVMOpaqueType* param_llvm_type = llvm_lower_type(ctx.ctx, types, param_type_id);
        LLVMOpaqueValue* alloca_ptr = LLVMBuildAlloca(ctx.builder, param_llvm_type, param.name);
        LLVMOpaqueValue* param_val = LLVMGetParam(fn_val, (u32)p);
        LLVMBuildStore(ctx.builder, param_val, alloca_ptr);
        ctx.add_local(param_name_id, alloca_ptr, param_type_id, true);
        // By-value parameters arrive fully initialized: the callee owns them
        // and drops them on exit (the caller's side was cleared at the call).
        llvm_register_local_drops(ctx, param_name_id, alloca_ptr, param_type_id, true);
        dec_str.drop();
        p += 1;
    }
    params.drop();
    ExprLowerer lowerer = ExprLowerer.new(pool, types, names);
    lowerer.unit_root = ctx.root;
    lowerer.debug_mode = ctx.debug_mode;
    Vec<u32> stmt_ids = Vec<u32>.new();
    lowerer.lower_block(body_node, &stmt_ids);
    i64 s = 0;
    while (s < stmt_ids.len()) {
        llvm_emit_stmt(ctx, stmt_ids.get(s));
        if (ctx.is_terminated()) { break; }
        s += 1;
    }
    stmt_ids.drop();
    if (!ctx.is_terminated()) {
        llvm_emit_defers_above(ctx, (i64)0);
    }
    if (!ctx.is_terminated()) {
        llvm_emit_drops_above(ctx, (i64)0);
        if (ret_type_id == TYPE_VOID) {
            LLVMBuildRetVoid(ctx.builder);
        } else {
            LLVMOpaqueType* ret_llvm_type = llvm_lower_type(ctx.ctx, types, ret_type_id);
            LLVMBuildRet(ctx.builder, LLVMConstNull(ret_llvm_type));
        }
    }
    ctx.pop_type_bindings(1);
    ctx.pop_scope();
    return true;
}

bool llvm_define_free_function_instance(LlvmContext* ctx, TypeTable* types,
                                        Interner* names, AstPool* pool,
                                        LLVMOpaqueValue* fn_val, SyntaxNode* ret_start,
                                        SyntaxNode* name_node,
                                        SyntaxNode* params_node, SyntaxNode* body_node) {
    if (fn_val == (LLVMOpaqueValue*)0 || LLVMCountBasicBlocks(fn_val) > 0) {
        return false;
    }
    String ret_text = String.new();
    SyntaxNode* rscan = ret_start;
    while (rscan != (SyntaxNode*)0 && rscan != name_node) {
        if (rscan.kind == NodeKind.Token && rscan.text == "#") {
            rscan = rscan.next_sibling;
            if (rscan != (SyntaxNode*)0 && rscan.kind == NodeKind.Bracket) {
                rscan = rscan.next_sibling;
            }
            continue;
        }
        if (rscan.kind == NodeKind.Token && (rscan.text == "private" || rscan.text == "static")) {
            rscan = rscan.next_sibling;
            continue;
        }
        append_node_tokens(rscan, &ret_text);
        rscan = rscan.next_sibling;
    }
    u32 ret_id = types.resolve_subst(type_id_from_text(types, ret_text.to_str()));
    ret_text.drop();
    mono_ensure_child_layouts(ctx, ret_id, &ctx.generic_layout_ids);
    ctx.current_fn = fn_val;
    ctx.current_return_type = ret_id;
    LLVMOpaqueBasicBlock* entry = LLVMAppendBasicBlockInContext(ctx.ctx, fn_val, "entry");
    LLVMPositionBuilderAtEnd(ctx.builder, entry);
    ctx.push_scope();
    Vec<Binding> params = Vec<Binding>.new();
    collect_parameter_bindings(params_node, &params);
    i64 i = 0;
    while (i < params.len()) {
        Binding* param = params.get_ptr(i);
        String text = binding_parameter_type_text(param);
        bool exact_function_type = binding_has_function_type(param);
        u32 type_id = types.parse_type_name(text.to_str());
        if (binding_is_variadic_parameter(param)
            || param.declared_type.kind == ProjectionTypeKind.Array) {
            type_id = types.resolve_subst(typecheck_parameter_type_id(types, param));
        } else if (!exact_function_type
            && (param.declared_type.kind == ProjectionTypeKind.Pointer
                || param.declared_type.kind == ProjectionTypeKind.Reference || type_id == TYPE_VOID)) {
            type_id = types.get_pointer(type_id, true);
        }
        mono_ensure_child_layouts(ctx, type_id, &ctx.generic_layout_ids);
        LLVMOpaqueType* llvm_ty = llvm_lower_type(ctx.ctx, types, type_id);
        LLVMOpaqueValue* slot = LLVMBuildAlloca(ctx.builder, llvm_ty, param.name);
        LLVMBuildStore(ctx.builder, LLVMGetParam(fn_val, (u32)i), slot);
        ctx.add_local(names.intern(param.name), slot, type_id, true);
        llvm_register_local_drops(ctx, names.intern(param.name), slot, type_id, true);
        text.drop();
        i += 1;
    }
    params.drop();
    ExprLowerer lowerer = ExprLowerer.new(pool, types, names);
    lowerer.unit_root = ctx.root;
    lowerer.debug_mode = ctx.debug_mode;
    Vec<u32> statements = Vec<u32>.new();
    lowerer.lower_block(body_node, &statements);
    i = 0;
    while (i < statements.len()) {
        llvm_emit_stmt(ctx, statements.get(i));
        if (ctx.is_terminated()) { break; }
        i += 1;
    }
    statements.drop();
    if (!ctx.is_terminated()) {
        llvm_emit_defers_above(ctx, (i64)0);
    }
    if (!ctx.is_terminated()) {
        llvm_emit_drops_above(ctx, (i64)0);
        if (ret_id == TYPE_VOID) {
            LLVMBuildRetVoid(ctx.builder);
        } else {
            LLVMBuildRet(ctx.builder, LLVMConstNull(llvm_lower_type(ctx.ctx, types, ret_id)));
        }
    }
    ctx.pop_scope();
    return true;
}

// Define all queued specializations. Nested generic calls discovered during
// definition are declared and queued inline by expression lowering, so the
// loop runs to fixpoint; the 4096-instance cap fails closed instead.
// (The full compiler needs ~300 instances; the old 256 cap was sized for
// small programs and broke the stage2 self-build with 20 distinct
// monomorph-cap notes and zero duplicates.)
void llvm_drain_mono_queue(LlvmContext* ctx, TypeTable* types, Interner* names, AstPool* pool) {
    i64 index = 0;
    while (index < ctx.mono_queue.len()) {
        MonoRequest* req_ptr = ctx.mono_queue.get_ptr(index);
        u32 base_id = req_ptr.base_id;
        u32 method_id = req_ptr.method_id;
        u32 mangled_id = req_ptr.mangled_id;
        u32 args_start = req_ptr.args_start;
        u32 args_count = req_ptr.args_count;
        u32 value_arg_count = req_ptr.value_arg_count;
        index += 1;
        str base = ctx.names.get(base_id);
        str method = req_ptr.is_free_function ? (str)0 : ctx.names.get(method_id);
        bool is_free_function = req_ptr.is_free_function;
        str mangled = ctx.names.get(mangled_id);
        LLVMOpaqueValue* fn_val = LLVMGetNamedFunction(ctx.module, mangled);
        if (fn_val == (LLVMOpaqueValue*)0) {
            ctx.note_unresolved("monomorph-instance", mangled);
            continue;
        }
        if (LLVMCountBasicBlocks(fn_val) > 0) {
            continue;
        }
        ctx.mono_count = ctx.mono_count + 1;
        if (ctx.mono_count > 4096) {
            ctx.note_unresolved("monomorph-cap", mangled);
            continue;
        }
        MonoMethodTemplate template;
        Vec<u32> param_ids = Vec<u32>.new();
        Vec<u32> arg_ids = Vec<u32>.new();
        i64 k = 0;
        while (k < (i64)args_count) {
            arg_ids.push(ctx.mono_queue_args.get((i64)args_start + k));
            k += 1;
        }
        bool found = is_free_function
            ? mono_find_function_template(ctx.root, types, base, value_arg_count, &template, &param_ids)
            : mono_find_method_template(ctx.root, types, base, method, &arg_ids, &template, &param_ids);
        if (found && (param_ids.len() == arg_ids.len() || param_ids.len() == 0)) {
            i64 b = 0;
            while (b < param_ids.len()) {
                u32 param_id = param_ids.get(b);
                u32 arg_id = arg_ids.get(b);
                types.push_subst(param_id, arg_id);
                ctx.push_type_binding(types.names.get(param_id), arg_id);
                b += 1;
            }
            bool defined = is_free_function
                ? llvm_define_free_function_instance(ctx, types, names, pool, fn_val, template.ret_start, template.name_node, template.params_node, template.body_node)
                : llvm_define_method_instance(ctx, types, names, pool, base, fn_val, template.ret_start, template.name_node, template.params_node, template.body_node, &arg_ids);
            if (!defined) {
                ctx.note_unresolved("monomorph-body", mangled);
            }
            types.pop_subst(param_ids.len());
            ctx.pop_type_bindings(param_ids.len());
        } else {
            ctx.note_unresolved("monomorph-template", mangled);
        }
        param_ids.drop();
        arg_ids.drop();
    }
}

String llvm_const_global_literal_prefix(str global_name, str kind, i64 index) {
    String prefix = String.from_str(global_name);
    prefix.push((u8)'.');
    prefix.push_str(kind);
    prefix.push((u8)'.');
    String digits = String.new();
    i64 value = index;
    if (value == 0) { digits.push((u8)'0'); }
    while (value > 0) {
        digits.push((u8)('0' + (value % 10)));
        value = value / 10;
    }
    i64 left = 0;
    i64 right = digits.len() - 1;
    while (left < right) {
        u8 temp = digits.data[left];
        digits.data[left] = digits.data[right];
        digits.data[right] = temp;
        left += 1;
        right -= 1;
    }
    prefix.push_str(digits.to_str());
    digits.drop();
    return move prefix;
}

LLVMOpaqueValue* llvm_const_bytes_global(LLVMOpaqueContext* raw_ctx,
    LLVMOpaqueModule* module, i8* bytes, u64 length, str global_prefix,
    i32 null_terminate) {
    LLVMOpaqueValue* literal = LLVMConstStringInContext2(raw_ctx,
        bytes, length, null_terminate);
    String literal_name = String.from_str(global_prefix);
    literal_name.push_str(".literal");
    LLVMOpaqueValue* global = LLVMAddGlobal(module, LLVMTypeOf(literal), literal_name.to_str());
    literal_name.drop();
    LLVMSetInitializer(global, literal);
    LLVMSetGlobalConstant(global, 1);
    LLVMSetLinkage(global, LLVMLinkage.LLVMPrivateLinkage);
    return global;
}

LLVMOpaqueValue* llvm_const_string_global(LLVMOpaqueContext* raw_ctx,
    LLVMOpaqueModule* module, str literal_text, str global_prefix) {
    String decoded = unescape_string_literal(literal_text);
    LLVMOpaqueValue* global = llvm_const_bytes_global(raw_ctx, module,
        (i8*)decoded.data, (u64)decoded.len(), global_prefix, 0);
    decoded.drop();
    return global;
}

LLVMOpaqueValue* llvm_const_pointer_literal(LLVMOpaqueContext* raw_ctx,
    LLVMOpaqueType* pointer_type, i64 value) {
    if (value == 0) { return LLVMConstNull(pointer_type); }
    LLVMOpaqueType* integer_type = LLVMInt64TypeInContext(raw_ctx);
    LLVMOpaqueValue* integer = LLVMConstInt(integer_type, (u64)value, 1);
    return LLVMConstIntToPtr(integer, pointer_type);
}

// Lower one aggregate field or array element to a constant. Returns null when
// the initializer is not a supported compile-time literal.
LLVMOpaqueValue* llvm_const_literal_value(LLVMOpaqueContext* raw_ctx,
    LLVMOpaqueModule* module, TypeTable* types, u32 target_type_id,
    str global_prefix, SyntaxNode* val) {
    if (val == (SyntaxNode*)0) {
        return (LLVMOpaqueValue*)0;
    }
    TypeEntry* target_entry = types.get(target_type_id);
    LLVMOpaqueType* field_ty = llvm_lower_type(raw_ctx, types, target_type_id);
    bool is_ptr = target_entry.kind == TypeKind.Pointer || target_entry.kind == TypeKind.Reference;
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.Minus
        && val.next_sibling != (SyntaxNode*)0
        && val.next_sibling.kind == NodeKind.Token
        && val.next_sibling.token_kind == TokenKind.IntLiteral) {
        if (type_is_integer(target_type_id)) {
            return llvm_const_int_literal(field_ty, val.next_sibling.text, true);
        }
        i64 n = -parse_int_literal(val.next_sibling.text);
        if (is_ptr) { return llvm_const_pointer_literal(raw_ctx, field_ty, n); }
        return LLVMConstInt(field_ty, (u64)n, 1);
    }
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.IntLiteral) {
        if (type_is_integer(target_type_id)) {
            return llvm_const_int_literal(field_ty, val.text, false);
        }
        i64 n = parse_int_literal(val.text);
        if (n == 0 && is_ptr) {
            return LLVMConstNull(field_ty);
        }
        if (is_ptr) { return llvm_const_pointer_literal(raw_ctx, field_ty, n); }
        return LLVMConstInt(field_ty, (u64)n, 1);
    }
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.True) {
        return LLVMConstInt(field_ty, 1, 0);
    }
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.False) {
        return LLVMConstInt(field_ty, 0, 0);
    }
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.CharLiteral) {
        return LLVMConstInt(field_ty, (u64)parse_char_literal(val.text), 0);
    }
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.StringLiteral
        && target_type_id == TYPE_STR) {
        return llvm_const_string_global(raw_ctx, module, val.text, global_prefix);
    }
    if (val.kind == NodeKind.Token && val.token_kind == TokenKind.FloatLiteral) {
        return llvm_const_real_literal(field_ty, val.text);
    }
    if (val.kind == NodeKind.Parenthesized) {
        // Cast form: `(T*)0` parses as Parenthesized[type *] followed by a
        // sibling IntLiteral; `(u64)1` likewise with a value literal.
        // Grouped form: `(5)` holds the literal as its only child.
        SyntaxNode* after = val.next_sibling;
        if (after != (SyntaxNode*)0 && after.kind == NodeKind.Token
            && after.token_kind == TokenKind.Minus
            && after.next_sibling != (SyntaxNode*)0
            && after.next_sibling.kind == NodeKind.Token
            && after.next_sibling.token_kind == TokenKind.IntLiteral) {
            if (type_is_integer(target_type_id)) {
                return llvm_const_int_literal(field_ty, after.next_sibling.text, true);
            }
            i64 n = -parse_int_literal(after.next_sibling.text);
            if (is_ptr) { return llvm_const_pointer_literal(raw_ctx, field_ty, n); }
            return LLVMConstInt(field_ty, (u64)n, 1);
        }
        if (after != (SyntaxNode*)0 && after.kind == NodeKind.Token
            && after.token_kind == TokenKind.IntLiteral) {
            if (type_is_integer(target_type_id)) {
                return llvm_const_int_literal(field_ty, after.text, false);
            }
            i64 n = parse_int_literal(after.text);
            if (n == 0 && is_ptr) {
                return LLVMConstNull(field_ty);
            }
            if (is_ptr) { return llvm_const_pointer_literal(raw_ctx, field_ty, n); }
            return LLVMConstInt(field_ty, (u64)n, 1);
        }
        if (after != (SyntaxNode*)0 && after.kind == NodeKind.Token
            && after.token_kind == TokenKind.FloatLiteral) {
            return llvm_const_real_literal(field_ty, after.text);
        }
        if (after != (SyntaxNode*)0 && after.kind == NodeKind.Token
            && after.token_kind == TokenKind.CharLiteral) {
            return LLVMConstInt(field_ty, (u64)parse_char_literal(after.text), 0);
        }
        if (after != (SyntaxNode*)0 && after.kind == NodeKind.Token
            && (after.token_kind == TokenKind.True || after.token_kind == TokenKind.False)) {
            return LLVMConstInt(field_ty, after.token_kind == TokenKind.True ? 1 : 0, 0);
        }
        if (after != (SyntaxNode*)0 && after.kind == NodeKind.Token
            && after.token_kind == TokenKind.StringLiteral
            && target_type_id == TYPE_STR) {
            return llvm_const_string_global(raw_ctx, module, after.text, global_prefix);
        }
        SyntaxNode* only = val.first_child;
        if (only != (SyntaxNode*)0 && only.next_sibling == (SyntaxNode*)0) {
            return llvm_const_literal_value(raw_ctx, module, types, target_type_id, global_prefix, only);
        }
    }
    return (LLVMOpaqueValue*)0;
}

void llvm_const_skip_initializer_value(SyntaxNode** cursor) {
    SyntaxNode* current = *cursor;
    if (current == (SyntaxNode*)0) { return; }
    SyntaxNode* next = current.next_sibling;
    if (current.kind == NodeKind.Token && current.token_kind == TokenKind.Minus
        && next != (SyntaxNode*)0 && next.kind == NodeKind.Token
        && next.token_kind == TokenKind.IntLiteral) {
        next = next.next_sibling;
    } else if (current.kind == NodeKind.Parenthesized
        && next != (SyntaxNode*)0 && next.kind == NodeKind.Token
        && (next.token_kind == TokenKind.IntLiteral || next.token_kind == TokenKind.FloatLiteral
            || next.token_kind == TokenKind.CharLiteral || next.token_kind == TokenKind.StringLiteral
            || next.token_kind == TokenKind.True || next.token_kind == TokenKind.False)) {
        next = next.next_sibling;
    }
    *cursor = next;
}

LLVMOpaqueValue* llvm_const_array_from_initializer(LLVMOpaqueContext* raw_ctx,
    LLVMOpaqueModule* module, TypeTable* types, u32 array_type_id,
    str global_prefix, SyntaxNode** cursor, bool bounded) {
    TypeEntry* array_entry = types.get(array_type_id);
    if (array_entry.kind != TypeKind.Array || array_entry.count < 0) {
        return (LLVMOpaqueValue*)0;
    }
    u32 elem_type_id = array_entry.inner;
    i64 elem_count = array_entry.count;
    LLVMOpaqueType* elem_ty = llvm_lower_type(raw_ctx, types, elem_type_id);
    Vec<LLVMOpaqueValue*> values = Vec<LLVMOpaqueValue*>.with_capacity(elem_count);
    bool const_ok = true;
    i64 index = 0;
    while (index < elem_count && const_ok) {
        while (*cursor != (SyntaxNode*)0 && (*cursor).kind == NodeKind.Token
            && (*cursor).token_kind == TokenKind.Comma) {
            *cursor = (*cursor).next_sibling;
        }
        if (*cursor == (SyntaxNode*)0) {
            values.push(LLVMConstNull(elem_ty));
            index += 1;
            continue;
        }

        String element_prefix = llvm_const_global_literal_prefix(global_prefix, "array", index);
        TypeEntry* elem_entry = types.get(elem_type_id);
        LLVMOpaqueValue* value = (LLVMOpaqueValue*)0;
        if (elem_entry.kind == TypeKind.Array) {
            if ((*cursor).kind == NodeKind.Block) {
                SyntaxNode* block = *cursor;
                SyntaxNode* nested_cursor = block.first_child;
                value = llvm_const_array_from_initializer(raw_ctx, module, types,
                    elem_type_id, element_prefix.to_str(), &nested_cursor, true);
                *cursor = block.next_sibling;
            } else {
                value = llvm_const_array_from_initializer(raw_ctx, module, types,
                    elem_type_id, element_prefix.to_str(), cursor, false);
            }
        } else {
            value = llvm_const_literal_value(raw_ctx, module, types, elem_type_id,
                element_prefix.to_str(), *cursor);
            llvm_const_skip_initializer_value(cursor);
        }
        element_prefix.drop();
        if (value == (LLVMOpaqueValue*)0) {
            const_ok = false;
        } else {
            values.push(value);
        }
        index += 1;
    }
    while (*cursor != (SyntaxNode*)0 && (*cursor).kind == NodeKind.Token
        && (*cursor).token_kind == TokenKind.Comma) {
        *cursor = (*cursor).next_sibling;
    }
    if (bounded && *cursor != (SyntaxNode*)0) { const_ok = false; }

    LLVMOpaqueValue* result = (LLVMOpaqueValue*)0;
    if (const_ok) {
        while (values.len() < elem_count) {
            values.push(LLVMConstNull(elem_ty));
        }
        result = LLVMConstArray2(elem_ty, values.data, (u64)elem_count);
    }
    values.drop();
    return result;
}

void llvm_bt_set_frame_pointer(LLVMOpaqueContext* ctx, LLVMOpaqueValue* function) {
    LLVMOpaqueAttributeRef* attr = LLVMCreateStringAttribute(
        ctx, (i8*)"frame-pointer", 13, (i8*)"all", 3);
    LLVMAddAttributeAtIndex(function, 0xFFFFFFFF, attr);
}

LLVMOpaqueValue* llvm_bt_read_frame_pointer(LLVMOpaqueContext* ctx, LLVMOpaqueBuilder* builder) {
    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx);
    LLVMOpaqueType* fn_type = LLVMFunctionType(i64_type, (LLVMOpaqueType**)0, 0, 0);
    str asm_text = "movq %rbp, $0";
    str constraints = "=r";
    LLVMOpaqueValue* inline_asm = LLVMGetInlineAsm(
        fn_type, (i8*)asm_text, (u64)strlen(asm_text),
        (i8*)constraints, (u64)strlen(constraints), 1, 0, 0, 0);
    return LLVMBuildCall2(
        builder, fn_type, inline_asm, (LLVMOpaqueValue**)0, 0, "bt.frame");
}

LLVMOpaqueValue* llvm_bt_string_global(LLVMOpaqueContext* ctx, LLVMOpaqueModule* module,
                                       str suffix, str text) {
    String global_name = String.from_str("__silver_bt_string.");
    global_name.push_str(suffix);
    LLVMOpaqueValue* initializer = LLVMConstStringInContext2(
        ctx, (i8*)text, (u64)strlen(text), 0);
    LLVMOpaqueValue* global = LLVMAddGlobal(
        module, LLVMTypeOf(initializer), global_name.to_str());
    LLVMSetInitializer(global, initializer);
    LLVMSetGlobalConstant(global, 1);
    LLVMSetLinkage(global, LLVMLinkage.LLVMPrivateLinkage);
    global_name.drop();
    return global;
}

void llvm_bt_record_function(LLVMOpaqueContext* ctx, LLVMOpaqueModule* module,
                             LLVMOpaqueValue* function, str function_name,
                             Span span, Vec<String>* source_paths,
                             Vec<LLVMOpaqueValue*>* records) {
    String file_name = String.new();
    if (span.file > 0 && span.file <= source_paths.len()) {
        String* path = source_paths.get_ptr((u32)(span.file - 1));
        file_name.push_str(path.to_str());
    } else {
        file_name.push_str("unknown.ag");
    }

    String name_suffix = String.from_str("name.");
    name_suffix.push_str(function_name);
    String file_suffix = String.from_str("file.");
    file_suffix.push_str(function_name);
    LLVMOpaqueValue* name_global = llvm_bt_string_global(
        ctx, module, name_suffix.to_str(), function_name);
    LLVMOpaqueValue* file_global = llvm_bt_string_global(
        ctx, module, file_suffix.to_str(), file_name.to_str());

    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx);
    Vec<LLVMOpaqueValue*> fields = Vec<LLVMOpaqueValue*>.new();
    fields.push(LLVMConstPtrToInt(function, i64_type));
    fields.push(name_global);
    fields.push(file_global);
    i64 line = span.start_line > 0 ? span.start_line : 1;
    fields.push(LLVMConstInt(i64_type, (u64)line, 0));
    records.push(LLVMConstStructInContext(ctx, fields.data, (u32)fields.len(), 0));
    fields.drop();
    name_suffix.drop();
    file_suffix.drop();
    file_name.drop();
}

LLVMOpaqueValue* llvm_bt_make_arg_record(LLVMOpaqueContext* ctx, LLVMOpaqueModule* module,
                                         LLVMOpaqueBuilder* builder, LLVMTargetDataRef* target_data,
                                         str function_name, str param_name,
                                         LLVMOpaqueType* param_type, LLVMOpaqueValue* param_slot,
                                         LLVMOpaqueValue* frame_pointer) {
    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx);
    String offset_suffix = String.from_str("offset.");
    offset_suffix.push_str(function_name);
    offset_suffix.push_str(".");
    offset_suffix.push_str(param_name);
    String offset_name = String.from_str("__silver_bt_");
    offset_name.push_str(offset_suffix.to_str());
    LLVMOpaqueValue* offset_global = LLVMAddGlobal(
        module, i64_type, offset_name.to_str());
    LLVMSetInitializer(offset_global, LLVMConstInt(i64_type, 0, 0));
    LLVMSetLinkage(offset_global, LLVMLinkage.LLVMInternalLinkage);
    LLVMOpaqueValue* param_address = LLVMBuildPtrToInt(
        builder, param_slot, i64_type, "bt.arg.address");
    LLVMOpaqueValue* relative_offset = LLVMBuildSub(
        builder, param_address, frame_pointer, "bt.arg.offset");
    LLVMBuildStore(builder, relative_offset, offset_global);

    LLVMOpaqueValue* encoded_offset = LLVMConstPtrToInt(offset_global, i64_type);
    String name_suffix = String.from_str("arg.");
    name_suffix.push_str(function_name);
    name_suffix.push_str(".");
    name_suffix.push_str(param_name);
    LLVMOpaqueValue* name_global = llvm_bt_string_global(
        ctx, module, name_suffix.to_str(), param_name);

    u64 abi_size = LLVMABISizeOfType(target_data, param_type);
    if (abi_size > 8) { abi_size = 8; }
    if (abi_size == 0) { abi_size = 1; }
    u64 encoded_size = 0x8000000000000000 | abi_size;
    Vec<LLVMOpaqueValue*> fields = Vec<LLVMOpaqueValue*>.new();
    fields.push(name_global);
    fields.push(encoded_offset);
    fields.push(LLVMConstInt(i64_type, encoded_size, 0));
    LLVMOpaqueValue* record = LLVMConstStructInContext(ctx, fields.data, (u32)fields.len(), 0);
    fields.drop();
    offset_suffix.drop();
    offset_name.drop();
    name_suffix.drop();
    return record;
}

void llvm_bt_record_args(LLVMOpaqueContext* ctx, LLVMOpaqueModule* module,
                         LLVMOpaqueValue* function, Vec<LLVMOpaqueValue*>* arg_records,
                         Vec<LLVMOpaqueValue*>* records) {
    if (arg_records.len() == 0) { return; }
    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx);
    LLVMOpaqueType* arg_type = LLVMTypeOf(arg_records.get(0));
    LLVMOpaqueType* array_type = LLVMArrayType(arg_type, (u32)arg_records.len());
    LLVMOpaqueValue* array_value = LLVMConstArray2(
        arg_type, arg_records.data, (u64)arg_records.len());
    LLVMOpaqueValue* array_global = LLVMAddGlobal(module, array_type, "__silver_bt_args_data");
    LLVMSetInitializer(array_global, array_value);
    LLVMSetGlobalConstant(array_global, 1);
    LLVMSetLinkage(array_global, LLVMLinkage.LLVMPrivateLinkage);

    Vec<LLVMOpaqueValue*> fields = Vec<LLVMOpaqueValue*>.new();
    fields.push(LLVMConstPtrToInt(function, i64_type));
    fields.push(LLVMConstInt(i64_type, (u64)arg_records.len(), 0));
    fields.push(array_global);
    records.push(LLVMConstStructInContext(ctx, fields.data, (u32)fields.len(), 0));
    fields.drop();
}

void llvm_bt_emit_tables(LLVMOpaqueContext* ctx, LLVMOpaqueModule* module,
                         Vec<LLVMOpaqueValue*>* function_records,
                         Vec<LLVMOpaqueValue*>* arg_function_records) {
    LLVMOpaqueType* ptr_type = LLVMPointerTypeInContext(ctx, 0);
    LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(ctx);
    LLVMOpaqueValue* entries_global = LLVMGetNamedGlobal(module, "__silver_bt_entries");
    LLVMOpaqueValue* count_global = LLVMGetNamedGlobal(module, "__silver_bt_count");

    if (function_records.len() > 0) {
        LLVMOpaqueType* record_type = LLVMTypeOf(function_records.get(0));
        LLVMOpaqueType* array_type = LLVMArrayType(record_type, (u32)function_records.len());
        LLVMOpaqueValue* array_value = LLVMConstArray2(
            record_type, function_records.data, (u64)function_records.len());
        LLVMOpaqueValue* data_global = LLVMAddGlobal(module, array_type, "__silver_bt_data");
        LLVMSetInitializer(data_global, array_value);
        LLVMSetGlobalConstant(data_global, 1);
        LLVMSetLinkage(data_global, LLVMLinkage.LLVMPrivateLinkage);
        if (entries_global == (LLVMOpaqueValue*)0) {
            entries_global = LLVMAddGlobal(module, ptr_type, "__silver_bt_entries");
        }
        LLVMSetInitializer(entries_global, data_global);
        if (count_global == (LLVMOpaqueValue*)0) {
            count_global = LLVMAddGlobal(module, i64_type, "__silver_bt_count");
        }
        LLVMSetInitializer(count_global, LLVMConstInt(i64_type, (u64)function_records.len(), 0));
    }

    LLVMOpaqueValue* args_global = LLVMGetNamedGlobal(module, "__silver_bt_args");
    LLVMOpaqueValue* args_count_global = LLVMGetNamedGlobal(module, "__silver_bt_args_count");
    if (arg_function_records.len() > 0) {
        LLVMOpaqueType* record_type = LLVMTypeOf(arg_function_records.get(0));
        LLVMOpaqueType* array_type = LLVMArrayType(record_type, (u32)arg_function_records.len());
        LLVMOpaqueValue* array_value = LLVMConstArray2(
            record_type, arg_function_records.data, (u64)arg_function_records.len());
        LLVMOpaqueValue* data_global = LLVMAddGlobal(module, array_type, "__silver_bt_args_functions");
        LLVMSetInitializer(data_global, array_value);
        LLVMSetGlobalConstant(data_global, 1);
        LLVMSetLinkage(data_global, LLVMLinkage.LLVMPrivateLinkage);
        if (args_global == (LLVMOpaqueValue*)0) {
            args_global = LLVMAddGlobal(module, ptr_type, "__silver_bt_args");
        }
        LLVMSetInitializer(args_global, data_global);
        if (args_count_global == (LLVMOpaqueValue*)0) {
            args_count_global = LLVMAddGlobal(module, i64_type, "__silver_bt_args_count");
        }
        LLVMSetInitializer(args_count_global, LLVMConstInt(i64_type, (u64)arg_function_records.len(), 0));
    }
}

struct LlvmGenerator {
    LLVMOpaqueContext* ctx;
    LLVMOpaqueModule* module;
    LLVMOpaqueBuilder* builder;
    LLVMOpaqueTargetMachine* target_machine;
    LLVMTargetDataRef* target_data;
    i64 unresolved_calls;
    DiagnosticBag ownership_diagnostics;
}

impl LlvmGenerator {
    LlvmGenerator new(str module_name) {
        LLVMInitializeAllTargetInfos();
        LLVMInitializeAllTargets();
        LLVMInitializeAllTargetMCs();
        LLVMInitializeAllAsmPrinters();
        LLVMInitializeAllAsmParsers();

        str triple = LLVMGetDefaultTargetTriple();
        LLVMTarget* target = (LLVMTarget*)0;
        i8* target_error = (i8*)0;
        LLVMOpaqueTargetMachine* target_machine = (LLVMOpaqueTargetMachine*)0;
        LLVMTargetDataRef* target_data = (LLVMTargetDataRef*)0;
        if (LLVMGetTargetFromTriple(triple, &target, &target_error) == 0) {
            target_machine = LLVMCreateTargetMachine(
                target, triple, "generic", "",
                LLVMCodeGenOptLevel.LLVMCodeGenLevelDefault,
                LLVMRelocMode.LLVMRelocPIC,
                LLVMCodeModel.LLVMCodeModelDefault
            );
            if (target_machine != (LLVMOpaqueTargetMachine*)0) {
                target_data = LLVMCreateTargetDataLayout(target_machine);
            }
        }
        if (target_error != (i8*)0) {
            LLVMDisposeMessage(target_error);
        }

        LLVMOpaqueContext* ctx = LLVMContextCreate();
        LLVMOpaqueModule* module = LLVMModuleCreateWithNameInContext(module_name, ctx);
        LLVMOpaqueBuilder* builder = LLVMCreateBuilderInContext(ctx);
        if (target_data != (LLVMTargetDataRef*)0) {
            i8* data_layout = LLVMCopyStringRepOfTargetData(target_data);
            LLVMSetTarget(module, triple);
            LLVMSetDataLayout(module, data_layout);
            LLVMDisposeMessage(data_layout);
        }
        LLVMDisposeMessage(triple);
        LlvmGenerator g;
        g.ctx = ctx;
        g.module = module;
        g.builder = builder;
        g.target_machine = target_machine;
        g.target_data = target_data;
        g.unresolved_calls = 0;
        g.ownership_diagnostics = DiagnosticBag.new();
        return move g;
    }

    void destroy(LlvmGenerator* self) {
        LLVMDisposeBuilder(self.builder);
        LLVMDisposeModule(self.module);
        LLVMContextDispose(self.ctx);
        if (self.target_data != (LLVMTargetDataRef*)0) {
            LLVMDisposeTargetData(self.target_data);
        }
        if (self.target_machine != (LLVMOpaqueTargetMachine*)0) {
            LLVMDisposeTargetMachine(self.target_machine);
        }
    }

    bool compile(LlvmGenerator* self, SyntaxTree* tree, AstPool* pool,
                 TypeTable* types, Interner* names, SymbolTable* symbols,
                 Vec<String>* source_paths, bool debug_mode, bool module_object) {
        LlvmContext ctx = LlvmContext.new(self.ctx, self.target_data, self.module, self.builder,
                                          types, names, pool, tree.root, source_paths, debug_mode);
        ctx.ownership_diagnostics = &self.ownership_diagnostics;
        if (self.target_data == (LLVMTargetDataRef*)0) {
            ctx.note_unresolved("target-layout", "native target initialization failed");
            self.unresolved_calls = ctx.unresolved_calls;
            return false;
        }

        // Pass 0: Register all struct types
        SyntaxNode* item = tree.root.first_child;
        while (item != (SyntaxNode*)0) {
            if (item.kind == NodeKind.Struct) {
                SyntaxNode* id_node = item_identifier(item);
                if (id_node != (SyntaxNode*)0) {
                    str struct_name = id_node.text;
                    u32 struct_name_id = names.intern(struct_name);
                    LLVMOpaqueType* struct_ty = LLVMStructCreateNamed(self.ctx, struct_name);

                    LlvmStructDef def;
                    def.name_id = struct_name_id;
                    def.llvm_type = struct_ty;
                    def.packed = item_has_attribute(item, "packed")
                        || types.struct_is_packed(struct_name);
                    def.fields = Vec<LlvmFieldInfo>.new();

                    SyntaxNode* block = item.first_child;
                    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                        block = block.next_sibling;
                    }
                    if (block != (SyntaxNode*)0) {
                        SyntaxNode* cursor = block.first_child;
                        u32 field_idx = 0;
                        while (cursor != (SyntaxNode*)0) {
                            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                                cursor = cursor.next_sibling;
                                continue;
                            }
                            SyntaxNode* start = cursor;
                            SyntaxNode* last_ident = (SyntaxNode*)0;
                            while (cursor != (SyntaxNode*)0 && !(cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon)) {
                                if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Identifier) {
                                    last_ident = cursor;
                                }
                                cursor = cursor.next_sibling;
                            }
                            if (last_ident != (SyntaxNode*)0) {
                                u32 field_name_id = names.intern(last_ident.text);
                                String field_type_text = String.new();
                                SyntaxNode* scan = start;
                                while (scan != last_ident && scan != (SyntaxNode*)0) {
                                    append_node_tokens(scan, &field_type_text);
                                    scan = scan.next_sibling;
                                }
                                SyntaxNode* ext = last_ident.next_sibling;
                                u32 field_type_id = type_id_from_declarator(types,
                                    field_type_text.to_str(), ext);
                                field_type_text.drop();
                                LlvmFieldInfo f_info;
                                f_info.name_id = field_name_id;
                                f_info.type_id = field_type_id;
                                f_info.index = field_idx;
                                def.fields.push(move f_info);
                                field_idx += 1;
                            }
                            if (cursor != (SyntaxNode*)0) {
                                cursor = cursor.next_sibling;
                            }
                        }
                    }
                    ctx.struct_defs.push(move def);
                }
            }
            item = item.next_sibling;
        }

        // Pass 0b: Set bodies for all struct types
        i64 s_idx = 0;
        while (s_idx < ctx.struct_defs.len()) {
            LlvmStructDef* def = ctx.struct_defs.get_ptr(s_idx);
            Vec<LLVMOpaqueType*> field_tys = Vec<LLVMOpaqueType*>.new();
            i64 f = 0;
            while (f < def.fields.len()) {
                LlvmFieldInfo* fi = def.fields.get_ptr(f);
                field_tys.push(llvm_lower_type(self.ctx, types, fi.type_id));
                f += 1;
            }
            LLVMStructSetBody(def.llvm_type, field_tys.data, (u32)field_tys.len(),
                              (u32)(def.packed ? 1 : 0));
            field_tys.drop();
            s_idx += 1;
        }

        // Pass 0c: Register enum layouts ({i16 tag, [N x i8] data}).
        SyntaxNode* enum_item = tree.root.first_child;
        while (enum_item != (SyntaxNode*)0) {
            if (enum_item.kind == NodeKind.Enum && llvm_item_is_generic_enum(enum_item)) {
                SyntaxNode* enum_id = item_identifier(enum_item);
                if (enum_id != (SyntaxNode*)0
                    && LLVMGetTypeByName2(self.ctx, enum_id.text) == (LLVMOpaqueType*)0) {
                    LLVMStructCreateNamed(self.ctx, enum_id.text);
                }
            } else if (enum_item.kind == NodeKind.Enum) {
                SyntaxNode* enum_id = item_identifier(enum_item);
                if (enum_id != (SyntaxNode*)0
                    && LLVMGetTypeByName2(self.ctx, enum_id.text) == (LLVMOpaqueType*)0) {
                    Vec<SyntaxNode*> variant_names = Vec<SyntaxNode*>.new();
                    Vec<i64> variant_tags = Vec<i64>.new();
                    Vec<i64> variant_arities = Vec<i64>.new();
                    enum_each_variant(enum_item, &variant_names, &variant_tags, &variant_arities);
                    u64 data_size = 0;
                    i64 variant_index = 0;
                    while (variant_index < variant_names.len()) {
                        Vec<u32> payload_types = Vec<u32>.new();
                        llvm_enum_payload_types(types, tree.root, enum_id.text,
                                                variant_names.get(variant_index).text, &payload_types);
                        u64 variant_size = llvm_target_payload_size(&ctx, &payload_types);
                        payload_types.drop();
                        if (variant_size > data_size) {
                            data_size = variant_size;
                        }
                        variant_index += 1;
                    }
                    bool has_payload = false;
                    i64 vi = 0;
                    while (vi < variant_arities.len()) {
                        if (variant_arities.get(vi) > 0) {
                            has_payload = true;
                        }
                        vi += 1;
                    }
                    variant_names.drop();
                    variant_tags.drop();
                    variant_arities.drop();
                    if (has_payload && data_size == 0) {
                        ctx.note_unresolved("empty-enum-payload-layout", enum_id.text);
                    }
                    LLVMOpaqueType* tag_ty = LLVMInt16TypeInContext(self.ctx);
                    LLVMOpaqueType* enum_ty = LLVMStructCreateNamed(self.ctx, enum_id.text);
                    Vec<LLVMOpaqueType*> enum_body = Vec<LLVMOpaqueType*>.new();
                    enum_body.push(tag_ty);
                    if (data_size > 0) {
                        LLVMOpaqueType* data_ty = LLVMArrayType(LLVMInt8TypeInContext(self.ctx), (u32)data_size);
                        enum_body.push(data_ty);
                    }
                    LLVMStructSetBody(enum_ty, enum_body.data, (u32)enum_body.len(), 0);
                    enum_body.drop();
                }
            }
            enum_item = enum_item.next_sibling;
        }

        // Pass 1: Declare top-level functions, methods, and externs
        item = tree.root.first_child;
        while (item != (SyntaxNode*)0) {
            if (item.kind == NodeKind.Function) {
                if (llvm_item_is_generic_fn(item)) {
                    item = item.next_sibling;
                    continue;
                }
                SyntaxNode* id_node = function_identifier(item);
                if (id_node != (SyntaxNode*)0) {
                    String fn_name = llvm_free_function_symbol(types, tree.root, item);
                    u32 ret_type_id = function_return_type_id(types, item);
                    LLVMOpaqueType* ret_llvm_type = llvm_lower_type(self.ctx, types, ret_type_id);
                    Vec<Binding> params = Vec<Binding>.new();
                    collect_parameter_bindings(binding_function_parameters(item), &params);
                    Vec<LLVMOpaqueType*> param_types = llvm_param_types(&ctx, types, &params, (str)0);
                    LLVMOpaqueType* fn_type = LLVMFunctionType(ret_llvm_type, param_types.data, (u32)param_types.len(), 0);
                    if (LLVMGetNamedFunction(self.module, fn_name.to_str()) == (LLVMOpaqueValue*)0) {
                        LLVMAddFunction(self.module, fn_name.to_str(), fn_type);
                    }
                    param_types.drop();
                    params.drop();
                    fn_name.drop();
                }
            } else if (item.kind == NodeKind.Impl) {
                if (llvm_item_is_generic_impl(item)) {
                    item = item.next_sibling;
                    continue;
                }
                SyntaxNode* struct_ident = impl_target_identifier(item);
                if (struct_ident != (SyntaxNode*)0) {
                    str struct_name = struct_ident.text;
                    SyntaxNode* block = item.first_child;
                    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                        block = block.next_sibling;
                    }
                    if (block != (SyntaxNode*)0) {
                        SyntaxNode* cursor = block.first_child;
                        while (cursor != (SyntaxNode*)0) {
                            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                                cursor = cursor.next_sibling;
                                continue;
                            }
                            bool is_cast = cursor.kind == NodeKind.Token && (cursor.token_kind == TokenKind.Cast || strcmp(cursor.text, "cast") == 0);
                            SyntaxNode* ret_start = cursor;
                            SyntaxNode* method_name_node = (SyntaxNode*)0;
                            SyntaxNode* params_node = (SyntaxNode*)0;
                            SyntaxNode* body_node = (SyntaxNode*)0;
                            SyntaxNode* scan = cursor;
                            bool hit_semi = false;
                            SyntaxNode* semi_node = (SyntaxNode*)0;
                            while (scan != (SyntaxNode*)0) {
                                if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon) {
                                    hit_semi = true;
                                    semi_node = scan;
                                    break;
                                }
                                if (scan.kind == NodeKind.Block) {
                                    body_node = scan;
                                    break;
                                }
                                if (scan.kind == NodeKind.Parenthesized) {
                                    params_node = scan;
                                    if (scan.next_sibling != (SyntaxNode*)0 && scan.next_sibling.kind == NodeKind.Block) {
                                        body_node = scan.next_sibling;
                                        break;
                                    }
                                }
                                if (!is_cast && scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                                    method_name_node = scan;
                                }
                                scan = scan.next_sibling;
                            }
                            if (hit_semi) {
                                cursor = semi_node.next_sibling;
                                continue;
                            }
                            if (body_node != (SyntaxNode*)0 && body_node.kind == NodeKind.Block) {
                                if ((is_cast || method_name_node != (SyntaxNode*)0) && params_node != (SyntaxNode*)0) {
                                    String mangled = String.from_str(struct_name);
                                    mangled.push_str("__");
                                    String ret_str = String.new();
                                    if (is_cast) {
                                        SyntaxNode* rscan = cursor.next_sibling;
                                        while (rscan != (SyntaxNode*)0 && rscan != params_node) {
                                            append_node_tokens(rscan, &ret_str);
                                            rscan = rscan.next_sibling;
                                        }
                                        mangled.push_str("cast_");
                                        mangled.push_str(ret_str.to_str());
                                    } else {
                                        mangled.push_str(method_name_node.text);
                                        SyntaxNode* rscan = ret_start;
                                        while (rscan != (SyntaxNode*)0 && rscan != method_name_node) {
                                            if (rscan.kind == NodeKind.Token && rscan.text == "#") {
                                                rscan = rscan.next_sibling;
                                                if (rscan != (SyntaxNode*)0 && rscan.kind == NodeKind.Bracket) {
                                                    rscan = rscan.next_sibling;
                                                }
                                                continue;
                                            }
                                            if (rscan.kind == NodeKind.Token && (rscan.text == "pub" || rscan.text == "static")) {
                                                rscan = rscan.next_sibling;
                                                continue;
                                            }
                                            break;
                                        }
                                        while (rscan != (SyntaxNode*)0 && rscan != method_name_node) {
                                            append_node_tokens(rscan, &ret_str);
                                            rscan = rscan.next_sibling;
                                        }
                                    }
                                    u32 ret_type_id = type_id_from_text(types, ret_str.to_str());
                                    ret_str.drop();
                                    if (!is_cast) {
                                        String method_symbol = typecheck_method_symbol(
                                            types, struct_name,
                                            method_name_node.text, ret_start,
                                            method_name_node, params_node);
                                        mangled.drop();
                                        mangled = move method_symbol;
                                    }
                                    // Keep unsupported signatures undeclared. An actual
                                    // call fails closed through method resolution.
                                    if (!mono_type_is_concrete(self.ctx, types, ret_type_id, 0)) {
                                        mangled.drop();
                                        cursor = body_node.next_sibling;
                                        continue;
                                    }
                                    mono_ensure_child_layouts(&ctx, ret_type_id, &ctx.generic_layout_ids);
                                    LLVMOpaqueType* ret_llvm_type = llvm_lower_type(self.ctx, types, ret_type_id);

                                    Vec<Binding> params = Vec<Binding>.new();
                                    collect_parameter_bindings(params_node, &params);
                                    Vec<LLVMOpaqueType*> param_types = llvm_param_types(&ctx, types, &params, struct_name);
                                    LLVMOpaqueType* fn_type = LLVMFunctionType(ret_llvm_type, param_types.data, (u32)param_types.len(), 0);
                                    if (LLVMGetNamedFunction(self.module, mangled.to_str()) == (LLVMOpaqueValue*)0) {
                                        LLVMAddFunction(self.module, mangled.to_str(), fn_type);
                                    }
                                    param_types.drop();
                                    params.drop();
                                    mangled.drop();
                                }
                                cursor = body_node.next_sibling;
                                continue;
                            }
                            cursor = cursor.next_sibling;
                        }
                    }
                }
            } else if (item.kind == NodeKind.Extern) {
                SyntaxNode* block = item.first_child;
                while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                    block = block.next_sibling;
                }
                if (block != (SyntaxNode*)0) {
                    SyntaxNode* cursor = block.first_child;
                    while (cursor != (SyntaxNode*)0) {
                        if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                            cursor = cursor.next_sibling;
                            continue;
                        }
                        SyntaxNode* declaration_start = cursor;
                        SyntaxNode* ret_start = declaration_start;
                        while (ret_start != (SyntaxNode*)0) {
                            if (ret_start.kind == NodeKind.Attribute) {
                                ret_start = ret_start.next_sibling;
                                continue;
                            }
                            if (ret_start.kind == NodeKind.Token && ret_start.text == "#") {
                                SyntaxNode* bracket = ret_start.next_sibling;
                                if (bracket != (SyntaxNode*)0 && bracket.kind == NodeKind.Bracket) {
                                    ret_start = bracket.next_sibling;
                                    continue;
                                }
                            }
                            break;
                        }
                        SyntaxNode* fn_name_node = (SyntaxNode*)0;
                        SyntaxNode* params_node = (SyntaxNode*)0;
                        SyntaxNode* scan = declaration_start;
                        while (scan != (SyntaxNode*)0 && !(scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon)) {
                            if (scan.kind == NodeKind.Parenthesized) {
                                params_node = scan;
                                break;
                            }
                            if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                                fn_name_node = scan;
                            }
                            scan = scan.next_sibling;
                        }
                        if (fn_name_node != (SyntaxNode*)0 && params_node != (SyntaxNode*)0) {
                            str fn_name = fn_name_node.text;
                            String ret_text = String.new();
                            SyntaxNode* rscan = ret_start;
                            while (rscan != (SyntaxNode*)0 && rscan != fn_name_node) {
                                append_node_tokens(rscan, &ret_text);
                                rscan = rscan.next_sibling;
                            }
                            u32 ret_type_id = type_id_from_text(types, ret_text.to_str());
                            ret_text.drop();
                            LLVMOpaqueType* ret_llvm_type = llvm_lower_type(self.ctx, types, ret_type_id);
                            Vec<Binding> params = Vec<Binding>.new();
                            collect_parameter_bindings(params_node, &params);
                            Vec<LLVMOpaqueType*> param_types = llvm_param_types(&ctx, types, &params, (str)0);
                            LLVMOpaqueType* fn_type = LLVMFunctionType(ret_llvm_type, param_types.data, (u32)param_types.len(), 0);
                            String link_name = item_attribute_string(declaration_start, fn_name_node, "link_name");
                            str llvm_name = link_name.len() > 0 ? link_name.to_str() : fn_name;
                            if (LLVMGetNamedFunction(self.module, llvm_name) == (LLVMOpaqueValue*)0) {
                                LLVMAddFunction(self.module, llvm_name, fn_type);
                            }
                            link_name.drop();
                            param_types.drop();
                            params.drop();
                            cursor = (params_node.next_sibling != (SyntaxNode*)0 && params_node.next_sibling.kind == NodeKind.Token && params_node.next_sibling.token_kind == TokenKind.Semicolon) ? params_node.next_sibling.next_sibling : params_node.next_sibling;
                            continue;
                        }
                        if (fn_name_node != (SyntaxNode*)0 && params_node == (SyntaxNode*)0) {
                            str g_name = fn_name_node.text;
                            String g_text = String.new();
                            SyntaxNode* g_scan = ret_start;
                            while (g_scan != (SyntaxNode*)0 && g_scan != fn_name_node) {
                                if (g_scan.kind == NodeKind.Token) {
                                    g_text.push_str(g_scan.text);
                                }
                                g_scan = g_scan.next_sibling;
                            }
                            SyntaxNode* ext = fn_name_node.next_sibling;
                            u32 g_type_id = type_id_from_declarator(types,
                                g_text.to_str(), ext);
                            g_text.drop();
                            LLVMOpaqueType* g_llvm_type = llvm_lower_type(self.ctx, types, g_type_id);
                            if (LLVMGetNamedGlobal(self.module, g_name) == (LLVMOpaqueValue*)0) {
                                LLVMAddGlobal(self.module, g_llvm_type, g_name);
                            }
                            while (cursor != (SyntaxNode*)0 && !(cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon)) {
                                cursor = cursor.next_sibling;
                            }
                            if (cursor != (SyntaxNode*)0) {
                                cursor = cursor.next_sibling;
                            }
                            continue;
                        }
                        cursor = cursor.next_sibling;
                    }
                }
            } else if (item.kind == NodeKind.Global) {
                SyntaxNode* id_node = item_identifier(item);
                if (id_node != (SyntaxNode*)0) {
                    str g_name = id_node.text;
                    String g_text = String.new();
                    SyntaxNode* g_scan = item.first_child;
                    while (g_scan != (SyntaxNode*)0 && g_scan != id_node) {
                        if (g_scan.kind == NodeKind.Token && g_scan.text == "#") {
                            g_scan = g_scan.next_sibling;
                            if (g_scan != (SyntaxNode*)0 && g_scan.kind == NodeKind.Bracket) {
                                g_scan = g_scan.next_sibling;
                            }
                            continue;
                        }
                        if (g_scan.kind == NodeKind.Token && g_scan.text != "pub"
                            && g_scan.text != "static" && g_scan.text != "const"
                            && g_scan.text != "volatile") {
                            g_text.push_str(g_scan.text);
                        }
                        g_scan = g_scan.next_sibling;
                    }
                    SyntaxNode* ext = id_node.next_sibling;
                    u32 g_type_id = type_id_from_declarator(types,
                        g_text.to_str(), ext);
                    g_text.drop();
                    if (g_type_id == TYPE_UNKNOWN) { g_type_id = TYPE_I64; }
                    LLVMOpaqueType* g_llvm_type = llvm_lower_type(self.ctx, types, g_type_id);

                    LLVMOpaqueValue* g_init = (LLVMOpaqueValue*)0;
                    SyntaxNode* eq_node = item.first_child;
                    while (eq_node != (SyntaxNode*)0 && !(eq_node.kind == NodeKind.Token && (eq_node.token_kind == TokenKind.Assign || strcmp(eq_node.text, "=") == 0))) {
                        eq_node = eq_node.next_sibling;
                    }
                    if (eq_node != (SyntaxNode*)0) {
                        SyntaxNode* init_node = eq_node.next_sibling;
                        if (init_node != (SyntaxNode*)0 && init_node.kind == NodeKind.Token
                            && init_node.token_kind == TokenKind.At
                            && init_node.next_sibling != (SyntaxNode*)0
                            && init_node.next_sibling.kind == NodeKind.Token
                            && init_node.next_sibling.token_kind == TokenKind.Identifier) {
                            SyntaxNode* builtin = init_node.next_sibling;
                            SyntaxNode* args = builtin.next_sibling;
                            if (args != (SyntaxNode*)0 && args.kind == NodeKind.Parenthesized
                                && args.first_child == (SyntaxNode*)0
                                && strcmp(builtin.text, "line") == 0) {
                                g_init = LLVMConstInt(g_llvm_type,
                                    (u64)builtin.span.start_line, 0);
                            } else if (args != (SyntaxNode*)0
                                && args.kind == NodeKind.Parenthesized
                                && args.first_child == (SyntaxNode*)0
                                && strcmp(builtin.text, "file") == 0
                                && builtin.span.file > 0
                                && builtin.span.file <= source_paths.len()) {
                                String* source_path = source_paths.get_ptr(
                                    builtin.span.file - 1);
                                str path = source_path.to_str();
                                g_init = llvm_const_bytes_global(self.ctx,
                                    self.module, (i8*)path, (u64)strlen(path),
                                    g_name, 1);
                            }
                            if (g_init == (LLVMOpaqueValue*)0) {
                                ctx.note_unresolved("global-init", g_name);
                            }
                        } else if (init_node != (SyntaxNode*)0 && init_node.kind == NodeKind.Parenthesized) {
                            // Cast or grouped literal: `(i8**)0`, `(u64)1`,
                            // `(5)`. The old code skipped the parens and read
                            // the raw literal, producing `ptr 0` for pointer
                            // casts (verify failure). Lower properly instead.
                            g_init = llvm_const_literal_value(self.ctx, self.module, types,
                                g_type_id, g_name, init_node);
                            if (g_init == (LLVMOpaqueValue*)0) {
                                ctx.note_unresolved("global-init", g_name);
                            }
                        } else if (init_node != (SyntaxNode*)0 && init_node.kind == NodeKind.Token) {
                            if (init_node.token_kind == TokenKind.Minus && init_node.next_sibling != (SyntaxNode*)0
                                && init_node.next_sibling.kind == NodeKind.Token
                                && init_node.next_sibling.token_kind == TokenKind.IntLiteral) {
                                if (type_is_integer(g_type_id)) {
                                    g_init = llvm_const_int_literal(g_llvm_type, init_node.next_sibling.text, true);
                                } else {
                                    i64 n = -parse_int_literal(init_node.next_sibling.text);
                                    TypeEntry* global_entry = types.get(g_type_id);
                                    if (global_entry.kind == TypeKind.Pointer
                                        || global_entry.kind == TypeKind.Reference) {
                                        g_init = llvm_const_pointer_literal(self.ctx, g_llvm_type, n);
                                    } else {
                                        g_init = LLVMConstInt(g_llvm_type, (u64)n, 1);
                                    }
                                }
                            } else if (init_node.token_kind == TokenKind.IntLiteral) {
                                if (type_is_integer(g_type_id)) {
                                    g_init = llvm_const_int_literal(g_llvm_type, init_node.text, false);
                                } else {
                                    i64 n = parse_int_literal(init_node.text);
                                    TypeEntry* global_entry = types.get(g_type_id);
                                    if (global_entry.kind == TypeKind.Pointer
                                        || global_entry.kind == TypeKind.Reference) {
                                        g_init = llvm_const_pointer_literal(self.ctx, g_llvm_type, n);
                                    } else {
                                        g_init = LLVMConstInt(g_llvm_type, (u64)n, 1);
                                    }
                                }
                            } else if (init_node.token_kind == TokenKind.True) {
                                g_init = LLVMConstInt(g_llvm_type, 1, 0);
                            } else if (init_node.token_kind == TokenKind.False) {
                                g_init = LLVMConstInt(g_llvm_type, 0, 0);
                            } else if (init_node.token_kind == TokenKind.CharLiteral) {
                                g_init = LLVMConstInt(g_llvm_type, (u64)parse_char_literal(init_node.text), 0);
                            } else if (init_node.token_kind == TokenKind.FloatLiteral) {
                                g_init = llvm_const_real_literal(g_llvm_type, init_node.text);
                            } else if (init_node.token_kind == TokenKind.StringLiteral
                                && g_type_id == TYPE_STR) {
                                g_init = llvm_const_string_global(self.ctx, self.module,
                                    init_node.text, g_name);
                            } else {
                                ctx.note_unresolved("global-init", g_name);
                            }
                        } else if (init_node.kind == NodeKind.Block) {
                            // Struct literal: { .field = lit, ... }. Build one
                            // constant per struct field in declaration order;
                            // missing fields zero-fill. Array literal:
                            // { lit, ... } with exact element count.
                            // Non-literal values fail closed via note_unresolved.
                            TypeEntry* g_entry = ctx.types.get(g_type_id);
                            if (g_entry.kind == TypeKind.Named) {
                                str g_type_name = types.names.get(g_entry.name_id);
                                LlvmStructDef* def = ctx.find_struct_by_str(g_type_name);
                                if (def != (LlvmStructDef*)0) {
                                    Vec<LLVMOpaqueValue*> field_vals = Vec<LLVMOpaqueValue*>.new();
                                    bool const_ok = true;
                                    i64 fi = 0;
                                    while (fi < def.fields.len() && const_ok) {
                                        LlvmFieldInfo* field = def.fields.get_ptr(fi);
                                        str field_name = ctx.names.get(field.name_id);
                                        SyntaxNode* cur = init_node.first_child;
                                        LLVMOpaqueValue* field_val = (LLVMOpaqueValue*)0;
                                        bool found_field = false;
                                        while (cur != (SyntaxNode*)0 && !found_field) {
                                            if (cur.kind == NodeKind.Token && strcmp(cur.text, ".") == 0
                                                && cur.next_sibling != (SyntaxNode*)0
                                                && cur.next_sibling.kind == NodeKind.Token
                                                && strcmp(cur.next_sibling.text, field_name) == 0) {
                                                SyntaxNode* eq = cur.next_sibling.next_sibling;
                                                if (eq != (SyntaxNode*)0 && eq.kind == NodeKind.Token
                                                    && (eq.token_kind == TokenKind.Assign || strcmp(eq.text, "=") == 0)) {
                                                    found_field = true;
                                                    String field_prefix = llvm_const_global_literal_prefix(g_name, "field", fi);
                                                    field_val = llvm_const_literal_value(self.ctx, self.module,
                                                        types, field.type_id, field_prefix.to_str(), eq.next_sibling);
                                                    field_prefix.drop();
                                                    if (field_val == (LLVMOpaqueValue*)0) {
                                                        const_ok = false;
                                                    }
                                                }
                                            }
                                            cur = cur.next_sibling;
                                        }
                                        if (!found_field) {
                                            LLVMOpaqueType* field_ty = llvm_lower_type(self.ctx, types, field.type_id);
                                            field_val = LLVMConstNull(field_ty);
                                        }
                                        if (const_ok) {
                                            field_vals.push(field_val);
                                        }
                                        fi += 1;
                                    }
                                    if (const_ok) {
                                        g_init = LLVMConstNamedStruct(g_llvm_type, field_vals.data, (u32)field_vals.len());
                                    } else {
                                        ctx.note_unresolved("global-init", g_name);
                                    }
                                    field_vals.drop();
                                } else {
                                    ctx.note_unresolved("global-init", g_name);
                                }
                            } else if (g_entry.kind == TypeKind.Array) {
                                SyntaxNode* value_cursor = init_node.first_child;
                                g_init = llvm_const_array_from_initializer(self.ctx, self.module,
                                    types, g_type_id, g_name, &value_cursor, true);
                                if (g_init == (LLVMOpaqueValue*)0) {
                                    ctx.note_unresolved("global-init", g_name);
                                }
                            } else {
                                ctx.note_unresolved("global-init", g_name);
                            }
                        }
                    }
                    if (g_init == (LLVMOpaqueValue*)0) {
                        g_init = LLVMConstNull(g_llvm_type);
                    }

                    LLVMOpaqueValue* g_val = LLVMGetNamedGlobal(self.module, g_name);
                    if (g_val == (LLVMOpaqueValue*)0) {
                        g_val = LLVMAddGlobal(self.module, g_llvm_type, g_name);
                    }
                    LLVMSetInitializer(g_val, g_init);
                }
            }
            item = item.next_sibling;
        }
        mono_define_generic_layouts(&ctx);

        // Runtime support globals
        LLVMOpaqueType* ptr_type = LLVMPointerTypeInContext(self.ctx, 0);
        LLVMOpaqueType* i64_type = LLVMInt64TypeInContext(self.ctx);
        LLVMOpaqueType* i1_type = LLVMInt1TypeInContext(self.ctx);

        LLVMOpaqueValue* g_leak = LLVMGetNamedGlobal(self.module, "__silver_leak_check_enabled");
        if (g_leak == (LLVMOpaqueValue*)0) {
            g_leak = LLVMAddGlobal(self.module, i1_type, "__silver_leak_check_enabled");
        }
        if (!module_object) { LLVMSetInitializer(g_leak, LLVMConstInt(i1_type, 0, 0)); }

        LLVMOpaqueValue* g_bt_entries = LLVMGetNamedGlobal(self.module, "__silver_bt_entries");
        if (g_bt_entries == (LLVMOpaqueValue*)0) {
            g_bt_entries = LLVMAddGlobal(self.module, ptr_type, "__silver_bt_entries");
        }
        if (!module_object) { LLVMSetInitializer(g_bt_entries, LLVMConstNull(ptr_type)); }

        LLVMOpaqueValue* g_bt_count = LLVMGetNamedGlobal(self.module, "__silver_bt_count");
        if (g_bt_count == (LLVMOpaqueValue*)0) {
            g_bt_count = LLVMAddGlobal(self.module, i64_type, "__silver_bt_count");
        }
        if (!module_object) { LLVMSetInitializer(g_bt_count, LLVMConstInt(i64_type, 0, 0)); }

        LLVMOpaqueValue* g_bt_lines = LLVMGetNamedGlobal(self.module, "__silver_bt_lines");
        if (g_bt_lines == (LLVMOpaqueValue*)0) {
            g_bt_lines = LLVMAddGlobal(self.module, ptr_type, "__silver_bt_lines");
        }
        if (!module_object) { LLVMSetInitializer(g_bt_lines, LLVMConstNull(ptr_type)); }

        LLVMOpaqueValue* g_bt_lines_count = LLVMGetNamedGlobal(self.module, "__silver_bt_lines_count");
        if (g_bt_lines_count == (LLVMOpaqueValue*)0) {
            g_bt_lines_count = LLVMAddGlobal(self.module, i64_type, "__silver_bt_lines_count");
        }
        if (!module_object) { LLVMSetInitializer(g_bt_lines_count, LLVMConstInt(i64_type, 0, 0)); }

        LLVMOpaqueValue* g_bt_args = LLVMGetNamedGlobal(self.module, "__silver_bt_args");
        if (g_bt_args == (LLVMOpaqueValue*)0) {
            g_bt_args = LLVMAddGlobal(self.module, ptr_type, "__silver_bt_args");
        }
        if (!module_object) { LLVMSetInitializer(g_bt_args, LLVMConstNull(ptr_type)); }

        LLVMOpaqueValue* g_bt_args_count = LLVMGetNamedGlobal(self.module, "__silver_bt_args_count");
        if (g_bt_args_count == (LLVMOpaqueValue*)0) {
            g_bt_args_count = LLVMAddGlobal(self.module, i64_type, "__silver_bt_args_count");
        }
        if (!module_object) { LLVMSetInitializer(g_bt_args_count, LLVMConstInt(i64_type, 0, 0)); }

        LLVMOpaqueType* i32_type = LLVMInt32TypeInContext(self.ctx);
        // P0-001: these MUST stay bare declarations (no initializer). The
        // storage is defined exactly once by the `.section .bss` labels
        // inside std/sys/entry.ag's `_start` asm blob (lowered as inline
        // asm); adding an initializer here creates a second definition and
        // the assembler rejects the object (`symbol '__silver_argc' is
        // already defined`). Verified by IR dump: `@__silver_argc = global`
        // + asm `.bss __silver_argc: .zero 4` collide. A proper fix needs
        // module-level globals AND removal of the .bss lines from the asm
        // blob (entry.ag edit + stage0-codegen impact review) plus linkage
        // control (BE-001) for multi-object builds. Until then: declaration
        // here, definition in the asm blob; single-object only.
        if (LLVMGetNamedGlobal(self.module, "__silver_argc") == (LLVMOpaqueValue*)0) {
            LLVMAddGlobal(self.module, i32_type, "__silver_argc");
        }
        if (LLVMGetNamedGlobal(self.module, "__silver_argv") == (LLVMOpaqueValue*)0) {
            LLVMAddGlobal(self.module, ptr_type, "__silver_argv");
        }
        if (LLVMGetNamedGlobal(self.module, "__silver_envp") == (LLVMOpaqueValue*)0) {
            LLVMAddGlobal(self.module, ptr_type, "__silver_envp");
        }

        Vec<LLVMOpaqueValue*> bt_function_records = Vec<LLVMOpaqueValue*>.new();
        Vec<LLVMOpaqueValue*> bt_arg_function_records = Vec<LLVMOpaqueValue*>.new();

        // Pass 2: Lower function and method bodies
        item = tree.root.first_child;
        while (item != (SyntaxNode*)0) {
            if (item.kind == NodeKind.Function) {
                if (llvm_item_is_generic_fn(item)) {
                    item = item.next_sibling;
                    continue;
                }
                SyntaxNode* body = find_function_body(item);
                if (body != (SyntaxNode*)0) {
                    SyntaxNode* id_node = function_identifier(item);
                    if (id_node == (SyntaxNode*)0) {
                        item = item.next_sibling;
                        continue;
                    }
                    String fn_name = llvm_free_function_symbol(types, tree.root, item);
                    LLVMOpaqueValue* fn_val = LLVMGetNamedFunction(self.module, fn_name.to_str());
                    if (fn_val == (LLVMOpaqueValue*)0 || LLVMCountBasicBlocks(fn_val) > 0) {
                        fn_name.drop();
                        item = item.next_sibling;
                        continue;
                    }
                    u32 ret_type_id = function_return_type_id(types, item);
                    llvm_bt_set_frame_pointer(self.ctx, fn_val);
                    llvm_bt_record_function(self.ctx, self.module, fn_val,
                        fn_name.to_str(), item.span, source_paths, &bt_function_records);
                    ctx.current_fn = fn_val;
                    ctx.current_return_type = ret_type_id;

                    LLVMOpaqueBasicBlock* entry_bb = LLVMAppendBasicBlockInContext(self.ctx, fn_val, "entry");
                    LLVMPositionBuilderAtEnd(self.builder, entry_bb);
                    ctx.push_scope();

                    Vec<Binding> params = Vec<Binding>.new();
                    collect_parameter_bindings(binding_function_parameters(item), &params);
                    Vec<LLVMOpaqueValue*> bt_arg_records = Vec<LLVMOpaqueValue*>.new();
                    LLVMOpaqueValue* frame_pointer = (LLVMOpaqueValue*)0;
                    if (params.len() > 0) {
                        frame_pointer = llvm_bt_read_frame_pointer(self.ctx, self.builder);
                    }
                    TypeEnv infer_env = TypeEnv.new();
                    i64 p = 0;
                    while (p < params.len()) {
                        Binding* param = params.get_ptr(p);
                        u32 param_name_id = names.intern(param.name);
                        bool exact_function_type = binding_has_function_type(param);
                        String dec_str = binding_parameter_type_text(param);
                        str type_str = dec_str.to_str();
                        u32 param_type_id = ctx.subst_type(type_str);
                        if (param_type_id == TYPE_UNKNOWN) {
                            param_type_id = types.parse_type_name(type_str);
                        }
                        if (binding_is_variadic_parameter(param)
                            || param.declared_type.kind == ProjectionTypeKind.Array) {
                            param_type_id = types.resolve_subst(
                                typecheck_parameter_type_id(types, param));
                        } else if (!exact_function_type && param.declared_type.kind == ProjectionTypeKind.Pointer) {
                            param_type_id = types.get_pointer(param_type_id, true);
                        } else if (!exact_function_type
                            && param.declared_type.kind == ProjectionTypeKind.Reference) {
                            param_type_id = types.get_reference(param_type_id,
                                                                param.declared_type.is_mutable);
                        } else if (!exact_function_type && param_type_id == TYPE_VOID) {
                            param_type_id = types.get_pointer(param_type_id, true);
                        }
                        LLVMOpaqueType* param_llvm_type = llvm_lower_type(self.ctx, types, param_type_id);
                        LLVMOpaqueValue* alloca_ptr = LLVMBuildAlloca(self.builder, param_llvm_type, param.name);
                        LLVMOpaqueValue* param_val = LLVMGetParam(fn_val, (u32)p);
                        LLVMBuildStore(self.builder, param_val, alloca_ptr);
                        bt_arg_records.push(llvm_bt_make_arg_record(
                            self.ctx, self.module, self.builder, self.target_data,
                            fn_name.to_str(), param.name, param_llvm_type,
                            alloca_ptr, frame_pointer));
                        ctx.add_local(param_name_id, alloca_ptr, param_type_id, true);
                        llvm_register_local_drops(&ctx, param_name_id, alloca_ptr, param_type_id, true);
                        infer_env.insert(param_name_id, param_type_id);
                        dec_str.drop();
                        p += 1;
                    }
                    llvm_bt_record_args(self.ctx, self.module, fn_val,
                        &bt_arg_records, &bt_arg_function_records);
                    bt_arg_records.drop();
                    params.drop();

                    ExprLowerer lowerer = ExprLowerer.new(pool, types, names);
                    lowerer.unit_root = tree.root;
                    lowerer.debug_mode = ctx.debug_mode;
                    Vec<u32> stmt_ids = Vec<u32>.new();
                    lowerer.lower_block(body, &stmt_ids);
                    if (lowerer.unsupported) {
                        ctx.note_unresolved("unsupported", fn_name.to_str());
                        stmt_ids.drop();
                    } else {
                        // Single lowering: infer types on these same IDs before
                        // emitting, so llvm_expr_type sees real types instead
                        // of UNKNOWN (previously a separate probe pool held the
                        // inference while codegen re-lowered blind).
                        // Advisory only: errors are discarded, emit proceeds.
                        DiagnosticBag infer_diag = DiagnosticBag.new();
                        bool infer_ok = true;
                        i64 ti = 0;
                        while (ti < stmt_ids.len()) {
                            typecheck_statement(pool, types, symbols, tree.root, &infer_env, ret_type_id, stmt_ids.get(ti), &infer_diag, &infer_ok);
                            ti += 1;
                        }
                        i64 s = 0;
                        while (s < stmt_ids.len()) {
                            llvm_emit_stmt(&ctx, stmt_ids.get(s));
                            if (ctx.is_terminated()) { break; }
                            s += 1;
                        }
                        stmt_ids.drop();
                    }

                    if (!ctx.is_terminated()) {
                        llvm_emit_defers_above(&ctx, (i64)0);
                    }
                    if (!ctx.is_terminated()) {
                        llvm_emit_drops_above(&ctx, (i64)0);
                        if (ret_type_id == TYPE_VOID) {
                            LLVMBuildRetVoid(self.builder);
                        } else {
                            LLVMOpaqueType* ret_llvm_type = llvm_lower_type(self.ctx, types, ret_type_id);
                            LLVMBuildRet(self.builder, LLVMConstNull(ret_llvm_type));
                        }
                    }
                    ctx.pop_scope();
                    fn_name.drop();
                }
            } else if (item.kind == NodeKind.Impl) {
                if (llvm_item_is_generic_impl(item)) {
                    item = item.next_sibling;
                    continue;
                }
                SyntaxNode* struct_ident = impl_target_identifier(item);
                if (struct_ident != (SyntaxNode*)0) {
                    str struct_name = struct_ident.text;
                    SyntaxNode* block = item.first_child;
                    while (block != (SyntaxNode*)0 && block.kind != NodeKind.Block) {
                        block = block.next_sibling;
                    }
                    if (block != (SyntaxNode*)0) {
                        SyntaxNode* cursor = block.first_child;
                        while (cursor != (SyntaxNode*)0) {
                            if (cursor.kind == NodeKind.Token && cursor.token_kind == TokenKind.Semicolon) {
                                cursor = cursor.next_sibling;
                                continue;
                            }
                            bool is_cast = cursor.kind == NodeKind.Token && (cursor.token_kind == TokenKind.Cast || strcmp(cursor.text, "cast") == 0);
                            SyntaxNode* ret_start = cursor;
                            SyntaxNode* method_name_node = (SyntaxNode*)0;
                            SyntaxNode* params_node = (SyntaxNode*)0;
                            SyntaxNode* body_node = (SyntaxNode*)0;
                            SyntaxNode* scan = cursor;
                            bool hit_semi = false;
                            SyntaxNode* semi_node = (SyntaxNode*)0;
                            while (scan != (SyntaxNode*)0) {
                                if (scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Semicolon) {
                                    hit_semi = true;
                                    semi_node = scan;
                                    break;
                                }
                                if (scan.kind == NodeKind.Block) {
                                    body_node = scan;
                                    break;
                                }
                                if (scan.kind == NodeKind.Parenthesized) {
                                    params_node = scan;
                                    if (scan.next_sibling != (SyntaxNode*)0 && scan.next_sibling.kind == NodeKind.Block) {
                                        body_node = scan.next_sibling;
                                        break;
                                    }
                                }
                                if (!is_cast && scan.kind == NodeKind.Token && scan.token_kind == TokenKind.Identifier) {
                                    method_name_node = scan;
                                }
                                scan = scan.next_sibling;
                            }
                            if (hit_semi) {
                                cursor = semi_node.next_sibling;
                                continue;
                            }
                            if (body_node != (SyntaxNode*)0 && body_node.kind == NodeKind.Block) {
                                if ((is_cast || method_name_node != (SyntaxNode*)0) && params_node != (SyntaxNode*)0) {
                                    String mangled = String.from_str(struct_name);
                                    mangled.push_str("__");
                                    String ret_str = String.new();
                                    if (is_cast) {
                                        SyntaxNode* rscan = cursor.next_sibling;
                                        while (rscan != (SyntaxNode*)0 && rscan != params_node) {
                                            append_node_tokens(rscan, &ret_str);
                                            rscan = rscan.next_sibling;
                                        }
                                        mangled.push_str("cast_");
                                        mangled.push_str(ret_str.to_str());
                                    } else {
                                        mangled.push_str(method_name_node.text);
                                        SyntaxNode* rscan = ret_start;
                                        while (rscan != (SyntaxNode*)0 && rscan != method_name_node) {
                                            if (rscan.kind == NodeKind.Token && rscan.text == "#") {
                                                rscan = rscan.next_sibling;
                                                if (rscan != (SyntaxNode*)0 && rscan.kind == NodeKind.Bracket) {
                                                    rscan = rscan.next_sibling;
                                                }
                                                continue;
                                            }
                                            if (rscan.kind == NodeKind.Token && (rscan.text == "pub" || rscan.text == "static")) {
                                                rscan = rscan.next_sibling;
                                                continue;
                                            }
                                            break;
                                        }
                                        while (rscan != (SyntaxNode*)0 && rscan != method_name_node) {
                                            append_node_tokens(rscan, &ret_str);
                                            rscan = rscan.next_sibling;
                                        }
                                    }
                                    u32 ret_type_id = type_id_from_text(types, ret_str.to_str());
                                    ret_str.drop();
                                    if (!is_cast) {
                                        String method_symbol = typecheck_method_symbol(
                                            types, struct_name,
                                            method_name_node.text, ret_start,
                                            method_name_node, params_node);
                                        mangled.drop();
                                        mangled = move method_symbol;
                                    }
                                    LLVMOpaqueValue* fn_val = LLVMGetNamedFunction(self.module, mangled.to_str());
                                    mangled.drop();
                                    if (fn_val != (LLVMOpaqueValue*)0 && LLVMCountBasicBlocks(fn_val) == 0) {
                                        llvm_bt_set_frame_pointer(self.ctx, fn_val);
                                        str emitted_name = LLVMGetValueName(fn_val);
                                        llvm_bt_record_function(self.ctx, self.module, fn_val,
                                            emitted_name, cursor.span, source_paths, &bt_function_records);
                                        ctx.current_fn = fn_val;
                                        ctx.current_return_type = ret_type_id;

                                        LLVMOpaqueBasicBlock* entry_bb = LLVMAppendBasicBlockInContext(self.ctx, fn_val, "entry");
                                        LLVMPositionBuilderAtEnd(self.builder, entry_bb);
                                        ctx.push_scope();

                                        Vec<Binding> params = Vec<Binding>.new();
                                        collect_parameter_bindings(params_node, &params);
                                        Vec<LLVMOpaqueValue*> bt_arg_records = Vec<LLVMOpaqueValue*>.new();
                                        LLVMOpaqueValue* frame_pointer = (LLVMOpaqueValue*)0;
                                        if (params.len() > 0) {
                                            frame_pointer = llvm_bt_read_frame_pointer(self.ctx, self.builder);
                                        }
                                        i64 p = 0;
                                        while (p < params.len()) {
                                            Binding* param = params.get_ptr(p);
                                            u32 param_name_id = names.intern(param.name);
                                            bool exact_function_type = binding_has_function_type(param);
                                            String dec_str = binding_parameter_type_text(param);
                                            str type_str = dec_str.to_str();
                                            if (strcmp(type_str, "Self") == 0 || (strcmp(param.name, "self") == 0 && strlen(type_str) == 0)) {
                                                type_str = struct_name;
                                            }
                                            u32 param_type_id = ctx.subst_type(type_str);
                                            if (param_type_id == TYPE_UNKNOWN) {
                                                param_type_id = types.parse_type_name(type_str);
                                            }
                                            if (binding_is_variadic_parameter(param)
                                                || param.declared_type.kind == ProjectionTypeKind.Array) {
                                                param_type_id = types.resolve_subst(
                                                    typecheck_parameter_type_id(types, param));
                                            } else if (!exact_function_type
                                                && (param.declared_type.kind == ProjectionTypeKind.Pointer
                                                    || param.declared_type.kind == ProjectionTypeKind.Reference || param_type_id == TYPE_VOID)) {
                                                param_type_id = types.get_pointer(param_type_id, true);
                                            }
                                            LLVMOpaqueType* param_llvm_type = llvm_lower_type(self.ctx, types, param_type_id);
                                            LLVMOpaqueValue* alloca_ptr = LLVMBuildAlloca(self.builder, param_llvm_type, param.name);
                                            LLVMOpaqueValue* param_val = LLVMGetParam(fn_val, (u32)p);
                                            LLVMBuildStore(self.builder, param_val, alloca_ptr);
                                            bt_arg_records.push(llvm_bt_make_arg_record(
                                                self.ctx, self.module, self.builder, self.target_data,
                                                emitted_name, param.name, param_llvm_type,
                                                alloca_ptr, frame_pointer));
                                            ctx.add_local(param_name_id, alloca_ptr, param_type_id, true);
                                            llvm_register_local_drops(&ctx, param_name_id, alloca_ptr, param_type_id, true);
                                            dec_str.drop();
                                            p += 1;
                                        }
                                        llvm_bt_record_args(self.ctx, self.module, fn_val,
                                            &bt_arg_records, &bt_arg_function_records);
                                        bt_arg_records.drop();
                                        // Cast receivers are borrowed views, not owned values:
                                        // the caller retains ownership, so the by-value
                                        // receiver must not run the destructor on exit.
                                        if (is_cast && params.len() > 0) {
                                            Binding* first_param = params.get_ptr(0);
                                            llvm_clear_local_drops(&ctx, names.intern(first_param.name));
                                        }
                                        params.drop();

                                        ExprLowerer lowerer = ExprLowerer.new(pool, types, names);
                                        lowerer.unit_root = tree.root;
                                        lowerer.debug_mode = ctx.debug_mode;
                                        Vec<u32> stmt_ids = Vec<u32>.new();
                                        lowerer.lower_block(body_node, &stmt_ids);
                                        i64 s = 0;
                                        while (s < stmt_ids.len()) {
                                            llvm_emit_stmt(&ctx, stmt_ids.get(s));
                                            if (ctx.is_terminated()) { break; }
                                            s += 1;
                                        }
                                        stmt_ids.drop();

                                        if (!ctx.is_terminated()) {
                                            llvm_emit_defers_above(&ctx, (i64)0);
                                        }
                                        if (!ctx.is_terminated()) {
                                            llvm_emit_drops_above(&ctx, (i64)0);
                                            if (ret_type_id == TYPE_VOID) {
                                                LLVMBuildRetVoid(self.builder);
                                            } else {
                                                LLVMOpaqueType* ret_llvm_type = llvm_lower_type(self.ctx, types, ret_type_id);
                                                LLVMBuildRet(self.builder, LLVMConstNull(ret_llvm_type));
                                            }
                                        }
                                        ctx.pop_scope();
                                    }
                                }
                                cursor = body_node.next_sibling;
                                continue;
                            }
                            cursor = cursor.next_sibling;
                        }
                    }
                }
            }
            item = item.next_sibling;
        }

        llvm_emit_entry_point(self.ctx, self.module, self.builder);

        llvm_drain_mono_queue(&ctx, types, names, pool);
        mono_define_generic_layouts(&ctx);
        if (!module_object) {
            llvm_bt_emit_tables(self.ctx, self.module,
                &bt_function_records, &bt_arg_function_records);
        }
        bt_function_records.drop();
        bt_arg_function_records.drop();

        self.unresolved_calls = ctx.unresolved_calls;
        return ctx.unresolved_calls == 0 && self.ownership_diagnostics.is_empty();
    }

    bool verify(LlvmGenerator* self, String* out_error) {
        i8* error_msg = (i8*)0;
        i32 res = LLVMVerifyModule(self.module, LLVMVerifierFailureAction.LLVMReturnStatusAction, &error_msg);
        if (res != 0) {
            if (error_msg != (i8*)0) {
                out_error.push_str(error_msg);
                LLVMDisposeMessage(error_msg);
            } else {
                out_error.push_str("unknown LLVM verification error");
            }
            return false;
        }
        return true;
    }

    String emit_ir(LlvmGenerator* self) {
        i8* raw_ir = LLVMPrintModuleToString(self.module);
        String ir = String.from_str(raw_ir);
        LLVMDisposeMessage(raw_ir);
        return move ir;
    }

    bool emit_object_file(LlvmGenerator* self, str output_path, String* out_error) {
        if (self.target_machine == (LLVMOpaqueTargetMachine*)0 || self.target_data == (LLVMTargetDataRef*)0) {
            out_error.push_str("failed to initialize target machine and data layout");
            return false;
        }

        i8* emit_err = (i8*)0;
        i32 emit_res = LLVMTargetMachineEmitToFile(
            self.target_machine, self.module, output_path,
            LLVMCodeGenFileType.LLVMObjectFile,
            &emit_err
        );

        if (emit_res != 0) {
            if (emit_err != (i8*)0) {
                out_error.push_str(emit_err);
                LLVMDisposeMessage(emit_err);
            } else {
                out_error.push_str("failed to emit object file");
            }
            return false;
        }
        return true;
    }
}
